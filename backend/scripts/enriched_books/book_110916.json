  "story": {
    "title": "Chicken and its friends",
    "paragraphs_en": [
      "This chicken is far .",
      "This one is very near .",
      "It can run .",
      "But it can not stop .",
      "It sits on the top .",
      "But it coughs at the bottom .",
      "One looks up while the others look down .",
      "Chicken eats in the dark .",
      "But it plays in the light .",
      "The chicken talks while the dog listens ."
    ],
