  "story": {
    "title": "Anand",
    "paragraphs_en": [
      "My name is Anand.",
      "My duty is to collect garbage from the houses here.",
      "If I go late, Mrs. Maskarenyas will be very angry.",
      "Unni uncle will say to pick garbage without leaving a ﻿single one.",
      "Anitha aunt cannot beare the smell.",
      "In the 4th cross street, there is a new family who are kind. But their dog is not like them.",
      "Alas! This takes time to clean.",
      "I like to go to saleem's house.",
      "Saleem and I are friends.",
      "He likes to play drums. I like to dance.",
      "It is time to go to school.",
      "Tata"
    ],
    "sentences": [
      {
        "text_en": "My name is Anand.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_000.mp3",
        "text_vi": "Tên của cháu là Anand."
      },
      {
        "text_en": "My duty is to collect garbage from the houses here.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_001.mp3",
        "text_vi": "Nhiệm vụ của cháu là thu gom rác từ các nhà ở đây."
      },
      {
        "text_en": "If I go late, Mrs.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_002.mp3",
        "text_vi": "Nếu cháu đến muộn,"
      },
      {
        "text_en": "Maskarenyas will be very angry.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_003.mp3",
        "text_vi": "cô Maskarenyas sẽ rất tức giận."
      },
      {
        "text_en": "Unni uncle will say to pick garbage without leaving a ﻿single one.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_004.mp3",
        "text_vi": "Chú Unni sẽ bảo nhặt rác không được bỏ sót một cái nào."
      },
      {
        "text_en": "Anitha aunt cannot beare the smell.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_005.mp3",
        "text_vi": "Dì Anitha không chịu được mùi này."
      },
      {
        "text_en": "In the 4th cross street, there is a new family who are kind.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_006.mp3",
        "text_vi": "Ở con phố thứ 4, có một gia đình mới rất tốt bụng."
      },
      {
        "text_en": "But their dog is not like them.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_007.mp3",
        "text_vi": "Nhưng con chó của họ thì không giống họ."
      },
      {
        "text_en": "Alas! This takes time to clean.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_008.mp3",
        "text_vi": "Ôi! Việc này tốn thời gian để dọn dẹp."
      },
      {
        "text_en": "I like to go to saleem's house.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_009.mp3",
        "text_vi": "Cháu thích đến nhà Saleem."
      },
      {
        "text_en": "Saleem and I are friends.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_010.mp3",
        "text_vi": "Saleem và cháu là bạn bè."
      },
      {
        "text_en": "He likes to play drums.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_011.mp3",
        "text_vi": "Cậu ấy thích chơi trống."
      },
      {
        "text_en": "I like to dance.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_012.mp3",
        "text_vi": "Cháu thích nhảy múa."
      },
      {
        "text_en": "It is time to go to school.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_013.mp3",
        "text_vi": "Đến giờ đi học rồi."
      },
      {
        "text_en": "Tata",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_131398/s_014.mp3",
        "text_vi": "Tạm biệt."
      }
    ]
  },
