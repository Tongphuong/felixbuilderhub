        "text_en": "The giraffe is taller than the boy.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_002.mp3",
        "text_vi": "Con hươu cao cổ cao hơn cậu bé."
      },
      {
        "text_en": "Is there anyone taller than you in your class?",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_003.mp3",
        "text_vi": "Trong lớp con có ai cao hơn con không?"
      },
      {
        "text_en": "Devi and Raju were asked to read story books by their mother.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_004.mp3",
        "text_vi": "Devi và Raju được mẹ bảo đọc sách truyện."
      },
      {
        "text_en": "Devi is happy reading story books.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_005.mp3",
        "text_vi": "Devi vui vẻ đọc sách truyện."
      },
      {
        "text_en": "Raju is sad as he does not like reading books.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_006.mp3",
        "text_vi": "Raju buồn vì cậu ấy không thích đọc sách."
      },
      {
        "text_en": "When do you feel happy and when do you feel sad?",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_007.mp3",
        "text_vi": "Khi nào con cảm thấy vui và khi nào con cảm thấy buồn?"
      },
      {
        "text_en": "The cat runs fast .",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_008.mp3",
        "text_vi": "Con mèo chạy nhanh."
      },
      {
        "text_en": "The elephant runs slow .",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_009.mp3",
        "text_vi": "Con voi chạy chậm."
      },
      {
        "text_en": "Do you run fast or do you run slow?",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_010.mp3",
        "text_vi": "Con chạy nhanh hay chạy chậm?"
      },
      {
        "text_en": "We played hide and seek.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_011.mp3",
        "text_vi": "Chúng ta đã chơi trốn tìm."
      },
      {
        "text_en": "It was fun.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_012.mp3",
        "text_vi": "Trò đó vui lắm."
      },
      {
        "text_en": "Raju closed his eyes and counted upto 10.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_013.mp3",
        "text_vi": "Raju nhắm mắt lại và đếm đến 10."
      },
      {
        "text_en": "When he opened his eyes, he could not find us.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_014.mp3",
        "text_vi": "Khi cậu ấy mở mắt ra, cậu ấy không tìm thấy chúng ta."
      },
      {
        "text_en": "We were all hiding.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_015.mp3",
        "text_vi": "Chúng ta đều đang trốn."
      },
      {
        "text_en": "Can we all play hide and seek?",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_016.mp3",
        "text_vi": "Chúng ta cùng chơi trốn tìm được không?"
      },
      {
        "text_en": "Who wants to close the eyes?",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123421/s_017.mp3",
        "text_vi": "Ai muốn nhắm mắt nào?"
      }
    ]
