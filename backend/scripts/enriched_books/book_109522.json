  "story": {
    "title": "There's an alien in my house!",
    "paragraphs_en": [
      "There’s an alien in my house... We are under attack!",
      "The walls are changing colour. It must be the alien. The air is getting warmer. It must be the alien.",
      "Strangers keep coming. It must be the alien.",
      "We need protection. I build a fort. Mom and Dad normally build with me, but these days I feel invisible. It must be the alien.",
      "I hear a weird noise in the middle of the night. It must be the alien.",
      "We are under attack! I am an army of one.",
      "1 step, 2 step... I am the army. 3 step, 4 step... Ready for battle.",
      "5 step, 6 step... Away with you, alien!",
      "7 step, 8 step... I get closer.",
      "9 step, 10 step... I am by its head. Woah! I get a fright. It is tiny and it... ...looks like me?! How can that be? Is it really an alien?",
      "Maybe it’s a friend. Maybe it’s my friend?",
      "1 step, 2 step... We are now an army of two."
    ],
    "sentences": [
      {
        "text_en": "There’s an alien in my house...",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_000.mp3",
        "text_vi": "Có một người ngoài hành tinh trong nhà của tớ..."
      },
      {
        "text_en": "We are under attack!",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_001.mp3",
        "text_vi": "Chúng ta đang bị tấn công!"
      },
      {
        "text_en": "The walls are changing colour.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_002.mp3",
        "text_vi": "Các bức tường đang đổi màu."
      },
      {
        "text_en": "It must be the alien.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_003.mp3",
        "text_vi": "Chắc chắn là do người ngoài hành tinh đó."
      },
      {
        "text_en": "The air is getting warmer.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_004.mp3",
        "text_vi": "Không khí đang ấm dần lên."
      },
      {
        "text_en": "It must be the alien.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_005.mp3",
        "text_vi": "Chắc chắn là do người ngoài hành tinh đó."
      },
      {
        "text_en": "Strangers keep coming.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_006.mp3",
        "text_vi": "Những người lạ cứ đến mãi."
      },
      {
        "text_en": "It must be the alien.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_007.mp3",
        "text_vi": "Chắc chắn là do người ngoài hành tinh đó."
      },
      {
        "text_en": "We need protection.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_008.mp3",
        "text_vi": "Chúng ta cần được bảo vệ."
      },
      {
        "text_en": "I build a fort.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_009.mp3",
        "text_vi": "Tớ xây một cái pháo đài."
      },
      {
        "text_en": "Mom and Dad normally build with me, but these days I feel invisible.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_010.mp3",
        "text_vi": "Bố mẹ thường xây cùng tớ, nhưng dạo này tớ cảm thấy như vô hình."
      },
      {
        "text_en": "It must be the alien.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_011.mp3",
        "text_vi": "Chắc chắn là do người ngoài hành tinh đó."
      },
      {
        "text_en": "I hear a weird noise in the middle of the night.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_012.mp3",
        "text_vi": "Tớ nghe thấy một tiếng động lạ giữa đêm."
      },
      {
        "text_en": "It must be the alien.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_013.mp3",
        "text_vi": "Chắc chắn là do người ngoài hành tinh đó."
      },
      {
        "text_en": "We are under attack!",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_014.mp3",
        "text_vi": "Chúng ta đang bị tấn công!"
      },
      {
        "text_en": "I am an army of one.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_015.mp3",
        "text_vi": "Tớ là một đội quân một người."
      },
      {
        "text_en": "1 step, 2 step...",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_016.mp3",
        "text_vi": "Một bước, hai bước..."
      },
      {
        "text_en": "I am the army.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_017.mp3",
        "text_vi": "Tớ là đội quân đây."
      },
      {
        "text_en": "3 step, 4 step...",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_018.mp3",
        "text_vi": "Ba bước, bốn bước..."
      },
      {
        "text_en": "Ready for battle.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_019.mp3",
        "text_vi": "Sẵn sàng chiến đấu."
      },
      {
        "text_en": "5 step, 6 step...",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_020.mp3",
        "text_vi": "Năm bước, sáu bước..."
      },
      {
        "text_en": "Away with you, alien!",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_021.mp3",
        "text_vi": "Đi đi, người ngoài hành tinh!"
      },
      {
        "text_en": "7 step, 8 step...",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_022.mp3",
        "text_vi": "Bảy bước, tám bước..."
      },
      {
        "text_en": "I get closer.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_023.mp3",
        "text_vi": "Tớ đến gần hơn."
      },
      {
        "text_en": "9 step, 10 step...",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_024.mp3",
        "text_vi": "Chín bước, mười bước..."
      },
      {
        "text_en": "I am by its head.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_025.mp3",
        "text_vi": "Tớ đang ở cạnh đầu nó."
      },
      {
        "text_en": "Woah! I get a fright.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_026.mp3",
        "text_vi": "Ôi! Tớ giật mình."
      },
      {
        "text_en": "It is tiny and it...",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_027.mp3",
        "text_vi": "Nó bé tí và nó..."
      },
      {
        "text_en": "...looks like me?!",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_028.mp3",
        "text_vi": "...trông giống tớ?!"
      },
      {
        "text_en": "How can that be?",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_029.mp3",
        "text_vi": "Sao lại thế được nhỉ?"
      },
      {
        "text_en": "Is it really an alien?",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_030.mp3",
        "text_vi": "Nó có thật sự là người ngoài hành tinh không?"
      },
      {
        "text_en": "Maybe it’s a friend.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_031.mp3",
        "text_vi": "Có lẽ nó là một người bạn."
      },
      {
        "text_en": "Maybe it’s my friend?",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_032.mp3",
        "text_vi": "Có lẽ nó là bạn của tớ?"
      },
      {
        "text_en": "1 step, 2 step...",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_033.mp3",
        "text_vi": "Một bước, hai bước..."
      },
      {
        "text_en": "We are now an army of two.",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_109522/s_034.mp3",
        "text_vi": "Bây giờ chúng ta là một đội quân hai người."
      }
    ]
  },
