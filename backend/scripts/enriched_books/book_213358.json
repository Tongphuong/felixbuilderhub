  "story": {
    "title": "My Aunt the Dyer",
    "paragraphs_en": [
      "My aunt the dyer lights her stove.",
      "She starts dyeing lots of clothes.",
      "One blue turban. One yellow sheet.",
      "One red sari. One green cap.",
      "One black pyjama.",
      "One yellow shirt.",
      "My aunt the dyer dyes all the clothes."
    ],
    "sentences": [
      {
        "text_en": "My aunt the dyer lights her stove.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213358/s_000.mp3",
        "text_vi": "Dì tôi, người thợ nhuộm, thắp bếp lên."
      },
      {
        "text_en": "She starts dyeing lots of clothes.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213358/s_001.mp3",
        "text_vi": "Dì ấy bắt đầu nhuộm rất nhiều quần áo."
      },
      {
        "text_en": "One blue turban.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213358/s_002.mp3",
        "text_vi": "Một chiếc khăn xếp màu xanh dương."
      },
      {
        "text_en": "One yellow sheet.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213358/s_003.mp3",
        "text_vi": "Một tấm vải màu vàng."
      },
      {
        "text_en": "One red sari.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213358/s_004.mp3",
        "text_vi": "Một chiếc sari màu đỏ."
      },
      {
        "text_en": "One green cap.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213358/s_005.mp3",
        "text_vi": "Một chiếc mũ màu xanh lá cây."
      },
      {
        "text_en": "One black pyjama.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213358/s_006.mp3",
        "text_vi": "Một bộ đồ ngủ màu đen."
      },
      {
        "text_en": "One yellow shirt.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213358/s_007.mp3",
        "text_vi": "Một chiếc áo sơ mi màu vàng."
      },
      {
        "text_en": "My aunt the dyer dyes all the clothes.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213358/s_008.mp3",
        "text_vi": "Dì tôi, người thợ nhuộm, nhuộm tất cả quần áo."
      }
