  "story": {
    "title": "It's All the Cat's Fault",
    "paragraphs_en": [
      "You did not do your work! Miss, it's all the cat's fault!",
      "The cat went up the tree. So I needed to help.",
      "I fixed the ladder. But I woke up the baby.",
      "Mama ran to the baby. And a monkey got in!",
      "The monkey made a big mess! So we had to buy new food.",
      "My papa went to get the food. A dog wanted the food!",
      "The dog ate my workbook!",
      "So, you tell me a dog is to blame?",
      "No, Miss. It's all the cat's fault!"
    ],
    "sentences": [
      {
        "text_en": "You did not do your work!",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_000.mp3",
        "text_vi": "Con chưa làm bài tập!"
      },
      {
        "text_en": "Miss, it's all the cat's fault!",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_001.mp3",
        "text_vi": "Cô ơi, tất cả là lỗi của con mèo!"
      },
      {
        "text_en": "The cat went up the tree.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_002.mp3",
        "text_vi": "Con mèo trèo lên cây."
      },
      {
        "text_en": "So I needed to help.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_003.mp3",
        "text_vi": "Thế là con phải giúp."
      },
      {
        "text_en": "I fixed the ladder.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_004.mp3",
        "text_vi": "Con sửa cái thang."
      },
      {
        "text_en": "But I woke up the baby.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_005.mp3",
        "text_vi": "Nhưng con lại làm em bé thức giấc."
      },
      {
        "text_en": "Mama ran to the baby.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_006.mp3",
        "text_vi": "Mẹ chạy đến chỗ em bé."
      },
      {
        "text_en": "And a monkey got in!",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_007.mp3",
        "text_vi": "Và một con khỉ đã vào nhà!"
      },
      {
        "text_en": "The monkey made a big mess!",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_008.mp3",
        "text_vi": "Con khỉ làm bừa bộn hết cả!"
      },
      {
        "text_en": "So we had to buy new food.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_009.mp3",
        "text_vi": "Nên chúng con phải mua đồ ăn mới."
      },
      {
        "text_en": "My papa went to get the food.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_010.mp3",
        "text_vi": "Bố con đi lấy đồ ăn."
      },
      {
        "text_en": "A dog wanted the food!",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_011.mp3",
        "text_vi": "Một con chó muốn đồ ăn!"
      },
      {
        "text_en": "The dog ate my workbook!",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_012.mp3",
        "text_vi": "Con chó ăn mất quyển vở bài tập của con!"
      },
      {
        "text_en": "So, you tell me a dog is to blame?",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_013.mp3",
        "text_vi": "Vậy con nói là lỗi của con chó à?"
      },
      {
        "text_en": "No, Miss. It's all the cat's fault!",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_123214/s_014.mp3",
        "text_vi": "Không ạ, thưa cô. Tất cả là lỗi của con mèo!"
      }
