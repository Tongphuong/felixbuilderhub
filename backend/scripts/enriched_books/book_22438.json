        "text_vi": "Bò kêu ủm bò. Ủm bò."
      },
      {
        "text_en": "Lions roar. Rawr",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_22438/s_006.mp3",
        "text_vi": "Sư tử gầm. Gầm gừ."
