  "story": {
    "title": "Listen",
    "paragraphs_en": [
      "Crickets chirp. Chirp Chirp",
      "Mice squeak. Squeak Squeak",
      "Snakes hiss. Hisssss",
      "Dogs bark. Bow Bow",
      "Goats bleat. Baaaaa",
      "Cows moo. Mooo",
      "Lions roar. Rawr",
      "And snails make no sound at all.",
      "Babies babble. ﻿Ga Ga. Goo Goo",
      "And children talk. Blah Blah"
    ],
    "sentences": [
      {
        "text_en": "Crickets chirp. Chirp Chirp",
