      },
      {
        "text_en": "Snakes hiss. Hisssss",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_22438/s_002.mp3",
        "text_vi": "Rắn kêu xì. Xììììì."
      },
      {
        "text_en": "Dogs bark. Bow Bow",
        "paragraph_index": 3,
