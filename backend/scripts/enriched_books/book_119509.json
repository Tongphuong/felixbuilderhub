  "story": {
    "title": "Chikkiri Chakkiri",
    "paragraphs_en": [
      "Chikkiri chakkiri, Round as a plum. The cat played her flute And the mouse beat his drum.",
      "Imbilli kimbilli, Roses so red. The pig leaped right over The buffalo's head.",
      "Jhataka mataka, Kettle of tea. The cow danced the bhangra Around the neem tree.",
      "Thandana thindana, Jamun so sweet. The dog sang ghazals to The old parakeet.",
      "Karukku murukku, Oh, what a bother! We’re spotted at play By the farmer’s grandmother!",
      "Dhadaka bhadaka, Hearts beat like drums. Will she blurt our secret Out to everyone? Jingiri jangiri, Shiny, bright sun. She kicks off her slippers",
      "And joins in the fun!"
    ],
    "sentences": [
      {
        "text_en": "Chikkiri chakkiri, Round as a plum.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_000.mp3",
        "text_vi": "Chikkiri chakkiri, Tròn như quả mận."
      },
      {
        "text_en": "The cat played her flute And the mouse beat his drum.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_001.mp3",
        "text_vi": "Mèo thổi sáo và chuột gõ trống."
      },
      {
        "text_en": "Imbilli kimbilli, Roses so red.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_002.mp3",
        "text_vi": "Imbilli kimbilli, Hoa hồng đỏ tươi."
      },
      {
        "text_en": "The pig leaped right over The buffalo's head.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_003.mp3",
        "text_vi": "Chú heo nhảy vọt qua đầu trâu."
      },
      {
        "text_en": "Jhataka mataka, Kettle of tea.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_004.mp3",
        "text_vi": "Jhataka mataka, Ấm trà."
      },
      {
        "text_en": "The cow danced the bhangra Around the neem tree.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_005.mp3",
        "text_vi": "Bò nhảy điệu bhangra quanh cây neem."
      },
      {
        "text_en": "Thandana thindana, Jamun so sweet.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_006.mp3",
        "text_vi": "Thandana thindana, Quả jamun thật ngọt."
      },
      {
        "text_en": "The dog sang ghazals to The old parakeet.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_007.mp3",
        "text_vi": "Chú chó hát ghazal cho con vẹt già."
      },
      {
        "text_en": "Karukku murukku, Oh, what a bother!",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_008.mp3",
        "text_vi": "Karukku murukku, Ôi, thật phiền phức!"
      },
      {
        "text_en": "We’re spotted at play By the farmer’s grandmother!",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_009.mp3",
        "text_vi": "Chúng ta bị phát hiện khi đang chơi bởi bà của bác nông dân!"
      },
      {
        "text_en": "Dhadaka bhadaka, Hearts beat like drums.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_010.mp3",
        "text_vi": "Dhadaka bhadaka, Tim đập thình thịch như trống."
      },
      {
        "text_en": "Will she blurt our secret Out to everyone?",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_011.mp3",
        "text_vi": "Liệu cô ấy có nói to bí mật của chúng ta cho mọi người không?"
      },
      {
        "text_en": "Jingiri jangiri, Shiny, bright sun.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_012.mp3",
        "text_vi": "Jingiri jangiri, Mặt trời sáng chói."
      },
      {
        "text_en": "She kicks off her slippers",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_013.mp3",
        "text_vi": "Cô ấy đá văng dép ra."
      },
      {
        "text_en": "And joins in the fun!",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_119509/s_014.mp3",
        "text_vi": "Và cùng tham gia cuộc vui!"
      }
    ]
  },
