  "story": {
    "title": "Where is my bat?",
    "paragraphs_en": [
      "I lost my bat. I am not fining it now.",
      "I looked behind the door. But could not find it there.",
      "I have looked in the cupboard. It is not there either.",
      "I looked under the bed. I did not find it there.",
      "I searched in suitcase. It is not there either.",
      "I have searched on the attic. I could not find it there too.",
      "I have searched here and there. I could not find it anywhere. See, it is there in sisters hand."
    ],
