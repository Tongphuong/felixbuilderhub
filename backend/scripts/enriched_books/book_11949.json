  "story": {
    "title": "The Kite",
    "paragraphs_en": [
      "Look! A kite fight! Oops! The purple kite is torn. Oh no! The yellow one’s gone. Aha! The red kite floats down. Climb up high. Stretch out and grab!",
      "Quick! Zoom away. Now step inside and hide.",
      "Sprint right through without a stop. Slide over and dodge about.",
      "Ride on, don’t let them load the hay. Hop off! Zig-zag through the market.",
      "Charge along, try not to crash. Push through faster! Make a dash!",
      "Yay! Hurray! It's all mine! This red kite now belongs to me.",
      "Oh no! Another chase?"
    ],
    "sentences": [
      {
        "text_en": "Look! A kite fight!",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_000.mp3",
        "text_vi": "Nhìn kìa! Diều đang đánh nhau!"
      },
      {
        "text_en": "Oops! The purple kite is torn.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_001.mp3",
        "text_vi": "Ối! Con diều màu tím bị rách rồi."
      },
      {
        "text_en": "Oh no! The yellow one’s gone.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_002.mp3",
        "text_vi": "Ôi không! Con diều màu vàng bay mất rồi."
      },
      {
        "text_en": "Aha! The red kite floats down.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_003.mp3",
        "text_vi": "Aha! Con diều màu đỏ đang bay xuống."
      },
      {
        "text_en": "Climb up high.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_004.mp3",
        "text_vi": "Leo lên cao."
      },
      {
        "text_en": "Stretch out and grab!",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_005.mp3",
        "text_vi": "Vươn tay ra và tóm lấy!"
      },
      {
        "text_en": "Quick! Zoom away.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_006.mp3",
        "text_vi": "Nhanh lên! Chạy thật nhanh đi."
      },
      {
        "text_en": "Now step inside and hide.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_007.mp3",
        "text_vi": "Bây giờ bước vào trong và trốn đi."
      },
      {
        "text_en": "Sprint right through without a stop.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_008.mp3",
        "text_vi": "Chạy vút qua không ngừng."
      },
      {
        "text_en": "Slide over and dodge about.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_009.mp3",
        "text_vi": "Trượt qua và né tránh."
      },
      {
        "text_en": "Ride on, don’t let them load the hay.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_010.mp3",
        "text_vi": "Cứ đi tiếp đi, đừng để họ chất rơm lên."
      },
      {
        "text_en": "Hop off! Zig-zag through the market.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_011.mp3",
        "text_vi": "Nhảy xuống! Đi zíc-zắc qua chợ."
      },
      {
        "text_en": "Charge along, try not to crash.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_012.mp3",
        "text_vi": "Xông lên, cố gắng đừng để bị va chạm."
      },
      {
        "text_en": "Push through faster!",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_013.mp3",
        "text_vi": "Vượt qua nhanh hơn!"
      },
      {
        "text_en": "Make a dash!",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_014.mp3",
        "text_vi": "Chạy vút đi!"
      },
      {
        "text_en": "Yay! Hurray! It's all mine!",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_015.mp3",
        "text_vi": "Hoan hô! Hoan hô! Tất cả là của mình!"
      },
      {
        "text_en": "This red kite now belongs to me.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_016.mp3",
        "text_vi": "Con diều đỏ này bây giờ là của mình rồi."
      },
      {
        "text_en": "Oh no! Another chase?",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_11949/s_017.mp3",
        "text_vi": "Ôi không! Lại một cuộc rượt đuổi nữa sao?"
      }
    ]
  },
