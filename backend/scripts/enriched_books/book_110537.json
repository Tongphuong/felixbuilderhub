  "story": {
    "title": "Vegetables party.",
    "paragraphs_en": [
      "Once the vegetables planned a party.",
      "So Brinjal and Beetroot were hearty.",
      "Spinach and Banana came running.",
      "But Radish woke up late.",
      "Dressed in red, Tomato forgot the date.",
      "While Onion grew its hair tall,",
      "Garlic welcomed all.",
      "Cucumber offered flowers, green",
      "and Pumpkin ate the leaves, unseen.",
      "Bitter Gourd was feeling hot.",
      "So Chilli said \"Thank you\" to the lot."
    ],
    "sentences": [
      {
        "text_en": "Once the vegetables planned a party.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_000.mp3",
        "text_vi": "Ngày xưa, các loại rau củ rủ nhau tổ chức một bữa tiệc."
      },
      {
        "text_en": "So Brinjal and Beetroot were hearty.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_001.mp3",
        "text_vi": "Thế là Cà tím và Củ dền rất vui vẻ."
      },
      {
        "text_en": "Spinach and Banana came running.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_002.mp3",
        "text_vi": "Rau chân vịt và Chuối chạy đến."
      },
      {
        "text_en": "But Radish woke up late.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_003.mp3",
        "text_vi": "Nhưng Củ cải thì thức dậy muộn."
      },
      {
        "text_en": "Dressed in red, Tomato forgot the date.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_004.mp3",
        "text_vi": "Cà chua mặc đồ đỏ, quên mất ngày hẹn."
      },
      {
        "text_en": "While Onion grew its hair tall,",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_005.mp3",
        "text_vi": "Trong khi Hành tây mọc tóc dài."
      },
      {
        "text_en": "Garlic welcomed all.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_006.mp3",
        "text_vi": "Tỏi chào đón tất cả mọi người."
      },
      {
        "text_en": "Cucumber offered flowers, green",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_007.mp3",
        "text_vi": "Dưa chuột mang tặng những bông hoa xanh."
      },
      {
        "text_en": "and Pumpkin ate the leaves, unseen.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_008.mp3",
        "text_vi": "và Bí ngô ăn lá cây, không ai thấy."
      },
      {
        "text_en": "Bitter Gourd was feeling hot.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_009.mp3",
        "text_vi": "Mướp đắng thì cảm thấy nóng."
      },
      {
        "text_en": "So Chilli said \"Thank you\" to the lot.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110537/s_010.mp3",
        "text_vi": "Thế là Ớt nói \"Cảm ơn\" tất cả."
      }
    ]
  },
