  "story": {
    "title": "Busy Busy Sun",
    "paragraphs_en": [
      "The sun rises in the morning, by the east side. I hear the cock crow at dawn.",
      "The sun moves over Terfa's compound before the morning meal. I smell the aroma of bier and akpupa following the sun to my window.",
      "The sun goes behind a tree at school during lunchtime. Then it arrives in a puddle in the middle of the playground.",
      "The sun stands above my head. My shadow stands beside me. I play the shadow game with my friends.",
      "My shadow grows bigger, then smaller. We run after it. My shadow grows longer, then shorter. We run after it.",
      "I stand, my friends stand. We see our shadows sway. We grow tired and return to class. After school, we go home.",
      "The sun yawns. I see the sun sink slowly in the west. I see my shadow on a wall. It is time to go to bed.",
      "The sun goes down behind the clouds. I lay down in my bed, and dream of the sun traveling afar."
    ],
    "sentences": [
      {
        "text_en": "The sun rises in the morning, by the east side.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_000.mp3",
        "text_vi": "Mặt trời mọc vào buổi sáng, ở phía đông."
      },
      {
        "text_en": "I hear the cock crow at dawn.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_001.mp3",
        "text_vi": "Tôi nghe tiếng gà trống gáy lúc bình minh."
      },
      {
        "text_en": "The sun moves over Terfa's compound before the morning meal.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_002.mp3",
        "text_vi": "Mặt trời di chuyển qua khu nhà của Terfa trước bữa ăn sáng."
      },
      {
        "text_en": "I smell the aroma of bier and akpupa following the sun to my window.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_003.mp3",
        "text_vi": "Tôi ngửi thấy mùi thơm của bia và akpupa theo ánh nắng đến cửa sổ của tôi."
      },
      {
        "text_en": "The sun goes behind a tree at school during lunchtime.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_004.mp3",
        "text_vi": "Mặt trời khuất sau một cái cây ở trường vào giờ ăn trưa."
      },
      {
        "text_en": "Then it arrives in a puddle in the middle of the playground.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_005.mp3",
        "text_vi": "Sau đó, nó chiếu xuống một vũng nước giữa sân chơi."
      },
      {
        "text_en": "The sun stands above my head.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_006.mp3",
        "text_vi": "Mặt trời đứng ngay trên đầu tôi."
      },
      {
        "text_en": "My shadow stands beside me.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_007.mp3",
        "text_vi": "Bóng của tôi đứng cạnh tôi."
      },
      {
        "text_en": "I play the shadow game with my friends.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_008.mp3",
        "text_vi": "Tôi chơi trò chơi bóng với bạn bè."
      },
      {
        "text_en": "My shadow grows bigger, then smaller.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_009.mp3",
        "text_vi": "Bóng của tôi lớn hơn, rồi nhỏ lại."
      },
      {
        "text_en": "We run after it.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_010.mp3",
        "text_vi": "Chúng tôi chạy theo nó."
      },
      {
        "text_en": "My shadow grows longer, then shorter.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_011.mp3",
        "text_vi": "Bóng của tôi dài hơn, rồi ngắn lại."
      },
      {
        "text_en": "We run after it.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_012.mp3",
        "text_vi": "Chúng tôi chạy theo nó."
      },
      {
        "text_en": "I stand, my friends stand.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_013.mp3",
        "text_vi": "Tôi đứng, bạn bè tôi cũng đứng."
      },
      {
        "text_en": "We see our shadows sway.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_014.mp3",
        "text_vi": "Chúng tôi thấy bóng của mình lắc lư."
      },
      {
        "text_en": "We grow tired and return to class.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_015.mp3",
        "text_vi": "Chúng tôi mệt và quay về lớp học."
      },
      {
        "text_en": "After school, we go home.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_016.mp3",
        "text_vi": "Sau giờ học, chúng tôi về nhà."
      },
      {
        "text_en": "The sun yawns.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_017.mp3",
        "text_vi": "Mặt trời ngáp."
      },
      {
        "text_en": "I see the sun sink slowly in the west.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_018.mp3",
        "text_vi": "Tôi thấy mặt trời lặn từ từ ở phía tây."
      },
      {
        "text_en": "I see my shadow on a wall.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_019.mp3",
        "text_vi": "Tôi thấy bóng của mình trên tường."
      },
      {
        "text_en": "It is time to go to bed.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_020.mp3",
        "text_vi": "Đã đến lúc đi ngủ."
      },
      {
        "text_en": "The sun goes down behind the clouds.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_021.mp3",
        "text_vi": "Mặt trời lặn sau những đám mây."
      },
      {
        "text_en": "I lay down in my bed, and dream of the sun traveling afar.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_146239/s_022.mp3",
        "text_vi": "Tôi nằm xuống giường, và mơ về mặt trời đi xa."
      }
    ]
  },
