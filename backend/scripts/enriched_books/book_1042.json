  "story": {
    "title": "My Best Friend",
    "paragraphs_en": [
      "I have a friend. She lives in my house.",
      "When I am happy, so is she.",
      "When I cry, she cries too.",
      "But I cannot hear her voice. My friend lives inside the mirror.",
      "“Come out,” I tell her, “we will play.” She does not come out.",
      "I am not happy. I go to sleep.",
      "She comes out of the mirror in my sleep! And we have fun.",
      "We play, we run, we shout and scream together.",
      "When I talk to her, she also talks to me.",
      "In the morning, my friend will go back into the mirror.",
      "But I don't mind at all. We will play again in my dreams!"
    ],
    "sentences": [
      {
        "text_en": "I have a friend.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_000.mp3",
        "text_vi": "Mình có một người bạn."
      },
      {
        "text_en": "She lives in my house.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_001.mp3",
        "text_vi": "Bạn ấy sống trong nhà mình."
      },
      {
        "text_en": "When I am happy, so is she.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_002.mp3",
        "text_vi": "Khi mình vui, bạn ấy cũng vui."
      },
      {
        "text_en": "When I cry, she cries too.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_003.mp3",
        "text_vi": "Khi mình khóc, bạn ấy cũng khóc."
      },
      {
        "text_en": "But I cannot hear her voice.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_004.mp3",
        "text_vi": "Nhưng mình không nghe thấy tiếng bạn ấy."
      },
      {
        "text_en": "My friend lives inside the mirror.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_005.mp3",
        "text_vi": "Bạn mình sống trong gương."
      },
      {
        "text_en": "“Come out,” I tell her, “we will play.” She does not come out.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_006.mp3",
        "text_vi": "Mình bảo bạn ấy: “Ra đây nào, chúng mình cùng chơi nhé!” Bạn ấy không ra."
      },
      {
        "text_en": "I am not happy.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_007.mp3",
        "text_vi": "Mình không vui."
      },
      {
        "text_en": "I go to sleep.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_008.mp3",
        "text_vi": "Mình đi ngủ."
      },
      {
        "text_en": "She comes out of the mirror in my sleep!",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_009.mp3",
        "text_vi": "Trong giấc ngủ, bạn ấy ra khỏi gương!"
      },
      {
        "text_en": "And we have fun.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_010.mp3",
        "text_vi": "Và chúng mình chơi vui lắm."
      },
      {
        "text_en": "We play, we run, we shout and scream together.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_011.mp3",
        "text_vi": "Chúng mình chơi, chạy, la hét và reo hò cùng nhau."
      },
      {
        "text_en": "When I talk to her, she also talks to me.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_012.mp3",
        "text_vi": "Khi mình nói chuyện với bạn ấy, bạn ấy cũng nói chuyện với mình."
      },
      {
        "text_en": "In the morning, my friend will go back into the mirror.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_013.mp3",
        "text_vi": "Sáng hôm sau, bạn mình sẽ quay lại trong gương."
      },
      {
        "text_en": "But I don't mind at all.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_014.mp3",
        "text_vi": "Nhưng mình không bận tâm chút nào."
      },
      {
        "text_en": "We will play again in my dreams!",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1042/s_015.mp3",
        "text_vi": "Chúng mình sẽ lại chơi trong giấc mơ của mình!"
      }
    ]
  },
