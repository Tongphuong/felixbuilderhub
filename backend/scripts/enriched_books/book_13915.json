  "story": {
    "title": "Katiiti’s Song",
    "paragraphs_en": [
      "Katiiti lived in a village next to a forest.",
      "She loved playing in the forest. Maama told her to be careful.",
      "Every day Maama would sing their special song to call her.",
      "One day, Katiiti bumped into a gorilla.",
      "She ran and hid in a cave.",
      "Gorilla came and sang Maama’s song in a gruff voice.",
      "Gorilla ate lots of bananas to make his voice sweeter.",
      "Gorilla sang sweetishly.",
      "Gorilla went away and ate lots of honey to make his voice even sweeter.",
      "Gorilla sang as sweetly as Maama.",
      "Maama came just in time to chase away Gorilla.",
      "Katiiti and Maama sang all the way back home."
    ],
    "sentences": [
      {
        "text_en": "Katiiti lived in a village next to a forest.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_000.mp3",
        "text_vi": "Katiiti sống trong một ngôi làng cạnh khu rừng."
      },
      {
        "text_en": "She loved playing in the forest.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_001.mp3",
        "text_vi": "Cô bé rất thích chơi trong rừng."
      },
      {
        "text_en": "Maama told her to be careful.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_002.mp3",
        "text_vi": "Maama dặn cô bé phải cẩn thận."
      },
      {
        "text_en": "Every day Maama would sing their special song to call her.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_003.mp3",
        "text_vi": "Ngày nào Maama cũng hát bài hát đặc biệt của họ để gọi cô bé về."
      },
      {
        "text_en": "One day, Katiiti bumped into a gorilla.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_004.mp3",
        "text_vi": "Một ngày nọ, Katiiti đụng phải một con khỉ đột."
      },
      {
        "text_en": "She ran and hid in a cave.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_005.mp3",
        "text_vi": "Cô bé chạy trốn vào một cái hang."
      },
      {
        "text_en": "Gorilla came and sang Maama’s song in a gruff voice.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_006.mp3",
        "text_vi": "Khỉ đột đến và hát bài hát của Maama bằng giọng khàn khàn."
      },
      {
        "text_en": "Gorilla ate lots of bananas to make his voice sweeter.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_007.mp3",
        "text_vi": "Khỉ đột ăn rất nhiều chuối để giọng mình ngọt hơn."
      },
      {
        "text_en": "Gorilla sang sweetishly.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_008.mp3",
        "text_vi": "Khỉ đột hát một cách ngọt ngào."
      },
      {
        "text_en": "Gorilla went away and ate lots of honey to make his voice even sweeter.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_009.mp3",
        "text_vi": "Khỉ đột bỏ đi và ăn rất nhiều mật ong để giọng mình còn ngọt hơn nữa."
      },
      {
        "text_en": "Gorilla sang as sweetly as Maama.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_010.mp3",
        "text_vi": "Khỉ đột hát ngọt ngào như Maama."
      },
      {
        "text_en": "Maama came just in time to chase away Gorilla.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_011.mp3",
        "text_vi": "Maama đến đúng lúc để đuổi Khỉ đột đi."
      },
      {
        "text_en": "Katiiti and Maama sang all the way back home.",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_13915/s_012.mp3",
        "text_vi": "Katiiti và Maama vừa đi vừa hát suốt đường về nhà."
      }
    ]
  },
