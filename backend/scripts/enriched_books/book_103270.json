  "story": {
    "title": "Everyone Eats",
    "paragraphs_en": [
      "This is Cow.",
      "Cow eats grass.",
      "This is Chicken.",
      "Chicken eats corn.",
      "This is Horse.",
      "Horse eats a banana tree.",
      "This is Elephant.",
      "Elephant eats sugarcane.",
      "This is Lion.",
      "Lion eats raw meat.",
      "They all live by eating food.",
      "But Lion’s food is different. Lion eats meat while the other animals eat plants."
    ],
    "sentences": [
      {
        "text_en": "This is Cow.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_000.mp3",
        "text_vi": "Đây là Bò."
      },
      {
        "text_en": "Cow eats grass.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_001.mp3",
        "text_vi": "Bò ăn cỏ."
      },
      {
        "text_en": "This is Chicken.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_002.mp3",
        "text_vi": "Đây là Gà."
      },
      {
        "text_en": "Chicken eats corn.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_003.mp3",
        "text_vi": "Gà ăn ngô."
      },
      {
        "text_en": "This is Horse.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_004.mp3",
        "text_vi": "Đây là Ngựa."
      },
      {
        "text_en": "Horse eats a banana tree.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_005.mp3",
        "text_vi": "Ngựa ăn cây chuối."
      },
      {
        "text_en": "This is Elephant.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_006.mp3",
        "text_vi": "Đây là Voi."
      },
      {
        "text_en": "Elephant eats sugarcane.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_007.mp3",
        "text_vi": "Voi ăn mía."
      },
      {
        "text_en": "This is Lion.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_008.mp3",
        "text_vi": "Đây là Sư tử."
      },
      {
        "text_en": "Lion eats raw meat.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_009.mp3",
        "text_vi": "Sư tử ăn thịt sống."
      },
      {
        "text_en": "They all live by eating food.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_010.mp3",
        "text_vi": "Tất cả chúng đều sống nhờ ăn thức ăn."
      },
      {
        "text_en": "But Lion’s food is different.",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_011.mp3",
        "text_vi": "Nhưng thức ăn của Sư tử thì khác."
      },
      {
        "text_en": "Lion eats meat while the other animals eat plants.",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_103270/s_012.mp3",
        "text_vi": "Sư tử ăn thịt, còn các con vật khác thì ăn thực vật."
      }
