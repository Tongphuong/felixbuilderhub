  "story": {
    "title": "My story",
    "paragraphs_en": [
      "Who am I? I am a seed.",
      "I was buried under the ground. Then, the root and the stem grew out of me.",
      "Then, the leaves grew bigger.",
      "A lot of my leaves came out and I became a plant.",
      "Slowly, I began to grow.",
      "A few years later, I became a tree.",
      "Fruits grew on me. Do you wish to eat them?",
      "I am a fruit. What will you do after you eat me?",
      "Take my seed and bury it under the ground. Then I will become a tree."
    ],
    "sentences": [
      {
        "text_en": "Who am I?",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_000.mp3",
        "text_vi": "Tôi là ai?"
      },
      {
        "text_en": "I am a seed.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_001.mp3",
        "text_vi": "Tôi là một hạt giống."
      },
      {
        "text_en": "I was buried under the ground.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_002.mp3",
        "text_vi": "Tôi đã được chôn dưới đất."
      },
      {
        "text_en": "Then, the root and the stem grew out of me.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_003.mp3",
        "text_vi": "Sau đó, rễ và thân cây mọc ra từ tôi."
      },
      {
        "text_en": "Then, the leaves grew bigger.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_004.mp3",
        "text_vi": "Sau đó, những chiếc lá lớn hơn."
      },
      {
        "text_en": "A lot of my leaves came out and I became a plant.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_005.mp3",
        "text_vi": "Rất nhiều lá của tôi mọc ra và tôi trở thành một cái cây con."
      },
      {
        "text_en": "Slowly, I began to grow.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_006.mp3",
        "text_vi": "Từ từ, tôi bắt đầu lớn lên."
      },
      {
        "text_en": "A few years later, I became a tree.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_007.mp3",
        "text_vi": "Vài năm sau, tôi trở thành một cái cây lớn."
      },
      {
        "text_en": "Fruits grew on me.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_008.mp3",
        "text_vi": "Trái cây mọc trên tôi."
      },
      {
        "text_en": "Do you wish to eat them?",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_009.mp3",
        "text_vi": "Bạn có muốn ăn chúng không?"
      },
      {
        "text_en": "I am a fruit.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_010.mp3",
        "text_vi": "Tôi là một quả trái cây."
      },
      {
        "text_en": "What will you do after you eat me?",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_011.mp3",
        "text_vi": "Bạn sẽ làm gì sau khi ăn tôi?"
      },
      {
        "text_en": "Take my seed and bury it under the ground.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_012.mp3",
        "text_vi": "Hãy lấy hạt của tôi và chôn nó xuống đất."
      },
      {
        "text_en": "Then I will become a tree.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128171/s_013.mp3",
        "text_vi": "Sau đó tôi sẽ trở thành một cái cây."
      }
    ]
  },
