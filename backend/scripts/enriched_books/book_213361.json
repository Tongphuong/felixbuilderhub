  "story": {
    "title": "Raju and Muniya",
    "paragraphs_en": [
      "The spinning top is green and blue.",
      "Muniya’s skirt is yellow.",
      "Raju’s bed is blue.",
      "The spinning top spins round and round.",
      "Muniya dances on the ground.",
      "Raju jumps up and down.",
      "Looking at them, mother smiles.",
      "And joins them as they dance in style!"
    ],
    "sentences": [
      {
        "text_en": "The spinning top is green and blue.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213361/s_000.mp3",
        "text_vi": "Con quay màu xanh lá và xanh dương."
      },
      {
        "text_en": "Muniya’s skirt is yellow.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213361/s_001.mp3",
        "text_vi": "Váy của Muniya màu vàng."
      },
      {
        "text_en": "Raju’s bed is blue.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213361/s_002.mp3",
        "text_vi": "Giường của Raju màu xanh dương."
      },
      {
        "text_en": "The spinning top spins round and round.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213361/s_003.mp3",
        "text_vi": "Con quay quay tròn tròn."
      },
      {
        "text_en": "Muniya dances on the ground.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213361/s_004.mp3",
        "text_vi": "Muniya nhảy múa trên mặt đất."
      },
      {
        "text_en": "Raju jumps up and down.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213361/s_005.mp3",
        "text_vi": "Raju nhảy lên nhảy xuống."
      },
      {
        "text_en": "Looking at them, mother smiles.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213361/s_006.mp3",
        "text_vi": "Nhìn các bạn ấy, mẹ mỉm cười."
      },
      {
        "text_en": "And joins them as they dance in style!",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_213361/s_007.mp3",
        "text_vi": "Và cùng tham gia nhảy múa thật đẹp!"
      }
    ]
