  "story": {
    "title": "Let's Fly",
    "paragraphs_en": [
      "Bird can fly. Parrot can fly.",
      "Horse cannot fly.",
      "Fly can fly. Cicada can fly.",
      "Lizard cannot fly.",
      "Owl can fly. Pelican can fly.",
      "Gibbon cannot fly.",
      "Egret can fly. Hornbill can fly.",
      "Lion cannot fly.",
      "Tawny owl can fly. Mosquito can fly.",
      "Sheep cannot fly.",
      "Someday we will fly.",
      "I want to fly too."
    ],
