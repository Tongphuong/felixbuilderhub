  "story": {
    "title": "my self",
    "paragraphs_en": [
      "MY SELF ﻿",
      "Morning I will wake & I will brush & go to bath . I will eat my break fast and I will go to school. My father, mother, sister they good bye..........",
      "I will sit in our village bus stop. I will wait until the bus comes. The bus stop at the bus stop and I will go to the school........",
      "All the kids were going to school and i am also going to school.All the freinds are happy",
      "I will go to the school and study a lot and play a lot. We will eat the lunch by 12:30.................",
      "After the school over we will go to home happy .......... SCHOOL IS THE PLACE WHERE WE WILL LEARN EVERYTHING. SCHOOL IS TEMPLE TEACHER IS A GOD. THANK YOU............ ﻿"
    ],
    "sentences": [
      {
        "text_en": "MY SELF ﻿",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_000.mp3",
        "text_vi": "BẢN THÂN TÔI"
      },
      {
        "text_en": "Morning I will wake & I will brush & go to bath .",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_001.mp3",
        "text_vi": "Buổi sáng, con sẽ thức dậy, đánh răng và đi tắm."
      },
      {
        "text_en": "I will eat my break fast and I will go to school.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_002.mp3",
        "text_vi": "Con sẽ ăn sáng rồi đi học."
      },
      {
        "text_en": "My father, mother, sister they good bye..........",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_003.mp3",
        "text_vi": "Bố, mẹ, chị của con sẽ chào tạm biệt."
      },
      {
        "text_en": "I will sit in our village bus stop.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_004.mp3",
        "text_vi": "Con sẽ ngồi ở trạm xe buýt của làng mình."
      },
      {
        "text_en": "I will wait until the bus comes.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_005.mp3",
        "text_vi": "Con sẽ đợi cho đến khi xe buýt đến."
      },
      {
        "text_en": "The bus stop at the bus stop and I will go to the school........",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_006.mp3",
        "text_vi": "Xe buýt dừng ở trạm và con sẽ đi đến trường."
      },
      {
        "text_en": "All the kids were going to school and i am also going to school.All the freinds are happy",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_007.mp3",
        "text_vi": "Tất cả các bạn nhỏ đều đi học và con cũng đi học. Tất cả bạn bè đều vui vẻ."
      },
      {
        "text_en": "I will go to the school and study a lot and play a lot.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_008.mp3",
        "text_vi": "Con sẽ đến trường học thật nhiều và chơi thật nhiều."
      },
      {
        "text_en": "We will eat the lunch by 12:30.................",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_009.mp3",
        "text_vi": "Chúng con sẽ ăn trưa vào lúc 12 giờ 30 phút."
      },
      {
        "text_en": "After the school over we will go to home happy ..........",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_010.mp3",
        "text_vi": "Sau khi tan học, chúng con sẽ vui vẻ về nhà."
      },
      {
        "text_en": "SCHOOL IS THE PLACE WHERE WE WILL LEARN EVERYTHING.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_011.mp3",
        "text_vi": "TRƯỜNG HỌC LÀ NƠI CHÚNG TA SẼ HỌC ĐƯỢC MỌI THỨ."
      },
      {
        "text_en": "SCHOOL IS TEMPLE TEACHER IS A GOD.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_012.mp3",
        "text_vi": "TRƯỜNG HỌC LÀ NGÔI ĐỀN, THẦY CÔ LÀ THẦN LINH."
      },
      {
        "text_en": "THANK YOU............ ﻿",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_12143/s_013.mp3",
        "text_vi": "XIN CẢM ƠN."
      }
    ]
  },
