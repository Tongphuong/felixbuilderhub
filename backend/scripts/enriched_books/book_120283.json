  "story": {
    "title": "Race",
    "paragraphs_en": [
      "Four friends decide to have a race with their toys.",
      "Veena has a green car . Meena has a yellow auto .",
      "Sanju has a red bus . and , Manju has a blue truck .",
      "Ready 1....2....3....Go! Look! Here comes Lucky .",
      "HaHaHa....... Lucky started running . Look Look ! Lucky is running faster than everyone. Lucky wins the race ."
    ],
    "sentences": [
