      {
        "text_en": "Of course, it was Vayu, the Wind!",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_16/s_024.mp3",
        "text_vi": "Chắc chắn rồi, đó là Vayu, Thần Gió!"
