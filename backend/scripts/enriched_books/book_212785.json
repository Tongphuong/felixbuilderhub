  "story": {
    "title": "The Sun and The Moon",
    "paragraphs_en": [
      "It's morning.",
      "The sun is out.",
      "Rising in the east…",
      "setting in the west.",
      "It’s night now…",
      "and the moon is out.",
      "Sometimes a half moon…",
      "sometimes a full moon!",
      "But how do they change so soon?"
    ],
    "sentences": [
      {
        "text_en": "It's morning.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_212785/s_000.mp3",
        "text_vi": "Trời sáng rồi."
      },
      {
        "text_en": "The sun is out.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_212785/s_001.mp3",
        "text_vi": "Mặt trời đã lên rồi."
      },
      {
        "text_en": "Rising in the east…",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_212785/s_002.mp3",
        "text_vi": "Mọc ở phía đông…"
      },
      {
        "text_en": "setting in the west.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_212785/s_003.mp3",
        "text_vi": "lặn ở phía tây."
      },
      {
        "text_en": "It’s night now…",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_212785/s_004.mp3",
        "text_vi": "Bây giờ là buổi tối rồi…"
      },
      {
        "text_en": "and the moon is out.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_212785/s_005.mp3",
        "text_vi": "và mặt trăng đã lên."
      },
      {
        "text_en": "Sometimes a half moon…",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_212785/s_006.mp3",
        "text_vi": "Đôi khi là trăng khuyết…"
      },
      {
        "text_en": "sometimes a full moon!",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_212785/s_007.mp3",
        "text_vi": "đôi khi là trăng tròn!"
      },
      {
        "text_en": "But how do they change so soon?",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_212785/s_008.mp3",
        "text_vi": "Nhưng sao chúng lại thay đổi nhanh thế?"
      }
    ]
  },
