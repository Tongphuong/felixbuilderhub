  "story": {
    "title": "Tamarind tree",
    "paragraphs_en": [
      "﻿ ﻿ ﻿There is a big Tamarind tree. It is full of fruit.",
      "﻿ Raju and Rama are going to school. Rama, mom asked me to get some tamarind while returning from school.",
      "Ramu wait . I am coming uuuhhhh! Fast......",
      "Oh my God! How many...... Bow wow wow..... ﻿Uuu! How many fruits.....",
      "﻿Do you want tamarind? yeah! take it....",
      "﻿ ﻿So nice of you! Thank you tree. Hurray! My mom will be very happy They collected tamarind and started to home happily."
    ],
    "sentences": [
      {
        "text_en": "﻿ ﻿ ﻿There is a big Tamarind tree.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_000.mp3",
        "text_vi": "Có một cây me lớn."
      },
      {
        "text_en": "It is full of fruit.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_001.mp3",
        "text_vi": "Cây đầy trái."
      },
      {
        "text_en": "﻿ Raju and Rama are going to school.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_002.mp3",
        "text_vi": "Raju và Rama đang đi học."
      },
      {
        "text_en": "Rama, mom asked me to get some tamarind while returning from school.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_003.mp3",
        "text_vi": "Rama ơi, mẹ dặn con lấy me khi đi học về."
      },
      {
        "text_en": "Ramu wait .",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_004.mp3",
        "text_vi": "Ramu đợi đã."
      },
      {
        "text_en": "I am coming uuuhhhh! Fast......",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_005.mp3",
        "text_vi": "Tớ đến đây! Nhanh lên!"
      },
      {
        "text_en": "Oh my God!",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_006.mp3",
        "text_vi": "Ôi trời ơi!"
      },
      {
        "text_en": "How many...... Bow wow wow.....",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_007.mp3",
        "text_vi": "Nhiều quá! Gâu gâu gâu....."
      },
      {
        "text_en": "﻿Uuu! How many fruits.....",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_008.mp3",
        "text_vi": "Uuu! Nhiều trái cây quá!"
      },
      {
        "text_en": "﻿Do you want tamarind?",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_009.mp3",
        "text_vi": "Cậu có muốn me không?"
      },
      {
        "text_en": "yeah! take it....",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_010.mp3",
        "text_vi": "Có! Lấy đi!"
      },
      {
        "text_en": "﻿ ﻿So nice of you!",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_011.mp3",
        "text_vi": "Cậu thật tốt bụng!"
      },
      {
        "text_en": "Thank you tree.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_012.mp3",
        "text_vi": "Cảm ơn cây nhé."
      },
      {
        "text_en": "Hurray! My mom will be very happy They collected tamarind and started to home happily.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_128071/s_013.mp3",
        "text_vi": "Hoan hô! Mẹ tớ sẽ rất vui. Họ đã hái me và vui vẻ đi về nhà."
      }
    ]
  },
