  "story": {
    "title": "Kites in the sky",
    "paragraphs_en": [
      "The cat and the mice fly the pink kite.",
      "The purple kite touches the clouds.",
      "There is a blue kite in the blue sky.",
      "The yellow kite is attached to a spool.",
      "The green kite has long string.",
      "The white kite is sad.",
      "And the red kite is angry.",
      "Meena flies her orange kite near orange sun.",
      "The small kite has black eyes.",
      "﻿Guess the colours of the animal kites."
    ],
    "sentences": [
      {
        "text_en": "The cat and the mice fly the pink kite.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110452/s_000.mp3",
        "text_vi": "Con mèo và những chú chuột thả con diều màu hồng."
      },
      {
        "text_en": "The purple kite touches the clouds.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110452/s_001.mp3",
        "text_vi": "Con diều màu tím chạm vào những đám mây."
      },
      {
        "text_en": "There is a blue kite in the blue sky.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110452/s_002.mp3",
        "text_vi": "Có một con diều màu xanh dương trên bầu trời xanh dương."
      },
      {
        "text_en": "The yellow kite is attached to a spool.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110452/s_003.mp3",
        "text_vi": "Con diều màu vàng được buộc vào một cuộn chỉ."
      },
      {
        "text_en": "The green kite has long string.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110452/s_004.mp3",
        "text_vi": "Con diều màu xanh lá cây có sợi dây dài."
      },
      {
        "text_en": "The white kite is sad.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110452/s_005.mp3",
        "text_vi": "Con diều màu trắng buồn bã."
      },
      {
        "text_en": "And the red kite is angry.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110452/s_006.mp3",
        "text_vi": "Và con diều màu đỏ thì tức giận."
      },
      {
        "text_en": "Meena flies her orange kite near orange sun.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110452/s_007.mp3",
        "text_vi": "Meena thả con diều màu cam của cô ấy gần mặt trời màu cam."
      },
      {
        "text_en": "The small kite has black eyes.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110452/s_008.mp3",
        "text_vi": "Con diều nhỏ có đôi mắt màu đen."
      },
      {
        "text_en": "﻿Guess the colours of the animal kites.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_110452/s_009.mp3",
        "text_vi": "Hãy đoán màu sắc của những con diều hình con vật."
      }
    ]
  },
