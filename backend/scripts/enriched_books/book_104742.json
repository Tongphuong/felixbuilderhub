  "story": {
    "title": "How about you?",
    "paragraphs_en": [
      "Who are you?",
      "Is that goo? Eeuw! I want some too.",
      "We are two. How old are you? Six hundred and thirty two?",
      "I like blue. Do you too?",
      "I choose two shoes. Which do you choose?",
      "Horseshoes!?",
      "I make toys with boys.",
      "We make lots of noise. Whaaa! eurgghhh... aargh!",
      "I take a nap on Gogo’s back.",
      "I don’t nap!",
      "I stay upright all through the night.",
      "The ball goes THWOCK! Buddy, you ROCK!",
      "That’s what we do. How about you?"
    ],
    "sentences": [
      {
        "text_en": "Who are you?",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_000.mp3",
        "text_vi": "Bạn là ai?"
      },
      {
        "text_en": "Is that goo?",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_001.mp3",
        "text_vi": "Đó là chất nhầy à?"
      },
      {
        "text_en": "Eeuw! I want some too.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_002.mp3",
        "text_vi": "Eo ôi! Mình cũng muốn một ít."
      },
      {
        "text_en": "We are two.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_003.mp3",
        "text_vi": "Chúng mình có hai người."
      },
      {
        "text_en": "How old are you?",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_004.mp3",
        "text_vi": "Bạn bao nhiêu tuổi?"
      },
      {
        "text_en": "Six hundred and thirty two?",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_005.mp3",
        "text_vi": "Sáu trăm ba mươi hai tuổi ư?"
      },
      {
        "text_en": "I like blue.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_006.mp3",
        "text_vi": "Mình thích màu xanh dương."
      },
      {
        "text_en": "Do you too?",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_007.mp3",
        "text_vi": "Bạn cũng thích chứ?"
      },
      {
        "text_en": "I choose two shoes.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_008.mp3",
        "text_vi": "Mình chọn hai chiếc giày."
      },
      {
        "text_en": "Which do you choose?",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_009.mp3",
        "text_vi": "Bạn chọn chiếc nào?"
      },
      {
        "text_en": "Horseshoes!?",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_010.mp3",
        "text_vi": "Móng ngựa ư!?"
      },
      {
        "text_en": "I make toys with boys.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_011.mp3",
        "text_vi": "Mình làm đồ chơi với các bạn trai."
      },
      {
        "text_en": "We make lots of noise.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_012.mp3",
        "text_vi": "Chúng mình làm ồn ào lắm."
      },
      {
        "text_en": "Whaaa! eurgghhh... aargh!",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_013.mp3",
        "text_vi": "Whaaa! eurgghhh... aargh!"
      },
      {
        "text_en": "I take a nap on Gogo’s back.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_014.mp3",
        "text_vi": "Mình ngủ trưa trên lưng Gogo."
      },
      {
        "text_en": "I don’t nap!",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_015.mp3",
        "text_vi": "Mình không ngủ trưa!"
      },
      {
        "text_en": "I stay upright all through the night.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_016.mp3",
        "text_vi": "Mình đứng thẳng suốt cả đêm."
      },
      {
        "text_en": "The ball goes THWOCK!",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_017.mp3",
        "text_vi": "Quả bóng bay cái 'THWOCK'!"
      },
      {
        "text_en": "Buddy, you ROCK!",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_018.mp3",
        "text_vi": "Bạn ơi, bạn thật tuyệt!"
      },
      {
        "text_en": "That’s what we do.",
        "paragraph_index": 12,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_019.mp3",
        "text_vi": "Đó là điều chúng mình làm."
      },
      {
        "text_en": "How about you?",
        "paragraph_index": 12,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_104742/s_020.mp3",
        "text_vi": "Còn bạn thì sao?"
      }
    ]
  },
