  "story": {
    "title": "Can and Can't",
    "paragraphs_en": [
      "I can’t knit, cats can’t write, fish can’t blink...",
      "...pigs can’t fly!",
      "Dogs can’t dance, ants can’t read, crows can’t sing...",
      "...monkeys can’t cook!",
      "But , monkeys can swing!",
      "Crows can caw... ants can bite... dogs can bark!",
      "Pigs can eat, fish can swim, cats can jump... and I can read!"
    ],
    "sentences": [
      {
        "text_en": "I can’t knit, cats can’t write, fish can’t blink...",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_137/s_000.mp3",
        "text_vi": "Tôi không biết đan, mèo không biết viết, cá không biết chớp mắt..."
      },
      {
        "text_en": "...pigs can’t fly!",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_137/s_001.mp3",
        "text_vi": "...heo không biết bay!"
      },
      {
        "text_en": "Dogs can’t dance, ants can’t read, crows can’t sing...",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_137/s_002.mp3",
        "text_vi": "Chó không biết nhảy múa, kiến không biết đọc, quạ không biết hát..."
      },
      {
        "text_en": "...monkeys can’t cook!",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_137/s_003.mp3",
        "text_vi": "...khỉ không biết nấu ăn!"
      },
      {
        "text_en": "But , monkeys can swing!",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_137/s_004.mp3",
        "text_vi": "Nhưng mà, khỉ biết đu dây!"
      },
      {
        "text_en": "Crows can caw...",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_137/s_005.mp3",
        "text_vi": "Quạ biết kêu quạ quạ..."
      },
      {
        "text_en": "ants can bite...",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_137/s_006.mp3",
        "text_vi": "kiến biết cắn..."
      },
      {
        "text_en": "dogs can bark!",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_137/s_007.mp3",
        "text_vi": "chó biết sủa!"
      },
      {
        "text_en": "Pigs can eat, fish can swim, cats can jump...",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_137/s_008.mp3",
        "text_vi": "Heo biết ăn, cá biết bơi, mèo biết nhảy..."
      },
      {
        "text_en": "and I can read!",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_137/s_009.mp3",
        "text_vi": "và tôi biết đọc!"
      }
    ]
