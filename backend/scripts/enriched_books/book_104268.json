  "story": {
    "title": "When will the bell ring?",
    "paragraphs_en": [
      "I am sitting in class.",
      "It is raining outside.",
      "I am feeling cold. Brrrr!",
      "I need to go to the restroom. But I cannot go during class!",
      "When will the bell ring? Will it ring after this class?",
      "Will it ring after Maths class?",
      "Will it ring after the test?",
      "When will the bell ring?",
      "Ring! Ring! Ring!",
      "Yay! That's the bell!"
    ],
