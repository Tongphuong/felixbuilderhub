  "story": {
    "title": "My Body",
    "paragraphs_en": [
      "I can run with it.",
      "I can jump with it.",
      "I can dance with it.",
      "I can swim with it.",
      "I can skip with it.",
      "I can kick with it.",
      "I can escape with it.",
      "But I can never fly with it."
    ],
    "sentences": [
