  "story": {
    "title": "Table",
    "paragraphs_en": [
      "We have a table at home.",
      "I study at the table.",
      "Mother listens to music at the table.",
      "Grandfather eats at the table.",
      "Father sings at the table.",
      "Brother writes at the table.",
      "Auntie sleeps on the table. But grandmother wakes her up!",
      "Everyone loves the table."
    ],
