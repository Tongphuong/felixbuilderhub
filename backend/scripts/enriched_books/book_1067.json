      {
        "text_en": "It is my duty to guard the house.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_005.mp3",
        "text_vi": "Nhiệm vụ của tôi là canh giữ nhà."
      },
      {
        "text_en": "We do everything together.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_006.mp3",
        "text_vi": "Chúng tôi làm mọi thứ cùng nhau."
      },
      {
        "text_en": "We work together.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_007.mp3",
        "text_vi": "Chúng tôi làm việc cùng nhau."
      },
      {
        "text_en": "We play together.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_008.mp3",
        "text_vi": "Chúng tôi chơi cùng nhau."
      },
      {
        "text_en": "We even share Ma’s scolding.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_009.mp3",
        "text_vi": "Chúng tôi thậm chí còn cùng nhau chịu lời mắng của mẹ."
      },
      {
        "text_en": "When Chinku is at school I help Ma.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_010.mp3",
        "text_vi": "Khi Chinku đi học, tôi giúp mẹ."
      },
      {
        "text_en": "I keep the crows away from the papads.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_011.mp3",
        "text_vi": "Tôi đuổi quạ không cho chúng lấy bánh papad."
      },
      {
        "text_en": "Today Chinku will be my teacher.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_012.mp3",
        "text_vi": "Hôm nay Chinku sẽ là thầy giáo của tôi."
      },
      {
        "text_en": "At last, I will learn something new.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_013.mp3",
        "text_vi": "Cuối cùng thì tôi cũng sẽ học được điều gì đó mới mẻ."
      },
      {
        "text_en": "I am a good doggy.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_014.mp3",
        "text_vi": "Tôi là một chú chó ngoan."
      },
      {
        "text_en": "I do not scare away cats.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_015.mp3",
        "text_vi": "Tôi không dọa mèo chạy mất."
      },
      {
        "text_en": "Are you Chinku’s friend?",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_016.mp3",
        "text_vi": "Bạn có phải là bạn của Chinku không?"
      },
      {
        "text_en": "Then you are my friend too.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_017.mp3",
        "text_vi": "Vậy thì bạn cũng là bạn của tôi."
      },
      {
        "text_en": "Read the following action sentences.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_018.mp3",
        "text_vi": "Hãy đọc các câu hành động dưới đây."
      },
      {
        "text_en": "Which of these activities do you like to do?",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_019.mp3",
        "text_vi": "Bạn thích làm hoạt động nào trong số này?"
      },
      {
        "text_en": "I like dancing.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_020.mp3",
        "text_vi": "Tôi thích nhảy múa."
      },
      {
        "text_en": "I like swimming.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_021.mp3",
        "text_vi": "Tôi thích bơi lội."
      },
      {
        "text_en": "I like skipping.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_022.mp3",
        "text_vi": "Tôi thích nhảy dây."
      },
      {
        "text_en": "I like drawing.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_023.mp3",
        "text_vi": "Tôi thích vẽ."
      },
      {
        "text_en": "I like cycling.",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_024.mp3",
        "text_vi": "Tôi thích đạp xe."
      },
      {
        "text_en": "I like climbing.",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_025.mp3",
        "text_vi": "Tôi thích leo trèo."
      },
      {
        "text_en": "Sometimes we say, “As faithful as a dog”.",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_026.mp3",
        "text_vi": "Đôi khi chúng ta nói, 'Trung thành như chó'."
      },
      {
        "text_en": "This is because a dog always stays close to its master.",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_027.mp3",
        "text_vi": "Điều này là vì chó luôn ở gần chủ của nó."
      },
      {
        "text_en": "If it goes far away or is lost, a dog always finds its way back home.",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_1067/s_028.mp3",
        "text_vi": "Nếu nó đi xa hoặc bị lạc, chó luôn tìm được đường về nhà."
      }
    ]
  },
