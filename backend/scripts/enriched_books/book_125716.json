        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_001.mp3",
        "text_vi": "Tôi thích mặc váy màu vàng."
      },
      {
        "text_en": "Which colour dress do you like to wear?",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_002.mp3",
        "text_vi": "Bạn thích mặc váy màu gì?"
      },
      {
        "text_en": "Mmm.Laddoos! I love to eat these sweet laddoos.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_003.mp3",
        "text_vi": "Mmm. Bánh Laddoo! Mình rất thích ăn những chiếc bánh laddoo ngọt ngào này."
      },
      {
        "text_en": "Do you know any other sweet like laddoo?",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_004.mp3",
        "text_vi": "Bạn có biết loại bánh ngọt nào khác giống bánh laddoo không?"
      },
      {
        "text_en": "I write with my pencil.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_005.mp3",
        "text_vi": "Mình viết bằng bút chì."
      },
      {
        "text_en": "I have two pencils in my box.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_006.mp3",
        "text_vi": "Mình có hai cây bút chì trong hộp."
      },
      {
        "text_en": "How many pencils do you have in your box?",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_007.mp3",
        "text_vi": "Bạn có bao nhiêu cây bút chì trong hộp của bạn?"
      },
      {
        "text_en": "Devi was a happy girl.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_008.mp3",
        "text_vi": "Devi là một cô bé vui vẻ."
      },
      {
        "text_en": "Her grandmother told her stories everyday.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_009.mp3",
        "text_vi": "Bà của cô bé kể chuyện cho cô bé nghe mỗi ngày."
      },
      {
        "text_en": "She felt happy listening to the stories.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_010.mp3",
        "text_vi": "Cô bé cảm thấy vui khi nghe những câu chuyện đó."
      },
      {
        "text_en": "Can you tell me something that made you happy?",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_011.mp3",
        "text_vi": "Bạn có thể kể cho mình nghe điều gì đó làm bạn vui không?"
      },
      {
        "text_en": "I am a short boy.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_012.mp3",
        "text_vi": "Mình là một cậu bé thấp."
      },
      {
        "text_en": "I cannot reach the cap kept on top shelf.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_013.mp3",
        "text_vi": "Mình không thể với tới cái mũ để trên kệ cao nhất."
      },
      {
        "text_en": "Are you short or are you tall?",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_014.mp3",
        "text_vi": "Bạn thấp hay bạn cao?"
      },
      {
        "text_en": "Is there anyone who is taller than you?",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_125716/s_015.mp3",
        "text_vi": "Có ai cao hơn bạn không?"
      }
    ]
