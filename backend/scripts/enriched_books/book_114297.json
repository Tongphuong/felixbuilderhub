        "text_vi": "Chúng cháu yêu thương nhau."
      },
      {
        "text_en": "We play together in our living room.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_003.mp3",
        "text_vi": "Chúng cháu chơi cùng nhau trong phòng khách."
      },
      {
        "text_en": "We have a bookshelf in our living room.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_004.mp3",
        "text_vi": "Nhà cháu có một giá sách trong phòng khách."
      },
      {
        "text_en": "My father keeps many books in the bookshelf.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_005.mp3",
        "text_vi": "Bố cháu để nhiều sách trên giá sách."
      },
      {
        "text_en": "I read one story everyday.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_006.mp3",
        "text_vi": "Cháu đọc một câu chuyện mỗi ngày."
      },
      {
        "text_en": "I am very neat.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_007.mp3",
        "text_vi": "Cháu rất gọn gàng."
      },
      {
        "text_en": "But my brother is very messy.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_008.mp3",
        "text_vi": "Nhưng anh trai cháu thì rất bừa bộn."
      },
      {
        "text_en": "He throws his toys, books, shoes and pens on the floor.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_009.mp3",
        "text_vi": "Anh ấy vứt đồ chơi, sách, giày và bút xuống sàn nhà."
      },
      {
        "text_en": "We have a sofa in our living room.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_010.mp3",
        "text_vi": "Nhà cháu có một chiếc ghế sofa trong phòng khách."
      },
      {
        "text_en": "My parents like to sit on the sofa.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_011.mp3",
        "text_vi": "Bố mẹ cháu thích ngồi trên ghế sofa."
      },
      {
        "text_en": "We also have a carpet in our living room.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_012.mp3",
        "text_vi": "Chúng cháu cũng có một tấm thảm trong phòng khách."
      },
      {
        "text_en": "The carpet is on the floor.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_013.mp3",
        "text_vi": "Tấm thảm ở trên sàn nhà."
      },
      {
        "text_en": "I like to sit on the carpet.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_014.mp3",
        "text_vi": "Cháu thích ngồi trên tấm thảm."
      },
      {
        "text_en": "My brother and I help our mother in cleaning the house.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_015.mp3",
        "text_vi": "Anh trai cháu và cháu giúp mẹ dọn dẹp nhà cửa."
      },
      {
        "text_en": "I sweep the floor.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_016.mp3",
        "text_vi": "Cháu quét sàn nhà."
      },
      {
        "text_en": "My brother cleans the bookshelf.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_017.mp3",
        "text_vi": "Anh trai cháu lau giá sách."
      },
      {
        "text_en": "We love our home a lot.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_114297/s_018.mp3",
        "text_vi": "Chúng cháu rất yêu ngôi nhà của mình."
      }
    ]
