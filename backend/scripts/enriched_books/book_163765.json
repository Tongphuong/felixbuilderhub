  "story": {
    "title": "Happy Akai",
    "paragraphs_en": [
      "Akai had no shoes. Other children her age had shoes.",
      "“It is difficult to play without shoes,” said Akai to her mother.",
      "“Akai, I think it is time for you to have shoes,” said mother.",
      "Mother woke up Akai early the next morning.",
      "Akai and her mother went to the market.",
      "They went into a shoe shop. Mother bought shoes for Akai.",
      "At night, Akai thought about her new shoes.",
      "Akai put on her new shoes.",
      "Akai thought about how she would show off her shoes.",
      "Akai wore her new shoes again. She danced around the room.",
      "“Akai, you must not wear shoes in bed,” said mother.",
      "Akai was so happy to have shoes for the first time."
    ],
    "sentences": [
      {
        "text_en": "Akai had no shoes.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_000.mp3",
        "text_vi": "Akai không có giày."
      },
      {
        "text_en": "Other children her age had shoes.",
        "paragraph_index": 0,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_001.mp3",
        "text_vi": "Những bạn khác bằng tuổi Akai đều có giày."
      },
      {
        "text_en": "“It is difficult to play without shoes,” said Akai to her mother.",
        "paragraph_index": 1,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_002.mp3",
        "text_vi": "\"Chơi mà không có giày thì khó lắm,\" Akai nói với mẹ."
      },
      {
        "text_en": "“Akai, I think it is time for you to have shoes,” said mother.",
        "paragraph_index": 2,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_003.mp3",
        "text_vi": "\"Akai à, mẹ nghĩ đã đến lúc con có giày rồi,\" mẹ nói."
      },
      {
        "text_en": "Mother woke up Akai early the next morning.",
        "paragraph_index": 3,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_004.mp3",
        "text_vi": "Sáng hôm sau, mẹ đánh thức Akai dậy sớm."
      },
      {
        "text_en": "Akai and her mother went to the market.",
        "paragraph_index": 4,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_005.mp3",
        "text_vi": "Akai và mẹ đi chợ."
      },
      {
        "text_en": "They went into a shoe shop.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_006.mp3",
        "text_vi": "Họ vào một cửa hàng giày."
      },
      {
        "text_en": "Mother bought shoes for Akai.",
        "paragraph_index": 5,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_007.mp3",
        "text_vi": "Mẹ mua giày cho Akai."
      },
      {
        "text_en": "At night, Akai thought about her new shoes.",
        "paragraph_index": 6,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_008.mp3",
        "text_vi": "Vào buổi tối, Akai nghĩ về đôi giày mới của mình."
      },
      {
        "text_en": "Akai put on her new shoes.",
        "paragraph_index": 7,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_009.mp3",
        "text_vi": "Akai đi đôi giày mới của mình vào."
      },
      {
        "text_en": "Akai thought about how she would show off her shoes.",
        "paragraph_index": 8,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_010.mp3",
        "text_vi": "Akai nghĩ xem mình sẽ khoe đôi giày như thế nào."
      },
      {
        "text_en": "Akai wore her new shoes again.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_011.mp3",
        "text_vi": "Akai lại đi đôi giày mới của mình."
      },
      {
        "text_en": "She danced around the room.",
        "paragraph_index": 9,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_012.mp3",
        "text_vi": "Cô bé nhảy múa quanh phòng."
      },
      {
        "text_en": "“Akai, you must not wear shoes in bed,” said mother.",
        "paragraph_index": 10,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_013.mp3",
        "text_vi": "\"Akai, con không được đi giày lên giường đâu nhé,\" mẹ nói."
      },
      {
        "text_en": "Akai was so happy to have shoes for the first time.",
        "paragraph_index": 11,
        "audio_url": "https://audio.felixbuilderhub.com/books/book_163765/s_014.mp3",
        "text_vi": "Akai rất vui vì lần đầu tiên có giày."
      }
    ]
  },
