                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "followup_state": {
                "enum": [
                  "answered",
                  "skipped"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "understand_saved",
                  "shadowing",
                  "mini_story",
                  "retell",
                  "complete"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "repair_state": {
                "enum": [
                  "not_needed",
                  "answered",
                  "skipped"
                ]
              }
            }
          }
        },
        {
