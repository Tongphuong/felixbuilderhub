        "schema_version": {
          "const": "1.2.0"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "child_id": {
          "type": "string",
          "minLength": 1
        },
        "lesson_id": {
          "type": "string",
          "minLength": 1
        },
        "content_version": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rubric_version": {
          "const": "practice-rubric-1"
        },
        "engine_version": {
          "const": "self-learn-2"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "enum": [
            "pre_read",
            "input",
            "comprehension",
            "understand_saved",
            "shadowing",
            "mini_story",
            "retell",
            "complete"
          ]
        },
        "input_mode": {
          "enum": [
            "listening_only",
            "audio_assisted_reading",
            "independent_reading",
            null
          ]
        },
        "status": {
          "enum": [
            "active",
            "saved",
            "complete"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "acknowledged_request_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "input_order": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "listen"
            ]
          }
        },
        "question_cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "dialogue_cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "repair_state": {
          "enum": [
            "not_needed",
            "available",
            "shown",
            "answered",
            "skipped"
          ]
        },
        "followup_state": {
          "enum": [
            "locked",
            "ready",
            "answered",
            "skipped"
          ]
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "child_id",
        "lesson_id",
        "content_version",
        "content_sha256",
        "rubric_version",
        "engine_version",
        "revision",
        "stage",
        "input_mode",
        "status",
        "created_at",
        "updated_at",
        "acknowledged_request_ids",
        "evidence_ids",
        "input_order",
        "question_cursor",
        "dialogue_cursor",
        "repair_state",
        "followup_state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "const": "complete"
              }
            }
          }
        },
        {
