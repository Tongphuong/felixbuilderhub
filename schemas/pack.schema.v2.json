{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://read2lead.felixbuilderhub.com/schemas/pack.schema.v2.json",
  "title": "Read2Lead Pack V2",
  "description": "Schema for a V2 Read2Lead pack: story + 5 web activities + rewards. Replaces V1 chunk-based schema.",
  "type": "object",
  "required": [
    "story",
    "activities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "student_name": { "type": "string", "minLength": 1, "maxLength": 50 },
    "level": { "type": "string", "enum": ["L1", "L2", "L3", "L4", "L5"] },
    "level_label": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1, "maxLength": 80 },
    "slug": { "type": "string", "pattern": "^[a-z0-9_]+$", "minLength": 1, "maxLength": 100 },
    "audio_filename": { "type": "string", "pattern": "\\.mp3$" },

    "story": {
      "type": "object",
      "required": ["title", "paragraphs_en", "sentences"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "paragraphs_en": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": { "type": "string", "minLength": 1 }
        },
        "paragraphs_vi": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": { "type": "string", "minLength": 1 }
        },
        "full_audio_url": { "type": "string" },
        "trivia_vi": { "type": "string", "minLength": 20, "maxLength": 200 },
        "trivia_en": { "type": "string", "minLength": 20, "maxLength": 200 },
        "sentences": {
          "type": "array",
          "minItems": 6,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["text_en", "paragraph_index"],
            "additionalProperties": false,
            "properties": {
              "text_en": { "type": "string", "minLength": 1 },
              "text_vi": { "type": "string", "minLength": 1 },
              "audio_url": { "type": "string" },
              "paragraph_index": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },

    "activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/listening_fill_blank" },
          { "$ref": "#/definitions/listen_and_order" },
          { "$ref": "#/definitions/reading_comprehension" },
          { "$ref": "#/definitions/written_response" },
          { "$ref": "#/definitions/listen_and_speak" },
          { "$ref": "#/definitions/read_aloud" },
          { "$ref": "#/definitions/book_read_aloud" }
        ]
      }
    },

    "guided_listening": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/guided_listening_paragraph" }
    },

    "rewards": {
      "type": "object",
      "required": ["coins_on_complete", "xp_on_complete", "bonus_coins_per_activity_attempted"],
      "additionalProperties": false,
      "properties": {
        "coins_on_complete": { "type": "integer", "minimum": 10, "maximum": 30 },
        "xp_on_complete": { "type": "integer", "minimum": 10, "maximum": 40 },
        "bonus_coins_per_activity_attempted": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },

    "parent_note_vi": { "type": "string", "minLength": 10, "maxLength": 400 },
    "next_suggestion_vi": { "type": "string", "minLength": 10, "maxLength": 200 },
    "book_slug": { "type": "string", "pattern": "^book_[0-9]+$", "maxLength": 100 },
    "book_images": {
      "type": "array",
      "minItems": 3,
      "maxItems": 24,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "book_page_audio": {
      "type": "array",
      "minItems": 3,
      "maxItems": 24,
      "items": { "type": "string", "format": "uri", "pattern": "^https://.*\\.mp3(?:[?#].*)?$" }
    },
    "book_attribution": { "$ref": "#/definitions/book_attribution" }
  },

  "allOf": [
    {
      "if": { "required": ["book_slug"] },
      "then": {
        "required": [
          "schema_version",
          "level",
          "slug",
          "audio_filename",
          "guided_listening",
          "book_images",
          "book_page_audio",
          "book_attribution"
        ],
        "properties": {
          "slug": { "pattern": "^book_[0-9]+$" },
          "audio_filename": { "pattern": "\\.mp3$" },
          "story": {
            "properties": {
              "paragraphs_en": { "minItems": 3, "maxItems": 24 },
              "sentences": { "minItems": 10, "maxItems": 200 }
            }
          },
          "activities": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "oneOf": [
                { "$ref": "#/definitions/book_read_aloud" }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "activities": { "minItems": 4, "maxItems": 6 }
        }
      }
    }
  ],

  "definitions": {
    "guided_listening_paragraph": {
      "type": "object",
      "required": ["paragraph_index", "questions"],
      "additionalProperties": false,
      "properties": {
        "paragraph_index": { "type": "integer", "minimum": 0 },
        "questions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/guided_listening_choice_v3" }
        }
      }
    },

    "guided_listening_choice_v3": {
      "type": "object",
      "required": ["id", "type", "question_en", "options_en", "correct_index", "sentence_index"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^gl_p[0-9]+_s[0-9]+_q[12]$" },
        "type": { "const": "choice" },
        "question_en": { "type": "string", "minLength": 3 },
        "options_en": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "correct_index": { "type": "integer", "minimum": 0, "maximum": 2 },
        "sentence_index": { "type": "integer", "minimum": 0 }
      }
    },

    "listening_fill_blank": {
      "type": "object",
      "required": ["type", "title_vi", "identity_vi", "instructions_vi", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "listening_fill_blank" },
        "title_vi": { "type": "string", "minLength": 1 },
        "identity_vi": { "type": "string", "minLength": 1 },
        "instructions_vi": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "source_sentence", "sentence_with_blank", "options_en", "correct_index", "explanation_vi"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "audio_url": { "type": "string" },
              "source_sentence": { "type": "string", "minLength": 1 },
              "sentence_with_blank": { "type": "string", "minLength": 1 },
              "options_en": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "string", "minLength": 1 }
              },
              "correct_index": { "type": "integer", "minimum": 0, "maximum": 2 },
              "explanation_vi": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "listen_and_order": {
      "type": "object",
      "required": ["type", "title_vi", "identity_vi", "instructions_vi", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "listen_and_order" },
        "title_vi": { "type": "string", "minLength": 1 },
        "identity_vi": { "type": "string", "minLength": 1 },
        "instructions_vi": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "original_sentence", "scrambled_tokens", "correct_order_indices", "translation_vi"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "audio_url": { "type": "string" },
              "original_sentence": { "type": "string", "minLength": 1 },
              "scrambled_tokens": {
                "type": "array",
                "minItems": 3,
                "maxItems": 16,
                "items": { "type": "string", "minLength": 1 }
              },
              "correct_order_indices": {
                "type": "array",
                "minItems": 3,
                "maxItems": 16,
                "items": { "type": "integer", "minimum": 0 }
              },
              "translation_vi": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "listen_and_speak": {
      "type": "object",
      "required": ["type", "title_vi", "identity_vi", "instructions_vi", "items", "scoring_mode"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "listen_and_speak" },
        "title_vi": { "type": "string", "minLength": 1 },
        "identity_vi": { "type": "string", "minLength": 1 },
        "instructions_vi": { "type": "string", "minLength": 1 },
        "scoring_mode": { "type": "string", "enum": ["self_rate", "whisper_stt"] },
        "items": {
          "type": "array",
          "minItems": 5,
          "maxItems": 35,
          "items": {
            "type": "object",
            "required": ["id", "text_en", "text_vi", "tip_vi"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "audio_url": { "type": "string" },
              "text_en": { "type": "string", "minLength": 1 },
              "text_vi": { "type": "string", "minLength": 1 },
              "tip_vi": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "book_attribution": {
      "type": "object",
      "required": ["title", "creators", "publisher", "credit_text", "source_url", "image_credits", "license"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "creators": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "publisher": { "type": "string", "minLength": 1 },
        "credit_text": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "image_credits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["page_index", "credit_text"],
            "additionalProperties": false,
            "properties": {
              "page_index": { "type": "integer", "minimum": 0, "maximum": 23 },
              "credit_text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "license": {
          "type": "object",
          "required": ["name", "url"],
          "additionalProperties": false,
          "properties": {
            "name": { "const": "CC BY 4.0" },
            "url": { "const": "https://creativecommons.org/licenses/by/4.0/" }
          }
        }
      }
    },

    "read_aloud": {
      "type": "object",
      "required": ["type", "title_vi", "identity_vi", "instructions_vi", "items", "scoring_mode"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "read_aloud" },
        "title_vi": { "type": "string", "minLength": 1 },
        "identity_vi": { "type": "string", "minLength": 1 },
        "instructions_vi": { "type": "string", "minLength": 1 },
        "scoring_mode": { "type": "string", "enum": ["self_rate", "whisper_stt"] },
        "items": {
          "type": "array",
          "minItems": 5,
          "maxItems": 35,
          "items": {
            "type": "object",
            "required": ["id", "text_en", "text_vi", "tip_vi"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "audio_url": { "type": "string" },
              "text_en": { "type": "string", "minLength": 1 },
              "text_vi": { "type": "string", "minLength": 1 },
              "tip_vi": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "book_read_aloud": {
      "type": "object",
      "required": ["type", "title_vi", "identity_vi", "instructions_vi", "items", "scoring_mode"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "read_aloud" },
        "title_vi": { "type": "string", "minLength": 1 },
        "identity_vi": { "type": "string", "minLength": 1 },
        "instructions_vi": { "type": "string", "minLength": 1 },
        "scoring_mode": { "const": "whisper_stt" },
        "items": {
          "type": "array",
          "minItems": 10,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["id", "text_en", "audio_url"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^ra_[0-9]+$" },
              "text_en": { "type": "string", "minLength": 1 },
              "audio_url": { "type": "string", "format": "uri", "pattern": "^https://.*\\.mp3(?:[?#].*)?$" }
            }
          }
        }
      }
    },

    "reading_comprehension": {
      "type": "object",
      "required": ["type", "title_vi", "identity_vi", "instructions_vi", "questions"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "reading_comprehension" },
        "title_vi": { "type": "string", "minLength": 1 },
        "identity_vi": { "type": "string", "minLength": 1 },
        "instructions_vi": { "type": "string", "minLength": 1 },
        "questions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "section", "question_en", "options_en", "correct_index"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "section": { "type": "string", "enum": ["Find It", "Think About It", "Open Question"] },
              "question_en": { "type": "string", "minLength": 1 },
              "question_vi": { "type": "string", "minLength": 1 },
              "options_en": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "string", "minLength": 1 }
              },
              "options_vi": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "string", "minLength": 1 }
              },
              "correct_index": { "type": "integer", "minimum": 0, "maximum": 2 },
              "explanation_vi": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "written_response": {
      "type": "object",
      "required": ["type", "title_vi", "identity_vi", "instructions_vi", "questions"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "written_response" },
        "title_vi": { "type": "string", "minLength": 1 },
        "identity_vi": { "type": "string", "minLength": 1 },
        "instructions_vi": { "type": "string", "minLength": 1 },
        "questions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "question_en", "question_vi"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "question_en": { "type": "string", "minLength": 1 },
              "question_vi": { "type": "string", "minLength": 1 },
              "expected_answer_en": { "type": "string", "minLength": 1 },
              "hint_vi": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "mcq_question": {
      "type": "object",
      "required": ["id", "question_en", "question_vi", "options_en", "options_vi", "correct_index", "explanation_vi"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question_en": { "type": "string", "minLength": 1 },
        "question_vi": { "type": "string", "minLength": 1 },
        "options_en": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "options_vi": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "correct_index": { "type": "integer", "minimum": 0, "maximum": 2 },
        "explanation_vi": { "type": "string", "minLength": 1 }
      }
    }
  }
}
