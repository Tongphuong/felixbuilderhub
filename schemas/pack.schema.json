{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://felixbuilderhub.com/schemas/pack.schema.json",
  "title": "Read2Lead Pack",
  "description": "Canonical schema for a Read2Lead reading pack. Hub-owned source of truth; R2L backend mirrors via schemas/pack.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_name",
    "level_label",
    "topic",
    "slug",
    "worksheet_title",
    "audio_filename",
    "story_title",
    "story_text",
    "story_text_vi",
    "power_chunks",
    "matching_activity",
    "build_the_chunk",
    "fill_in_the_blank",
    "fix_the_chunk",
    "story_cloze",
    "shadowing_sentences",
    "best_line_challenge",
    "comprehension_questions",
    "story_order",
    "retell_frame",
    "answer_key",
    "parent_teacher_note",
    "next_lesson_suggestion"
  ],
  "properties": {
    "student_name": {
      "type": "string",
      "minLength": 1,
      "description": "Child name used throughout the pack."
    },
    "level_label": {
      "type": "string",
      "enum": [
        "L1 Beginner (A1/A1+)",
        "L2 Early Reader (A2)",
        "L3 Growing Reader (A2+/low B1)"
      ],
      "description": "Exact label emitted by the backend prompt for the requested level."
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "description": "Short English topic name."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
      "description": "Lowercase underscore slug used for generated asset names."
    },
    "worksheet_title": {
      "type": "string",
      "minLength": 1
    },
    "audio_filename": {
      "type": "string",
      "pattern": "\\.mp3$",
      "description": "Story narration filename."
    },
    "story_title": {
      "type": "string",
      "minLength": 1
    },
    "story_text": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "English story paragraphs. Semantic word count is enforced by the Python validator."
    },
    "story_text_vi": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Vietnamese parent/teacher reference paragraphs."
    },
    "power_chunks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "$ref": "#/definitions/powerChunk"
      }
    },
    "matching_activity": {
      "$ref": "#/definitions/matchingActivity"
    },
    "build_the_chunk": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fill_in_the_blank": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fix_the_chunk": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "story_cloze": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?=.*____________________)(?!.*____________________.*____________________).+$",
        "description": "Sentence containing exactly one 20-underscore blank."
      }
    },
    "shadowing_sentences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "One sentence per power chunk. Pairing and level word ranges are semantic validator rules."
    },
    "best_line_challenge": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/bestLineChallenge"
      }
    },
    "comprehension_questions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/definitions/comprehensionQuestion"
      }
    },
    "story_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retell_frame": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "answer_key": {
      "$ref": "#/definitions/answerKey"
    },
    "parent_teacher_note": {
      "type": "string",
      "minLength": 1
    },
    "next_lesson_suggestion": {
      "type": "string",
      "minLength": 1
    }
  },
  "definitions": {
    "powerChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk", "meaning", "example"],
      "properties": {
        "chunk": {
          "type": "string",
          "minLength": 1,
          "description": "Base-form collocation or useful phrase."
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "description": "Vietnamese gloss."
        },
        "example": {
          "type": "string",
          "minLength": 1,
          "description": "Example sentence using the chunk."
        }
      }
    },
    "matchingActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "meanings"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Same chunk strings as power_chunks, usually shuffled for display."
        },
        "meanings": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Same Vietnamese meanings as power_chunks, in a different order."
        }
      }
    },
    "bestLineChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options", "correct_index"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "correct_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "comprehensionQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "question", "hint_vi"],
      "properties": {
        "section": {
          "type": "string",
          "enum": [
            "Find It",
            "Think About It",
            "Language in the Story",
            "Open Question",
            "Your Turn"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "hint_vi": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answerKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matching",
        "build_the_chunk",
        "fill_in_the_blank",
        "fix_the_chunk",
        "story_cloze",
        "best_line_challenge",
        "comprehension",
        "story_order",
        "suggested_retell"
      ],
      "properties": {
        "matching": {
          "type": "string",
          "minLength": 1
        },
        "build_the_chunk": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fill_in_the_blank": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fix_the_chunk": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "story_cloze": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "best_line_challenge": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        },
        "comprehension": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "string"
          }
        },
        "story_order": {
          "type": "string",
          "minLength": 1
        },
        "suggested_retell": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
