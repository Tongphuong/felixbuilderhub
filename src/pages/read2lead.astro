---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ZALO_DISPLAY, ZALO_URL } from '../config/contact';

const topics = [
  ['animals_pets', 'Động vật & thú cưng'],
  ['family_friends', 'Gia đình & bạn bè'],
  ['school', 'Trường học'],
  ['sports', 'Thể thao'],
  ['games_toys', 'Trò chơi & đồ chơi'],
  ['vehicles', 'Xe cộ & di chuyển'],
  ['food_cooking', 'Đồ ăn & nấu ăn'],
  ['nature', 'Thiên nhiên'],
  ['art_creativity', 'Vẽ tranh & sáng tạo'],
  ['heroes_jobs', 'Nghề nghiệp & ước mơ'],
  ['imagination', 'Tưởng tượng & phép màu'],
  ['vietnamese_holidays', 'Lễ hội Việt Nam'],
];

const activityCards = [
  ['Nghe điền cụm', 'Con nghe câu, chọn từ đúng để điền vào chỗ trống.'],
  ['Sắp xếp câu', 'Con nghe rồi kéo các từ theo đúng thứ tự.'],
  ['Đọc hiểu', 'Con đọc truyện và trả lời câu hỏi.'],
  ['Viết câu trả lời', 'Con tự viết câu trả lời ngắn.'],
  ['Nghe và nói lại', 'Con nghe câu mẫu, thu âm rồi tự đánh giá.'],
];

const faqItems = [
  ['Chưa có mã thì làm gì?', `Nhắn Zalo ${ZALO_DISPLAY} để Felix tạo hồ sơ cho bé. Sau đó anh/chị sẽ nhận mã qua Zalo.`],
  ['Có cần chọn level không?', 'Không. Mọi bạn nhỏ bắt đầu từ L1 và hệ thống tự mở level tiếp theo khi bé tích đủ XP.'],
  ['Con làm bài ở đâu?', 'Ngay trên web. Sau khi bấm "Tạo bài học", bé bấm "Mở bài học" để làm trực tiếp trên điện thoại hoặc máy tính.'],
  ['Xem tiến trình ở đâu?', 'Bấm "Hồ sơ học sinh" ở đầu trang, nhập mã là thấy level, XP, xu, streak và bài đang mở.'],
];
---

<BaseLayout
  title="Read2Lead - Tự học nghe và đọc tiếng Anh qua câu chuyện | Felix Builder Hub"
  description="Read2Lead giúp bé tự học nghe và đọc tiếng Anh thông qua câu chuyện bé tự chọn, với hồ sơ riêng, XP, xu và level."
>
  <Header />

  <main id="main" class="flex-1">
    <!-- ===== HERO ===== -->
    <section class="mx-auto max-w-5xl px-5 pb-6 pt-12 text-center sm:pt-16">
      <h1 class="mx-auto max-w-3xl font-display text-3xl font-extrabold leading-tight text-cream sm:text-4xl md:text-5xl">
        Tự học nghe và đọc tiếng Anh thông qua câu chuyện con tự chọn
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-cream-muted sm:text-lg">
        Nhập mã học sinh, chọn chủ đề con thích, rồi bấm tạo bài. Bé làm bài trực tiếp trên web và nhận XP/xu để leo rank.
      </p>
    </section>

    <!-- ===== 3 BIG ACTION CARDS ===== -->
    <section class="mx-auto max-w-5xl px-5 pb-10">
      <div class="grid gap-4 sm:grid-cols-3">
        <a
          href="#form"
          class="flex flex-col items-center gap-3 rounded-xl border-2 border-accent/60 bg-accent/10 p-6 text-center transition hover:border-accent hover:bg-accent/20 sm:p-8"
        >
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-accent text-2xl font-bold text-navy-950">+</span>
          <span class="text-xl font-extrabold text-cream sm:text-2xl">Tạo bài cho con</span>
          <span class="text-sm text-cream-muted">Nhập mã, chọn chủ đề, bấm tạo</span>
        </a>
        <a
          href="/read2lead/leaderboard"
          class="flex flex-col items-center gap-3 rounded-xl border-2 border-gold/50 bg-gold/10 p-6 text-center transition hover:border-gold hover:bg-gold/20 sm:p-8"
        >
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-gold text-2xl font-bold text-navy-950">&#9733;</span>
          <span class="text-xl font-extrabold text-cream sm:text-2xl">Bảng xếp hạng</span>
          <span class="text-sm text-cream-muted">Xem rank của các bạn nhỏ</span>
        </a>
        <a
          href="/read2lead/review"
          class="flex flex-col items-center gap-3 rounded-xl border-2 border-cream/30 bg-cream/5 p-6 text-center transition hover:border-cream/50 hover:bg-cream/10 sm:p-8"
        >
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-cream/20 text-2xl text-cream">&#128100;</span>
          <span class="text-xl font-extrabold text-cream sm:text-2xl">Hồ sơ học sinh</span>
          <span class="text-sm text-cream-muted">Level, XP, xu, bài đang mở</span>
        </a>
      </div>
    </section>

    <!-- ===== CREATE LESSON FORM ===== -->
    <section id="form" class="bg-navy-900 px-5 py-14 sm:py-16">
      <div class="mx-auto max-w-xl">
        <div id="form-section">
          <h2 class="text-center font-display text-2xl font-bold text-cream sm:text-3xl">Tạo bài học mới</h2>

          <!-- mini stepper -->
          <div class="mx-auto mt-6 flex max-w-md items-start justify-between gap-1 text-center text-xs font-semibold sm:text-sm">
            <div class="flex-1">
              <span class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-accent font-bold text-navy-950 sm:h-9 sm:w-9">1</span>
              <p class="mt-1.5 text-cream">Nhập mã</p>
            </div>
            <div class="mt-4 h-px flex-1 bg-cream/20"></div>
            <div class="flex-1">
              <span class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-cream/20 font-bold text-cream sm:h-9 sm:w-9">2</span>
              <p class="mt-1.5 text-cream-muted">Chọn chủ đề</p>
            </div>
            <div class="mt-4 h-px flex-1 bg-cream/20"></div>
            <div class="flex-1">
              <span class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-cream/20 font-bold text-cream sm:h-9 sm:w-9">3</span>
              <p class="mt-1.5 text-cream-muted">Tạo bài</p>
            </div>
            <div class="mt-4 h-px flex-1 bg-cream/20"></div>
            <div class="flex-1">
              <span class="mx-auto flex h-8 w-8 items-center justify-center rounded-full bg-cream/20 font-bold text-cream sm:h-9 sm:w-9">4</span>
              <p class="mt-1.5 text-cream-muted">Mở bài</p>
            </div>
          </div>

          <form id="r2l-form" class="mt-8 space-y-5">
            <!-- Step 1: Code -->
            <div>
              <label class="mb-2 block text-sm font-semibold text-cream">
                Bước 1 — Nhập mã học sinh <span class="text-red-400">*</span>
              </label>
              <input
                type="text"
                name="access_code"
                required
                maxlength="32"
                autocomplete="off"
                placeholder="VD: R2L-JUN-A4F2"
                class="w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-4 py-3.5 text-lg uppercase text-cream placeholder:normal-case placeholder:text-cream-dim/80 focus:border-accent focus:outline-none"
              />
            </div>

            <!-- Help: Mã học sinh là gì? -->
            <div class="rounded-lg border border-cream/20 bg-cream/5 p-4">
              <p class="text-sm font-semibold text-gold">Mã học sinh là gì?</p>
              <p class="mt-1 text-sm leading-relaxed text-cream-muted">
                Đây là mã riêng của bé. Felix gửi mã này cho phụ huynh qua Zalo. Chưa có mã? <a href={ZALO_URL} class="font-semibold text-accent underline">Nhắn Zalo Felix</a>.
              </p>
            </div>

            <!-- Step 2: Topic -->
            <div>
              <label class="mb-2 block text-sm font-semibold text-cream">
                Bước 2 — Con thích chủ đề gì? <span class="text-cream-dim">(không bắt buộc)</span>
              </label>
              <div class="grid grid-cols-2 gap-2 rounded-lg border border-cream-dim/30 bg-navy-950 p-3 sm:grid-cols-3">
                <label class="flex cursor-pointer items-center gap-2 rounded-md p-2 transition hover:bg-navy-800 has-[:checked]:bg-accent/15 has-[:checked]:ring-1 has-[:checked]:ring-accent">
                  <input type="radio" name="topic" value="" class="h-4 w-4 accent-accent" checked />
                  <span class="text-sm font-semibold text-cream">Felix chọn giúp</span>
                </label>
                {topics.map(([value, label]) => (
                  <label class="flex cursor-pointer items-center gap-2 rounded-md p-2 transition hover:bg-navy-800 has-[:checked]:bg-accent/15 has-[:checked]:ring-1 has-[:checked]:ring-accent">
                    <input type="radio" name="topic" value={value} class="h-4 w-4 accent-accent" />
                    <span class="text-sm text-cream">{label}</span>
                  </label>
                ))}
              </div>
              <p class="mt-2 text-xs text-cream-dim">Nếu không chọn, Felix sẽ chọn chủ đề giúp con.</p>
            </div>

            <!-- Optional: interests (collapsed) -->
            <details class="group rounded-lg border border-cream-dim/20 bg-navy-950/60">
              <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-cream-muted transition hover:text-accent">
                <span>Ghi thêm sở thích của con <span class="text-xs font-normal text-cream-dim">(không bắt buộc)</span></span>
                <span class="ml-3 shrink-0 text-cream-dim transition group-open:rotate-180" aria-hidden="true">▾</span>
              </summary>
              <div class="px-4 pb-4 pt-1">
                <input
                  name="interests"
                  type="text"
                  maxlength="120"
                  placeholder="VD: bóng đá, Roblox, mèo, vẽ tranh..."
                  class="w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-4 py-3 text-base text-cream placeholder:text-cream-dim/80 focus:border-accent focus:outline-none"
                />
                <p class="mt-2 text-xs text-cream-dim">Nếu điền, câu chuyện sẽ cố gắng đi theo điều con thích.</p>
              </div>
            </details>

            <!-- Honeypot -->
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" tabindex="-1" />
            </div>

            <!-- Step 3: Submit -->
            <button type="submit" class="w-full rounded-xl bg-accent px-6 py-4 text-xl font-extrabold text-navy-950 transition hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-70">
              Tạo bài học cho con
            </button>

            <p class="text-center text-xs text-cream-dim/80">Gửi form đồng nghĩa anh chị đồng ý <a href="/privacy" class="underline transition hover:text-accent">chính sách dữ liệu</a> của Felix.</p>
          </form>

          <!-- Help: Không biết bắt đầu -->
          <div class="mt-6 rounded-lg border border-gold/30 bg-gold/10 p-4">
            <p class="text-sm font-semibold text-gold">Không biết bắt đầu từ đâu?</p>
            <p class="mt-1 text-sm leading-relaxed text-cream-muted">
              Chỉ cần nhập mã học sinh rồi bấm <strong class="text-cream">Tạo bài học</strong>. Nếu chưa có mã, nhắn Zalo Felix.
            </p>
          </div>
        </div>

        <!-- Progress state -->
        <div id="progress-section" class="hidden rounded-lg border border-cream-dim/20 bg-navy-950 p-6 text-center">
          <div class="h-3 overflow-hidden rounded-full bg-navy-800">
            <div class="h-full w-2/3 animate-pulse rounded-full bg-gradient-to-r from-accent via-gold-light to-accent"></div>
          </div>
          <p id="status-text" class="mt-6 text-lg font-semibold text-cream"></p>
          <p class="mt-3 text-sm text-cream-dim">Lần đầu có thể chậm hơn một chút vì máy chủ cần khởi động.</p>
        </div>

        <!-- Result state -->
        <div id="result-section" class="hidden rounded-lg border border-gold/40 bg-gold/10 p-6 text-center">
          <h2 class="font-display text-2xl font-bold leading-snug text-cream sm:text-3xl">Bài học của <span id="result-child-name"></span> đã sẵn sàng</h2>
          <div class="mt-5 space-y-2 text-cream-muted">
            <p>Chủ đề: <span id="result-topic" class="font-semibold text-cream"></span></p>
            <p>Tên truyện: <span id="result-story-title" class="font-semibold text-cream"></span></p>
          </div>
          <div class="mt-8">
            <a id="lesson-link" href="/read2lead/lesson" class="inline-block w-full rounded-xl bg-accent px-6 py-4 text-xl font-extrabold text-navy-950 transition hover:bg-accent-hover sm:w-auto sm:px-10">Mở bài học</a>
          </div>
          <p class="mt-6 text-sm leading-relaxed text-cream-muted">
            Con nghe truyện, làm 5 nhiệm vụ và lưu chiến công trực tiếp trên web. Bố mẹ có thể mở <a id="review-link" href="/read2lead/review" class="font-semibold text-gold-light underline">hồ sơ học sinh</a> để xem tiến trình.
          </p>
          <div class="mt-6">
            <p class="text-cream-dim">Muốn tạo bài khác?</p>
            <button id="reset-btn" type="button" class="mt-3 rounded-lg border border-cream-dim/30 px-5 py-2.5 font-semibold text-cream transition hover:border-accent hover:text-accent">Tạo bài mới</button>
          </div>
        </div>

        <!-- Error state -->
        <div id="error-section" class="hidden rounded-lg border border-red-500/30 bg-red-500/10 p-6 text-center">
          <p class="text-lg font-semibold text-red-400">Có lỗi xảy ra: <span id="error-message"></span></p>
          <button id="retry-btn" type="button" class="mt-5 rounded-lg bg-accent px-5 py-2.5 font-semibold text-navy-950 transition hover:bg-accent-hover">Thử lại</button>
          <p class="mt-4 text-sm text-cream-muted">Nếu lỗi tiếp tục, nhắn Zalo {ZALO_DISPLAY}</p>
        </div>
      </div>
    </section>

    <!-- ===== HOW IT WORKS ===== -->
    <section class="mx-auto max-w-5xl px-5 py-14 sm:py-16">
      <h2 class="text-center font-display text-2xl font-bold text-cream sm:text-3xl">Bé sẽ làm gì trong bài?</h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-sm leading-relaxed text-cream-muted sm:text-base">
        Mỗi bài có 5 nhiệm vụ ngắn. Con đi từ đầu tới cuối rồi bấm lưu chiến công.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {activityCards.map(([title, description], i) => (
          <div class="rounded-xl border border-cream-dim/20 bg-navy-900/70 p-5">
            <span class="flex h-9 w-9 items-center justify-center rounded-md bg-accent text-sm font-bold text-navy-950">{i + 1}</span>
            <h3 class="mt-3 font-display text-lg font-bold text-cream">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream-muted">{description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== PROGRESS / MOTIVATION ===== -->
    <section class="bg-navy-900 px-5 py-14 sm:py-16">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-center font-display text-2xl font-bold text-cream sm:text-3xl">Mỗi bé có một hồ sơ học riêng</h2>
        <p class="mx-auto mt-3 max-w-xl text-center text-sm leading-relaxed text-cream-muted sm:text-base">
          Mã học sinh giữ tên bé, level, XP, xu, streak và lịch sử bài học. Bé bắt đầu từ L1 và mở dần tới L5.
        </p>
        <div class="mx-auto mt-8 grid max-w-4xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/read2lead/leaderboard" class="rounded-xl border border-gold/35 bg-gold/10 p-5 transition hover:border-gold hover:bg-gold/15">
            <p class="text-sm font-semibold uppercase tracking-wide text-gold-light">Bảng xếp hạng</p>
            <p class="mt-2 text-sm leading-relaxed text-cream-muted">Xem rank Đồng, Bạc, Vàng, Kim cương, Huyền thoại của các bạn nhỏ.</p>
          </a>
          <a id="library-card-link" href="/read2lead/library" class="rounded-xl border border-cream/25 bg-cream/5 p-5 transition hover:border-cream/45 hover:bg-cream/10">
            <p class="text-sm font-semibold uppercase tracking-wide text-cream">Thư viện truyện</p>
            <p class="mt-2 text-sm leading-relaxed text-cream-muted">Sổ sticker các câu chuyện con đã hoàn thành — đọc lại bất cứ lúc nào.</p>
          </a>
          <a href="/read2lead/review" class="rounded-xl border border-accent/35 bg-accent/10 p-5 transition hover:border-accent hover:bg-accent/15">
            <p class="text-sm font-semibold uppercase tracking-wide text-accent">Hồ sơ học sinh</p>
            <p class="mt-2 text-sm leading-relaxed text-cream-muted">Nhập mã để xem level, XP, xu, streak và bài đang mở của bé.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="mx-auto max-w-3xl px-5 py-14 sm:py-16">
      <h2 class="text-center font-display text-2xl font-bold text-cream sm:text-3xl">Câu hỏi thường gặp</h2>
      <div class="mt-8 space-y-3">
        {faqItems.map(([question, answer]) => (
          <details class="rounded-lg border border-cream-dim/20 bg-navy-900/70 p-5">
            <summary class="cursor-pointer text-base font-bold text-cream sm:text-lg">{question}</summary>
            <p class="mt-3 text-sm leading-relaxed text-cream-muted sm:text-base">{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- ===== CROSS-SELL ===== -->
    <section class="mx-auto max-w-5xl px-5 pb-14 sm:pb-16">
      <div class="rounded-xl border border-accent/30 bg-navy-900/70 p-6 text-center sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-wide text-cream-dim">Bạn cũng có thể quan tâm</p>
        <h3 class="mt-3 font-display text-xl font-bold text-cream sm:text-2xl">MSMW - Sách truyện cá nhân hóa làm quà tặng</h3>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-cream-muted">Một cuốn sách 20 trang với con là nhân vật chính, phù hợp làm quà sinh nhật hoặc dịp đặc biệt.</p>
        <a href="/msmw" class="mt-4 inline-flex font-semibold text-accent transition hover:text-accent-hover">Xem MSMW</a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const form = document.getElementById('r2l-form');
    const btn = form.querySelector('button[type="submit"]');
    const progressSection = document.getElementById('progress-section');
    const statusText = document.getElementById('status-text');
    const resultSection = document.getElementById('result-section');
    const errorSection = document.getElementById('error-section');
    const formSection = document.getElementById('form-section');

    {
      const prefillCode = new URLSearchParams(window.location.search).get('code');
      if (prefillCode) {
        const codeInput = form.querySelector('input[name="access_code"]');
        if (codeInput) codeInput.value = prefillCode.toUpperCase();
        const libraryLink = document.getElementById('library-card-link');
        if (libraryLink) {
          libraryLink.href = `/read2lead/library?code=${encodeURIComponent(prefillCode.toUpperCase())}`;
        }
      }
    }

    let statusInterval = null;
    let pollInterval = null;
    let pollAttempts = 0;
    let pollInFlight = false;
    let activeTaskId = null;
    let generationComplete = false;
    const MAX_POLL_ATTEMPTS = 60;
    const POLL_INTERVAL_MS = 5000;

    const stages = [
      'Đang viết câu chuyện riêng cho con...',
      'Đang chuẩn bị phần nghe cho câu chuyện...',
      'Đang ghi âm các cụm câu để con tập đọc...',
      'Đang chuẩn bị nhiệm vụ web cho con...',
      'Sắp xong rồi, đang mở bài học...',
    ];

    function showProgress() {
      formSection.classList.add('hidden');
      errorSection.classList.add('hidden');
      resultSection.classList.add('hidden');
      progressSection.classList.remove('hidden');

      let idx = 0;
      statusText.textContent = stages[idx];
      statusInterval = setInterval(() => {
        idx = Math.min(idx + 1, stages.length - 1);
        statusText.textContent = stages[idx];
      }, 15000);

      progressSection.scrollIntoView({ behavior: 'smooth' });
    }

    function showResult(data) {
      clearInterval(statusInterval);
      if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
      generationComplete = true;
      activeTaskId = null;
      progressSection.classList.add('hidden');
      errorSection.classList.add('hidden');

      document.getElementById('result-child-name').textContent = data.child_name || '';
      document.getElementById('result-topic').textContent = data.topic || '';
      document.getElementById('result-story-title').textContent = data.story_title || '';
      document.getElementById('lesson-link').href = data.lesson_link || '/read2lead/lesson';
      document.getElementById('review-link').href = data.review_link || '/read2lead/review';

      resultSection.classList.remove('hidden');
      resultSection.scrollIntoView({ behavior: 'smooth' });
    }

    function showError(msg) {
      if (generationComplete) return;
      clearInterval(statusInterval);
      progressSection.classList.add('hidden');
      resultSection.classList.add('hidden');
      document.getElementById('error-message').textContent = msg;
      errorSection.classList.remove('hidden');
      errorSection.scrollIntoView({ behavior: 'smooth' });
    }

    function resetForm() {
      if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
      pollInFlight = false;
      activeTaskId = null;
      generationComplete = false;
      formSection.classList.remove('hidden');
      resultSection.classList.add('hidden');
      errorSection.classList.add('hidden');
      form.reset();
      formSection.scrollIntoView({ behavior: 'smooth' });
    }

    document.getElementById('reset-btn').addEventListener('click', resetForm);
    document.getElementById('retry-btn').addEventListener('click', resetForm);

    async function pollGenerationStatus(accessCode, taskId) {
      if (generationComplete || activeTaskId !== taskId || pollInFlight) return;
      pollInFlight = true;
      try {
        const res = await fetch(`/api/check-generation-status?access_code=${encodeURIComponent(accessCode)}&task_id=${encodeURIComponent(taskId)}`);
        const result = await res.json();

        if (generationComplete || activeTaskId !== taskId) return;

        if (result.status === 'pending') {
          pollAttempts += 1;
          const statusEl = document.getElementById('status-text');
          if (statusEl) {
            const pos = typeof result.queue_position === 'number' ? result.queue_position : null;
            if (pos && pos > 3) {
              const ahead = pos - 3;
              const estMinutes = Math.max(1, Math.ceil((ahead * 60) / 60));
              statusEl.textContent = `Hệ thống đang bận: còn ${ahead} bài trước con. Đợi khoảng ${estMinutes} phút...`;
            } else if (pos && pos > 0) {
              statusEl.textContent = 'Bài của con đang được tạo. Đợi khoảng 1 phút...';
            }
          }
          if (pollAttempts >= MAX_POLL_ATTEMPTS) {
            clearInterval(pollInterval);
            pollInterval = null;
            activeTaskId = null;
            showError('Tạo bài quá lâu. Vui lòng thử lại hoặc nhắn Zalo Felix.');
          }
          return;
        }

        clearInterval(pollInterval);
        pollInterval = null;
        activeTaskId = null;

        if (result.status === 'done' && result.lesson_link) {
          showResult(result);
        } else {
          showError(result.message || result.error || 'Tạo bài thất bại.');
        }
      } catch (err) {
        if (generationComplete || activeTaskId !== taskId) return;
        clearInterval(pollInterval);
        pollInterval = null;
        activeTaskId = null;
        showError('Mất kết nối khi kiểm tra trạng thái. Thử lại sau.');
      } finally {
        pollInFlight = false;
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form));
      if (data.website) {
        formSection.classList.add('hidden');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Đang tạo...';
      showProgress();
      pollAttempts = 0;
      generationComplete = false;

      try {
        const res = await fetch('/api/generate-read2lead-pack', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await res.json();

        if (!res.ok || !result.ok) {
          showError(result.review_link ? `${result.message || result.error} Mở hồ sơ: ${result.review_link}` : (result.message || result.error || 'Có lỗi xảy ra, vui lòng thử lại.'));
          return;
        }

        if (result.status === 'done' && result.lesson_link) {
          showResult(result);
          return;
        }

        if (!result.task_id) {
          showError('Chưa nhận được phản hồi từ hệ thống. Vui lòng thử lại.');
          return;
        }

        activeTaskId = result.task_id;
        pollGenerationStatus(data.access_code.toUpperCase(), result.task_id);
        pollInterval = setInterval(
          () => pollGenerationStatus(data.access_code.toUpperCase(), result.task_id),
          POLL_INTERVAL_MS,
        );
      } catch (err) {
        showError('Mạng không ổn định. Vui lòng thử lại sau ít phút.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Tạo bài học cho con';
      }
    });
  </script>
</BaseLayout>
