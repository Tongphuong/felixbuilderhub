---
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  ['📖', 'Truyện cá nhân hoá', '5-8 trang. Tên con xuất hiện tự nhiên.'],
  ['🔑', '5-6 power chunks', 'Cụm từ thực dụng, KHÔNG phải từ đơn lẻ.'],
  ['✍️', 'Bài tập đa dạng', 'Match chunk, fill blank, build sentence, fix mistake.'],
  ['❓', 'Comprehension + retell', 'Đọc hiểu, kể lại bằng chunks.'],
  ['🎧', 'MP3 story audio', 'Đọc to truyện. Nghe trước hoặc trong khi đọc.'],
  ['📋', 'Đáp án phụ huynh', 'Hướng dẫn riêng ở trang cuối.'],
];

const steps = [
  ['Điền thông tin', 'Tên con + tuổi + level tiếng Anh'],
  ['Tạo pack tự động', 'Đợi 2 phút trên trang'],
  ['Tải về & in', 'PDF + MP3, in trên giấy A4 đen trắng'],
];

const faqItems = [
  ['Mã đăng nhập là gì?', 'Mỗi phụ huynh khi mua quyền sử dụng nhận 1 mã từ Felix (gửi qua Zalo). 1 mã cho phép tạo 10 packs trong 60 ngày. Hết uses hoặc hết hạn → nhắn Zalo Felix để gia hạn cùng mã đó.'],
  ['Phí dùng Read2Lead bao nhiêu?', 'Read2Lead hiện tại đang thử nghiệm với học sinh hiện tại của Felix. Nhắn Zalo Felix để biết chi tiết về mã đăng nhập.'],
  ['Bao lâu nhận pack?', '~2 phút trực tiếp trên trang này, Felix không cần làm tay.'],
  ['Pack có thật cá nhân hoá hay chỉ đổi tên?', 'Mỗi pack được tạo riêng dựa trên tên, tuổi, giới tính và level của con. Hai pack của hai bé khác nhau sẽ có chủ đề + chunks khác nhau.'],
  ['Nếu pack không phù hợp thì sao?', 'Có thể tạo lại bằng mã đăng nhập nếu mã còn lượt. Nếu liên tục không ưng → nhắn Zalo Felix.'],
  ['Có thể đặt cho nhiều bé không?', 'Được. Mỗi lần tạo 1 pack. Lặp lại form cho bé tiếp theo.'],
];
---

<BaseLayout
  title="Read2Lead — Bộ học tiếng Anh in được cho con | Felix Builder Hub"
  description="Pack học tiếng Anh cá nhân hoá tạo riêng trong 2 phút: truyện + chunk practice + MP3. Bố mẹ nhập mã và in tại nhà."
>
  <header class="sticky top-0 z-50 border-b border-cream-dim/20 bg-navy-950/85 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="font-display text-lg font-semibold text-cream">Felix Builder Hub</a>
      <nav class="hidden items-center gap-6 text-sm font-medium text-cream-muted sm:flex">
        <a href="/#products" class="transition hover:text-accent">Sản phẩm</a>
        <a href="/#contact" class="transition hover:text-accent">Liên hệ</a>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <section class="mx-auto max-w-6xl px-6 py-20 text-center md:py-32">
      <span class="inline-block rounded-full bg-accent/20 px-4 py-1 text-sm font-semibold text-accent">Cần mã đăng nhập từ Felix</span>
      <h1 class="mx-auto mt-6 max-w-5xl font-display text-4xl font-extrabold leading-snug text-cream md:text-6xl">Bộ học tiếng Anh in được, làm riêng cho con.</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-muted md:text-xl">Truyện cá nhân hoá + bài tập chunk + audio MP3. Bố mẹ nhập mã, tạo pack trong 2 phút.</p>
      <a href="#form" class="mt-10 inline-flex rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Tạo pack cho con</a>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-center font-display text-3xl font-bold text-cream md:text-4xl">Mỗi pack có những gì</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {features.map(([icon, title, description]) => (
          <div class="flex gap-4 rounded-lg border border-cream-dim/20 bg-navy-900/70 p-5">
            <span class="text-3xl" aria-hidden="true">{icon}</span>
            <div>
              <h3 class="font-display text-xl font-bold text-cream">{title}</h3>
              <p class="mt-2 leading-relaxed text-cream-muted">{description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <h2 class="text-center font-display text-3xl font-bold text-cream md:text-4xl">3 bước</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {steps.map(([title, description], index) => (
            <div class="rounded-lg border border-cream-dim/20 bg-navy-950/75 p-5">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent font-display text-lg font-bold text-navy-950">{index + 1}</div>
              <h3 class="mt-5 font-display text-xl font-bold text-cream">{title}</h3>
              <p class="mt-3 leading-relaxed text-cream-muted">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="form" class="mx-auto max-w-6xl px-6 py-20">
      <div id="form-section">
        <div class="text-center">
          <h2 class="font-display text-3xl font-bold text-cream md:text-4xl">Tạo pack cho con</h2>
          <p class="mt-4 text-cream-muted">Felix sẽ liên hệ qua Zalo trong 24h nếu pack có vấn đề</p>
        </div>

        <form id="r2l-form" class="mx-auto mt-10 max-w-xl space-y-5">
          <div>
            <label class="mb-2 block text-sm text-cream-muted">
              Mã đăng nhập <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              name="access_code"
              required
              maxlength="32"
              autocomplete="off"
              placeholder="VD: R2L-JUN-A4F2"
              class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base uppercase text-cream placeholder:normal-case placeholder:text-cream-dim/80 focus:border-accent focus:outline-none"
            />
            <p class="mt-2 text-xs text-cream-dim">Chưa có mã? <a href="https://zalo.me/0396868675" class="text-accent underline">Nhắn Zalo Felix</a> để nhận.</p>
          </div>
          <div>
            <label for="child_name" class="mb-2 block text-sm text-cream-muted">Tên con <span class="text-red-400">*</span></label>
            <input id="child_name" name="child_name" required maxlength="50" placeholder="Vd: Linh" class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream focus:border-accent" />
          </div>
          <div>
            <label for="age" class="mb-2 block text-sm text-cream-muted">Tuổi con <span class="text-red-400">*</span></label>
            <input id="age" type="number" name="age" min="5" max="14" required placeholder="5-14" class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream focus:border-accent" />
          </div>
          <fieldset>
            <legend class="mb-2 block text-sm text-cream-muted">Level tiếng Anh <span class="text-red-400">*</span></legend>
            <div class="space-y-3 rounded-lg border border-cream-dim/30 bg-navy-900 p-4">
              <label class="flex items-start gap-3 text-base text-cream">
                <input type="radio" name="level" value="L1" required class="mt-1 h-4 w-4 accent-accent" />
                <span>L1 Beginner (A1) — mới bắt đầu</span>
              </label>
              <label class="flex items-start gap-3 text-base text-cream">
                <input type="radio" name="level" value="L2" required checked class="mt-1 h-4 w-4 accent-accent" />
                <span>L2 Early Reader (A2) — đọc được câu đơn</span>
              </label>
              <label class="flex items-start gap-3 text-base text-cream">
                <input type="radio" name="level" value="L3" required class="mt-1 h-4 w-4 accent-accent" />
                <span>L3 Growing Reader (A2+) — đọc đoạn ngắn</span>
              </label>
            </div>
          </fieldset>
          <div>
            <label class="mb-2 block text-sm text-cream-muted">Giới tính con <span class="text-red-400">*</span></label>
            <div class="space-y-2">
              <label class="flex cursor-pointer items-center gap-3">
                <input type="radio" name="child_gender" value="boy" required class="h-4 w-4 accent-accent" checked />
                <span>Bé trai</span>
              </label>
              <label class="flex cursor-pointer items-center gap-3">
                <input type="radio" name="child_gender" value="girl" required class="h-4 w-4 accent-accent" />
                <span>Bé gái</span>
              </label>
            </div>
          </div>
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" tabindex="-1" />
          </div>
          <button type="submit" class="w-full rounded-lg bg-accent px-6 py-3 text-lg font-semibold text-navy-950 transition hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-70">Tạo pack bằng mã đăng nhập</button>
        </form>
      </div>

      <div id="progress-section" class="mx-auto hidden max-w-2xl rounded-lg border border-cream-dim/20 bg-navy-900 p-6 text-center">
        <div class="h-3 overflow-hidden rounded-full bg-navy-800">
          <div class="h-full w-2/3 animate-pulse rounded-full bg-gradient-to-r from-accent via-gold-light to-accent"></div>
        </div>
        <p id="status-text" class="mt-6 text-lg font-semibold text-cream"></p>
        <p class="mt-3 text-sm text-cream-dim">Lần đầu có thể chậm ~30s do server khởi động</p>
      </div>

      <div id="result-section" class="mx-auto hidden max-w-2xl rounded-lg border border-gold/40 bg-gold/10 p-6 text-center">
        <h2 class="font-display text-3xl font-bold text-cream">✅ Pack của <span id="result-child-name"></span> đã sẵn sàng!</h2>
        <div class="mt-5 space-y-2 text-cream-muted">
          <p>Topic: <span id="result-topic" class="font-semibold text-cream"></span></p>
          <p>Story: <span id="result-story-title" class="font-semibold text-cream"></span></p>
        </div>
        <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
          <a id="pdf-link" href="#" target="_blank" rel="noreferrer" class="rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Tải PDF</a>
          <a id="mp3-link" href="#" target="_blank" rel="noreferrer" class="rounded-lg border border-accent px-6 py-3 font-semibold text-accent transition hover:bg-accent hover:text-navy-950">Tải MP3</a>
        </div>
        <p class="mt-6 text-sm text-cream-muted">📌 Lưu file ngay — link chỉ tồn tại vài giờ. Tải về máy để giữ lại.</p>
        <div class="mt-6">
          <p class="text-cream-dim">Tạo pack khác cho bé khác?</p>
          <button id="reset-btn" type="button" class="mt-3 rounded-lg border border-cream-dim/30 px-5 py-2 font-semibold text-cream transition hover:border-accent hover:text-accent">Làm lại form</button>
        </div>
      </div>

      <div id="error-section" class="mx-auto hidden max-w-2xl rounded-lg border border-red-500/30 bg-red-500/10 p-6 text-center">
        <p class="text-lg font-semibold text-red-400">⚠️ Có lỗi xảy ra: <span id="error-message"></span></p>
        <button id="retry-btn" type="button" class="mt-5 rounded-lg bg-accent px-5 py-2 font-semibold text-navy-950 transition hover:bg-accent-hover">Thử lại</button>
        <p class="mt-4 text-sm text-cream-muted">Nếu lỗi tiếp tục, nhắn Zalo +84 396868675</p>
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center font-display text-3xl font-bold text-cream md:text-4xl">Câu hỏi thường gặp</h2>
        <div class="mt-10 space-y-3">
          {faqItems.map(([question, answer]) => (
            <details class="rounded-lg border border-cream-dim/20 bg-navy-950/75 p-5">
              <summary class="cursor-pointer font-display text-lg font-bold text-cream">{question}</summary>
              <p class="mt-4 leading-relaxed text-cream-muted">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20 text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-cream-dim">Bạn cũng có thể quan tâm</p>
      <div class="mx-auto mt-6 max-w-2xl rounded-lg border border-accent bg-navy-900/70 p-8">
        <h3 class="font-display text-2xl font-bold text-cream">MSMW — Sách truyện cá nhân hoá làm quà tặng</h3>
        <p class="mt-4 leading-relaxed text-cream-muted">Quà ý nghĩa: cuốn sách 20 trang với con là nhân vật chính.</p>
        <a href="/msmw" class="mt-6 inline-flex font-semibold text-accent transition hover:text-accent-hover">Xem MSMW →</a>
      </div>
    </section>
  </main>

  <footer class="mt-auto border-t border-cream-dim/20 py-8 text-center text-sm text-cream-dim/80">
    © 2026 Tong Phuong - built in vietnam
  </footer>

  <script>
    const form = document.getElementById('r2l-form');
    const btn = form.querySelector('button[type="submit"]');
    const progressSection = document.getElementById('progress-section');
    const statusText = document.getElementById('status-text');
    const resultSection = document.getElementById('result-section');
    const errorSection = document.getElementById('error-section');
    const formSection = document.getElementById('form-section');

    let statusInterval = null;

    const stages = [
      '✍️ Đang tạo truyện riêng cho con...',
      '📝 Đang chuẩn bị bài tập...',
      '🎧 Đang ghi âm story...',
      '📦 Sắp xong, đang đóng gói file...',
    ];

    function showProgress() {
      formSection.classList.add('hidden');
      errorSection.classList.add('hidden');
      resultSection.classList.add('hidden');
      progressSection.classList.remove('hidden');

      let idx = 0;
      statusText.textContent = stages[idx];
      statusInterval = setInterval(() => {
        idx = Math.min(idx + 1, stages.length - 1);
        statusText.textContent = stages[idx];
      }, 20000);

      progressSection.scrollIntoView({ behavior: 'smooth' });
    }

    function showResult(data) {
      clearInterval(statusInterval);
      progressSection.classList.add('hidden');

      document.getElementById('result-child-name').textContent = data.child_name || '';
      document.getElementById('result-topic').textContent = data.topic || '';
      document.getElementById('result-story-title').textContent = data.story_title || '';
      document.getElementById('pdf-link').href = data.pdf_url;
      document.getElementById('mp3-link').href = data.mp3_url;

      resultSection.classList.remove('hidden');
      resultSection.scrollIntoView({ behavior: 'smooth' });
    }

    function showError(msg) {
      clearInterval(statusInterval);
      progressSection.classList.add('hidden');
      document.getElementById('error-message').textContent = msg;
      errorSection.classList.remove('hidden');
      errorSection.scrollIntoView({ behavior: 'smooth' });
    }

    function resetForm() {
      formSection.classList.remove('hidden');
      resultSection.classList.add('hidden');
      errorSection.classList.add('hidden');
      form.reset();
      formSection.scrollIntoView({ behavior: 'smooth' });
    }

    document.getElementById('reset-btn').addEventListener('click', resetForm);
    document.getElementById('retry-btn').addEventListener('click', resetForm);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form));
      if (data.website) {
        showResult({ child_name: data.child_name, topic: 'spam', story_title: 'fake', pdf_url: '#', mp3_url: '#' });
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Đang tạo... (~2 phút)';
      showProgress();

      try {
        const res = await fetch('/api/generate-read2lead-pack', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await res.json();

        if (res.ok && result.ok && result.pdf_url) {
          showResult({ ...result, child_name: data.child_name });
        } else {
          showError(result.message || result.error || 'Có lỗi xảy ra, vui lòng thử lại.');
        }
      } catch (err) {
        showError('Mạng không ổn định. Vui lòng thử lại sau ít phút.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Tạo pack bằng mã đăng nhập';
      }
    });
  </script>
</BaseLayout>
