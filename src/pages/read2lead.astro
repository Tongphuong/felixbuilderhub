---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ZALO_DISPLAY, ZALO_URL } from '../config/contact';

const topics = [
  ['animals_pets', 'Động vật & thú cưng'],
  ['family_friends', 'Gia đình & bạn bè'],
  ['school', 'Trường học'],
  ['sports', 'Thể thao'],
  ['games_toys', 'Trò chơi & đồ chơi'],
  ['vehicles', 'Xe cộ & di chuyển'],
  ['food_cooking', 'Đồ ăn & nấu ăn'],
  ['nature', 'Thiên nhiên'],
  ['art_creativity', 'Vẽ tranh & sáng tạo'],
  ['heroes_jobs', 'Nghề nghiệp & ước mơ'],
  ['imagination', 'Tưởng tượng & phép màu'],
  ['vietnamese_holidays', 'Lễ hội Việt Nam'],
];

const learningSkills = [
  ['1', 'Luyện đọc hiểu', 'Con đọc một câu chuyện tiếng Anh ngắn, hợp với tuổi và mức đọc — đủ ngắn để không nản, đủ thú vị để con muốn đọc tiếp.'],
  ['2', 'Học cụm câu hữu ích', 'Mỗi bài có 4-6 cụm câu tiếng Anh ("take a deep breath", "try again slowly") con học và dùng được ngay, không phải nhớ từ rời rạc.'],
  ['3', 'Luyện viết qua bài tập', 'Sau truyện, con làm 3-4 bài tập ngắn: điền từ, sắp xếp câu, sửa câu sai — để tập dùng cụm câu vừa học.'],
  ['4', 'Luyện nghe và phát âm', 'Con nghe trực tiếp trên web: nghe truyện, nghe từng câu, rồi nói lại theo nhịp riêng.'],
  ['5', 'Luyện tư duy bằng tiếng Anh', 'Câu hỏi đọc hiểu và 1 câu hỏi mở để con tự viết 1-2 câu suy nghĩ — luyện viết câu hoàn chỉnh, không phải tick A/B/C/D.'],
];

const insideItems = [
  ['Nghe truyện', 'Con nghe câu chuyện trực tiếp trên web trước khi làm nhiệm vụ.'],
  ['Nghe hiểu', 'Con trả lời câu hỏi ngắn sau khi nghe để nắm ý chính.'],
  ['Sắp xếp câu', 'Con nghe từng câu, ghép từ lại đúng thứ tự để nhớ cấu trúc.'],
  ['Nói lại', 'Con nghe câu mẫu, ghi âm thử và tự luyện phát âm.'],
  ['Đọc hiểu', 'Con đọc lại truyện và trả lời câu hỏi về nội dung.'],
  ['XP và xu', 'Hoàn thành bài sẽ nhận XP và xu để mở level tiếp theo.'],
];

const homeSteps = [
  ['1', 'Nhập mã học sinh', 'Bố mẹ nhập mã Read2Lead của con để mở quyền tạo bài.'],
  ['2', 'Tạo bài trên web', 'Felixar tạo câu chuyện, audio và 4 nhiệm vụ nghe-đọc-nói ngay trong trình duyệt.'],
  ['3', 'Con làm bài online', 'Con nghe truyện, sắp xếp câu, nói lại và trả lời câu hỏi trên web.'],
  ['4', 'Nhận XP và xu', 'Hoàn thành bài sẽ cộng XP, xu và streak cho con.'],
  ['5', 'Mở level tiếp theo', 'Đủ XP thì hệ thống tự mở L2, L3 và các level cao hơn.'],
];

const faqItems = [
  ['Read2Lead dùng để làm gì?', 'Read2Lead giúp con luyện nghe, đọc, sắp xếp câu và nói lại qua một bài học tiếng Anh ngắn trên web.'],
  ['Bố mẹ cần làm gì sau khi tạo bài?', 'Cho con mở bài học trên web, nghe truyện, làm đủ 4 nhiệm vụ rồi bấm lưu chiến công để nhận XP và xu.'],
  ['Mã đăng nhập là gì? Lấy ở đâu?', `Mỗi phụ huynh khi đăng ký dùng Read2Lead sẽ nhận 1 mã từ Felix qua Zalo. Chưa có mã thì nhắn Zalo ${ZALO_DISPLAY} để hỏi cách nhận mã.`],
  ['Nên chọn mức đọc nào cho con?', 'Không cần chọn. Mọi bạn nhỏ bắt đầu từ L1, làm bài để tích XP rồi hệ thống tự mở level tiếp theo.'],
  ['Nếu bài quá khó hoặc quá dễ thì sao?', 'Bố mẹ nhắn Zalo Felix để được hỗ trợ. Hệ thống sẽ được tinh chỉnh dần theo kết quả làm bài thật của con.'],
  ['Bài học có cần tải file không?', 'Không cần. Toàn bộ bài học, audio, ghi âm và lưu kết quả đều làm trực tiếp trên web.'],
];
---

<BaseLayout
  title="Read2Lead - Bài đọc tiếng Anh riêng cho con | Felix Builder Hub"
  description="Read2Lead tạo bài học tiếng Anh riêng cho con trên web: có truyện ngắn, audio, nhiệm vụ nghe-đọc-nói, XP và xu."
>
  <Header />

  <main id="main" class="flex-1">
    <section class="mx-auto max-w-6xl px-6 py-20 text-center md:py-28">
      <span class="inline-block rounded-full bg-accent/20 px-4 py-1 text-sm font-semibold text-accent">12 bạn nhỏ đang dùng Read2Lead mỗi tuần</span>
      <h1 class="mx-auto mt-6 max-w-4xl font-display text-4xl font-extrabold text-cream md:text-5xl lg:text-6xl">
        <span class="block">Bài tập đọc tiếng Anh</span>
        <span class="block">cho con tự học tại nhà.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-muted md:text-xl">
        Mỗi bài có truyện ngắn, audio, nhiệm vụ nghe-đọc-nói và phần thưởng XP/xu. Con làm trực tiếp trên web từ đầu đến cuối. <span class="font-semibold text-cream">Miễn phí trong giai đoạn thử nghiệm.</span>
      </p>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-cream-dim">
        Phù hợp khi bố mẹ muốn cho con thêm bài đọc tiếng Anh ở nhà, hợp với tuổi và mức đọc của con.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="#form" class="inline-flex rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Đã có mã — Tạo bài cho con</a>
        <a href="/read2lead/review" class="inline-flex rounded-lg border border-cream-dim/40 px-6 py-3 font-semibold text-cream transition hover:border-gold hover:text-gold-light">Vào Felixar</a>
      </div>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-cream-dim">
        Miễn phí cho học sinh của Felix trong giai đoạn thử nghiệm. Chưa có mã? Nhắn Zalo {ZALO_DISPLAY} để nhận.
      </p>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div class="text-center">
          <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Mỗi bài Read2Lead luyện gì cho con?</h2>
          <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-cream-dim">5 kỹ năng con luyện qua mỗi bài đọc — viết, đọc, nghe, từ vựng, tư duy.</p>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {learningSkills.map(([number, title, description]) => (
            <div class="rounded-xl border border-cream-dim/20 bg-navy-950/75 p-6">
              <div class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-accent font-display text-lg font-bold text-navy-950">{number}</span>
                <div>
                  <h3 class="font-display text-xl font-bold text-cream">{title}</h3>
                  <p class="mt-2 leading-relaxed text-cream-muted">{description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-center font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Bên trong bài học có gì?</h2>
      <p class="mx-auto mt-5 max-w-2xl text-center leading-relaxed text-cream-dim">Đây là các phần con sẽ làm trực tiếp trên web sau khi tạo bài xong.</p>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {insideItems.map(([title, description]) => (
          <div class="rounded-lg border border-cream-dim/20 bg-navy-900/70 p-5">
            <h3 class="font-display text-xl font-bold text-cream">{title}</h3>
            <p class="mt-2 leading-relaxed text-cream-muted">{description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <h2 class="text-center font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Bài học web hoạt động thế nào?</h2>
        <p class="mx-auto mt-5 max-w-2xl text-center leading-relaxed text-cream-dim">Con đi qua 4 nhiệm vụ: nghe truyện, xếp câu, nói lại và đọc hiểu. Mỗi phần hoàn thành sẽ cộng tiến trình cho con.</p>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          <figure class="overflow-hidden rounded-xl bg-navy-950 shadow-2xl ring-1 ring-cream-dim/25">
            <div class="aspect-[3/4] overflow-hidden bg-navy-950">
              <img src="/read2lead/story.png" alt="Trang đọc của Read2Lead" loading="lazy" class="h-full w-full object-contain" />
            </div>
            <figcaption class="px-5 py-4 text-sm text-cream-muted"><strong class="text-cream">Nghe truyện</strong> - Câu chuyện ngắn có tên con.</figcaption>
          </figure>
          <figure class="overflow-hidden rounded-xl bg-navy-950 shadow-2xl ring-1 ring-cream-dim/25">
            <div class="aspect-[3/4] overflow-hidden bg-navy-950">
              <img src="/read2lead/chunk.png" alt="Trang bài luyện của Read2Lead" loading="lazy" class="h-full w-full object-contain" />
            </div>
            <figcaption class="px-5 py-4 text-sm text-cream-muted"><strong class="text-cream">Nhiệm vụ luyện</strong> - Con nghe, xếp câu và nói lại.</figcaption>
          </figure>
          <figure class="overflow-hidden rounded-xl bg-navy-950 shadow-2xl ring-1 ring-cream-dim/25">
            <div class="aspect-[3/4] overflow-hidden bg-navy-950">
              <img src="/read2lead/parents.png" alt="Trang đáp án cho phụ huynh" loading="lazy" class="h-full w-full object-contain" />
            </div>
            <figcaption class="px-5 py-4 text-sm text-cream-muted"><strong class="text-cream">Lưu chiến công</strong> - Con nhận XP, xu và tiến dần lên level mới.</figcaption>
          </figure>
        </div>
        <div class="mt-12 rounded-xl border border-gold/30 bg-gold/10 p-6 md:flex md:items-center md:gap-6">
          <div class="text-center md:text-left">
            <p class="font-display text-3xl font-bold text-gold-light">12 bạn nhỏ</p>
            <p class="mt-1 text-sm text-cream-dim">đang đọc Read2Lead mỗi tuần</p>
          </div>
          <div class="mt-4 md:mt-0 md:flex-1">
            <p class="italic leading-relaxed text-cream-muted">"Cháu đọc thấy tên mình trong truyện thì cười khoái chí. Tuần nào cũng hỏi 'mẹ ơi tuần này con là gì?'"</p>
            <p class="mt-2 text-sm text-cream-dim">— Phụ huynh bé H. (9 tuổi), TP.HCM</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">5 bước dùng tại nhà</h2>
        <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-cream-dim">Không cần tải file. Con làm bài, nghe audio và lưu kết quả ngay trên web.</p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-5">
        {homeSteps.map(([number, title, description]) => (
          <div class="rounded-lg border border-cream-dim/20 bg-navy-900/70 p-5">
            <div class="flex h-10 w-10 items-center justify-center rounded-md bg-accent font-display text-lg font-bold text-navy-950">{number}</div>
            <h3 class="mt-5 font-display text-lg font-bold text-cream">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-cream-muted">{description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="rounded-xl border border-gold/30 bg-gold/10 p-6 md:flex md:items-center md:justify-between md:gap-10">
        <div>
          <span class="inline-block rounded-md bg-gold/20 px-3 py-1 text-xs font-semibold text-gold-light">Felixar — đua sao</span>
          <h2 class="mt-4 font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Đua sao với bạn — học vì vui, không vì điểm</h2>
          <p class="mt-4 max-w-2xl leading-relaxed text-cream-muted">
            Con nộp ảnh bài làm + ghi âm kể lại câu chuyện. Felixar gửi nhận xét ngắn, cộng sao, mở bài tiếp theo. Mỗi bài qua là 1 sao. Đủ 3 sao là rank Chunk Explorer, 6 sao là Mission Builder, 10 sao là Story Hero. Bảng vinh danh cập nhật mỗi tuần.
          </p>
        </div>
        <div class="mt-6 shrink-0 md:mt-0">
          <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
            <a href="/read2lead/review" class="inline-flex justify-center rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Vào Felixar</a>
            <a href="/read2lead/leaderboard" class="inline-flex justify-center rounded-lg border border-gold px-6 py-3 font-semibold text-gold-light transition hover:bg-gold hover:text-navy-950">Xem bảng vinh danh</a>
          </div>
        </div>
      </div>
    </section>

    <section id="form" class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <div id="form-section">
          <div class="text-center">
            <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Tạo file cho con</h2>
            <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-cream-muted">Điền thông tin bên dưới. Nếu không chắc mức đọc nào phù hợp, hãy chọn mức 2 trước.</p>
          </div>

          <form id="r2l-form" class="mx-auto mt-10 max-w-xl space-y-5">
            <div>
              <label class="mb-2 block text-sm text-cream-muted">
                Mã đăng nhập <span class="text-red-400">*</span>
              </label>
              <input
                type="text"
                name="access_code"
                required
                maxlength="32"
                autocomplete="off"
                placeholder="VD: R2L-JUN-A4F2"
                class="w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-4 py-3 text-base uppercase text-cream placeholder:normal-case placeholder:text-cream-dim/80 focus:border-accent focus:outline-none"
              />
              <p class="mt-2 text-xs text-cream-dim">Chưa có mã? <a href={ZALO_URL} class="text-accent underline">Nhắn Zalo Felix</a> để nhận.</p>
            </div>
            <div>
              <label for="child_name" class="mb-2 block text-sm text-cream-muted">Tên con <span class="text-red-400">*</span></label>
              <input id="child_name" name="child_name" required maxlength="50" placeholder="VD: Linh" class="w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-4 py-3 text-base text-cream placeholder:text-cream-dim/80 focus:border-accent focus:outline-none" />
            </div>
            <div>
              <label for="age" class="mb-2 block text-sm text-cream-muted">Tuổi con <span class="text-red-400">*</span></label>
              <input id="age" type="number" name="age" min="5" max="14" required placeholder="5-14" class="w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-4 py-3 text-base text-cream placeholder:text-cream-dim/80 focus:border-accent focus:outline-none" />
            </div>
            <div class="rounded-lg border border-accent/30 bg-accent/10 p-4 text-sm leading-relaxed text-cream-muted">
              Mọi bạn nhỏ bắt đầu từ L1. Sau khi làm bài và tích lũy đủ XP, Read2Lead sẽ tự mở L2, L3 cho con.
            </div>
            <div>
              <label class="mb-2 block text-sm text-cream-muted">Giới tính con <span class="text-red-400">*</span></label>
              <div class="space-y-2 rounded-lg border border-cream-dim/30 bg-navy-950 p-4">
                <label class="flex cursor-pointer items-center gap-3">
                  <input type="radio" name="child_gender" value="boy" required class="h-4 w-4 accent-accent" checked />
                  <span>Bé trai</span>
                </label>
                <label class="flex cursor-pointer items-center gap-3">
                  <input type="radio" name="child_gender" value="girl" required class="h-4 w-4 accent-accent" />
                  <span>Bé gái</span>
                </label>
              </div>
            </div>
            <details class="group rounded-lg border border-cream-dim/30 bg-navy-950/60">
              <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold text-cream-muted transition hover:text-accent">
                <span>
                  Tùy chọn thêm: sở thích &amp; chủ đề của con
                  <span class="mt-0.5 block text-xs font-normal text-cream-dim">Không bắt buộc — bỏ qua thì Felix chọn giúp.</span>
                </span>
                <span class="ml-3 shrink-0 text-cream-dim transition group-open:rotate-180" aria-hidden="true">▾</span>
              </summary>
              <div class="space-y-5 px-4 pb-4 pt-1">
                <div>
                  <label for="interests" class="mb-2 block text-sm text-cream-muted">
                    Sở thích của con
                  </label>
                  <input
                    id="interests"
                    name="interests"
                    type="text"
                    maxlength="120"
                    placeholder="VD: bóng đá, Roblox, mèo, vẽ tranh..."
                    class="w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-4 py-3 text-base text-cream placeholder:text-cream-dim/80 focus:border-accent focus:outline-none"
                  />
                  <p class="mt-2 text-xs text-cream-dim">Nếu điền, câu chuyện sẽ cố gắng đi theo điều con thích.</p>
                </div>
                <div>
                  <label class="mb-2 block text-sm text-cream-muted">
                    Chủ đề con thích
                  </label>
                  <div class="grid grid-cols-2 gap-2 rounded-lg border border-cream-dim/30 bg-navy-950 p-3 sm:grid-cols-3">
                    <label class="flex cursor-pointer items-center gap-2 rounded-md p-2 transition hover:bg-navy-800 has-[:checked]:bg-accent/15 has-[:checked]:ring-1 has-[:checked]:ring-accent">
                      <input type="radio" name="topic" value="" class="h-3.5 w-3.5 accent-accent" checked />
                      <span class="text-sm text-cream">Felix chọn giúp</span>
                    </label>
                    {topics.map(([value, label]) => (
                      <label class="flex cursor-pointer items-center gap-2 rounded-md p-2 transition hover:bg-navy-800 has-[:checked]:bg-accent/15 has-[:checked]:ring-1 has-[:checked]:ring-accent">
                        <input type="radio" name="topic" value={value} class="h-3.5 w-3.5 accent-accent" />
                        <span class="text-sm text-cream">{label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </div>
            </details>
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" tabindex="-1" />
            </div>
            <button type="submit" class="w-full rounded-lg bg-accent px-6 py-3 text-lg font-semibold text-navy-950 transition hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-70">Tạo file đọc cho con</button>
            <p class="text-center text-xs text-cream-dim/80">Gửi form đồng nghĩa anh chị đồng ý <a href="/privacy" class="underline transition hover:text-accent">chính sách dữ liệu</a> của Felix.</p>
          </form>
        </div>

        <div id="progress-section" class="mx-auto hidden max-w-2xl rounded-lg border border-cream-dim/20 bg-navy-950 p-6 text-center">
          <div class="h-3 overflow-hidden rounded-full bg-navy-800">
            <div class="h-full w-2/3 animate-pulse rounded-full bg-gradient-to-r from-accent via-gold-light to-accent"></div>
          </div>
          <p id="status-text" class="mt-6 text-lg font-semibold text-cream"></p>
          <p class="mt-3 text-sm text-cream-dim">Lần đầu có thể chậm hơn một chút vì máy chủ cần khởi động.</p>
        </div>

        <div id="result-section" class="mx-auto hidden max-w-2xl rounded-lg border border-gold/40 bg-gold/10 p-6 text-center">
          <h2 class="font-display text-3xl font-bold leading-snug text-cream">Bài học của <span id="result-child-name"></span> đã sẵn sàng</h2>
          <div class="mt-5 space-y-2 text-cream-muted">
            <p>Chủ đề: <span id="result-topic" class="font-semibold text-cream"></span></p>
            <p>Tên truyện: <span id="result-story-title" class="font-semibold text-cream"></span></p>
          </div>
          <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
            <a id="lesson-link" href="/read2lead/lesson" class="rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Mở bài học trên web</a>
          </div>
          <p class="mt-6 text-sm leading-relaxed text-cream-muted">
            Con nghe truyện, làm 4 nhiệm vụ và lưu chiến công trực tiếp trên web. Bố mẹ có thể mở <a id="review-link" href="/read2lead/review" class="font-semibold text-gold-light underline">Felixar</a> để xem tiến trình.
          </p>
          <div class="mt-6">
            <p class="text-cream-dim">Muốn tạo file khác cho bé khác?</p>
            <button id="reset-btn" type="button" class="mt-3 rounded-lg border border-cream-dim/30 px-5 py-2 font-semibold text-cream transition hover:border-accent hover:text-accent">Làm lại form</button>
          </div>
        </div>

        <div id="error-section" class="mx-auto hidden max-w-2xl rounded-lg border border-red-500/30 bg-red-500/10 p-6 text-center">
          <p class="text-lg font-semibold text-red-400">Có lỗi xảy ra: <span id="error-message"></span></p>
          <button id="retry-btn" type="button" class="mt-5 rounded-lg bg-accent px-5 py-2 font-semibold text-navy-950 transition hover:bg-accent-hover">Thử lại</button>
          <p class="mt-4 text-sm text-cream-muted">Nếu lỗi tiếp tục, nhắn Zalo {ZALO_DISPLAY}</p>
        </div>
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Câu hỏi thường gặp</h2>
        <div class="mt-10 space-y-3">
          {faqItems.map(([question, answer]) => (
            <details class="rounded-lg border border-cream-dim/20 bg-navy-950/75 p-5">
              <summary class="cursor-pointer font-display text-lg font-bold text-cream">{question}</summary>
              <p class="mt-4 leading-relaxed text-cream-muted">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20 text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-cream-dim">Bạn cũng có thể quan tâm</p>
      <div class="mx-auto mt-6 max-w-2xl rounded-lg border border-accent bg-navy-900/70 p-8">
        <h3 class="font-display text-2xl font-bold leading-snug text-cream">MSMW - Sách truyện cá nhân hóa làm quà tặng</h3>
        <p class="mt-4 leading-relaxed text-cream-muted">Một cuốn sách 20 trang với con là nhân vật chính, phù hợp làm quà sinh nhật hoặc dịp đặc biệt.</p>
        <a href="/msmw" class="mt-6 inline-flex font-semibold text-accent transition hover:text-accent-hover">Xem MSMW</a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const form = document.getElementById('r2l-form');
    const btn = form.querySelector('button[type="submit"]');
    const progressSection = document.getElementById('progress-section');
    const statusText = document.getElementById('status-text');
    const resultSection = document.getElementById('result-section');
    const errorSection = document.getElementById('error-section');
    const formSection = document.getElementById('form-section');

    let statusInterval = null;
    let pollInterval = null;
    let pollAttempts = 0;
    let pollInFlight = false;
    let activeTaskId = null;
    let generationComplete = false;
    const MAX_POLL_ATTEMPTS = 60;
    const POLL_INTERVAL_MS = 5000;

    const stages = [
      '✍️ Đang viết câu chuyện riêng cho con...',
      '🎙️ Đang ghi âm câu chuyện thành file nghe...',
      '🔊 Đang ghi âm các cụm câu để con tập đọc...',
      '🎮 Đang chuẩn bị nhiệm vụ web cho con...',
      '✨ Sắp xong rồi, đang đóng gói file...',
    ];

    function showProgress() {
      formSection.classList.add('hidden');
      errorSection.classList.add('hidden');
      resultSection.classList.add('hidden');
      progressSection.classList.remove('hidden');

      let idx = 0;
      statusText.textContent = stages[idx];
      statusInterval = setInterval(() => {
        idx = Math.min(idx + 1, stages.length - 1);
        statusText.textContent = stages[idx];
      }, 15000);

      progressSection.scrollIntoView({ behavior: 'smooth' });
    }

    function showResult(data) {
      clearInterval(statusInterval);
      if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
      generationComplete = true;
      activeTaskId = null;
      progressSection.classList.add('hidden');
      errorSection.classList.add('hidden');

      document.getElementById('result-child-name').textContent = data.child_name || '';
      document.getElementById('result-topic').textContent = data.topic || '';
      document.getElementById('result-story-title').textContent = data.story_title || '';
      document.getElementById('lesson-link').href = data.lesson_link || '/read2lead/lesson';
      document.getElementById('review-link').href = data.review_link || '/read2lead/review';

      resultSection.classList.remove('hidden');
      resultSection.scrollIntoView({ behavior: 'smooth' });
    }

    function showError(msg) {
      if (generationComplete) return;
      clearInterval(statusInterval);
      progressSection.classList.add('hidden');
      resultSection.classList.add('hidden');
      document.getElementById('error-message').textContent = msg;
      errorSection.classList.remove('hidden');
      errorSection.scrollIntoView({ behavior: 'smooth' });
    }

    function resetForm() {
      if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
      pollInFlight = false;
      activeTaskId = null;
      generationComplete = false;
      formSection.classList.remove('hidden');
      resultSection.classList.add('hidden');
      errorSection.classList.add('hidden');
      form.reset();
      formSection.scrollIntoView({ behavior: 'smooth' });
    }

    document.getElementById('reset-btn').addEventListener('click', resetForm);
    document.getElementById('retry-btn').addEventListener('click', resetForm);

    async function pollGenerationStatus(accessCode, taskId, childName) {
      if (generationComplete || activeTaskId !== taskId || pollInFlight) return;
      pollInFlight = true;
      try {
        const res = await fetch(`/api/check-generation-status?access_code=${encodeURIComponent(accessCode)}&task_id=${encodeURIComponent(taskId)}`);
        const result = await res.json();

        if (generationComplete || activeTaskId !== taskId) return;

        if (result.status === 'pending') {
          pollAttempts += 1;
          const statusEl = document.getElementById('status-text');
          if (statusEl) {
            const pos = typeof result.queue_position === 'number' ? result.queue_position : null;
            if (pos && pos > 3) {
              const ahead = pos - 3;
              const estMinutes = Math.max(1, Math.ceil((ahead * 60) / 60));
              statusEl.textContent = `Hệ thống đang bận: còn ${ahead} bài trước con. Đợi khoảng ${estMinutes} phút...`;
            } else if (pos && pos > 0) {
              statusEl.textContent = 'Bài của con đang được tạo. Đợi khoảng 1 phút...';
            }
          }
          if (pollAttempts >= MAX_POLL_ATTEMPTS) {
            clearInterval(pollInterval);
            pollInterval = null;
            activeTaskId = null;
            showError('Tạo bài quá lâu. Vui lòng thử lại hoặc nhắn Zalo Felix.');
          }
          return;
        }

        clearInterval(pollInterval);
        pollInterval = null;
        activeTaskId = null;

        if (result.status === 'done' && result.lesson_link) {
          showResult({
            ...result,
            child_name: childName,
          });
        } else {
          showError(result.message || result.error || 'Tạo bài thất bại.');
        }
      } catch (err) {
        if (generationComplete || activeTaskId !== taskId) return;
        clearInterval(pollInterval);
        pollInterval = null;
        activeTaskId = null;
        showError('Mất kết nối khi kiểm tra trạng thái. Thử lại sau.');
      } finally {
        pollInFlight = false;
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form));
      if (data.website) {
        formSection.classList.add('hidden');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Đang tạo...';
      showProgress();
      pollAttempts = 0;
      generationComplete = false;

      try {
        const res = await fetch('/api/generate-read2lead-pack', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await res.json();

        if (!res.ok || !result.ok) {
          showError(result.review_link ? `${result.message || result.error} Mở Felixar: ${result.review_link}` : (result.message || result.error || 'Có lỗi xảy ra, vui lòng thử lại.'));
          return;
        }

        if (result.status === 'done' && result.lesson_link) {
          showResult({
            ...result,
            child_name: data.child_name,
          });
          return;
        }

        if (!result.task_id) {
          showError('Backend không trả task_id hoặc lesson_link. Vui lòng thử lại.');
          return;
        }

        activeTaskId = result.task_id;
        pollGenerationStatus(data.access_code.toUpperCase(), result.task_id, data.child_name);
        pollInterval = setInterval(
          () => pollGenerationStatus(data.access_code.toUpperCase(), result.task_id, data.child_name),
          POLL_INTERVAL_MS,
        );
      } catch (err) {
        showError('Mạng không ổn định. Vui lòng thử lại sau ít phút.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Tạo file đọc cho con';
      }
    });
  </script>
</BaseLayout>
