---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ZALO_DISPLAY, ZALO_URL } from '../config/contact';
import { MSMW_DIGITAL_VND, MSMW_HARDCOPY_VND, formatVND } from '../config/pricing';

const features = [
  ['📖', '20 trang đầy đủ', 'Bìa, lời đề tặng, 16 trang câu chuyện, bìa sau'],
  ['🌏', 'Song ngữ Việt–Anh', 'Mỗi trang có cả 2 ngôn ngữ, bé học tự nhiên'],
  ['👶', 'Bé là nhân vật chính', 'Ảnh thật của con xuất hiện trong từng cảnh'],
  ['🎨', 'Minh hoạ riêng', 'Tạo bằng AI cho từng cuốn, không trùng nhau'],
  ['⏰', 'Nhận nhanh', '24h cho bản số, 5 ngày cho bản in'],
  ['💝', 'Quà ý nghĩa', 'Hợp cho sinh nhật, Tết thiếu nhi, dịp đặc biệt'],
];

const steps = [
  ['Điền thông tin', 'Tên + tuổi + giới tính của bé'],
  ['Felix nhắn Zalo', 'Xin ảnh con + xác nhận đơn'],
  ['Tạo sách cá nhân', 'Felix làm sách trong 24h (bản số) / 5 ngày (bản in)'],
  ['Nhận sách', 'File PDF hoặc bản in tận tay'],
];

const stories = [
  {
    id: 'toy_brick_city_v4',
    title_vi: 'Thành Phố Gạch Màu',
    title_en: 'The Lost Toy Brick City',
    hook: 'Bé giải cứu thành phố cùng robot Minny — học không bỏ rơi bạn bè.',
    tags: ['Bé trai', 'Dũng cảm'],
    thumb: '/msmw/thumb-toy-brick.jpg',
    default_gender: 'boy',
  },
  {
    id: 'heart_garden_v1',
    title_vi: 'Khu Vườn Trái Tim',
    title_en: 'The Heart Garden',
    hook: 'Bé học cách trao đi yêu thương và chăm sóc người khác.',
    tags: ['Bé gái', 'Yêu thương'],
    thumb: '/msmw/thumb-heart-garden.jpg',
    default_gender: 'girl',
  },
  {
    id: 'dark_lighthouse_v1',
    title_vi: 'Ngọn Hải Đăng Tối',
    title_en: 'The Dark Lighthouse',
    hook: 'Bé thắp lại ngọn đèn giữa biển bão — học cách ngồi xuống thay vì bỏ cuộc.',
    tags: ['Bé trai', 'Kiên trì'],
    thumb: '/msmw/thumb-dark-lighthouse.svg',
    default_gender: 'boy',
  },
  {
    id: 'dawn_mountain_v1',
    title_vi: 'Núi Bình Minh',
    title_en: 'Dawn Mountain',
    hook: 'Bé giữ lời hứa với chính mình — đến đỉnh núi muộn nhất để thấy bình minh đẹp nhất.',
    tags: ['Bé gái', 'Kiên trì'],
    thumb: '/msmw/thumb-dawn-mountain.svg',
    default_gender: 'girl',
  },
];

const faqItems = [
  ['Tại sao cần ảnh của con?', 'Ảnh con là chất liệu để Felix tạo các cảnh minh hoạ có con xuất hiện như nhân vật chính. Không có ảnh, sách sẽ không cá nhân hoá được.'],
  ['Sách có thật sự cá nhân hoá hay chỉ đổi tên?', 'Mỗi cuốn có 16 trang minh hoạ riêng. Felix dùng AI để tạo cảnh có khuôn mặt và dáng người con trong câu chuyện. Hai cuốn sách của hai bé khác nhau sẽ trông hoàn toàn khác.'],
  ['Bao lâu thì nhận sách?', 'Bản số (PDF): 24h sau khi xác nhận. Bản in: 5 ngày, giao tận nhà toàn quốc.'],
  ['Có refund không nếu không hài lòng?', 'Bản số có thể edit lại 1 lần miễn phí nếu sai tên hoặc cần chỉnh sửa. Bản in đã ship không hoàn tiền nhưng Felix sẽ làm lại nếu lỗi từ phía sản xuất.'],
  ['Sách dùng ngôn ngữ gì?', 'Mỗi trang có cả tiếng Việt và tiếng Anh. Bé đọc tiếng Việt trước, parent có thể đọc tiếng Anh cho bé khi muốn.'],
  ['Đặt nhiều cuốn cho nhiều bé được không?', 'Được. Mỗi bé một form riêng. Nếu đặt 2+ cuốn cùng lúc, nhắn Zalo Felix để có ưu đãi.'],
];
---

<BaseLayout
  title="MSMW — Sách truyện cá nhân hoá cho con của bạn | Felix Builder Hub"
  description="Sách truyện song ngữ Việt-Anh với chính con bạn là nhân vật chính. Bản số 69k, bản in 129k. Giao toàn quốc."
>
  <Header />

  <main id="main" class="flex-1">
    <section class="mx-auto max-w-6xl px-6 py-20 text-center md:py-32">
      <h1 class="mx-auto max-w-5xl font-display text-4xl font-extrabold leading-snug text-cream md:text-6xl">Con là nhân vật chính trong câu chuyện của riêng mình.</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-muted md:text-xl">Sách truyện cá nhân hoá song ngữ Việt–Anh, dành riêng cho con của bạn.</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="#form" class="w-full rounded-lg bg-accent px-6 py-3 text-center font-semibold text-navy-950 transition hover:bg-accent-hover sm:w-auto">Đặt sách cho con</a>
        <a href={ZALO_URL} class="w-full rounded-lg border border-cream-dim/30 px-6 py-3 text-center font-semibold text-cream transition hover:border-accent hover:text-accent sm:w-auto">Liên hệ Zalo</a>
      </div>
    </section>

    <section id="stories" class="bg-navy-900 px-6 py-20" aria-labelledby="story-picker-heading">
      <div class="mx-auto max-w-6xl">
        <div class="text-center">
          <h2 id="story-picker-heading" class="font-display text-3xl font-bold text-cream md:text-4xl">Chọn câu chuyện cho con của bạn</h2>
          <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-cream-dim">4 câu chuyện gốc, mỗi câu chuyện một bài học khác nhau. Bé là nhân vật chính trong câu chuyện bạn chọn.</p>
        </div>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {stories.map((s) => (
            <article id={`story-${s.id}`} class="group flex flex-col overflow-hidden rounded-xl border border-cream-dim/20 bg-navy-950 transition hover:border-accent hover:shadow-xl">
              <div class="aspect-[2/3] overflow-hidden bg-navy-800">
                <img src={s.thumb} alt={`Bìa truyện ${s.title_vi}`} loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="font-display text-xl font-bold text-cream">{s.title_vi}</h3>
                <p class="mt-1 text-sm italic text-cream-dim">{s.title_en}</p>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-cream-muted">{s.hook}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {s.tags.map((t) => (
                    <span class="rounded-full bg-navy-800 px-3 py-1 text-xs font-semibold text-cream-dim">{t}</span>
                  ))}
                </div>
                <button type="button" data-story={s.id} data-gender={s.default_gender} class="story-pick-btn mt-5 inline-flex w-full items-center justify-center rounded-lg border border-cream-dim/30 px-4 py-2.5 font-semibold text-cream transition hover:border-accent hover:bg-accent hover:text-navy-950">
                  Chọn truyện này →
                </button>
              </div>
            </article>
          ))}
        </div>
        <p class="mt-8 text-center text-sm text-cream-dim/80">* Mỗi cuốn gồm 20 trang song ngữ Việt–Anh. Khuôn mặt bé được làm riêng từ ảnh bạn gửi.</p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-center font-display text-3xl font-bold text-cream md:text-4xl">Bên trong cuốn sách</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {features.map(([icon, title, description]) => (
          <div class="flex gap-4 rounded-lg border border-cream-dim/20 bg-navy-900/70 p-5">
            <span class="text-3xl" aria-hidden="true">{icon}</span>
            <div>
              <h3 class="font-display text-xl font-bold text-cream">{title}</h3>
              <p class="mt-2 leading-relaxed text-cream-muted">{description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <h2 class="text-center font-display text-3xl font-bold text-cream md:text-4xl">Cách đặt sách — 4 bước</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-4">
          {steps.map(([title, description], index) => (
            <div class="rounded-lg border border-cream-dim/20 bg-navy-950/75 p-5">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent font-display text-lg font-bold text-navy-950">{index + 1}</div>
              <h3 class="mt-5 font-display text-xl font-bold text-cream">{title}</h3>
              <p class="mt-3 leading-relaxed text-cream-muted">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="pricing" class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-center font-display text-3xl font-bold text-cream md:text-4xl">Chọn phiên bản phù hợp</h2>
      <div class="mx-auto mt-10 grid max-w-4xl gap-6 md:grid-cols-2">
        <article class="rounded-lg border border-cream-dim/30 bg-navy-900/70 p-6">
          <span class="inline-flex rounded-full bg-navy-800 px-3 py-1 text-xs font-semibold text-cream-muted">Tự in tại nhà</span>
          <h3 class="mt-5 font-display text-2xl font-bold text-cream">Bản số (PDF)</h3>
          <p class="mt-4 font-display text-5xl font-extrabold text-cream">{formatVND(MSMW_DIGITAL_VND)}</p>
          <ul class="mt-6 space-y-3 text-cream-muted">
            <li class="flex gap-3"><span class="text-gold-light">✓</span>File PDF chất lượng cao</li>
            <li class="flex gap-3"><span class="text-gold-light">✓</span>Nhận trong 24h</li>
            <li class="flex gap-3"><span class="text-gold-light">✓</span>In bao nhiêu bản tuỳ ý</li>
            <li class="flex gap-3"><span class="text-gold-light">✓</span>Có thể in cửa hàng / in màu nhà</li>
          </ul>
          <a href="#form" data-version="digital" class="mt-8 inline-flex w-full justify-center rounded-lg border border-cream-dim/30 px-6 py-3 font-semibold text-cream transition hover:border-accent hover:text-accent">Đặt bản số</a>
        </article>

        <article class="relative rounded-lg border border-accent bg-navy-900/70 p-6">
          <span class="absolute right-5 top-5 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-navy-950">Được chọn nhiều nhất</span>
          <h3 class="mt-10 font-display text-2xl font-bold text-cream sm:mt-0">Bản in giao tận nơi</h3>
          <p class="mt-4 font-display text-5xl font-extrabold text-cream">{formatVND(MSMW_HARDCOPY_VND)}</p>
          <ul class="mt-6 space-y-3 text-cream-muted">
            <li class="flex gap-3"><span class="text-gold-light">✓</span>Sách in bìa cứng / chất liệu cao cấp</li>
            <li class="flex gap-3"><span class="text-gold-light">✓</span>Giao tận nhà toàn quốc</li>
            <li class="flex gap-3"><span class="text-gold-light">✓</span>Nhận trong 5 ngày</li>
            <li class="flex gap-3"><span class="text-gold-light">✓</span>Đóng gói cẩn thận, sẵn làm quà</li>
          </ul>
          <a href="#form" data-version="hardcopy" class="mt-8 inline-flex w-full justify-center rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Đặt bản in</a>
        </article>
      </div>
    </section>

    <section id="form" class="mx-auto max-w-6xl px-6 py-20">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold text-cream md:text-4xl">Đặt sách cho con</h2>
        <p class="mt-4 text-cream-muted">Felix sẽ liên hệ qua Zalo trong 24h</p>
      </div>
      <form id="msmw-form" class="mx-auto mt-10 max-w-xl space-y-5">
        <div>
          <label for="parent_name" class="mb-2 block text-sm text-cream-muted">Tên phụ huynh <span class="text-red-400">*</span></label>
          <input id="parent_name" name="parent_name" required maxlength="100" class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream focus:border-accent" />
        </div>
        <div>
          <label for="child_name" class="mb-2 block text-sm text-cream-muted">Tên con (sẽ in trong sách) <span class="text-red-400">*</span></label>
          <input id="child_name" name="child_name" required maxlength="50" class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream focus:border-accent" />
        </div>
        <div>
          <label for="child_age" class="mb-2 block text-sm text-cream-muted">Tuổi con <span class="text-red-400">*</span></label>
          <input id="child_age" type="number" name="child_age" min="2" max="15" required class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream focus:border-accent" />
        </div>
        <div>
          <label for="child_gender" class="mb-2 block text-sm text-cream-muted">Giới tính con <span class="text-red-400">*</span></label>
          <select id="child_gender" name="child_gender" required class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream focus:border-accent">
            <option value="" disabled selected>-- Chọn giới tính --</option>
            <option value="boy">Bé trai</option>
            <option value="girl">Bé gái</option>
          </select>
        </div>
        <fieldset>
          <legend class="mb-2 block text-sm text-cream-muted">Câu chuyện <span class="text-red-400">*</span></legend>
          <div class="space-y-3 rounded-lg border border-cream-dim/30 bg-navy-900 p-4">
            {stories.map((s) => (
              <label class="flex items-start gap-3 text-base text-cream">
                <input type="radio" name="story_template" value={s.id} required class="mt-1 h-4 w-4 accent-accent" />
                <span class="leading-snug">{s.title_vi} <span class="text-cream-dim">— {s.tags[1]}</span></span>
              </label>
            ))}
          </div>
          <p class="mt-2 text-xs text-cream-dim/80">Chưa biết chọn? Xem mô tả 4 câu chuyện ở <a href="#stories" class="text-accent underline">phần trên</a>.</p>
        </fieldset>
        <fieldset>
          <legend class="mb-2 block text-sm text-cream-muted">Phiên bản <span class="text-red-400">*</span></legend>
          <div class="space-y-3 rounded-lg border border-cream-dim/30 bg-navy-900 p-4">
            <label class="flex items-center gap-3 text-base text-cream">
              <input type="radio" name="version" value="digital" required class="h-4 w-4 accent-accent" />
              <span>Bản số (PDF) — {formatVND(MSMW_DIGITAL_VND)}</span>
            </label>
            <label class="flex items-center gap-3 text-base text-cream">
              <input type="radio" name="version" value="hardcopy" required checked class="h-4 w-4 accent-accent" />
              <span>Bản in (giao tận nơi) — {formatVND(MSMW_HARDCOPY_VND)}</span>
            </label>
          </div>
        </fieldset>
        <div>
          <label for="zalo_phone" class="mb-2 block text-sm text-cream-muted">Số Zalo <span class="text-red-400">*</span></label>
          <input id="zalo_phone" type="tel" name="zalo_phone" required pattern="^[+0-9\s\-()]{8,20}$" class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream focus:border-accent" />
        </div>
        <div>
          <label for="note" class="mb-2 block text-sm text-cream-muted">Lời nhắn thêm</label>
          <textarea id="note" name="note" maxlength="500" rows="3" placeholder="Sinh nhật con, dịp đặc biệt, yêu cầu khác..." class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream focus:border-accent"></textarea>
        </div>
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" tabindex="-1" />
        </div>
        <button type="submit" class="w-full rounded-lg bg-accent px-6 py-3 text-lg font-semibold text-navy-950 transition hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-70">Gửi yêu cầu — Felix sẽ liên hệ qua Zalo</button>
        <p class="mt-3 text-center text-xs text-cream-dim/80">Felix chỉ dùng thông tin để liên hệ và làm sách. Không chia sẻ với bên thứ ba.</p>
      </form>
      <div id="form-status" class="mx-auto mt-8 hidden max-w-xl rounded-lg border border-cream-dim/20 bg-navy-900 p-5 text-center font-semibold"></div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-16">
      <div class="rounded-2xl border border-cream-dim/20 bg-navy-900/60 p-8 text-center md:p-12">
        <h2 class="font-display text-2xl font-bold leading-snug text-cream md:text-3xl">Anh chị đã đặt MSMW?</h2>
        <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-cream-muted">Nếu bé đã nhận sách và anh chị thấy thích, Felix rất biết ơn nếu được dùng vài dòng cảm nhận để giới thiệu với phụ huynh khác.</p>
        <a href={ZALO_URL} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex rounded-lg border border-accent px-5 py-2.5 font-semibold text-accent transition hover:bg-accent hover:text-navy-950">
          Gửi cảm nhận qua Zalo
        </a>
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center font-display text-3xl font-bold text-cream md:text-4xl">Câu hỏi thường gặp</h2>
        <div class="mt-10 space-y-3">
          {faqItems.map(([question, answer]) => (
            <details class="rounded-lg border border-cream-dim/20 bg-navy-950/75 p-5">
              <summary class="cursor-pointer font-display text-lg font-bold text-cream">{question}</summary>
              <p class="mt-4 leading-relaxed text-cream-muted">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20 text-center">
      <h2 class="font-display text-3xl font-bold text-cream md:text-4xl">Tặng con một câu chuyện riêng</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-cream-muted">Mỗi bé chỉ có một tuổi thơ. Hãy để con có sách của riêng mình.</p>
      <a href="#form" class="mt-8 inline-flex rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Đặt sách ngay →</a>
    </section>
  </main>

  <Footer />

  <script define:vars={{ ZALO_URL, ZALO_DISPLAY }}>
    const form = document.getElementById('msmw-form');
    const btn = form.querySelector('button[type="submit"]');
    const statusEl = document.getElementById('form-status');

    const VALID_STORIES = ['toy_brick_city_v4', 'heart_garden_v1', 'dark_lighthouse_v1', 'dawn_mountain_v1'];
    const STORY_DEFAULT_GENDER = {
      toy_brick_city_v4: 'boy',
      heart_garden_v1: 'girl',
      dark_lighthouse_v1: 'boy',
      dawn_mountain_v1: 'girl',
    };

    const pageUrl = new URL(window.location.href);
    const urlRef = pageUrl.searchParams.get('ref') || '';
    const urlStoryParam = pageUrl.searchParams.get('story') || '';
    const urlStoryHash = location.hash.startsWith('#story-') ? location.hash.slice(7) : '';
    const initialStory = VALID_STORIES.includes(urlStoryParam)
      ? urlStoryParam
      : VALID_STORIES.includes(urlStoryHash)
        ? urlStoryHash
        : '';

    function selectStory(storyId, defaultGender) {
      if (!VALID_STORIES.includes(storyId)) return;
      const radio = form.querySelector(`input[name="story_template"][value="${storyId}"]`);
      if (radio) radio.checked = true;
      if (defaultGender) {
        const genderEl = document.getElementById('child_gender');
        if (genderEl && !genderEl.value) genderEl.value = defaultGender;
      }
      const formSection = document.getElementById('form');
      if (formSection) formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    document.querySelectorAll('.story-pick-btn').forEach((b) => {
      b.addEventListener('click', () => {
        selectStory(b.dataset.story, b.dataset.gender);
      });
    });

    document.querySelectorAll('[data-version]').forEach((link) => {
      link.addEventListener('click', () => {
        const radio = form.querySelector(`input[name="version"][value="${link.dataset.version}"]`);
        if (radio) radio.checked = true;
      });
    });

    if (initialStory) {
      setTimeout(() => selectStory(initialStory, STORY_DEFAULT_GENDER[initialStory]), 150);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form));
      if (urlRef) data.ref = urlRef;

      if (data.website) {
        showSuccess();
        return;
      }

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Đang gửi...';

      try {
        const res = await fetch('/api/msmw-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          showSuccess();
        } else {
          showError();
          btn.disabled = false;
          btn.textContent = originalText;
        }
      } catch (err) {
        showError();
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });

    function showSuccess() {
      form.style.display = 'none';
      statusEl.className = 'mx-auto mt-8 max-w-xl rounded-lg border border-gold/40 bg-gold/10 p-5 text-center font-semibold text-gold-light';
      statusEl.innerHTML = `✅ Gửi thành công! Felix sẽ Zalo cho anh chị trong 24h. Nếu gấp, anh chị nhắn <a href="${ZALO_URL}" class="underline">Zalo ${ZALO_DISPLAY}</a> ngay.`;
      statusEl.scrollIntoView({ behavior: 'smooth' });
    }

    function showError() {
      statusEl.className = 'mx-auto mt-8 max-w-xl rounded-lg border border-red-500/30 bg-red-500/10 p-5 text-center font-semibold text-red-400';
      statusEl.innerHTML = `⚠️ Có lỗi xảy ra. Vui lòng thử lại hoặc nhắn trực tiếp <a href="${ZALO_URL}" class="underline">Zalo ${ZALO_DISPLAY}</a>`;
    }
  </script>
</BaseLayout>
