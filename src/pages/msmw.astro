---
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  ['📖', '20 trang đầy đủ', 'Bìa, lời đề tặng, 16 trang câu chuyện, bìa sau'],
  ['🌏', 'Song ngữ Việt–Anh', 'Mỗi trang có cả 2 ngôn ngữ, bé học tự nhiên'],
  ['👶', 'Bé là nhân vật chính', 'Ảnh thật của con xuất hiện trong từng cảnh'],
  ['🎨', 'Minh hoạ riêng', 'Tạo bằng AI cho từng cuốn, không trùng nhau'],
  ['⏰', 'Nhận nhanh', '24h cho bản số, 5 ngày cho bản in'],
  ['💝', 'Quà ý nghĩa', 'Hợp cho sinh nhật, Tết thiếu nhi, dịp đặc biệt'],
];

const steps = [
  ['Điền thông tin', 'Tên + tuổi + giới tính của bé'],
  ['Felix nhắn Zalo', 'Xin ảnh con + xác nhận đơn'],
  ['Tạo sách cá nhân', 'Felix làm sách trong 24h (bản số) / 5 ngày (bản in)'],
  ['Nhận sách', 'File PDF hoặc bản in tận tay'],
];

const faqItems = [
  ['Tại sao cần ảnh của con?', 'Ảnh con là chất liệu để Felix tạo các cảnh minh hoạ có con xuất hiện như nhân vật chính. Không có ảnh, sách sẽ không cá nhân hoá được.'],
  ['Sách có thật sự cá nhân hoá hay chỉ đổi tên?', 'Mỗi cuốn có 16 trang minh hoạ riêng. Felix dùng AI để tạo cảnh có khuôn mặt và dáng người con trong câu chuyện. Hai cuốn sách của hai bé khác nhau sẽ trông hoàn toàn khác.'],
  ['Bao lâu thì nhận sách?', 'Bản số (PDF): 24h sau khi xác nhận. Bản in: 5 ngày, giao tận nhà toàn quốc.'],
  ['Có refund không nếu không hài lòng?', 'Bản số có thể edit lại 1 lần miễn phí nếu sai tên hoặc cần chỉnh sửa. Bản in đã ship không hoàn tiền nhưng Felix sẽ làm lại nếu lỗi từ phía sản xuất.'],
  ['Sách dùng ngôn ngữ gì?', 'Mỗi trang có cả tiếng Việt và tiếng Anh. Bé đọc tiếng Việt trước, parent có thể đọc tiếng Anh cho bé khi muốn.'],
  ['Đặt nhiều cuốn cho nhiều bé được không?', 'Được. Mỗi bé một form riêng. Nếu đặt 2+ cuốn cùng lúc, nhắn Zalo Felix để có ưu đãi.'],
];
---

<BaseLayout
  title="MSMW — Sách truyện cá nhân hoá cho bé yêu | Felix Builder Hub"
  description="Sách truyện song ngữ Việt-Anh với chính con bạn là nhân vật chính. Bản số 69k, bản in 129k. Giao toàn quốc."
>
  <header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="font-display text-lg font-semibold text-white">Felix Builder Hub</a>
      <nav class="hidden items-center gap-6 text-sm font-medium text-slate-300 sm:flex">
        <a href="/#products" class="transition hover:text-accent">Sản phẩm</a>
        <a href="/#contact" class="transition hover:text-accent">Liên hệ</a>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <section class="mx-auto max-w-6xl px-6 py-20 text-center md:py-32">
      <h1 class="mx-auto max-w-5xl font-display text-4xl font-extrabold leading-tight text-white md:text-6xl">Con là nhân vật chính trong câu chuyện của riêng mình.</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-300 md:text-xl">Sách truyện cá nhân hoá song ngữ Việt–Anh, dành riêng cho bé yêu của bạn.</p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="#form" class="w-full rounded-lg bg-accent px-6 py-3 text-center font-semibold text-white transition hover:bg-accent-hover sm:w-auto">Đặt sách cho con</a>
        <a href="https://zalo.me/0396868675" class="w-full rounded-lg border border-slate-700 px-6 py-3 text-center font-semibold text-slate-100 transition hover:border-accent hover:text-accent sm:w-auto">Liên hệ Zalo</a>
      </div>
    </section>

    <section class="bg-slate-900 px-6 py-20">
      <div class="mx-auto max-w-6xl text-center">
        <h2 class="font-display text-3xl font-bold text-white md:text-4xl">Mỗi bé một câu chuyện riêng</h2>
        <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-slate-400">Cùng một câu chuyện 'Thành Phố Gạch Màu'. Nhân vật chính là chính con. Đây là sách thật của bé Việt và bé Hưng.</p>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          <div class="aspect-[4/3] overflow-hidden rounded-xl bg-slate-950 shadow-2xl ring-1 ring-slate-800">
            <img src="/msmw/viet-sample-1.jpg" alt="Sách của bé Việt — trang 1-8" loading="lazy" class="h-full w-full object-contain" />
          </div>
          <div class="aspect-[4/3] overflow-hidden rounded-xl bg-slate-950 shadow-2xl ring-1 ring-slate-800">
            <img src="/msmw/viet-sample-2.jpg" alt="Sách của bé Việt — trang 9-16" loading="lazy" class="h-full w-full object-contain" />
          </div>
          <div class="aspect-[4/3] overflow-hidden rounded-xl bg-slate-950 shadow-2xl ring-1 ring-slate-800">
            <img src="/msmw/hung-sample-1.jpg" alt="Sách của bé Hưng — trang 1-8" loading="lazy" class="h-full w-full object-contain" />
          </div>
          <div class="aspect-[4/3] overflow-hidden rounded-xl bg-slate-950 shadow-2xl ring-1 ring-slate-800">
            <img src="/msmw/hung-sample-2.jpg" alt="Sách của bé Hưng — trang 9-16" loading="lazy" class="h-full w-full object-contain" />
          </div>
        </div>
        <p class="mt-6 text-sm text-slate-500">* Khuôn mặt và chi tiết được giữ riêng tư cho phụ huynh đã đặt.</p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-center font-display text-3xl font-bold text-white md:text-4xl">Bên trong cuốn sách</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {features.map(([icon, title, description]) => (
          <div class="flex gap-4 rounded-lg border border-slate-800 bg-slate-900/60 p-5">
            <span class="text-3xl" aria-hidden="true">{icon}</span>
            <div>
              <h3 class="font-display text-xl font-bold text-white">{title}</h3>
              <p class="mt-2 leading-relaxed text-slate-300">{description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-slate-900 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <h2 class="text-center font-display text-3xl font-bold text-white md:text-4xl">Cách đặt sách — 4 bước</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-4">
          {steps.map(([title, description], index) => (
            <div class="rounded-lg border border-slate-800 bg-slate-950/70 p-5">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent font-display text-lg font-bold text-white">{index + 1}</div>
              <h3 class="mt-5 font-display text-xl font-bold text-white">{title}</h3>
              <p class="mt-3 leading-relaxed text-slate-300">{description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="pricing" class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="text-center font-display text-3xl font-bold text-white md:text-4xl">Chọn phiên bản phù hợp</h2>
      <div class="mx-auto mt-10 grid max-w-4xl gap-6 md:grid-cols-2">
        <article class="rounded-lg border border-slate-700 bg-slate-900/60 p-6">
          <span class="inline-flex rounded-full bg-slate-800 px-3 py-1 text-xs font-semibold text-slate-300">Tự in tại nhà</span>
          <h3 class="mt-5 font-display text-2xl font-bold text-white">Bản số (PDF)</h3>
          <p class="mt-4 font-display text-5xl font-extrabold text-white">69.000₫</p>
          <ul class="mt-6 space-y-3 text-slate-300">
            <li class="flex gap-3"><span class="text-green-400">✓</span>File PDF chất lượng cao</li>
            <li class="flex gap-3"><span class="text-green-400">✓</span>Nhận trong 24h</li>
            <li class="flex gap-3"><span class="text-green-400">✓</span>In bao nhiêu bản tuỳ ý</li>
            <li class="flex gap-3"><span class="text-green-400">✓</span>Có thể in cửa hàng / in màu nhà</li>
          </ul>
          <a href="#form" data-version="digital" class="mt-8 inline-flex w-full justify-center rounded-lg border border-slate-700 px-6 py-3 font-semibold text-white transition hover:border-accent hover:text-accent">Đặt bản số</a>
        </article>

        <article class="relative rounded-lg border border-accent bg-slate-900/60 p-6">
          <span class="absolute right-5 top-5 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-white">Được chọn nhiều nhất</span>
          <h3 class="mt-10 font-display text-2xl font-bold text-white sm:mt-0">Bản in giao tận nơi</h3>
          <p class="mt-4 font-display text-5xl font-extrabold text-white">129.000₫</p>
          <ul class="mt-6 space-y-3 text-slate-300">
            <li class="flex gap-3"><span class="text-green-400">✓</span>Sách in bìa cứng / chất liệu cao cấp</li>
            <li class="flex gap-3"><span class="text-green-400">✓</span>Giao tận nhà toàn quốc</li>
            <li class="flex gap-3"><span class="text-green-400">✓</span>Nhận trong 5 ngày</li>
            <li class="flex gap-3"><span class="text-green-400">✓</span>Đóng gói cẩn thận, sẵn làm quà</li>
          </ul>
          <a href="#form" data-version="hardcopy" class="mt-8 inline-flex w-full justify-center rounded-lg bg-accent px-6 py-3 font-semibold text-white transition hover:bg-accent-hover">Đặt bản in</a>
        </article>
      </div>
    </section>

    <section id="form" class="mx-auto max-w-6xl px-6 py-20">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold text-white md:text-4xl">Đặt sách cho con</h2>
        <p class="mt-4 text-slate-300">Felix sẽ liên hệ qua Zalo trong 24h</p>
      </div>
      <form id="msmw-form" class="mx-auto mt-10 max-w-xl space-y-5">
        <div>
          <label for="parent_name" class="mb-2 block text-sm text-slate-300">Tên phụ huynh <span class="text-red-400">*</span></label>
          <input id="parent_name" name="parent_name" required maxlength="100" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 text-base text-white focus:border-accent" />
        </div>
        <div>
          <label for="child_name" class="mb-2 block text-sm text-slate-300">Tên con (sẽ in trong sách) <span class="text-red-400">*</span></label>
          <input id="child_name" name="child_name" required maxlength="50" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 text-base text-white focus:border-accent" />
        </div>
        <div>
          <label for="child_age" class="mb-2 block text-sm text-slate-300">Tuổi con <span class="text-red-400">*</span></label>
          <input id="child_age" type="number" name="child_age" min="2" max="15" required class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 text-base text-white focus:border-accent" />
        </div>
        <div>
          <label for="child_gender" class="mb-2 block text-sm text-slate-300">Giới tính con <span class="text-red-400">*</span></label>
          <select id="child_gender" name="child_gender" required class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 text-base text-white focus:border-accent">
            <option value="" disabled selected>-- Chọn giới tính --</option>
            <option value="boy">Bé trai</option>
            <option value="girl">Bé gái</option>
          </select>
        </div>
        <fieldset>
          <legend class="mb-2 block text-sm text-slate-300">Phiên bản <span class="text-red-400">*</span></legend>
          <div class="space-y-3 rounded-lg border border-slate-700 bg-slate-900 p-4">
            <label class="flex items-center gap-3 text-base text-slate-200">
              <input type="radio" name="version" value="digital" required class="h-4 w-4 accent-indigo-500" />
              <span>Bản số (PDF) — 69.000₫</span>
            </label>
            <label class="flex items-center gap-3 text-base text-slate-200">
              <input type="radio" name="version" value="hardcopy" required checked class="h-4 w-4 accent-indigo-500" />
              <span>Bản in (giao tận nơi) — 129.000₫</span>
            </label>
          </div>
        </fieldset>
        <div>
          <label for="zalo_phone" class="mb-2 block text-sm text-slate-300">Số Zalo <span class="text-red-400">*</span></label>
          <input id="zalo_phone" type="tel" name="zalo_phone" required pattern="^[+0-9\s\-()]{8,20}$" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 text-base text-white focus:border-accent" />
        </div>
        <div>
          <label for="note" class="mb-2 block text-sm text-slate-300">Lời nhắn thêm</label>
          <textarea id="note" name="note" maxlength="500" rows="3" placeholder="Sinh nhật con, dịp đặc biệt, yêu cầu khác..." class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 text-base text-white focus:border-accent"></textarea>
        </div>
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" tabindex="-1" />
        </div>
        <button type="submit" class="w-full rounded-lg bg-accent px-6 py-3 text-lg font-semibold text-white transition hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-70">Gửi yêu cầu — Felix sẽ liên hệ qua Zalo</button>
        <p class="mt-3 text-center text-xs text-slate-500">Felix chỉ dùng thông tin để liên hệ và làm sách. Không chia sẻ với bên thứ ba.</p>
      </form>
      <div id="form-status" class="mx-auto mt-8 hidden max-w-xl rounded-lg border border-slate-800 bg-slate-900 p-5 text-center font-semibold"></div>
    </section>

    <section class="bg-slate-900 px-6 py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center font-display text-3xl font-bold text-white md:text-4xl">Câu hỏi thường gặp</h2>
        <div class="mt-10 space-y-3">
          {faqItems.map(([question, answer]) => (
            <details class="rounded-lg border border-slate-800 bg-slate-950/70 p-5">
              <summary class="cursor-pointer font-display text-lg font-bold text-white">{question}</summary>
              <p class="mt-4 leading-relaxed text-slate-300">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20 text-center">
      <h2 class="font-display text-3xl font-bold text-white md:text-4xl">Tặng con một câu chuyện riêng</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">Mỗi bé chỉ có một tuổi thơ. Hãy để con có sách của riêng mình.</p>
      <a href="#form" class="mt-8 inline-flex rounded-lg bg-accent px-6 py-3 font-semibold text-white transition hover:bg-accent-hover">Đặt sách ngay →</a>
    </section>
  </main>

  <footer class="mt-auto border-t border-slate-800 py-8 text-center text-sm text-slate-500">
    © 2026 Tong Phuong - built in vietnam
  </footer>

  <script>
    const form = document.getElementById('msmw-form');
    const btn = form.querySelector('button[type="submit"]');
    const statusEl = document.getElementById('form-status');

    document.querySelectorAll('[data-version]').forEach((link) => {
      link.addEventListener('click', () => {
        const radio = form.querySelector(`input[name="version"][value="${link.dataset.version}"]`);
        if (radio) radio.checked = true;
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form));

      if (data.website) {
        showSuccess();
        return;
      }

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Đang gửi...';

      try {
        const res = await fetch('/api/msmw-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          showSuccess();
        } else {
          showError();
          btn.disabled = false;
          btn.textContent = originalText;
        }
      } catch (err) {
        showError();
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });

    function showSuccess() {
      form.style.display = 'none';
      statusEl.className = 'mx-auto mt-8 max-w-xl rounded-lg border border-green-500/30 bg-green-500/10 p-5 text-center font-semibold text-green-400';
      statusEl.innerHTML = '✅ Gửi thành công! Felix sẽ nhắn Zalo cho bạn trong 24h.';
      statusEl.scrollIntoView({ behavior: 'smooth' });
    }

    function showError() {
      statusEl.className = 'mx-auto mt-8 max-w-xl rounded-lg border border-red-500/30 bg-red-500/10 p-5 text-center font-semibold text-red-400';
      statusEl.innerHTML = '⚠️ Có lỗi xảy ra. Vui lòng thử lại hoặc nhắn trực tiếp <a href="https://zalo.me/0396868675" class="underline">Zalo +84 396868675</a>';
    }
  </script>
</BaseLayout>
