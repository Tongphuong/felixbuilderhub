---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import ProgressBar from '../../components/ui/ProgressBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { ZALO_URL } from '../../config/contact';

const STAGE_LABELS = [
  'Đang chọn truyện phù hợp với con…',
  'Đang chuẩn bị phần nghe…',
  'Đang ghi âm các cụm câu…',
  'Đang chuẩn bị nhiệm vụ web…',
];
const INITIAL_PROGRESS = ((0 + 1) / 4) * 100;
---

<BaseLayout
  title="Tạo bài học — Read2Lead | Felix Coaching"
  description="Tạo bài đọc và nghe phù hợp cho con."
  robots="noindex, nofollow"
>
  <Header />

  <main id="main" class="mx-auto max-w-3xl px-6 py-12" data-phase="resolving">
    {/* ========================== RESOLVING ========================== */}
    <section class="phase-resolving flex min-h-[40vh] flex-col items-center justify-center text-center">
      <div class="r2l-spinner" aria-label="Đang tải"></div>
      <p class="mt-6 text-lg font-semibold text-cream">Đang mở bài của con…</p>
    </section>

    {/* ============================= ERROR ============================= */}
    <section class="phase-error flex min-h-[40vh] flex-col items-center justify-center">
      <Card variant="raised" class="max-w-md text-center">
        <p class="text-4xl">😕</p>
        <h2 class="font-display mt-4 text-xl font-bold text-cream">Không mở được link</h2>
        <p id="error-message" class="mt-3 leading-relaxed text-cream-muted" role="alert">
          Link không hợp lệ hoặc đã hết hạn.
        </p>
        <div class="mt-6">
          <Button variant="secondary" href={ZALO_URL}>Nhắn Zalo Felix</Button>
        </div>
      </Card>
    </section>

    {/* ============================= READY ============================= */}
    <section class="phase-ready">
      <div class="text-center">
        <p class="fx-eyebrow text-accent">HỌC SINH READ2LEAD</p>
        <h1 class="mt-3 font-display text-2xl font-extrabold text-cream sm:text-3xl">
          Chào con <span id="greeting-name" data-clarity-mask="true">bạn nhỏ</span>! 👋
        </h1>
        <p class="mt-2 text-cream-muted">
          Cấp <span id="greeting-level" class="font-semibold text-accent">L1</span>
        </p>
      </div>

      {/* Honeypot */}
      <div class="r2l-honeypot" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="r2l-hub-big-grid">
        <button type="button" id="generate-btn" class="r2l-hub-big r2l-hub-big--primary">
          <span class="r2l-hub-big__icon" aria-hidden="true">📖</span>
          <span class="r2l-hub-big__text">
            <span class="r2l-hub-big__title">Tạo bài đọc</span>
            <span class="r2l-hub-big__sub">Nhận một cuốn truyện mới và bắt đầu đọc ngay</span>
          </span>
          <span class="r2l-hub-big__chev" aria-hidden="true">›</span>
        </button>

        <a id="speak-link" href="/speak-up" class="r2l-hub-big r2l-hub-big--secondary">
          <span class="r2l-hub-big__icon" aria-hidden="true">🗣️</span>
          <span class="r2l-hub-big__text">
            <span class="r2l-hub-big__title">SpeakUp</span>
            <span class="r2l-hub-big__sub">Luyện nói tiếng Anh cùng Minny</span>
          </span>
          <span class="r2l-hub-big__chev" aria-hidden="true">›</span>
        </a>
      </div>

      <div class="r2l-hub-small-grid">
        <a id="hoso-link" href="/ho-so" class="r2l-hub-small">
          <span class="r2l-hub-small__icon" aria-hidden="true">👤</span>
          <span class="r2l-hub-small__text">
            <span class="r2l-hub-small__title">Hồ sơ – Báo cáo tiến độ</span>
            <span class="r2l-hub-small__sub">Xem con đã học được gì và giỏi lên thế nào</span>
          </span>
        </a>
        <a href="/read2lead/leaderboard" class="r2l-hub-small">
          <span class="r2l-hub-small__icon" aria-hidden="true">🏆</span>
          <span class="r2l-hub-small__text">
            <span class="r2l-hub-small__title">Bảng xếp hạng</span>
            <span class="r2l-hub-small__sub">Xem thứ hạng của con so với các bạn</span>
          </span>
        </a>
        <a id="shop-link" href="/read2lead/shop" class="r2l-hub-small">
          <span class="r2l-hub-small__icon" aria-hidden="true">🛒</span>
          <span class="r2l-hub-small__text">
            <span class="r2l-hub-small__title">Cửa hàng</span>
            <span class="r2l-hub-small__sub">Dùng xu con kiếm được để mua đồ cho thú cưng</span>
          </span>
        </a>
      </div>
    </section>

    {/* ========================== GENERATING ========================== */}
    <section class="phase-generating">
      <SectionHeading align="center" title="Minny đang chuẩn bị bài cho con…" />
      <Card variant="raised" class="mt-8 text-center">
        <div id="gen-progress">
          <ProgressBar value={INITIAL_PROGRESS} gradient aria-label="Tiến độ tạo bài học" />
        </div>
        <p id="stage-label" class="r2l-stage-label" aria-live="polite">{STAGE_LABELS[0]}</p>
        <p id="gen-note" class="r2l-gen-note">Lần đầu có thể chậm hơn một chút vì máy chủ cần khởi động.</p>
      </Card>
    </section>

    {/* ============================ RESULT ============================ */}
    <section class="phase-result">
      <Card variant="accent" class="mt-8 text-center">
        <h2 class="font-display r2l-result-title">Bài học của <span id="result-name" data-clarity-mask="true"></span> đã sẵn sàng! ✨</h2>
        <p class="r2l-result-text" id="result-topic-wrap" hidden>Chủ đề: <strong class="text-accent" id="result-topic"></strong></p>
        <p class="r2l-result-text" id="result-story" hidden>Tên truyện: <strong class="text-accent" id="result-story-title"></strong></p>
        <div class="r2l-result-actions">
          <Button variant="primary" size="lg" href="#" id="open-lesson">Mở bài học →</Button>
          <Button variant="secondary" id="reset">Tạo bài khác</Button>
        </div>
      </Card>
    </section>

    {/* =========================== GEN-ERROR =========================== */}
    <section class="phase-gen-error">
      <Card variant="raised" class="mt-8 text-center">
        <h2 class="font-display r2l-result-title">Chưa tạo được bài học</h2>
        <p class="r2l-result-text" id="gen-error-message" aria-live="polite" role="alert"></p>
        <div class="r2l-result-actions">
          <Button variant="primary" size="lg" id="retry">Thử lại</Button>
        </div>
        <p class="r2l-gen-note">Nếu vẫn lỗi, anh chị nhắn Zalo Felix để được hỗ trợ.</p>
      </Card>
    </section>
  </main>

  <Footer />

  <script>
    import '../../scripts/r2l-start.client.ts';
  </script>
</BaseLayout>

<style>
  /* Spinner — matches ho-so pattern. */
  .r2l-spinner {
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid color-mix(in srgb, var(--cream) 20%, transparent);
    border-top-color: var(--accent);
    border-radius: var(--radius-full);
    animation: r2l-spin 0.7s linear infinite;
  }
  @keyframes r2l-spin {
    to { transform: rotate(360deg); }
  }

  /* Honeypot */
  .r2l-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Generating stage caption. */
  .r2l-stage-label {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--cream);
  }
  .r2l-gen-note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--cream-dim);
  }

  /* Result card. */
  .r2l-result-title {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    color: var(--cream);
  }
  .r2l-result-text {
    margin-top: var(--space-4);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
  }
  .r2l-result-actions {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  /* ---- Home hub (ready phase) ---- */
  .r2l-hub-big-grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .r2l-hub-big {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    padding: 1.35rem var(--space-5);
    border-radius: var(--radius-xl);
    border: 1px solid transparent;
    font-family: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-standard);
  }
  .r2l-hub-big:active { transform: translateY(1px); }
  .r2l-hub-big__icon {
    flex: 0 0 auto;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.9rem;
  }
  .r2l-hub-big__text { display: block; }
  .r2l-hub-big__title {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--weight-extrabold);
    font-size: var(--text-lg);
    line-height: 1.2;
  }
  .r2l-hub-big__sub {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    line-height: 1.35;
  }
  .r2l-hub-big__chev {
    margin-left: auto;
    font-size: 1.3rem;
    opacity: 0.55;
    flex: 0 0 auto;
  }
  .r2l-hub-big--primary {
    background: var(--gold);
    color: var(--navy-950);
    box-shadow: 0 6px 20px -8px color-mix(in srgb, var(--gold) 55%, transparent);
  }
  .r2l-hub-big--primary .r2l-hub-big__icon { background: color-mix(in srgb, var(--navy-950) 14%, transparent); }
  .r2l-hub-big--primary .r2l-hub-big__title { color: var(--navy-950); }
  .r2l-hub-big--primary .r2l-hub-big__sub { color: color-mix(in srgb, var(--navy-950) 78%, transparent); }
  .r2l-hub-big--secondary {
    background: var(--navy-850);
    border-color: var(--accent-border);
    color: var(--cream);
  }
  .r2l-hub-big--secondary .r2l-hub-big__icon { background: var(--accent-soft); }
  .r2l-hub-big--secondary .r2l-hub-big__title { color: var(--cream); }
  .r2l-hub-big--secondary .r2l-hub-big__sub { color: var(--cream-muted); }

  .r2l-hub-small-grid {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .r2l-hub-small {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--navy-900) 70%, transparent);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-standard);
  }
  .r2l-hub-small:hover { border-color: var(--accent-border); }
  .r2l-hub-small__icon {
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--cream) 8%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }
  .r2l-hub-small__text { display: block; }
  .r2l-hub-small__title {
    display: block;
    font-weight: var(--weight-bold);
    color: var(--cream);
    font-size: 0.92rem;
    line-height: 1.2;
  }
  .r2l-hub-small__sub {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--cream-dim);
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .r2l-hub-big-grid { grid-template-columns: 1fr 1fr; gap: var(--space-5); }
    .r2l-hub-big {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.75rem var(--space-6);
      min-height: 12rem;
    }
    .r2l-hub-big__icon { width: 4rem; height: 4rem; font-size: 2.2rem; }
    .r2l-hub-big__title { font-size: 1.45rem; margin-top: var(--space-4); }
    .r2l-hub-big__sub { font-size: var(--text-sm); }
    .r2l-hub-big__chev { display: none; }
    .r2l-hub-small-grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
    .r2l-hub-small { flex-direction: column; align-items: flex-start; padding: var(--space-5); }
    .r2l-hub-small__icon { margin-bottom: var(--space-2); }
  }

  /* All phases live in the DOM at once; CSS reveals one per data-phase. */
  .phase-resolving,
  .phase-error,
  .phase-ready,
  .phase-generating,
  .phase-result,
  .phase-gen-error {
    display: none;
  }
  [data-phase='resolving'] .phase-resolving { display: flex; }
  [data-phase='error'] .phase-error { display: flex; }
  [data-phase='ready'] .phase-ready { display: block; }
  [data-phase='generating'] .phase-generating { display: block; }
  [data-phase='result'] .phase-result { display: block; }
  [data-phase='gen-error'] .phase-gen-error { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .r2l-spinner { animation: none; }
    .phase-generating .fx-progress__fill,
    .phase-generating .fx-progress__fill--gradient {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
