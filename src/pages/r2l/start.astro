---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import TopicTile from '../../components/ui/TopicTile.astro';
import Input from '../../components/ui/Input.astro';
import ProgressBar from '../../components/ui/ProgressBar.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { ZALO_URL } from '../../config/contact';

const TOPICS = [
  { value: 'animals_pets', label: 'Động vật & thú cưng', emoji: '🐾' },
  { value: 'family_friends', label: 'Gia đình & bạn bè', emoji: '👨‍👩‍👧' },
  { value: 'school', label: 'Trường học', emoji: '🏫' },
  { value: 'sports', label: 'Thể thao', emoji: '⚽' },
  { value: 'games_toys', label: 'Trò chơi & đồ chơi', emoji: '🎮' },
  { value: 'vehicles', label: 'Xe cộ & di chuyển', emoji: '🚗' },
  { value: 'food_cooking', label: 'Đồ ăn & nấu ăn', emoji: '🍳' },
  { value: 'nature', label: 'Thiên nhiên', emoji: '🌳' },
  { value: 'art_creativity', label: 'Vẽ tranh & sáng tạo', emoji: '🎨' },
  { value: 'heroes_jobs', label: 'Nghề nghiệp & ước mơ', emoji: '🦸' },
  { value: 'imagination', label: 'Tưởng tượng & phép màu', emoji: '✨' },
  { value: 'vietnamese_holidays', label: 'Lễ hội Việt Nam', emoji: '🏮' },
];

const STAGE_LABELS = [
  'Đang chọn truyện phù hợp với con…',
  'Đang chuẩn bị phần nghe…',
  'Đang ghi âm các cụm câu…',
  'Đang chuẩn bị nhiệm vụ web…',
];
const INITIAL_PROGRESS = ((0 + 1) / 4) * 100;
---

<BaseLayout
  title="Tạo bài học — Read2Lead | Felix Coaching"
  description="Tạo bài đọc và nghe phù hợp cho con."
  robots="noindex, nofollow"
>
  <Header />

  <main id="main" class="mx-auto max-w-3xl px-6 py-12" data-phase="resolving">
    {/* ========================== RESOLVING ========================== */}
    <section class="phase-resolving flex min-h-[40vh] flex-col items-center justify-center text-center">
      <div class="r2l-spinner" aria-label="Đang tải"></div>
      <p class="mt-6 text-lg font-semibold text-cream">Đang mở bài của con…</p>
    </section>

    {/* ============================= ERROR ============================= */}
    <section class="phase-error flex min-h-[40vh] flex-col items-center justify-center">
      <Card variant="raised" class="max-w-md text-center">
        <p class="text-4xl">😕</p>
        <h2 class="font-display mt-4 text-xl font-bold text-cream">Không mở được link</h2>
        <p id="error-message" class="mt-3 leading-relaxed text-cream-muted" role="alert">
          Link không hợp lệ hoặc đã hết hạn.
        </p>
        <div class="mt-6">
          <Button variant="secondary" href={ZALO_URL}>Nhắn Zalo Felix</Button>
        </div>
      </Card>
    </section>

    {/* ============================= READY ============================= */}
    <section class="phase-ready">
      <div class="text-center">
        <p class="fx-eyebrow text-accent">HỌC SINH READ2LEAD</p>
        <h1 class="mt-3 font-display text-2xl font-extrabold text-cream sm:text-3xl">
          Chào con <span id="greeting-name" data-clarity-mask="true">bạn nhỏ</span>! 👋
        </h1>
        <p class="mt-2 text-cream-muted">
          Cấp <span id="greeting-level" class="font-semibold text-accent">L1</span>
        </p>
      </div>

      <Card variant="accent" class="mt-8">
        <h2 class="font-display text-lg font-bold text-cream">Chọn chủ đề bài học</h2>
        <div class="mt-4 grid grid-cols-3 gap-3">
          {TOPICS.map((topic, i) => (
            <TopicTile emoji={topic.emoji} label={topic.label} selected={i === 0} data-topic={topic.value} />
          ))}
        </div>

        <div class="mt-6">
          <Input
            label="Sở thích của con (không bắt buộc)"
            name="interests"
            placeholder="VD: bóng đá, Roblox, mèo, vẽ tranh…"
            maxlength={120}
            autocomplete="off"
            hint="Nếu điền, câu chuyện sẽ cố gắng đi theo điều con thích."
          />
        </div>

        {/* Honeypot */}
        <div class="r2l-honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="mt-6">
          <Button variant="primary" size="lg" block id="generate-btn">Tạo bài học cho con</Button>
        </div>
      </Card>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <a
          id="hoso-link"
          href="/ho-so"
          class="flex items-center gap-4 rounded-xl border border-cream-dim/20 bg-navy-900/70 p-5 transition hover:border-accent/40"
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-cream/10 text-2xl">👤</span>
          <div>
            <p class="font-semibold text-cream">Hồ sơ & tiến độ</p>
            <p class="mt-1 text-xs text-cream-muted">Cấp độ, điểm, bài đang mở</p>
          </div>
        </a>
        <a
          href="/read2lead/leaderboard"
          class="flex items-center gap-4 rounded-xl border border-cream-dim/20 bg-navy-900/70 p-5 transition hover:border-accent/40"
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-cream/10 text-2xl">🏆</span>
          <div>
            <p class="font-semibold text-cream">Bảng xếp hạng</p>
            <p class="mt-1 text-xs text-cream-muted">Xem thành tích các bạn nhỏ</p>
          </div>
        </a>
      </div>
    </section>

    {/* ========================== GENERATING ========================== */}
    <section class="phase-generating">
      <SectionHeading align="center" title="Minny đang chuẩn bị bài cho con…" />
      <Card variant="raised" class="mt-8 text-center">
        <div id="gen-progress">
          <ProgressBar value={INITIAL_PROGRESS} gradient aria-label="Tiến độ tạo bài học" />
        </div>
        <p id="stage-label" class="r2l-stage-label" aria-live="polite">{STAGE_LABELS[0]}</p>
        <p id="gen-note" class="r2l-gen-note">Lần đầu có thể chậm hơn một chút vì máy chủ cần khởi động.</p>
      </Card>
    </section>

    {/* ============================ RESULT ============================ */}
    <section class="phase-result">
      <Card variant="accent" class="mt-8 text-center">
        <h2 class="font-display r2l-result-title">Bài học của <span id="result-name" data-clarity-mask="true"></span> đã sẵn sàng! ✨</h2>
        <p class="r2l-result-text">Chủ đề: <strong class="text-accent" id="result-topic"></strong></p>
        <p class="r2l-result-text" id="result-story" hidden>Tên truyện: <strong class="text-accent" id="result-story-title"></strong></p>
        <div class="r2l-result-actions">
          <Button variant="primary" size="lg" href="#" id="open-lesson">Mở bài học →</Button>
          <Button variant="secondary" id="reset">Tạo bài khác</Button>
        </div>
      </Card>
    </section>

    {/* =========================== GEN-ERROR =========================== */}
    <section class="phase-gen-error">
      <Card variant="raised" class="mt-8 text-center">
        <h2 class="font-display r2l-result-title">Chưa tạo được bài học</h2>
        <p class="r2l-result-text" id="gen-error-message" aria-live="polite" role="alert"></p>
        <div class="r2l-result-actions">
          <Button variant="primary" size="lg" id="retry">Thử lại</Button>
        </div>
        <p class="r2l-gen-note">Nếu vẫn lỗi, anh chị nhắn Zalo Felix để được hỗ trợ.</p>
      </Card>
    </section>
  </main>

  <Footer />

  <script>
    import '../../scripts/r2l-start.client.ts';
  </script>
</BaseLayout>

<style>
  /* Spinner — matches ho-so pattern. */
  .r2l-spinner {
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid color-mix(in srgb, var(--cream) 20%, transparent);
    border-top-color: var(--accent);
    border-radius: var(--radius-full);
    animation: r2l-spin 0.7s linear infinite;
  }
  @keyframes r2l-spin {
    to { transform: rotate(360deg); }
  }

  /* Honeypot */
  .r2l-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Generating stage caption. */
  .r2l-stage-label {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--cream);
  }
  .r2l-gen-note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--cream-dim);
  }

  /* Result card. */
  .r2l-result-title {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    color: var(--cream);
  }
  .r2l-result-text {
    margin-top: var(--space-4);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
  }
  .r2l-result-actions {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  /* All phases live in the DOM at once; CSS reveals one per data-phase. */
  .phase-resolving,
  .phase-error,
  .phase-ready,
  .phase-generating,
  .phase-result,
  .phase-gen-error {
    display: none;
  }
  [data-phase='resolving'] .phase-resolving { display: flex; }
  [data-phase='error'] .phase-error { display: flex; }
  [data-phase='ready'] .phase-ready { display: block; }
  [data-phase='generating'] .phase-generating { display: block; }
  [data-phase='result'] .phase-result { display: block; }
  [data-phase='gen-error'] .phase-gen-error { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .r2l-spinner { animation: none; }
    .phase-generating .fx-progress__fill,
    .phase-generating .fx-progress__fill--gradient {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
