---
import BaseLayout from '../layouts/BaseLayout.astro';

const previewCards = [
  ['📚', 'Tài liệu miễn phí', 'Pack đọc, file in, template prompts cho phụ huynh và giáo viên.'],
  ['💡', 'Kinh nghiệm dạy', 'Phương pháp chunk-based, bài học từ những học sinh thực tế của tôi.'],
  ['🎓', 'Tài nguyên', 'Hướng dẫn chọn sách, lập lịch học, tips luyện tiếng Anh tại nhà.'],
];
---

<BaseLayout
  title="Felix Sharing Space — Tài liệu miễn phí cho phụ huynh | Felix Builder Hub"
  description="Nơi Felix chia sẻ tài liệu, kinh nghiệm dạy con và tài nguyên giáo dục miễn phí cho phụ huynh Việt."
>
  <header class="sticky top-0 z-50 border-b border-cream-dim/20 bg-navy-950/85 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center" aria-label="Felix Builder Hub">
        <img src="/logo/felixbuilderhub_website_header_logo.png" alt="Felix Builder Hub" class="h-9 w-auto md:h-10" />
      </a>
      <nav class="hidden items-center gap-6 text-sm font-medium text-cream-muted sm:flex">
        <a href="/#products" class="transition hover:text-accent">Sản phẩm</a>
        <a href="/#contact" class="transition hover:text-accent">Liên hệ</a>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <section class="mx-auto max-w-6xl px-6 py-20 text-center md:py-28">
      <span class="inline-block rounded-full bg-accent/20 px-4 py-1 text-sm font-semibold text-accent">Đang chuẩn bị</span>
      <h1 class="mx-auto mt-6 max-w-4xl font-display text-4xl font-extrabold leading-snug text-cream md:text-6xl">Felix Sharing Space</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-muted md:text-xl">
        Nơi tôi chia sẻ kiến thức, kinh nghiệm và các tài liệu miễn phí cho phụ huynh.
      </p>
      <a href="#subscribe" class="mt-10 inline-flex rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">
        Để lại Zalo để biết khi có nội dung mới
      </a>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <h2 class="text-center font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Sắp tới trong Sharing Space</h2>
        <div class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-3">
          {previewCards.map(([icon, title, description]) => (
            <article class="rounded-lg border border-cream-dim/20 bg-navy-950/75 p-6">
              <div class="text-4xl" aria-hidden="true">{icon}</div>
              <h3 class="mt-5 font-display text-xl font-bold leading-snug text-cream">{title}</h3>
              <p class="mt-3 leading-relaxed text-cream-muted">{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="subscribe" class="mx-auto max-w-6xl px-6 py-20">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Nhận thông báo khi có nội dung mới</h2>
        <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-cream-dim">Tôi gửi tài liệu mới qua Zalo. Không spam, hủy bất cứ lúc nào.</p>
      </div>

      <form id="space-form" class="mx-auto mt-10 max-w-md space-y-5">
        <div>
          <label for="name" class="mb-2 block text-sm text-cream-muted">Tên</label>
          <input
            id="name"
            name="name"
            maxlength="50"
            placeholder="VD: Cô Mai"
            class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream placeholder:text-cream-dim/80 focus:border-accent focus:outline-none"
          />
        </div>

        <div>
          <label for="contact" class="mb-2 block text-sm text-cream-muted">Zalo hoặc Email <span class="text-red-400">*</span></label>
          <input
            id="contact"
            name="contact"
            required
            maxlength="100"
            placeholder="Số Zalo hoặc email"
            class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream placeholder:text-cream-dim/80 focus:border-accent focus:outline-none"
          />
        </div>

        <div>
          <label for="interest" class="mb-2 block text-sm text-cream-muted">Quan tâm gì nhất?</label>
          <textarea
            id="interest"
            name="interest"
            maxlength="200"
            rows="2"
            placeholder="VD: bài tập tiếng Anh, prompts ChatGPT, kinh nghiệm dạy con..."
            class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream placeholder:text-cream-dim/80 focus:border-accent focus:outline-none"
          ></textarea>
        </div>

        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" tabindex="-1" />
        </div>

        <button type="submit" class="w-full rounded-lg bg-accent px-6 py-3 text-lg font-semibold text-navy-950 transition hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-70">
          Để lại liên hệ
        </button>
        <p class="text-center text-xs text-cream-dim/80">Felix chỉ dùng thông tin để gửi tài liệu, không chia sẻ với ai khác.</p>
      </form>

      <div id="space-form-status" class="mt-6 hidden text-center font-semibold"></div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20 text-center">
      <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Hãy cùng học và dạy con tốt hơn</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-cream-muted">Felix đang tổng hợp tài liệu. Để lại Zalo, anh sẽ là người đầu tiên biết.</p>
      <a href="#subscribe" class="mt-8 inline-flex rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">
        Để lại liên hệ
      </a>
    </section>
  </main>

  <footer class="mt-auto border-t border-cream-dim/20 py-8 text-center text-sm text-cream-dim/80">
    © 2026 Tong Phuong - built in vietnam
  </footer>

  <script>
    const form = document.getElementById('space-form');
    const btn = form.querySelector('button[type="submit"]');
    const statusEl = document.getElementById('space-form-status');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));

      if (data.website) {
        showSuccess();
        return;
      }

      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Đang gửi...';

      try {
        const res = await fetch('/api/sharing-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          showSuccess();
        } else {
          const result = await res.json().catch(() => ({}));
          showError(result.message || 'Có lỗi xảy ra, vui lòng thử lại.');
          btn.disabled = false;
          btn.textContent = original;
        }
      } catch {
        showError('Mạng không ổn định.');
        btn.disabled = false;
        btn.textContent = original;
      }
    });

    function showSuccess() {
      form.style.display = 'none';
      statusEl.classList.remove('hidden', 'text-red-400');
      statusEl.classList.add('text-green-400');
      statusEl.innerHTML = '✅ Cảm ơn anh chị. Felix sẽ liên hệ khi có tài liệu mới.';
      statusEl.scrollIntoView({ behavior: 'smooth' });
    }

    function showError(msg) {
      statusEl.classList.remove('hidden', 'text-green-400');
      statusEl.classList.add('text-red-400');
      statusEl.innerHTML = `⚠️ ${msg} <a href="https://zalo.me/0396868675" class="underline">Nhắn Zalo Felix</a>`;
    }
  </script>
</BaseLayout>
