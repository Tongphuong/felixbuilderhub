---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Tiến độ học sinh — Felix Coaching"
  description="Phụ huynh nhập mã học sinh Felix cấp qua Zalo để xem tiến độ đọc, bài đang học và việc cần làm trong tuần."
  robots="noindex, follow"
>
  <Header read2LeadState={false} />

  <main id="main" class="parent-page flex-1 bg-[#f4f6f9]">
    <section class="mx-auto max-w-2xl px-4 py-8 sm:px-6 sm:py-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-[#5a6a8c]">Felix Coaching</p>
      <h1 class="mt-2 text-2xl font-bold text-[#1e2a4a] sm:text-3xl">Tiến độ học sinh</h1>
      <p class="mt-2 text-sm leading-relaxed text-[#5a6a8c]">
        Nhập mã Felix gửi qua Zalo để xem bài con đang học, tiến bộ tuần và việc nên nhắc con trong tuần này.
      </p>

      <div id="parent-entry" class="parent-card mt-6">
        <label for="parent-code" class="text-sm font-semibold text-[#1e2a4a]">Mã học sinh</label>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row">
          <input
            id="parent-code"
            name="access_code"
            required
            maxlength="40"
            autocomplete="off"
            autocapitalize="characters"
            autocorrect="off"
            spellcheck="false"
            placeholder="VD: R2L-LINH-8F3KQ2"
            data-clarity-mask="true"
            class="parent-input"
          />
          <button id="parent-load" type="button" class="parent-btn parent-btn--primary shrink-0">Xem tiến độ</button>
        </div>
      </div>

      <div id="parent-session" class="parent-card mt-4 hidden items-center justify-between gap-3">
        <p class="min-w-0 truncate text-sm text-[#1e2a4a]">
          <span class="text-[#5a6a8c]">Mã:</span>
          <span id="parent-code-display" class="ml-1 font-semibold" data-clarity-mask="true"></span>
        </p>
        <button id="parent-change-code" type="button" class="parent-btn shrink-0">Đổi mã</button>
      </div>

      <section id="parent-error" class="parent-error mt-4 hidden"></section>
      <div id="parent-dashboard" class="mt-6 hidden space-y-4"></div>
    </section>
  </main>

  <Footer />

  <style is:global>
    .parent-page {
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    }

    .parent-card {
      border-radius: 12px;
      border: 1px solid #d8dee8;
      background: #fff;
      padding: 1.25rem;
      box-shadow: 0 1px 3px rgb(30 42 74 / 0.06);
    }

    #parent-session:not(.hidden) {
      display: flex;
    }

    .parent-input {
      min-height: 48px;
      width: 100%;
      border: 1px solid #c5ced9;
      border-radius: 8px;
      background: #fff;
      padding: 0 1rem;
      font-size: 1rem;
      text-transform: uppercase;
      color: #1e2a4a;
    }

    .parent-input:focus {
      border-color: #5b8def;
      outline: 2px solid rgb(91 141 239 / 0.2);
    }

    .parent-btn {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      border: 1px solid #c5ced9;
      background: #fff;
      padding: 0 1.25rem;
      font-size: 0.9375rem;
      font-weight: 600;
      color: #1e2a4a;
      text-decoration: none;
    }

    .parent-btn--primary {
      border-color: #3d6fd4;
      background: #3d6fd4;
      color: #fff;
    }

    .parent-error {
      border-radius: 8px;
      border: 1px solid #f5c2c2;
      background: #fef2f2;
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
      color: #9b1c1c;
    }

    .parent-section {
      border-radius: 12px;
      border: 1px solid #d8dee8;
      background: #fff;
      padding: 1.25rem;
    }

    .parent-section--highlight {
      border-color: #b8ccf5;
      background: #f0f5ff;
    }

    .parent-section__title {
      margin: 0 0 0.75rem;
      font-size: 1rem;
      font-weight: 700;
      color: #1e2a4a;
    }

    .parent-muted {
      color: #5a6a8c;
    }

    .parent-stat-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .parent-stat {
      border-radius: 8px;
      background: #f4f6f9;
      padding: 0.75rem 0.5rem;
      text-align: center;
    }

    .parent-stat__value {
      font-size: 1.35rem;
      font-weight: 700;
      color: #1e2a4a;
      line-height: 1.1;
    }

    .parent-stat__label {
      margin-top: 0.25rem;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #5a6a8c;
    }

    .parent-task-list {
      margin: 0;
      padding-left: 1.15rem;
      font-size: 0.9375rem;
      line-height: 1.55;
      color: #1e2a4a;
    }

    .parent-task-list li + li {
      margin-top: 0.5rem;
    }

    .parent-growth-bars {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0.4rem;
      align-items: end;
      min-height: 7rem;
      margin-top: 0.75rem;
    }

    .parent-growth-bar {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 0.25rem;
      min-height: 7rem;
    }

    .parent-growth-track {
      display: flex;
      width: 100%;
      height: 4.5rem;
      align-items: flex-end;
      justify-content: center;
      border-radius: 6px;
      background: #eef2f7;
      padding: 0.25rem;
    }

    .parent-growth-fill {
      width: 100%;
      min-height: 4px;
      border-radius: 4px;
      background: #94a3b8;
    }

    .parent-growth-fill--current {
      background: #3d6fd4;
    }

    .parent-growth-label {
      font-size: 0.6rem;
      font-weight: 600;
      text-align: center;
      color: #5a6a8c;
    }

    .parent-growth-value {
      font-size: 0.58rem;
      font-weight: 700;
      color: #3d6fd4;
    }

    .parent-quality-alert {
      margin-bottom: 0.75rem;
      border-radius: 8px;
      border: 1px solid #f0b45e;
      background: #fff8eb;
      padding: 0.65rem 0.75rem;
      color: #8a4f00;
      font-size: 0.875rem;
      font-weight: 650;
    }

    .parent-quality-bars {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0.45rem;
      min-height: 4.8rem;
      margin-top: 0.85rem;
      align-items: end;
    }

    .parent-quality-bar {
      display: flex;
      min-height: 4.8rem;
      align-items: flex-end;
      border-radius: 6px;
      background: #eef2f7;
      padding: 0.25rem;
    }

    .parent-quality-fill {
      display: block;
      width: 100%;
      min-height: 4px;
      border-radius: 4px;
      background: #28a47b;
    }

    .parent-quality-fill--warn {
      background: #d66b35;
    }

    .parent-story-row {
      display: flex;
      gap: 0.65rem;
      align-items: flex-start;
      padding: 0.65rem 0;
      border-bottom: 1px solid #eef2f7;
    }

    .parent-story-row:last-child {
      border-bottom: none;
    }

    .parent-video-card {
      scroll-margin-top: 1rem;
      border-top: 1px solid #eef2f7;
      padding-top: 1rem;
    }

    .parent-video-card:first-child {
      border-top: 0;
      padding-top: 0;
    }

    .parent-video {
      display: block;
      width: 100%;
      max-height: 28rem;
      border-radius: 10px;
      background: #111827;
    }

    .parent-reactions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .parent-reaction {
      display: inline-flex;
      min-width: 72px;
      min-height: 46px;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      border: 1px solid #d8dee8;
      border-radius: 999px;
      background: #fff;
      padding: 0.5rem 0.85rem;
      font-size: 0.9375rem;
      font-weight: 700;
      color: #1e2a4a;
      transition: background-color 120ms ease, transform 120ms ease;
    }

    .parent-reaction:hover {
      background: #f4f6f9;
    }

    .parent-reaction:active {
      transform: scale(0.97);
    }

    .parent-reaction:disabled {
      cursor: wait;
      opacity: 0.65;
    }
  </style>

  <script>
    import { initPhuHuynh } from './phu-huynh';
    initPhuHuynh();
  </script>
</BaseLayout>
