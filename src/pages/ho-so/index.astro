---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MonsterBuilder from '../../components/read2lead/v3/avatar/MonsterBuilder.astro';
import MedalCabinet from '../../components/read2lead/v3/rank/MedalCabinet.astro';
import RankUpModal from '../../components/read2lead/v3/rank/RankUpModal.astro';
import SeasonBanner from '../../components/read2lead/v3/rank/SeasonBanner.astro';
import '../../styles/r2l-kid.css';
import '../../styles/rank-ladder.css';
import './ho-so.css';
import '@fontsource-variable/baloo-2/index.css';
---

<BaseLayout
  title="Ho so hoc sinh — Read2Lead | Felix Coaching"
  description="Xem tien do hoc tap, avatar, xu va cap do cua con."
  robots="noindex, follow"
>
  <Header />

  <main id="main" class="ho-so-page flex-1 px-4 py-8 sm:px-6">
    <section class="mx-auto max-w-lg">

      <!-- CODE ENTRY -->
      <section id="ho-so-entry">
        <h1 class="text-center font-display text-3xl font-extrabold text-cream md:text-4xl">Hồ sơ học sinh</h1>
        <p class="mt-3 text-center text-cream-muted">Chọn vai trò và nhập mã Felix gửi qua Zalo để xem tiến độ con.</p>

        <div class="mt-8 grid grid-cols-2 gap-4">
          <button id="ho-so-role-parent-entry" type="button"
            class="flex flex-col items-center gap-3 rounded-2xl border-2 border-accent/40 bg-accent/10 p-6 text-center transition hover:border-accent hover:bg-accent/20"
            style="min-height:140px">
            <span class="text-4xl">👨‍👩‍👧</span>
            <span class="font-display text-lg font-extrabold text-cream">Phụ huynh</span>
            <span class="text-xs text-cream-muted">Xem tiến độ, báo cáo học tập</span>
          </button>
          <button id="ho-so-role-kid-entry" type="button"
            class="flex flex-col items-center gap-3 rounded-2xl border-2 border-gold/40 bg-gold/10 p-6 text-center transition hover:border-gold hover:bg-gold/20"
            style="min-height:140px">
            <span class="text-4xl">🎒</span>
            <span class="font-display text-lg font-extrabold text-cream">Học sinh</span>
            <span class="text-xs text-cream-muted">Xem thành tích, tạo bài mới</span>
          </button>
        </div>

        <div class="mt-6 rounded-xl border border-cream-dim/20 bg-navy-900/70 p-5">
          <label for="ho-so-code-input" class="text-sm font-semibold text-cream">Mã học sinh</label>
          <p class="mt-1 text-xs text-cream-dim">VD: R2L-LINH-8F3KQ2</p>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row">
            <input
              id="ho-so-code-input"
              name="access_code"
              required
              maxlength="40"
              autocomplete="off"
              autocapitalize="characters"
              autocorrect="off"
              spellcheck="false"
              inputmode="text"
              placeholder="R2L-..."
              data-clarity-mask="true"
              class="min-h-[48px] w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-4 text-cream placeholder:text-cream-dim/50 focus:border-accent focus:outline-none"
            />
            <button id="ho-so-load-btn" type="button"
              class="fx-btn fx-btn--primary shrink-0 px-6">Xem hồ sơ</button>
          </div>
        </div>
      </section>

      <!-- SESSION BAR -->
      <div
        id="ho-so-session-bar"
        class="mt-6 hidden items-center justify-between gap-3 rounded-[var(--r2l-radius)] border-2 border-[rgb(30_42_74/0.1)] bg-[var(--r2l-surface)] px-4 py-3 shadow-[var(--r2l-shadow)]"
      >
        <div class="flex min-w-0 items-center gap-2">
          <p class="min-w-0 truncate text-sm font-bold">
            <span class="r2l-kid-muted">Xin chao</span>
            <span id="ho-so-student-name" class="ml-1" data-clarity-mask="true"></span>
          </p>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <button
            id="ho-so-role-toggle"
            type="button"
            class="r2l-kid-btn r2l-kid-btn--ghost r2l-kid-btn--md hidden text-xs"
          >
            Doi goc nhin
          </button>
          <button
            id="ho-so-change-code"
            type="button"
            class="r2l-kid-btn r2l-kid-btn--ghost r2l-kid-btn--md shrink-0"
          >
            Doi ma
          </button>
        </div>
      </div>

      <!-- ERROR -->
      <section id="ho-so-error" class="r2l-kid-error mt-4 hidden"></section>

      <!-- LOADING -->
      <div id="ho-so-loading" class="mt-8 hidden text-center">
        <div class="ho-so-spinner"></div>
        <p class="mt-3 text-sm r2l-kid-muted">Dang tai ho so...</p>
      </div>

      <!-- ROLE PICKER -->
      <section id="ho-so-role-picker" class="mt-6 hidden">
        <p class="text-center text-sm font-bold r2l-kid-muted mb-4">Ban la ai?</p>
        <div class="grid grid-cols-2 gap-4">
          <button
            id="ho-so-role-kid"
            type="button"
            class="ho-so-role-btn"
          >
            <span class="text-3xl">🎒</span>
            <span class="mt-2 text-base font-bold">Con</span>
            <span class="text-xs r2l-kid-muted">Hoc sinh</span>
          </button>
          <button
            id="ho-so-role-parent"
            type="button"
            class="ho-so-role-btn"
          >
            <span class="text-3xl">👨‍👩‍👧</span>
            <span class="mt-2 text-base font-bold">Bo / Me</span>
            <span class="text-xs r2l-kid-muted">Phu huynh</span>
          </button>
        </div>
      </section>

      <!-- DASHBOARD (kid or parent view rendered here) -->
      <SeasonBanner />
      <section id="ho-so-dashboard" class="mt-6 hidden"></section>
      <MedalCabinet />

      <!-- KID VIEW: generation UX -->
      <div id="ho-so-create-sheet" class="hidden" aria-hidden="true"></div>
      <div id="ho-so-wait-scene" class="mt-6 hidden" aria-live="polite"></div>

      <!-- KID VIEW: monster builder + celebrations -->
      <MonsterBuilder />
      <RankUpModal />

    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { initHoSo } from './ho-so';
  initHoSo();
</script>
