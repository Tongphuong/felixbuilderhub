---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MonsterBuilder from '../../components/read2lead/v3/avatar/MonsterBuilder.astro';
import RankUpModal from '../../components/read2lead/v3/rank/RankUpModal.astro';
import './ho-so.css';
---

<BaseLayout title="Hồ sơ học sinh — Read2Lead | Felix Coaching" description="Xem tiến độ học tập, avatar, xu và cấp độ của con." robots="noindex, follow">
  <Header />
  <main id="main" class="ho-so-page flex-1">
    <section id="ho-so-entry" class="ho-so-entry star-field">
      <div class="ho-so-entry__panel">
        <header class="ho-so-entry__header">
          <p class="fx-eyebrow ho-so-accent-eyebrow">Hồ sơ học sinh</p>
          <h1>Xem tiến độ của con</h1>
          <p>Chọn vai trò và nhập mã Felix gửi qua Zalo.</p>
        </header>
        <div class="ho-so-role-grid" role="radiogroup" aria-label="Bạn là ai?">
          <button id="ho-so-role-parent-entry" class="ho-so-role-tile" type="button" role="radio" aria-checked="false" data-role="parent"><span class="ho-so-role-tile__icon" aria-hidden="true">👨‍👩‍👧</span><strong>Phụ huynh</strong><span>Báo cáo, video, việc tuần</span></button>
          <button id="ho-so-role-kid-entry" class="ho-so-role-tile" type="button" role="radio" aria-checked="true" data-role="kid" data-selected="true"><span class="ho-so-role-tile__icon" aria-hidden="true">🎒</span><strong>Học sinh</strong><span>Avatar, huy hiệu, tạo bài</span></button>
        </div>
        <div>
          <label class="fx-label" for="ho-so-code-input">Mã học sinh <span class="fx-label__req">*</span></label>
          <input id="ho-so-code-input" class="fx-field ho-so-code-field" name="access_code" required maxlength="40" autocomplete="off" autocapitalize="characters" autocorrect="off" spellcheck="false" inputmode="text" placeholder="R2L-..." data-clarity-mask="true" aria-describedby="ho-so-code-hint ho-so-entry-error" />
          <p id="ho-so-code-hint" class="ho-so-field-hint">VD: R2L-LINH-8F3KQ2 · không phân biệt hoa thường</p>
          <p id="ho-so-entry-error" class="ho-so-inline-error hidden" role="alert"></p>
        </div>
        <button id="ho-so-load-btn" class="fx-btn fx-btn--primary fx-btn--lg fx-btn--block ho-so-primary-action" type="button">Xem hồ sơ →</button>
        <aside class="fx-card fx-card--accent ho-so-helper-card"><span aria-hidden="true">💬</span><div><strong>Chưa có mã?</strong><p>Nhắn Zalo Felix — mã sẽ gửi trong 24h, miễn phí.</p><a href="/coaching#contact" class="fx-btn fx-btn--secondary fx-btn--sm">Nhắn Zalo Felix →</a></div></aside>
      </div>
    </section>
    <div id="ho-so-loading" class="ho-so-state-layer hidden" aria-live="polite"><div class="ho-so-loading-grid" aria-label="Đang tải hồ sơ"><div class="fx-card ho-so-skeleton"></div><div class="fx-card ho-so-skeleton"></div><div class="fx-card ho-so-skeleton"></div></div></div>
    <section id="ho-so-error" class="ho-so-global-error hidden" role="alert"><span data-ho-so-error-message></span><button id="ho-so-retry" class="fx-btn fx-btn--secondary fx-btn--sm" type="button">Thử lại ↻</button></section>
    <section id="ho-so-kid" class="ho-so-kid star-field hidden"><div class="ho-so-pad"><div id="ho-so-kid-session"></div><section id="ho-so-kid-hero" class="fx-card"></section><section id="ho-so-kid-stats" class="ho-so-stats" aria-label="Thành tích nhanh"></section><section class="ho-so-board"><div id="ho-so-kid-rank" class="fx-card fx-card--accent"></div><div id="ho-so-kid-medals" class="fx-card"></div></section><section id="ho-so-kid-season"></section><section id="ho-so-kid-extras" class="ho-so-kid-extras"></section><section id="ho-so-kid-cta"></section></div></section>
    <section id="ho-so-parent" class="ho-so-parent star-field hidden"><div class="ho-so-pad"><div id="ho-so-parent-session"></div><header id="ho-so-parent-header"></header><section id="ho-so-parent-stats" class="ho-so-p-stats"></section><section id="ho-so-parent-charts" class="ho-so-p-charts"></section><section class="ho-so-p-bottom"><div id="ho-so-parent-stories" class="fx-card"></div><div class="ho-so-p-side"><div id="ho-so-parent-tasks" class="fx-card fx-card--accent"></div><div id="ho-so-parent-portfolio" class="fx-card"></div></div></section></div></section>
    <div id="ho-so-create-sheet" class="hidden" aria-hidden="true"></div>
    <div id="ho-so-wait-scene" class="hidden" aria-live="polite"></div>
    <MonsterBuilder />
    <RankUpModal />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { initHoSo } from './ho-so';
  initHoSo();
</script>
