---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Faq from '../components/ui/Faq.astro';
import Input from '../components/ui/Input.astro';
import Select from '../components/ui/Select.astro';
import Textarea from '../components/ui/Textarea.astro';
import { ZALO_DISPLAY, ZALO_URL } from '../config/contact';
import { COACHING_MONTHLY_VND, formatVND } from '../config/pricing';

const skillAreas = [
  ['💬', 'Hội thoại', 'Phản xạ nhanh, đối đáp tự nhiên trong tình huống đời thường.'],
  ['📖', 'Kể chuyện', 'Sắp xếp ý mạch lạc, dùng giọng diễn cảm, giữ người nghe theo dõi.'],
  ['🎤', 'Thuyết trình', 'Đứng trước người khác tự tin, trình bày ý tưởng có cấu trúc.'],
  ['⚖️', 'Tranh luận', 'Lập luận có lý lẽ, lắng nghe và phản biện văn minh.'],
];

const outcomes = [
  ['💪', 'Tự tin', 'Dám nói trước đám đông, dám hỏi khi không hiểu.'],
  ['🧠', 'Tư duy phản biện', 'Không vâng dạ thụ động. Biết đặt câu hỏi và suy luận.'],
  ['🌟', 'Kĩ năng mềm', 'Giao tiếp, lắng nghe, hợp tác — nền tảng cho mọi nghề tương lai.'],
];

// Khu vực sample dạy của Felix — ảnh + video minh chứng.
// Khi có content thật: thay `placeholder: true` thành `placeholder: false`
// và điền `src` (ảnh) hoặc `youtubeId` (video).
const teachingSamples = [
  { type: 'video', placeholder: true, title: 'Buổi luyện thuyết trình', caption: 'Học sinh trong nhóm nhỏ luyện thuyết trình về chủ đề tự chọn.' },
  { type: 'photo', placeholder: true, title: 'Lớp tranh luận nhóm nhỏ', caption: 'Nhóm 4 bạn tranh luận về một chủ đề xã hội.' },
  { type: 'video', placeholder: true, title: 'Kể chuyện bằng tiếng Anh', caption: 'Bé tự kể lại câu chuyện vừa đọc bằng các cụm từ đã luyện.' },
];

const faqItems = [
  ['Lớp học có bao nhiêu bạn?', 'Nhóm nhỏ tối đa 4 học viên. Học online qua Zoom hoặc Google Meet. Nhóm nhỏ để mỗi bạn có nhiều thời gian nói và Felix theo sát từng bạn.'],
  ['Học phí bao nhiêu?', `${formatVND(COACHING_MONTHLY_VND)} / tháng cho lớp nhóm. Trước khi bắt đầu, Felix có buổi tư vấn 30 phút miễn phí để đánh giá level và mục tiêu của con.`],
  ['Mất bao lâu để con tự tin trình bày?', 'Tuỳ điểm khởi đầu. Trung bình: bé mới bắt đầu cần 6-12 tháng để dám nói và giao tiếp tự nhiên. Bé đã có nền tảng — 3-6 tháng để rèn kĩ năng riêng, ví dụ thuyết trình.'],
  ['Bé chưa biết gì có học được không?', 'Có. Felix có lộ trình riêng cho beginner — bắt đầu bằng hội thoại đơn giản, không grammar khô khan. Quan trọng là con quen với việc mở miệng nói trước.'],
  ['Học online hay offline?', 'Online (Zoom / Google Meet) là chính. Offline tuỳ khu vực, anh chị nhắn Zalo Felix xem có sắp xếp được không.'],
  ['Felix có kinh nghiệm bao lâu?', 'Hơn 10 năm coach huấn luyện kĩ năng nói cho trẻ em, sử dụng tiếng Anh làm phương tiện — bao gồm cả học sinh người nước ngoài.'],
];
---

<BaseLayout
  title="Huấn luyện kĩ năng nói — Rèn tự tin online | Felix Coaching"
  description="Lớp online nhóm tối đa 4 bé với thầy Phương. Coach huấn luyện kĩ năng nói và tự tin — tiếng Anh là phương tiện. Tư vấn 30 phút miễn phí trước khi bắt đầu."
  ogImage="/images/felix.jpg"
>
  <Header />

  <main id="main" class="flex-1">
    <section class="mx-auto max-w-6xl px-6 py-20 text-center md:py-28">
      <Badge variant="accent">Nhóm nhỏ · Tối đa 4 bé · Online</Badge>
      <h1 class="mx-auto mt-6 max-w-4xl font-display text-4xl font-extrabold text-cream md:text-5xl lg:text-6xl">
        <span class="block">Huấn luyện kĩ năng nói</span>
        <span class="block">rèn tự tin cho con</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-muted md:text-xl">
        Felix dùng tiếng Anh làm phương tiện — hội thoại, kể chuyện, thuyết trình, tranh luận trong lớp nhóm nhỏ, online.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button variant="primary" href="#book">Đặt lịch tư vấn miễn phí</Button>
        <Button variant="secondary" href="/ho-so">Xem tiến độ con</Button>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <SectionHeading
        eyebrow="Kĩ năng"
        title="Bốn kĩ năng nói con sẽ rèn"
        lead="Mỗi buổi tập trung 1 kĩ năng. Lộ trình tăng dần độ khó theo level con."
        align="center"
      />
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {skillAreas.map(([icon, title, description]) => (
          <Card>
            <div class="text-4xl" aria-hidden="true">{icon}</div>
            <h3 class="mt-5 font-display text-xl font-bold leading-snug text-cream">{title}</h3>
            <p class="mt-3 leading-relaxed text-cream-muted">{description}</p>
          </Card>
        ))}
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <SectionHeading eyebrow="Kết quả" title="Con sẽ phát triển gì" align="center" />
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {outcomes.map(([icon, title, description]) => (
            <Card>
              <div class="text-4xl" aria-hidden="true">{icon}</div>
              <h3 class="mt-5 font-display text-xl font-bold leading-snug text-cream">{title}</h3>
              <p class="mt-3 leading-relaxed text-cream-muted">{description}</p>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="text-center">
        <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Khoảnh khắc trong lớp</h2>
        <p class="mx-auto mt-5 max-w-2xl leading-relaxed text-cream-dim">Ảnh và video sample từ các buổi học của Felix.</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {teachingSamples.map((sample) => (
          <figure class="overflow-hidden rounded-xl bg-navy-950 shadow-2xl ring-1 ring-cream-dim/25">
            <div class="relative flex aspect-video items-center justify-center bg-gradient-to-br from-navy-900 to-navy-800">
              <div class="flex flex-col items-center gap-2 text-center">
                <span class="text-4xl" aria-hidden="true">{sample.type === 'video' ? '▶️' : '📸'}</span>
                <Badge variant="gold">Sắp ra mắt</Badge>
              </div>
            </div>
            <figcaption class="px-5 py-4">
              <p class="font-display text-base font-bold text-cream">{sample.title}</p>
              <p class="mt-2 text-sm leading-relaxed text-cream-muted">{sample.caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-6 text-center text-sm text-cream-dim/80">* Felix đang chuẩn bị ảnh và video sample. Phụ huynh quan tâm có thể nhắn Zalo để xem demo trực tiếp.</p>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[320px_1fr] md:items-center">
        <img
          src="/images/felix.jpg"
          alt="Phương — huấn luyện viên Felix Coaching"
          width="320"
          height="320"
          loading="lazy"
          class="mx-auto aspect-square w-full max-w-xs rounded-xl object-cover shadow-2xl ring-1 ring-cream-dim/25 md:mx-0"
        />
        <div>
          <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Về Felix</h2>
          <div class="mt-6 space-y-5 text-lg leading-relaxed text-cream-muted">
            <p>Tôi là Phương — coach huấn luyện kĩ năng nói với <strong class="text-cream">hơn 10 năm kinh nghiệm</strong> rèn tự tin cho các bạn nhỏ, sử dụng tiếng Anh làm phương tiện — bao gồm cả học sinh người nước ngoài.</p>
            <p><strong class="text-cream">Triết lý của tôi:</strong> tiếng Anh là một <em>ngôn ngữ</em>, không phải một môn học. Con không học để thi — con học để nói, kể, hỏi, tranh luận về những điều con thật sự quan tâm.</p>
            <p>Tôi huấn luyện <strong class="text-cream">kĩ năng tư duy và trình bày</strong> thông qua tiếng Anh: thuyết trình, tranh luận, kể chuyện, hội thoại. Tiếng Anh là phương tiện — kĩ năng mềm và sự tự tin mới là đích đến.</p>
            <p>Ngoài lớp coaching, tôi xây dựng <strong class="text-cream">Read2Lead</strong> và <strong class="text-cream">SpeakUp</strong> — sản phẩm giáo dục tăng cường bởi AI, bổ trợ con luyện đọc và luyện nói tại nhà.</p>
          </div>
          <div class="mt-8 rounded-lg border border-accent/40 bg-navy-950/60 p-5">
            <p class="text-sm font-semibold uppercase tracking-wide text-accent">Hình thức lớp học</p>
            <ul class="mt-3 space-y-2 text-cream-muted">
              <li class="flex gap-3"><span class="text-gold-light">✓</span>Online qua Zoom / Google Meet</li>
              <li class="flex gap-3"><span class="text-gold-light">✓</span>Nhóm nhỏ tối đa <strong class="text-cream">4 học viên</strong></li>
              <li class="flex gap-3"><span class="text-gold-light">✓</span>Học phí <strong class="text-cream">{formatVND(COACHING_MONTHLY_VND)} / tháng</strong></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20 text-center">
      <SectionHeading
        align="center"
        title="Đặt lịch tư vấn miễn phí"
        lead="Trước khi bắt đầu, Felix tư vấn 30 phút miễn phí cho phụ huynh. Hiểu con và đề xuất lộ trình phù hợp."
      />
      <ul class="mx-auto mt-8 max-w-2xl space-y-3 text-left text-cream-muted">
        <li class="flex gap-3"><span class="text-gold-light">✓</span><span>Đánh giá level và mục tiêu của con</span></li>
        <li class="flex gap-3"><span class="text-gold-light">✓</span><span>Đề xuất lộ trình (số buổi, kĩ năng cần luyện)</span></li>
        <li class="flex gap-3"><span class="text-gold-light">✓</span><span>Báo giá rõ ràng sau khi tư vấn</span></li>
      </ul>
      <div class="mt-10">
        <Button variant="primary" href="#book">Đặt lịch tư vấn</Button>
      </div>
    </section>

    <section id="book" class="mx-auto max-w-6xl px-6 py-20">
      <SectionHeading
        align="center"
        title="Để Felix liên hệ tư vấn"
        lead="Điền form, Felix sẽ nhắn Zalo trong 24h."
      />

      <form id="coaching-form" class="mx-auto mt-8 grid max-w-xl gap-5">
        <Input label="Tên phụ huynh" name="parent_name" required maxlength={100} />
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          <Input label="Tên con" name="child_name" required maxlength={50} />
          <Input label="Tuổi con" name="child_age" type="number" required />
        </div>
        <Select label="Level tiếng Anh hiện tại" name="english_level" required>
          <option value="" disabled selected>-- Chọn level --</option>
          <option value="beginner">Mới bắt đầu (chưa giao tiếp được)</option>
          <option value="basic">Cơ bản (nói được câu đơn)</option>
          <option value="intermediate">Trung bình (giao tiếp được nhưng còn ngại)</option>
          <option value="advanced">Khá (cần luyện chuyên sâu)</option>
          <option value="unsure">Không chắc — Felix đánh giá giúp</option>
        </Select>
        <Textarea label="Mục tiêu của phụ huynh" name="goals" rows={3} maxlength={300} placeholder="VD: Con tự tin nói trước lớp, kể chuyện mạch lạc, giao tiếp tự nhiên với người nước ngoài..." />
        <Input label="Số Zalo" name="zalo_phone" type="tel" required pattern="^[+0-9\s\-()]{8,20}$" />
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" tabindex="-1" />
        </div>
        <Button size="lg" block type="submit">Đặt lịch tư vấn — miễn phí</Button>
        <p class="text-center text-xs text-cream-dim">Felix chỉ dùng thông tin để liên hệ tư vấn. Không spam.</p>
        <p class="text-center text-xs text-cream-dim">Gửi form đồng nghĩa anh chị đồng ý <a href="/privacy" class="underline transition hover:text-accent">chính sách dữ liệu</a> của Felix.</p>
      </form>

      <div id="coaching-form-status" class="mx-auto mt-8 hidden max-w-xl rounded-lg border border-cream-dim/20 bg-navy-900 p-5 text-center font-semibold"></div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-16">
      <div class="rounded-2xl border border-cream-dim/20 bg-navy-900/60 p-8 text-center md:p-12">
        <h2 class="font-display text-2xl font-bold leading-snug text-cream md:text-3xl">Phụ huynh đã học cùng Felix?</h2>
        <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-cream-muted">Nếu con đang học hoặc đã học với Felix, anh chị có thể gửi cảm nhận để Felix giới thiệu với phụ huynh khác đang cân nhắc.</p>
        <div class="mt-6">
          <Button variant="secondary" href={ZALO_URL} target="_blank" rel="noopener noreferrer">Gửi cảm nhận qua Zalo</Button>
        </div>
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Câu hỏi thường gặp</h2>
        <div class="mt-10 space-y-3">
          {faqItems.map(([question, answer]) => (
            <Faq question={question}>{answer}</Faq>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20 text-center">
      <SectionHeading
        align="center"
        title="Mỗi bé một lộ trình riêng"
        lead="Đặt lịch tư vấn miễn phí để Felix gặp con và đề xuất hướng đi phù hợp."
      />
      <div class="mt-8">
        <Button variant="primary" href="#book">Đặt lịch tư vấn</Button>
      </div>
    </section>
  </main>

  <Footer />

  <script define:vars={{ ZALO_URL, ZALO_DISPLAY }}>
    const form = document.getElementById('coaching-form');
    const btn = form.querySelector('button[type="submit"]');
    const statusEl = document.getElementById('coaching-form-status');
    const pageUrl = new URL(window.location.href);
    const urlRef = pageUrl.searchParams.get('ref') || '';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      if (urlRef) data.ref = urlRef;

      if (data.website) {
        showSuccess();
        return;
      }

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Đang gửi...';

      try {
        const res = await fetch('/api/coaching-booking', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          showSuccess();
        } else {
          showError();
          btn.disabled = false;
          btn.textContent = originalText;
        }
      } catch {
        showError();
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });

    function showSuccess() {
      form.style.display = 'none';
      statusEl.className = 'mx-auto mt-8 max-w-xl rounded-lg border border-gold/40 bg-gold/10 p-5 text-center font-semibold text-gold-light';
      statusEl.innerHTML = '✅ Đã ghi nhận lịch tư vấn. Felix sẽ Zalo trong 24h để confirm slot.';
      statusEl.scrollIntoView({ behavior: 'smooth' });
    }

    function showError() {
      statusEl.className = 'mx-auto mt-8 max-w-xl rounded-lg border border-red-500/30 bg-red-500/10 p-5 text-center font-semibold text-red-400';
      statusEl.innerHTML = `⚠️ Có lỗi xảy ra. Vui lòng thử lại hoặc nhắn trực tiếp <a href="${ZALO_URL}" class="underline">Zalo ${ZALO_DISPLAY}</a>`;
    }
  </script>
</BaseLayout>
