---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const socialLinks = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/phuong.tong.79230',
    svg: '<path fill="currentColor" d="M22 12a10 10 0 1 0-11.6 9.9V14.9H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/>',
  },
  {
    label: 'Messenger',
    href: 'https://m.me/phuong.tong.79230',
    svg: '<path fill="currentColor" d="M12 2C6.5 2 2 6.2 2 11.3c0 2.9 1.4 5.4 3.7 7.1V22l3.4-1.9c.9.3 1.9.4 2.9.4 5.5 0 10-4.2 10-9.3S17.5 2 12 2Zm1 12.5L10.5 12 5.6 14.5 11 8.8l2.6 2.5L18.5 8.8l-5.5 5.7Z"/>',
  },
  {
    label: 'Zalo',
    href: 'https://zalo.me/0396868675',
    svg: '<path fill="currentColor" d="M12 2a10 10 0 1 0 5.4 18.4l3.6 1.1-1.1-3.5A10 10 0 0 0 12 2Zm-4.1 8.5h2v.8c.5-.6 1.2-1 2.1-1 1.6 0 2.5 1 2.5 2.7v3.5h-2v-3.2c0-.9-.4-1.4-1.2-1.4-.8 0-1.4.6-1.4 1.5v3.1h-2v-6Zm-2.4 0h2v6h-2v-6Zm9.9 0h4.8v1.3l-3 3h3v1.7h-5v-1.3l3-3h-2.8v-1.7Z"/>',
  },
];
---

<BaseLayout title="Felix Builder Hub — Sản phẩm giáo dục dành riêng cho mỗi bạn nhỏ">
  <Header homeLinks={true} />

  <main id="main" class="flex-1">
    <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
      <div class="flex flex-col items-center gap-10 md:flex-row md:gap-16">
        <div class="shrink-0">
          <img
            src="/images/felix.jpg"
            alt="Phương"
            width="208"
            height="208"
            class="h-44 w-44 rounded-full object-cover shadow-2xl ring-4 ring-cream-dim/25 md:h-52 md:w-52"
          />
        </div>
        <div class="text-center md:text-left">
          <h1 class="max-w-3xl font-display text-3xl font-extrabold leading-[1.6] text-cream md:text-5xl">
            Xin chào, tôi là Phương,<br class="hidden md:block" /> chào mừng bạn đến với thế giới của tôi.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream-muted md:text-xl">
            Tôi xây dựng các sản phẩm giáo dục dành riêng cho mỗi bạn nhỏ.
          </p>
          <a href="#products" class="mt-8 inline-block rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">
            Xem sản phẩm →
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Về tôi</h2>
      <div class="mt-8 max-w-3xl space-y-5 text-lg leading-relaxed text-cream-muted">
        <p>Tôi là một huấn luyện viên kĩ năng giao tiếp tiếng Anh và nhà phát triển các dự án giáo dục cá nhân hóa cho trẻ em.</p>
        <p>Hiện tại tôi đang xây dựng:</p>
        <ul class="space-y-3 pl-1">
          <li class="flex gap-3">
            <span class="shrink-0 text-accent" aria-hidden="true">•</span>
            <span><strong class="font-semibold text-cream">Coaching giao tiếp tiếng Anh</strong> — lớp 1-1 hoặc nhóm nhỏ rèn kĩ năng nói cho con.</span>
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 text-accent" aria-hidden="true">•</span>
            <span><strong class="font-semibold text-cream">My Story, My World</strong> — truyện cá nhân hóa làm quà tặng.</span>
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 text-accent" aria-hidden="true">•</span>
            <span><strong class="font-semibold text-cream">Read2Lead</strong> — khơi gợi cảm hứng đọc và học tiếng Anh với câu chuyện được thiết kế riêng cho con.</span>
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 text-accent" aria-hidden="true">•</span>
            <span><strong class="font-semibold text-cream">Felix Sharing Space</strong> — nơi tôi chia sẻ kiến thức, kinh nghiệm và các sản phẩm miễn phí.</span>
          </li>
        </ul>
        <p>Mong rằng sản phẩm của tôi giúp ích cho cuộc sống của bạn.</p>
      </div>
    </section>

    <section id="products" class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <h2 class="font-display text-3xl font-bold text-cream">Sản phẩm</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4">
          <article class="rounded-lg border border-accent bg-navy-950/75 p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <h3 class="font-display text-2xl font-bold text-cream">MSMW — My Story, My World</h3>
              <span class="w-fit rounded-md border border-accent/40 bg-accent/15 px-2.5 py-1 text-xs font-semibold text-accent">Sẵn sàng đặt</span>
            </div>
            <p class="mt-5 leading-relaxed text-cream-muted">Sách truyện cá nhân hoá cho con của bạn — món quà ý nghĩa hơn đồ chơi thường ngày.</p>
            <a href="/msmw" class="mt-6 inline-flex font-semibold text-accent transition hover:text-accent-hover">Xem chi tiết →</a>
          </article>

          <article class="rounded-lg border border-cream-dim/30 bg-navy-950/75 p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <h3 class="font-display text-2xl font-bold text-cream">Read2Lead</h3>
              <span class="w-fit rounded-md border border-gold/40 bg-gold/15 px-2.5 py-1 text-xs font-semibold text-gold-light">Thử nghiệm — miễn phí</span>
            </div>
            <p class="mt-5 leading-relaxed text-cream-muted">Tạo gói đọc tiếng Anh cá nhân hoá cho trẻ em Việt — in được, có audio.</p>
            <a href="/read2lead" class="mt-6 inline-flex font-semibold text-accent transition hover:text-accent-hover">Tải pack miễn phí →</a>
          </article>

          <article class="rounded-lg border border-cream-dim/30 bg-navy-950/75 p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <h3 class="font-display text-2xl font-bold text-cream">Felix Sharing Space</h3>
              <span class="w-fit rounded-md border border-cream-dim/40 bg-cream-dim/10 px-2.5 py-1 text-xs font-semibold text-cream-dim">Sắp ra mắt</span>
            </div>
            <p class="mt-5 leading-relaxed text-cream-muted">Nơi tôi chia sẻ kiến thức, kinh nghiệm và các tài liệu miễn phí cho phụ huynh.</p>
            <a href="/space" class="mt-6 inline-flex font-semibold text-accent transition hover:text-accent-hover">Xem chi tiết →</a>
          </article>

          <article class="rounded-lg border border-accent bg-navy-950/75 p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <h3 class="font-display text-2xl font-bold text-cream">Coaching giao tiếp tiếng Anh</h3>
              <span class="w-fit rounded-md border border-accent/40 bg-accent/15 px-2.5 py-1 text-xs font-semibold text-accent">Đang nhận học sinh</span>
            </div>
            <p class="mt-5 leading-relaxed text-cream-muted">Lớp 1-1 hoặc nhóm nhỏ. Hội thoại, kể chuyện, thuyết trình, tranh luận — rèn tự tin và tư duy phản biện.</p>
            <a href="/coaching" class="mt-6 inline-flex font-semibold text-accent transition hover:text-accent-hover">Xem chi tiết →</a>
          </article>
        </div>
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="font-display text-3xl font-bold text-cream">Liên hệ</h2>
      <p class="mt-6 text-lg text-cream-muted">Nhắn cho tôi qua Zalo để liên hệ về sản phẩm hoặc cộng tác.</p>
      <div class="mt-8 flex max-w-md flex-col gap-3 text-cream-muted">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0 text-cream-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
          </svg>
          <span>Zalo: +84 396868675</span>
        </div>
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0 text-cream-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16v16H4z" />
            <path d="m22 6-10 7L2 6" />
          </svg>
          <a href="mailto:phuongtong474@gmail.com" class="transition hover:text-accent">phuongtong474@gmail.com</a>
        </div>
        <div class="flex items-center gap-3 pt-3">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Nhắn tin qua ${link.label}`}
              title={link.label}
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-cream-dim/30 text-cream-dim transition hover:border-accent hover:bg-accent/10 hover:text-accent"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" set:html={link.svg}></svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
