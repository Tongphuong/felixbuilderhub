---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Avatar from '../components/ui/Avatar.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { EMAIL, FB_URL, MESSENGER_URL, ZALO_DISPLAY, ZALO_URL } from '../config/contact';

const socialLinks = [
  {
    label: 'Facebook',
    href: FB_URL,
    svg: '<path fill="currentColor" d="M22 12a10 10 0 1 0-11.6 9.9V14.9H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/>',
  },
  {
    label: 'Messenger',
    href: MESSENGER_URL,
    svg: '<path fill="currentColor" d="M12 2C6.5 2 2 6.2 2 11.3c0 2.9 1.4 5.4 3.7 7.1V22l3.4-1.9c.9.3 1.9.4 2.9.4 5.5 0 10-4.2 10-9.3S17.5 2 12 2Zm1 12.5L10.5 12 5.6 14.5 11 8.8l2.6 2.5L18.5 8.8l-5.5 5.7Z"/>',
  },
  {
    label: 'Zalo',
    href: ZALO_URL,
    svg: '<path fill="currentColor" d="M12 2a10 10 0 1 0 5.4 18.4l3.6 1.1-1.1-3.5A10 10 0 0 0 12 2Zm-4.1 8.5h2v.8c.5-.6 1.2-1 2.1-1 1.6 0 2.5 1 2.5 2.7v3.5h-2v-3.2c0-.9-.4-1.4-1.2-1.4-.8 0-1.4.6-1.4 1.5v3.1h-2v-6Zm-2.4 0h2v6h-2v-6Zm9.9 0h4.8v1.3l-3 3h3v1.7h-5v-1.3l3-3h-2.8v-1.7Z"/>',
  },
];

---

<BaseLayout
  title="Felix Coaching — Coach huấn luyện kĩ năng nói cho trẻ em"
  description="Lớp online nhóm nhỏ tối đa 4 bé — rèn tự tin nói, kể chuyện, thuyết trình và tranh luận. Tiếng Anh là phương tiện luyện tập. Đặt lịch tư vấn miễn phí với thầy Phương."
  ogImage="/images/felix.jpg"
>
  <Header />

  <main id="main" class="flex-1">
    <section class="border-b border-cream-dim/10 bg-navy-900/60 px-6 py-8">
      <div class="mx-auto flex max-w-lg flex-col items-center gap-4 text-center">
        <p class="text-sm font-bold text-cream-muted">Nhập mã Felix cấp qua Zalo để xem hồ sơ con</p>
        <form id="home-code-form" class="flex w-full flex-col gap-3 sm:flex-row">
          <input
            id="home-code-input"
            name="code"
            maxlength="40"
            autocomplete="off"
            autocapitalize="characters"
            autocorrect="off"
            spellcheck="false"
            inputmode="text"
            placeholder="VD: R2L-LINH-8F3KQ2"
            data-clarity-mask="true"
            class="min-h-[48px] w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-4 text-cream placeholder:text-cream-dim/50 focus:border-accent focus:outline-none"
          />
          <button
            type="submit"
            class="fx-btn fx-btn--primary shrink-0 whitespace-nowrap px-6"
          >Xem hồ sơ</button>
        </form>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 py-12 md:py-16">
      <div class="grid gap-6 sm:grid-cols-3">
        <a href="/coaching" class="fx-card fx-card--interactive flex flex-col items-center gap-4 rounded-2xl p-8 text-center">
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-accent text-3xl text-navy-950">💬</span>
          <span class="font-display text-2xl font-extrabold text-cream">Coaching</span>
          <span class="text-sm text-cream-muted">Lớp online nhóm nhỏ tối đa 4 bé — rèn tự tin nói, kể chuyện, thuyết trình.</span>
        </a>
        <a href="/san-pham" class="fx-card fx-card--interactive flex flex-col items-center gap-4 rounded-2xl p-8 text-center">
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-gold text-3xl text-navy-950">📚</span>
          <span class="font-display text-2xl font-extrabold text-cream">Sản phẩm giáo dục</span>
          <span class="text-sm text-cream-muted">Read2Lead và SpeakUp — công cụ luyện đọc và luyện nói cho trẻ em.</span>
        </a>
        <a href="/ho-so" class="fx-card fx-card--interactive flex flex-col items-center gap-4 rounded-2xl p-8 text-center">
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-cream/20 text-3xl">🎓</span>
          <span class="font-display text-2xl font-extrabold text-cream">Hồ sơ học sinh</span>
          <span class="text-sm text-cream-muted">Xem tiến độ con — cấp độ, điểm, bài đang học.</span>
        </a>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
      <div class="text-center">
        <Badge variant="accent">Dịch vụ chính · Nhóm nhỏ tối đa 4 bé · Online</Badge>
        <h1 class="mx-auto mt-6 max-w-5xl font-display text-4xl font-extrabold leading-[1.3] text-cream md:text-5xl lg:text-6xl">
          <span class="block">Huấn luyện kĩ năng nói</span>
          <span class="block text-accent">rèn tự tin cho con</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-muted md:text-xl">
          Felix dùng tiếng Anh làm phương tiện — kể chuyện, thuyết trình, tranh luận trong lớp nhóm tối đa 4 bé, online.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button variant="primary" href="/coaching#book">Đặt lịch tư vấn miễn phí →</Button>
          <Button variant="secondary" href="/ho-so">
            <span class="flex flex-col items-center sm:items-start">
              <span>Xem tiến độ con</span>
              <span class="mt-0.5 text-xs font-normal text-cream-dim">Nhập mã học sinh Felix cấp</span>
            </span>
          </Button>
        </div>
        <p class="mt-6 text-sm text-cream-dim">Hơn 10 năm coach huấn luyện kĩ năng nói cho trẻ em Việt</p>
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-16">
      <div class="mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-[auto_1fr]">
        <Avatar
          src="/images/felix.jpg"
          alt="Phương — huấn luyện viên Felix Coaching"
          size="xl"
          loading="lazy"
        />
        <div>
          <SectionHeading eyebrow="Giới thiệu" title="Felix Coaching là gì?" />
          <p class="mt-4 leading-relaxed text-cream-muted">
            Tôi là Phương — coach huấn luyện kĩ năng nói, sử dụng tiếng Anh làm phương tiện. Tôi rèn <strong class="text-cream">tự tin nói thật</strong>:
            con dám mở miệng, kể chuyện có cấu trúc, thuyết trình trước lớp và tranh luận có lý lẽ.
          </p>
          <p class="mt-3 leading-relaxed text-cream-muted">
            Ngoài lớp coaching, tôi xây dựng <strong class="text-cream">Read2Lead</strong> và <strong class="text-cream">SpeakUp</strong> — công cụ luyện đọc và luyện nói cho trẻ em, bổ trợ cho việc học tại nhà.
          </p>
          <p class="mt-3 leading-relaxed text-cream-muted">
            Mỗi học sinh có <a href="/ho-so" class="font-semibold text-accent underline">trang xem tiến độ riêng</a> — bố mẹ nhập mã là thấy bài con đang học, truyện đã hoàn thành và (sắp tới) luyện nói chuyên sâu.
          </p>
          <Button variant="ghost" href="/coaching" class="mt-5">Xem chương trình coaching →</Button>
        </div>
      </div>
    </section>

    <section id="ai-products" class="mx-auto max-w-6xl px-6 py-20">
      <SectionHeading
        class="max-w-3xl"
        eyebrow="Bổ trợ ngoài lớp"
        title="Sản phẩm giáo dục cho trẻ em"
        lead="Bài luyện đọc và nghe phù hợp với trình độ từng con — bổ trợ buổi coaching, không thay thế lớp trực tiếp với Felix."
      />
      <Card variant="accent" class="mt-8">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="font-display text-2xl font-bold text-cream">Read2Lead</h3>
              <Badge variant="gold">Thử nghiệm — miễn phí</Badge>
            </div>
            <p class="mt-4 leading-relaxed text-cream-muted">
              Công cụ luyện đọc và nghe cho trẻ em — con chọn chủ đề, làm nhiệm vụ, tích điểm và leo cấp. Bố mẹ xem tiến độ qua <a href="/ho-so" class="font-semibold text-accent underline">trang xem tiến độ con</a>.
            </p>
          </div>
          <Button variant="primary" href="/read2lead" class="shrink-0">Tạo bài miễn phí →</Button>
        </div>
      </Card>
      <Card variant="accent" class="mt-4">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="font-display text-2xl font-bold text-cream">SpeakUp</h3>
              <Badge variant="gold">Sắp ra mắt</Badge>
            </div>
            <p class="mt-4 leading-relaxed text-cream-muted">
              Công cụ luyện nói tiếng Anh cho trẻ em — con tập phát âm, kể chuyện và thuyết trình với Minny.
            </p>
          </div>
          <Button variant="secondary" href="/speak-up" class="shrink-0">Tìm hiểu thêm →</Button>
        </div>
      </Card>
    </section>

    <section id="contact" class="mx-auto max-w-6xl px-6 py-20">
      <SectionHeading
        title="Liên hệ"
        lead="Nhắn Zalo để đặt lịch tư vấn coaching hoặc hỏi về tiến độ học của con."
      />
      <div class="mt-8 flex max-w-md flex-col gap-3 text-cream-muted">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0 text-cream-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
          </svg>
          <span>Zalo: {ZALO_DISPLAY}</span>
        </div>
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0 text-cream-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16v16H4z" />
            <path d="m22 6-10 7L2 6" />
          </svg>
          <a href={`mailto:${EMAIL}`} class="transition hover:text-accent">{EMAIL}</a>
        </div>
        <div class="flex items-center gap-3 pt-3">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Nhắn tin qua ${link.label}`}
              title={link.label}
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-cream-dim/30 text-cream-dim transition hover:border-accent hover:bg-accent/10 hover:text-accent"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" set:html={link.svg}></svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const form = document.getElementById('home-code-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('home-code-input') as HTMLInputElement | null;
      const code = (input?.value || '').trim().toUpperCase();
      if (code) window.location.href = '/ho-so?code=' + encodeURIComponent(code);
    });
  </script>
</BaseLayout>
