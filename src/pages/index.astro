---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { EMAIL, FB_URL, MESSENGER_URL, ZALO_DISPLAY, ZALO_URL } from '../config/contact';

const socialLinks = [
  {
    label: 'Facebook',
    href: FB_URL,
    svg: '<path fill="currentColor" d="M22 12a10 10 0 1 0-11.6 9.9V14.9H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/>',
  },
  {
    label: 'Messenger',
    href: MESSENGER_URL,
    svg: '<path fill="currentColor" d="M12 2C6.5 2 2 6.2 2 11.3c0 2.9 1.4 5.4 3.7 7.1V22l3.4-1.9c.9.3 1.9.4 2.9.4 5.5 0 10-4.2 10-9.3S17.5 2 12 2Zm1 12.5L10.5 12 5.6 14.5 11 8.8l2.6 2.5L18.5 8.8l-5.5 5.7Z"/>',
  },
  {
    label: 'Zalo',
    href: ZALO_URL,
    svg: '<path fill="currentColor" d="M12 2a10 10 0 1 0 5.4 18.4l3.6 1.1-1.1-3.5A10 10 0 0 0 12 2Zm-4.1 8.5h2v.8c.5-.6 1.2-1 2.1-1 1.6 0 2.5 1 2.5 2.7v3.5h-2v-3.2c0-.9-.4-1.4-1.2-1.4-.8 0-1.4.6-1.4 1.5v3.1h-2v-6Zm-2.4 0h2v6h-2v-6Zm9.9 0h4.8v1.3l-3 3h3v1.7h-5v-1.3l3-3h-2.8v-1.7Z"/>',
  },
];

---

<BaseLayout
  title="Felix Coaching — Coach huấn luyện kĩ năng nói cho trẻ em"
  description="Lớp online nhóm nhỏ tối đa 4 bé — rèn tự tin nói, kể chuyện, thuyết trình và tranh luận. Tiếng Anh là phương tiện luyện tập. Đặt lịch tư vấn miễn phí với thầy Phương."
  ogImage="/images/felix.jpg"
>
  <Header />

  <main id="main" class="flex-1">
    <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
      <div class="text-center">
        <span class="inline-block rounded-full border border-accent/40 bg-accent/15 px-4 py-1 text-sm font-semibold text-accent">
          Dịch vụ chính · Nhóm nhỏ tối đa 4 bé · Online
        </span>
        <h1 class="mx-auto mt-6 max-w-5xl font-display text-4xl font-extrabold leading-[1.3] text-cream md:text-5xl lg:text-6xl">
          <span class="block">Huấn luyện kĩ năng nói</span>
          <span class="block text-accent">rèn tự tin cho con</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-muted md:text-xl">
          Felix dùng tiếng Anh làm phương tiện — kể chuyện, thuyết trình, tranh luận trong lớp nhóm tối đa 4 bé, online.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/coaching#book" class="inline-flex rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">
            Đặt lịch tư vấn miễn phí →
          </a>
          <a href="/hoc-sinh" class="inline-flex flex-col items-center rounded-lg border border-cream-dim/40 px-6 py-3 font-semibold text-cream transition hover:border-accent hover:text-accent sm:items-start">
            <span>Xem tiến độ con</span>
            <span class="mt-0.5 text-xs font-normal text-cream-dim">Nhập mã học sinh Felix cấp</span>
          </a>
        </div>
        <p class="mt-6 text-sm text-cream-dim">Hơn 10 năm coach huấn luyện kĩ năng nói cho trẻ em Việt</p>
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-16">
      <div class="mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-[auto_1fr]">
        <img
          src="/images/felix.jpg"
          alt="Phương — huấn luyện viên Felix Coaching"
          width="180"
          height="180"
          loading="lazy"
          class="h-36 w-36 rounded-full object-cover ring-4 ring-accent/30 md:h-44 md:w-44"
        />
        <div>
          <h2 class="font-display text-2xl font-bold leading-snug text-cream md:text-3xl">Felix Coaching là gì?</h2>
          <p class="mt-4 leading-relaxed text-cream-muted">
            Tôi là Phương — coach huấn luyện kĩ năng nói, sử dụng tiếng Anh làm phương tiện. Tôi rèn <strong class="text-cream">tự tin nói thật</strong>:
            con dám mở miệng, kể chuyện có cấu trúc, thuyết trình trước lớp và tranh luận có lý lẽ.
          </p>
          <p class="mt-3 leading-relaxed text-cream-muted">
            Ngoài lớp coaching, tôi xây dựng <strong class="text-cream">Read2Lead</strong> và <strong class="text-cream">MSMW</strong> — sản phẩm giáo dục tăng cường bởi AI, bổ trợ con luyện đọc và đọc truyện tại nhà.
          </p>
          <p class="mt-3 leading-relaxed text-cream-muted">
            Mỗi học sinh có <a href="/hoc-sinh" class="font-semibold text-accent underline">trang xem tiến độ riêng</a> — bố mẹ nhập mã là thấy bài con đang học, truyện đã hoàn thành và (sắp tới) luyện nói chuyên sâu.
          </p>
          <a href="/coaching" class="mt-5 inline-flex font-semibold text-accent transition hover:text-accent-hover">
            Xem chương trình coaching →
          </a>
        </div>
      </div>
    </section>

    <section id="ai-products" class="mx-auto max-w-6xl px-6 py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-extrabold uppercase tracking-widest text-cream-dim">Bổ trợ ngoài lớp</p>
        <h2 class="mt-2 font-display text-3xl font-bold text-cream">Sản phẩm giáo dục tăng cường bởi AI</h2>
        <p class="mt-3 leading-relaxed text-cream-muted">
          Felix dùng AI để tạo bài luyện đọc và nghe cá nhân hoá — bổ trợ buổi coaching, không thay thế lớp trực tiếp với Felix.
        </p>
      </div>
      <article class="mt-8 rounded-2xl border border-gold/30 bg-navy-950/70 p-6 md:p-8">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="font-display text-2xl font-bold text-cream">Read2Lead</h3>
              <span class="rounded-md border border-gold/40 bg-gold/15 px-2.5 py-1 text-xs font-semibold text-gold-light">Thử nghiệm — miễn phí</span>
            </div>
            <p class="mt-4 leading-relaxed text-cream-muted">
              Công cụ luyện đọc và nghe tăng cường bởi AI — con chọn chủ đề, làm nhiệm vụ, tích điểm và leo cấp. Bố mẹ xem tiến độ qua <a href="/hoc-sinh" class="font-semibold text-accent underline">trang xem tiến độ con</a>.
            </p>
          </div>
          <a href="/read2lead" class="inline-flex shrink-0 rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">
            Tạo bài miễn phí →
          </a>
        </div>
      </article>
    </section>

    <section id="msmw" class="bg-navy-900 px-6 py-20">
      <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-widest text-cream-dim">Sản phẩm riêng</p>
          <h2 class="mt-2 font-display text-3xl font-bold text-cream">MSMW — My Story, My World</h2>
          <p class="mt-4 leading-relaxed text-cream-muted">
            Sách truyện song ngữ Việt–Anh với <strong class="text-cream">chính con là nhân vật chính</strong> — Felix dùng AI tạo minh hoạ riêng từ ảnh thật của bé. Món quà ý nghĩa cho sinh nhật, Tết thiếu nhi hoặc dịp đặc biệt.
          </p>
          <p class="mt-3 text-sm text-cream-dim">Bản số từ 69k · Bản in từ 129k · Giao toàn quốc</p>
          <a href="/msmw" class="mt-6 inline-flex rounded-lg border border-cream-dim/40 px-6 py-3 font-semibold text-cream transition hover:border-accent hover:text-accent">
            Xem trang MSMW →
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <img src="/msmw/thumb-toy-brick.jpg" alt="Bìa sách MSMW Thành Phố Gạch Màu" width="240" height="360" loading="lazy" class="rounded-xl border border-cream-dim/20 object-cover shadow-lg" />
          <img src="/msmw/thumb-heart-garden.jpg" alt="Bìa sách MSMW Khu Vườn Trái Tim" width="240" height="360" loading="lazy" class="mt-8 rounded-xl border border-cream-dim/20 object-cover shadow-lg" />
        </div>
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="font-display text-3xl font-bold text-cream">Liên hệ</h2>
      <p class="mt-6 text-lg text-cream-muted">Nhắn Zalo để đặt lịch tư vấn coaching hoặc hỏi về tiến độ học của con.</p>
      <div class="mt-8 flex max-w-md flex-col gap-3 text-cream-muted">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0 text-cream-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
          </svg>
          <span>Zalo: {ZALO_DISPLAY}</span>
        </div>
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0 text-cream-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16v16H4z" />
            <path d="m22 6-10 7L2 6" />
          </svg>
          <a href={`mailto:${EMAIL}`} class="transition hover:text-accent">{EMAIL}</a>
        </div>
        <div class="flex items-center gap-3 pt-3">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Nhắn tin qua ${link.label}`}
              title={link.label}
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-cream-dim/30 text-cream-dim transition hover:border-accent hover:bg-accent/10 hover:text-accent"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" set:html={link.svg}></svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
