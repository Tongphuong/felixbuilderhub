---
import BaseLayout from '../layouts/BaseLayout.astro';

const socialLinks = [
  {
    label: 'Facebook',
    href: '#',
    path: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
  },
  {
    label: 'LinkedIn',
    href: '#',
    path: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  },
  {
    label: 'GitHub',
    href: '#',
    path: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-1-2.6c3.2-.4 6.5-1.6 6.5-7A5.4 5.4 0 0 0 20 4.8 5 5 0 0 0 19.9 1S18.7.6 16 2.5a13.4 13.4 0 0 0-7 0C6.3.6 5.1 1 5.1 1A5 5 0 0 0 5 4.8 5.4 5.4 0 0 0 3.5 8.5c0 5.4 3.3 6.6 6.5 7a3.4 3.4 0 0 0-1 2.6V22',
  },
];
---

<BaseLayout title="Felix Builder Hub — Sản phẩm giáo dục dành riêng cho mỗi bạn nhỏ">
  <header class="sticky top-0 z-50 border-b border-cream-dim/20 bg-navy-950/85 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="#" class="font-display text-lg font-semibold text-cream">Felix Builder Hub</a>
      <nav class="hidden items-center gap-6 text-sm font-medium text-cream-muted sm:flex">
        <a href="#products" class="transition hover:text-accent">Sản phẩm</a>
        <a href="#contact" class="transition hover:text-accent">Liên hệ</a>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
      <div class="flex flex-col items-center gap-10 md:flex-row md:gap-16">
        <div class="shrink-0">
          <img
            src="/images/felix.jpg"
            alt="Phương"
            class="h-44 w-44 rounded-full object-cover shadow-2xl ring-4 ring-cream-dim/25 md:h-52 md:w-52"
          />
        </div>
        <div class="text-center md:text-left">
          <h1 class="max-w-3xl font-display text-3xl font-extrabold leading-[1.6] text-cream md:text-5xl">
            Xin chào, tôi là Phương,<br class="hidden md:block" /> chào mừng bạn đến với thế giới của tôi.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream-muted md:text-xl">
            Tôi xây dựng các sản phẩm giáo dục dành riêng cho mỗi bạn nhỏ.
          </p>
          <a href="#products" class="mt-8 inline-block rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">
            Xem sản phẩm →
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Về tôi</h2>
      <div class="mt-8 max-w-3xl space-y-5 text-lg leading-relaxed text-cream-muted">
        <p>Tôi là một huấn luyện viên kĩ năng giao tiếp tiếng Anh và nhà phát triển các dự án giáo dục cá nhân hóa cho trẻ em.</p>
        <p>Hiện tại tôi đang xây dựng:</p>
        <ul class="space-y-3 pl-1">
          <li class="flex gap-3">
            <span class="shrink-0 text-accent" aria-hidden="true">•</span>
            <span><strong class="font-semibold text-cream">My Story, My World</strong> — truyện cá nhân hóa làm quà tặng.</span>
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 text-accent" aria-hidden="true">•</span>
            <span><strong class="font-semibold text-cream">Read2Lead</strong> — khơi gợi cảm hứng đọc và học tiếng Anh với câu chuyện được thiết kế riêng cho con.</span>
          </li>
          <li class="flex gap-3">
            <span class="shrink-0 text-accent" aria-hidden="true">•</span>
            <span><strong class="font-semibold text-cream">Felix Sharing Space</strong> — nơi tôi chia sẻ kiến thức, kinh nghiệm và các sản phẩm miễn phí.</span>
          </li>
        </ul>
        <p>Mong rằng sản phẩm của tôi giúp ích cho cuộc sống của bạn.</p>
      </div>
    </section>

    <section id="products" class="bg-navy-900 px-6 py-20">
      <div class="mx-auto max-w-6xl">
        <h2 class="font-display text-3xl font-bold text-cream">Sản phẩm</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          <article class="rounded-lg border border-accent bg-navy-950/75 p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <h3 class="font-display text-2xl font-bold text-cream">MSMW — My Story, My World</h3>
              <span class="w-fit rounded-full bg-gold/15 px-3 py-1 text-xs font-semibold text-gold-light">Sample sẵn sàng</span>
            </div>
            <p class="mt-5 leading-relaxed text-cream-muted">Sách truyện cá nhân hoá cho bé yêu — món quà ý nghĩa hơn đồ chơi thường ngày.</p>
            <a href="/msmw" class="mt-6 inline-flex font-semibold text-accent transition hover:text-accent-hover">Xem chi tiết →</a>
          </article>

          <article class="rounded-lg border border-cream-dim/30 bg-navy-950/75 p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <h3 class="font-display text-2xl font-bold text-cream">Read2Lead</h3>
              <span class="w-fit rounded-full bg-gold/15 px-3 py-1 text-xs font-semibold text-gold-light">Đang phát triển</span>
            </div>
            <p class="mt-5 leading-relaxed text-cream-muted">Tạo gói đọc tiếng Anh cá nhân hoá cho trẻ em Việt — in được, có audio.</p>
            <a href="/read2lead" class="mt-6 inline-flex font-semibold text-accent transition hover:text-accent-hover">Tải pack miễn phí →</a>
          </article>
        </div>
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="font-display text-3xl font-bold text-cream">Liên hệ</h2>
      <p class="mt-6 text-lg text-cream-muted">Nhắn cho tôi qua Zalo để liên hệ về sản phẩm hoặc cộng tác.</p>
      <div class="mt-8 flex max-w-md flex-col gap-3 text-cream-muted">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0 text-cream-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />
          </svg>
          <span>Zalo: +84 396868675</span>
        </div>
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0 text-cream-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16v16H4z" />
            <path d="m22 6-10 7L2 6" />
          </svg>
          <a href="mailto:phuongtong474@gmail.com" class="transition hover:text-accent">phuongtong474@gmail.com</a>
        </div>
        <div class="flex items-center gap-4 pt-2">
          {socialLinks.map((link) => (
            <a href={link.href} aria-label={link.label} class="text-cream-dim transition hover:text-accent">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={link.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="mt-auto border-t border-cream-dim/20 py-8 text-center text-sm text-cream-dim/80">
    © 2026 Tong Phuong - built in vietnam
  </footer>
</BaseLayout>
