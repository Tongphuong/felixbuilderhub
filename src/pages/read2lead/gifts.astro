---
// Shop đổi quà — Đảo phiêu lưu release 2 (design 08). A SEPARATE economy from the monster shop: diamonds only, no
// preview-flag gate. Full-screen kid page (no site header/footer) like the other Đảo phiêu lưu screens; all styling lives
// in src/styles/qua-that.css and every state is rendered by src/lib/gift-ux.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GiftConfirmModal from '../../components/read2lead/gifts/GiftConfirmModal.astro';
import GiftSuccessModal from '../../components/read2lead/gifts/GiftSuccessModal.astro';
import '../../styles/qua-that.css';
---

<BaseLayout
  title="Shop đổi quà | Read2Lead | Felix Coaching"
  description="Con dùng kim cương đổi lấy một món quà trong shop đổi quà — Coach Felix mua và trao tận tay ở lớp."
  robots="noindex, follow"
  childHome
>
  <main id="main" class="qt-page r2l">
    <div class="qt-wrap">
      <div class="qt-top">
        <a id="gifts-home" class="r2l-back" href="/read2lead" data-design="shop.back"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path d="M19 12H6M11 6l-6 6 6 6" stroke="#17324D" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>Về đọc sách</a>
        <header class="qt-head" data-design="shop.header">
          <div class="qt-title"><span class="r2l-lab">Quà từ Coach Felix</span><h1 class="r2l-d">Shop đổi quà</h1></div>
          <svg class="qt-head-gift" aria-hidden="true" width="72" height="72" viewBox="0 0 24 24"><rect x="3" y="9" width="18" height="12" rx="2" fill="#FF7A3D" stroke="#17324D" stroke-width="1.6"/><rect x="2" y="6" width="20" height="4" rx="1.5" fill="#FFC83D" stroke="#17324D" stroke-width="1.6"/><path d="M12 6v15M12 6c-2-4-7-4-6-1s6 1 6 1c2-4 7-4 6-1s-6 1-6 1" stroke="#17324D" stroke-width="1.6" fill="none"/></svg>
        </header>
        <div id="gifts-balance-pill" class="qt-wallet r2l-card-f hidden" data-design="shop.wallet">
          <svg aria-hidden="true" width="52" height="52" viewBox="0 0 24 24"><path d="M6 3h12l4 6-10 12L2 9z" fill="#3CC8F0" stroke="#17324D" stroke-width="1.6" stroke-linejoin="round"/><path d="M2 9h20M9 3l3 18 3-18" stroke="#17324D" stroke-width="1.2" fill="none"/></svg>
          <div class="qt-wallet-text">
            <span class="r2l-lab">Kim cương của con</span>
            <strong id="gifts-balance-pill-value" class="r2l-d">0</strong>
          </div>
        </div>
      </div>

      <div id="gifts-entry" class="qt-entry r2l-card-f">
        <label for="gifts-code" class="r2l-lab">Mã học sinh</label>
        <div class="qt-entry__row">
          <input id="gifts-code" maxlength="40" autocomplete="off" placeholder="R2L-..." class="r2l-inp qt-entry__input" />
          <button id="gifts-load" type="button" class="r2l-btn r2l-btn-sun qt-entry__button">Vào cửa hàng</button>
        </div>
      </div>

      <div id="gifts-error" class="qt-error hidden" role="alert"></div>

      <div id="gifts-shell" class="qt-shell hidden">
        <p class="qt-note r2l-b-m">Kim cương đến từ <b>lớp học</b> — Coach Felix thưởng mỗi buổi. Con đổi kim cương lấy quà, Coach Felix trao tận tay ở lớp.</p>
        <div class="qt-main">
          <div id="gifts-goal" class="qt-goal-slot hidden" data-design="shop.goal" data-design-col></div>
          <section class="qt-listcol" aria-labelledby="qt-all-title" data-design-col>
            <h2 id="qt-all-title" class="r2l-d r2l-t-3">Tất cả quà</h2>
            <div class="qt-gridwrap" data-design="shop.grid">
              <div id="gifts-bands" class="qt-bands"></div>
              <div id="gifts-trophy" class="qt-trophy-slot hidden"></div>
              <div id="gifts-inflight" class="qt-inflight-slot hidden"></div>
              <a id="gifts-accessory" class="qt-accessory" href="/read2lead/shop" data-design="shop.accessory-link"><img src="/assets/minny/minny_face.png" alt="" width="44" height="44" /><span>Đổi kim cương lấy phụ kiện quái vật</span></a>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>

  <GiftConfirmModal />
  <GiftSuccessModal />
</BaseLayout>

<script>
  import { initGiftsPage } from '../../lib/gift-ux';

  function showGiftsError(message: string) {
    const errorEl = document.querySelector('#gifts-error');
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
  }

  initGiftsPage({ onError: showGiftsError });

  // "Xem quà của con" scrolls back to the catalogue after the celebration
  // closes; "Về cửa hàng" just closes. Wired here (page-shell concern) rather
  // than in gift-ux.ts, which only owns data/state, not page scroll position.
  document.querySelector('.qt-success-view')?.addEventListener('click', () => {
    document.querySelector('#gifts-bands')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
