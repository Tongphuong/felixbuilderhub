  function _r2lSpeakingRetryCount() {
    let retryCount = 0;
    _r2lRecorderState.perItem.forEach((entry) => {
      retryCount += Number(entry?.failureCount || 0);
    });
    retryCount += Number(_r2lRetellState?.failureCount || 0);
    return retryCount;
  }

  function _r2lLearningMetricPayload() {
    return {
      started_at: state.learningMetrics?.startedAt || new Date().toISOString(),
