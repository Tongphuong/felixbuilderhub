  async function _r2lOpenMicStream() {
    // R2LRecorder remembers the mic that passed the mic test (Zoom pattern) and
    // applies the current constraint profile (noiseSuppression auto-disabled on
    // machines where it gated the child's voice).
    if (window.R2LRecorder?.getStream) {
      return window.R2LRecorder.getStream();
    }
    if (window.R2LMicCheck?.getMicStream) {
      return window.R2LMicCheck.getMicStream();
    }
    return navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
    });
  }

  // Unified recorder: MediaRecorder by default, raw-PCM WAV on machines where the
  // platform encoder proved broken. Falls back to the local MediaRecorder path if
  // the engine script failed to load.
  function _r2lCreateUnifiedRecorder(stream) {
    if (window.R2LRecorder?.createRecorder) {
      return window.R2LRecorder.createRecorder(stream);
    }
    const { mediaRecorder, mimeType } = _r2lCreateMediaRecorder(stream);
    const chunks = [];
    let resolveStop = null;
    const stopped = new Promise((resolve) => { resolveStop = resolve; });
    mediaRecorder.addEventListener('dataavailable', (e) => {
      if (e.data && e.data.size > 0) chunks.push(e.data);
    });
    mediaRecorder.addEventListener('stop', () => {
      resolveStop(new Blob(chunks, { type: mediaRecorder.mimeType || mimeType || 'audio/mp4' }));
    });
    return {
      engine: 'mr',
      mimeType,
      start() { mediaRecorder.start(250); },
      stop() { _r2lStopMediaRecorder(mediaRecorder); return stopped; },
    };
  }

  // Meet-style live monitor on the recording stream — detects "no sound reached
  // the mic" on the child's machine instead of waiting for the server to fail.
  async function _r2lStartLevelMonitor(stream, cardEl) {
    if (!window.R2LRecorder?.startMonitor) {
      return { available: false, peak: () => -1, voiced: () => true, stop: () => {} };
    }
    return window.R2LRecorder.startMonitor(stream, {
      onLevel: (level) => {
        const bar = cardEl?.querySelector?.('[data-rec-meter]');
        if (bar) bar.style.width = `${Math.min(100, Math.round((level / 64) * 100))}%`;
      },
      onSilenceHint: () => {
        const hint = cardEl?.querySelector?.('[data-rec-hint]');
        if (hint) hint.textContent = 'Minny chưa thấy tiếng — con nói TO hơn nhé!';
      },
    });
  }

