  // Below this, the blob is almost certainly a codec header with no speech
  // (kid tapped stop instantly / Safari header-only chunk). Real speech ≥0.5s
  // is several KB; header-only is ~200–600 bytes. 1200 cleanly separates them.
  const _R2L_MIN_SPEECH_BYTES = 1200;
  const _R2L_SPEAK_CHECK_TIMEOUT_MS = 25000;
  const _R2L_SPEAKING_PASS_PERCENT = 50;
