<script is:inline set:html={dictationHelperInline} />

<script is:inline>
  /* ----- W4.4 SFX library ----- */
  const SFX = {
    correctCommon: '/sfx/r2l/success-1.mp3',
    correctRare: '/sfx/r2l/success-2.mp3',
    correctLegendary: '/sfx/r2l/success-3.mp3',
    wrong: '/sfx/r2l/soft-boop.mp3',
    encouragement: '/sfx/r2l/voice-colen.mp3',
    activityComplete: '/sfx/r2l/page-complete.mp3',
    packComplete: '/sfx/r2l/final-reward.mp3',
    levelUp: '/sfx/r2l/voice-xuatsac.mp3',
  };

  const VOICE_POOL = [
    '/sfx/r2l/voice-tuyetvoi.mp3',
    '/sfx/r2l/voice-gioiqua.mp3',
    '/sfx/r2l/voice-tienbo.mp3',
    '/sfx/r2l/voice-xuatsac.mp3',
  ];

  const _r2lSfxState = {
    muted: (() => {
      try { return localStorage.getItem('r2l_sfx_muted') === '1'; } catch { return false; }
    })(),
    wrongStreak: new Map(),
    audioCache: new Map(),
  };

  function _r2lGetAudio(src) {
    let audio = _r2lSfxState.audioCache.get(src);
    if (!audio) {
      audio = new Audio(src);
      audio.preload = 'auto';
      _r2lSfxState.audioCache.set(src, audio);
    }
    return audio;
  }

  function playSfx(src, { volume = 0.85 } = {}) {
    if (_r2lSfxState.muted || !src) return;
    try {
      const audio = _r2lGetAudio(src);
      audio.volume = volume;
      audio.currentTime = 0;
      audio.play().catch((err) => {
        console.debug('[r2l-sfx] play blocked:', src, err.message);
      });
    } catch (err) {
      console.warn('[r2l-sfx] error:', err);
    }
  }

  function playSfxSequence(sources, gapMs = 600) {
    if (_r2lSfxState.muted) return;
    if (!sources.length) return;
    playSfx(sources[0]);
    if (sources.length > 1) {
      window.setTimeout(() => playSfxSequence(sources.slice(1), gapMs), gapMs);
    }
  }

  function pickVoiceClip() {
    return VOICE_POOL[Math.floor(Math.random() * VOICE_POOL.length)];
  }

  function playCorrectVoice(delayMs = 360) {
    window.setTimeout(() => playSfx(pickVoiceClip(), { volume: 0.95 }), delayMs);
  }

  function setSfxMuted(muted) {
    _r2lSfxState.muted = !!muted;
    try {
      localStorage.setItem('r2l_sfx_muted', muted ? '1' : '0');
    } catch {}
    const btn = document.getElementById('sfx-toggle');
    if (btn) btn.textContent = muted ? 'Bật âm' : 'Tắt âm';
  }

  let _r2lSfxPreloaded = false;
  function preloadSfxOnce() {
    if (_r2lSfxPreloaded) return;
    _r2lSfxPreloaded = true;
    [SFX.correctCommon, SFX.wrong, SFX.activityComplete, SFX.packComplete].forEach((src) => {
      try { _r2lGetAudio(src).load(); } catch {}
    });
  }
  document.addEventListener('click', preloadSfxOnce, { once: true });

  const sfxToggle = document.getElementById('sfx-toggle');
  if (sfxToggle) {
    sfxToggle.textContent = _r2lSfxState.muted ? 'Bật âm' : 'Tắt âm';
    sfxToggle.addEventListener('click', () => setSfxMuted(!_r2lSfxState.muted));
  }

  const state = {
    accessCode: '',
    packId: '',
    lesson: null,
    activityIndex: 0,
    completedTypes: new Set(),
    activityResults: {},
    writtenDrafts: {},
    activityProgress: {},
    w1Phase: 'story',
    w1MaxUnlocked: 0,
    w1MidpointCelebrated: false,
    storyGate: { read_done: false, listen_done: false, paragraphs_played: [], card_index: 0 },
    questionOutcomes: {},
    learningMetrics: { startedAt: new Date().toISOString(), events: [] },
  };

  const lessonAudioState = {
    audio: null,
    url: '',
    button: null,
  };

  const ACTIVITY_LABELS = {
    listening_fill_blank: 'Nghe điền',
    listen_and_fill: 'Tai thần',
    listen_and_order: 'Xếp câu',
    sentence_builder: 'Thợ xây câu',
    reading_comprehension: 'Đọc hiểu',
    story_detective: 'Thám tử truyện',
    written_response: 'Viết đáp án',
    listen_and_speak: 'Nói lại',
    echo_challenge: 'Giọng ca vàng',
    retell_summary: 'Kể truyện',
    speed_round: 'Tổng công kích',
    story_discovery: 'Nghe & Khám phá',
    vocab_blitz: 'Sức mạnh từ vựng',
  };

  const ACTIVITY_LABELS_V21 = {
    story_discovery: { icon: '🗺️', label: 'Nghe & Khám phá' },
    vocab_blitz: { icon: '⚡', label: 'Sức mạnh từ vựng' },
    sentence_builder: { icon: '🏗️', label: 'Thợ xây câu' },
    story_detective: { icon: '🔍', label: 'Thám tử truyện' },
    listen_and_fill: { icon: '👂', label: 'Tai thần' },
    echo_challenge: { icon: '🎙️', label: 'Giọng ca vàng' },
    speed_round: { icon: '🚀', label: 'Tổng công kích' },
  };

  const ACTIVITY_SHELL_ALIAS = {
    sentence_builder: 'listen_and_order',
    listen_and_fill: 'listening_fill_blank',
    story_detective: 'story_detective',
    echo_challenge: 'echo_challenge',
  };

  const V21_BADGES = {
    story_discovery: { name_vi: 'Nhà thám hiểm', icon: '/img/r2l/badges/explorer.svg' },
    vocab_blitz: { name_vi: 'Phù thủy chữ', icon: '/img/r2l/badges/wizard.svg' },
    sentence_builder: { name_vi: 'Kiến trúc sư', icon: '/img/r2l/badges/architect.svg' },
    story_detective: { name_vi: 'Thám tử Vàng', icon: '/img/r2l/badges/detective.svg' },
    listen_and_fill: { name_vi: 'Tai Thần', icon: '/img/r2l/badges/ear.svg' },
    echo_challenge: { name_vi: 'Giọng ca Vàng', icon: '/img/r2l/badges/singer.svg' },
    speed_round: { name_vi: 'Tia Chớp', icon: '/img/r2l/badges/lightning.svg' },
  };

  const DETECTIVE_CATEGORY_VI = {
    detail: 'chi tiết',
    inference: 'suy luận',
    prediction: 'dự đoán',
    opinion: 'ý kiến',
  };

  function isV21Lesson(lesson = state.lesson) {
    return String(lesson?.schema_version || '') === '2.1';
  }

  function activityLabelText(type) {
    const v21 = ACTIVITY_LABELS_V21[type];
    if (isV21Lesson() && v21) return v21.label;
    return ACTIVITY_LABELS[type] || type;
  }

  function activityShellForType(type) {
    if (type === 'story_discovery' || type === 'vocab_blitz' || type === 'speed_round') {
      return qs(`[data-activity-shell="${type}"]`);
    }
    if (type === 'story_detective') {
      return qs('[data-activity-shell="story_detective"]') || qs('[data-activity-shell="reading_comprehension"]');
    }
    if (type === 'echo_challenge') {
      return qs('[data-activity-shell="echo_challenge"]') || qs('[data-activity-shell="listen_and_speak"], [data-activity-shell="echo_challenge"]');
    }
    const alias = ACTIVITY_SHELL_ALIAS[type] || type;
    return qs(`[data-activity-shell="${alias}"]`);
  }

  const _r2lGameState = {
    combo: { current: 0, max: 0, phase_max: {} },
    phaseStars: {},
    badgesEarned: [],
    speedRoundPool: [],
  };

  function _r2lCreateGameState() {
    _r2lGameState.combo = { current: 0, max: 0, phase_max: {} };
    _r2lGameState.phaseStars = {};
    _r2lGameState.badgesEarned = [];
    _r2lGameState.speedRoundPool = [];
    return _r2lGameState;
  }

  function _r2lRecordAnswer(correct, timeMs = 0) {
    if (correct) {
      _r2lGameState.combo.current += 1;
      _r2lGameState.combo.max = Math.max(_r2lGameState.combo.max, _r2lGameState.combo.current);
      window.__r2lV21Audio?.playFx?.('correct');
      _r2lUpdateComboHud();
    } else {
      _r2lGameState.combo.current = 0;
      window.__r2lV21Audio?.playFx?.('wrong');
      _r2lUpdateComboHud();
    }
    return { correct, timeMs, combo: _r2lGameState.combo.current };
  }

  function _r2lEndPhase(phaseType, stats = {}) {
    const phaseCombo = _r2lGameState.combo.phase_max[phaseType] || _r2lGameState.combo.max;
    _r2lGameState.combo.phase_max[phaseType] = phaseCombo;
    _r2lGameState.combo.current = 0;
    _r2lUpdateComboHud();
    const badge = _r2lMaybeAwardBadge(phaseType, stats);
    return { phaseType, badge, comboMax: phaseCombo };
  }

  function _r2lCalculateReward() {
    const stars = Object.values(_r2lGameState.phaseStars).reduce((sum, n) => sum + Number(n || 0), 0);
    const score100 = Math.round((stars / 21) * 100);
    const base = Object.keys(_r2lGameState.phaseStars).length * 5;
    const comboBonus = _r2lGameState.combo.max >= 8 ? 15 : _r2lGameState.combo.max >= 5 ? 10 : _r2lGameState.combo.max >= 3 ? 5 : 0;
    return { score100, stars, coins: base + comboBonus, badges: _r2lGameState.badgesEarned.slice() };
  }

  function _r2lComboLevel() {
    const n = _r2lGameState.combo.current;
    if (n >= 8) return 'rainbow';
    if (n >= 5) return 'lightning';
    if (n >= 3) return 'fire';
    return null;
  }

  function _r2lUpdateComboHud() {
    if (!isV21Lesson()) return;
    const hud = qs('#r2l-combo-hud');
    const countEl = qs('[data-combo-count]');
    const emojiEl = qs('[data-combo-emoji]');
    if (!hud || !countEl) return;
    const n = _r2lGameState.combo.current;
    hud.dataset.show = n > 0 ? 'true' : 'false';
    countEl.textContent = String(n);
    const level = _r2lComboLevel();
    if (emojiEl) {
      emojiEl.textContent = level === 'rainbow' ? '🌈' : level === 'lightning' ? '⚡' : level === 'fire' ? '🔥' : '';
    }
    if (level) {
      window.__r2lV21Fx?.showComboLevel?.(level);
      if (level === 'rainbow') {
        window.__r2lV21Fx?.shakeScreen?.('heavy');
        window.__r2lV21Fx?.fireCoinRain?.();
      } else if (level === 'lightning') {
        window.__r2lV21Fx?.shakeScreen?.('medium');
      } else {
        window.__r2lV21Fx?.shakeScreen?.('light');
      }
    }
  }

  function _r2lMaybeAwardBadge(phaseType, stats) {
    const def = V21_BADGES[phaseType];
    if (!def) return null;
    let earned = false;
    if (phaseType === 'story_discovery') earned = (stats.correct || 0) / Math.max(1, stats.total || 1) >= 0.8;
    else if (phaseType === 'vocab_blitz') earned = (stats.correct || 0) >= 5;
    else if (phaseType === 'sentence_builder') earned = (stats.wrong_count || 0) === 0 && (stats.correct || 0) === (stats.total || 0);
    else if (phaseType === 'story_detective') earned = (stats.correct || 0) === (stats.total || 0);
    else if (phaseType === 'listen_and_fill') earned = (stats.correct || 0) === (stats.total || 0) && (stats.wrong_count || 0) === 0;
    else if (phaseType === 'echo_challenge') earned = (stats.avg_score || 0) >= 80;
    else if (phaseType === 'speed_round') earned = (stats.correct || 0) >= 8;
