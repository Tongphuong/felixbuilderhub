      _r2lSyncMinnyRecordButton(itemKey, cardEl);
      if (itemData.checkResult) _r2lRenderSpeakFeedback(cardEl, itemData.checkResult);
    });
    _r2lMergeSpeakActivityScores(activity);
  }



  function _r2lFlushAndSave() {
    if (_r2lSaveSessionTimer) {
      window.clearTimeout(_r2lSaveSessionTimer);
      _r2lSaveSessionTimer = null;
    }
    saveLessonSession();
