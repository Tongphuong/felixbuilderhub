        if (info.explanationShown) {
          root.querySelector(`[data-fill-explanation="${itemIndex}"]`)?.classList.remove('hidden');
        }
        if (info.revealedIndex != null) {
          const revealedBtn = root.querySelector(
            `[data-fill-item="${itemIndex}"][data-option-index="${info.revealedIndex}"]`,
          );
          if (revealedBtn) revealedBtn.dataset.state = 'revealed';
