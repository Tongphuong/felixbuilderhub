---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ActivityProgress from '../../components/read2lead/v2/ActivityProgress.astro';
import IdentityBanner from '../../components/read2lead/v2/IdentityBanner.astro';
import ListeningFillBlank from '../../components/read2lead/v2/ListeningFillBlank.astro';
import ListenAndOrder from '../../components/read2lead/v2/ListenAndOrder.astro';
import ListenAndSpeak from '../../components/read2lead/v2/ListenAndSpeak.astro';
import RetellSummary from '../../components/read2lead/v2/RetellSummary.astro';
import StoryDiscovery from '../../components/read2lead/v2/StoryDiscovery.astro';
import VocabBlitz from '../../components/read2lead/v2/VocabBlitz.astro';
import StoryDetective from '../../components/read2lead/v2/StoryDetective.astro';
import EchoChallenge from '../../components/read2lead/v2/EchoChallenge.astro';
import SpeedRound from '../../components/read2lead/v2/SpeedRound.astro';
import LevelUpModal from '../../components/read2lead/v2/LevelUpModal.astro';
import RankUpModal from '../../components/read2lead/v3/rank/RankUpModal.astro';
import ProgressBar from '../../components/read2lead/v2/ProgressBar.astro';
import StoryDock from '../../components/read2lead/v2/StoryDock.astro';
import MinnyCoachStrip from '../../components/read2lead/v2/MinnyCoachStrip.astro';
import ParentStrip from '../../components/read2lead/v2/ParentStrip.astro';
import ReadingComprehension from '../../components/read2lead/v2/ReadingComprehension.astro';
import RewardBurst from '../../components/read2lead/v2/RewardBurst.astro';
import retellGuideSrc from '../../../functions/api/_read2lead-retell-guide.js?raw';
import dictationHelperSrc from '../../lib/read2lead-dictation.ts?raw';
import { r2lRecorderScriptSrc } from '../../scripts/r2l-recorder-script.mjs';
import '../../styles/r2l-w2-dynamic.css';

const r2lRecorderSrc = r2lRecorderScriptSrc();
const retellGuideInline = retellGuideSrc
  .replace(/^export function /gm, 'function ')
  .replace(/^export const /gm, 'const ');
const dictationHelperInline = dictationHelperSrc.replace(/^export function /gm, 'function ');
---

<BaseLayout
  title="Bài học Read2Lead — Luyện đọc tiếng Anh | Felix Coaching"
  description="Bài học Read2Lead: nghe truyện, xếp câu, nói lại và đọc hiểu theo nhịp nhẹ nhàng."
  robots="noindex, follow"
>
  <Header read2LeadState={true} />
  <main id="main" class="min-h-screen bg-navy-950" data-r2l-w1-ssr={import.meta.env.PUBLIC_R2L_W1 === '1' ? '1' : '0'}>
    <IdentityBanner />
    <ProgressBar />

    <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
      <div id="loading-card" class="rounded-md border border-cream/10 bg-cream/5 p-6 text-cream">
        <p id="loading-message">Minny đang mở nhiệm vụ cho con...</p>
      </div>

      <div id="error-card" class="hidden rounded-md border border-gold/30 bg-gold/10 p-6 text-cream">
        <p class="font-semibold text-gold">Chưa mở được bài học</p>
        <p id="error-message" class="mt-2 text-sm text-cream/80"></p>
        <button id="error-retry" class="r2l-primary mt-4" type="button">Thử lại</button>
      </div>

      <article id="lesson-shell" class="hidden space-y-6">
        <section id="w1-story-phase" class="hidden space-y-4 rounded-md border border-cream/10 bg-cream/[0.04] p-4">
          <h2 class="font-display text-2xl font-bold text-cream">Khám phá truyện</h2>
          <div id="w1-gate-chips" class="flex flex-wrap gap-2">
            <span id="w1-chip-read" class="r2l-w1-chip" data-done="false">📖 Đọc</span>
            <span id="w1-chip-listen" class="r2l-w1-chip" data-done="false">🎧 Nghe</span>
          </div>
          <p id="w1-gate-hint" class="text-sm leading-relaxed text-cream/70">
            Con đọc hết truyện và nghe Minny đọc xong, rồi mới mở nhiệm vụ nhé!
          </p>
          <div id="w1-story-cards" class="space-y-3"></div>
          <div class="flex flex-wrap gap-2">
            <button id="w1-read-along" class="r2l-primary" type="button">▶ Đọc cùng Minny</button>
            <button id="w1-story-prev" class="r2l-secondary hidden" type="button">← Trước</button>
            <button id="w1-story-next" class="r2l-primary" type="button">Tiếp →</button>
          </div>
          <button id="w1-open-quests" class="r2l-primary w-full text-lg" type="button" disabled>Mở nhiệm vụ 🎯</button>
        </section>

        <ParentStrip />
        <div
          id="mic-prep-banner"
          class="hidden rounded-md border border-gold/35 bg-gold/10 px-4 py-3 text-sm leading-relaxed text-cream"
          role="status"
        >
          <p class="font-bold text-gold">Bài này có phần nói — cần micro</p>
          <p class="mt-1 text-cream/85">
            Ba mẹ: cho Chrome hoặc Safari được dùng micro (Windows/Mac → Cài đặt → Quyền riêng tư → Microphone).
            Không mở trong Zalo/Facebook.
          </p>
          <button id="mic-prep-dismiss" type="button" class="r2l-secondary mt-3 text-xs">Đã hiểu</button>
        </div>
        <StoryDock />
        <MinnyCoachStrip />

        <section class="rounded-md border border-cream/10 bg-cream/[0.04] p-4">
          <ol id="w1-quest-path" class="r2l-kid-quest-path hidden" data-r2l-quest-path aria-label="Nhiệm vụ"></ol>
          <div id="w1-legacy-progress">
            <ActivityProgress />
          </div>
        </section>

        <section class="space-y-4">
          <StoryDiscovery />
          <VocabBlitz />
          <ListeningFillBlank />
          <ListenAndOrder />
          <StoryDetective />
          <ReadingComprehension />
          <section class="r2l-activity" data-activity-shell="written_response" hidden>
            <div class="r2l-activity-head">
              <p class="r2l-identity" data-activity-identity></p>
              <h2 data-activity-title></h2>
              <p data-activity-instructions></p>
            </div>
            <div data-activity-body></div>
          </section>
          <EchoChallenge />
          <ListenAndSpeak />
          <SpeedRound />
          <RetellSummary />
        </section>

        <div
          id="r2l-combo-hud"
          class="pointer-events-none fixed right-4 top-24 z-40 hidden rounded-full border border-gold/40 bg-navy-900/90 px-4 py-2 text-sm font-bold text-gold shadow-lg"
          data-show="false"
          aria-live="polite"
        >
          <span data-combo-count>0</span> combo <span data-combo-emoji></span>
        </div>
        <div
          id="r2l-combo-level-overlay"
          class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center text-6xl opacity-0 transition-opacity duration-300"
          data-show="false"
          aria-hidden="true"
        ></div>
        <div
          id="r2l-badge-toast"
          class="fixed left-1/2 top-4 z-50 flex -translate-x-1/2 translate-y-[-120%] items-center gap-3 rounded-xl border border-gold/40 bg-navy-900 px-4 py-3 shadow-xl transition-transform duration-300"
          data-show="false"
          role="status"
        >
          <img data-badge-icon src="/img/r2l/badges/explorer.svg" alt="" width="48" height="48" />
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-gold">Huy hiệu mới!</p>
            <p class="font-bold text-cream" data-badge-name></p>
          </div>
        </div>

        <section id="global-cta" class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-2">
          <button id="lesson-continue" class="r2l-primary w-full text-lg" type="button" disabled>
            Tiếp tục →
          </button>
        </section>

        <section
          id="trivia-reveal-section"
          class="r2l-trivia-reveal hidden rounded-md border border-accent/30 bg-accent/[0.08] p-5"
          data-show="false"
        >
          <div class="flex flex-wrap items-start gap-3">
            <span class="text-3xl" aria-hidden="true">✨</span>
            <div>
              <p class="text-sm font-semibold uppercase tracking-wide text-accent">Bí mật sau truyện</p>
              <h3 class="mt-1 font-display text-xl font-bold text-cream">Minny mở khóa một điều thú vị!</h3>
            </div>
          </div>
          <p id="trivia-reveal-text" class="mt-4 text-base leading-7 text-cream"></p>
          <p id="trivia-reveal-text-en" class="mt-2 hidden text-sm leading-6 text-cream/65"></p>
          <button id="trivia-reveal-continue" class="r2l-primary mt-5" type="button">Tiếp tục</button>
        </section>

        <section class="flex flex-col gap-3 rounded-md border border-accent/25 bg-accent/10 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-display text-xl font-bold text-cream">Hoàn thành nhiệm vụ</p>
            <p id="submit-hint" class="mt-1 text-sm text-cream/70">
              Con hoàn thành đủ 6 phần rồi bấm nút này để lưu kết quả.
            </p>
          </div>
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
            <button id="submit-lesson" class="r2l-primary" type="button" disabled>Lưu chiến công</button>
            <button id="submit-retry" class="r2l-secondary hidden" type="button">Gửi lại</button>
          </div>
        </section>

        <section id="w1-result-recap" class="hidden space-y-3 rounded-md border border-cream/10 bg-cream/[0.04] p-4">
          <h3 class="font-display text-xl font-bold text-cream">Cần ôn 💪</h3>
          <p id="w1-recap-intro" class="text-sm text-cream/70"></p>
          <div id="w1-recap-cards" class="space-y-3"></div>
          <button id="w1-recap-skip" class="r2l-secondary hidden w-full" type="button">Bỏ qua phần ôn</button>
        </section>

        <section id="completion-card" class="hidden rounded-md border border-gold/40 bg-gold/10 p-6 text-center">
          <p class="font-display text-2xl font-bold text-gold">Nhiệm vụ xong!</p>
          <p id="completion-copy" class="mt-2 text-cream/80"></p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
            <a id="completion-new-pack" href="/read2lead#form" class="r2l-primary inline-flex items-center justify-center">Tạo bài mới</a>
            <a href="/read2lead/leaderboard" class="r2l-secondary inline-flex items-center justify-center">Bảng xếp hạng</a>
            <a href="/read2lead" class="r2l-secondary inline-flex items-center justify-center">Trang chính</a>
          </div>
        </section>
      </article>
    </section>

    <RewardBurst />
    <LevelUpModal />
    <RankUpModal />

    <div id="submit-confirm-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60">
      <div class="mx-4 max-w-sm rounded-xl bg-navy-900 border border-gold/30 p-6 text-center">
        <img src="/assets/minny/minny_celebrate.png" alt="Minny" width="80" height="80" class="mx-auto mb-3" />
        <p class="font-display text-xl font-bold text-gold">Con đã xong bài!</p>
        <p class="mt-2 text-sm text-cream/80">Lưu chiến công hôm nay?</p>
        <div class="mt-5 flex gap-3 justify-center">
          <button id="submit-confirm-yes" class="r2l-primary px-6" type="button">Lưu chiến công</button>
          <button id="submit-confirm-no" class="r2l-secondary px-4" type="button">Quay lại</button>
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <script src={r2lRecorderSrc} defer></script>
  <script src="/scripts/r2l-mic-check.js" defer></script>
  <script>
    import { initAudioSprites, playFx, playUrl } from '../../lib/r2l-howler';
    import { fireConfetti, fireCoinRain, fireComboFx } from '../../lib/r2l-confetti';
    import { shakeScreen, showComboLevel, showBadgeToast } from '../../lib/r2l-combo-fx';

    window.__r2lV21Audio = { initAudioSprites, playFx, playUrl };
    window.__r2lV21Fx = {
      fireConfetti,
      fireCoinRain,
      fireComboFx,
      shakeScreen,
      showComboLevel,
      showBadgeToast,
    };
    initAudioSprites();
  </script>
</BaseLayout>

<style is:global>
  .r2l-primary {
    min-height: 44px;
    border-radius: 8px;
    background: rgb(74 222 128);
    padding: 0.75rem 1rem;
    font-weight: 800;
    color: rgb(10 14 26);
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .r2l-primary:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .r2l-primary:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .r2l-secondary {
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.24);
    background: rgb(245 230 211 / 0.05);
    padding: 0.75rem 1rem;
    font-weight: 800;
    color: rgb(245 230 211);
  }

  .r2l-secondary:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .r2l-step {
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.14);
    padding: 0.75rem;
    text-align: left;
    font-weight: 700;
    color: rgb(245 230 211 / 0.72);
  }

  .r2l-step[data-active='true'],
  .r2l-step[data-state='active'] {
    border-color: rgb(212 166 78 / 0.5);
    color: rgb(212 166 78);
  }

  .r2l-step[data-done='true'],
  .r2l-step[data-state='done'] {
    border-color: rgb(74 222 128 / 0.55);
    color: rgb(74 222 128);
  }

  .r2l-step[data-state='locked'] {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .r2l-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(245 230 211 / 0.15);
    transition: background 300ms ease, transform 300ms ease;
  }

  .r2l-dot[data-state='done'] {
    background: rgb(74 222 128);
  }

  .r2l-dot[data-state='active'] {
    background: rgb(212 166 78);
    transform: scale(1.3);
  }

  .r2l-dot[data-state='locked'] {
    background: rgb(245 230 211 / 0.15);
  }

  .r2l-story-dock {
    border-bottom: 1px solid rgb(245 230 211 / 0.1);
    background: rgb(245 230 211 / 0.03);
    transition: max-height 300ms ease;
  }

  .r2l-story-dock [data-highlight='true'] {
    background: rgb(212 166 78 / 0.2);
    border-radius: 4px;
    padding: 0 4px;
  }

  .r2l-activity {
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.12);
    background: rgb(245 230 211 / 0.04);
    padding: 1.25rem;
  }

  .r2l-activity-head h2 {
    margin-top: 0.25rem;
    font-family: Manrope, Inter, sans-serif;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 800;
    color: rgb(245 230 211);
  }

  .r2l-activity-head p {
    color: rgb(245 230 211 / 0.72);
  }

  .r2l-identity {
    font-weight: 800;
    color: rgb(212 166 78) !important;
  }

  .r2l-option,
  .r2l-token,
  .r2l-sentence {
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.14);
    background: rgb(10 14 26 / 0.45);
    padding: 0.75rem 0.9rem;
    text-align: left;
    color: rgb(245 230 211);
  }

  .r2l-option[data-state='correct'],
  .r2l-token[data-picked='true'],
  .r2l-sentence:hover {
    border-color: rgb(74 222 128 / 0.7);
    background: rgb(74 222 128 / 0.14);
  }

  .r2l-option[data-state='retry'] {
    border-color: rgb(212 166 78 / 0.75);
    background: rgb(212 166 78 / 0.14);
  }

  .r2l-option[data-state='revealed'] {
    border-color: rgb(74 222 128 / 0.5);
    background: rgb(74 222 128 / 0.1);
    opacity: 0.85;
  }

  .r2l-order-slots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    gap: 0.5rem;
  }

  .r2l-order-slot {
    min-height: 48px;
    border-radius: 8px;
    border: 1px dashed rgb(245 230 211 / 0.24);
    background: rgb(245 230 211 / 0.05);
    padding: 0.7rem 0.8rem;
    text-align: center;
    font-weight: 700;
    color: rgb(245 230 211 / 0.82);
  }

  .r2l-order-slot[data-filled='true'] {
    border-style: solid;
    border-color: rgb(74 222 128 / 0.52);
    background: rgb(74 222 128 / 0.12);
    color: rgb(245 230 211);
  }

  .r2l-order-slot[data-drop-active='true'] {
    border-color: rgb(212 166 78 / 0.85);
    background: rgb(212 166 78 / 0.14);
  }

  .r2l-order-slot[data-correct='true'] {
    border-color: rgb(74 222 128 / 0.85);
    background: rgb(74 222 128 / 0.18);
  }

  .r2l-order-slot[data-misplaced='true'] {
    border-color: rgb(239 68 68 / 0.7);
    background: rgb(239 68 68 / 0.12);
    animation: pulse-hint 0.6s ease-in-out;
  }

  [data-order-card][data-dictation-locked='true'] .r2l-order-slots,
  [data-order-card][data-dictation-locked='true'] [data-order-tokens] {
    opacity: 0.45;
  }

  [data-order-card][data-dictation-locked='true'] .r2l-order-slot,
  [data-order-card][data-dictation-locked='true'] .r2l-token {
    cursor: not-allowed;
  }

  @keyframes pulse-hint {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  .r2l-token[hidden] {
    display: none;
  }

  .r2l-rec-row {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .r2l-rec-btn {
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid rgba(245, 239, 224, 0.3);
    background: #0f172a;
    color: #f5efe0;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .r2l-rec-btn:hover {
    background: #1e293b;
  }

  .r2l-rec-start,
  .r2l-rec-play {
    border-color: rgba(16, 185, 129, 0.5);
  }

  .r2l-rec-stop {
    border-color: rgba(239, 68, 68, 0.6);
    background: rgba(127, 29, 29, 0.3);
  }

  .r2l-rec-redo {
    border-color: rgba(245, 158, 11, 0.4);
  }

  .r2l-rec-indicator {
    color: #f87171;
    font-size: 0.85rem;
    animation: r2l-pulse 1.2s infinite;
  }

  @keyframes r2l-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  .r2l-speaking-word {
    display: inline-block;
    margin: 0.15rem 0.25rem 0.15rem 0;
    border-radius: 999px;
    border: 1px solid transparent;
    padding: 0.2rem 0.55rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  button.r2l-speaking-word {
    cursor: pointer;
    min-height: 44px;
  }

  .r2l-speaking-word[data-tone='good'] {
    background: rgb(74 222 128 / 0.18);
    color: rgb(187 247 208);
  }

  .r2l-speaking-word[data-tone='close'] {
    background: rgb(212 166 78 / 0.18);
    color: rgb(253 230 138);
  }

  .r2l-speaking-word[data-tone='miss'] {
    border-color: rgb(239 68 68 / 0.65);
    background: rgb(239 68 68 / 0.28);
    color: #fee2e2;
  }

  .r2l-speaking-word-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-left: 0.25rem;
    vertical-align: middle;
  }

  .r2l-speaking-feedback-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .r2l-replay-rate-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.65rem;
  }

  .r2l-replay-rate {
    min-height: 44px;
    border-radius: 999px;
    border: 1px solid rgb(242 204 126 / 0.45);
    background: rgb(15 23 42 / 0.72);
    padding: 0.25rem 0.7rem;
    color: #f5efe0;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .r2l-wave-panel {
    margin-top: 0.75rem;
    border-radius: 8px;
    border: 1px solid rgb(245 239 224 / 0.12);
    background: rgb(15 23 42 / 0.42);
    padding: 0.75rem;
  }

  .r2l-wave-row {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: center;
  }

  .r2l-wave-row + .r2l-wave-row {
    margin-top: 0.5rem;
  }

  .r2l-wave-label,
  .r2l-wave-status {
    color: rgb(245 239 224 / 0.72);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .r2l-wave-mount {
    min-height: 38px;
  }

  @media (prefers-reduced-motion: reduce) {
    .r2l-rec-indicator {
      animation: none;
    }
  }

  .r2l-minny-hero-wrap {
    display: flex;
    justify-content: center;
    margin: 1rem 0 0.5rem;
  }

  .r2l-minny-hero {
    width: 9rem;
    height: 9rem;
  }

  .r2l-minny-video,
  .r2l-minny-fallback {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .r2l-minny-sentence-en {
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 800;
    line-height: 1.45;
    color: rgb(245 230 211);
  }

  .r2l-minny-sentence-vi {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: rgb(245 230 211 / 0.65);
  }

  .r2l-minny-sentence-card {
