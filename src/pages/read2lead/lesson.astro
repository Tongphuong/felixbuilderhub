      : 'Kéo từng chữ vào ô. Bấm chữ trong ô để lấy ra.';
    root.innerHTML = `
      <div class="mt-5 space-y-5">
        ${(activity.items || [])
          .map(
            (item, itemIndex) => `
              <article class="rounded-md border border-cream/10 bg-navy-950/45 p-4" data-order-card="${itemIndex}">
