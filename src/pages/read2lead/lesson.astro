  function _r2lRecorderHelpMessage(error) {
    if (window.R2LMicCheck?.helpMessage) {
      return window.R2LMicCheck.helpMessage(error);
    }
    if (error && _r2lIsPermissionError(error)) {
      return 'Vui lòng cấp quyền micro cho trình duyệt (Safari/Chrome), rồi tải lại trang nhé.';
    }
    if (error?.name === 'NotFoundError') {
      return 'Không tìm thấy micro trên máy. Con thử tai nghe hoặc kiểm tra cài đặt micro.';
    }
    if (!_r2lHasMicInput()) {
      return 'Thiết bị chưa bật micro hoặc trình duyệt chưa cho phép. Con thử Chrome/Safari mới nhất trên máy tính nhé.';
