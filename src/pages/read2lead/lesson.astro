      return 'Vui lòng cấp quyền micro cho trình duyệt (Safari/Chrome), rồi tải lại trang nhé.';
    }
    if (error?.name === 'NotFoundError') {
      return 'Không tìm thấy micro trên máy. Con thử tai nghe hoặc kiểm tra cài đặt micro.';
    }
    if (!_r2lHasMicInput()) {
