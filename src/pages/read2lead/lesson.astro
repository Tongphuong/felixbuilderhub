  function _r2lApplyMicGate(ready) {
    _r2lMicGateReady = ready;
    const speakShell = qs('[data-activity-shell="listen_and_speak"], [data-activity-shell="echo_challenge"]');
    const retellShell = qs('[data-activity-shell="retell_summary"]');
