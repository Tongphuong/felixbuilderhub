  function bookFinishReader() {
    if (
      state.bookReader.stage === 'summary'
      && !qs('#book-reader-summary')?.classList.contains('hidden')
    ) return;
    state.bookReader.stage = 'summary';
    state.w1Phase = 'result';
    qsa('[data-book-stage-container]').forEach((container) => container.classList.add('hidden'));
    const summary = summarizeBookFlow(bookSubmissionState());
    const content = qs('#book-reader-summary-content');
    if (content) {
      content.innerHTML = `
        <p>Trang đã nghe: <strong>${summary.pages_heard}/${state.bookReader.pages.length}</strong></p>
        <p>Câu hỏi đã trả lời: <strong>${summary.questions_answered}</strong></p>
        <p>Phần đọc đạt: <strong>${summary.chunks_passed}</strong></p>
        <p>Phần đọc bỏ qua: <strong>${summary.chunks_skipped}</strong></p>
        <p>Điểm phát âm trung bình: <strong>${summary.average_pronunciation_score}%</strong></p>
      `;
    }
    qs('#book-reader-summary')?.classList.remove('hidden');
    const status = qs('#book-reader-save-status');
    if (status) status.textContent = 'Minny đang tự động lưu kết quả...';
    saveLessonSession();
    submitLesson();
  }

  function w1EnterActivitiesPhase(resume) {
    state.w1Phase = 'activities';
    qs('#w1-story-phase')?.classList.add('hidden');
    qs('#w1-book-reader-phase')?.classList.add('hidden');
    qs('#w1-legacy-progress')?.classList.remove('hidden');
    qs('#w1-quest-path')?.classList.remove('hidden');
    qs('#global-cta')?.classList.remove('hidden');
