    } catch { /* diagnostics only */ }
  }

  // Short rising "go" beep so a non-reading kid knows the exact moment to speak.
  // Self-contained AudioContext that closes itself — never leaks.
  function _r2lPlayGoBeep() {
    try {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return;
      const ctx = new Ctx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(660, ctx.currentTime);
      osc.frequency.setValueAtTime(880, ctx.currentTime + 0.12);
      gain.gain.setValueAtTime(0.0001, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.25, ctx.currentTime + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.24);
      osc.connect(gain).connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.25);
      osc.onended = () => { ctx.close().catch(() => {}); };
    } catch {
      /* beep is a nice-to-have; never block recording */
    }
  }

  // Soft "tick" each second of the countdown so kids feel the rhythm.
  function _r2lTickBeep() {
    try {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return;
      const ctx = new Ctx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(520, ctx.currentTime);
      gain.gain.setValueAtTime(0.0001, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.12, ctx.currentTime + 0.01);
      gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.12);
      osc.connect(gain).connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.13);
      osc.onended = () => { ctx.close().catch(() => {}); };
    } catch { /* tick is optional */ }
  }

  // ── Big full-screen countdown popup so kids can't miss the "wait → speak" moment ──
  function _r2lEnsureCountdownStyles() {
    if (document.getElementById('r2l-cd-styles')) return;
    const style = document.createElement('style');
    style.id = 'r2l-cd-styles';
    style.textContent =
      '#r2l-mic-countdown{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;background:rgba(6,10,20,.85);backdrop-filter:blur(4px)}' +
      '#r2l-mic-countdown .r2l-cd-card{text-align:center;padding:2rem 1.5rem}' +
      '#r2l-mic-countdown .r2l-cd-title{font-size:1.6rem;font-weight:800;color:#f2cc7e;margin:0 0 .75rem}' +
      '#r2l-mic-countdown .r2l-cd-num{font-size:8.5rem;font-weight:900;line-height:1;color:#fff;text-shadow:0 4px 24px rgba(0,0,0,.4)}' +
      '#r2l-mic-countdown.r2l-cd-go .r2l-cd-num{color:#4ade80}' +
      '#r2l-mic-countdown.r2l-cd-go .r2l-cd-title{color:#4ade80;font-size:2.6rem}' +
      '#r2l-mic-countdown .r2l-cd-sub{margin:.9rem 0 0;font-size:1.15rem;color:rgba(245,230,211,.85)}' +
      '.r2l-cd-pop{animation:r2lCdPop .45s ease-out}' +
      '@keyframes r2lCdPop{0%{transform:scale(.4);opacity:0}45%{transform:scale(1.18);opacity:1}100%{transform:scale(1)}}' +
      '.r2l-rec-meter{display:block;height:10px;margin-top:6px;border-radius:5px;background:rgba(245,230,211,.18);overflow:hidden}' +
      '.r2l-rec-meter-bar{display:block;height:100%;width:0;border-radius:5px;background:#4ade80;transition:width .1s linear}';
    document.head.appendChild(style);
  }

  function _r2lGetCountdownOverlay() {
    let overlay = document.getElementById('r2l-mic-countdown');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'r2l-mic-countdown';
      overlay.setAttribute('aria-hidden', 'true');
      overlay.innerHTML =
        '<div class="r2l-cd-card">' +
        '<p class="r2l-cd-title">Chuẩn bị nói nhé!</p>' +
        '<div class="r2l-cd-num">3</div>' +
        '<p class="r2l-cd-sub">Chờ micro bật xong…</p>' +
        '</div>';
      document.body.appendChild(overlay);
    }
    return overlay;
  }

  function _r2lHideCountdownOverlay() {
    const overlay = document.getElementById('r2l-mic-countdown');
    if (overlay) {
      overlay.style.display = 'none';
      overlay.classList.remove('r2l-cd-go');
    }
  }

  // Counts 3→2→1 in a big popup, then LEAVES it visible. The caller flips it to
  // "NÓI ĐI" via _r2lCountdownGo() at the exact instant recording starts, so the
  // child never speaks before capture begins (the old empty-recording bug).
  async function _r2lRunCountdownOverlay(seconds, isCancelled = () => false) {
    _r2lEnsureCountdownStyles();
    const overlay = _r2lGetCountdownOverlay();
    const numEl = overlay.querySelector('.r2l-cd-num');
    const subEl = overlay.querySelector('.r2l-cd-sub');
    const titleEl = overlay.querySelector('.r2l-cd-title');
    overlay.classList.remove('r2l-cd-go');
    if (titleEl) titleEl.textContent = 'Chuẩn bị nói nhé!';
    overlay.style.display = 'flex';
    for (let n = seconds; n >= 1; n -= 1) {
      if (isCancelled()) { _r2lHideCountdownOverlay(); return; }
      if (numEl) {
        numEl.textContent = String(n);
        numEl.classList.remove('r2l-cd-pop');
        void numEl.offsetWidth;
        numEl.classList.add('r2l-cd-pop');
      }
      if (subEl) subEl.textContent = n === 1 ? 'Sắp tới rồi…' : 'Chưa nói vội nhé';
      _r2lTickBeep();
      await new Promise((r) => window.setTimeout(r, 1000));
    }
  }

  function _r2lCountdownGo() {
    const overlay = document.getElementById('r2l-mic-countdown');
    if (!overlay || overlay.style.display === 'none') return;
    const numEl = overlay.querySelector('.r2l-cd-num');
    const subEl = overlay.querySelector('.r2l-cd-sub');
    const titleEl = overlay.querySelector('.r2l-cd-title');
    overlay.classList.add('r2l-cd-go');
    if (titleEl) titleEl.textContent = 'NÓI ĐI CON! 🔴';
    if (numEl) {
      numEl.textContent = '🎤';
      numEl.classList.remove('r2l-cd-pop');
      void numEl.offsetWidth;
      numEl.classList.add('r2l-cd-pop');
    }
    if (subEl) subEl.textContent = 'Đọc to cả câu nhé!';
    window.setTimeout(_r2lHideCountdownOverlay, 900);
  }

  async function _r2lRunMicWarmup(stream, onMessage, isCancelled = () => false) {
    // ROOT-CAUSE FIX: do NOT create/close an AudioContext here. The mic stream is
    // already open and stays live through the 3s countdown, which warms the audio
    // pipeline naturally (no dropped first syllable). On Windows/Realtek, closing an
    // AudioContext that holds a MediaStreamSource right before MediaRecorder.start()
    // leaves the track feeding SILENCE — the recording uploads (>1.2KB) but Whisper
    // transcribes nothing ("Khong nghe duoc ro"), even though the mic test passed.
    // The mic test never does this prime-then-close, which is why it works.
    await _r2lRunCountdownOverlay(3, isCancelled);
  }

  function _r2lFocusMicHelp(shell) {
    if (window.R2LMicCheck?.focusMicHelpInShell) {
      window.R2LMicCheck.focusMicHelpInShell(shell);
      return;
    }
    const panel = shell?.querySelector?.('[data-r2l-mic-check]');
    if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function _r2lLessonNeedsMic(activities) {
    return (activities || []).some((a) => a?.type === 'listen_and_speak' || a?.type === 'read_aloud');
  }

  function _r2lUpdateMicPrepBanner(activities) {
    const banner = qs('#mic-prep-banner');
    if (!banner) return;
    const dismissed = sessionStorage.getItem('r2l_mic_prep_dismissed') === '1';
    const passed = window.R2LMicCheck?.sessionPassed?.();
    const show = _r2lLessonNeedsMic(activities) && !dismissed && !passed;
    banner.classList.toggle('hidden', !show);
  }

  function _r2lMicIsReady() {
    return _r2lHasMicInput() && _r2lHasMediaRecorder();
  }

  function _r2lCreateMediaRecorder(stream) {
    if (!_r2lHasMediaRecorder()) {
      throw new Error('MediaRecorder unavailable');
    }
    const candidates = [
      'audio/mp4',
      'audio/aac',
      'audio/webm;codecs=opus',
      'audio/webm',
      'audio/ogg;codecs=opus',
    ];
    for (const mimeType of candidates) {
      try {
        if (typeof MediaRecorder.isTypeSupported === 'function' && !MediaRecorder.isTypeSupported(mimeType)) {
          continue;
        }
        const mediaRecorder = new MediaRecorder(stream, { mimeType });
        return { mediaRecorder, mimeType: mediaRecorder.mimeType || mimeType };
      } catch {
        // try next Safari-friendly codec
      }
    }
    const mediaRecorder = new MediaRecorder(stream);
    return { mediaRecorder, mimeType: mediaRecorder.mimeType || 'audio/mp4' };
  }

  // Backward-compatible alias used in tests and legacy checks.
  const _r2lSupportsRecording = _r2lHasRecordingCapability();

  async function _r2lPostSpeakingCheck(blob, expectedText, checkMode = 'read', maxSeconds = 0, telemetry = null) {
    const formData = new FormData();
    const blobType = String(blob?.type || '').toLowerCase();
    const audioName = blobType.includes('mp4') || blobType.includes('m4a') || blobType.includes('aac')
      ? 'audio.mp4'
      : blobType.includes('wav')
        ? 'audio.wav'
        : blobType.includes('ogg')
          ? 'audio.ogg'
          : 'audio.webm';
    formData.append('audio', blob, audioName);
    formData.append('access_code', state.accessCode);
    formData.append('pack_id', state.packId);
    formData.append('expected_text', expectedText);
    formData.append('check_mode', checkMode);
    if (maxSeconds > 0) {
      formData.append('max_seconds', String(maxSeconds));
    }
    if (telemetry && window.R2LRecorder?.appendTelemetry) {
      window.R2LRecorder.appendTelemetry(formData, telemetry);
    }

    const controller = new AbortController();
    const timer = window.setTimeout(() => controller.abort(), _R2L_SPEAK_CHECK_TIMEOUT_MS);
    let response;
    try {
      response = await fetch('/api/read2lead-speaking-check', {
        method: 'POST',
        body: formData,
        signal: controller.signal,
      });
    } catch (err) {
      if (err?.name === 'AbortError') {
        throw new Error('Mạng hơi chậm, Minny chấm chưa kịp. Con bấm Thu lại nhé!');
      }
      throw new Error('Mạng chập chờn. Con thử Thu lại một lần nữa nhé!');
    } finally {
      window.clearTimeout(timer);
    }
    return safeJson(response);
  }

  function _r2lSpeakingWordChips(words, tone) {
    if (!Array.isArray(words) || !words.length) return '';
    return `<span class="r2l-speaking-word-list">${words
      .map((word) => `<span class="r2l-speaking-word" data-tone="${tone}">${escapeHtml(word)}</span>`)
      .join('')}</span>`;
  }

  function _r2lSpeakingWordFeedback(words) {
    if (!Array.isArray(words) || !words.length) return '';
    return `<div class="r2l-speaking-feedback-line" aria-label="Nhận xét từng từ">${words
      .map((item) => {
        const expected = String(item?.expected || '').trim();
        if (!expected) return '';
        const status = item.status === 'exact' ? 'good' : item.status === 'close' ? 'close' : 'miss';
        const label = item.feedback_vi || (status === 'good'
          ? `Con đọc ${expected} rõ rồi.`
          : `Nghe lại từ này: ${expected}.`);
        if (status === 'good') {
          return `<span class="r2l-speaking-word" data-tone="good" aria-label="${escapeHtml(label)}">${escapeHtml(expected)}</span>`;
        }
        return `<button type="button" class="r2l-speaking-word" data-tone="${status}" data-r2l-word-replay="${escapeHtml(expected)}" title="${escapeHtml(label)}" aria-label="Nghe lại từ này. ${escapeHtml(label)}">${escapeHtml(expected)}</button>`;
      })
      .join('')}</div>`;
  }

  function _r2lReplayControlsHtml(nativeAudioUrl) {
    if (!nativeAudioUrl || isRewardSfxUrl(nativeAudioUrl)) return '';
    return `
      <div class="r2l-replay-rate-row" aria-label="Nghe mẫu chậm">
        <button type="button" class="r2l-replay-rate" data-r2l-replay-rate="0.5" data-audio-url="${escapeHtml(nativeAudioUrl)}">0.5x</button>
        <button type="button" class="r2l-replay-rate" data-r2l-replay-rate="0.75" data-audio-url="${escapeHtml(nativeAudioUrl)}">0.75x</button>
        <button type="button" class="r2l-replay-rate" data-r2l-replay-rate="1" data-audio-url="${escapeHtml(nativeAudioUrl)}">1.0x</button>
      </div>
    `;
  }

  function _r2lFormatReadScoreLine(result) {
    const exact = Number(result.exact_count ?? result.correct_count ?? 0);
    const close = Number(result.close_count ?? (Array.isArray(result.words_close) ? result.words_close.length : 0));
    const total = Number(result.total_count || 0);
    const closePart = close > 0 ? `, ${close} gần đúng` : '';
    return `Điểm đọc: <strong class="text-cream">${Number(result.score_percent || 0)}%</strong> (${exact}/${total} từ đúng${closePart})`;
  }

  function _r2lBuildOpenSpeakingFeedbackHtml(result) {
    if (result?.loading) {
      return '<p class="text-sm text-gold">Minny đang nghe con kể truyện...</p>';
    }
    if (!result?.ok) {
      return `<p class="font-semibold text-gold">${escapeHtml(result?.message || 'Chưa chấm được. Con thử thu lại nhé!')}</p>`;
    }
    const matched = Array.isArray(result.words_matched) ? result.words_matched : [];
    const matchedHtml = matched.length
      ? `<p class="mt-2 text-sm text-cream/75"><span class="font-semibold text-cream">Con nhắc tới:</span> ${_r2lSpeakingWordChips(matched, 'good')}</p>`
      : '';
    const transcriptHtml = result.transcript
      ? `<p class="mt-2 text-xs text-cream/55">Minny nghe: “${escapeHtml(result.transcript)}”</p>`
      : '';
    return `
      <p class="font-semibold text-gold">${escapeHtml(result.feedback_vi || '')}</p>
      ${transcriptHtml}
      ${matchedHtml}
    `;
  }

  function _r2lBuildSpeakingFeedbackHtml(result, { compact = false, nativeAudioUrl = '' } = {}) {
    if (result?.warming) {
      return `<p class="text-sm text-gold">${escapeHtml(result.message || 'Micro đã bật — chờ 3 giây rồi mới nói nhé…')}</p>`;
    }
    if (result?.recording) {
      // Meet-style live meter: the child SEES sound entering the mic while
      // recording, so a dead mic is visible instantly instead of after upload.
      return `<p class="r2l-rec-go text-base font-extrabold text-green-300">🟢 ${escapeHtml(result.message || 'Nói đi con! Đọc to cả câu nhé!')}</p>
        <span class="r2l-rec-meter"><span class="r2l-rec-meter-bar" data-rec-meter></span></span>
        <p class="mt-1 text-sm text-gold" data-rec-hint></p>`;
    }
    if (result?.loading) {
      return '<p class="text-sm text-gold">Minny đang nghe và nhận xét bài đọc của con...</p>';
    }
    if (!result?.ok) {
      return `<p class="font-semibold text-gold">${escapeHtml(result?.message || 'Chưa chấm được. Con thử thu lại nhé!')}</p>`;
    }

    const missed = Array.isArray(result.words_missed) ? result.words_missed : [];
    const close = Array.isArray(result.words_close) ? result.words_close : [];
    const exact = Array.isArray(result.words_exact) ? result.words_exact : [];
    const wordFeedback = Array.isArray(result.word_feedback) ? result.word_feedback : [];
    const wordFeedbackHtml = wordFeedback.length ? _r2lSpeakingWordFeedback(wordFeedback) : '';
    const exactHtml = exact.length
      ? `<p class="mt-2 text-sm text-cream/75"><span class="font-semibold text-cream">Từ đúng:</span> ${_r2lSpeakingWordChips(exact, 'good')}</p>`
      : '';
    const missedHtml = missed.length
      ? `<p class="mt-2 text-sm text-cream/75"><span class="font-semibold text-cream">Luyện thêm:</span> ${_r2lSpeakingWordChips(missed, 'miss')}</p>`
      : '';
    const closeHtml = close.length
      ? `<p class="mt-2 text-sm text-cream/75"><span class="font-semibold text-cream">Gần đúng:</span> ${_r2lSpeakingWordChips(close, 'close')}</p>`
      : '';
    const transcriptHtml = result.transcript && !compact
      ? `<p class="mt-2 text-xs text-cream/55">Minny nghe: “${escapeHtml(result.transcript)}”</p>`
      : '';

    return `
      <p class="font-semibold text-gold">${escapeHtml(result.feedback_vi || '')}</p>
      <p class="mt-1 text-sm text-cream/75">${_r2lFormatReadScoreLine(result)}</p>
      ${transcriptHtml}
      ${wordFeedbackHtml || `${exactHtml}${closeHtml}${missedHtml}`}
      ${_r2lReplayControlsHtml(nativeAudioUrl)}
    `;
  }

  function _r2lRenderSpeakFeedback(cardEl, result) {
    const slot = cardEl?.querySelector('[data-speak-feedback]');
    if (!slot) return;
    if (!result) {
      slot.classList.add('hidden');
      slot.innerHTML = '';
      _r2lMountSpeakingQuality(cardEl, null);
      return;
    }
    slot.classList.remove('hidden');
    slot.innerHTML = _r2lBuildSpeakingFeedbackHtml(result, {
      nativeAudioUrl: cardEl?.dataset?.nativeAudioUrl || '',
    });
    _r2lMountSpeakingQuality(cardEl, result);
  }

  function _r2lMountSpeakingQuality(cardEl, result) {
    const panel = cardEl?.querySelector('[data-speak-waveform]');
    if (!panel) return;
    const entry = _r2lRecorderState.perItem.get(cardEl.dataset.itemKey || '');
    const nativeUrl = cardEl.dataset.nativeAudioUrl || '';
    if (!result?.ok || !entry?.blobUrl || !nativeUrl || isRewardSfxUrl(nativeUrl)) {
      panel.classList.add('hidden');
      panel.innerHTML = '';
      return;
    }
    panel.classList.remove('hidden');
    void window.R2LFeedbackVisual?.mountDualWaveform?.({
      container: panel,
      nativeUrl,
      kidUrl: entry.blobUrl,
    });
  }

  async function _r2lScoreSpeakRecording(itemKey, cardEl, blob, telemetry = null) {
    const entry = _r2lRecorderState.perItem.get(itemKey);
    const expectedText = entry?.expectedText || '';
    if (!expectedText || !blob) return;

    const scoringBlob = blob;
    const uploadSeq = entry?.uploadSeq || 0;
    const stuckMessage = 'Mạng hơi chậm, Minny chấm chưa kịp. Con bấm Thu lại nhé!';
    _r2lRenderSpeakFeedback(cardEl, { loading: true });

    const watchdog = window.setTimeout(() => {
      if (!_r2lSpeakUploadActive(itemKey, uploadSeq)) return;
      _r2lResolveSpeakUploadStuck(itemKey, cardEl, telemetry, stuckMessage);
    }, _R2L_SPEAK_CHECK_TIMEOUT_MS + 1500);

    try {
      const payload = await _r2lPostSpeakingCheck(blob, expectedText, 'read', 0, telemetry);
      // The analyser HEARD the child but the server transcribed nothing → the
      // platform audio encoder is producing garbage on this machine. Switch it
      // to the raw-PCM WAV engine permanently (no OS codec in the path).
      if (
        payload && !payload.ok && payload.error === 'transcription_failed'
        && telemetry && telemetry.voiced === true && telemetry.engine === 'mr'
      ) {
        window.R2LRecorder?.useWavEngine?.();
      }
      if (!_r2lSpeakUploadActive(itemKey, uploadSeq)) return;
      const current = _r2lRecorderState.perItem.get(itemKey);
      if (!current || current.blob !== scoringBlob) return;
      const passed = payload?.ok && Number(payload.score_percent || 0) >= _R2L_SPEAKING_PASS_PERCENT;
      _r2lRecorderState.perItem.set(itemKey, {
        ...current,
        failureCount: passed ? 0 : Number(current.failureCount || 0) + 1,
        checkStatus: passed ? 'done' : 'error',
        checkResult: payload,
      });
      _r2lRenderRecorderUi(itemKey, cardEl);
      const friendlyPayload = payload?.ok
        ? payload
        : {
            ...payload,
            message: 'Minny chưa chấm điểm được. Con bấm Thu lại nhé!',
          };
      _r2lRenderSpeakFeedback(cardEl, friendlyPayload);
      if (cardEl?.dataset?.bookChunkId) {
        if (payload?.ok) bookHandleShadowScore(cardEl, payload);
        else bookHandleShadowTechnicalFailure(cardEl);
      }
      if (passed) {
        const heroEl = cardEl.closest('[data-activity-shell]')?.querySelector('[data-minny-hero]');
        _r2lSetMinnyMood(_r2lMinnyMoodForScore(payload.score_percent), heroEl);
        persistSpeakItemResult(activityItemsFromCard(cardEl), itemKey, _r2lRecorderState.perItem.get(itemKey));
      } else if (payload?.ok) {
        const heroEl = cardEl.closest('[data-activity-shell]')?.querySelector('[data-minny-hero]');
        _r2lSetMinnyMood('encourage', heroEl);
        showToast('Minny cần nghe được ít nhất 50%. Con thu lại nhé!');
        const nativeUrl = cardEl?.dataset?.nativeAudioUrl || '';
        if (nativeUrl && !isRewardSfxUrl(nativeUrl)) {
          void window.R2LReplayControl?.playUrl?.(nativeUrl, 0.75);
        }
      }
      _r2lMergeSpeakActivityScores(activityItemsFromCard(cardEl));
      _r2lMaybeOfferSpeakSkip();
    } catch (error) {
      if (!_r2lSpeakUploadActive(itemKey, uploadSeq)) return;
      const current = _r2lRecorderState.perItem.get(itemKey);
      if (!current || current.blob !== scoringBlob) return;
      _r2lRecorderState.perItem.set(itemKey, {
        ...current,
        failureCount: Number(current.failureCount || 0) + 1,
        checkStatus: 'error',
        checkResult: null,
      });
      _r2lRenderRecorderUi(itemKey, cardEl);
      _r2lRenderSpeakFeedback(cardEl, {
        ok: false,
        message: error.message || 'Chưa gửi được bài đọc. Con thử lại nhé!',
      });
      if (cardEl?.dataset?.bookChunkId) bookHandleShadowTechnicalFailure(cardEl);
      _r2lMaybeOfferSpeakSkip();
    } finally {
      window.clearTimeout(watchdog);
      if (_r2lSpeakUploadActive(itemKey, uploadSeq)) {
        const still = _r2lRecorderState.perItem.get(itemKey);
        if (still?.checkStatus === 'uploading') {
          _r2lResolveSpeakUploadStuck(itemKey, cardEl, telemetry, stuckMessage);
        }
      }
    }
  }

  function _r2lSpeakItemKeysForActivity(activity) {
    return (activity?.items || []).map((item, index) => item.id || `ls_${index}`);
  }

  const _R2L_ASR_OUTAGE_MSG = 'Minny chưa chấm điểm được. Con bấm Thu lại nhé!';
  const _R2L_MIC_SKIP_MSG = 'Con đã bỏ qua phần nói vì micro chưa hoạt động. Bài vẫn kết thúc nhưng không nhận thưởng.';

  function _r2lRecordingHadVoice(telemetry) {
    if (!telemetry) return true;
    if (telemetry.voiced === true) return true;
    return typeof telemetry.peak === 'number' && telemetry.peak >= 4;
  }

  function _r2lAsrFailureLooksLikeOutage(payload) {
    if (!payload || payload.ok) return false;
    if (payload.asr_outage === true) return true;
    return ['transcription_failed', 'transcription_timeout', 'internal_error', 'config_error']
      .includes(String(payload.error || ''));
  }

  function _r2lCompleteSpeakActivityOnMicSkip(activity) {
    const activityType = activity?.type;
    if (!activity || !SPEAKING_ACTIVITY_TYPES.has(activityType) || state.completedTypes.has(activityType)) return;
    const itemKeys = _r2lSpeakItemKeysForActivity(activity);
    itemKeys.forEach((itemKey, itemIndex) => {
      const existing = _r2lRecorderState.perItem.get(itemKey) || {};
      if (existing.blobUrl) URL.revokeObjectURL(existing.blobUrl);
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: null,
        chunks: [],
        blob: null,
        blobUrl: null,
        status: 'idle',
        silentAttempts: existing.silentAttempts || 0,
        failureCount: existing.failureCount || 0,
        expectedText: existing.expectedText || activity.items?.[itemIndex]?.text_en || '',
        uploadSeq: _r2lNextSpeakUploadSeq(),
        checkStatus: 'error',
        checkResult: { ok: false, skipped_due_to_mic: true },
      });
      const shell = qs('[data-activity-shell="' + activityType + '"]');
      const cardEl = shell?.querySelector('[data-speak-card="' + itemIndex + '"]');
      if (cardEl) {
        _r2lRenderRecorderUi(itemKey, cardEl);
        _r2lRenderSpeakFeedback(cardEl, { ok: false, message: _R2L_MIC_SKIP_MSG });
      }
    });
    completeActivity(activityType, {
      correct_count: 0,
      total_count: Math.max(itemKeys.length, 1),
      wrong_count: Math.max(itemKeys.length, 1),
      score_percent: 0,
      skipped_due_to_mic: true,
    });
  }

  function _r2lSkipMicSpeakingProgress() {
    const activities = state.lesson?.activities || [];
    const current = activities[state.activityIndex];
    if (SPEAKING_ACTIVITY_TYPES.has(current?.type)) {
      _r2lCompleteSpeakActivityOnMicSkip(current);
      showToast('Mình sang phần tiếp nhé. Phần nói này không nhận thưởng.');
    }
  }

  function _r2lMaybeOfferSpeakSkip() {
    const shouldOffer = Array.from(_r2lRecorderState.perItem.values())
      .some((entry) => Number(entry?.failureCount || entry?.silentAttempts || 0) >= _R2L_SKIP_AFTER_FAILURES);
    document.querySelectorAll('[data-speak-mic-skip]').forEach((btn) => {
      btn.hidden = !shouldOffer;
    });
  }

  function _r2lMergeSpeakActivityScores(activity) {
    if (!activity) return;
    const activityType = activity.type;
    const itemKeys = _r2lSpeakItemKeysForActivity(activity);
    let exactTotal = 0;
    let closeTotal = 0;
    let wordTotal = 0;
    let scoredItems = 0;
    let passedItems = 0;
    itemKeys.forEach((itemKey) => {
      const entry = _r2lRecorderState.perItem.get(itemKey);
      if (entry?.checkResult?.ok) {
        scoredItems += 1;
        exactTotal += Number(entry.checkResult.exact_count ?? entry.checkResult.correct_count ?? 0);
        closeTotal += Number(entry.checkResult.close_count ?? (entry.checkResult.words_close?.length || 0));
        wordTotal += Number(entry.checkResult.total_count || 0);
        if (Number(entry.checkResult.score_percent || 0) >= _R2L_SPEAKING_PASS_PERCENT) {
          passedItems += 1;
        }
      }
    });
    if (!scoredItems) return;
    const weighted = wordTotal > 0
      ? Math.round(((exactTotal + closeTotal * 0.5) / wordTotal) * 100)
      : 0;
    state.activityResults[activityType] = {
      type: activityType,
      attempted: true,
      correct_count: exactTotal,
      total_count: wordTotal,
      wrong_count: Math.max(0, wordTotal - exactTotal),
      score_percent: weighted,
      whisper_scored_items: scoredItems,
      passed_items: passedItems,
    };
    if (passedItems >= itemKeys.length && !state.completedTypes.has(activityType)) {
      completeActivity(activityType, {
        correct_count: exactTotal,
        total_count: wordTotal,
        wrong_count: Math.max(0, wordTotal - exactTotal),
        score_percent: weighted,
        whisper_scored_items: scoredItems,
        passed_items: passedItems,
      });
    }
  }

  function activityItemsFromCard(cardEl) {
    const activityType = cardEl?.closest('[data-activity-shell]')?.dataset.activityShell;
    return (state.lesson?.activities || []).find((activity) => activity.type === activityType) || null;
  }

  function _r2lInitSpeakRecorder(itemKey, cardEl, expectedText) {
    const existing = _r2lRecorderState.perItem.get(itemKey);
    if (!existing) {
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: null,
        chunks: [],
        blob: null,
        blobUrl: null,
        status: 'idle',
        expectedText: expectedText || '',
        failureCount: 0,
        checkStatus: 'idle',
        checkResult: null,
      });
    } else if (expectedText && !existing.expectedText) {
      existing.expectedText = expectedText;
    }
    const latest = _r2lRecorderState.perItem.get(itemKey);
    _r2lRenderRecorderUi(itemKey, cardEl);
    if (latest?.checkResult?.ok) {
      _r2lRenderSpeakFeedback(cardEl, latest.checkResult);
    }
  }

  async function _r2lStartRecording(itemKey, cardEl) {
    if (!_r2lMicGateReady && !window.R2LMicCheck?.sessionPassed?.()) {
      _r2lRenderSpeakFeedback(cardEl, {
        ok: false,
        message: 'Con bấm Kiểm tra micro ở khung phía trên trước nhé.',
      });
      return;
    }
    if (!_r2lHasMicInput()) {
      _r2lRenderSpeakFeedback(cardEl, { ok: false, message: _r2lRecorderHelpMessage() });
      return;
    }
    if (!_r2lHasMediaRecorder()) {
      _r2lRenderSpeakFeedback(cardEl, { ok: false, message: _r2lRecorderHelpMessage() });
      return;
    }
    if (_r2lRecorderState.micPermissionBlocked) {
      _r2lRenderSpeakFeedback(cardEl, { ok: false, message: _r2lRecorderHelpMessage({ name: 'NotAllowedError' }) });
      return;
    }
    const prev = _r2lRecorderState.perItem.get(itemKey);
    if (prev?.blobUrl) URL.revokeObjectURL(prev.blobUrl);
    try {
      const stream = await _r2lOpenMicStream();
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: null,
        chunks: [],
        blob: null,
        blobUrl: null,
        status: 'warming',
        warmupStream: stream,
        warmupCancelled: false,
        expectedText: prev?.expectedText || '',
        checkStatus: 'idle',
        checkResult: null,
      });
      _r2lRenderRecorderUi(itemKey, cardEl);
      _r2lRenderSpeakFeedback(cardEl, {
        warming: true,
        message: 'Nhìn màn hình đếm ngược — chờ chữ “NÓI ĐI” hiện ra rồi mới đọc nhé!',
      });
      await _r2lRunMicWarmup(
        stream,
        () => {},
        () => Boolean(_r2lRecorderState.perItem.get(itemKey)?.warmupCancelled),
      );
      const afterWarmup = _r2lRecorderState.perItem.get(itemKey);
      if (afterWarmup?.warmupCancelled || afterWarmup?.status !== 'warming') {
        _r2lHideCountdownOverlay();
        stream.getTracks().forEach((t) => t.stop());
        return;
      }

      // Verify the track is actually alive before we trust it — Windows hands out
      // muted tracks when another app (Zoom/Zalo) is holding the microphone.
      const trackState = window.R2LRecorder?.trackInfo?.(stream) || { live: true, muted: false, label: '' };
      if (!trackState.live) {
        _r2lHideCountdownOverlay();
        stream.getTracks().forEach((t) => t.stop());
        throw new Error('track_not_live');
      }
      const recorder = _r2lCreateUnifiedRecorder(stream);
      const monitor = await _r2lStartLevelMonitor(stream, cardEl);
      const unwatch = window.R2LRecorder?.watchTrack
        ? window.R2LRecorder.watchTrack(stream, (kind) => {
            const hint = cardEl?.querySelector?.('[data-rec-hint]');
            if (hint) {
              hint.textContent = kind === 'muted'
                ? 'Micro đang bị app khác giữ (Zoom/Zalo?). Ba mẹ tắt app đó rồi con thu lại nhé.'
                : 'Micro vừa bị ngắt. Con kiểm tra tai nghe rồi thu lại nhé.';
            }
          })
        : () => {};
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: null,
        recorderCtl: recorder,
        monitor,
        unwatch,
        stream,
        deviceLabel: trackState.label || '',
        silentAttempts: prev?.silentAttempts || 0,
        failureCount: prev?.failureCount || 0,
        chunks: [],
        blob: null,
        blobUrl: null,
        status: 'recording',
        expectedText: prev?.expectedText || '',
        checkStatus: 'idle',
        checkResult: null,
      });
      try {
        recorder.start();
        _r2lTrackLearningEvent('speak');
      } catch (startError) {
        _r2lHideCountdownOverlay();
        _r2lSafeStopMonitor(monitor);
        try { unwatch(); } catch { /* listener already gone */ }
        stream.getTracks().forEach((t) => t.stop());
        throw startError;
      }
      _r2lRenderRecorderUi(itemKey, cardEl);
      // GO fires the INSTANT capture begins — the big popup flips to "NÓI ĐI",
      // a beep sounds, and the inline banner turns green. Recording is already
      // live, so even a kid who speaks immediately is captured from word one
      // (speaking during warmup = lost audio = the #1 cause of "nói to mà Minny
      // không nghe").
      _r2lCountdownGo();
      _r2lPlayGoBeep();
      _r2lRenderSpeakFeedback(cardEl, { recording: true, message: 'Nói đi con! Đọc to cả câu nhé!' });
    } catch (err) {
      console.warn('[r2l-recorder] Permission denied or error:', err);
      _r2lHideCountdownOverlay();
      if (_r2lIsPermissionError(err)) {
        _r2lRecorderState.micPermissionBlocked = true;
      }
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: null,
        chunks: [],
        blob: null,
        blobUrl: null,
        status: 'denied',
        expectedText: prev?.expectedText || '',
        checkStatus: 'idle',
        checkResult: null,
      });
      _r2lRenderRecorderUi(itemKey, cardEl);
      _r2lRenderSpeakFeedback(cardEl, { ok: false, message: _r2lRecorderHelpMessage(err) });
      if (cardEl?.dataset?.bookChunkId) bookHandleShadowTechnicalFailure(cardEl);
      _r2lFocusMicHelp(cardEl?.closest('[data-activity-shell], #w1-book-reader-phase'));
    }
  }

  function _r2lStopMediaRecorder(mediaRecorder) {
    if (!mediaRecorder || mediaRecorder.state !== 'recording') return;
    try {
      mediaRecorder.requestData();
    } catch {
      /* optional on some browsers */
    }
    mediaRecorder.stop();
  }

  function _r2lStopRecording(itemKey, cardEl) {
    const entry = _r2lRecorderState.perItem.get(itemKey);
    if (entry?.status === 'warming') {
      entry.warmupCancelled = true;
      _r2lHideCountdownOverlay();
      if (entry.warmupStream) {
        entry.warmupStream.getTracks().forEach((t) => t.stop());
      }
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: null,
        chunks: [],
        blob: null,
        blobUrl: null,
        status: 'idle',
        expectedText: entry.expectedText || '',
        checkStatus: 'idle',
        checkResult: null,
      });
      _r2lRenderRecorderUi(itemKey, cardEl);
      _r2lRenderSpeakFeedback(cardEl, null);
      return;
    }
    if (entry?.recorderCtl && entry.status === 'recording') {
      _r2lFinishSpeakRecording(itemKey, cardEl);
    } else if (entry?.mediaRecorder && entry.status === 'recording') {
      _r2lStopMediaRecorder(entry.mediaRecorder);
    }
  }

  async function _r2lFinishSpeakRecording(itemKey, cardEl) {
    const entry = _r2lRecorderState.perItem.get(itemKey);
    if (!entry?.recorderCtl || entry.status !== 'recording') return;
    entry.status = 'stopping';
    const { recorderCtl, monitor, unwatch, stream, deviceLabel } = entry;
    let blob = null;
    try {
      blob = await recorderCtl.stop();
    } catch {
      blob = null;
    }
    _r2lSafeStopMonitor(monitor);
    try { if (unwatch) unwatch(); } catch { /* already removed */ }
    if (stream) stream.getTracks().forEach((t) => t.stop());

    const peak = monitor?.available ? monitor.peak() : -1;
    const voiced = window.R2LRecorder?.recordingLooksVoiced
      ? window.R2LRecorder.recordingLooksVoiced(monitor, blob?.size || 0)
      : (monitor?.available ? monitor.voiced() : true);
    const telemetry = {
      peak,
      voiced,
      engine: recorderCtl.engine || 'mr',
      mimeType: (blob && blob.type) || recorderCtl.mimeType || '',
      deviceLabel: deviceLabel || '',
    };
    const expectedText = entry.expectedText || '';
    const tooShort = !blob || blob.size < _R2L_MIN_SPEECH_BYTES;

    // Silent capture detected ON THIS MACHINE (Meet pattern): no sound ever
    // reached the recording pipeline. Don't upload silence — tell the truth,
    // relax the audio constraints for the next try, and log it for remote
    // diagnosis. Repeated failures reveal an explicit no-reward skip.
    if (!voiced && !tooShort) {
      const silentAttempts = (entry.silentAttempts || 0) + 1;
      window.R2LRecorder?.bumpProfile?.();
      _r2lReportSilentCapture(expectedText, telemetry);
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: null,
        chunks: [],
        blob: null,
        blobUrl: null,
        status: 'idle',
        silentAttempts,
        failureCount: Number(entry.failureCount || 0) + 1,
        expectedText,
        checkStatus: 'error',
        checkResult: null,
      });
      _r2lRenderRecorderUi(itemKey, cardEl);
      _r2lRenderSpeakFeedback(cardEl, {
        ok: false,
        message: 'Micro chưa thu được tiếng. Ba mẹ kiểm tra hướng dẫn rồi con bấm Thu lại nhé!',
      });
      if (cardEl?.dataset?.bookChunkId) bookHandleShadowTechnicalFailure(cardEl);
      _r2lMaybeOfferSpeakSkip();
      return;
    }

    const url = blob ? URL.createObjectURL(blob) : null;
    const uploadSeq = _r2lNextSpeakUploadSeq();
    _r2lRecorderState.perItem.set(itemKey, {
      mediaRecorder: null,
      chunks: [],
      blob,
      blobUrl: url,
      status: tooShort ? 'idle' : 'recorded',
      silentAttempts: 0,
      failureCount: tooShort ? Number(entry.failureCount || 0) + 1 : Number(entry.failureCount || 0),
      expectedText,
      uploadSeq,
      checkStatus: tooShort ? 'error' : 'uploading',
      checkResult: null,
    });
    _r2lRenderRecorderUi(itemKey, cardEl);
    if (!tooShort) {
      _r2lScoreSpeakRecording(itemKey, cardEl, blob, telemetry);
    } else {
      // A header-only blob (stopped too fast) transcribes to nothing — catch it
      // locally instead of sending silence to the server.
      _r2lRenderSpeakFeedback(cardEl, {
        ok: false,
        message: 'Minny chưa nghe rõ. Con bấm 🎤 Con nói, chờ đèn xanh rồi đọc to cả câu nhé!',
      });
      if (cardEl?.dataset?.bookChunkId) bookHandleShadowTechnicalFailure(cardEl);
      _r2lMaybeOfferSpeakSkip();
    }
  }

  function _r2lDiscardRecording(itemKey, cardEl) {
    const entry = _r2lRecorderState.perItem.get(itemKey);
    if (entry?.blobUrl) URL.revokeObjectURL(entry.blobUrl);
    const expectedText = entry?.expectedText || '';
    _r2lRecorderState.perItem.delete(itemKey);
    if (expectedText) {
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: null,
        chunks: [],
        blob: null,
        blobUrl: null,
        status: 'idle',
        failureCount: entry?.failureCount || 0,
        expectedText,
        checkStatus: 'idle',
        checkResult: null,
      });
    }
    _r2lRenderSpeakFeedback(cardEl, null);
    _r2lRenderRecorderUi(itemKey, cardEl);
  }

  function _r2lPlayRecording(itemKey) {
    const entry = _r2lRecorderState.perItem.get(itemKey);
    if (!entry?.blobUrl) return;
    const audio = new Audio(entry.blobUrl);
    audio.play().catch((e) => console.warn('[r2l-recorder] playback failed', e));
  }

  function _r2lCleanupRecorderState() {
    _r2lRecorderState.perItem.forEach((entry) => {
      if (entry.blobUrl) URL.revokeObjectURL(entry.blobUrl);
      _r2lSafeStopMonitor(entry.monitor);
      try { if (entry.unwatch) entry.unwatch(); } catch { /* already removed */ }
      if (entry.stream) entry.stream.getTracks().forEach((t) => t.stop());
      if (entry.warmupStream) entry.warmupStream.getTracks().forEach((t) => t.stop());
    });
    _r2lRecorderState.perItem.clear();
  }

  function _r2lSyncMinnyRecordButton(itemKey, cardEl) {
    const itemIndex = cardEl?.dataset?.speakCard;
    if (itemIndex == null) return;
    const button = cardEl.closest('[data-activity-body]')?.querySelector(`[data-speak-record="${itemIndex}"]`);
    if (!button) return;
    const entry = _r2lRecorderState.perItem.get(itemKey);
    const status = entry?.status || 'idle';
    if (status === 'warming') {
      button.textContent = '⏳ Chờ micro...';
      button.disabled = true;
    } else if (status === 'recording') {
      button.textContent = '⏹ Dừng thu';
      button.disabled = false;
    } else if (entry?.checkStatus === 'uploading') {
      button.textContent = '🎤 Con nói';
      button.disabled = true;
    } else {
      button.textContent = '🎤 Con nói';
      button.disabled = button.dataset.heard !== 'true' || !_r2lMicIsReady();
    }
    bookSyncShadowVisualState(cardEl, status, entry?.checkStatus || 'idle');
  }

  function _r2lRenderRecorderUi(itemKey, cardEl) {
    if (cardEl?.querySelector('[data-speak-record]')) {
      _r2lSyncMinnyRecordButton(itemKey, cardEl);
      return;
    }
    const slot = cardEl.querySelector('[data-recorder-slot]');
    if (!slot) return;
    if (!_r2lHasMicInput()) {
      slot.innerHTML = `<p class="text-sm text-cream/60">${escapeHtml(_r2lRecorderHelpMessage())}</p>`;
      return;
    }
    if (!_r2lHasMediaRecorder()) {
      slot.innerHTML = `<p class="text-sm text-cream/60">${escapeHtml(_r2lRecorderHelpMessage())}</p>`;
      return;
    }
    const entry = _r2lRecorderState.perItem.get(itemKey);
    const status = entry?.status || 'idle';

    if (status === 'denied') {
      slot.innerHTML = `
        <button type="button" class="r2l-rec-btn r2l-rec-start" data-action="start">Thử thu lại</button>
        <p class="text-sm text-cream/60">${escapeHtml(_r2lRecorderHelpMessage({ name: 'NotAllowedError' }))}</p>
      `;
    } else if (status === 'warming') {
      slot.innerHTML = `
        <button type="button" class="r2l-rec-btn r2l-rec-stop" data-action="stop">Hủy</button>
        <span class="r2l-rec-indicator">chờ micro 3 giây...</span>
      `;
    } else if (status === 'recording') {
      slot.innerHTML = `
        <button type="button" class="r2l-rec-btn r2l-rec-stop" data-action="stop">Dừng thu</button>
        <span class="r2l-rec-indicator">đang thu...</span>
      `;
    } else if (status === 'recorded') {
      const checking = entry?.checkStatus === 'uploading';
      slot.innerHTML = `
        <button type="button" class="r2l-rec-btn r2l-rec-play" data-action="play" ${checking ? 'disabled' : ''}>Nghe lại bài thu</button>
        <button type="button" class="r2l-rec-btn r2l-rec-redo" data-action="redo" ${checking ? 'disabled' : ''}>Thu lại</button>
        ${checking ? '<span class="r2l-rec-indicator">đang chấm...</span>' : ''}
      `;
    } else {
      slot.innerHTML = '<button type="button" class="r2l-rec-btn r2l-rec-start" data-action="start">Thu âm</button>';
    }

    slot.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const action = btn.getAttribute('data-action');
        if (action === 'start') {
          if (entry?.status === 'denied') {
            _r2lRecorderState.micPermissionBlocked = false;
          }
          _r2lStartRecording(itemKey, cardEl);
        } else if (action === 'stop') _r2lStopRecording(itemKey, cardEl);
        else if (action === 'play') _r2lPlayRecording(itemKey);
        else if (action === 'redo') _r2lDiscardRecording(itemKey, cardEl);
      });
    });
  }

  window.addEventListener('beforeunload', _r2lCleanupRecorderState);

  /* ----- W11 trivia reveal (after lesson pass) ----- */
  const TRIVIA_REVEAL_MIN_SCORE = 75;
  const _r2lTriviaState = {
    revealed: false,
    pendingRewards: null,
    pendingLevelUp: null,
    pendingRankUp: null,
    pendingRankLadder: null,
  };

  function _r2lMaybeRevealTriviaSecret(scorePercent) {
    const trivia = state.lesson?.story?.trivia_vi;
    const section = qs('#trivia-reveal-section');
    if (!trivia || !section || _r2lTriviaState.revealed || scorePercent < TRIVIA_REVEAL_MIN_SCORE) {
      return false;
    }

    _r2lTriviaState.revealed = true;
    qs('#trivia-reveal-text').textContent = String(trivia);
    const triviaEn = state.lesson?.story?.trivia_en;
    const triviaEnEl = qs('#trivia-reveal-text-en');
    if (triviaEnEl) {
      if (triviaEn) {
        triviaEnEl.textContent = String(triviaEn);
        triviaEnEl.classList.remove('hidden');
      } else {
        triviaEnEl.textContent = '';
        triviaEnEl.classList.add('hidden');
      }
    }

    section.classList.remove('hidden');
    qs('#global-cta')?.classList.add('hidden');
    window.requestAnimationFrame(() => {
      section.dataset.show = 'true';
    });
    window.setTimeout(() => {
      section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 80);
    return true;
  }

  function _r2lShowCompletionAfterTrivia(data) {
    qs('#global-cta')?.classList.add('hidden');
    if (isW1() && !isBookLesson()) w1ShowResultRecap();
    const rewards = _r2lTriviaState.pendingRewards || data.rewards_earned || {};
    const completedWithoutReward = data.completed_without_reward === true;
    qs('#completion-copy').textContent = completedWithoutReward
      ? 'Bài đã kết thúc. Phần nói được bỏ qua nên con không nhận sao hay điểm, nhưng vẫn có thể tạo bài mới.'
      : `Con nhận 🪙 ${rewards.coins || 0} xu và ⭐ ${rewards.xp || 0} XP cho nhiệm vụ này.`;
    qs('#completion-card').classList.remove('hidden');
    if (state.accessCode) {
      qs('#completion-new-pack').href = `/read2lead?code=${encodeURIComponent(state.accessCode)}#form`;
    }
    if (completedWithoutReward) return;
    window.__r2lJuice?.playSynthTone?.('coin', _r2lSfxState.muted);
    window.__r2lJuice?.fireLessonPassConfetti?.();
    window.__r2lJuice?.showXpTicker?.(Number(rewards.xp || 0), '#completion-card');
    if (_r2lTriviaState.pendingLevelUp) {
      window.__r2lJuice?.playSynthTone?.('level-up', _r2lSfxState.muted);
      playSfxSequence([SFX.packComplete, SFX.levelUp], 700);
    } else {
      playSfxSequence([SFX.packComplete, pickVoiceClip()], 600);
    }
    showLevelUp(_r2lTriviaState.pendingLevelUp);
    if (window.__r2lV3?.showRankUp) {
      window.__r2lV3.showRankUp(_r2lTriviaState.pendingRankUp, _r2lTriviaState.pendingRankLadder);
    }
    showReward({ mode: 'celebrate', withVoice: true });
    _r2lTriviaState.pendingRewards = null;
    _r2lTriviaState.pendingLevelUp = null;
    _r2lTriviaState.pendingRankUp = null;
    _r2lTriviaState.pendingRankLadder = null;
  }

  qs('#trivia-reveal-continue')?.addEventListener('click', () => {
    qs('#trivia-reveal-section')?.classList.add('hidden');
