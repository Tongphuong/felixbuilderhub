      });
    }

    root.querySelectorAll('[data-play-fill]').forEach((button) => {
      const item = activity.items[Number(button.dataset.playFill)];
      const url = item?.audio_url || '';
      setLessonPlayButtonState(button, url);
      button.addEventListener('click', () => playAudio(url, button));
    });
    root.querySelectorAll('[data-fill-item]').forEach((button) => {
      button.addEventListener('click', () => {
        const itemIndex = Number(button.dataset.fillItem);
        if (attempted.has(itemIndex)) return;
        const optionIndex = Number(button.dataset.optionIndex);
        const item = activity.items[itemIndex];
        const isCorrect = optionIndex === item.correct_index;
        const questionId = `${activity.type}:${item.id || itemIndex}`;
        if (isCorrect) {
          button.dataset.state = 'correct';
          answered.add(itemIndex);
          attempted.add(itemIndex);
          clearWrongStreak(questionId);
          root.querySelector(`[data-fill-explanation="${itemIndex}"]`)?.classList.remove('hidden');
          if (isW1()) w1RecordQuestionOutcome(activity.type, questionId, 'first_try', 1);
          if (attempted.size < (activity.items || []).length) onItemCorrect();
          buttonStates[itemIndex] = {
            optionIndex,
            state: 'correct',
            explanationShown: true,
            revealedIndex: null,
          };
        } else {
          wrongCount += 1;
          const itemWrongs = (itemWrongCounts.get(itemIndex) || 0) + 1;
          itemWrongCounts.set(itemIndex, itemWrongs);
          onItemWrong(questionId);
          if (isW1()) {
            button.dataset.state = 'wrong-w1';
            button.dataset.disabledW1 = 'true';
            button.classList.add('r2l-w1-shake');
            window.setTimeout(() => button.classList.remove('r2l-w1-shake'), 500);
          } else {
            button.dataset.state = 'retry';
          }
          if (itemWrongs >= MAX_WRONG_PER_ITEM) {
            attempted.add(itemIndex);
            const correctBtn = root.querySelector(`[data-fill-item="${itemIndex}"][data-option-index="${item.correct_index}"]`);
            if (correctBtn) correctBtn.dataset.state = 'revealed';
            if (isW1()) {
              w1McqWrongFeedback(root, itemIndex, 'data-fill-explanation', false);
              w1RecordQuestionOutcome(activity.type, questionId, 'revealed', itemWrongs);
              window.setTimeout(() => {
                if (!attempted.has(itemIndex + 1) && itemIndex + 1 < (activity.items || []).length) {
                  /* auto-advance cue only */
                }
              }, 2500);
            } else {
              root.querySelector(`[data-fill-explanation="${itemIndex}"]`)?.classList.remove('hidden');
            }
            buttonStates[itemIndex] = {
              optionIndex,
              state: 'retry',
              explanationShown: true,
              revealedIndex: item.correct_index,
            };
          } else {
            if (isW1()) {
              w1McqWrongFeedback(root, itemIndex, 'data-fill-explanation', true);
              w1RecordQuestionOutcome(activity.type, questionId, 'second_try', itemWrongs);
            }
            buttonStates[itemIndex] = {
              optionIndex,
              state: isW1() ? 'wrong-w1' : 'retry',
              explanationShown: false,
              revealedIndex: null,
            };
          }
        }
        saveFillBlankProgress();
        checkFillBlankComplete();
      });
    });

    function checkFillBlankComplete() {
      if (attempted.size === (activity.items || []).length) {
        completeActivity(activity.type, {
          correct_count: answered.size,
          total_count: activity.items.length,
          wrong_count: wrongCount,
        });
      }
    }

    if (savedFill && attempted.size === (activity.items || []).length && !state.completedTypes.has(activity.type)) {
      checkFillBlankComplete();
    }
  }

