  /* ----- Minny hero moods (video → PNG fallback) ----- */
  const _r2lMinnyVideoAvailable = new Map();

  function _r2lMinnyAssetBase(mood) {
    const file = ['idle', 'listen', 'celebrate', 'encourage'].includes(mood) ? mood : 'idle';
    return `/assets/minny/minny_${file}`;
  }

  function _r2lShowMinnyPng(mood, heroEl) {
    const img = heroEl?.querySelector('[data-minny-fallback]');
    const video = heroEl?.querySelector('[data-minny-video]');
    if (!img) return;
    img.src = `${_r2lMinnyAssetBase(mood)}.png`;
    img.classList.remove('hidden');
    if (video) video.classList.add('hidden');
  }

  function _r2lSetMinnyMood(mood, heroEl) {
    if (!heroEl) return;
    const video = heroEl.querySelector('[data-minny-video]');
    const img = heroEl.querySelector('[data-minny-fallback]');
    const base = _r2lMinnyAssetBase(mood);
    const cacheKey = `${heroEl.dataset.minnyHero || 'default'}:${mood}`;

    if (!video) {
      _r2lShowMinnyPng(mood, heroEl);
      return;
    }

    if (_r2lMinnyVideoAvailable.get(cacheKey) === false) {
      _r2lShowMinnyPng(mood, heroEl);
      return;
    }

    const tryPlay = (ext) => {
      video.onerror = () => {
        if (ext === 'mp4') {
          video.src = `${base}.webm`;
          video.onerror = () => {
            _r2lMinnyVideoAvailable.set(cacheKey, false);
            _r2lShowMinnyPng(mood, heroEl);
          };
        } else {
          _r2lMinnyVideoAvailable.set(cacheKey, false);
          _r2lShowMinnyPng(mood, heroEl);
        }
      };
      video.onloadeddata = () => {
        _r2lMinnyVideoAvailable.set(cacheKey, true);
        video.classList.remove('hidden');
        if (img) img.classList.add('hidden');
        video.play().catch(() => _r2lShowMinnyPng(mood, heroEl));
      };
      video.poster = `${base}.png`;
      video.src = `${base}.${ext}`;
      video.load();
    };

    tryPlay('mp4');
  }

  function _r2lInitMinnyHero(heroEl) {
    if (!heroEl || heroEl.dataset.minnyReady) return;
    heroEl.dataset.minnyReady = 'true';
    _r2lSetMinnyMood('idle', heroEl);
  }

  function _r2lSpeakLine(text, lang, onEnd) {
    const line = String(text || '').trim();
    if (!line || !window.speechSynthesis) {
      if (typeof onEnd === 'function') onEnd();
      return;
    }
    _r2lTrackLearningEvent('audio');
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(line);
    utterance.lang = lang;
    utterance.rate = lang.startsWith('vi') ? 0.95 : 0.92;
    utterance.onend = () => {
      if (typeof onEnd === 'function') onEnd();
    };
    utterance.onerror = () => {
      if (typeof onEnd === 'function') onEnd();
    };
    window.speechSynthesis.speak(utterance);
  }

  function _r2lSpeakEnglishLine(text, onEnd) {
    _r2lSpeakLine(text, 'en-US', onEnd);
  }

  function _r2lSpeakVietnameseLine(text, onEnd) {
    _r2lSpeakLine(text, 'vi-VN', onEnd);
  }

  function _r2lMinnyMoodForScore(scorePercent) {
    return Number(scorePercent || 0) >= 70 ? 'celebrate' : 'encourage';
  }

  // ── Safe JSON helper: prevents crash on 502/503 HTML responses ──
  async function safeJson(res) {
    const ct = res.headers.get('content-type') || '';
    if (!ct.includes('application/json')) {
      throw new Error('Mạng không ổn định. Con đợi một chút rồi thử lại nhé!');
    }
    try {
      return await res.json();
    } catch {
      throw new Error('Mạng không ổn định. Con đợi một chút rồi thử lại nhé!');
    }
  }

  let submitInFlight = false;
  let _r2lAutoSubmitArmed = false;
  let _r2lAutoSubmitTimer = null;

  // Kids abandoned packs when saving required extra taps after the last
  // activity — the lesson now saves itself, like the book flow already does.
  function _r2lScheduleAutoSubmit(delayMs) {
    if (_r2lAutoSubmitArmed || submitInFlight || isBookLesson()) return;
    _r2lAutoSubmitArmed = true;
    qs('#submit-hint').textContent = 'Minny đang tự động lưu chiến công của con...';
    updateGlobalCta();
    _r2lAutoSubmitTimer = window.setTimeout(() => {
      _r2lAutoSubmitTimer = null;
      submitLesson({ trigger: 'auto' });
    }, delayMs);
  }

  function pendingSubmitKey(code, packId) {
    return `r2l_pending_submit:${code}:${packId}`;
  }

  function savePendingSubmit(payload) {
    try {
      localStorage.setItem(pendingSubmitKey(state.accessCode, state.packId), JSON.stringify(payload));
    } catch {
      // localStorage unavailable — submit still works without backup
    }
  }

  function clearPendingSubmit() {
    try {
      localStorage.removeItem(pendingSubmitKey(state.accessCode, state.packId));
    } catch {
      // ignore
    }
  }

  function loadPendingSubmit() {
    try {
      const raw = localStorage.getItem(pendingSubmitKey(state.accessCode, state.packId));
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  const LESSON_SESSION_VERSION = 2;
  let _r2lSaveSessionTimer = null;

  function lessonSessionKey(code, packId) {
    return `r2l_lesson_session:${code}:${packId}`;
  }

  function lessonSessionSnapshot() {
    return {
      schema_version: LESSON_SESSION_VERSION,
      saved_at: new Date().toISOString(),
      activity_index: state.activityIndex,
      completed_types: Array.from(state.completedTypes),
      activity_results: state.activityResults,
      activity_progress: state.activityProgress,
      ...(isW1() ? {
        w1_phase: state.w1Phase,
        w1_max_unlocked: state.w1MaxUnlocked,
        w1_midpoint_celebrated: state.w1MidpointCelebrated,
        story_gate: state.storyGate,
        guided_listening: state.guidedListening,
        book_reader: state.bookReader,
        question_outcomes: state.questionOutcomes,
      } : {}),
    };
  }

  function sendCheckpointToServer() {
    if (!state.accessCode || !state.packId || !state.lesson) return;
    let payload;
    try {
      payload = JSON.stringify({
        access_code: state.accessCode,
        pack_id: state.packId,
        snapshot: lessonSessionSnapshot(),
      });
    } catch {
      return;
    }
    try {
      if (navigator.sendBeacon) {
        const blob = new Blob([payload], { type: 'application/json' });
        navigator.sendBeacon('/api/read2lead-checkpoint-save', blob);
        return;
      }
    } catch {
      // fall through to fetch
    }
    try {
      fetch('/api/read2lead-checkpoint-save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: payload,
        keepalive: true,
      }).catch(() => {});
    } catch {
      // best-effort only -- never block the unload path
    }
  }

  function saveLessonSession() {
    if (!state.accessCode || !state.packId || !state.lesson) return;
    const key = lessonSessionKey(state.accessCode, state.packId);
    let serialized;
    try {
      serialized = JSON.stringify(lessonSessionSnapshot());
    } catch {
      return;
    }
    try {
      localStorage.setItem(key, serialized);
    } catch {
      // Durable storage can be disabled or full.
    }
    try {
      sessionStorage.setItem(key, serialized);
    } catch {
      // Keep the lesson usable when browser storage is unavailable.
    }
  }

  function scheduleSaveLessonSession() {
    if (_r2lSaveSessionTimer) window.clearTimeout(_r2lSaveSessionTimer);
    _r2lSaveSessionTimer = window.setTimeout(() => {
      _r2lSaveSessionTimer = null;
      saveLessonSession();
    }, 250);
  }

  function parseLessonSession(raw) {
    if (!raw) return null;
    try {
      const parsed = JSON.parse(raw);
      if (parsed?.schema_version !== 1 && parsed?.schema_version !== LESSON_SESSION_VERSION) return null;
      return parsed;
    } catch {
      return null;
    }
  }

  function loadLessonSession() {
    const key = lessonSessionKey(state.accessCode, state.packId);
    let durableRaw = null;
    let sessionRaw = null;
    try { durableRaw = localStorage.getItem(key); } catch {}
    try { sessionRaw = sessionStorage.getItem(key); } catch {}

    const durable = parseLessonSession(durableRaw);
    if (durable) return durable;
    const session = parseLessonSession(sessionRaw);
    if (session) {
      try {
        localStorage.setItem(key, sessionRaw);
      } catch {
        // Best-effort migration; the session snapshot can still be restored.
      }
      return session;
    }

    // Both browser storages are empty (private/incognito mode, in-app
    // WebView storage wipe, OS eviction, new device/browser) -- fall back
    // to the server-side checkpoint that rode along on this page's initial
    // lesson fetch.
    const serverCheckpoint = state.lesson?.web_session_checkpoint?.snapshot;
    if (!serverCheckpoint) return null;
    let serialized;
    try {
      serialized = JSON.stringify(serverCheckpoint);
    } catch {
      return null;
    }
    const parsedServer = parseLessonSession(serialized);
    if (!parsedServer) return null;
    try { localStorage.setItem(key, serialized); } catch {}
    try { sessionStorage.setItem(key, serialized); } catch {}
    return parsedServer;
  }

  function clearLessonSession() {
    const key = lessonSessionKey(state.accessCode, state.packId);
    try { localStorage.removeItem(key); } catch {}
    try { sessionStorage.removeItem(key); } catch {}
  }

  function restoreLessonSession() {
    const saved = loadLessonSession();
    if (!saved) return false;
    const activities = state.lesson?.activities || [];
    const activityTypes = new Set(activities.map((activity) => activity?.type).filter(Boolean));
    state.completedTypes = new Set(
      (saved.completed_types || []).filter((type) => activityTypes.has(type)),
    );
    state.activityResults = Object.fromEntries(
      Object.entries(saved.activity_results || {}).filter(([type]) => (
        type === 'guided_listening' || activityTypes.has(type)
      )),
    );
    state.activityProgress = Object.fromEntries(
      Object.entries(saved.activity_progress || {}).filter(([type]) => activityTypes.has(type)),
    );
    let index = Number(saved.activity_index);
    if (!Number.isFinite(index)) index = 0;
    const currentType = activities[index]?.type;
    if (currentType && state.completedTypes.has(currentType)) {
      const nextIncomplete = activities.findIndex((activity) => !state.completedTypes.has(activity?.type));
      index = nextIncomplete >= 0 ? nextIncomplete : index;
    }
    state.activityIndex = Math.max(0, Math.min(index, Math.max(0, activities.length - 1)));
    if (isW1()) {
      state.w1Phase = saved.w1_phase === 'activities' || saved.w1_phase === 'result' || saved.w1_phase === 'guided_listening' || saved.w1_phase === 'book_reader' ? saved.w1_phase : 'story';
      state.w1MaxUnlocked = Number.isFinite(Number(saved.w1_max_unlocked))
        ? Math.max(0, Number(saved.w1_max_unlocked))
        : Math.max(0, state.completedTypes.size - 1);
      state.w1MidpointCelebrated = Boolean(saved.w1_midpoint_celebrated);
      if (saved.story_gate && typeof saved.story_gate === 'object') {
        state.storyGate = {
          read_done: Boolean(saved.story_gate.read_done),
          listen_done: Boolean(saved.story_gate.listen_done),
          paragraphs_played: Array.isArray(saved.story_gate.paragraphs_played)
            ? saved.story_gate.paragraphs_played.slice()
            : [],
          card_index: Number(saved.story_gate.card_index) || 0,
        };
      }
      state.questionOutcomes = saved.question_outcomes || {};
      if (state.storyGate.read_done && state.storyGate.listen_done) {
        state.w1Phase = state.w1Phase === 'story' ? 'guided_listening' : state.w1Phase;
      }
      // Restore guided listening state
      if (saved.guided_listening && typeof saved.guided_listening === 'object') {
        const gl = saved.guided_listening;
        const storySentences = (state.lesson?.story?.sentences || []).filter((sentence) => String(sentence?.text_en || sentence?.text || '').trim());
        const paragraphStarts = [];
        storySentences.forEach((sentence, sentenceIndex) => {
          const paragraphIndex = Number(sentence?.paragraph_index) || 0;
          if (!Number.isFinite(paragraphStarts[paragraphIndex])) paragraphStarts[paragraphIndex] = sentenceIndex;
        });
        const isSentenceProgress = gl.progressVersion === 2 || Number.isFinite(Number(gl.sentenceIndex));
        const legacyParagraphIndex = Number(gl.paragraphIndex ?? gl.paragraph_index ?? 0) || 0;
        const sentenceIndex = isSentenceProgress
          ? (Number(gl.sentenceIndex) || 0)
          : (paragraphStarts[legacyParagraphIndex] ?? legacyParagraphIndex);
        state.guidedListening = {
          progressVersion: 2,
          phase: gl.phase || (gl.sentencesDone?.every(Boolean) ? 'done' : 'idle'),
          sentenceIndex,
          sentencePlayed: isSentenceProgress && Array.isArray(gl.sentencePlayed) ? gl.sentencePlayed.slice() : [],
          sentencesDone: isSentenceProgress && Array.isArray(gl.sentencesDone) ? gl.sentencesDone.slice() : [],
          answers: gl.answers || {},
        };
      }
      if (saved.book_reader && typeof saved.book_reader === 'object') {
        const book = saved.book_reader;
        if (Number(book.flowVersion) === 2) {
          state.bookReader = {
            flowVersion: 2,
            pageIndex: Number(book.pageIndex) || 0,
            stage: ['story', 'listen', 'questions', 'shadow', 'next', 'summary'].includes(book.stage)
              ? (book.stage === 'listen' ? 'story' : book.stage)
              : 'story',
            story_completed: Boolean(book.story_completed),
            questionIndex: Math.max(0, Number(book.questionIndex) || 0),
            chunkIndex: Math.max(0, Number(book.chunkIndex) || 0),
            pages: Array.isArray(book.pages) ? book.pages : [],
          };
        } else {
          const completedAudio = Array.isArray(book.audioCompleted) ? book.audioCompleted : [];
          state.bookReader = {
            flowVersion: 2,
            pageIndex: Math.max(0, Number(book.pageIndex) || 0),
            stage: completedAudio.every(Boolean) && completedAudio.length ? 'questions' : 'story',
            story_completed: completedAudio.every(Boolean) && completedAudio.length > 0,
            questionIndex: 0,
            chunkIndex: 0,
            pages: completedAudio.map((audioCompleted, pageIndex) => ({
              page_index: pageIndex,
              audio_completed: Boolean(audioCompleted),
              selected_questions: [],
              question_results: [],
              shadow_chunks: [],
            })),
          };
        }
      }
    }
    return true;
  }

  function patchActivityProgress(type, patch) {
    state.activityProgress[type] = {
      ...(state.activityProgress[type] || {}),
      ...patch,
    };
    scheduleSaveLessonSession();
  }

  function markSpeakHeard(activity, itemIndex) {
    const activityType = activity.type;
    const progress = state.activityProgress[activityType] || { heard: [], items: {} };
    const heard = Array.isArray(progress.heard) ? progress.heard.slice() : [];
    if (!heard.includes(itemIndex)) heard.push(itemIndex);
    patchActivityProgress(activityType, { heard, items: progress.items || {} });
  }

  function persistSpeakItemResult(activity, itemKey, entry) {
    const activityType = activity?.type;
    if (!activityType) return;
    const progress = state.activityProgress[activityType] || { heard: [], items: {} };
    const items = { ...(progress.items || {}) };
    if (entry?.checkResult?.ok) {
      items[itemKey] = {
        checkStatus: entry.checkStatus,
        checkResult: entry.checkResult,
        expectedText: entry.expectedText || '',
      };
    } else {
      delete items[itemKey];
    }
    patchActivityProgress(activityType, {
      heard: progress.heard || [],
      items,
    });
  }

  function restoreSpeakActivityProgress(root, activity) {
    const saved = state.activityProgress[activity.type];
    if (!saved) return;
    (saved.heard || []).forEach((itemIndex) => {
      const recordBtn = root.querySelector('[data-speak-record="' + itemIndex + '"]');
      if (recordBtn) {
        recordBtn.dataset.heard = 'true';
        recordBtn.disabled = !_r2lMicIsReady();
