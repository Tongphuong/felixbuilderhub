  function _r2lBuildSpeedRoundPool(lesson) {
    const pool = [];
    (lesson?.activities || []).forEach((act) => {
      if (act.type === 'story_discovery') {
        (act.items || []).forEach((item, i) => pool.push({ type: 'micro_check', source: act.type, item, index: i }));
      } else if (act.type === 'vocab_blitz') {
        (act.items || []).forEach((item, i) => pool.push({ type: 'vocab', source: act.type, item, index: i }));
      } else if (act.type === 'listen_and_fill') {
        (act.items || []).forEach((item, i) => pool.push({ type: 'fill', source: act.type, item, index: i }));
      } else if (act.type === 'story_detective') {
        (act.questions || []).forEach((item, i) => pool.push({ type: 'detective', source: act.type, item, index: i }));
      }
    });
    for (let i = pool.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    const level = String(lesson?.level || 'L3');
    const maxItems = level === 'L1' || level === 'L2' ? 8 : 10;
    return pool.slice(0, maxItems);
  }

  function _r2lSpeedTimerMs(level) {
    const map = { L1: 10000, L2: 8000, L3: 6000, L4: 5000, L5: 4000 };
    return map[level] || 6000;
  }

  function renderSpeedRoundActivity(root, activity) {
    const lesson = state.lesson;
    const level = String(lesson?.level || 'L3');
    const items = _r2lBuildSpeedRoundPool(lesson);
    activity.items = items;
    let idx = 0;
    let correct = 0;
    let comboStreak = 0;
    let maxCombo = 0;
    const timerMs = _r2lSpeedTimerMs(level);

    function multiplier() {
      if (comboStreak >= 8) return 5;
      if (comboStreak >= 5) return 3;
      if (comboStreak >= 3) return 2;
      return 1;
    }

    function renderSpeedItem() {
      const entry = items[idx];
      if (!entry) {
        const stats = { correct, total: items.length, combo_max: maxCombo };
        _r2lSetPhaseStars(activity.type, correct, items.length);
        _r2lEndPhase(activity.type, stats);
        root.innerHTML = `
          <div class="mt-5 rounded-md border border-gold/30 bg-gold/10 p-5 text-center">
            <p class="font-display text-xl font-bold text-gold">Hết giờ tấn công!</p>
            <p class="mt-2 text-cream">Đúng ${correct}/${items.length} · Combo cao nhất x${maxCombo}</p>
          </div>
        `;
        completeActivity(activity.type, { correct_count: correct, total_count: items.length, combo_max: maxCombo });
        return;
      }
      const meta = root.closest('[data-activity-shell]')?.querySelector('[data-speed-round-meta]');
      if (meta) meta.textContent = `Câu ${idx + 1}/${items.length} · x${multiplier()}`;
      let prompt = '';
      let options = [];
      let correctIndex = 0;
      if (entry.type === 'micro_check') {
        prompt = entry.item.micro_check?.prompt_vi || entry.item.text_en || '';
        options = entry.item.micro_check?.options || [];
        correctIndex = entry.item.micro_check?.correct_index ?? 0;
      } else if (entry.type === 'vocab') {
        prompt = entry.item.word_en || '';
        options = entry.item.options_vi || entry.item.options_en || [];
        correctIndex = entry.item.correct_index ?? 0;
      } else if (entry.type === 'fill') {
        prompt = entry.item.display_text || entry.item.sentence_with_blank || '';
        options = entry.item.options || entry.item.options_en || [];
        correctIndex = entry.item.correct_index ?? 0;
      } else if (entry.type === 'detective') {
        prompt = entry.item.question_en || '';
        options = (entry.item.options || []).map((o) => (typeof o === 'string' ? o : o.text_en));
        correctIndex = entry.item.correct_index ?? 0;
      }
      root.innerHTML = `
        <article class="mt-5 rounded-md border border-cream/10 bg-navy-950/45 p-4">
          <div class="r2l-speed-timer-bar" style="--r2l-speed-ms:${timerMs}ms"><span></span></div>
          <p class="mt-3 font-bold text-cream">${escapeHtml(prompt)}</p>
          <div class="mt-3 grid gap-2" data-speed-opts></div>
        </article>
      `;
      const bar = root.querySelector('.r2l-speed-timer-bar');
      window.setTimeout(() => { if (bar) bar.dataset.urgent = 'true'; }, Math.max(0, timerMs - 2000));
      const wrap = root.querySelector('[data-speed-opts]');
      let answered = false;
      const timeout = window.setTimeout(() => {
        if (answered) return;
        answered = true;
        comboStreak = 0;
        _r2lRecordAnswer(false);
        idx += 1;
        renderSpeedItem();
      }, timerMs);
      options.forEach((opt, oi) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'r2l-option min-h-[44px]';
        btn.textContent = String(opt);
        btn.addEventListener('click', () => {
          if (answered) return;
          answered = true;
          clearTimeout(timeout);
          const isCorrect = oi === correctIndex;
          if (isCorrect) {
            correct += 1;
            comboStreak += 1;
            maxCombo = Math.max(maxCombo, comboStreak);
            btn.dataset.state = 'correct';
            _r2lRecordAnswer(true);
            window.__r2lV21Audio?.playFx?.('speed_tick');
            if (multiplier() >= 5) {
              window.__r2lV21Fx?.fireCoinRain?.();
              window.__r2lV21Fx?.shakeScreen?.('heavy');
            }
          } else {
            comboStreak = 0;
            btn.dataset.state = 'wrong';
            _r2lRecordAnswer(false);
          }
          window.setTimeout(() => {
            idx += 1;
            renderSpeedItem();
          }, 350);
        });
        wrap?.appendChild(btn);
      });
    }
    renderSpeedItem();
  }

  async function _r2lAwaitStoryAudio(url) {
    return new Promise((resolve, reject) => {
      if (!url) { resolve(); return; }
      const audio = new Audio(url);
      audio.onended = () => resolve();
      audio.onerror = () => reject(new Error('audio'));
      audio.play().catch(reject);
    });
  }

