  function w1RenderQuestPath() {
    const el = qs('[data-r2l-quest-path]');
    if (!el || !isW1()) return;
    const activities = state.lesson?.activities || [];
    el.innerHTML = activities.map((activity, index) => {
      const type = activity?.type;
      let nodeState = 'locked';
      if (type && state.completedTypes.has(type)) nodeState = 'done';
      else if (index === state.activityIndex) nodeState = 'current';
      else if (index <= state.w1MaxUnlocked) nodeState = 'current';
      const icon = nodeState === 'done' ? '✅' : nodeState === 'locked' ? '🔒' : (W1_QUEST_ICONS[type] || '▶');
      const label = ACTIVITY_LABELS[type] || `Phần ${index + 1}`;
      return `
        <li class="r2l-kid-quest-path__node r2l-kid-quest-path__node--${nodeState}" data-r2l-quest-index="${index}">
          <button type="button" class="r2l-kid-quest-path__btn" ${nodeState === 'locked' ? 'disabled' : ''} aria-label="${escapeHtml(label)}">
            <span class="r2l-kid-quest-path__icon">${icon}</span>
            <span class="r2l-kid-quest-path__label">${escapeHtml(label)}</span>
          </button>
        </li>
      `;
    }).join('');
    el.querySelectorAll('.r2l-kid-quest-path__btn:not([disabled])').forEach((btn) => {
      btn.addEventListener('click', () => {
        const li = btn.closest('[data-r2l-quest-index]');
        const index = Number(li?.getAttribute('data-r2l-quest-index'));
        if (!Number.isNaN(index)) showActivity(index);
