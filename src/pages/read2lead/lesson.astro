  // ── Toast: non-destructive error (does NOT hide lesson) ──
  function showToast(message, durationMs = 4000) {
    let toast = qs('#r2l-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'r2l-toast';
      toast.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);z-index:9999;max-width:90vw;padding:12px 20px;border-radius:8px;background:#b45309;color:#fff;font-size:14px;font-weight:600;text-align:center;opacity:0;transition:opacity 0.3s;pointer-events:none;';
      document.body.appendChild(toast);
    }
    toast.textContent = message;
    toast.style.opacity = '1';
    clearTimeout(toast._hideTimer);
    toast._hideTimer = setTimeout(() => { toast.style.opacity = '0'; }, durationMs);
  }

  init();

  async function init() {
    const params = new URLSearchParams(window.location.search);

    state.accessCode = (params.get('code') || '').trim().toUpperCase();
    state.packId = (params.get('pack_id') || '').trim();
    if (!state.accessCode || !state.packId) {
      showError('Thiếu mã học sinh hoặc mã bài. Anh Phương mở lại từ link bài học nhé.');
      return;
    }

    const FETCH_TIMEOUT_MS = 15000;
    // Cloudflare KV eventual consistency: right after the generator mints a
    // brand-new pack_id and returns lesson_link, this read can briefly hit
    // stale KV and answer 404 `pack_not_found` or 409 `generation_in_progress`
    // for a few seconds until the write propagates. Those two are TRANSIENT
    // "not ready yet" states — poll them with gentle backoff up to a hard cap
    // instead of failing. A pack that is already ready returns 200 on the first
    // try and renders with ZERO added latency. Genuine errors (410 legacy,
    // code_not_found, 5xx, …) surface immediately.
    const POLL_DEADLINE_MS = Date.now() + 90000; // hard cap ~90s — never loops forever
    const POLL_MAX_WAIT_MS = 6000;
    let pollWait = 1800;
    let transientWaits = 0;
    let lastError = '';

    for (;;) {
      let retryable = false;
      try {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);
        const res = await fetch(
          `/api/read2lead-lesson?code=${encodeURIComponent(state.accessCode)}&pack_id=${encodeURIComponent(state.packId)}`,
          { signal: controller.signal },
        );
        clearTimeout(timer);
        const data = await safeJson(res);

        if (res.ok && data.ok) {
          // V2.1 flag gate: when a pack reports schema_version "2.1" but
          // PUBLIC_R2L_V21 is off, show the maintenance screen instead of
          // attempting the (not-yet-shipped) V2.1 UI. Infra-only — no V2.1 render.
          if (
            String(data.lesson?.schema_version ?? '') === '2.1'
            && document.getElementById('main')?.dataset.r2lV21Ssr !== '1'
          ) {
            qs('#loading-card')?.classList.add('hidden');
            qs('#error-card')?.classList.add('hidden');
            qs('#lesson-shell')?.classList.add('hidden');
            const maintenance = qs('#v21-maintenance');
            if (maintenance) maintenance.hidden = false;
            return;
          }
          if (data.lesson?.schema_version !== 2) {
            showError('Bài này vẫn là format cũ. V2 lesson chỉ nhận pack schema_version = 2.');
            return;
          }
          renderLesson(data.lesson);
          return;
        }

        // Transient KV race: this pack's write is not yet visible to the read.
        const notReady =
          (res.status === 404 && data.error === 'pack_not_found')
          || (res.status === 409 && data.error === 'generation_in_progress');
        if (notReady) {
          retryable = true;
          lastError = data.message || 'Bài đang được chuẩn bị. Con đợi một chút nhé.';
        } else {
          // Genuine, terminal error — surface immediately.
          showError(data.message || data.error || 'Không tải được bài.');
          return;
        }
      } catch (error) {
        console.warn('[r2l-lesson] load attempt failed', error);
        // Network / timeout — also transient; keep retrying within the budget.
        retryable = true;
        lastError = error.name === 'AbortError'
          ? 'Mạng hơi chậm. Đang thử lại...'
          : (error.message || 'Có lỗi khi mở bài học.');
      }

      if (!retryable || Date.now() + pollWait >= POLL_DEADLINE_MS) {
        showError(lastError || 'Có lỗi khi mở bài học.');
        return;
      }

      transientWaits += 1;
      const loadingMsg = qs('#loading-message');
      if (loadingMsg) {
        loadingMsg.textContent = transientWaits >= 3
          ? 'Minny đang hoàn tất bài cho con…'
          : 'Minny đang mở nhiệm vụ cho con...';
      }
      await new Promise((r) => setTimeout(r, pollWait));
      pollWait = Math.min(Math.round(pollWait * 1.4), POLL_MAX_WAIT_MS);
    }
  }

  qs('#error-retry')?.addEventListener('click', () => {
    qs('#error-card')?.classList.add('hidden');
    qs('#loading-card')?.classList.remove('hidden');
    const loadingMsg = qs('#loading-message');
    if (loadingMsg) loadingMsg.textContent = 'Minny đang mở nhiệm vụ cho con...';
    init();
  });

  function setStoryAudioButtonState(button, audioUrl) {
    if (audioUrl) {
      button.textContent = 'Nghe cả truyện';
      button.disabled = false;
      return;
    }
    button.textContent = 'Chưa có audio';
    button.disabled = true;
  }

  async function pollDeferredFullStoryAudio(button) {
    button.textContent = 'Đang tạo audio truyện...';
    button.disabled = true;
    const maxAttempts = 12;
    const intervalMs = 3000;
    for (let attempt = 0; attempt < maxAttempts; attempt += 1) {
      await new Promise((resolve) => window.setTimeout(resolve, intervalMs));
      try {
        const res = await fetch(
          `/api/read2lead-lesson?code=${encodeURIComponent(state.accessCode)}&pack_id=${encodeURIComponent(state.packId)}`,
        );
        const data = await safeJson(res);
        const mergedUrl = data.lesson?.story?.full_audio_url || '';
        if (res.ok && data.ok && mergedUrl) {
          state.lesson.story.full_audio_url = mergedUrl;
          setStoryAudioButtonState(button, mergedUrl);
          return;
        }
      } catch {
        // keep polling until attempts exhausted
      }
    }
    setStoryAudioButtonState(button, '');
  }

  function ensureLessonActivities(lesson) {
    const activities = Array.isArray(lesson?.activities) ? lesson.activities : [];
    const activityOrder = isBookLesson(lesson)
      ? BOOK_ACTIVITY_ORDER
      : FRONTEND_ACTIVITY_ORDER;
    const activityByType = new Map(
      activities
        .filter((activity) => activityOrder.includes(activity?.type))
        .map((activity) => [activity.type, activity]),
    );
    lesson.activities = activityOrder
      .map((type) => activityByType.get(type))
      .filter(Boolean);
    return lesson;
  }


  function w1StoryHasAnyAudio(story) {
    if (!story) return false;
    if (story.full_audio_url) return true;
    return (story.sentences || []).some((sentence) => Boolean(sentence?.audio_url));
  }

  function w1GateComplete() {
    return Boolean(state.storyGate.read_done && state.storyGate.listen_done);
  }

  function w1UpdateGateChips() {
    const readChip = qs('#w1-chip-read');
    const listenChip = qs('#w1-chip-listen');
    if (readChip) readChip.dataset.done = String(state.storyGate.read_done);
    if (listenChip) listenChip.dataset.done = String(state.storyGate.listen_done);
    const openBtn = qs('#w1-open-quests');
    if (openBtn) openBtn.disabled = !w1GateComplete();
  }

  function w1MarkParagraphPlayed(paragraphIndex) {
    const played = state.storyGate.paragraphs_played || [];
    if (!played.includes(paragraphIndex)) {
      played.push(paragraphIndex);
      state.storyGate.paragraphs_played = played;
    }
    const totalParagraphs = (state.lesson?.story?.paragraphs_en || []).length;
    const allPlayed = totalParagraphs > 0 && played.length >= totalParagraphs;
    if (allPlayed) state.storyGate.listen_done = true;
    w1UpdateGateChips();
    scheduleSaveLessonSession();
  }

  function w1CheckListenAutoPass(story) {
    if (!w1StoryHasAnyAudio(story)) {
      state.storyGate.listen_done = true;
      w1UpdateGateChips();
    }
  }

  function w1RenderStoryCard() {
    const story = state.lesson?.story || {};
    const paragraphs = story.paragraphs_en || [];
    const idx = Math.max(0, Math.min(state.storyGate.card_index || 0, Math.max(0, paragraphs.length - 1)));
    state.storyGate.card_index = idx;
    const host = qs('#w1-story-cards');
    if (!host) return;
    if (!paragraphs.length) {
      host.innerHTML = '<p class="text-cream/70">Chưa có truyện trong bài này.</p>';
      return;
    }
    const text = paragraphs[idx] || '';
    host.innerHTML = `
      <article class="r2l-w1-story-card" data-w1-card-index="${idx}">
        <p class="text-xs font-bold uppercase tracking-wide text-gold/80">Trang ${idx + 1}/${paragraphs.length}</p>
        <p class="mt-3" id="w1-card-text">${escapeHtml(text)}</p>
      </article>
    `;
    const prev = qs('#w1-story-prev');
    const next = qs('#w1-story-next');
    if (prev) prev.classList.toggle('hidden', idx <= 0);
    if (next) next.textContent = idx >= paragraphs.length - 1 ? 'Đọc xong trang này ✓' : 'Tiếp →';
  }

  function w1MarkReadProgressFromCard() {
    const paragraphs = state.lesson?.story?.paragraphs_en || [];
    const idx = state.storyGate.card_index || 0;
    if (idx >= paragraphs.length - 1) {
      state.storyGate.read_done = true;
      w1UpdateGateChips();
      scheduleSaveLessonSession();
    }
  }

  function w1OpenStoryPanel() {
    const dock = qs('#story-dock');
    if (dock?.dataset.dockState === 'collapsed') toggleDock();
    dock?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  let _w1StoryPhaseBound = false;

  function w1InitStoryPhase() {
    w1CheckListenAutoPass(state.lesson?.story || {});
    w1RenderStoryCard();
    w1UpdateGateChips();
    qs('#w1-story-phase')?.classList.remove('hidden');
    qs('#w1-legacy-progress')?.classList.add('hidden');
    qsa('[data-activity-shell]').forEach((shell) => { shell.hidden = true; });
    qs('#global-cta')?.classList.add('hidden');
    if (_w1StoryPhaseBound) return;
    _w1StoryPhaseBound = true;
    qs('#w1-story-prev')?.addEventListener('click', () => {
      state.storyGate.card_index = Math.max(0, (state.storyGate.card_index || 0) - 1);
      w1RenderStoryCard();
      scheduleSaveLessonSession();
    });
    qs('#w1-story-next')?.addEventListener('click', () => {
      const paragraphs = state.lesson?.story?.paragraphs_en || [];
      const idx = state.storyGate.card_index || 0;
      if (idx < paragraphs.length - 1) {
        state.storyGate.card_index = idx + 1;
        w1RenderStoryCard();
      } else {
        w1MarkReadProgressFromCard();
      }
      scheduleSaveLessonSession();
    });
    qs('#w1-open-quests')?.addEventListener('click', () => {
      if (!w1GateComplete()) {
        showToast('Con đọc và nghe hết truyện đã nhé!');
        return;
      }
      w1EnterGuidedListeningPhase();
    });
    qs('#w1-read-along')?.addEventListener('click', () => w1ToggleReadAlong());
  }

  async function w1PlaySentenceAt(index) {
    const sentences = state.lesson?.story?.sentences || [];
    const sentence = sentences[index];
    if (!sentence) return;
    const paragraphIndex = Number(sentence.paragraph_index) || 0;
    state.storyGate.card_index = paragraphIndex;
    w1RenderStoryCard();
    const cardText = qs('#w1-card-text');
    if (cardText && sentence.text_en) {
      const plain = cardText.textContent || '';
      const pos = plain.indexOf(sentence.text_en);
      if (pos >= 0) {
        const before = plain.slice(0, pos);
        const match = plain.slice(pos, pos + sentence.text_en.length);
        const after = plain.slice(pos + sentence.text_en.length);
        cardText.innerHTML = `${escapeHtml(before)}<span class="r2l-w1-karaoke">${escapeHtml(match)}</span>${escapeHtml(after)}`;
      }
    }
    const url = sentence.audio_url || '';
    if (url) {
      await new Promise((resolve) => {
        const audio = new Audio(url);
        audio.addEventListener('ended', resolve, { once: true });
        audio.addEventListener('error', resolve, { once: true });
        audio.play().catch(resolve);
      });
    }
    w1MarkParagraphPlayed(paragraphIndex);
  }

  async function w1RunReadAlong() {
    const sentences = state.lesson?.story?.sentences || [];
    if (!sentences.length) return;
    _w1ReadAlong.running = true;
    _w1ReadAlong.paused = false;
    for (let i = _w1ReadAlong.sentenceIdx; i < sentences.length; i += 1) {
      if (!_w1ReadAlong.running || _w1ReadAlong.paused) break;
      _w1ReadAlong.sentenceIdx = i;
      await w1PlaySentenceAt(i);
    }
    if (_w1ReadAlong.running && !_w1ReadAlong.paused) {
      state.storyGate.read_done = true;
      state.storyGate.listen_done = true;
      const paragraphs = state.lesson?.story?.paragraphs_en || [];
      state.storyGate.card_index = Math.max(0, paragraphs.length - 1);
      w1RenderStoryCard();
      w1UpdateGateChips();
      scheduleSaveLessonSession();
      _w1ReadAlong.running = false;
    }
  }

  function w1ToggleReadAlong() {
    const btn = qs('#w1-read-along');
    if (_w1ReadAlong.running && !_w1ReadAlong.paused) {
      _w1ReadAlong.paused = true;
      _w1ReadAlong.running = false;
      if (btn) btn.textContent = '▶ Đọc cùng Minny';
      return;
    }
    if (btn) btn.textContent = '⏸ Tạm dừng';
    w1RunReadAlong();
  }


  let _bookReaderBound = false;
  let _bookAudioUiState = 'idle';
  let _bookAudioPageIndex = -1;
  let _bookShowTranslations = false;
  let _bookVocabOpen = false;
  let _bookListenAgainCount = 0;
  let _bookListenAgainSlow = false;
  let _bookTranslationUsedPages = new Set();
  let _bookStageLeaveTimer = null;
  let _bookPageTurnTimer = null;
  let _bookMeterObserver = null;

  function bookPageSentences(pageIndex = state.bookReader.pageIndex) {
    return (state.lesson?.story?.sentences || [])
      .map((sentence, sentenceIndex) => ({ ...sentence, sentenceIndex }))
      .filter((sentence) => Number(sentence.paragraph_index) === Number(pageIndex));
  }

  function bookPageLabel(pageIndex) {
    const generatedPage = state.lesson?.pages?.[pageIndex] || state.lesson?.book_pages?.[pageIndex] || {};
    return String(generatedPage.title_vi || `Trang ${pageIndex + 1}`);
  }

  function bookPageIsComplete(page) {
    if (!page?.audio_completed) return false;
    const questionsDone = (page.selected_questions || []).length === 0
      || (page.question_results || []).filter((result) => result?.correct === true).length >= page.selected_questions.length;
    const readsDone = (page.page_reads || []).every((read) => read.status === 'passed' || read.status === 'skipped');
    return questionsDone && readsDone;
  }

  function bookFormatTime(value) {
    const seconds = Math.max(0, Number.isFinite(Number(value)) ? Math.floor(Number(value)) : 0);
    return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
  }

  function bookRenderStoryText() {
    const pageIndex = state.bookReader.pageIndex;
    const root = qs('#book-reader-page-text');
    const sentences = bookPageSentences(pageIndex);
    if (root) {
      if (sentences.length) {
        root.innerHTML = sentences.map((sentence, localIndex) => `
          <span class="r2l-book-sentence" data-book-sentence-index="${localIndex}">${escapeHtml(sentence.text_en || '')}</span>${_bookShowTranslations && sentence.text_vi
            ? `<span class="r2l-book-sentence-translation">${escapeHtml(sentence.text_vi)}</span>`
            : ' '}
        `).join('');
      } else {
        root.textContent = state.lesson?.story?.paragraphs_en?.[pageIndex] || '';
      }
    }

    const translate = qs('#book-reader-translate');
    if (translate) {
      translate.setAttribute('aria-expanded', String(_bookShowTranslations));
      translate.textContent = _bookShowTranslations ? '▣ Ẩn bản dịch' : '▣ Dịch từng câu';
    }
    const translationPanel = qs('#book-reader-translation-panel');
    const hasTranslations = sentences.some((sentence) => Boolean(sentence.text_vi));
    if (translationPanel) {
      translationPanel.classList.toggle('hidden', !_bookShowTranslations || hasTranslations);
      translationPanel.textContent = _bookShowTranslations && !hasTranslations
        ? 'Trang này chưa có bản dịch tiếng Việt riêng.'
        : '';
    }
  }

  function bookPageVocabulary(pageIndex = state.bookReader.pageIndex) {
    const pageVocab = state.lesson?.pages?.[pageIndex]?.vocab
      || state.lesson?.book_pages?.[pageIndex]?.vocab
      || [];
    const lessonVocab = state.lesson?.vocabulary || state.lesson?.vocab || [];
    return [...(Array.isArray(pageVocab) ? pageVocab : []), ...(Array.isArray(lessonVocab) ? lessonVocab : [])]
      .filter((item) => item && (item.paragraph_index == null || Number(item.paragraph_index) === Number(pageIndex)));
  }

  function bookRenderVocabPanel() {
    const panel = qs('#book-reader-vocab-panel');
    const button = qs('#book-reader-vocab');
    if (!panel || !button) return;
    button.setAttribute('aria-expanded', String(_bookVocabOpen));
    panel.classList.toggle('hidden', !_bookVocabOpen);
    if (!_bookVocabOpen) return;
    const words = bookPageVocabulary();
    const sentences = bookPageSentences();
    if (!words.length) {
      panel.innerHTML = '<p>Trang này chưa có danh sách từ khó riêng. Con có thể bấm “🔊 Nghe lại” để nghe Minny đọc lại.</p>';
      return;
    }
    panel.innerHTML = words.map((item) => {
      const word = item.word_en || item.word || item.text_en || '';
      const vi = item.meaning_vi || item.translation_vi || item.text_vi || '';
      const contextSentence = sentences.find(s =>
        (s.text_en || '').toLowerCase().includes(word.toLowerCase())
      );
      return `<div class=”r2l-vocab-card”>
        <strong class=”r2l-vocab-word”>${escapeHtml(word)}</strong>
        ${contextSentence ? `<p class=”r2l-vocab-context”>”${escapeHtml(contextSentence.text_en)}”</p>` : ''}
        ${vi ? `<p class=”r2l-vocab-vi”>${escapeHtml(vi)}</p>` : ''}
      </div>`;
    }).join('');
  }

  function bookCheckAutoEncourage() {
    if (_bookListenAgainCount >= 2 && _bookTranslationUsedPages.has(state.bookReader.pageIndex)) {
      setMinnyStrip('celebrate', 'Con cố gắng giỏi lắm! Thử sang trang tiếp nhé!');
    }
  }

  function bookSetActiveSentence(localIndex, { completed = false } = {}) {
    const sentences = bookPageSentences();
    const safeIndex = sentences.length
      ? Math.max(0, Math.min(Number(localIndex) || 0, sentences.length - 1))
      : 0;
    qsa('[data-book-sentence-index]').forEach((sentence) => {
      sentence.dataset.active = String(Number(sentence.dataset.bookSentenceIndex) === safeIndex);
    });
    const karaoke = qs('#book-reader-karaoke-text');
    const excerpt = qs('#book-reader-audio-excerpt');
    const text = sentences[safeIndex]?.text_en || state.lesson?.story?.paragraphs_en?.[state.bookReader.pageIndex] || '';
    if (karaoke) {
      karaoke.textContent = text || 'Bấm nghe để Minny bắt đầu đọc.';
      karaoke.dataset.active = String(Boolean(text));
    }
    if (excerpt) excerpt.textContent = text ? `“${text}”` : '';
    if (completed && sentences.length) {
      qsa('[data-book-sentence-index]').forEach((sentence) => {
        sentence.dataset.active = String(Number(sentence.dataset.bookSentenceIndex) === sentences.length - 1);
      });
    }
  }

  function bookSetAudioUiState(nextState) {
    _bookAudioUiState = nextState;
    const gate = qs('#book-reader-audio-gate');
    const button = qs('#book-reader-listen-btn');
    if (gate) gate.dataset.audioState = nextState;
    if (button) {
      const playing = nextState === 'playing';
      button.setAttribute('aria-pressed', String(playing));
      button.setAttribute('aria-label', playing ? 'Tạm dừng Minny đọc' : nextState === 'paused' ? 'Tiếp tục nghe Minny đọc' : 'Nghe Minny đọc trang');
    }
  }

  function bookResetAudioUi(page = bookPageState()) {
    const finished = Boolean(page?.audio_completed);
    bookSetAudioUiState(finished ? 'done' : 'idle');
    const progress = qs('#book-reader-audio-progress');
    if (progress) progress.style.width = finished ? '100%' : '0%';
    const current = qs('#book-reader-audio-current');
    if (current) current.textContent = '0:00';
    const duration = qs('#book-reader-audio-duration');
    if (duration) duration.textContent = '0:00';
    bookSetActiveSentence(finished ? Math.max(0, bookPageSentences().length - 1) : 0, { completed: finished });
  }

  function bookSyncAudioProgress(audio, pageIndex) {
    if (!audio || pageIndex !== state.bookReader.pageIndex) return;
    const duration = Number(audio.duration) || 0;
    const currentTime = Number(audio.currentTime) || 0;
    const ratio = duration > 0 ? Math.max(0, Math.min(1, currentTime / duration)) : 0;
    const progress = qs('#book-reader-audio-progress');
    if (progress) progress.style.width = `${Math.round(ratio * 100)}%`;
    const current = qs('#book-reader-audio-current');
    if (current) current.textContent = bookFormatTime(currentTime);
    const total = qs('#book-reader-audio-duration');
    if (total) total.textContent = bookFormatTime(duration);
    const sentences = bookPageSentences(pageIndex);
    const activeIndex = sentences.length ? Math.min(sentences.length - 1, Math.floor(ratio * sentences.length)) : 0;
    bookSetActiveSentence(activeIndex);
  }

  function bookAnimatePageTurn(updatePage) {
    const shell = qs('#book-reader-page-shell');
    if (!shell || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      updatePage();
      return;
    }
    if (_bookPageTurnTimer) window.clearTimeout(_bookPageTurnTimer);
    shell.classList.remove('is-entering');
    shell.classList.add('is-turning');
    _bookPageTurnTimer = window.setTimeout(() => {
      updatePage();
      shell.classList.remove('is-turning');
      void shell.offsetWidth;
      shell.classList.add('is-entering');
      window.setTimeout(() => shell.classList.remove('is-entering'), 440);
      _bookPageTurnTimer = null;
    }, 560);
  }

  function bookSyncStageUi(stage) {
    const reader = qs('#w1-book-reader-phase');
    if (reader) reader.dataset.bookStage = stage;
    const stageOrder = { story: 0, questions: 1, shadow: 2, next: 3 };
    const current = stageOrder[stage] ?? 0;
    qsa('[data-book-step]').forEach((step, index) => {
      step.dataset.state = index < current ? 'completed' : index === current ? 'active' : 'upcoming';
    });
  }

  function bookSyncShadowVisualState(card, status = 'idle', checkStatus = 'idle') {
    if (!card?.dataset?.bookChunkId) return;
    const visualState = checkStatus === 'uploading' ? 'checking' : status;
    card.dataset.recState = visualState;
    const heading = card.querySelector('[data-book-rec-heading]');
    const hint = card.querySelector('[data-book-rec-hint]');
    if (heading) {
      heading.textContent = visualState === 'warming'
        ? 'Minny đang đếm ngược…'
        : visualState === 'recording'
          ? 'Minny đang nghe con đọc…'
          : visualState === 'checking'
            ? 'Minny đang lắng nghe…'
            : 'Bấm để bắt đầu đọc';
    }
    if (hint) {
      hint.textContent = visualState === 'recording'
        ? 'Bấm dừng khi con đọc xong.'
        : visualState === 'checking'
          ? 'Minny đang kiểm tra bài đọc của con.'
          : 'Bấm 🎤 rồi đọc to cho Minny nghe nhé.';
    }
  }

  function bookObserveRecordMeter(card) {
    if (_bookMeterObserver) _bookMeterObserver.disconnect();
    const meter = card?.querySelector('[data-rec-meter]');
    if (!meter || typeof MutationObserver === 'undefined') return;
    const update = () => {
      const level = Math.max(5, Math.min(100, Number.parseFloat(meter.style.width) || 5));
      meter.style.height = `${level}%`;
      const bars = card.querySelectorAll('.r2l-book-shadow-wave i');
      bars.forEach((bar, index) => {
        const factor = 0.45 + ((index * 7) % 10) / 18;
        bar.style.height = `${Math.max(7, Math.round(level * factor * 0.42))}px`;
      });
    };
    _bookMeterObserver = new MutationObserver(update);
    _bookMeterObserver.observe(meter, { attributes: true, attributeFilter: ['style'] });
    update();
  }

  function bookHandleKeyboard(event) {
    const reader = qs('#w1-book-reader-phase');
    if (!reader || reader.classList.contains('hidden') || event.altKey || event.ctrlKey || event.metaKey) return;
    const target = event.target;
    if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || target?.isContentEditable) return;
    const key = String(event.key || '').toLowerCase();
    if (key === ' ' && state.bookReader.stage === 'story') {
      event.preventDefault();
      bookPlayPageAudio();
    } else if (key === 'r') {
      event.preventDefault();
      bookPlayPageAudio({ restart: true });
    } else if (/^[1-4]$/.test(key) && state.bookReader.stage === 'questions') {
      const option = qs(`#book-reader-question-options button:nth-child(${Number(key)})`);
      option?.click();
    } else if (key === 'enter') {
      const next = state.bookReader.stage === 'story' ? qs('#book-reader-story-next') : state.bookReader.stage === 'next' ? qs('#book-reader-next') : null;
      if (next && !next.disabled) {
        event.preventDefault();
        next.click();
      }
    } else if (key === 'm' && state.bookReader.stage === 'shadow') {
      event.preventDefault();
      qs('#book-reader-shadow-body [data-speak-record]')?.click();
    }
  }

  function bookPageState(pageIndex = state.bookReader.pageIndex) {
    return state.bookReader.pages[pageIndex] || null;
  }

  function bookPracticeStageForPage(page = bookPageState()) {
    if (!page) return 'summary';
    if (!page.audio_completed) return 'story';
    if (page.question_results.length < page.selected_questions.length) {
      state.bookReader.questionIndex = page.question_results.length;
      return 'questions';
    }
    const pendingRead = page.page_reads.findIndex((read) => read.status === 'pending');
    if (pendingRead >= 0) {
      state.bookReader.chunkIndex = pendingRead;
      return 'shadow';
    }
    return 'next';
  }

  function bookInitializeState() {
    const resumeSummary = state.bookReader.stage === 'summary';
    const totalPages = state.lesson.book_images.length;
    const sentences = state.lesson?.story?.sentences || [];
    const savedPages = Array.isArray(state.bookReader.pages) ? state.bookReader.pages : [];
    state.bookReader.pages = Array.from({ length: totalPages }, (_, pageIndex) => {
      const saved = savedPages[pageIndex] || {};
      const selectedQuestions = selectBookQuestions(
        state.lesson.guided_listening,
        sentences,
        pageIndex,
        BOOK_QUESTION_LIMIT_V3,
      );
      const questionResults = selectedQuestions
        .map((question) => (Array.isArray(saved.question_results) ? saved.question_results : [])
          .find((result) => String(result?.question_id || '') === question.id))
        .filter((result) => Boolean(result?.correct));
      // v2 snapshots carried shadow_chunks; their per-chunk progress is dropped
      // on purpose (the page-read units are new work, and a kid resuming from a
      // v2 checkpoint only ever gets LESS required speaking, never more).
      const savedReads = Array.isArray(saved.page_reads) ? saved.page_reads : [];
      const pageReads = buildBookPageReads(sentences, pageIndex).map((read) => {
        const previous = savedReads.find((savedRead) => savedRead?.read_id === read.read_id) || {};
        return {
          ...read,
          attempts: Math.max(0, Number(previous.attempts) || 0),
          technical_failures: Math.max(0, Number(previous.technical_failures) || 0),
          status: ['passed', 'skipped'].includes(previous.status) ? previous.status : 'pending',
          score_percent: Number.isFinite(Number(previous.score_percent))
            ? Number(previous.score_percent)
            : 0,
          ...(previous.latest_feedback ? { latest_feedback: previous.latest_feedback } : {}),
          ...(previous.technical_skip === true ? { technical_skip: true } : {}),
        };
      });
      return {
        page_index: pageIndex,
        audio_completed: Boolean(saved.audio_completed),
        selected_questions: selectedQuestions,
        question_results: questionResults,
        page_reads: pageReads,
      };
    });
    // Page-by-page loop: resume at the first page with unfinished work, in
    // whatever stage that page is at (listen, questions, or read-aloud).
    const firstIncomplete = state.bookReader.pages.findIndex((bookPage) => !bookPageIsComplete(bookPage));
    state.bookReader.pageIndex = firstIncomplete >= 0 ? firstIncomplete : Math.max(0, totalPages - 1);
    state.bookReader.stage = bookPracticeStageForPage(bookPageState());
    state.bookReader.story_completed = state.bookReader.pages.length > 0
      && state.bookReader.pages.every((bookPage) => bookPage.audio_completed === true);
    if (resumeSummary && firstIncomplete < 0) {
      state.bookReader.stage = 'summary';
    }
  }

  function w1InitBookReaderPhase() {
    state.w1Phase = 'book_reader';
    qs('#w1-story-phase')?.classList.add('hidden');
    qs('#w1-guided-listening-phase')?.classList.add('hidden');
    qs('#w1-book-reader-phase')?.classList.remove('hidden');
    qs('#w1-quest-path')?.classList.add('hidden');
    qs('#w1-legacy-progress')?.classList.add('hidden');
    qs('#global-cta')?.classList.add('hidden');
    qsa('[data-activity-shell]').forEach((shell) => { shell.hidden = true; });

    bookInitializeState();
    bookRenderAttribution();
    bookShowPage();
    _r2lMountMicCheck(qs('#w1-book-reader-phase'), 0, false);

    if (_bookReaderBound) return;
    _bookReaderBound = true;
    qs('#book-reader-listen-btn')?.addEventListener('click', bookPlayPageAudio);
    qs('#book-reader-story-next')?.addEventListener('click', bookGoToNextStoryPage);
    qs('#book-reader-next')?.addEventListener('click', () => {
      if (state.bookReader.stage !== 'next') return;
      stopLessonAudio();
      // Advance to the FIRST page with unfinished work, not blindly to
      // pageIndex + 1 — after a trail revisit of a completed page, +1 would
      // walk the kid through every already-done page one tap at a time
      // (Buffet review finding, 2026-07-12). All pages done -> finish.
      const firstIncomplete = state.bookReader.pages.findIndex((page) => !bookPageIsComplete(page));
      if (firstIncomplete < 0) {
        bookFinishReader();
        return;
      }
      bookAnimatePageTurn(() => {
        state.bookReader.questionIndex = 0;
        state.bookReader.chunkIndex = 0;
        bookResumeFrontier();
        bookShowPage();
        scheduleSaveLessonSession();
      });
    });
    qs('#book-reader-listen-again')?.addEventListener('click', () => {
      _bookListenAgainCount += 1;
      _bookListenAgainSlow = _bookListenAgainCount > 1;
      bookPlayPageAudio({ restart: true, slow: _bookListenAgainSlow });
      setMinnyStrip('encourage', _bookListenAgainSlow
        ? 'Chậm hơn cho con nghe rõ!'
        : 'Nghe lần nữa nhé!');
      bookCheckAutoEncourage();
    });
    qs('#book-reader-translate')?.addEventListener('click', () => {
      _bookShowTranslations = !_bookShowTranslations;
      bookRenderStoryText();
      if (_bookShowTranslations && !_bookTranslationUsedPages.has(state.bookReader.pageIndex)) {
        _bookTranslationUsedPages.add(state.bookReader.pageIndex);
        setMinnyStrip('encourage', 'Không sao, xem tiếng Việt cũng tốt! Sau đó thử nghe lại nhé.');
      }
      bookCheckAutoEncourage();
    });
    qs('#book-reader-vocab')?.addEventListener('click', () => {
      _bookVocabOpen = !_bookVocabOpen;
      bookRenderVocabPanel();
    });
    qs('#book-reader-question-retry')?.addEventListener('click', bookRenderQuestion);
    qs('#book-reader-art-prev')?.addEventListener('click', () => {
      if (state.bookReader.stage !== 'story' || state.bookReader.pageIndex <= 0) return;
      stopLessonAudio();
      bookAnimatePageTurn(() => {
        state.bookReader.pageIndex -= 1;
        state.bookReader.stage = 'story';
        bookShowPage();
      });
    });
    qs('#book-reader-art-next')?.addEventListener('click', bookGoToNextStoryPage);
    qs('#book-reader-technical-skip')?.addEventListener('click', bookSkipCurrentChunkForTechnicalFailure);
    document.addEventListener('keydown', bookHandleKeyboard);
  }

  function bookShowPage() {
    const pageIndex = state.bookReader.pageIndex;
    const total = state.lesson.book_images.length;
    const counter = qs('#book-reader-page-counter');
    if (counter) counter.textContent = 'Trang ' + (pageIndex + 1) + ' / ' + total;
    const title = qs('#book-reader-title');
    if (title) title.textContent = state.lesson?.story?.title || 'Đọc truyện tranh';
    const meta = qs('#book-reader-trail-meta');
    if (meta) meta.textContent = `${total} trang · khoảng ${Math.max(4, total * 2 + 2)} phút`;
    const pageBadge = qs('#book-reader-page-badge');
    if (pageBadge) pageBadge.textContent = `Trang ${pageIndex + 1}`;
    const credit = qs('#book-reader-art-credit');
    if (credit) {
      const attribution = state.lesson?.book_attribution || {};
      credit.textContent = attribution.publisher ? `Minh hoạ · ${attribution.publisher}` : 'Minh hoạ truyện';
    }
    const image = qs('#book-reader-img');
    const imageUrl = state.lesson.book_images[pageIndex] || '';
    if (image) {
      image.src = imageUrl;
      image.alt = 'Minh họa trang ' + (pageIndex + 1) + ' của truyện ' + (state.lesson.story?.title || '');
    }
    const art = qs('.r2l-book-page__art');
    if (art) art.style.setProperty('--book-art-image', imageUrl ? `url("${encodeURI(imageUrl).replaceAll('"', '%22')}")` : 'none');
    bookRenderStoryText();
    _bookVocabOpen = false;
    _bookListenAgainCount = 0;
    _bookListenAgainSlow = false;
    bookRenderVocabPanel();
    const page = bookPageState(pageIndex);
    const status = qs('#book-reader-audio-status');
    if (status) status.textContent = page?.audio_completed
      ? 'Con đã nghe xong trang này.'
      : 'Nghe xong, con trả lời câu hỏi rồi đọc lại trang này nhé.';
    _bookAudioPageIndex = pageIndex;
    bookResetAudioUi(page);
    const previous = qs('#book-reader-art-prev');
    if (previous) previous.disabled = state.bookReader.stage !== 'story' || pageIndex <= 0;
    const nextArt = qs('#book-reader-art-next');
    if (nextArt) nextArt.disabled = state.bookReader.stage !== 'story' || !page?.audio_completed;
    bookRenderTrail();
    bookSetStage(state.bookReader.stage);
    // Every page change funnels through here (forward "Trang tiếp →", back,
    // trail jump, story-page next). Reset to the top of the reader so the new
    // page doesn't open scrolled to where the kid tapped Next. Extracted into
    // read2lead-book-flow.mjs (scrollBookReaderToTop) so it is unit-testable.
    scrollBookReaderToTop(document);
  }

  function bookRenderTrail() {
    const trail = qs('#book-reader-trail');
    if (!trail) return;
    const totalPages = state.lesson.book_images.length;
    const currentIndex = state.bookReader.pageIndex;
    const pages = state.bookReader.pages || [];
    trail.innerHTML = '';
    for (let i = 0; i < totalPages; i++) {
      const pageState = pages[i] || {};
      const isCompleted = bookPageIsComplete(pageState);
      const isActive = i === currentIndex;
      const isLast = i === totalPages - 1;
      const li = document.createElement('li');
      li.className = 'r2l-book-trail__node';
      li.dataset.pageIndex = String(i);
      if (isActive) li.dataset.state = 'active';
      else if (isCompleted) li.dataset.state = 'completed';
      else if (isLast) li.dataset.state = 'reward';
      else li.dataset.state = 'upcoming';

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'r2l-book-trail__btn';
      btn.setAttribute('aria-label', 'Trang ' + (i + 1));
      btn.disabled = !isCompleted || isActive;

      const icon = document.createElement('span');
      icon.className = 'r2l-book-trail__icon';
      if (isActive) {
        icon.innerHTML = '<img src="/assets/minny/minny_idle.png" alt="Minny" class="r2l-book-trail__minny" />';
      } else if (isLast && !isCompleted) {
        icon.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>';
      } else if (isCompleted) {
        icon.textContent = '★';
      } else {
        icon.textContent = String(i + 1);
      }
      btn.appendChild(icon);

      if (isActive) {
        const pill = document.createElement('span');
        pill.className = 'r2l-book-trail__pill';
        pill.textContent = 'đang đây';
        btn.appendChild(pill);
      }

      const label = document.createElement('span');
      label.className = 'r2l-book-trail__label';
      label.textContent = isLast && !isActive ? 'Phần thưởng' : bookPageLabel(i);
      btn.appendChild(label);

      const sub = document.createElement('span');
      sub.className = 'r2l-book-trail__sub';
      if (isCompleted && !isActive) {
        sub.textContent = 'HOÀN THÀNH ★';
      } else if (isActive) {
        const stageLabels = { story: 'NGHE', questions: 'HỎI', shadow: 'ĐỌC', next: 'XONG' };
        sub.textContent = ['NGHE', 'HỎI', 'ĐỌC'].map((s) => s === stageLabels[state.bookReader.stage] ? s : s).join(' → ');
      } else if (isLast && !isCompleted) {
        sub.textContent = '+50 XP · HUY HIỆU';
      } else {
        sub.textContent = 'Tiếp theo';
      }
      btn.appendChild(sub);

      if (isCompleted && !isActive) {
        btn.addEventListener('click', () => {
          if (state.bookReader.stage === 'summary') return;
          stopLessonAudio();
          state.bookReader.pageIndex = i;
          state.bookReader.stage = 'story';
          bookShowPage();
          scheduleSaveLessonSession();
        });
      }

      li.appendChild(btn);
      trail.appendChild(li);
    }

    const fill = qs('#book-reader-progress-fill');
    if (fill) {
      const completedCount = pages.filter((page) => bookPageIsComplete(page)).length;
      const pct = totalPages > 0 ? Math.round((completedCount / totalPages) * 100) : 0;
      fill.style.width = pct + '%';
    }
  }

  function bookSetStage(stage) {
    if (stage === 'listen') stage = 'story';
    const target = qs(`[data-book-stage-container="${stage}"]`);
    const previous = qsa('[data-book-stage-container]').find((container) => !container.classList.contains('hidden') && container !== target);
    state.bookReader.stage = stage;
    bookSyncStageUi(stage);
    if (_bookStageLeaveTimer) window.clearTimeout(_bookStageLeaveTimer);
    qsa('[data-book-stage-container]').forEach((container) => {
      if (container === target) {
        container.classList.remove('hidden', 'is-leaving');
      } else if (container !== previous) {
        container.classList.add('hidden');
        container.classList.remove('is-leaving');
      }
    });
    if (previous) {
      previous.classList.add('is-leaving');
      _bookStageLeaveTimer = window.setTimeout(() => {
        previous.classList.add('hidden');
        previous.classList.remove('is-leaving');
        _bookStageLeaveTimer = null;
      }, 190);
    }
    if (stage === 'story') {
      const listen = qs('#book-reader-listen-btn');
      const page = bookPageState();
      if (listen) {
        listen.disabled = false;
      }
      if (_bookAudioPageIndex !== state.bookReader.pageIndex || _bookAudioUiState !== 'playing') bookResetAudioUi(page);
      bookUpdateStoryNavigation();
    } else if (stage === 'questions') {
      bookRenderQuestion();
    } else if (stage === 'shadow') {
      bookRenderShadowChunk();
    } else if (stage === 'next') {
      bookUpdateNavigation();
    } else if (stage === 'summary') {
      bookFinishReader();
    }
    scheduleSaveLessonSession();
  }

  function bookUpdateStoryNavigation() {
    const page = bookPageState();
    const pageIndex = state.bookReader.pageIndex;
    const total = state.lesson.book_images.length;
    const next = qs('#book-reader-story-next');
    if (!next) return;
    next.classList.toggle('hidden', !page?.audio_completed);
    next.disabled = !page?.audio_completed;
    next.textContent = 'Tiếp tục →';
    const nextArt = qs('#book-reader-art-next');
    if (nextArt) nextArt.disabled = !page?.audio_completed;
  }

  function bookResumeFrontier() {
    // Jump to the first page that still has work (page-by-page loop), in
    // whatever stage that page needs. All pages done -> the last page's
    // reward panel, whose button finishes the book.
    const firstIncomplete = state.bookReader.pages.findIndex((page) => !bookPageIsComplete(page));
    if (firstIncomplete < 0) {
      state.bookReader.pageIndex = Math.max(0, state.lesson.book_images.length - 1);
      state.bookReader.stage = 'next';
      return;
    }
    state.bookReader.pageIndex = firstIncomplete;
    state.bookReader.stage = bookPracticeStageForPage(bookPageState(firstIncomplete));
  }

  function bookGoToNextStoryPage() {
    const page = bookPageState();
    if (!page?.audio_completed || state.bookReader.stage !== 'story') return;
    stopLessonAudio();
    bookAnimatePageTurn(() => {
      const stage = bookPracticeStageForPage(page);
      if (stage === 'next') {
        // Re-visit of an already-finished page (trail jump): continue from
        // wherever the real work is instead of re-running this page.
        bookResumeFrontier();
      } else {
        state.bookReader.questionIndex = page.question_results.length;
        state.bookReader.stage = stage;
      }
      bookShowPage();
      scheduleSaveLessonSession();
    });
  }

  function bookAudioFailure(message) {
    const button = qs('#book-reader-listen-btn');
    if (button) button.disabled = false;
    bookSetAudioUiState('idle');
    const status = qs('#book-reader-audio-status');
    if (status) status.textContent = message;
  }

  function bookPlayPageAudio({ restart = false, slow = false } = {}) {
    const pageIndex = state.bookReader.pageIndex;
    const url = state.lesson.book_page_audio[pageIndex] || '';
    if (!url || isRewardSfxUrl(url)) {
      bookAudioFailure('Audio trang chưa sẵn sàng. Con thử lại sau nhé.');
      return;
    }
    const currentAudio = lessonAudioState.audio;
    if (!restart && currentAudio && lessonAudioState.url === url) {
      if (!currentAudio.paused) {
        currentAudio.pause();
        bookSetAudioUiState('paused');
        const pausedStatus = qs('#book-reader-audio-status');
        if (pausedStatus) pausedStatus.textContent = 'Minny đang tạm dừng. Con bấm lại để nghe tiếp nhé.';
        return;
      }
      currentAudio.playbackRate = slow ? 0.82 : 1;
      currentAudio.play().then(() => {
        bookSetAudioUiState('playing');
        const resumedStatus = qs('#book-reader-audio-status');
        if (resumedStatus) resumedStatus.textContent = slow ? 'Minny đang đọc chậm cho con nghe...' : 'Minny đang đọc...';
      }).catch(() => bookAudioFailure('Chưa phát được audio. Con bấm thử nghe lại nhé.'));
      return;
    }
    if (restart) stopLessonAudio();
    const button = qs('#book-reader-listen-btn');
    if (button) button.disabled = false;
    _bookAudioPageIndex = pageIndex;
    bookSetAudioUiState('playing');
    const status = qs('#book-reader-audio-status');
    if (status) status.textContent = slow ? 'Minny đang đọc chậm cho con nghe...' : 'Minny đang đọc...';
    playAudio(url, null);
    const audio = lessonAudioState.audio;
    if (!audio) {
      bookAudioFailure('Chưa phát được audio. Con bấm thử nghe lại nhé.');
      return;
    }
    audio.playbackRate = slow ? 0.82 : 1;
    const syncProgress = () => bookSyncAudioProgress(audio, pageIndex);
    audio.addEventListener('loadedmetadata', syncProgress);
    audio.addEventListener('durationchange', syncProgress);
    audio.addEventListener('timeupdate', syncProgress);
    const fail = () => {
      if (!bookPageState(pageIndex)?.audio_completed) {
        bookAudioFailure('Chưa phát được audio. Con bấm thử nghe lại nhé.');
      }
    };
    audio.addEventListener('error', fail, { once: true });
    audio.addEventListener('r2l-play-error', fail, { once: true });
    audio.addEventListener('ended', () => {
      if (pageIndex !== state.bookReader.pageIndex) return;
      bookPageState(pageIndex).audio_completed = true;
      bookSetAudioUiState('done');
      bookSyncAudioProgress(audio, pageIndex);
      bookSetActiveSentence(Math.max(0, bookPageSentences(pageIndex).length - 1), { completed: true });
      bookRenderTrail();
      const status = qs('#book-reader-audio-status');
      if (status) status.textContent = 'Nghe xong rồi — giờ tới câu hỏi nhé!';
      // Page-by-page loop: the page's questions follow its listen right away
      // (a short beat so the "done" state registers before the stage swaps).
      window.setTimeout(() => {
        if (pageIndex !== state.bookReader.pageIndex || state.bookReader.stage !== 'story') return;
        const page = bookPageState(pageIndex);
        state.bookReader.questionIndex = page.question_results.length;
        bookSetStage(bookPracticeStageForPage(page));
      }, 900);
    }, { once: true });
  }

  function bookStableOptionOrder(question) {
    // Deterministic per pack+question: a retry re-renders the SAME order, so a
    // kid who picked wrong can simply try the other option (no reshuffle).
    const seedText = String(state.packId || '') + ':' + String(question.id || '');
    let seed = 0;
    for (let i = 0; i < seedText.length; i++) seed = ((seed * 31) + seedText.charCodeAt(i)) >>> 0;
    const entries = question.options_en.map((option, originalIndex) => ({ option, originalIndex }));
    for (let i = entries.length - 1; i > 0; i--) {
      seed = ((seed * 1664525) + 1013904223) >>> 0;
      const j = seed % (i + 1);
      [entries[i], entries[j]] = [entries[j], entries[i]];
    }
    return entries;
  }

  function bookRenderQuestion() {
    const page = bookPageState();
    const questionIndex = page?.question_results.length || 0;
    const question = page?.selected_questions[questionIndex];
    state.bookReader.questionIndex = questionIndex;
    if (!question) {
      bookSetStage(bookPracticeStageForPage(page));
      return;
    }
    qs('#book-reader-question-counter').textContent = `Câu ${questionIndex + 1} / ${page.selected_questions.length} · Chọn một đáp án`;
    qs('#book-reader-question-text').textContent = question.question_vi || question.question_en;
    const feedback = qs('#book-reader-question-feedback');
    feedback.classList.add('hidden');
    feedback.dataset.state = '';
    qs('#book-reader-question-rewards')?.classList.add('hidden');
    qs('#book-reader-question-hint')?.classList.add('hidden');
    qs('#book-reader-question-retry')?.classList.add('hidden');
    const options = qs('#book-reader-question-options');
    options.innerHTML = '';
    const orderedOptions = bookStableOptionOrder(question);
    orderedOptions.forEach(({ option, originalIndex }, visualIndex) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'r2l-book-guided-option';
      button.dataset.optionLabel = String.fromCharCode(65 + visualIndex);
      button.textContent = option;
      button.addEventListener('click', () => {
        const correct = originalIndex === question.correct_index;
        const questionId = `book:${state.lesson?.book_slug || 'book'}:${question.id}`;
        options.querySelectorAll('button').forEach((optionButton) => { optionButton.disabled = true; });
        feedback.classList.remove('hidden');
        if (correct) {
          page.question_results.push({
            question_id: question.id,
            sentence_index: question.sentence_index,
            selected_index: originalIndex,
            correct_index: question.correct_index,
            correct: true,
            attempts: (Number(question._attempts) || 0) + 1,
          });
          button.dataset.state = 'correct';
          feedback.dataset.state = 'correct';
          qs('#book-reader-question-counter').textContent = `Câu ${questionIndex + 1} / ${page.selected_questions.length} · Đúng rồi!`;
          qs('#book-reader-question-feedback-title').textContent = 'Tốt lắm, con ơi!';
          qs('#book-reader-question-feedback-copy').textContent = `Minny: “Đúng “${option}” rồi đó con.”`;
          qs('#book-reader-question-minny').src = '/assets/r2l/minny/smile.png';
          qs('#book-reader-question-rewards')?.classList.remove('hidden');
          clearWrongStreak(questionId);
          onBookReaderCorrect();
          scheduleSaveLessonSession();
          window.setTimeout(() => {
            if (state.bookReader.stage === 'questions') bookRenderQuestion();
          }, 1200);
        } else {
          question._attempts = (Number(question._attempts) || 0) + 1;
          button.dataset.state = 'retry';
          feedback.dataset.state = 'retry';
          qs('#book-reader-question-counter').textContent = `Câu ${questionIndex + 1} / ${page.selected_questions.length} · Thử lại`;
          qs('#book-reader-question-feedback-title').textContent = 'Gần đúng rồi, con!';
          qs('#book-reader-question-feedback-copy').textContent = 'Minny đợi con chọn lại nhé.';
          qs('#book-reader-question-minny').src = '/assets/r2l/minny/thinking.png';
          const hint = question.hint || 'Con nhìn lại đoạn truyện và tìm từ khóa giống trong câu hỏi nhé.';
          qs('#book-reader-question-hint-copy').textContent = hint;
          qs('#book-reader-question-hint')?.classList.remove('hidden');
          qs('#book-reader-question-retry')?.classList.remove('hidden');
          onBookReaderWrong(questionId);
        }
      }, { once: true });
      options.appendChild(button);
    });
    _r2lSpeakEnglishLine(question.question_en);
  }

  function bookCurrentChunk() {
    return bookPageState()?.page_reads[state.bookReader.chunkIndex] || null;
  }

  function bookChunkItemKey(read = bookCurrentChunk()) {
    return read ? `book_read_${read.read_id}` : '';
  }

  function bookRenderShadowChunk() {
    const page = bookPageState();
    const chunk = bookCurrentChunk();
    if (!chunk) {
      bookSetStage('next');
      return;
    }
    qs('#book-reader-shadow-counter').textContent = page.page_reads.length > 1
      ? `Phần ${state.bookReader.chunkIndex + 1}/${page.page_reads.length}`
      : 'Cả trang';
    const itemKey = bookChunkItemKey(chunk);
    const body = qs('#book-reader-shadow-body');
    const settled = chunk.status === 'passed' || chunk.status === 'skipped';
    body.innerHTML = `
      <article class="r2l-book-shadow-card" data-speak-card="0" data-item-key="${escapeHtml(itemKey)}" data-book-chunk-id="${escapeHtml(chunk.read_id)}" data-rec-state="idle">
        <p class="r2l-book-eyebrow" data-book-rec-heading>Bấm để bắt đầu đọc</p>
        <div class="r2l-book-shadow-card__visuals">
          <button type="button" data-speak-record="0" ${!settled ? '' : 'disabled'}>🎤 Con nói</button>
          <div class="r2l-book-shadow-meter" aria-label="Mức âm thanh của con">
            <div class="r2l-book-shadow-meter__star"><span class="r2l-book-shadow-meter__fill" data-rec-meter></span></div>
          </div>
        </div>
        <div class="r2l-book-shadow-wave" aria-hidden="true">${Array.from({ length: 14 }, () => '<i></i>').join('')}</div>
        <p class="r2l-book-shadow-card__text">“${escapeHtml(chunk.text_en)}”</p>
        <p class="r2l-book-shadow-card__hint" data-book-rec-hint data-rec-hint>Bấm 🎤 rồi đọc to cho Minny nghe nhé.</p>
        <p data-book-attempt-status>Lần đọc: ${chunk.attempts}/3</p>
        <div class="r2l-minny-speak-actions">
          <button type="button" class="minny-btn minny-btn--listen" data-speak-listen="0">🔊 Nghe Minny đọc lại</button>
        </div>
        <div class="hidden rounded-md border border-cream/10 bg-navy-950/35 p-3 text-sm text-cream/80" data-speak-feedback></div>
        <div class="r2l-book-shadow-result hidden" data-book-shadow-result></div>
        <button type="button" class="r2l-primary mt-3 w-full ${settled ? '' : 'hidden'}" data-book-shadow-continue>${bookShadowContinueLabel()}</button>
        <div class="r2l-wave-panel hidden" data-speak-waveform aria-label="Sóng âm bài đọc của con"></div>
      </article>
    `;
    const card = body.querySelector('[data-speak-card]');
    const recordButton = body.querySelector('[data-speak-record]');
    // Page-by-page loop: the kid just heard Minny read this page in the listen
    // step, so the mic is armed immediately — no per-chunk sample gate. The
    // shared _r2lSyncMinnyRecordButton still requires dataset.heard, which the
    // page listen has already earned.
    if (recordButton) recordButton.dataset.heard = 'true';
    _r2lInitSpeakRecorder(itemKey, card, chunk.text_en);
    if (chunk.latest_feedback) {
      _r2lRenderSpeakFeedback(card, chunk.latest_feedback);
    }
    _r2lSyncMinnyRecordButton(itemKey, card);
    bookSyncShadowVisualState(card, _r2lRecorderState.perItem.get(itemKey)?.status || 'idle', _r2lRecorderState.perItem.get(itemKey)?.checkStatus || 'idle');
    bookObserveRecordMeter(card);
    if (settled && recordButton) recordButton.disabled = true;
    body.querySelector('[data-speak-listen]')?.addEventListener('click', () => bookPlayShadowChunk(chunk, card));
    recordButton?.addEventListener('click', () => {
      const entry = _r2lRecorderState.perItem.get(itemKey);
      if (entry?.status === 'recording' || entry?.status === 'warming') {
        _r2lStopRecording(itemKey, card);
      } else if (entry?.checkStatus !== 'uploading') {
        _r2lStartRecording(itemKey, card);
      }
    });
    body.querySelector('[data-book-shadow-continue]')?.addEventListener('click', () => bookCompleteShadowChunk(chunk.read_id));
    qs('#book-reader-parent-help')?.classList.toggle('hidden', chunk.technical_failures < 2);
  }

  function bookShadowContinueLabel() {
    const page = bookPageState();
    const nextPending = page?.page_reads.findIndex(
      (read, index) => index > state.bookReader.chunkIndex && read.status === 'pending',
    );
    if (nextPending >= 0) return 'Tiếp phần sau →';
    return state.bookReader.pageIndex >= state.lesson.book_images.length - 1
      ? 'Lưu chiến công'
      : 'Trang tiếp →';
  }

  async function bookPlayShadowChunk(chunk, card) {
    const button = card?.querySelector('[data-speak-listen]');
    const recordButton = card?.querySelector('[data-speak-record]');
    if (button) {
      button.disabled = true;
      button.textContent = '🔊 Đang phát...';
    }
    if (recordButton) recordButton.disabled = true;
    try {
      const sentences = state.lesson?.story?.sentences || [];
      for (const sentenceIndex of chunk.sentence_indexes) {
        const sentence = sentences[sentenceIndex] || {};
        const url = sentence.audio_url || '';
        if (url && !isRewardSfxUrl(url)) {
          await new Promise((resolve, reject) => {
            playAudio(url, button);
            const audio = lessonAudioState.audio;
            if (!audio) {
              reject(new Error('audio_unavailable'));
              return;
            }
            audio.addEventListener('ended', resolve, { once: true });
            audio.addEventListener('error', reject, { once: true });
            audio.addEventListener('r2l-play-error', reject, { once: true });
          });
        } else {
          await new Promise((resolve) => _r2lSpeakEnglishLine(sentence.text_en || '', resolve));
        }
      }
      chunk.playback_completed = true;
      if (recordButton) {
        recordButton.dataset.heard = 'true';
        recordButton.disabled = chunk.status !== 'pending' || !_r2lMicIsReady();
      }
      scheduleSaveLessonSession();
    } catch {
      showToast('Chưa phát hết đoạn. Con bấm nghe lại nhé!');
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = '🔊 Nghe Minny đọc lại';
      }
    }
  }

  function bookChunkFromCard(card) {
    const readId = card?.dataset?.bookChunkId || '';
    return bookPageState()?.page_reads.find((read) => read.read_id === readId) || null;
  }

  function bookHandleShadowScore(card, payload) {
    const chunk = bookChunkFromCard(card);
    if (!chunk || chunk.status !== 'pending' || !payload?.ok) return;
    const score = Math.max(0, Math.min(100, Number(payload.score_percent) || 0));
    chunk.attempts += 1;
    chunk.score_percent = score;
    chunk.latest_feedback = payload;
    const questionId = `book-shadow:${chunk.read_id}`;
    if (score >= _R2L_SPEAKING_PASS_PERCENT) {
      chunk.status = 'passed';
      clearWrongStreak(questionId);
      onBookReaderCorrect({ coinTone: true });
    } else if (chunk.attempts >= 3) {
      chunk.status = 'skipped';
      onBookReaderWrong(questionId);
    } else {
      onBookReaderWrong(questionId);
    }
    const attemptStatus = card?.querySelector('[data-book-attempt-status]');
    if (attemptStatus) {
      attemptStatus.textContent = chunk.status === 'passed'
        ? `Đã đạt ${score}% ✓`
        : chunk.status === 'skipped'
          ? `Đã thử 3 lần — mình đi tiếp nhé.`
          : `Lần đọc: ${chunk.attempts}/3 — cần từ 50% để qua.`;
    }
    scheduleSaveLessonSession();
    if (chunk.status !== 'pending') {
      const continueButton = card?.querySelector('[data-book-shadow-continue]');
      if (continueButton) {
        continueButton.textContent = bookShadowContinueLabel();
        continueButton.classList.remove('hidden');
      }
      const recordButton = card?.querySelector('[data-speak-record]');
      if (recordButton) recordButton.disabled = true;
    }
    const result = card?.querySelector('[data-book-shadow-result]');
    if (result) {
      result.classList.remove('hidden');
      result.textContent = score >= 80
        ? `Đọc rất rõ! Con đạt ${score}% và nhận 2 sao.`
        : score >= 60
          ? `Khá tốt! Con đạt ${score}% và nhận 1 sao.`
          : chunk.status === 'passed'
            ? `Con đã hoàn thành với ${score}%. Mình đi tiếp nhé.`
            : `Đọc chậm hơn nhé con. Minny đợi.`;
    }
    bookSyncShadowVisualState(card, chunk.status === 'pending' ? 'idle' : 'result', 'done');
  }

  function bookHandleShadowTechnicalFailure(card) {
    const chunk = bookChunkFromCard(card);
    if (!chunk || chunk.status !== 'pending') return;
    chunk.technical_failures += 1;
    if (chunk.technical_failures >= 2) {
      qs('#book-reader-parent-help')?.classList.remove('hidden');
    }
    scheduleSaveLessonSession();
  }

  function bookSkipCurrentChunkForTechnicalFailure() {
    const chunk = bookCurrentChunk();
    if (!chunk || chunk.status !== 'pending' || chunk.technical_failures < 2) return;
    chunk.status = 'skipped';
    chunk.technical_skip = true;
    chunk.score_percent = Number(chunk.score_percent) || 0;
    scheduleSaveLessonSession();
    bookCompleteShadowChunk(chunk.read_id);
  }

  function bookCompleteShadowChunk(readId) {
    const page = bookPageState();
    const settledIndex = page?.page_reads.findIndex((read) => read.read_id === readId);
    if (settledIndex == null || settledIndex < 0) return;
    const nextPending = page.page_reads.findIndex(
      (read, index) => index > settledIndex && read.status === 'pending',
    );
    if (nextPending >= 0) {
      state.bookReader.chunkIndex = nextPending;
      bookSetStage('shadow');
      return;
    }
    if (state.bookReader.pageIndex >= state.lesson.book_images.length - 1) {
      playSfx(SFX.levelUp, { volume: 0.6 });
      bookSetStage('next');
      return;
    }
    playSfx(SFX.levelUp, { volume: 0.6 });
    bookSetStage('next');
  }

  function bookUpdateNavigation() {
    const pageIndex = state.bookReader.pageIndex;
    const total = state.lesson.book_images.length;
    const next = qs('#book-reader-next');
    if (!next) return;
    next.disabled = false;
    next.textContent = pageIndex >= total - 1 ? 'Hoàn thành →' : 'Trang tiếp →';
  }

  function bookRenderAttribution() {
    const root = qs('#book-reader-attribution-content');
    if (!root || root.dataset.rendered === 'true') return;
    root.dataset.rendered = 'true';
    const attribution = state.lesson.book_attribution || {};
    const addText = (label, value) => {
      if (!value) return;
      const paragraph = document.createElement('p');
      const strong = document.createElement('strong');
      strong.textContent = label + ': ';
      paragraph.append(strong, document.createTextNode(String(value)));
      root.appendChild(paragraph);
    };
    addText('Tên truyện', attribution.title);
    addText('Tác giả / họa sĩ', (attribution.creators || []).join(', '));
    addText('Nhà xuất bản', attribution.publisher);
    addText('Ghi công', attribution.credit_text);
    const addLink = (label, href) => {
      if (!href) return;
      const link = document.createElement('a');
      link.href = href;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.className = 'block min-h-11 py-2 font-bold text-gold underline';
      link.textContent = label;
      root.appendChild(link);
    };
    addLink('Xem truyện gốc trên StoryWeaver', attribution.source_url);
    addLink(
      'Giấy phép ' + (attribution.license?.name || 'CC BY 4.0'),
      attribution.license?.url,
    );
    if (Array.isArray(attribution.image_credits) && attribution.image_credits.length) {
      const heading = document.createElement('p');
      heading.className = 'font-bold text-cream';
      heading.textContent = 'Ghi công hình ảnh';
      root.appendChild(heading);
      const list = document.createElement('ol');
      list.className = 'list-decimal space-y-1 pl-5';
      attribution.image_credits.forEach((credit) => {
        const item = document.createElement('li');
        item.textContent = credit.credit_text || '';
        list.appendChild(item);
      });
      root.appendChild(list);
    }
  }

  function bookSubmissionState() {
    return {
      pages: state.bookReader.pages.map((page) => ({
        page_index: page.page_index,
        audio_completed: page.audio_completed,
        question_results: page.question_results,
        page_reads: page.page_reads.map((read) => ({
          read_id: read.read_id,
          sentence_indexes: read.sentence_indexes,
          attempts: read.attempts,
          status: read.status,
          score_percent: read.score_percent,
          technical_failures: read.technical_failures,
          ...(read.technical_skip === true ? { technical_skip: true } : {}),
        })),
      })),
    };
