---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ActivityProgress from '../../components/read2lead/v2/ActivityProgress.astro';
import IdentityBanner from '../../components/read2lead/v2/IdentityBanner.astro';
import ListeningComprehension from '../../components/read2lead/v2/ListeningComprehension.astro';
import ListenAndOrder from '../../components/read2lead/v2/ListenAndOrder.astro';
import ListenAndSpeak from '../../components/read2lead/v2/ListenAndSpeak.astro';
import LevelUpModal from '../../components/read2lead/v2/LevelUpModal.astro';
import ProgressBar from '../../components/read2lead/v2/ProgressBar.astro';
import ReadingComprehension from '../../components/read2lead/v2/ReadingComprehension.astro';
import RewardBurst from '../../components/read2lead/v2/RewardBurst.astro';
---

<BaseLayout
  title="Read2Lead V2 Lesson | Felix Builder Hub"
  description="Bài học Read2Lead V2: nghe truyện, xếp câu, nói lại và đọc hiểu theo nhịp nhẹ nhàng."
>
  <Header read2LeadState={true} />
  <main id="main" class="min-h-screen bg-navy-950">
    <IdentityBanner />
    <ProgressBar initialPercent={20} />
    <div class="mx-auto flex max-w-6xl justify-end px-4 pt-3 sm:px-6 lg:px-8">
      <button
        id="sfx-toggle"
        type="button"
        class="rounded-md border border-cream/30 bg-navy-900 px-3 py-1 text-xs font-medium text-cream hover:bg-navy-800"
        aria-label="Bật/tắt âm thanh"
      >
        Tắt âm
      </button>
    </div>

    <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
      <div id="loading-card" class="rounded-md border border-cream/10 bg-cream/5 p-6 text-cream">
        Minny đang mở nhiệm vụ cho con...
      </div>

      <div id="error-card" class="hidden rounded-md border border-gold/30 bg-gold/10 p-6 text-cream">
        <p class="font-semibold text-gold">Chưa mở được bài học</p>
        <p id="error-message" class="mt-2 text-sm text-cream/80"></p>
      </div>

      <article id="lesson-shell" class="hidden space-y-6">
        <section class="grid gap-4 lg:grid-cols-[1.15fr_0.85fr]">
          <div class="rounded-md border border-cream/10 bg-cream/[0.04] p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="text-sm font-semibold uppercase tracking-wide text-gold">Câu chuyện hôm nay</p>
                <h2 id="story-title" class="mt-1 font-display text-2xl font-bold text-cream"></h2>
              </div>
              <button id="play-story" class="r2l-primary" type="button">Nghe cả truyện</button>
            </div>
            <div id="story-paragraphs" class="mt-5 space-y-4 text-base leading-8 text-cream/85"></div>
          </div>

          <aside class="rounded-md border border-cream/10 bg-cream/[0.04] p-5">
            <p class="text-sm font-semibold uppercase tracking-wide text-gold">Tap-to-play</p>
            <h3 class="mt-1 font-display text-xl font-bold text-cream">Nghe từng câu</h3>
            <p class="mt-2 text-sm text-cream/70">
              Con bấm từng câu để nghe lại phần mình thích, rồi quay sang nhiệm vụ bên dưới.
            </p>
            <div id="sentence-list" class="mt-4 max-h-[420px] space-y-2 overflow-y-auto pr-1"></div>
          </aside>
        </section>

        <section class="rounded-md border border-cream/10 bg-cream/[0.04] p-4">
          <ActivityProgress />
        </section>

        <section class="space-y-4">
          <ListeningComprehension />
          <ListenAndOrder />
          <ListenAndSpeak />
          <ReadingComprehension />
        </section>

        <section class="flex flex-col gap-3 rounded-md border border-accent/25 bg-accent/10 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-display text-xl font-bold text-cream">Hoàn thành nhiệm vụ</p>
            <p id="submit-hint" class="mt-1 text-sm text-cream/70">
              Con hoàn thành đủ 4 phần rồi bấm nút này để lưu kết quả.
            </p>
          </div>
          <button id="submit-lesson" class="r2l-primary" type="button" disabled>Lưu chiến công</button>
        </section>

        <section id="completion-card" class="hidden rounded-md border border-gold/40 bg-gold/10 p-6 text-center">
          <p class="font-display text-2xl font-bold text-gold">Nhiệm vụ xong!</p>
          <p id="completion-copy" class="mt-2 text-cream/80"></p>
        </section>
      </article>
    </section>

    <RewardBurst />
    <LevelUpModal />
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .r2l-primary {
    min-height: 44px;
    border-radius: 8px;
    background: rgb(74 222 128);
    padding: 0.75rem 1rem;
    font-weight: 800;
    color: rgb(10 14 26);
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .r2l-primary:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .r2l-primary:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .r2l-step {
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.14);
    padding: 0.75rem;
    text-align: left;
    font-weight: 700;
    color: rgb(245 230 211 / 0.72);
  }

  .r2l-step[data-active='true'] {
    border-color: rgb(212 166 78 / 0.5);
    color: rgb(212 166 78);
  }

  .r2l-step[data-done='true'] {
    border-color: rgb(74 222 128 / 0.55);
    color: rgb(74 222 128);
  }

  .r2l-activity {
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.12);
    background: rgb(245 230 211 / 0.04);
    padding: 1.25rem;
  }

  .r2l-activity-head h2 {
    margin-top: 0.25rem;
    font-family: Manrope, Inter, sans-serif;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 800;
    color: rgb(245 230 211);
  }

  .r2l-activity-head p {
    color: rgb(245 230 211 / 0.72);
  }

  .r2l-identity {
    font-weight: 800;
    color: rgb(212 166 78) !important;
  }

  .r2l-option,
  .r2l-token,
  .r2l-sentence {
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.14);
    background: rgb(10 14 26 / 0.45);
    padding: 0.75rem 0.9rem;
    text-align: left;
    color: rgb(245 230 211);
  }

  .r2l-option[data-state='correct'],
  .r2l-token[data-picked='true'],
  .r2l-sentence:hover {
    border-color: rgb(74 222 128 / 0.7);
    background: rgb(74 222 128 / 0.14);
  }

  .r2l-option[data-state='retry'] {
    border-color: rgb(212 166 78 / 0.75);
    background: rgb(212 166 78 / 0.14);
  }

  .r2l-rec-row {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .r2l-rec-btn {
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid rgba(245, 239, 224, 0.3);
    background: #0f172a;
    color: #f5efe0;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .r2l-rec-btn:hover {
    background: #1e293b;
  }

  .r2l-rec-start,
  .r2l-rec-play {
    border-color: rgba(16, 185, 129, 0.5);
  }

  .r2l-rec-stop {
    border-color: rgba(239, 68, 68, 0.6);
    background: rgba(127, 29, 29, 0.3);
  }

  .r2l-rec-redo {
    border-color: rgba(245, 158, 11, 0.4);
  }

  .r2l-rec-indicator {
    color: #f87171;
    font-size: 0.85rem;
    animation: r2l-pulse 1.2s infinite;
  }

  @keyframes r2l-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
</style>

<script is:inline>
  /* ----- W4.4 SFX library ----- */
  const SFX = {
    correctCommon: '/sfx/r2l/success-1.mp3',
    correctRare: '/sfx/r2l/success-2.mp3',
    correctLegendary: '/sfx/r2l/success-3.mp3',
    wrong: '/sfx/r2l/soft-boop.mp3',
    encouragement: '/sfx/r2l/voice-colen.mp3',
    activityComplete: '/sfx/r2l/page-complete.mp3',
    packComplete: '/sfx/r2l/final-reward.mp3',
    levelUp: '/sfx/r2l/voice-xuatsac.mp3',
  };

  const VOICE_POOL = [
    '/sfx/r2l/voice-tuyetvoi.mp3',
    '/sfx/r2l/voice-gioiqua.mp3',
    '/sfx/r2l/voice-tienbo.mp3',
    '/sfx/r2l/voice-xuatsac.mp3',
  ];

  const _r2lSfxState = {
    muted: (() => {
      try { return localStorage.getItem('r2l_sfx_muted') === '1'; } catch { return false; }
    })(),
    wrongStreak: new Map(),
    audioCache: new Map(),
  };

  function _r2lGetAudio(src) {
    let audio = _r2lSfxState.audioCache.get(src);
    if (!audio) {
      audio = new Audio(src);
      audio.preload = 'auto';
      _r2lSfxState.audioCache.set(src, audio);
    }
    return audio;
  }

  function playSfx(src, { volume = 0.85 } = {}) {
    if (_r2lSfxState.muted || !src) return;
    try {
      const audio = _r2lGetAudio(src);
      audio.volume = volume;
      audio.currentTime = 0;
      audio.play().catch((err) => {
        console.debug('[r2l-sfx] play blocked:', src, err.message);
      });
    } catch (err) {
      console.warn('[r2l-sfx] error:', err);
    }
  }

  function playSfxSequence(sources, gapMs = 600) {
    if (_r2lSfxState.muted) return;
    if (!sources.length) return;
    playSfx(sources[0]);
    if (sources.length > 1) {
      window.setTimeout(() => playSfxSequence(sources.slice(1), gapMs), gapMs);
    }
  }

  function pickVoiceClip() {
    return VOICE_POOL[Math.floor(Math.random() * VOICE_POOL.length)];
  }

  function setSfxMuted(muted) {
    _r2lSfxState.muted = !!muted;
    try {
      localStorage.setItem('r2l_sfx_muted', muted ? '1' : '0');
    } catch {}
    const btn = document.getElementById('sfx-toggle');
    if (btn) btn.textContent = muted ? 'Bật âm' : 'Tắt âm';
  }

  let _r2lSfxPreloaded = false;
  function preloadSfxOnce() {
    if (_r2lSfxPreloaded) return;
    _r2lSfxPreloaded = true;
    [SFX.correctCommon, SFX.wrong, SFX.activityComplete, SFX.packComplete].forEach((src) => {
      try { _r2lGetAudio(src).load(); } catch {}
    });
  }
  document.addEventListener('click', preloadSfxOnce, { once: true });

  const sfxToggle = document.getElementById('sfx-toggle');
  if (sfxToggle) {
    sfxToggle.textContent = _r2lSfxState.muted ? 'Bật âm' : 'Tắt âm';
    sfxToggle.addEventListener('click', () => setSfxMuted(!_r2lSfxState.muted));
  }

  const state = {
    accessCode: '',
    packId: '',
    lesson: null,
    activityIndex: 0,
    completedTypes: new Set(),
    activityResults: {},
  };

  const ACTIVITY_LABELS = {
    listening_comprehension: 'Nghe hiểu',
    listen_and_order: 'Xếp câu',
    listen_and_speak: 'Nói lại',
    reading_comprehension: 'Đọc hiểu',
  };

  const qs = (selector) => document.querySelector(selector);
  const qsa = (selector) => Array.from(document.querySelectorAll(selector));
  const escapeHtml = (value) =>
    String(value || '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');

  function rollRewardTier() {
    const roll = Math.random();
    if (roll < 0.05) return 'legendary';
    if (roll < 0.3) return 'rare';
    return 'common';
  }

  function testRewardDistribution(count = 100) {
    const result = { common: 0, rare: 0, legendary: 0 };
    for (let i = 0; i < count; i += 1) result[rollRewardTier()] += 1;
    return result;
  }

  window.__r2lRollRewardTier = rollRewardTier;
  window.__r2lTestRewardDistribution = testRewardDistribution;

  /* ----- Activity C audio recorder (W4.3) ----- */
  const _r2lRecorderState = {
    // Map of itemKey -> { mediaRecorder, chunks, blobUrl, status: 'idle'|'recording'|'recorded'|'denied' }
    perItem: new Map(),
    micPermissionDenied: false,
  };

  const _r2lSupportsRecording = (() => {
    try {
      return !!(navigator.mediaDevices &&
        typeof navigator.mediaDevices.getUserMedia === 'function' &&
        typeof window.MediaRecorder !== 'undefined');
    } catch {
      return false;
    }
  })();

  async function _r2lStartRecording(itemKey, cardEl) {
    if (_r2lRecorderState.micPermissionDenied) return;
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const mr = new MediaRecorder(stream);
      const chunks = [];
      mr.addEventListener('dataavailable', (e) => {
        if (e.data && e.data.size > 0) chunks.push(e.data);
      });
      mr.addEventListener('stop', () => {
        const blob = new Blob(chunks, { type: mr.mimeType || 'audio/webm' });
        const url = URL.createObjectURL(blob);
        const prev = _r2lRecorderState.perItem.get(itemKey);
        if (prev?.blobUrl) URL.revokeObjectURL(prev.blobUrl);
        _r2lRecorderState.perItem.set(itemKey, {
          mediaRecorder: null,
          chunks: [],
          blobUrl: url,
          status: 'recorded',
        });
        stream.getTracks().forEach((t) => t.stop());
        _r2lRenderRecorderUi(itemKey, cardEl);
      });
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: mr,
        chunks,
        blobUrl: null,
        status: 'recording',
      });
      mr.start();
      _r2lRenderRecorderUi(itemKey, cardEl);
    } catch (err) {
      console.warn('[r2l-recorder] Permission denied or error:', err);
      _r2lRecorderState.micPermissionDenied = true;
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: null,
        chunks: [],
        blobUrl: null,
        status: 'denied',
      });
      _r2lRenderRecorderUi(itemKey, cardEl);
    }
  }

  function _r2lStopRecording(itemKey, cardEl) {
    const entry = _r2lRecorderState.perItem.get(itemKey);
    if (entry?.mediaRecorder && entry.status === 'recording') {
      entry.mediaRecorder.stop();
      // UI re-renders on 'stop' event handler above.
    }
  }

  function _r2lDiscardRecording(itemKey, cardEl) {
    const entry = _r2lRecorderState.perItem.get(itemKey);
    if (entry?.blobUrl) URL.revokeObjectURL(entry.blobUrl);
    _r2lRecorderState.perItem.delete(itemKey);
    _r2lRenderRecorderUi(itemKey, cardEl);
  }

  function _r2lPlayRecording(itemKey) {
    const entry = _r2lRecorderState.perItem.get(itemKey);
    if (!entry?.blobUrl) return;
    const audio = new Audio(entry.blobUrl);
    audio.play().catch((e) => console.warn('[r2l-recorder] playback failed', e));
  }

  function _r2lCleanupRecorderState() {
    _r2lRecorderState.perItem.forEach((entry) => {
      if (entry.blobUrl) URL.revokeObjectURL(entry.blobUrl);
    });
    _r2lRecorderState.perItem.clear();
  }

  function _r2lRenderRecorderUi(itemKey, cardEl) {
    const slot = cardEl.querySelector('[data-recorder-slot]');
    if (!slot) return;
    if (!_r2lSupportsRecording) {
      slot.innerHTML = '';
      return;
    }
    const entry = _r2lRecorderState.perItem.get(itemKey);
    const status = entry?.status || 'idle';

    if (status === 'denied') {
      slot.innerHTML = '<p class="text-sm text-cream/60">Vui lòng cấp quyền micro để con nghe lại bài thu của mình.</p>';
      return;
    }

    if (status === 'recording') {
      slot.innerHTML = `
        <button type="button" class="r2l-rec-btn r2l-rec-stop" data-action="stop">Dừng thu</button>
        <span class="r2l-rec-indicator">đang thu...</span>
      `;
    } else if (status === 'recorded') {
      slot.innerHTML = `
        <button type="button" class="r2l-rec-btn r2l-rec-play" data-action="play">Nghe lại bài thu</button>
        <button type="button" class="r2l-rec-btn r2l-rec-redo" data-action="redo">Thu lại</button>
      `;
    } else {
      slot.innerHTML = '<button type="button" class="r2l-rec-btn r2l-rec-start" data-action="start">Thu âm</button>';
    }

    slot.querySelectorAll('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const action = btn.getAttribute('data-action');
        if (action === 'start') _r2lStartRecording(itemKey, cardEl);
        else if (action === 'stop') _r2lStopRecording(itemKey, cardEl);
        else if (action === 'play') _r2lPlayRecording(itemKey);
        else if (action === 'redo') _r2lDiscardRecording(itemKey, cardEl);
      });
    });
  }

  window.addEventListener('beforeunload', _r2lCleanupRecorderState);

  init();

  async function init() {
    const params = new URLSearchParams(window.location.search);
    state.accessCode = (params.get('code') || '').trim().toUpperCase();
    state.packId = (params.get('pack_id') || '').trim();
    if (!state.accessCode || !state.packId) {
      showError('Thiếu mã học sinh hoặc mã bài. Anh Phương mở lại từ link bài học nhé.');
      return;
    }

    try {
      const res = await fetch(
        `/api/read2lead-lesson?code=${encodeURIComponent(state.accessCode)}&pack_id=${encodeURIComponent(state.packId)}`,
      );
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.message || data.error || 'Không tải được bài.');
      if (data.lesson?.schema_version !== 2) {
        throw new Error('Bài này vẫn là format cũ. V2 lesson chỉ nhận pack schema_version = 2.');
      }
      state.lesson = data.lesson;
      renderLesson(data.lesson);
    } catch (error) {
      showError(error.message || 'Có lỗi khi mở bài học.');
    }
  }

  function renderLesson(lesson) {
    qs('#loading-card').classList.add('hidden');
    qs('#lesson-shell').classList.remove('hidden');
    qs('#story-title').textContent = lesson.story?.title || 'Câu chuyện của con';

    const paragraphs = Array.isArray(lesson.story?.paragraphs_en) ? lesson.story.paragraphs_en : [];
    qs('#story-paragraphs').innerHTML = paragraphs
      .map((paragraph) => `<p>${escapeHtml(paragraph)}</p>`)
      .join('');

    const fullAudio = lesson.story?.full_audio_url || '';
    qs('#play-story').addEventListener('click', () => playAudio(fullAudio));
    if (!fullAudio) qs('#play-story').textContent = 'Chưa có audio';

    renderSentences(lesson.story?.sentences || []);
    renderActivity(0);
    updateProgress();
  }

  function renderSentences(sentences) {
    qs('#sentence-list').innerHTML = sentences
      .map(
        (sentence, index) => `
          <button class="r2l-sentence block w-full" type="button" data-sentence-index="${index}">
            <span class="block text-sm font-bold text-gold">Câu ${index + 1}</span>
            <span>${escapeHtml(sentence.text_en)}</span>
          </button>
        `,
      )
      .join('');

    qsa('[data-sentence-index]').forEach((button) => {
      button.addEventListener('click', () => {
        const sentence = sentences[Number(button.dataset.sentenceIndex)];
        playAudio(sentence?.audio_url || '');
      });
    });
  }

  function renderActivity(index) {
    const activities = state.lesson.activities || [];
    const nextIndex = Math.max(0, Math.min(index, 3));
    const previousActivity = activities[state.activityIndex];
    if (previousActivity?.type === 'listen_and_speak' && nextIndex !== state.activityIndex) {
      _r2lCleanupRecorderState();
    }
    state.activityIndex = nextIndex;
    qsa('[data-activity-shell]').forEach((shell) => {
      shell.hidden = true;
    });
    const activity = activities[state.activityIndex];
    if (!activity) return;

    const shell = qs(`[data-activity-shell="${activity.type}"]`);
    if (!shell) return;
    shell.hidden = false;
    shell.querySelector('[data-activity-title]').textContent = activity.title_vi || ACTIVITY_LABELS[activity.type] || '';
    shell.querySelector('[data-activity-identity]').textContent = activity.identity_vi || '';
    shell.querySelector('[data-activity-instructions]').textContent = activity.instructions_vi || '';

    if (activity.type === 'listening_comprehension' || activity.type === 'reading_comprehension') {
      renderMcqActivity(shell.querySelector('[data-activity-body]'), activity);
    } else if (activity.type === 'listen_and_order') {
      renderOrderActivity(shell.querySelector('[data-activity-body]'), activity);
    } else if (activity.type === 'listen_and_speak') {
      renderSpeakActivity(shell.querySelector('[data-activity-body]'), activity);
    }

    qsa('[data-step-button]').forEach((button, buttonIndex) => {
      button.dataset.active = String(buttonIndex === state.activityIndex);
      const type = activities[buttonIndex]?.type;
      button.dataset.done = String(type && state.completedTypes.has(type));
      button.onclick = () => renderActivity(buttonIndex);
    });
  }

  function renderMcqActivity(root, activity) {
    root.innerHTML = `
      <div class="mt-5 space-y-5">
        ${(activity.questions || [])
          .map(
            (question, questionIndex) => `
              <article class="rounded-md border border-cream/10 bg-navy-950/45 p-4">
                <p class="font-bold text-cream">${escapeHtml(question.question_en)}</p>
                <p class="mt-1 text-sm text-cream/65">${escapeHtml(question.question_vi)}</p>
                <div class="mt-3 grid gap-2">
                  ${(question.options_en || [])
                    .map(
                      (option, optionIndex) => `
                        <button class="r2l-option" type="button" data-question-index="${questionIndex}" data-option-index="${optionIndex}">
                          ${escapeHtml(option)}
                          <span class="block text-xs text-cream/55">${escapeHtml(question.options_vi?.[optionIndex] || '')}</span>
                        </button>
                      `,
                    )
                    .join('')}
                </div>
                <p class="mt-2 hidden text-sm text-gold" data-explanation="${questionIndex}">${escapeHtml(question.explanation_vi || '')}</p>
              </article>
            `,
          )
          .join('')}
      </div>
    `;

    const answered = new Set();
    root.querySelectorAll('[data-question-index]').forEach((button) => {
      button.addEventListener('click', () => {
        const questionIndex = Number(button.dataset.questionIndex);
        const optionIndex = Number(button.dataset.optionIndex);
        const question = activity.questions[questionIndex];
        const isCorrect = optionIndex === question.correct_index;
        const questionId = `${activity.type}:${question.id || questionIndex}`;
        button.dataset.state = isCorrect ? 'correct' : 'retry';
        root.querySelector(`[data-explanation="${questionIndex}"]`)?.classList.remove('hidden');
        if (isCorrect && !answered.has(questionIndex)) {
          answered.add(questionIndex);
          clearWrongStreak(questionId);
          showReward();
        } else if (!isCorrect) {
          playWrongSfx(questionId);
        }
        if (answered.size === (activity.questions || []).length) completeActivity(activity.type, {
          correct_count: answered.size,
          total_count: activity.questions.length,
        });
      });
    });
  }

  function renderOrderActivity(root, activity) {
    root.innerHTML = `
      <div class="mt-5 space-y-5">
        ${(activity.items || [])
          .map(
            (item, itemIndex) => `
              <article class="rounded-md border border-cream/10 bg-navy-950/45 p-4" data-order-card="${itemIndex}">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <p class="font-bold text-cream">Câu ${itemIndex + 1}</p>
                  <button class="r2l-primary" type="button" data-play-order="${itemIndex}">Nghe câu</button>
                </div>
                <p class="mt-2 text-sm text-cream/65">${escapeHtml(item.translation_vi || '')}</p>
                <div class="mt-3 min-h-12 rounded-md border border-cream/10 bg-cream/5 p-3 text-cream" data-built="${itemIndex}"></div>
                <div class="mt-3 flex flex-wrap gap-2">
                  ${(item.scrambled_tokens || [])
                    .map(
                      (token, tokenIndex) => `
                        <button class="r2l-token" type="button" data-order-item="${itemIndex}" data-token-index="${tokenIndex}">
                          ${escapeHtml(token)}
                        </button>
                      `,
                    )
                    .join('')}
                </div>
                <p class="mt-2 hidden text-sm text-gold" data-order-hint="${itemIndex}">Gần đúng rồi, con thử đổi thứ tự nhé.</p>
              </article>
            `,
          )
          .join('')}
      </div>
    `;

    const solved = new Set();
    const picked = {};
    root.querySelectorAll('[data-play-order]').forEach((button) => {
      button.addEventListener('click', () => playAudio(activity.items[Number(button.dataset.playOrder)]?.audio_url || ''));
    });
    root.querySelectorAll('[data-order-item]').forEach((button) => {
      button.addEventListener('click', () => {
        const itemIndex = Number(button.dataset.orderItem);
        const tokenIndex = Number(button.dataset.tokenIndex);
        const item = activity.items[itemIndex];
        picked[itemIndex] = picked[itemIndex] || [];
        if (picked[itemIndex].includes(tokenIndex)) return;
        picked[itemIndex].push(tokenIndex);
        button.dataset.picked = 'true';
        const built = picked[itemIndex].map((idx) => item.scrambled_tokens[idx]).join(' ');
        root.querySelector(`[data-built="${itemIndex}"]`).textContent = built;
        if (picked[itemIndex].length === item.correct_order_indices.length) {
          const correct = item.correct_order_indices.every((idx, i) => idx === picked[itemIndex][i]);
          const questionId = `${activity.type}:${item.id || itemIndex}`;
          if (correct) {
            solved.add(itemIndex);
            clearWrongStreak(questionId);
            showReward();
          } else {
            playWrongSfx(questionId);
            root.querySelector(`[data-order-hint="${itemIndex}"]`)?.classList.remove('hidden');
            picked[itemIndex] = [];
            setTimeout(() => resetOrderCard(root, itemIndex), 500);
          }
        }
        if (solved.size === (activity.items || []).length) completeActivity(activity.type, {
          correct_count: solved.size,
          total_count: activity.items.length,
        });
      });
    });
  }

  function resetOrderCard(root, itemIndex) {
    root.querySelector(`[data-built="${itemIndex}"]`).textContent = '';
    root.querySelectorAll(`[data-order-item="${itemIndex}"]`).forEach((button) => {
      button.dataset.picked = 'false';
    });
  }

  function renderSpeakActivity(root, activity) {
    root.innerHTML = `
      <div class="mt-5 space-y-4">
        ${(activity.items || [])
          .map(
            (item, itemIndex) => `
              <article class="rounded-md border border-cream/10 bg-navy-950/45 p-4" data-speak-card="${itemIndex}">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <p class="font-bold text-cream">${escapeHtml(item.text_en)}</p>
                    <p class="mt-1 text-sm text-cream/65">${escapeHtml(item.text_vi || '')}</p>
                  </div>
                  <button class="r2l-primary" type="button" data-play-speak="${itemIndex}">Nghe</button>
                </div>
                <p class="mt-3 text-sm text-gold">${escapeHtml(item.tip_vi || '')}</p>
                <div class="r2l-rec-row" data-recorder-slot></div>
                <div class="mt-3 flex flex-wrap gap-2">
                  <button class="r2l-option" type="button" data-rate-speak="${itemIndex}" data-rate-value="ready">Con nói được</button>
                  <button class="r2l-option" type="button" data-rate-speak="${itemIndex}" data-rate-value="practice">Con luyện thêm</button>
                </div>
              </article>
            `,
          )
          .join('')}
      </div>
    `;

    const rated = new Set();
    root.querySelectorAll('[data-play-speak]').forEach((button) => {
      button.addEventListener('click', () => playAudio(activity.items[Number(button.dataset.playSpeak)]?.audio_url || ''));
    });
    root.querySelectorAll('[data-speak-card]').forEach((cardEl) => {
      const itemIndex = Number(cardEl.dataset.speakCard);
      const item = activity.items?.[itemIndex] || {};
      _r2lRenderRecorderUi(item.id || `ls_${itemIndex}`, cardEl);
    });
    root.querySelectorAll('[data-rate-speak]').forEach((button) => {
      button.addEventListener('click', () => {
        const itemIndex = Number(button.dataset.rateSpeak);
        rated.add(itemIndex);
        button.dataset.state = 'correct';
        showReward();
        if (rated.size === (activity.items || []).length) completeActivity(activity.type, {
          correct_count: rated.size,
          total_count: activity.items.length,
          self_rate: true,
        });
      });
    });
  }

  function completeActivity(type, details) {
    if (type === 'listen_and_speak') {
      _r2lCleanupRecorderState();
    }
    state.completedTypes.add(type);
    state.activityResults[type] = {
      type,
      attempted: true,
      ...details,
    };
    updateProgress();
    if (state.completedTypes.size < 4) {
      const nextIndex = Math.min(state.activityIndex + 1, 3);
      if (nextIndex !== state.activityIndex) {
        playSfx(SFX.activityComplete);
      }
      setTimeout(() => renderActivity(nextIndex), 450);
    }
  }

  function updateProgress() {
    const percent = 20 + state.completedTypes.size * 20;
    qs('#progress-fill').style.width = `${percent}%`;
    qs('#progress-label').textContent = `${percent}%`;
    qs('#submit-lesson').disabled = state.completedTypes.size < 4;
    renderStepStates();
  }

  function renderStepStates() {
    const activities = state.lesson?.activities || [];
    qsa('[data-step-button]').forEach((button, index) => {
      const type = activities[index]?.type;
      button.dataset.active = String(index === state.activityIndex);
      button.dataset.done = String(type && state.completedTypes.has(type));
    });
  }

  function showReward() {
    const tier = rollRewardTier();
    const burst = qs('#reward-burst');
    const title = qs('#reward-burst-title');
    const copy = qs('#reward-burst-copy');
    const messages = {
      common: ['Hay lắm!', 'Con vừa mở thêm năng lượng.'],
      rare: ['Combo đẹp!', 'Minny thấy con đang bắt nhịp rất tốt.'],
      legendary: ['Khoảnh khắc vàng!', 'Một cú nghe cực sáng vừa xuất hiện.'],
    };
    title.textContent = messages[tier][0];
    copy.textContent = messages[tier][1];
    burst.dataset.tier = tier;
    burst.dataset.show = 'false';
    window.setTimeout(() => {
      burst.dataset.show = 'true';
      const tierSfx = {
        common: SFX.correctCommon,
        rare: SFX.correctRare,
        legendary: SFX.correctLegendary,
      };
      playSfx(tierSfx[tier] || SFX.correctCommon);
    }, 20);
    window.setTimeout(() => {
      burst.dataset.show = 'false';
    }, 950);
  }

  function playWrongSfx(questionId) {
    if (!questionId) {
      playSfx(SFX.wrong);
      return;
    }
    const current = _r2lSfxState.wrongStreak.get(questionId) || 0;
    const next = current + 1;
    _r2lSfxState.wrongStreak.set(questionId, next);
    if (next >= 2) {
      playSfx(SFX.encouragement);
    } else {
      playSfx(SFX.wrong);
    }
  }

  function clearWrongStreak(questionId) {
    if (questionId) _r2lSfxState.wrongStreak.delete(questionId);
  }

  function playAudio(url) {
    if (!url) {
      showReward();
      return;
    }
    const audio = new Audio(url);
    audio.preload = 'auto';
    audio.play().catch(() => {
      showError('Trình duyệt chưa cho phát audio. Con bấm lại một lần nữa nhé.');
    });
  }

  qs('#submit-lesson').addEventListener('click', async () => {
    qs('#submit-lesson').disabled = true;
    qs('#submit-hint').textContent = 'Minny đang lưu kết quả...';
    try {
      const res = await fetch('/api/submit-read2lead-lesson', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          access_code: state.accessCode,
          pack_id: state.packId,
          answers: {
            schema_version: 2,
            activity_results: Object.values(state.activityResults),
          },
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok || !data.passed) throw new Error(data.message || data.error || 'Chưa lưu được.');
      const rewards = data.rewards_earned || {};
      qs('#completion-copy').textContent = `Con nhận ${rewards.coins || 0} xu và ${rewards.xp || 0} XP cho nhiệm vụ này.`;
      qs('#completion-card').classList.remove('hidden');
      updateStateHeader(data.read2lead_state);
      if (data.level_up) {
        playSfxSequence([SFX.packComplete, SFX.levelUp], 700);
      } else {
        playSfxSequence([SFX.packComplete, pickVoiceClip()], 600);
      }
      showLevelUp(data.level_up);
      showReward();
    } catch (error) {
      qs('#submit-lesson').disabled = false;
      qs('#submit-hint').textContent = error.message || 'Chưa lưu được kết quả. Anh Phương thử lại giúp con nhé.';
    }
  });

  function showError(message) {
    qs('#loading-card')?.classList.add('hidden');
    qs('#lesson-shell')?.classList.add('hidden');
    qs('#error-card')?.classList.remove('hidden');
    qs('#error-message').textContent = message;
  }

  function updateStateHeader(read2LeadState) {
    if (!read2LeadState) return;
    const header = document.querySelector('[data-r2l-state-header]');
    if (!header) return;
    header.classList.remove('hidden');
    header.classList.add('flex');
    header.querySelector('[data-r2l-level]').textContent = read2LeadState.current_level || 'LV';
    header.querySelector('[data-r2l-rank]').textContent = read2LeadState.rank_title || 'Read2Lead';
    header.querySelector('[data-r2l-xp-label]').textContent = `${read2LeadState.xp_in_level || 0}/${read2LeadState.xp_to_next_level || 60} XP`;
    header.querySelector('[data-r2l-xp-fill]').style.width = `${read2LeadState.xp_percent || 0}%`;
    header.querySelector('[data-r2l-coins]').textContent = `${read2LeadState.coins || 0} xu`;
    header.querySelector('[data-r2l-streak]').textContent = `${read2LeadState.streak_days || 0} ngày`;
  }

  function showLevelUp(levelUp) {
    if (!levelUp) return;
    const modal = qs('#level-up-modal');
    qs('#level-up-copy').textContent = `Từ ${levelUp.from_level} lên ${levelUp.to_level}. Con đã mở thêm một nấc đọc mới.`;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  qs('#level-up-close')?.addEventListener('click', () => {
    const modal = qs('#level-up-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  });
</script>
