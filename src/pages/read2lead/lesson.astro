    function sectionWrap(title, body) {
      return `<section class="mb-6 rounded-xl border border-cream-dim/20 bg-navy-950/70 p-5">${title}${body}</section>`;
    }

    function collectAnswers() {
      const answers = {
        matching: {},
        build_chunk: {},
        fill_blank: {},
        fix_chunk: {},
        chunk_in_context: {},
        dictation: {},
        best_line: {},
        story_order: {},
        comprehension: {},
        open_response: {},
      };
      document.querySelectorAll('[data-answer-type]').forEach((field) => {
        if (field.type === 'radio' && !field.checked) return;
        const type = field.getAttribute('data-answer-type');
        const index = field.getAttribute('data-answer-index');
        if (!answers[type]) answers[type] = {};
        answers[type][index] = field.value || '';
      });
      return answers;
    }

    // Per-slot subset of collectAnswers used by inline grade-slot fetch.
    function collectAnswersInSlot(slot) {
      const answers = {};
      if (!slot) return answers;
      slot.querySelectorAll('[data-answer-type]').forEach((field) => {
        if (field.type === 'radio' && !field.checked) return;
        const type = field.getAttribute('data-answer-type');
        const index = field.getAttribute('data-answer-index');
        if (!answers[type]) answers[type] = {};
        answers[type][index] = field.value || '';
      });
      return answers;
    }

    // After /api/grade-slot returns, mark wrong cells with red ring + label
    // but DO NOT clear values (kid keeps their answer to compare). The next
    // submit re-evaluates everything; the retry button from 68f04a5 still
    // handles full-clear if kid wants a clean slate.
    function markSlotWrongInline(slot, wrongItems) {
      if (!slot || !Array.isArray(wrongItems) || !wrongItems.length) return;
      // Clear stale per-slot marks from a previous "Tiếp theo" press
      slot.querySelectorAll('[data-slot-wrong]').forEach((el) => {
        el.classList.remove('ring-2', 'ring-red-500');
        el.removeAttribute('data-slot-wrong');
      });
      slot.querySelectorAll('[data-slot-wrong-label]').forEach((el) => el.remove());
      wrongItems.forEach((w) => {
        if (!w || typeof w.type !== 'string' || typeof w.index !== 'number') return;
        slot.querySelectorAll(`[data-answer-type="${w.type}"][data-answer-index="${w.index}"]`).forEach((el) => {
          el.classList.add('ring-2', 'ring-red-500');
          el.setAttribute('data-slot-wrong', '1');
          const card = el.closest('[data-shadow-card], [data-tap-card], label, fieldset');
          if (card && !card.querySelector('[data-slot-wrong-label]')) {
            const label = document.createElement('p');
            label.setAttribute('data-slot-wrong-label', '1');
            label.className = 'mt-2 text-xs font-semibold text-red-300';
            label.textContent = '🔄 Câu này cần xem lại nhé';
            card.appendChild(label);
          }
        });
      });
    }

    function showStep(name, { scroll = false } = {}) {
      if (!stepSections[name]) return;
      currentStep = name;
      stepOrder.forEach((step) => {
        stepSections[step].classList.toggle('hidden', step !== name);
      });
      stepIndicators.forEach((el) => {
        const step = el.getAttribute('data-step-indicator');
        const reached = stepOrder.indexOf(step) <= stepOrder.indexOf(name);
        el.classList.toggle('border-accent', step === name);
        el.classList.toggle('bg-accent/15', step === name);
        el.classList.toggle('text-cream', reached);
        el.classList.toggle('text-cream-dim', !reached);
      });
      if (stickyAudio && lesson?.mp3_url) {
        const showSticky = name !== 'listen';
        stickyAudio.classList.toggle('hidden', !showSticky);
        document.body.style.paddingBottom = showSticky ? '6rem' : '';
      }
      if (scroll) lessonCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function renderLesson(data) {
      lesson = data.lesson;
      assets = lesson.assets || {};
      document.getElementById('lesson-meta').textContent = `${lesson.student_name || 'Học sinh Read2Lead'} · ${lesson.level || 'L2'} · ${lesson.topic || 'Read2Lead'}`;
      document.getElementById('lesson-title').textContent = lesson.story_title || 'Bài đọc Read2Lead';
      document.getElementById('lesson-subtitle').textContent = `Mã: ${lesson.access_code_masked || '***'}`;

      const pdfLink = document.getElementById('pdf-link');
      if (lesson.pdf_url && pdfLink) {
        pdfLink.href = lesson.pdf_url;
        pdfLink.classList.remove('hidden');
      }

      if (lesson.mp3_url) {
        stepAudio.src = lesson.mp3_url;
        stepAudio.classList.remove('hidden');
        stepAudioMissing.classList.add('hidden');
        if (stickyAudioEl) stickyAudioEl.src = lesson.mp3_url;
      } else {
        stepAudio.classList.add('hidden');
        stepAudioMissing.classList.remove('hidden');
      }

      const storyActivity = lesson.activities.find((a) => a.type === 'story');
      const practiceActivities = lesson.activities.filter((a) => a.type !== 'story');
      const oldPowerChunkItems = lesson.activities.find((a) => a.id === 'power_chunks')?.items || [];
      const groupedPowerChunkItems = lesson.activities
        .find((a) => a.id === 'cum_cau_con')
        ?.parts?.find((part) => part.kind === 'chunks_glossary')
        ?.items || [];
      const powerChunkItems = oldPowerChunkItems.length ? oldPowerChunkItems : groupedPowerChunkItems;
      const chunks = powerChunkItems.map((item) => item.chunk).filter(Boolean);
      const chunkMeanings = {};
      powerChunkItems.forEach((item) => {
        if (item.chunk) chunkMeanings[item.chunk.toLowerCase().trim()] = item.meaning || '';
      });

      if (storyActivity) {
        stepReadBody.innerHTML = renderAssetHero() + storyActivity.items.map((item) => `<p class="mb-6 text-xl leading-relaxed text-cream md:text-2xl md:leading-loose">${highlightChunks(item.text, chunks)}</p>`).join('');
        stepReadBody.querySelectorAll('mark').forEach((el) => {
          el.style.cursor = 'pointer';
          el.title = chunkMeanings[el.textContent.toLowerCase().trim()] || '';
        });
      } else {
        stepReadBody.innerHTML = '<p class="text-cream-muted">Bài này chưa có truyện. Con có thể chuyển sang bước làm bài.</p>';
      }

      activitiesEl.innerHTML = practiceActivities.map((activity, index) => {
        const inner = renderActivity(activity, index + 1);
        return `<div data-activity-slot="${index}" class="${index === 0 ? '' : 'hidden'}">${inner}</div>`;
      }).join('');
      activitySequence = practiceActivities.map((activity) => activity.id || activity.type);
      currentActivityIdx = 0;
      showActivity(0);
      loadingCard.classList.add('hidden');
      lessonCard.classList.remove('hidden');

      const draft = loadDraft();
      applyDraft(draft);
      const startStep = (draft && stepOrder.includes(draft.current_step)) ? draft.current_step : 'listen';
      showStep(startStep);

      // Autosave on any input change inside practice form
      const debouncedSave = (() => {
        let t = null;
        return () => {
          if (t) clearTimeout(t);
          t = setTimeout(saveDraft, 400);
        };
      })();
      activitiesEl.addEventListener('input', debouncedSave);
      activitiesEl.addEventListener('change', debouncedSave);
    }

    const ACTIVITY_NAME_BY_ID = {
      cum_cau_con: '📚 Cụm câu của con',
      dung_cum_cau: '✏️ Dùng cụm câu',
      nghe_doc_theo: '🎧 Nghe & Đọc theo',
      hieu_truyen: '💭 Minny hỏi con xíu nhé',
      ke_chuyen_con: '✍️ Con kể cho Minny nghe',
    };
    const CELEBRATION_EMOJIS = ['🎉', '⭐', '✨', '🚀', '💪', '🌟', '🎊'];

    // ===== Proportional reward (P1.2) =====
    function getRewardTier(scorePercent, passed, totalCount) {
      if (!passed || totalCount <= 0) return { tier: 'fail', confettiCount: 0, voice: null };
      if (scorePercent === 100) return { tier: 'perfect', confettiCount: 50, voice: 'voice-xuatsac.mp3', volume: 0.7 };
      if (scorePercent >= 85) return { tier: 'great', confettiCount: 30, voice: 'voice-gioiqua.mp3', volume: 0.6 };
      return { tier: 'pass', confettiCount: 15, voice: 'voice-tuyetvoi.mp3', volume: 0.5 };
    }

    function neededForPass(correct, total) {
      if (total === 0) return 0;
      return Math.max(0, Math.ceil(0.7 * total) - correct);
    }

    function renderActivityProgress() {
      const total = activitySequence.length;
      const dotsEl = document.getElementById('activity-dots');
      const totalEl = document.getElementById('activity-total-num');
      const progressEl = document.getElementById('activity-progress');
      if (!dotsEl || !totalEl || !progressEl || total === 0) return;
      progressEl.classList.remove('hidden');
      totalEl.textContent = total;
      dotsEl.innerHTML = activitySequence.map((id, idx) => {
        const isCurrent = idx === currentActivityIdx;
        const isDone = idx < currentActivityIdx;
        const cls = isCurrent
          ? 'h-3 w-8 rounded-full bg-accent'
          : isDone
            ? 'h-3 w-3 rounded-full bg-gold-light'
            : 'h-3 w-3 rounded-full bg-cream-dim/30';
        return `<span class="${cls}" aria-label="Phần ${idx + 1}"></span>`;
      }).join('');
    }

    function showActivity(idx) {
      if (!activitySequence.length) return;
      currentActivityIdx = Math.max(0, Math.min(idx, activitySequence.length - 1));
      document.querySelectorAll('[data-activity-slot]').forEach((slot) => {
        const slotIdx = Number(slot.getAttribute('data-activity-slot'));
        slot.classList.toggle('hidden', slotIdx !== currentActivityIdx);
      });
      const currentNum = document.getElementById('activity-current-num');
      const currentName = document.getElementById('activity-current-name');
      if (currentNum) currentNum.textContent = currentActivityIdx + 1;
      if (currentName) currentName.textContent = ACTIVITY_NAME_BY_ID[activitySequence[currentActivityIdx]] || activitySequence[currentActivityIdx];
      renderActivityProgress();
      updateActivityNavButtons();
      const active = document.querySelector(`[data-activity-slot="${currentActivityIdx}"]`);
      if (active && !lessonCard.classList.contains('hidden')) active.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function updateActivityNavButtons() {
      const backBtn = document.getElementById('activity-back');
      const nextBtn = document.getElementById('activity-next');
      const submitBtnEl = document.getElementById('submit-lesson');
      if (!backBtn || !nextBtn || !submitBtnEl || !activitySequence.length) return;
      backBtn.disabled = currentActivityIdx === 0;
      backBtn.classList.toggle('opacity-40', currentActivityIdx === 0);
      const isLast = currentActivityIdx === activitySequence.length - 1;
      nextBtn.classList.toggle('hidden', isLast);
      submitBtnEl.classList.toggle('hidden', !isLast);
    }

    function isActivitySlotComplete(slot) {
      if (!slot) return true;
      const requiredFields = slot.querySelectorAll('[required]');
      if (requiredFields.length === 0) return true;
      const radioNames = new Set();
      for (const field of requiredFields) {
        if (field.type === 'radio') {
          radioNames.add(field.name);
          continue;
        }
        if (!field.value || !field.value.trim()) return false;
      }
      for (const name of radioNames) {
        if (!slot.querySelector(`input[name="${CSS.escape(name)}"]:checked`)) return false;
      }
      return true;
    }

    function findFirstEmpty(slot) {
      if (!slot) return null;
      const required = slot.querySelectorAll('[required]');
      for (const field of required) {
        if (field.type === 'radio') {
          if (!slot.querySelector(`input[name="${CSS.escape(field.name)}"]:checked`)) return field;
        } else if (!field.value || !field.value.trim()) {
          return field;
        }
      }
      return null;
    }

    function shakeField(field) {
      if (!field) return;
      const target = field.closest('label, fieldset, [data-shadow-card], [data-tap-card], [data-activity-slot] > *') || field;
      target.classList.add('r2l-shake');
      setTimeout(() => target.classList.remove('r2l-shake'), 600);
    }

    function showToast(message, duration = 2200) {
      let toast = document.getElementById('r2l-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'r2l-toast';
        toast.className = 'fixed left-1/2 top-6 z-[60] -translate-x-1/2 rounded-lg border border-gold/40 bg-navy-900/95 px-5 py-3 font-semibold text-cream shadow-2xl';
        document.body.appendChild(toast);
      }
      toast.textContent = message;
      toast.style.opacity = '1';
      setTimeout(() => { toast.style.transition = 'opacity 0.4s'; toast.style.opacity = '0'; }, duration);
    }

    function showMascotClapCorner() {
      if (!assets?.minny_clap) return;
      const img = document.createElement('img');
      img.src = assets.minny_clap;
      img.alt = '';
      img.className = 'r2l-mascot-pop-corner fixed right-4 top-20 z-[60] h-24 w-auto';
      document.body.appendChild(img);
      setTimeout(() => img.remove(), 1000);
    }

    function showCelebration(text) {
      const overlay = document.getElementById('celebration-overlay');
      const emojiEl = document.getElementById('celebration-emoji');
      const textEl = document.getElementById('celebration-text');
      if (!overlay || !emojiEl || !textEl) return;
      emojiEl.textContent = randomFrom(CELEBRATION_EMOJIS);
      textEl.textContent = text || 'Tuyệt vời!';
      overlay.classList.remove('hidden');
      const popEl = overlay.querySelector('.r2l-reward-pop');
      if (popEl) {
        popEl.classList.remove('r2l-reward-pop');
        void popEl.offsetWidth;
        popEl.classList.add('r2l-reward-pop');
      }
      setTimeout(() => overlay.classList.add('hidden'), 1500);
    }

    async function goNextActivity() {
      const slot = document.querySelector(`[data-activity-slot="${currentActivityIdx}"]`);
      if (!isActivitySlotComplete(slot)) {
        playSoftBoop();
        showToast('Con thử trả lời thêm vài câu nhé! 💪');
        const empty = findFirstEmpty(slot);
        if (empty) {
          shakeField(empty);
          empty.scrollIntoView({ behavior: 'smooth', block: 'center' });
          if (typeof empty.focus === 'function') {
            try { empty.focus({ preventScroll: true }); } catch { empty.focus(); }
          }
        }
        return;
      }
      // Inline per-slot grade so kid sees what to review before advancing.
      // Fail-open: any network/api error just skips the inline mark and advances.
      const nextBtn = document.getElementById('activity-next');
      const slotId = activitySequence[currentActivityIdx];
      let wrongItems = [];
      const originalLabel = nextBtn ? nextBtn.textContent : '';
      if (nextBtn) {
        nextBtn.disabled = true;
        nextBtn.textContent = 'Minny đang xem… 👀';
      }
      try {
        const res = await fetch('/api/grade-slot', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            access_code: accessCode,
            pack_id: packId,
            slot_id: slotId,
            answers: collectAnswersInSlot(slot),
          }),
        });
        if (res.ok) {
          const data = await res.json().catch(() => ({}));
          if (data && Array.isArray(data.wrong_items)) wrongItems = data.wrong_items;
        }
      } catch (err) {
        console.warn('[grade-slot] fetch failed, advancing without inline grade:', err);
      } finally {
        if (nextBtn) {
          nextBtn.disabled = false;
          nextBtn.textContent = originalLabel;
        }
      }
      if (wrongItems.length) {
        playSoftBoop();
        markSlotWrongInline(slot, wrongItems);
        showToast(`Còn ${wrongItems.length} câu nữa muốn ghé. Con thử lại hoặc qua tiếp cũng được 🌟`, 1000);
      } else {
        playSfx('success-1.mp3', 0.6);
        spawnConfetti(15);
        showMascotClapCorner();
        showToast('Tuyệt vời! 💯', 1800);
        const voiceText = playPageComplete();
        showCelebration(voiceText);
      }
      if (currentActivityIdx < activitySequence.length - 1) {
        currentActivityIdx += 1;
        setTimeout(() => showActivity(currentActivityIdx), 900);
      } else {
        updateActivityNavButtons();
      }
    }

    function goBackActivity() {
      if (currentActivityIdx === 0) return;
      currentActivityIdx -= 1;
      showActivity(currentActivityIdx);
    }

    document.addEventListener('DOMContentLoaded', () => {
      const nextBtn = document.getElementById('activity-next');
      const backBtn = document.getElementById('activity-back');
      if (nextBtn) nextBtn.addEventListener('click', goNextActivity);
      if (backBtn) backBtn.addEventListener('click', goBackActivity);
    });

    document.querySelectorAll('[data-step-next]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.getAttribute('data-step-next');
        const nowIso = new Date().toISOString();
        if (currentStep === 'listen' && !listenCompletedAt) listenCompletedAt = nowIso;
        if (currentStep === 'read' && !readCompletedAt) readCompletedAt = nowIso;
        showStep(next, { scroll: true });
        saveDraft();
      });
    });

    document.querySelectorAll('[data-step-back]').forEach((btn) => {
      btn.addEventListener('click', () => showStep(btn.getAttribute('data-step-back'), { scroll: true }));
    });

    document.querySelectorAll('[data-step-jump]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!lesson) return;
        showStep(btn.getAttribute('data-step-jump'), { scroll: true });
      });
    });

    activitiesEl.addEventListener('click', async (event) => {
      const chip = event.target.closest('[data-tap-word]');
      if (chip) {
        const sentenceIdx = chip.getAttribute('data-tap-sentence');
        const source = chip.getAttribute('data-tap-source');
        const card = chip.closest('[data-tap-card]');
        if (!card) return;
        const answerArea = card.querySelector(`[data-tap-answer="${sentenceIdx}"]`);
        const poolArea = card.querySelector(`[data-tap-pool="${sentenceIdx}"]`);
        const hiddenInput = card.querySelector(`input[data-answer-type="dictation"][data-answer-index="${sentenceIdx}"]`);
        if (!answerArea || !poolArea || !hiddenInput) return;
        if (source === 'pool') {
          chip.setAttribute('data-tap-source', 'answer');
          answerArea.appendChild(chip);
        } else {
          chip.setAttribute('data-tap-source', 'pool');
          poolArea.appendChild(chip);
        }
        const words = Array.from(answerArea.querySelectorAll('[data-tap-word]')).map((el) => el.getAttribute('data-tap-word-text') || '');
        hiddenInput.value = words.join(' ');
        hiddenInput.dispatchEvent(new Event('input', { bubbles: true }));
        return;
      }

      const listenBtn = event.target.closest('[data-sentence-listen]');
      if (listenBtn) {
        const url = listenBtn.getAttribute('data-sentence-listen');
        if (!url) return;
        try {
          if (sentenceListenAudio) {
            sentenceListenAudio.pause();
            sentenceListenAudio.currentTime = 0;
          }
          sentenceListenAudio = new Audio(url);
          await sentenceListenAudio.play();
        } catch (err) {
          console.warn('[sentence-listen] play failed:', err);
        }
        return;
      }

      const voiceBtn = event.target.closest('[data-voice-record]');
      if (voiceBtn) {
        const type = voiceBtn.getAttribute('data-voice-target-type');
        const idx = voiceBtn.getAttribute('data-voice-target-index');
        if (!type || idx === null) return;
        const key = `${type}:${idx}`;
        const existing = voiceRecordings.get(key);
        if (existing?.mediaRecorder && existing.mediaRecorder.state === 'recording') {
          existing.mediaRecorder.stop();
          return;
        }

        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          const chunks = [];
          const mediaRecorder = new MediaRecorder(stream);
          mediaRecorder.addEventListener('dataavailable', (e) => {
            if (e.data.size > 0) chunks.push(e.data);
          });
          mediaRecorder.addEventListener('stop', () => {
            const blob = new Blob(chunks, { type: mediaRecorder.mimeType || 'audio/webm' });
            const blobUrl = URL.createObjectURL(blob);
            const prev = voiceRecordings.get(key);
            if (prev?.blobUrl) URL.revokeObjectURL(prev.blobUrl);
            voiceRecordings.set(key, { mediaRecorder: null, blobUrl });
            const textarea = document.querySelector(`textarea[data-answer-type="${CSS.escape(type)}"][data-answer-index="${CSS.escape(idx)}"]`);
            if (textarea) {
              const seconds = Math.max(1, Math.round(blob.size / 16000));
              if (!textarea.value.trim()) {
                textarea.value = `[Con đã ghi âm câu trả lời ${seconds} giây — bố mẹ nghe lại với con]`;
                textarea.dispatchEvent(new Event('input', { bubbles: true }));
              }
              let audio = textarea.parentElement.querySelector('audio[data-voice-playback]');
              if (!audio) {
                audio = document.createElement('audio');
                audio.setAttribute('data-voice-playback', '1');
                audio.controls = true;
                audio.className = 'mt-2 w-full';
                textarea.parentElement.appendChild(audio);
              }
              audio.src = blobUrl;
            }
            voiceBtn.textContent = '🎤';
            stream.getTracks().forEach((track) => track.stop());
          });
          voiceRecordings.set(key, { mediaRecorder, blobUrl: existing?.blobUrl || null });
          voiceBtn.textContent = '⏹ Dừng';
          mediaRecorder.start();
        } catch (err) {
          console.warn('[voice-record] mic permission denied or unavailable:', err);
          showToast('Bố mẹ cho phép microphone để con nói nhé');
        }
        return;
      }

      const recordBtn = event.target.closest('[data-shadow-record]');
      if (recordBtn) {
        const card = recordBtn.closest('[data-shadow-card]');
        if (!card) return;
        const idx = card.getAttribute('data-shadow-index');
        const status = card.querySelector('[data-shadow-status]');
        const playback = card.querySelector('[data-shadow-playback]');
        const existing = shadowRecordings.get(idx);

        if (existing?.mediaRecorder && existing.mediaRecorder.state === 'recording') {
          existing.mediaRecorder.stop();
          return;
        }

        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          const chunks = [];
          const mediaRecorder = new MediaRecorder(stream);
          mediaRecorder.addEventListener('dataavailable', (e) => {
            if (e.data.size > 0) chunks.push(e.data);
          });
          mediaRecorder.addEventListener('stop', () => {
            const blob = new Blob(chunks, { type: mediaRecorder.mimeType || 'audio/webm' });
            const blobUrl = URL.createObjectURL(blob);
            const prev = shadowRecordings.get(idx);
            if (prev?.blobUrl) URL.revokeObjectURL(prev.blobUrl);
            shadowRecordings.set(idx, { mediaRecorder: null, chunks: [], stream: null, blobUrl });
            if (playback) {
              playback.src = blobUrl;
              playback.classList.remove('hidden');
            }
            if (status) status.textContent = '✅ Đã ghi âm — bấm ▶ nghe lại';
            recordBtn.textContent = '🎤 Đọc lại';
            stream.getTracks().forEach((track) => track.stop());
          });
          mediaRecorder.start();
          shadowRecordings.set(idx, { mediaRecorder, chunks, stream });
          recordBtn.textContent = '⏹ Dừng ghi';
          if (status) status.textContent = '🔴 Đang ghi âm...';
        } catch (err) {
          if (status) status.textContent = 'Không mở được micro. Cho phép quyền rồi thử lại.';
        }
      }
    });

    async function loadLesson() {
      if (!accessCode || !packId) {
        loadingCard.classList.add('hidden');
        missingLinkCard.classList.remove('hidden');
        return;
      }

      try {
        const res = await fetch(`/api/read2lead-lesson?code=${encodeURIComponent(accessCode)}&pack_id=${encodeURIComponent(packId)}`);
        const data = await res.json();
        if (!res.ok || !data.ok) {
          showError(data.message || 'Không mở được bài này.');
          return;
        }
        renderLesson(data);
      } catch {
        showError('Mạng không ổn định. Vui lòng thử lại.');
      }
    }

    function spawnConfetti(count = 25) {
      const emojis = ['⭐', '🎉', '✨', '🌟', '💫', '🏆'];
      for (let i = 0; i < count; i += 1) {
        const el = document.createElement('div');
        el.className = 'r2l-confetti';
        el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        el.style.left = `${Math.random() * 100}%`;
        el.style.animationDelay = `${Math.random() * 0.9}s`;
        el.style.animationDuration = `${2.4 + Math.random() * 1.6}s`;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 4800);
      }
    }

    function showMascotDance() {
      if (!assets?.minny_dance) return;
      const img = document.createElement('img');
      img.src = assets.minny_dance;
      img.alt = '';
      img.className = 'r2l-mascot-pop fixed left-1/2 top-1/2 z-[60] h-48 w-auto -translate-x-1/2 -translate-y-1/2';
      document.body.appendChild(img);
      setTimeout(() => img.remove(), 1800);
    }

    function renderResult(result) {
      const sections = Array.isArray(result.sections) ? result.sections : [];
      const feedbackVi = result.review?.feedback_vi || {};
      const miniVi = result.review?.mini_practice_vi || {};
      const passed = Boolean(result.passed);
      const scorePercent = result.score_percent || 0;
      const totalCount = result.total_count || 0;
      const correctCount = result.correct_count || 0;
      const reward = getRewardTier(scorePercent, passed, totalCount);
      const needed = neededForPass(correctCount, totalCount);

      let headingText;
      let headingClass;
      if (!passed) {
        headingText = needed === 0
          ? 'Con sắp pass rồi — sửa 1 chút thôi! 💪'
          : `Cố lên! Còn ${needed} câu nữa là pass 💪`;
        headingClass = 'font-display text-3xl font-bold leading-snug text-cream';
      } else if (reward.tier === 'perfect') {
        headingText = 'Siêu sao! 💯⭐';
        headingClass = 'r2l-reward-pop font-display text-5xl font-bold leading-snug text-gold-light md:text-6xl';
      } else {
        headingText = 'Con được 1 sao! 🌟';
        headingClass = 'r2l-reward-pop font-display text-4xl font-bold leading-snug text-gold-light md:text-5xl';
      }
      const missionBox = passed ? `
        <div class="mt-6 rounded-lg border border-accent/30 bg-accent/10 p-5">
          <p class="font-display text-lg font-bold text-cream">Mission Complete ✨</p>
          <ul class="mt-3 space-y-2 text-cream-muted">
            <li>✅ Con đã nghe câu chuyện</li>
            <li>✅ Con đã đọc to câu chuyện</li>
            <li>✅ Con đã làm bài luyện tập (${scorePercent}%)</li>
            <li>⭐ Con được +1 sao!</li>
          </ul>
        </div>
      ` : `
        <div class="mt-6 rounded-lg border border-gold/30 bg-gold/10 p-5">
          <p class="font-display text-lg font-bold text-cream">Mission In Progress</p>
          <ul class="mt-3 space-y-2 text-cream-muted">
            <li>✅ Con đã nghe câu chuyện</li>
            <li>✅ Con đã đọc to câu chuyện</li>
            <li>✅ Con đã làm bài luyện tập (${scorePercent}%)</li>
            <li>💪 ${needed === 0 ? 'Con sắp pass rồi — sửa 1 chút và nộp lại!' : `Con chỉ cần đúng thêm <strong class="text-gold-light">${needed}</strong> câu nữa là pass!`}</li>
          </ul>
        </div>
      `;
      const recommendationsHtml = `
        <div class="mt-6 grid gap-3 md:grid-cols-3">
          <div class="rounded-lg border border-cream-dim/20 bg-navy-900/70 p-4">
            <p class="text-xs uppercase tracking-wide text-cream-dim">Điểm tốt</p>
            <p class="mt-2 text-sm text-cream">${escapeHtml(feedbackVi.strength || 'Con đã hoàn thành bài đầy đủ.')}</p>
          </div>
          <div class="rounded-lg border border-cream-dim/20 bg-navy-900/70 p-4">
            <p class="text-xs uppercase tracking-wide text-cream-dim">Cần luyện</p>
            <p class="mt-2 text-sm text-cream">${escapeHtml(feedbackVi.practice || 'Con có thể nghe lại MP3 chậm hơn lần sau.')}</p>
          </div>
          <div class="rounded-lg border border-cream-dim/20 bg-navy-900/70 p-4">
            <p class="text-xs uppercase tracking-wide text-cream-dim">Level</p>
            <p class="mt-2 text-sm text-cream">${escapeHtml(levelRecommendationText(result.review?.level_recommendation))}</p>
          </div>
        </div>
      `;
      // Detect packs with data inconsistency: any section where actual graded count < UI render count
      const renderedCounts = {
        matching: (result.sections.find((section) => section.id === 'matching')?.total) ?? null,
        fill_blank: (result.sections.find((section) => section.id === 'fill_blank')?.total) ?? null,
        chunk_in_context: (result.sections.find((section) => section.id === 'chunk_in_context')?.total) ?? null,
        best_line: (result.sections.find((section) => section.id === 'best_line')?.total) ?? null,
      };
      void renderedCounts;
      // If any section has total smaller than what was rendered to kid, surface a friendly notice
      // (we don't have direct access to render counts here; rely on console.warn for diagnostics)
      const miniPracticeHtml = (miniVi.read_again || miniVi.chunk_to_practice || miniVi.parent_question) ? `
        <div class="mt-4 rounded-lg border border-accent/30 bg-accent/10 p-4">
          <p class="font-semibold text-cream">5 phút luyện thêm</p>
          <ul class="mt-2 space-y-2 text-sm text-cream-muted">
            <li><strong class="text-cream">Đọc lại:</strong> ${escapeHtml(miniVi.read_again || 'Một câu trong truyện.')}</li>
            <li><strong class="text-cream">Cụm cần luyện:</strong> ${escapeHtml(miniVi.chunk_to_practice || 'Một cụm trong bài.')}</li>
            <li><strong class="text-cream">Bố mẹ hỏi:</strong> ${escapeHtml(miniVi.parent_question || 'Con kể lại chuyện gì xảy ra nhé?')}</li>
          </ul>
        </div>
      ` : '';
      resultCard.innerHTML = `
        <h2 class="${headingClass}">${headingText}</h2>
        ${missionBox}
        ${recommendationsHtml}
        ${miniPracticeHtml}
        <p class="mt-3 text-lg text-cream-muted">Điểm: <strong class="text-gold-light">${scorePercent}%</strong> · Đúng ${result.correct_count || 0}/${result.total_count || 0} phần được chấm</p>
        <div class="mt-5 grid gap-3 md:grid-cols-2">
          ${sections.map((section) => {
            const wrongCount = Array.isArray(section.wrong_items) ? section.wrong_items.length : 0;
            const wrongLabel = (!section.passed && wrongCount > 0)
              ? `<p class="mt-1 text-xs text-red-200">Câu cần xem lại: ${section.wrong_items.map((w) => Number(w.index) + 1).join(', ')}</p>`
              : '';
            return `
              <div class="rounded-lg border ${section.passed ? 'border-green-500/30 bg-green-500/10' : 'border-red-500/30 bg-red-500/10'} p-4">
                <p class="font-semibold ${section.passed ? 'text-green-300' : 'text-red-300'}">${section.passed ? '✅' : '🔄'} ${escapeHtml(section.title)}</p>
                <p class="mt-1 text-sm text-cream-muted">${section.correct}/${section.total} đúng</p>
                ${wrongLabel}
              </div>
            `;
          }).join('')}
        </div>
        <div class="mt-5 rounded-lg border border-cream-dim/20 bg-navy-950/70 p-4">
          <p class="font-semibold text-cream">${escapeHtml(feedbackVi.summary || result.message || '')}</p>
          <p class="mt-2 text-sm leading-relaxed text-cream-muted">${escapeHtml(feedbackVi.parent_next_step || (passed ? 'Bố mẹ có thể tạo bài tiếp theo cho con.' : 'Bố mẹ cho con sửa lại rồi nộp lại nhé.'))}</p>
        </div>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          ${passed ? '<a href="/read2lead#form" class="inline-flex justify-center rounded-lg bg-accent px-5 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Khám phá bài mới 🚀</a>' : '<button id="retry-lesson" type="button" class="inline-flex justify-center rounded-lg bg-accent px-5 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">🔄 Xem lại vài câu</button>'}
          <a href="/read2lead/review" class="inline-flex justify-center rounded-lg border border-gold px-5 py-3 font-semibold text-gold-light transition hover:bg-gold hover:text-navy-950">Khoe Felixar cho ba mẹ xem 🌟</a>
        </div>
      `;
      resultCard.classList.remove('hidden');
      resultCard.scrollIntoView({ behavior: 'smooth' });
      if (reward.confettiCount > 0) spawnConfetti(reward.confettiCount);
      if (passed) {
        playFinalReward(reward.volume || 0.6);
        showMascotDance();
        if (reward.voice) setTimeout(() => playSfx(reward.voice, 0.75), 600);
      }
      const retry = document.getElementById('retry-lesson');
      if (retry) retry.addEventListener('click', () => highlightAndJumpToWrong(sections));
    }

    // Section ID -> activity slot ID mapping (cluster 4 has 2 sections in 1 slot)
    const SECTION_TO_SLOT_ID = {
      cum_cau_con: 'cum_cau_con',
      dung_cum_cau: 'dung_cum_cau',
      nghe_doc_theo: 'nghe_doc_theo',
      hieu_truyen_best: 'hieu_truyen',
      hieu_truyen_text: 'hieu_truyen',
      ke_chuyen_con: 'ke_chuyen_con',
    };

    function highlightAndJumpToWrong(sections) {
      // Clear stale highlights from previous attempt
      document.querySelectorAll('[data-wrong-marked]').forEach((el) => {
        el.classList.remove('ring-2', 'ring-red-500', 'border-red-500');
        el.removeAttribute('data-wrong-marked');
      });
      const failed = (sections || []).filter((s) => !s.passed && Array.isArray(s.wrong_items) && s.wrong_items.length);
      if (!failed.length) {
        lessonCard.scrollIntoView({ behavior: 'smooth' });
        return;
      }
      let firstWrongEl = null;
      failed.forEach((section) => {
        section.wrong_items.forEach((item) => {
          const type = item && item.type;
          const idx = item && item.index;
          if (typeof type !== 'string' || typeof idx !== 'number') return;
          document.querySelectorAll(`[data-answer-type="${type}"][data-answer-index="${idx}"]`).forEach((el) => {
            el.setAttribute('data-wrong-marked', '1');
            // Visual: red ring around the input
            el.classList.add('ring-2', 'ring-red-500');
            // Clear the value so kid re-answers
            if (el.tagName === 'SELECT') {
              el.value = '';
            } else if (el.tagName === 'TEXTAREA') {
              el.value = '';
            } else if (el.tagName === 'INPUT') {
              if (el.type === 'radio') {
                el.checked = false;
                // For tap-words hidden input, also clear the visual answer slots
                if (el.getAttribute('data-answer-type') === 'dictation') el.value = '';
              } else {
                el.value = '';
              }
            }
            // Mark surrounding card too
            const card = el.closest('[data-shadow-card], [data-tap-card], label, fieldset');
            if (card) {
              card.classList.add('border-red-500');
              card.setAttribute('data-wrong-marked', '1');
            }
            if (!firstWrongEl) firstWrongEl = el;
          });
          // Tap-words special: clear visible answer pool + reset pool chips
          if (type === 'dictation') {
            const tapCard = document.querySelector(`[data-tap-card-index="${idx}"]`);
            if (tapCard) {
              const answerBox = tapCard.querySelector(`[data-tap-answer="${idx}"]`);
              if (answerBox) answerBox.innerHTML = '';
              tapCard.querySelectorAll('[data-tap-word][data-tap-source="answer"]').forEach((chip) => {
                chip.setAttribute('data-tap-source', 'pool');
                const pool = tapCard.querySelector(`[data-tap-pool="${idx}"]`);
                if (pool) pool.appendChild(chip);
              });
            }
          }
        });
      });
      // Jump pagination to the slot containing the first failed section
      const firstFailedSection = failed[0];
      const targetSlotId = SECTION_TO_SLOT_ID[firstFailedSection.id];
      if (targetSlotId && Array.isArray(activitySequence)) {
        const slotIdx = activitySequence.indexOf(targetSlotId);
        if (slotIdx >= 0 && typeof showActivity === 'function') {
          showActivity(slotIdx);
        }
      }
      // Scroll to first wrong input
      setTimeout(() => {
        if (firstWrongEl && typeof firstWrongEl.scrollIntoView === 'function') {
          firstWrongEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          lessonCard.scrollIntoView({ behavior: 'smooth' });
        }
      }, 50);
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!lesson) return;
      resultCard.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Minny đang xem... 👀';

      try {
        const res = await fetch('/api/submit-read2lead-lesson', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            access_code: accessCode,
            pack_id: packId,
            answers: collectAnswers(),
            steps: {
              listen_completed_at: listenCompletedAt,
              read_completed_at: readCompletedAt,
            },
          }),
        });
        const result = await res.json();
        if (!res.ok || !result.ok) {
          showError(result.message || 'Chưa nộp được bài. Vui lòng thử lại.');
          return;
        }
        if (result.passed) clearDraft();
        renderResult(result);
      } catch {
        showError('Mạng không ổn định. Vui lòng thử lại.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Nộp bài 🚀';
      }
    });

    loadLesson();
  </script>
</BaseLayout>
