                            type="button"
                            data-order-slot="${itemIndex}"
                            data-slot-index="${slotIndex}"
                            data-filled="false"
                            aria-label="Ô số ${slotIndex + 1}"
                          >Ô ${slotIndex + 1}</button>
                        `,
                      )
                      .join('')}
                  </div>
                </div>
                <div class="mt-3 flex flex-wrap gap-2" data-order-tokens="${itemIndex}">
                  ${(item.scrambled_tokens || [])
                    .map(
                      (token, tokenIndex) => `
                        <button class="r2l-token" type="button" draggable="true" data-order-item="${itemIndex}" data-token-index="${tokenIndex}">
                          ${escapeHtml(token)}
                        </button>
                      `,
                    )
                    .join('')}
                </div>
                <p class="mt-2 hidden text-sm text-gold" data-order-hint="${itemIndex}">${isW1() ? 'Từ màu cam chưa đúng chỗ' : 'Gần đúng rồi, con thử đổi thứ tự nhé.'}</p>
                <p class="r2l-w1-copy-ghost hidden" data-order-ghost="${itemIndex}"></p>
              </article>
            `,
          )
          .join('')}
      </div>
    `;

    const solved = new Set();
    const attempted = new Set();
    let wrongCount = 0;
    const picked = {};
    const wrongSignatures = {};
    const itemWrongCounts = new Map();
    const heard = new Set();
    let draggedToken = null;

    function saveOrderProgress() {
      patchActivityProgress(activity.type, {
        solved: Array.from(solved),
        attempted: Array.from(attempted),
        heard: Array.from(heard),
        wrong_count: wrongCount,
        picked: JSON.parse(JSON.stringify(picked)),
      });
    }

    const savedOrder = state.activityProgress[activity.type];
    if (savedOrder) {
      (savedOrder.solved || []).forEach((itemIndex) => solved.add(itemIndex));
      (savedOrder.attempted || []).forEach((itemIndex) => attempted.add(itemIndex));
      normalizeDictationHeard(savedOrder.heard, (activity.items || []).length)
        .forEach((itemIndex) => heard.add(itemIndex));
      wrongCount = Number(savedOrder.wrong_count || 0);
      Object.entries(savedOrder.picked || {}).forEach(([itemIndex, slots]) => {
        picked[itemIndex] = Array.isArray(slots) ? slots.slice() : slots;
        const isSolved = solved.has(Number(itemIndex));
        renderOrderSlots(root, activity, picked, Number(itemIndex), isSolved);
        if (isSolved) {
          root.querySelector(`[data-order-hint="${itemIndex}"]`)?.classList.add('hidden');
        }
      });
    }

    function updateDictationGate(itemIndex) {
      const item = activity.items[itemIndex];
      const url = item?.audio_url || '';
      const hasAudio = Boolean(url) && !isRewardSfxUrl(url);
      const hasProgress = solved.has(itemIndex)
        || attempted.has(itemIndex)
        || hasDictationProgress(picked[itemIndex]);
      const unlocked = canUseDictationItem({
        hasAudio,
        heard: heard.has(itemIndex),
        hasProgress,
      });
      const card = root.querySelector(`[data-order-card="${itemIndex}"]`);
      const status = root.querySelector(`[data-dictation-status="${itemIndex}"]`);
      if (card) card.dataset.dictationLocked = unlocked ? 'false' : 'true';
      if (status) {
        status.textContent = !hasAudio
          ? 'Câu này chưa có audio. Con vẫn có thể xếp từ nhé.'
          : unlocked
            ? 'Đã nghe. Con xếp từ theo đúng thứ tự nhé.'
            : 'Bước 1: Con nghe câu trước nhé.';
      }
      root.querySelectorAll(`[data-order-slot="${itemIndex}"]`).forEach((slot) => {
        slot.disabled = !unlocked || attempted.has(itemIndex);
        if (!unlocked) slot.draggable = false;
      });
      root.querySelectorAll(`[data-order-item="${itemIndex}"]`).forEach((button) => {
        button.disabled = !unlocked || attempted.has(itemIndex);
        button.draggable = unlocked && !attempted.has(itemIndex);
      });
      return unlocked;
    }

    (activity.items || []).forEach((_, itemIndex) => updateDictationGate(itemIndex));

    function afterCheck(itemIndex) {
      if (attempted.size === (activity.items || []).length) {
        completeActivity(activity.type, {
          correct_count: solved.size,
          total_count: activity.items.length,
          wrong_count: wrongCount,
        });
      }
    }

    function revealCorrectOrder(itemIndex) {
      if (attempted.has(itemIndex)) return;
      const item = activity.items[itemIndex];
      const questionId = `${activity.type}:${item.id || itemIndex}`;
      if (isW1()) {
        const ghost = root.querySelector(`[data-order-ghost="${itemIndex}"]`);
        if (ghost) {
          ghost.textContent = item.original_sentence || '';
          ghost.classList.remove('hidden');
        }
        root.querySelector(`[data-order-hint="${itemIndex}"]`)?.classList.remove('hidden');
        w1RecordQuestionOutcome(activity.type, questionId, 'revealed', 2);
        return;
      }
      attempted.add(itemIndex);
      picked[itemIndex] = item.correct_order_indices.slice();
      renderOrderSlots(root, activity, picked, itemIndex, true);
      root.querySelector(`[data-order-hint="${itemIndex}"]`)?.classList.add('hidden');
      saveOrderProgress();
    }

    function w1CompleteCopyMode(itemIndex) {
      if (attempted.has(itemIndex)) return;
      attempted.add(itemIndex);
      const item = activity.items[itemIndex];
      if (Array.isArray(item.correct_order_indices)) {
        picked[itemIndex] = item.correct_order_indices.slice();
      }
      // Clear any stale orange left by earlier wrong attempts.
      root.querySelectorAll(`[data-order-slot="${itemIndex}"]`).forEach((s) => { s.dataset.misplaced = 'false'; });
      renderOrderSlots(root, activity, picked, itemIndex, true);
      root.querySelector(`[data-order-hint="${itemIndex}"]`)?.classList.add('hidden');
      root.querySelector(`[data-order-ghost="${itemIndex}"]`)?.classList.add('hidden');
      solved.add(itemIndex);
      saveOrderProgress();
      afterCheck(itemIndex);
    }

    root.querySelectorAll('[data-play-order]').forEach((button) => {
      const itemIndex = Number(button.dataset.playOrder);
      const item = activity.items[itemIndex];
      const url = item?.audio_url || '';
      setLessonPlayButtonState(button, url);
      button.addEventListener('click', () => {
        heard.add(itemIndex);
        button.dataset.audioDefaultLabel = 'Nghe lại';
        updateDictationGate(itemIndex);
        saveOrderProgress();
        const liveRegion = document.querySelector('[data-dictation-live]');
        if (liveRegion) liveRegion.textContent = `Đã mở câu ${itemIndex + 1}. Con bắt đầu xếp từ nhé.`;
        playAudio(url, button);
      });
    });
    root.querySelectorAll('[data-order-slot]').forEach((slot) => {
      const itemIndex = Number(slot.dataset.orderSlot);
      const slotIndex = Number(slot.dataset.slotIndex);
      slot.addEventListener('click', () => {
        if (attempted.has(itemIndex) || !updateDictationGate(itemIndex)) return;
        removeOrderToken(root, activity, picked, itemIndex, slotIndex, solved);
        saveOrderProgress();
      });
      slot.addEventListener('dragstart', (event) => {
        if (attempted.has(itemIndex) || !updateDictationGate(itemIndex)) return;
        const st = picked[itemIndex] || [];
        const tokenIndex = st[slotIndex];
        if (tokenIndex == null) return;
        draggedToken = { itemIndex, tokenIndex, fromSlot: slotIndex };
        event.dataTransfer?.setData('text/plain', JSON.stringify(draggedToken));
      });
      slot.addEventListener('dragover', (event) => {
        if (!updateDictationGate(itemIndex)) return;
        event.preventDefault();
        slot.dataset.dropActive = 'true';
      });
      slot.addEventListener('dragleave', () => {
        slot.dataset.dropActive = 'false';
      });
      slot.addEventListener('drop', (event) => {
        event.preventDefault();
        slot.dataset.dropActive = 'false';
        if (attempted.has(itemIndex) || !updateDictationGate(itemIndex)) return;
        const payload = readOrderDragPayload(event, draggedToken);
        if (!payload || payload.itemIndex !== itemIndex) return;
        placeOrderToken(root, activity, picked, itemIndex, payload.tokenIndex, slotIndex, solved);
        checkOrderItem(root, activity, picked, wrongSignatures, solved, itemIndex, () => {
          wrongCount += 1;
          const itemWrongs = (itemWrongCounts.get(itemIndex) || 0) + 1;
          itemWrongCounts.set(itemIndex, itemWrongs);
          if (itemWrongs >= MAX_WRONG_PER_ITEM) revealCorrectOrder(itemIndex);
        }, () => w1CompleteCopyMode(itemIndex));
        if (!attempted.has(itemIndex) && solved.has(itemIndex)) attempted.add(itemIndex);
        saveOrderProgress();
        afterCheck(itemIndex);
      });
    });
    root.querySelectorAll('[data-order-item]').forEach((button) => {
      button.addEventListener('dragstart', (event) => {
        const itemIndex = Number(button.dataset.orderItem);
        if (!updateDictationGate(itemIndex)) {
          event.preventDefault();
          return;
        }
        draggedToken = {
          itemIndex,
          tokenIndex: Number(button.dataset.tokenIndex),
          fromSlot: null,
        };
        event.dataTransfer?.setData('text/plain', JSON.stringify(draggedToken));
      });
      button.addEventListener('dragend', () => {
        draggedToken = null;
      });
      button.addEventListener('click', () => {
        const itemIndex = Number(button.dataset.orderItem);
        if (attempted.has(itemIndex) || !updateDictationGate(itemIndex)) return;
        const tokenIndex = Number(button.dataset.tokenIndex);
        const item = activity.items[itemIndex];
        const st = ensureOrderState(picked, itemIndex, item.scrambled_tokens.length);
        if (st.includes(tokenIndex)) return;
        const firstEmptySlot = firstEmptyDictationSlot(st);
        if (firstEmptySlot === -1) return;
        placeOrderToken(root, activity, picked, itemIndex, tokenIndex, firstEmptySlot, solved);
        checkOrderItem(root, activity, picked, wrongSignatures, solved, itemIndex, () => {
          wrongCount += 1;
          const itemWrongs = (itemWrongCounts.get(itemIndex) || 0) + 1;
          itemWrongCounts.set(itemIndex, itemWrongs);
          if (itemWrongs >= MAX_WRONG_PER_ITEM) revealCorrectOrder(itemIndex);
        }, () => w1CompleteCopyMode(itemIndex));
        if (!attempted.has(itemIndex) && solved.has(itemIndex)) attempted.add(itemIndex);
        saveOrderProgress();
        afterCheck(itemIndex);
      });
    });

    if (savedOrder && attempted.size === (activity.items || []).length && !state.completedTypes.has(activity.type)) {
      completeActivity(activity.type, {
        correct_count: solved.size,
        total_count: activity.items.length,
        wrong_count: wrongCount,
      });
    }
  }

  function ensureOrderState(picked, itemIndex, length) {
    if (!picked[itemIndex]) picked[itemIndex] = Array.from({ length }, () => null);
    return picked[itemIndex];
  }

  /** Match backend validator_v2 _normalize_for_reconstruction — trailing punct only. */
  function normalizeOrderSentence(text) {
    let value = (text || '').trim();
    if (value && /[.!?,;:]$/.test(value)) {
      value = value.slice(0, -1).trim();
    }
    return value.replace(/\s+/g, ' ').toLowerCase();
  }

  function splitOrderTokens(sentence) {
    return (sentence || '').trim().split(/\s+/).filter(Boolean);
  }

  function reconstructOrderSentence(item, state) {
    const tokens = item.scrambled_tokens || [];
    return state.map((tokenIdx) => tokens[tokenIdx]).join(' ');
  }

  function isOrderAnswerCorrect(item, state) {
    if (state.some((value) => value == null)) return false;
    const reconstructed = reconstructOrderSentence(item, state);
    return normalizeOrderSentence(reconstructed) === normalizeOrderSentence(item.original_sentence || '');
  }

  function firstMisplacedOrderSlot(item, state) {
    const tokens = item.scrambled_tokens || [];
    const expected = splitOrderTokens(item.original_sentence || '');
    return state.findIndex((tokenIdx, slotIdx) => {
      if (tokenIdx == null) return false;
      const placed = tokens[tokenIdx] || '';
      const target = expected[slotIdx] || '';
      return normalizeOrderSentence(placed) !== normalizeOrderSentence(target);
    });
  }

  function readOrderDragPayload(event, fallback) {
    const raw = event.dataTransfer?.getData('text/plain');
    if (!raw) return fallback;
    try {
      return JSON.parse(raw);
    } catch {
      return fallback;
    }
  }

  function placeOrderToken(root, activity, picked, itemIndex, tokenIndex, slotIndex, solved) {
    if (solved.has(itemIndex)) return;
    const item = activity.items[itemIndex];
    const state = ensureOrderState(picked, itemIndex, item.scrambled_tokens.length);
    const previousSlot = state.findIndex((value) => value === tokenIndex);
    if (previousSlot !== -1) state[previousSlot] = null;
    state[slotIndex] = tokenIndex;
    renderOrderSlots(root, activity, picked, itemIndex, false);
  }

  function removeOrderToken(root, activity, picked, itemIndex, slotIndex, solved) {
    if (solved.has(itemIndex)) return;
    const item = activity.items[itemIndex];
    const state = ensureOrderState(picked, itemIndex, item.scrambled_tokens.length);
    if (state[slotIndex] == null) return;
    state[slotIndex] = null;
    renderOrderSlots(root, activity, picked, itemIndex, false);
    root.querySelector(`[data-order-hint="${itemIndex}"]`)?.classList.add('hidden');
  }

  function renderOrderSlots(root, activity, picked, itemIndex, isCorrect) {
    const item = activity.items[itemIndex];
    const state = ensureOrderState(picked, itemIndex, item.scrambled_tokens.length);
    root.querySelectorAll(`[data-order-slot="${itemIndex}"]`).forEach((slot) => {
      const slotIndex = Number(slot.dataset.slotIndex);
      const tokenIndex = state[slotIndex];
      slot.textContent = tokenIndex == null ? `Ô ${slotIndex + 1}` : item.scrambled_tokens[tokenIndex];
      slot.dataset.filled = tokenIndex == null ? 'false' : 'true';
      slot.dataset.correct = isCorrect ? 'true' : 'false';
      const locked = root.querySelector(`[data-order-card="${itemIndex}"]`)?.dataset.dictationLocked === 'true';
      slot.disabled = locked || isCorrect;
      slot.draggable = !locked && tokenIndex != null && !isCorrect;
    });
    root.querySelectorAll(`[data-order-item="${itemIndex}"]`).forEach((button) => {
      const tokenIndex = Number(button.dataset.tokenIndex);
      const pickedAlready = state.includes(tokenIndex);
      button.hidden = pickedAlready;
      button.dataset.picked = pickedAlready ? 'true' : 'false';
      const locked = root.querySelector(`[data-order-card="${itemIndex}"]`)?.dataset.dictationLocked === 'true';
      button.disabled = locked || isCorrect;
      button.draggable = !locked && !isCorrect;
    });
  }

  function checkOrderItem(root, activity, picked, wrongSignatures, solved, itemIndex, onWrong, onCopyComplete) {
    const item = activity.items[itemIndex];
    const st = ensureOrderState(picked, itemIndex, item.scrambled_tokens.length);
    if (st.some((value) => value == null)) return;
    const correct = isOrderAnswerCorrect(item, st);
    const questionId = `${activity.type}:${item.id || itemIndex}`;
    if (correct) {
      if (isW1() && root.querySelector(`[data-order-ghost="${itemIndex}"]:not(.hidden)`)) {
        // w1CompleteCopyMode lives in renderOrderActivity's closure — it MUST
        // arrive as a callback. Calling it by name here threw ReferenceError
        // (swallowed by Sentry) and trapped kids who fixed their sentence
        // after the reveal: stale orange, no completion ("không cho làm tiếp").
        if (typeof onCopyComplete === 'function') onCopyComplete();
        return;
      }
      solved.add(itemIndex);
      if (isW1()) w1RecordQuestionOutcome(activity.type, questionId, 'first_try', 1);
      clearWrongStreak(questionId);
      root.querySelector(`[data-order-hint="${itemIndex}"]`)?.classList.add('hidden');
      root.querySelectorAll(`[data-order-slot="${itemIndex}"]`).forEach((s) => { s.dataset.misplaced = 'false'; });
      renderOrderSlots(root, activity, picked, itemIndex, true);
      if (solved.size < (activity.items || []).length) onItemCorrect();
      return;
    }
    wrongSignatures[itemIndex] = wrongSignatures[itemIndex] || new Set();
    const signature = normalizeOrderSentence(reconstructOrderSentence(item, st));
    if (!wrongSignatures[itemIndex].has(signature)) {
      wrongSignatures[itemIndex].add(signature);
      onWrong();
      onItemWrong(questionId);
    }
    root.querySelector(`[data-order-hint="${itemIndex}"]`)?.classList.remove('hidden');
    root.querySelectorAll(`[data-order-slot="${itemIndex}"]`).forEach((s) => { s.dataset.misplaced = 'false'; });
    const firstMisplaced = firstMisplacedOrderSlot(item, st);
    if (firstMisplaced !== -1) {
      const slot = root.querySelector(`[data-order-slot="${itemIndex}"][data-slot-index="${firstMisplaced}"]`);
      if (slot) slot.dataset.misplaced = 'true';
    }
  }

  function renderWrittenActivity(root, activity) {
    root.innerHTML = `
      <div class="mt-5 space-y-5">
        ${(activity.questions || [])
          .map(
            (question, questionIndex) => {
              const modelAnswer = isW1() ? w1WrittenModelAnswer(question) : '';
              const modelLine = modelAnswer
                ? `Câu mẫu của Minny: "${escapeHtml(modelAnswer)}"`
                : 'Minny gợi ý con đọc lại truyện để tìm ý nhé!';
              return `
              <article class="rounded-md border border-cream/10 bg-navy-950/45 p-4" data-written-card="${questionIndex}">
                <label class="block">
                  <span class="block font-bold text-cream">${escapeHtml(question.question_en)}</span>
                  <span class="mt-1 block text-sm text-cream/65">${escapeHtml(question.question_vi || '')}</span>
                  <textarea
                    class="mt-3 min-h-24 w-full rounded-md border border-cream/15 bg-navy-950/65 p-3 text-cream outline-none focus:border-accent"
                    data-written-answer="${questionIndex}"
                    placeholder="Con viết câu trả lời ở đây..."
                  >${escapeHtml(state.writtenDrafts[writtenDraftKey(activity, question, questionIndex)] || '')}</textarea>
                </label>
                ${isW1() ? `
                  <p class="mt-2 hidden text-sm text-cream/65" data-written-nudge="${questionIndex}">Con viết thêm một chút nhé (ít nhất 3 từ)!</p>
                  <div class="mt-3 hidden space-y-2" data-written-review="${questionIndex}">
                    <p class="text-sm text-gold">${modelLine}</p>
                    <div class="flex flex-wrap gap-2" data-written-actions="${questionIndex}">
                      <button type="button" class="r2l-secondary" data-written-ok="${questionIndex}">Giống ý 👍</button>
                      <button type="button" class="r2l-secondary" data-written-retry="${questionIndex}">Khác ý, con sửa lại ✏️</button>
                    </div>
                    <p class="hidden text-sm font-semibold text-green-400" data-written-confirmed="${questionIndex}">Minny ghi nhận câu này rồi nhé!</p>
                  </div>
                ` : ''}
              </article>
            `;
            },
          )
          .join('')}
      </div>
    `;

    const w1Submitted = new Set();

    root.querySelectorAll('[data-written-answer]').forEach((input) => {
      input.addEventListener('input', () => {
        const questionIndex = Number(input.dataset.writtenAnswer);
        const question = activity.questions?.[questionIndex] || {};
        state.writtenDrafts[writtenDraftKey(activity, question, questionIndex)] = input.value;
        scheduleSaveLessonSession();
        if (!isW1()) finalizeCurrentActivityIfReady();
      });
    });

    if (isW1()) {
      root.querySelectorAll('[data-written-answer]').forEach((input) => {
        const submitBtn = document.createElement('button');
        submitBtn.type = 'button';
        submitBtn.className = 'r2l-primary mt-3';
        submitBtn.textContent = 'Gửi câu trả lời';
        submitBtn.dataset.writtenSubmit = String(input.dataset.writtenAnswer);
        input.parentElement?.appendChild(submitBtn);
        submitBtn.addEventListener('click', () => {
          const questionIndex = Number(input.dataset.writtenAnswer);
          const question = activity.questions?.[questionIndex] || {};
          const value = input.value || '';
          if (w1WordCount(value) < 3) {
            root.querySelector(`[data-written-nudge="${questionIndex}"]`)?.classList.remove('hidden');
            return;
          }
          root.querySelector(`[data-written-nudge="${questionIndex}"]`)?.classList.add('hidden');
          input.disabled = true;
          root.querySelector(`[data-written-review="${questionIndex}"]`)?.classList.remove('hidden');
        });
      });
      function w1WrittenQuestionId(question, questionIndex) {
        return `${activity.type}:${question.id || questionIndex}`;
      }

      function w1MarkWrittenQuestionOk(questionIndex) {
        const question = activity.questions?.[questionIndex] || {};
        w1Submitted.add(questionIndex);
        w1RecordQuestionOutcome(activity.type, w1WrittenQuestionId(question, questionIndex), 'first_try', 1);
        root.querySelector(`[data-written-actions="${questionIndex}"]`)?.classList.add('hidden');
        root.querySelector(`[data-written-confirmed="${questionIndex}"]`)?.classList.remove('hidden');
        root.querySelector(`[data-written-submit="${questionIndex}"]`)?.classList.add('hidden');
        scheduleSaveLessonSession();
        const total = (activity.questions || []).length;
        if (w1Submitted.size >= total) {
          completeActivity(activity.type, {
            correct_count: w1Submitted.size,
            total_count: total,
            written_answers: collectWrittenAnswers(activity),
          });
        }
      }

      root.addEventListener('click', (event) => {
        const okBtn = event.target.closest('[data-written-ok]');
        if (!okBtn || !root.contains(okBtn)) return;
        const questionIndex = Number(okBtn.getAttribute('data-written-ok'));
        if (!Number.isInteger(questionIndex) || w1Submitted.has(questionIndex)) return;
        w1MarkWrittenQuestionOk(questionIndex);
      });

      root.querySelectorAll('[data-written-retry]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const questionIndex = Number(btn.getAttribute('data-written-retry'));
          if (!Number.isInteger(questionIndex)) return;
          const question = activity.questions?.[questionIndex] || {};
          w1Submitted.delete(questionIndex);
          const questionId = w1WrittenQuestionId(question, questionIndex);
          if (state.questionOutcomes[activity.type]) {
            delete state.questionOutcomes[activity.type][questionId];
          }
          const input = root.querySelector(`[data-written-answer="${questionIndex}"]`);
          if (input) {
            input.disabled = false;
            input.focus();
          }
          root.querySelector(`[data-written-submit="${questionIndex}"]`)?.classList.remove('hidden');
          root.querySelector(`[data-written-actions="${questionIndex}"]`)?.classList.remove('hidden');
          root.querySelector(`[data-written-confirmed="${questionIndex}"]`)?.classList.add('hidden');
          scheduleSaveLessonSession();
        });
      });
    } else {
      finalizeCurrentActivityIfReady();
    }
  }

  function renderSpeakActivity(root, activity) {
    const heroScope = root.closest('[data-activity-shell="listen_and_speak"], [data-activity-shell="echo_challenge"]');
    _r2lInitMinnyHero(heroScope);

    root.innerHTML = `
      <p class="mt-2 text-sm font-semibold text-gold">Bước 1: Bấm Nghe. Bước 2: Bấm Con nói và đọc lại câu.</p>
      <div class="mt-5 space-y-5">
        ${(activity.items || [])
          .map(
            (item, itemIndex) => `
              <article class="r2l-minny-sentence-card" data-speak-card="${itemIndex}" data-item-key="${escapeHtml(item.id || `ls_${itemIndex}`)}" data-native-audio-url="${escapeHtml(item.audio_url || '')}">
                <p class="r2l-minny-sentence-en">${escapeHtml(item.text_en)}</p>
                ${item.text_vi ? `<p class="r2l-minny-sentence-vi">${escapeHtml(item.text_vi)}</p>` : ''}
                <div class="r2l-minny-speak-actions">
                  <button type="button" class="minny-btn minny-btn--listen" data-speak-listen="${itemIndex}">🔊 Nghe</button>
                  <button type="button" class="minny-btn minny-btn--record" data-speak-record="${itemIndex}" disabled>🎤 Con nói</button>
                </div>
                ${
                  item.audio_url && !isRewardSfxUrl(item.audio_url)
                    ? `<div class="r2l-replay-rate-row" aria-label="Nghe mẫu chậm">
                        <button type="button" class="r2l-replay-rate" data-r2l-replay-rate="0.5" data-audio-url="${escapeHtml(item.audio_url)}">0.5x</button>
                        <button type="button" class="r2l-replay-rate" data-r2l-replay-rate="0.75" data-audio-url="${escapeHtml(item.audio_url)}">0.75x</button>
                        <button type="button" class="r2l-replay-rate" data-r2l-replay-rate="1" data-audio-url="${escapeHtml(item.audio_url)}">1.0x</button>
                      </div>`
                    : ''
                }
                <div class="mt-3 hidden rounded-md border border-cream/10 bg-navy-950/35 p-3 text-sm text-cream/80" data-speak-feedback></div>
                <div class="r2l-wave-panel hidden" data-speak-waveform aria-label="Sóng âm mẫu và bài đọc của con"></div>
              </article>
            `,
          )
          .join('')}
      </div>
      <button type="button" class="r2l-secondary mt-5 w-full" data-speak-mic-skip hidden>
        Không sửa được — bỏ qua phần nói (không nhận thưởng)
      </button>
    `;

    root.querySelectorAll('[data-speak-listen]').forEach((button) => {
      const itemIndex = Number(button.dataset.speakListen);
      const item = activity.items[itemIndex];
      const url = item?.audio_url || '';
      const recordBtn = root.querySelector(`[data-speak-record="${itemIndex}"]`);
      const cardEl = root.querySelector(`[data-speak-card="${itemIndex}"]`);
      const itemKey = item?.id || `ls_${itemIndex}`;

      button.addEventListener('click', () => {
        _r2lSetMinnyMood('listen', heroScope);
        const onEnd = () => _r2lSetMinnyMood('idle', heroScope);
        if (url && !isRewardSfxUrl(url)) {
          playAudio(url, button);
          const audio = lessonAudioState.audio;
          if (audio) {
            audio.addEventListener('ended', onEnd, { once: true });
          } else {
            onEnd();
          }
        } else {
          _r2lSpeakEnglishLine(item.text_en, onEnd);
        }
        if (recordBtn) {
          recordBtn.dataset.heard = 'true';
          recordBtn.disabled = !_r2lMicIsReady();
        }
        markSpeakHeard(activity, itemIndex);
      });

      _r2lInitSpeakRecorder(itemKey, cardEl, item?.text_en || '');
    });

    restoreSpeakActivityProgress(root, activity);

    root.querySelectorAll('[data-speak-record]').forEach((button) => {
      const itemIndex = Number(button.dataset.speakRecord);
      const cardEl = root.querySelector(`[data-speak-card="${itemIndex}"]`);
      const item = activity.items?.[itemIndex] || {};
      const itemKey = item.id || `ls_${itemIndex}`;

      button.addEventListener('click', () => {
        const entry = _r2lRecorderState.perItem.get(itemKey);
        if (entry?.status === 'recording') {
          _r2lStopRecording(itemKey, cardEl);
        } else if (entry?.checkStatus !== 'uploading') {
          _r2lSetMinnyMood('listen', heroScope);
          _r2lStartRecording(itemKey, cardEl);
        }
      });
    });
  }

  function completeActivity(type, details) {
    if (state.completedTypes.has(type)) return;
    const completedIndex = state.activityIndex;
    if (isV21Lesson() && type !== 'speed_round') {
      _r2lGameState.combo.phase_max[type] = Math.max(
        _r2lGameState.combo.phase_max[type] || 0,
        _r2lGameState.combo.max,
      );
    }
    state.completedTypes.add(type);
    const questionOutcomes = isW1() ? w1BuildQuestionOutcomesForSubmit(type) : undefined;
    state.activityResults[type] = {
      type,
      attempted: true,
      ...details,
      ...(questionOutcomes?.length ? { question_outcomes: questionOutcomes } : {}),
    };
    if (isW1()) {
      state.w1MaxUnlocked = Math.max(state.w1MaxUnlocked, completedIndex + 1);
      w1MaybeMidpointCelebration(completedIndex);
      w1RenderQuestPath();
    }
    updateProgress();
    updateGlobalCta();
    if (!details?.skipped_due_to_mic) {
      showReward({ mode: 'celebrate', withVoice: true });
      playSfx(SFX.activityComplete);
    }

    const activities = state.lesson?.activities || [];
    const nextIndex = completedIndex + 1;
    if (nextIndex < activities.length) {
      showMesoInterstitial(completedIndex, nextIndex);
    }
    saveLessonSession();
  }

  function updateProgress() {
    const activities = state.lesson?.activities || [];
    const total = activities.length || 6;
    const currentIndex = state.activityIndex;

    qs('#progress-part-label').textContent = `Phần ${currentIndex + 1}/${total}`;

    qsa('[data-dot]').forEach((dot, i) => {
      const type = activities[i]?.type;
      if (type && state.completedTypes.has(type)) {
        dot.dataset.state = 'done';
      } else if (i === currentIndex) {
        dot.dataset.state = 'active';
      } else {
        dot.dataset.state = 'locked';
      }
    });

    qs('#submit-lesson').disabled = submitInFlight || state.completedTypes.size < total;
    renderStepStates();
    updateGlobalCta();
  }

  function renderStepStates() {
    const activities = state.lesson?.activities || [];
    qsa('[data-step-button]').forEach((button, index) => {
      const type = activities[index]?.type;
      if (type && state.completedTypes.has(type)) {
        button.dataset.state = 'done';
      } else if (index === state.activityIndex) {
        button.dataset.state = 'active';
      } else {
        button.dataset.state = 'locked';
      }
      button.dataset.active = String(index === state.activityIndex);
      button.dataset.done = String(type && state.completedTypes.has(type));
    });
  }

  function showReward({ mode = 'mini', withVoice = false } = {}) {
    const tier = rollRewardTier();
    const burst = qs('#reward-burst');
    const title = qs('#reward-burst-title');
    const copy = qs('#reward-burst-copy');
    const messages = {
      common: ['Hay lắm!', 'Con vừa mở thêm năng lượng.'],
      rare: ['Combo đẹp!', 'Minny thấy con đang bắt nhịp rất tốt.'],
      legendary: ['Khoảnh khắc vàng!', 'Một cú nghe cực sáng vừa xuất hiện.'],
    };
    title.textContent = messages[tier][0];
    copy.textContent = messages[tier][1];
    burst.dataset.tier = tier;
    burst.dataset.mode = mode;
    burst.dataset.show = 'false';
    if (_rewardBurstShowTimer) clearTimeout(_rewardBurstShowTimer);
    _rewardBurstShowTimer = window.setTimeout(() => {
      burst.dataset.show = 'true';
      const tierSfx = {
        common: SFX.correctCommon,
        rare: SFX.correctRare,
        legendary: SFX.correctLegendary,
      };
      playSfx(tierSfx[tier] || SFX.correctCommon);
      if (withVoice || tier === 'rare' || tier === 'legendary') {
        playCorrectVoice(mode === 'celebrate' ? 420 : 320);
      }
      _rewardBurstShowTimer = null;
    }, 20);
    if (_rewardBurstHideTimer) clearTimeout(_rewardBurstHideTimer);
    _rewardBurstHideTimer = window.setTimeout(() => {
      burst.dataset.show = 'false';
      _rewardBurstHideTimer = null;
    }, mode === 'celebrate' ? 1450 : 950);
  }

  function playWrongSfx(questionId) {
    if (!questionId) {
      playSfx(SFX.wrong);
      return;
    }
    const current = _r2lSfxState.wrongStreak.get(questionId) || 0;
    const next = current + 1;
    _r2lSfxState.wrongStreak.set(questionId, next);
    if (next >= 2) {
      playSfx(SFX.encouragement);
    } else {
      playSfx(SFX.wrong);
    }
  }

  function clearWrongStreak(questionId) {
    if (questionId) _r2lSfxState.wrongStreak.delete(questionId);
  }

  function isRewardSfxUrl(url) {
    if (!url || typeof url !== 'string') return false;
    const normalized = url.toLowerCase();
    return (
      normalized.includes('/sfx/')
      || normalized.includes('/public/sfx/')
      || normalized.includes('r2l/sfx')
    );
  }

  function setLessonPlayButtonState(button, audioUrl) {
    if (!button) return;
    if (!button.dataset.audioDefaultLabel) {
      button.dataset.audioDefaultLabel = button.textContent || 'Nghe';
    }
    const playable = Boolean(audioUrl) && !isRewardSfxUrl(audioUrl);
    button.disabled = !playable;
    button.textContent = playable ? button.dataset.audioDefaultLabel : 'Chưa có audio';
  }

  function playAudio(url, button = null) {
    if (!url) {
      console.warn('[r2l-lesson-audio] missing lesson audio URL — not playing reward voice');
      return;
    }
    if (isRewardSfxUrl(url)) {
      console.warn('[r2l-lesson-audio] refused reward/SFX URL for lesson playback:', url);
      return;
    }
    if (lessonAudioState.audio && lessonAudioState.url === url && !lessonAudioState.audio.paused) {
      stopLessonAudio();
      return;
    }
    _r2lTrackLearningEvent('audio');
    stopLessonAudio();
    const audio = new Audio(url);
    audio.preload = 'auto';
    lessonAudioState.audio = audio;
    lessonAudioState.url = url;
    lessonAudioState.button = button;
    markAudioButtonPlaying(button);
    audio.addEventListener('ended', () => {
      if (isW1() && url && url === state.lesson?.story?.full_audio_url) {
        state.storyGate.listen_done = true;
        w1UpdateGateChips();
        scheduleSaveLessonSession();
      }
      if (lessonAudioState.audio === audio) stopLessonAudio({ resetTime: false });
    });
    audio.play().catch(() => {
      if (lessonAudioState.audio === audio) stopLessonAudio();
      showToast('Chưa phát được audio. Con bấm lại một lần nữa nhé!');
    });
  }

  function calculateLessonScore() {
    const results = Object.values(state.activityResults || {});
    const scorer = window.__r2lLessonScoring?.calculateLessonScore;
    if (scorer) {
      return scorer(results, { w1: isW1() });
    }
    let correct = 0;
    let total = 0;
    let wrong = 0;
    results.forEach((result) => {
      const resultTotal = Number(result.total_count || 0);
      total += resultTotal;
      correct += Math.min(resultTotal, Number(result.correct_count || 0));
      wrong += Number(result.wrong_count || 0);
    });
    const denominator = total + Math.floor(wrong * 0.5);
    return {
      correct_count: correct,
      total_count: total,
      wrong_count: wrong,
      score_percent: denominator > 0 ? Math.round((correct / denominator) * 100) : 0,
    };
  }

  async function submitLesson() {
    if (submitInFlight) return;
    submitInFlight = true;

    const submitBtn = qs('#submit-lesson');
    const retryBtn = qs('#submit-retry');
    submitBtn.disabled = true;
    retryBtn?.classList.add('hidden');

    const payload = {
      access_code: state.accessCode,
      pack_id: state.packId,
      answers: {
        schema_version: 2,
        activity_results: Object.values(state.activityResults),
        score_percent: calculateLessonScore().score_percent,
        learning_metrics: _r2lLearningMetricPayload(),
      },
    };
    savePendingSubmit(payload);
    qs('#submit-hint').textContent = 'Minny đang lưu kết quả...';

    const SUBMIT_TIMEOUT_MS = 20000;
    try {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), SUBMIT_TIMEOUT_MS);
      const res = await fetch('/api/submit-read2lead-lesson', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      clearTimeout(timer);
      const data = await safeJson(res);
      if (!res.ok || !data.ok) throw new Error(data.message || data.error || 'Chưa lưu được.');
      clearPendingSubmit();
      clearLessonSession();
      if (!data.passed && !data.completed_without_reward) {
        qs('#submit-hint').textContent = data.message || 'Chưa đạt điểm tối thiểu. Không sao, mình thử lại nhé!';
        submitInFlight = false;
        submitBtn.disabled = false;
        return;
      }
      if (data.completed_without_reward) {
        updateStateHeader(data.read2lead_state);
        qs('#submit-hint').textContent = data.message || 'Bài đã kết thúc không thưởng.';
        _r2lShowCompletionAfterTrivia(data);
        return;
      }
      const rewards = data.rewards_earned || {};
      const scorePercent = calculateLessonScore().score_percent;
      updateStateHeader(data.read2lead_state);
      _r2lTriviaState.pendingRewards = rewards;
      _r2lTriviaState.pendingLevelUp = data.level_up || null;
      _r2lTriviaState.pendingRankUp = data.rank_up || null;
      _r2lTriviaState.pendingRankLadder = data.read2lead_state?.rank_ladder || null;
      void window.__r2lJuice?.openChest?.(data.pending_chest);
      if (data.read2lead_state?.rank_ladder?.stars_to_next === 1) window.__r2lJuice?.showNearMissBanner?.(`Còn 1 sao nữa là lên ${data.read2lead_state.rank_ladder.next_label_vi}!`);

      if (_r2lMaybeRevealTriviaSecret(scorePercent)) {
        qs('#submit-hint').textContent = 'Con đã mở khóa bí mật sau truyện!';
      } else {
        _r2lShowCompletionAfterTrivia(data);
      }
    } catch (error) {
      const message = error.name === 'AbortError'
        ? 'Mạng hơi chậm, chưa gửi được. Con bấm Gửi lại nhé!'
        : (error.message || 'Chưa lưu được kết quả. Con bấm Gửi lại nhé!');
      qs('#submit-hint').textContent = message;
      retryBtn?.classList.remove('hidden');
      submitInFlight = false;
      submitBtn.disabled = false;
    }
  }

  qs('#submit-lesson').addEventListener('click', () => {
    submitLesson();
  });

  qs('#submit-retry')?.addEventListener('click', () => {
    submitLesson();
  });

  function showError(message) {
    qs('#loading-card')?.classList.add('hidden');
    qs('#lesson-shell')?.classList.add('hidden');
    qs('#error-card')?.classList.remove('hidden');
    qs('#error-message').textContent = message;
  }

  function updateStateHeader(read2LeadState) {
    if (!read2LeadState) return;
    const header = document.querySelector('[data-r2l-state-header]');
    if (!header) return;
    header.classList.remove('hidden');
    header.classList.add('flex');
    header.querySelector('[data-r2l-level]').textContent = read2LeadState.current_level || 'LV';
    if (window.__r2lV3?.applyHeaderRank) {
      window.__r2lV3.applyHeaderRank(read2LeadState, header);
      if (window.__r2lV3.isEnabled?.() && read2LeadState.avatar?.monster) {
        window.__r2lV3.applyHeaderMonster?.(read2LeadState, header);
      }
    } else {
      header.querySelector('[data-r2l-rank]').textContent = read2LeadState.rank_title || 'Read2Lead';
      const rankImage = header.querySelector('[data-r2l-rank-image]');
      if (rankImage && read2LeadState.rank_asset_url) {
        rankImage.src = read2LeadState.rank_asset_url;
        rankImage.alt = `Rank ${read2LeadState.rank_title || read2LeadState.current_level || 'Read2Lead'}`;
      }
    }
    header.querySelector('[data-r2l-xp-label]').textContent = `${read2LeadState.xp_in_level ?? 0}/${read2LeadState.xp_to_next_level ?? 60} XP`;
    header.querySelector('[data-r2l-xp-fill]').style.width = `${read2LeadState.xp_percent ?? 0}%`;
    header.querySelector('[data-r2l-coins]').textContent = `${read2LeadState.coins || 0} xu`;
    header.querySelector('[data-r2l-streak]').textContent = `${read2LeadState.streak_days || 0} ngày`;
  }

  function showLevelUp(levelUp) {
    if (!levelUp) return;
    const modal = qs('#level-up-modal');
    qs('#level-up-copy').textContent = `Từ ${levelUp.from_level} lên ${levelUp.to_level}. Con đã mở thêm một nấc đọc mới.`;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  qs('#level-up-close')?.addEventListener('click', () => {
    const modal = qs('#level-up-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  });
</script>

<script>
  import { isV3Enabled } from '../../config/flags';
  import { applyV3HeaderRank } from '../../lib/rank-header';
  import { applyHeaderMonsterAvatar } from '../../lib/monster-avatar';
  import { calculateLessonScore as calcLessonScore, questionPoints } from '../../scripts/r2l-lesson-scoring.mjs';
  import { writtenModelAnswer } from '../../scripts/r2l-written-model-answer.mjs';
  import { R2LFeedbackVisual } from '../../scripts/r2l-feedback-visual.js';
  import { R2LReplayControl } from '../../scripts/r2l-replay-control.js';
  import { claimDailyChest, fireLessonPassConfetti, fireStreakConfetti, isMuted, openChest, playKenney, playSynthTone, setMuted, showComboBadge, showNearMissBanner, showXpTicker } from '../../lib/lesson-juice';
  import { bindRankUpModalClose, showRankUpModal } from '../../lib/rank-up-celebration';
  import type { RankLadderView } from '../../lib/rank-ladder-ui';

  bindRankUpModalClose();

  window.__r2lLessonScoring = { calculateLessonScore: calcLessonScore, questionPoints };
  window.__r2lWritten = { writtenModelAnswer };
  window.R2LFeedbackVisual = R2LFeedbackVisual;
  window.R2LReplayControl = R2LReplayControl;
  R2LReplayControl.bindReplayControls(document);

  window.__r2lJuice = {
    playSynthTone,
    fireStreakConfetti,
    fireLessonPassConfetti,
    playKenney, showXpTicker, showComboBadge, openChest, showNearMissBanner, setMuted, isMuted, claimDailyChest,
  };

  window.__r2lV3 = {
    isEnabled: isV3Enabled,
    applyHeaderRank: applyV3HeaderRank,
    applyHeaderMonster: applyHeaderMonsterAvatar,
    showRankUp(
      rankUp: { changed: boolean; from_label: string; to_label: string; tier_changed: boolean } | null | undefined,
      ladder?: RankLadderView,
    ) {
      if (!isV3Enabled() || !rankUp?.changed) return;
      showRankUpModal(rankUp, ladder);
    },
  };
</script>
