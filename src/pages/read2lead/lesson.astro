---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Làm bài Read2Lead trên web | Felix Builder Hub"
  description="Phụ huynh có thể cho con làm bài Read2Lead trực tiếp trên web, nghe MP3, nộp bài và nhận điểm cơ bản."
>
  <Header />

  <main id="main" class="flex-1">
    <section class="mx-auto max-w-5xl px-6 py-14 md:py-20">
      <span class="inline-block rounded-md bg-accent/20 px-4 py-1 text-sm font-semibold text-accent">Read2Lead Web Lesson</span>
      <h1 class="mt-5 font-display text-4xl font-extrabold leading-snug text-cream md:text-5xl">Cho con làm bài ngay trên web.</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-cream-muted">
        Con đọc truyện, nghe MP3, làm các phần luyện tập rồi bấm nộp. Felixar chấm các phần có đáp án rõ ràng và mở bài tiếp theo khi con đạt.
      </p>
    </section>

    <section class="bg-navy-900 px-6 py-12">
      <div class="mx-auto max-w-5xl">
        <div id="missing-link-card" class="hidden rounded-xl border border-cream-dim/20 bg-navy-950/75 p-6">
          <h2 class="font-display text-2xl font-bold leading-snug text-cream">Cần mở từ đúng bài Read2Lead</h2>
          <p class="mt-3 leading-relaxed text-cream-muted">Bố mẹ mở trang này từ nút <strong class="text-cream">Cho con làm trên web</strong> sau khi tạo bài, hoặc từ Felixar dashboard.</p>
          <a href="/read2lead/review" class="mt-5 inline-flex rounded-lg bg-accent px-5 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Khoe Felixar cho ba mẹ xem 🌟</a>
        </div>

        <div id="loading-card" class="rounded-xl border border-cream-dim/20 bg-navy-950/75 p-6">
          <div class="h-3 overflow-hidden rounded-full bg-navy-800">
            <div class="h-full w-2/3 animate-pulse rounded-full bg-gradient-to-r from-accent via-gold-light to-accent"></div>
          </div>
          <p class="mt-5 text-lg font-semibold text-cream">Đang mở bài cho con...</p>
        </div>

        <div id="error-card" class="hidden rounded-xl border border-red-500/30 bg-red-500/10 p-6 text-red-300"></div>

        <article id="lesson-card" class="hidden rounded-xl border border-cream-dim/20 bg-navy-950/80 p-6">
          <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
            <div>
              <p id="lesson-meta" class="text-sm font-semibold text-gold-light"></p>
              <h2 id="lesson-title" class="mt-2 font-display text-3xl font-bold leading-snug text-cream"></h2>
              <p id="lesson-subtitle" class="mt-2 text-cream-muted"></p>
            </div>
            <div class="flex shrink-0 flex-col gap-3 sm:flex-row md:flex-col">
              <button id="sfx-toggle" type="button" aria-label="Bật tắt âm thanh" onclick="toggleSfx()" class="rounded-lg border border-cream-dim/30 px-4 py-3 text-center text-lg font-semibold text-cream transition hover:border-accent hover:text-accent">🔊</button>
              <a id="pdf-link" href="#" target="_blank" rel="noreferrer" class="hidden rounded-lg border border-cream-dim/30 px-5 py-3 text-center font-semibold text-cream transition hover:border-accent hover:text-accent">Mở PDF</a>
            </div>
          </div>

          <div id="step-progress" class="sticky top-2 z-20 mt-6 grid grid-cols-3 gap-2 rounded-lg border border-cream-dim/20 bg-navy-950/95 p-2 text-center text-[11px] font-semibold leading-tight text-cream-dim shadow-lg backdrop-blur sm:text-xs">
            <button type="button" data-step-indicator="listen" data-step-jump="listen" class="rounded-md border border-cream-dim/20 bg-navy-900/60 px-2 py-2 transition hover:border-accent hover:text-cream sm:px-3">🎧 Bước 1: Nghe</button>
            <button type="button" data-step-indicator="read" data-step-jump="read" class="rounded-md border border-cream-dim/20 bg-navy-900/60 px-2 py-2 transition hover:border-accent hover:text-cream sm:px-3">📖 Bước 2: Đọc</button>
            <button type="button" data-step-indicator="practice" data-step-jump="practice" class="rounded-md border border-cream-dim/20 bg-navy-900/60 px-2 py-2 transition hover:border-accent hover:text-cream sm:px-3">🎯 Bước 3: Mission</button>
          </div>

          <section id="step-listen" class="mt-8 hidden">
            <p class="text-sm font-semibold text-gold-light">Bước 1</p>
            <h3 class="mt-1 font-display text-2xl font-bold leading-snug text-cream">Con nghe câu chuyện</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream-muted">Mở loa hoặc tai nghe. Con nghe ít nhất 1 lần để quen âm thanh, sau đó mới sang phần đọc.</p>
            <audio id="step-audio" controls preload="none" class="mt-5 w-full"></audio>
            <p id="step-audio-missing" class="mt-3 hidden text-sm text-red-300">Bài này chưa có file MP3. Con có thể chuyển sang bước Đọc.</p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
              <button data-step-next="read" type="button" class="rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Con đã nghe xong</button>
            </div>
          </section>

          <section id="step-read" class="mt-8 hidden">
            <p class="text-sm font-semibold text-gold-light">Bước 2</p>
            <h3 class="mt-1 font-display text-2xl font-bold leading-snug text-cream">Con đọc câu chuyện</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream-muted">Con đọc to thành tiếng từng đoạn. Bố mẹ ngồi cạnh giúp con đọc chuẩn nhé.</p>
            <div id="step-read-body" class="mt-5 mx-auto max-w-prose"></div>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-between">
              <button data-step-back="listen" type="button" class="rounded-lg border border-cream-dim/30 px-6 py-3 font-semibold text-cream transition hover:border-accent hover:text-accent">Nghe lại</button>
              <button data-step-next="practice" type="button" class="rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Con đã đọc xong</button>
            </div>
          </section>

          <section id="step-practice" class="mt-8 hidden">
            <p class="text-sm font-semibold text-gold-light">Bước 3</p>
            <h3 class="mt-1 font-display text-2xl font-bold leading-snug text-cream">Con làm bài luyện tập</h3>
            <p class="mt-2 text-sm leading-relaxed text-cream-muted">Các phần nối, điền, sửa và sắp xếp sẽ được chấm ngay. Ô viết tự do để bố mẹ đọc cùng con, chưa tính điểm tự động.</p>

            <div id="activity-progress" class="mt-4 hidden rounded-lg border border-cream-dim/20 bg-navy-900/60 p-3">
              <div id="activity-dots" class="flex flex-wrap items-center gap-1.5"></div>
              <p class="mt-2 text-sm text-cream-muted">Phần <span id="activity-current-num" class="font-semibold text-cream">1</span>/<span id="activity-total-num">1</span>: <span id="activity-current-name" class="text-gold-light"></span></p>
            </div>

            <form id="lesson-form" class="mt-6 space-y-6">
              <div id="activities"></div>
              <div class="absolute -left-[9999px]" aria-hidden="true">
                <label for="website">Website</label>
                <input id="website" name="website" tabindex="-1" autocomplete="off" />
              </div>
              <div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
                <button data-step-back="read" type="button" class="rounded-lg border border-cream-dim/30 px-6 py-3 font-semibold text-cream transition hover:border-accent hover:text-accent">Đọc lại truyện</button>
                <div class="flex gap-3">
                  <button id="activity-back" type="button" class="rounded-lg border border-cream-dim/30 px-5 py-3 font-semibold text-cream transition hover:border-accent hover:text-accent">← Quay lại</button>
                  <button id="activity-next" type="button" class="rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Tiếp theo →</button>
                  <button id="submit-lesson" type="submit" class="hidden rounded-lg bg-accent px-6 py-3 text-lg font-semibold text-navy-950 transition hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-60">Nộp bài 🚀</button>
                </div>
              </div>
            </form>
          </section>
        </article>

        <section id="result-card" class="mt-6 hidden rounded-xl border border-gold/40 bg-gold/10 p-6"></section>
      </div>
    </section>

    <div id="celebration-overlay" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-navy-950/85 backdrop-blur">
      <div class="text-center r2l-reward-pop">
        <p id="celebration-emoji" class="text-7xl">🎉</p>
        <p id="celebration-text" class="mt-4 font-display text-4xl font-bold text-gold-light md:text-5xl">Tuyệt vời!</p>
      </div>
    </div>
  </main>

  <div id="sticky-audio" class="fixed inset-x-0 bottom-0 z-30 hidden border-t border-cream-dim/20 bg-navy-900/95 px-4 py-3 shadow-2xl backdrop-blur">
    <div class="mx-auto flex max-w-5xl items-center gap-3">
      <span class="hidden text-xs font-semibold uppercase tracking-wide text-gold-light sm:inline">🎧 Nghe lại</span>
      <audio id="sticky-audio-el" controls preload="none" class="w-full"></audio>
    </div>
  </div>

  <Footer />

  <style is:global>
    @keyframes r2l-confetti-fall {
      0% { transform: translate3d(0, -10vh, 0) rotate(0deg); opacity: 1; }
      100% { transform: translate3d(0, 110vh, 0) rotate(720deg); opacity: 0; }
    }
    @keyframes r2l-reward-pop {
      0% { transform: scale(0.5); opacity: 0; }
      55% { transform: scale(1.15); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .r2l-confetti {
      position: fixed;
      top: 0;
      font-size: 2.25rem;
      line-height: 1;
      pointer-events: none;
      z-index: 50;
      animation: r2l-confetti-fall 3s ease-out forwards;
    }
    .r2l-reward-pop {
      animation: r2l-reward-pop 0.7s ease-out;
    }
    @keyframes r2l-shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }
    .r2l-shake {
      animation: r2l-shake 0.5s ease;
    }
    @keyframes r2l-mascot-pop {
      0% { transform: translate(-50%, -50%) scale(0.4); opacity: 0; }
      30% { transform: translate(-50%, -50%) scale(1.1); opacity: 1; }
      60% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
      100% { transform: translate(-50%, -50%) scale(1); opacity: 0; }
    }
    .r2l-mascot-pop {
      animation: r2l-mascot-pop 1.8s ease forwards;
    }
    @keyframes r2l-mascot-pop-corner {
      0% { transform: translateY(20px); opacity: 0; }
      20% { transform: translateY(0); opacity: 1; }
      80% { transform: translateY(0); opacity: 1; }
      100% { transform: translateY(-10px); opacity: 0; }
    }
    .r2l-mascot-pop-corner {
      animation: r2l-mascot-pop-corner 1s ease forwards;
    }
  </style>

  <script>
    const params = new URLSearchParams(window.location.search);
    const accessCode = (params.get('code') || '').trim().toUpperCase();
    const packId = (params.get('pack_id') || '').trim();
    const missingLinkCard = document.getElementById('missing-link-card');
    const loadingCard = document.getElementById('loading-card');
    const errorCard = document.getElementById('error-card');
    const lessonCard = document.getElementById('lesson-card');
    const resultCard = document.getElementById('result-card');
    const activitiesEl = document.getElementById('activities');
    const stepReadBody = document.getElementById('step-read-body');
    const stepAudio = document.getElementById('step-audio');
    const stepAudioMissing = document.getElementById('step-audio-missing');
    const stepSections = {
      listen: document.getElementById('step-listen'),
      read: document.getElementById('step-read'),
      practice: document.getElementById('step-practice'),
    };
    const stepIndicators = document.querySelectorAll('[data-step-indicator]');
    const stepOrder = ['listen', 'read', 'practice'];
    const stickyAudio = document.getElementById('sticky-audio');
    const stickyAudioEl = document.getElementById('sticky-audio-el');

    const form = document.getElementById('lesson-form');
    const submitBtn = document.getElementById('submit-lesson');

    // ===== Audio SFX (kid dopamine layer) =====
    const SFX_VOLUME_KEY = 'r2l-sfx-on';
    let sfxEnabled = (localStorage.getItem(SFX_VOLUME_KEY) ?? 'on') === 'on';
    let audioCtxUnlocked = false;
    const sfxCache = new Map();

    function unlockAudioOnce() {
      if (audioCtxUnlocked) return;
      try {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (Ctx) {
          const ctx = new Ctx();
          const buf = ctx.createBuffer(1, 1, 22050);
          const src = ctx.createBufferSource();
          src.buffer = buf;
          src.connect(ctx.destination);
          src.start(0);
        }
      } catch {}
      audioCtxUnlocked = true;
    }

    function playSfx(filename, volume = 0.5) {
      if (!sfxEnabled) return;
      unlockAudioOnce();
      let audio = sfxCache.get(filename);
      if (!audio) {
        audio = new Audio(`/sfx/r2l/${filename}`);
        audio.volume = volume;
        sfxCache.set(filename, audio);
      }
      try {
        audio.currentTime = 0;
        audio.play().catch(() => {});
      } catch {}
    }

    const SUCCESS_POOL = ['success-1.mp3', 'success-2.mp3', 'success-3.mp3'];
    // Mid-flow celebrations rotate through warm/encouraging voices.
    // Final result voices are tier-specific (see getRewardTier below).
    const MID_VOICE_POOL = ['voice-tuyetvoi.mp3', 'voice-gioiqua.mp3', 'voice-colen.mp3', 'voice-tienbo.mp3'];
    const VOICE_TEXT = {
      'voice-tuyetvoi.mp3': 'Tuyệt vời!',
      'voice-gioiqua.mp3': 'Giỏi quá!',
      'voice-colen.mp3': 'Cố lên nhé!',
      'voice-xuatsac.mp3': 'Xuất sắc!',
      'voice-tienbo.mp3': 'Tiến bộ rồi!',
    };

    function randomFrom(arr) {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    function playPageComplete() {
      playSfx(randomFrom(SUCCESS_POOL), 0.45);
      const voiceFile = randomFrom(MID_VOICE_POOL);
      setTimeout(() => playSfx(voiceFile, 0.7), 200);
      return VOICE_TEXT[voiceFile] || 'Tuyệt vời!';
    }

    function playSoftBoop() {
      playSfx('soft-boop.mp3', 0.4);
    }

    function playFinalReward(volume = 0.6) {
      playSfx('final-reward.mp3', volume);
    }

    function toggleSfx() {
      sfxEnabled = !sfxEnabled;
      localStorage.setItem(SFX_VOLUME_KEY, sfxEnabled ? 'on' : 'off');
      const btn = document.getElementById('sfx-toggle');
      if (btn) btn.textContent = sfxEnabled ? '🔊' : '🔇';
      if (sfxEnabled) playSfx('success-1.mp3', 0.4);
    }

    window.toggleSfx = toggleSfx;

    document.addEventListener('DOMContentLoaded', () => {
      const sfxBtn = document.getElementById('sfx-toggle');
      if (sfxBtn) sfxBtn.textContent = sfxEnabled ? '🔊' : '🔇';
    });

    let lesson = null;
    let assets = {};
    let currentStep = 'listen';
    let listenCompletedAt = null;
    let readCompletedAt = null;
    const shadowRecordings = new Map();
    const voiceRecordings = new Map();
    let sentenceListenAudio = null;
    let activitySequence = [];
    let currentActivityIdx = 0;

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function levelRecommendationText(value) {
      return {
        easier: 'Nên chọn bài dễ hơn ở lần sau',
        stay: 'Giữ mức hiện tại',
        move_up: 'Có thể thử mức khó hơn',
      }[value] || 'Giữ mức hiện tại';
    }

    function escapeRegExp(value) {
      return String(value || '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function highlightChunks(text, chunkList) {
      const sorted = (Array.isArray(chunkList) ? chunkList : [])
        .filter(Boolean)
        .map((chunk) => escapeHtml(chunk))
        .sort((a, b) => b.length - a.length);
      const html = escapeHtml(text);
      if (!sorted.length) return html;
      const regex = new RegExp(`(${sorted.map((chunk) => escapeRegExp(chunk)).join('|')})`, 'gi');
      return html.replace(regex, '<mark class="rounded bg-gold/30 px-1 text-cream">$1</mark>');
    }

    function renderAssetHero() {
      if (!assets?.minny_idle) return '';
      const setting = assets.setting
        ? `<img src="${escapeHtml(assets.setting)}" alt="" class="absolute inset-x-0 bottom-0 mx-auto h-28 w-auto opacity-45" />`
        : '';
      return `
        <div class="relative mb-5 flex min-h-36 items-end justify-center gap-3 overflow-hidden rounded-lg border border-cream-dim/20 bg-navy-900/60 p-4">
          ${setting}
          <img src="${escapeHtml(assets.minny_idle)}" alt="Minny" class="relative h-24 w-auto" />
          ${assets.kid_reading ? `<img src="${escapeHtml(assets.kid_reading)}" alt="" class="relative h-32 w-auto" />` : ''}
          ${assets.animal ? `<img src="${escapeHtml(assets.animal)}" alt="" class="relative h-20 w-auto" />` : ''}
        </div>
      `;
    }

    function hashSeed(str) {
      let h = 0;
      const s = String(str || '');
      for (let i = 0; i < s.length; i += 1) {
        h = (h * 31 + s.charCodeAt(i)) | 0;
      }
      return Math.abs(h) || 1;
    }

    function seededShuffle(arr, seed) {
      const out = arr.slice();
      let s = seed;
      for (let i = out.length - 1; i > 0; i -= 1) {
        s = (s * 9301 + 49297) % 233280;
        const j = Math.floor((s / 233280) * (i + 1));
        [out[i], out[j]] = [out[j], out[i]];
      }
      return out;
    }

    function showError(message) {
      loadingCard.classList.add('hidden');
      lessonCard.classList.add('hidden');
      errorCard.textContent = message;
      errorCard.classList.remove('hidden');
    }

    // Draft autosave — restore khi reload bất ngờ, clear khi submit pass.
    const DRAFT_TTL_MS = 7 * 24 * 60 * 60 * 1000;
    const draftKey = () => `r2l-draft:${accessCode}:${packId}`;

    function saveDraft() {
      if (!packId || !lesson) return;
      try {
        const payload = {
          answers: collectAnswers(),
          listen_completed_at: listenCompletedAt,
          read_completed_at: readCompletedAt,
          current_step: currentStep,
          saved_at: Date.now(),
        };
        localStorage.setItem(draftKey(), JSON.stringify(payload));
      } catch {}
    }

    function loadDraft() {
      try {
        const raw = localStorage.getItem(draftKey());
        if (!raw) return null;
        const data = JSON.parse(raw);
        if (!data?.saved_at || Date.now() - data.saved_at > DRAFT_TTL_MS) {
          localStorage.removeItem(draftKey());
          return null;
        }
        return data;
      } catch {
        return null;
      }
    }

    function clearDraft() {
      try { localStorage.removeItem(draftKey()); } catch {}
    }

    function applyDraft(draft) {
      if (!draft) return;
      if (draft.listen_completed_at) listenCompletedAt = draft.listen_completed_at;
      if (draft.read_completed_at) readCompletedAt = draft.read_completed_at;
      const answers = draft.answers || {};
      Object.entries(answers).forEach(([type, byIndex]) => {
        if (!byIndex || typeof byIndex !== 'object') return;
        Object.entries(byIndex).forEach(([index, value]) => {
          if (value == null || value === '') return;
          // Radio buttons match by name+value, others by data-answer-type + index
          document.querySelectorAll(`[data-answer-type="${type}"][data-answer-index="${index}"]`).forEach((el) => {
            if (el.type === 'radio') {
              if (el.value === String(value)) el.checked = true;
            } else {
              el.value = value;
            }
          });
        });
      });
    }

    function optionHtml(value, label = value) {
      return `<option value="${escapeHtml(value)}">${escapeHtml(label)}</option>`;
    }

    function renderTapWordsCard(item) {
      const chips = (item.shuffled_words || []).map((word, wIdx) => `
        <button type="button" data-tap-word data-tap-sentence="${item.index}" data-tap-source="pool" data-tap-word-text="${escapeHtml(word)}" data-tap-id="${item.index}-${wIdx}" class="inline-flex items-center rounded-md border border-gold/40 bg-gold/10 px-3 py-2 text-sm font-semibold text-gold-light transition hover:bg-gold hover:text-navy-950">${escapeHtml(word)}</button>
      `).join('');
      return `
        <div data-tap-card data-tap-card-index="${item.index}">
          <p class="mt-3 text-xs text-cream-dim">Khung trả lời:</p>
          <div data-tap-answer="${item.index}" class="mt-1 flex min-h-[3rem] flex-wrap gap-2 rounded-lg border border-dashed border-cream-dim/40 bg-navy-950/60 p-2"></div>
          <p class="mt-3 text-xs text-cream-dim">Bấm vào từ để thêm vào câu:</p>
          <div data-tap-pool="${item.index}" class="mt-1 flex flex-wrap gap-2">${chips}</div>
          <input type="hidden" data-answer-type="dictation" data-answer-index="${item.index}" value="" required />
        </div>
      `;
    }

    function renderPart(part, activitySeed) {
      void activitySeed;
      const sub = part.sub_title_vi
        ? `<h4 class="mt-4 mb-3 font-display text-lg font-bold text-gold-light">${escapeHtml(part.sub_title_vi)}</h4>`
        : '';
      if (part.kind === 'chunks_glossary') {
        return sub + `
          <div class="grid gap-3 md:grid-cols-2">
            ${part.items.map((item) => `
              <div class="rounded-lg border border-cream-dim/20 bg-navy-900/75 p-4">
                <p class="font-semibold text-cream">${escapeHtml(item.chunk)}</p>
                <p class="mt-1 text-sm text-cream-muted">${escapeHtml(item.meaning)}</p>
                ${item.example ? `<p class="mt-2 text-sm italic text-cream-dim">${escapeHtml(item.example)}</p>` : ''}
              </div>
            `).join('')}
          </div>
        `;
