  qs('#submit-confirm-no')?.addEventListener('click', () => {
    qs('#submit-confirm-modal')?.classList.add('hidden');
  });

  /* ----- Minny hero moods (video → PNG fallback) ----- */
  const _r2lMinnyVideoAvailable = new Map();

  function _r2lMinnyAssetBase(mood) {
    const file = ['idle', 'listen', 'celebrate', 'encourage'].includes(mood) ? mood : 'idle';
    return `/assets/minny/minny_${file}`;
  }

  function _r2lShowMinnyPng(mood, heroEl) {
    const img = heroEl?.querySelector('[data-minny-fallback]');
    const video = heroEl?.querySelector('[data-minny-video]');
    if (!img) return;
    img.src = `${_r2lMinnyAssetBase(mood)}.png`;
    img.classList.remove('hidden');
    if (video) video.classList.add('hidden');
  }

  function _r2lSetMinnyMood(mood, heroEl) {
    if (!heroEl) return;
    const video = heroEl.querySelector('[data-minny-video]');
    const img = heroEl.querySelector('[data-minny-fallback]');
    const base = _r2lMinnyAssetBase(mood);
    const cacheKey = `${heroEl.dataset.minnyHero || 'default'}:${mood}`;

    if (!video) {
      _r2lShowMinnyPng(mood, heroEl);
      return;
    }

    if (_r2lMinnyVideoAvailable.get(cacheKey) === false) {
      _r2lShowMinnyPng(mood, heroEl);
      return;
    }

    const tryPlay = (ext) => {
      video.onerror = () => {
        if (ext === 'mp4') {
          video.src = `${base}.webm`;
          video.onerror = () => {
            _r2lMinnyVideoAvailable.set(cacheKey, false);
            _r2lShowMinnyPng(mood, heroEl);
          };
        } else {
          _r2lMinnyVideoAvailable.set(cacheKey, false);
          _r2lShowMinnyPng(mood, heroEl);
        }
      };
      video.onloadeddata = () => {
        _r2lMinnyVideoAvailable.set(cacheKey, true);
        video.classList.remove('hidden');
        if (img) img.classList.add('hidden');
        video.play().catch(() => _r2lShowMinnyPng(mood, heroEl));
      };
      video.poster = `${base}.png`;
      video.src = `${base}.${ext}`;
      video.load();
    };

    tryPlay('mp4');
  }

  function _r2lInitMinnyHero(heroEl) {
    if (!heroEl || heroEl.dataset.minnyReady) return;
    heroEl.dataset.minnyReady = 'true';
    _r2lSetMinnyMood('idle', heroEl);
  }

  function _r2lSpeakLine(text, lang, onEnd) {
    const line = String(text || '').trim();
    if (!line || !window.speechSynthesis) {
      if (typeof onEnd === 'function') onEnd();
      return;
    }
    _r2lTrackLearningEvent('audio');
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(line);
    utterance.lang = lang;
    utterance.rate = lang.startsWith('vi') ? 0.95 : 0.92;
    utterance.onend = () => {
      if (typeof onEnd === 'function') onEnd();
    };
    utterance.onerror = () => {
      if (typeof onEnd === 'function') onEnd();
    };
    window.speechSynthesis.speak(utterance);
  }

  function _r2lSpeakEnglishLine(text, onEnd) {
    _r2lSpeakLine(text, 'en-US', onEnd);
  }

  function _r2lSpeakVietnameseLine(text, onEnd) {
    _r2lSpeakLine(text, 'vi-VN', onEnd);
  }

  function _r2lMinnyMoodForScore(scorePercent) {
    return Number(scorePercent || 0) >= 70 ? 'celebrate' : 'encourage';
  }

  /* ----- Activity 6: retell summary (open mode, up to 60s) ----- */
  const RETELL_MAX_SECONDS = 60;
  const _r2lRetellState = {
    mediaRecorder: null,
    stream: null,
    chunks: [],
    blob: null,
    status: 'idle',
    timerId: null,
    secondsLeft: RETELL_MAX_SECONDS,
    storyContext: '',
    heardInstruction: false,
    result: null,
    failureCount: 0,
    silentAttempts: 0,
    heroEl: null,
    root: null,
    activity: null,
  };

  function _r2lBuildStoryContext(lesson) {
    const chunks = [];
    if (lesson?.story?.title) chunks.push(String(lesson.story.title));
    if (lesson?.topic) chunks.push(String(lesson.topic));
    for (const paragraph of lesson?.story?.paragraphs_en || []) {
      chunks.push(String(paragraph));
    }
    return chunks.join(' ').trim();
  }

  function _r2lResolveRetellPrompt(activity, lesson) {
    const title = lesson?.story?.title || 'the story';
    return {
      vi: activity?.prompt_vi
        || activity?.instructions_vi
        || `Con nhìn truyện bên dưới, điền các chỗ trống và kể lại “${title}” bằng tiếng Anh trong khoảng 1 phút nhé.`,
      en: activity?.prompt_en
        || `Read the story below, fill in the blanks, and retell "${title}" in English.`,
    };
  }

  function _r2lResolveRetellTemplate(activity, lesson) {
    if (activity?.retell_template?.lines?.length) {
      return activity.retell_template;
    }
    return _r2lBuildRetellTemplate(lesson);
  }

  function _r2lBuildRetellStoryHtml(lesson) {
    const story = lesson?.story || {};
    const title = story.title || 'Câu chuyện';
    const paragraphs = Array.isArray(story.paragraphs_en) ? story.paragraphs_en : [];
    if (!paragraphs.length) return '';
    return `
      <section class="r2l-retell-story" data-retell-story data-state="expanded" aria-label="Truyện tham khảo">
        <div class="r2l-retell-story-head">
          <h3 class="r2l-retell-story-title">📖 ${escapeHtml(title)}</h3>
          <button type="button" class="r2l-retell-story-toggle" data-retell-story-toggle>Thu gọn truyện ▲</button>
        </div>
        <div class="r2l-retell-story-body" data-retell-story-body>
          ${paragraphs.map((p) => `<p>${escapeHtml(p)}</p>`).join('')}
        </div>
      </section>
    `;
  }

  function _r2lBindRetellStoryToggle(root) {
    const storySection = root?.querySelector('[data-retell-story]');
    const toggle = root?.querySelector('[data-retell-story-toggle]');
    if (!storySection || !toggle) return;
    toggle.addEventListener('click', () => {
      const collapsed = storySection.dataset.state === 'collapsed';
      storySection.dataset.state = collapsed ? 'expanded' : 'collapsed';
      toggle.textContent = collapsed ? 'Thu gọn truyện ▲' : 'Mở truyện ▼';
    });
  }

  function _r2lBuildRetellTemplateHtml(template) {
    const lines = Array.isArray(template?.lines) ? template.lines : [];
    if (!lines.length) return '';
    const items = lines
      .map(
        (line) => `
          <p class="r2l-retell-template-line">
            ${escapeHtml(line.template || '')}
            ${line.hint_vi ? `<span class="r2l-retell-template-hint">${escapeHtml(line.hint_vi)}</span>` : ''}
          </p>
        `,
      )
      .join('');
    return `
      <div class="r2l-retell-template" data-retell-template aria-label="Khung điền chỗ trống khi kể">
        <p class="r2l-retell-template-label">Con điền chỗ trống khi kể bằng tiếng Anh</p>
        ${items}
        <p class="r2l-retell-guide-hint">Con nhìn truyện phía trên để điền — không cần đúng từng chữ.</p>
      </div>
    `;
  }

  function _r2lPlayRetellStoryAudio(listenBtn, template, onEnd) {
    stopLessonAudio();
    const fullUrl = state.lesson?.story?.full_audio_url || '';
    if (fullUrl) {
      playAudio(fullUrl, listenBtn);
      const audio = lessonAudioState.audio;
      if (audio) {
        audio.addEventListener('ended', onEnd, { once: true });
        audio.addEventListener('error', onEnd, { once: true });
      } else {
        onEnd();
      }
      return;
    }
    _r2lSpeakEnglishLine(template?.speak_prompt_en || _r2lBuildStoryContext(state.lesson), onEnd);
  }

  function _r2lCleanupRetellRecording() {
    if (_r2lRetellState.timerId) {
      window.clearInterval(_r2lRetellState.timerId);
      _r2lRetellState.timerId = null;
    }
    if (_r2lRetellState.mediaRecorder && _r2lRetellState.status === 'recording') {
      try {
        _r2lRetellState.mediaRecorder.stop();
      } catch {}
    }
    if (_r2lRetellState.recorderCtl && _r2lRetellState.status === 'recording') {
      try {
        _r2lRetellState.recorderCtl.stop();
      } catch {}
    }
    if (_r2lRetellState.monitor) {
      _r2lSafeStopMonitor(_r2lRetellState.monitor);
      _r2lRetellState.monitor = null;
    }
    if (_r2lRetellState.stream) {
      _r2lRetellState.stream.getTracks().forEach((track) => track.stop());
      _r2lRetellState.stream = null;
    }
    _r2lRetellState.mediaRecorder = null;
    _r2lRetellState.recorderCtl = null;
    _r2lRetellState.chunks = [];
    _r2lRetellState.blob = null;
    _r2lRetellState.warmupCancelled = false;
    if (_r2lRetellState.status === 'recording' || _r2lRetellState.status === 'warming') {
      _r2lRetellState.status = 'idle';
    }
    _r2lRetellState.secondsLeft = RETELL_MAX_SECONDS;
  }

  function _r2lRenderRetellControls() {
    const listenBtn = _r2lRetellState.root?.querySelector('[data-retell-listen]');
    const recordBtn = _r2lRetellState.root?.querySelector('[data-retell-record]');
    const timerEl = _r2lRetellState.root?.querySelector('[data-retell-timer]');
    const statusEl = _r2lRetellState.root?.querySelector('[data-retell-status]');
    const meterEl = _r2lRetellState.root?.querySelector('[data-retell-meter]');
    if (meterEl) meterEl.hidden = _r2lRetellState.status !== 'recording';
    if (!recordBtn || !statusEl) return;

    const micReady = _r2lMicIsReady();
    if (_r2lRetellState.status === 'warming') {
      recordBtn.textContent = 'Hủy';
      recordBtn.disabled = false;
      timerEl?.classList.add('hidden');
      statusEl.textContent = _r2lRetellState.warmupMessage || 'Micro đã bật — chờ 3 giây rồi mới nói nhé…';
      if (listenBtn) listenBtn.disabled = true;
      return;
    }
    if (_r2lRetellState.status === 'recording') {
      recordBtn.textContent = '⏹ Dừng thu';
      recordBtn.disabled = false;
      timerEl?.classList.remove('hidden');
      if (timerEl) timerEl.textContent = `${_r2lRetellState.secondsLeft}s`;
      statusEl.textContent = 'Minny đang nghe con kể truyện...';
      return;
    }

    timerEl?.classList.add('hidden');
    if (_r2lRetellState.status === 'uploading') {
      recordBtn.disabled = true;
      recordBtn.textContent = '🎤 Con kể';
      statusEl.textContent = 'Minny đang nhận xét bài kể của con...';
      if (listenBtn) listenBtn.disabled = true;
      return;
    }

    recordBtn.textContent = '🎤 Con kể';
    recordBtn.disabled = !micReady || !_r2lRetellState.heardInstruction;
    if (listenBtn) listenBtn.disabled = false;
    if (!micReady) {
      statusEl.textContent = 'Micro chưa sẵn sàng. Con thử Chrome hoặc Safari mới nhất nhé.';
    } else if (!_r2lRetellState.heardInstruction) {
      statusEl.textContent = 'Bước 1: Đọc truyện và khung chỗ trống. Bước 2: Bấm Nghe truyện. Bước 3: Con kể.';
    } else {
      statusEl.textContent = `Con kể bằng tiếng Anh theo khung chỗ trống (tối đa ${RETELL_MAX_SECONDS} giây).`;
    }
  }

  function _r2lRenderRetellFeedback(result) {
    const slot = _r2lRetellState.root?.querySelector('[data-retell-feedback]');
    if (!slot) return;
    if (!result) {
      slot.classList.add('hidden');
      slot.innerHTML = '';
      return;
    }
    slot.classList.remove('hidden');
    slot.innerHTML = _r2lBuildOpenSpeakingFeedbackHtml(result);
  }

  async function _r2lSubmitRetellRecording(blob, telemetry = null) {
    const uploadSeq = _r2lNextSpeakUploadSeq();
    const stuckMessage = 'Mạng hơi chậm, Minny chấm chưa kịp. Con bấm Thu lại nhé!';
    _r2lRetellState.uploadSeq = uploadSeq;
    _r2lRetellState.status = 'uploading';
    _r2lRenderRetellControls();
    _r2lRenderRetellFeedback({ loading: true });

    const watchdog = window.setTimeout(() => {
      if (_r2lRetellState.uploadSeq !== uploadSeq || _r2lRetellState.status !== 'uploading') return;
      _r2lRetellState.status = 'idle';
      _r2lRetellState.failureCount += 1;
      _r2lSetMinnyMood('encourage', _r2lRetellState.heroEl);
      _r2lRenderRetellFeedback({ ok: false, message: stuckMessage });
      _r2lMaybeOfferRetellSkip();
      _r2lRenderRetellControls();
    }, _R2L_SPEAK_CHECK_TIMEOUT_MS + 1500);

    try {
      const payload = await _r2lPostSpeakingCheck(
        blob,
        _r2lRetellState.storyContext,
        'open',
        RETELL_MAX_SECONDS,
        telemetry,
      );
      if (_r2lRetellState.uploadSeq !== uploadSeq) return;
      if (_r2lAsrFailureLooksLikeOutage(payload) && _r2lRecordingHadVoice(telemetry)) {
        _r2lRetellState.status = 'idle';
        _r2lRetellState.failureCount += 1;
        _r2lRenderRetellFeedback({
          ok: false,
          message: _R2L_ASR_OUTAGE_MSG,
        });
        _r2lMaybeOfferRetellSkip();
        _r2lRenderRetellControls();
        return;
      }
      // Analyser heard the child but ASR heard nothing → broken platform
      // encoder on this machine; switch future recordings to the WAV engine.
      if (
        payload && !payload.ok && payload.error === 'transcription_failed'
        && telemetry && telemetry.voiced === true && telemetry.engine === 'mr'
      ) {
        window.R2LRecorder?.useWavEngine?.();
      }
      _r2lRetellState.result = payload;
      const passed = payload?.ok && Number(payload.score_percent || 0) >= _R2L_SPEAKING_PASS_PERCENT;
      _r2lRetellState.status = passed ? 'done' : 'idle';
      _r2lRenderRetellFeedback(payload);
      patchActivityProgress('retell_summary', {
        heard_instruction: _r2lRetellState.heardInstruction,
        result: payload,
      });
      if (passed) {
        _r2lRetellState.failureCount = 0;
        _r2lSetMinnyMood(_r2lMinnyMoodForScore(payload.score_percent), _r2lRetellState.heroEl);
        completeActivity('retell_summary', {
          correct_count: Number(payload.correct_count || 0),
          total_count: Number(payload.total_count || 1),
          wrong_count: 0,
          score_percent: Number(payload.score_percent || 0),
          check_mode: 'open',
        });
      } else {
        _r2lRetellState.failureCount += 1;
        _r2lSetMinnyMood('encourage', _r2lRetellState.heroEl);
        if (payload?.ok) showToast('Minny cần nghe được ít nhất 50%. Con kể lại nhé!');
        _r2lMaybeOfferRetellSkip();
      }
    } catch (error) {
      if (_r2lRetellState.uploadSeq !== uploadSeq) return;
      _r2lRetellState.status = 'idle';
      _r2lRetellState.failureCount += 1;
      _r2lSetMinnyMood('encourage', _r2lRetellState.heroEl);
      _r2lRenderRetellFeedback({
        ok: false,
        message: error.message || 'Chưa gửi được bài kể. Con thử lại nhé!',
      });
      _r2lMaybeOfferRetellSkip();
    } finally {
      window.clearTimeout(watchdog);
      if (_r2lRetellState.uploadSeq === uploadSeq && _r2lRetellState.status === 'uploading') {
        _r2lRetellState.status = 'idle';
        _r2lRetellState.failureCount += 1;
        _r2lSetMinnyMood('encourage', _r2lRetellState.heroEl);
        _r2lRenderRetellFeedback({ ok: false, message: stuckMessage });
        _r2lMaybeOfferRetellSkip();
      }
      _r2lRenderRetellControls();
    }
  }

  function _r2lCompleteRetellOnMicSkip() {
    if (state.completedTypes.has('retell_summary')) return;
    completeActivity('retell_summary', {
      correct_count: 0,
      total_count: 1,
      wrong_count: 1,
      score_percent: 0,
      check_mode: 'open',
      skipped_due_to_mic: true,
    });
  }

  async function _r2lStartRetellRecording() {
    if (!_r2lRetellState.heardInstruction || !_r2lMicIsReady()) return;
    if (!_r2lMicGateReady && !window.R2LMicCheck?.sessionPassed?.()) {
      _r2lRenderRetellFeedback({
        ok: false,
        message: 'Con bấm Kiểm tra micro ở khung phía trên trước nhé.',
      });
      return;
    }
    _r2lCleanupRetellRecording();
    try {
      const stream = await _r2lOpenMicStream();
      _r2lRetellState.stream = stream;
      _r2lRetellState.status = 'warming';
      _r2lRetellState.warmupCancelled = false;
      _r2lRetellState.warmupMessage = 'Micro đã bật — chờ 3 giây rồi mới nói nhé…';
      _r2lSetMinnyMood('listen', _r2lRetellState.heroEl);
      _r2lRenderRetellControls();

      await _r2lRunMicWarmup(
        stream,
        () => {},
        () => Boolean(_r2lRetellState.warmupCancelled) || _r2lRetellState.status !== 'warming',
      );
      if (_r2lRetellState.warmupCancelled || _r2lRetellState.status !== 'warming') {
        _r2lHideCountdownOverlay();
        stream.getTracks().forEach((track) => track.stop());
        _r2lRetellState.stream = null;
        return;
      }

      const trackState = window.R2LRecorder?.trackInfo?.(stream) || { live: true, muted: false, label: '' };
      if (!trackState.live) {
        _r2lHideCountdownOverlay();
        stream.getTracks().forEach((track) => track.stop());
        throw new Error('track_not_live');
      }
      const recorder = _r2lCreateUnifiedRecorder(stream);
      const monitor = window.R2LRecorder?.startMonitor
        ? await window.R2LRecorder.startMonitor(stream, {
            onLevel: (level) => {
              const bar = _r2lRetellState.root?.querySelector?.('[data-retell-meter-bar]');
              if (bar) bar.style.width = `${Math.min(100, Math.round((level / 64) * 100))}%`;
            },
            onSilenceHint: () => {
              const statusEl = _r2lRetellState.root?.querySelector?.('[data-retell-status]');
              if (statusEl) statusEl.textContent = 'Minny chưa thấy tiếng — con nói TO hơn nhé!';
            },
          })
        : { available: false, peak: () => -1, voiced: () => true, stop: () => {} };

      _r2lRetellState.mediaRecorder = null;
      _r2lRetellState.recorderCtl = recorder;
      _r2lRetellState.monitor = monitor;
      _r2lRetellState.deviceLabel = trackState.label || '';
      _r2lRetellState.chunks = [];
      _r2lRetellState.status = 'recording';
      _r2lRetellState.secondsLeft = RETELL_MAX_SECONDS;
      _r2lSetMinnyMood('listen', _r2lRetellState.heroEl);
      try {
        recorder.start();
        _r2lTrackLearningEvent('speak');
      } catch (startError) {
        _r2lHideCountdownOverlay();
        _r2lSafeStopMonitor(monitor);
        stream.getTracks().forEach((track) => track.stop());
        throw startError;
      }
      _r2lCountdownGo();
      _r2lPlayGoBeep();
      _r2lRenderRetellControls();

      _r2lRetellState.timerId = window.setInterval(() => {
        _r2lRetellState.secondsLeft -= 1;
        _r2lRenderRetellControls();
        if (_r2lRetellState.secondsLeft <= 0) {
          _r2lStopRetellRecording();
        }
      }, 1000);
    } catch (error) {
      _r2lHideCountdownOverlay();
      _r2lRetellState.status = 'idle';
      _r2lSetMinnyMood('encourage', _r2lRetellState.heroEl);
      _r2lRenderRetellFeedback({
        ok: false,
        message: _r2lRecorderHelpMessage(error),
      });
      _r2lFocusMicHelp(_r2lRetellState.heroEl);
      _r2lRenderRetellControls();
    }
  }

  async function _r2lStopRetellRecording() {
    if (_r2lRetellState.timerId) {
      window.clearInterval(_r2lRetellState.timerId);
      _r2lRetellState.timerId = null;
    }
    if (_r2lRetellState.recorderCtl && _r2lRetellState.status === 'recording') {
      const recorder = _r2lRetellState.recorderCtl;
      const monitor = _r2lRetellState.monitor;
      _r2lRetellState.status = 'stopping';
      let blob = null;
      try {
        blob = await recorder.stop();
      } catch {
        blob = null;
      }
      _r2lSafeStopMonitor(monitor);
      if (_r2lRetellState.stream) {
        _r2lRetellState.stream.getTracks().forEach((track) => track.stop());
        _r2lRetellState.stream = null;
      }
      _r2lRetellState.recorderCtl = null;
      _r2lRetellState.monitor = null;

      const voiced = window.R2LRecorder?.recordingLooksVoiced
        ? window.R2LRecorder.recordingLooksVoiced(monitor, blob?.size || 0)
        : (monitor?.available ? monitor.voiced() : true);
      const telemetry = {
        peak: monitor?.available ? monitor.peak() : -1,
        voiced,
        engine: recorder.engine || 'mr',
        mimeType: (blob && blob.type) || recorder.mimeType || '',
        deviceLabel: _r2lRetellState.deviceLabel || '',
      };

      if (!voiced && blob && blob.size > 0) {
        // Client-detected silent capture: relax constraints, log it, then retry.
        const silentAttempts = (_r2lRetellState.silentAttempts || 0) + 1;
        _r2lRetellState.silentAttempts = silentAttempts;
        window.R2LRecorder?.bumpProfile?.();
        _r2lReportSilentCapture(_r2lRetellState.storyContext, telemetry);
        _r2lRetellState.status = 'idle';
        _r2lSetMinnyMood('encourage', _r2lRetellState.heroEl);
        _r2lRenderRetellFeedback({
          ok: false,
          message: 'Micro chưa thu được tiếng. Ba mẹ kiểm tra hướng dẫn rồi con bấm Con kể lại nhé!',
        });
        _r2lRetellState.failureCount += 1;
        _r2lMaybeOfferRetellSkip();
        _r2lRenderRetellControls();
        return;
      }

      _r2lRetellState.blob = blob;
      if (blob && blob.size > 0) {
        _r2lRetellState.silentAttempts = 0;
        _r2lRetellState.status = 'uploading';
        _r2lSubmitRetellRecording(blob, telemetry);
      } else {
        _r2lRetellState.status = 'idle';
        _r2lRetellState.failureCount += 1;
        _r2lSetMinnyMood('encourage', _r2lRetellState.heroEl);
        _r2lRenderRetellFeedback({
          ok: false,
          message: 'Không thu được tiếng. Con thử nói to hơn và bấm Dừng thu nhé.',
        });
        _r2lMaybeOfferRetellSkip();
        _r2lRenderRetellControls();
      }
      return;
    }
    if (_r2lRetellState.mediaRecorder && _r2lRetellState.status === 'recording') {
      _r2lStopMediaRecorder(_r2lRetellState.mediaRecorder);
    }
  }

  function renderRetellSummaryActivity(root, activity) {
    const heroScope = root.closest('[data-activity-shell="retell_summary"]');
    _r2lInitMinnyHero(heroScope);
    const prompt = _r2lResolveRetellPrompt(activity, state.lesson);
    const template = _r2lResolveRetellTemplate(activity, state.lesson);
    _r2lRetellState.root = root;
    _r2lRetellState.heroEl = heroScope;
    _r2lRetellState.activity = activity;
    _r2lRetellState.storyContext = [
      template?.speak_prompt_en || '',
      _r2lBuildStoryContext(state.lesson),
    ].filter(Boolean).join(' ');
    _r2lRetellState.heardInstruction = false;
    _r2lRetellState.result = null;
    _r2lRetellState.status = 'idle';

    root.innerHTML = `
      <div class="r2l-minny-retell-prompt">
        <p class="text-base font-bold leading-7 text-cream">${escapeHtml(prompt.vi)}</p>
        <p class="r2l-minny-retell-prompt-en">${escapeHtml(prompt.en)}</p>
      </div>
      ${_r2lBuildRetellStoryHtml(state.lesson)}
      ${_r2lBuildRetellTemplateHtml(template)}
      <div class="r2l-minny-speak-actions mt-4">
        <button type="button" class="minny-btn minny-btn--listen" data-retell-listen>🔊 Nghe truyện</button>
        <button type="button" class="minny-btn minny-btn--record" data-retell-record disabled>🎤 Con kể</button>
      </div>
      <p class="mt-2 text-sm text-cream/65" data-retell-status></p>
      <span class="r2l-rec-meter" data-retell-meter hidden><span class="r2l-rec-meter-bar" data-retell-meter-bar></span></span>
      <span class="mt-1 hidden text-sm font-semibold text-gold" data-retell-timer></span>
      <div class="mt-4 hidden rounded-md border border-cream/10 bg-navy-950/35 p-3 text-sm text-cream/80" data-retell-feedback></div>
      <button type="button" class="r2l-secondary mt-4 w-full" data-retell-mic-skip hidden>
        Không sửa được — bỏ qua phần kể (không nhận thưởng)
      </button>
    `;

    _r2lBindRetellStoryToggle(root);

    root.querySelector('[data-retell-listen]')?.addEventListener('click', () => {
      _r2lRetellState.heardInstruction = true;
      patchActivityProgress('retell_summary', { heard_instruction: true });
      _r2lRenderRetellControls();
      _r2lSetMinnyMood('listen', heroScope);
      const listenBtn = root.querySelector('[data-retell-listen]');
      _r2lPlayRetellStoryAudio(listenBtn, template, () => {
        _r2lSetMinnyMood('idle', heroScope);
      });
    });

    root.querySelector('[data-retell-record]')?.addEventListener('click', () => {
      if (_r2lRetellState.status === 'recording') {
        _r2lStopRetellRecording();
      } else if (_r2lRetellState.status === 'warming') {
        _r2lRetellState.warmupCancelled = true;
        _r2lHideCountdownOverlay();
        _r2lCleanupRetellRecording();
        _r2lSetMinnyMood('idle', heroScope);
        _r2lRenderRetellControls();
      } else if (_r2lRetellState.status !== 'uploading') {
        _r2lStartRetellRecording();
      }
    });

    restoreRetellActivityProgress();
    _r2lRenderRetellControls();
  }

  window.addEventListener('beforeunload', _r2lCleanupRetellRecording);

  // ── Safe JSON helper: prevents crash on 502/503 HTML responses ──
  async function safeJson(res) {
    const ct = res.headers.get('content-type') || '';
    if (!ct.includes('application/json')) {
      throw new Error('Mạng không ổn định. Con đợi một chút rồi thử lại nhé!');
    }
    try {
      return await res.json();
    } catch {
      throw new Error('Mạng không ổn định. Con đợi một chút rồi thử lại nhé!');
    }
  }

  let submitInFlight = false;

  function pendingSubmitKey(code, packId) {
    return `r2l_pending_submit:${code}:${packId}`;
  }

  function savePendingSubmit(payload) {
    try {
      localStorage.setItem(pendingSubmitKey(state.accessCode, state.packId), JSON.stringify(payload));
    } catch {
      // localStorage unavailable — submit still works without backup
    }
  }

  function clearPendingSubmit() {
    try {
      localStorage.removeItem(pendingSubmitKey(state.accessCode, state.packId));
    } catch {
      // ignore
    }
  }

  function loadPendingSubmit() {
    try {
      const raw = localStorage.getItem(pendingSubmitKey(state.accessCode, state.packId));
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  const LESSON_SESSION_VERSION = 2;
  let _r2lSaveSessionTimer = null;

  function lessonSessionKey(code, packId) {
    return `r2l_lesson_session:${code}:${packId}`;
  }

  function saveLessonSession() {
    if (!state.accessCode || !state.packId || !state.lesson) return;
    try {
      const snapshot = {
        schema_version: LESSON_SESSION_VERSION,
        saved_at: new Date().toISOString(),
        activity_index: state.activityIndex,
        completed_types: Array.from(state.completedTypes),
        activity_results: state.activityResults,
        written_drafts: state.writtenDrafts,
        activity_progress: state.activityProgress,
        ...(isW1() ? {
          w1_phase: state.w1Phase,
          w1_max_unlocked: state.w1MaxUnlocked,
          w1_midpoint_celebrated: state.w1MidpointCelebrated,
          story_gate: state.storyGate,
          question_outcomes: state.questionOutcomes,
        } : {}),
      };
      sessionStorage.setItem(lessonSessionKey(state.accessCode, state.packId), JSON.stringify(snapshot));
    } catch {
      // sessionStorage full or unavailable
    }
  }

  function scheduleSaveLessonSession() {
    if (_r2lSaveSessionTimer) window.clearTimeout(_r2lSaveSessionTimer);
    _r2lSaveSessionTimer = window.setTimeout(() => {
      _r2lSaveSessionTimer = null;
      saveLessonSession();
    }, 250);
  }

  function loadLessonSession() {
    try {
      const raw = sessionStorage.getItem(lessonSessionKey(state.accessCode, state.packId));
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (parsed?.schema_version !== 1 && parsed?.schema_version !== LESSON_SESSION_VERSION) return null;
      return parsed;
    } catch {
      return null;
    }
  }

  function clearLessonSession() {
    try {
      sessionStorage.removeItem(lessonSessionKey(state.accessCode, state.packId));
    } catch {
      // ignore
    }
  }

  function restoreLessonSession() {
    const saved = loadLessonSession();
    if (!saved) return false;
    state.completedTypes = new Set(saved.completed_types || []);
    state.activityResults = saved.activity_results || {};
    state.writtenDrafts = saved.written_drafts || {};
    state.activityProgress = saved.activity_progress || {};
    const activities = state.lesson?.activities || [];
    let index = Number(saved.activity_index);
    if (!Number.isFinite(index)) index = 0;
    const currentType = activities[index]?.type;
    if (currentType && state.completedTypes.has(currentType)) {
      const nextIncomplete = activities.findIndex((activity) => !state.completedTypes.has(activity?.type));
      index = nextIncomplete >= 0 ? nextIncomplete : index;
    }
    state.activityIndex = Math.max(0, Math.min(index, Math.max(0, activities.length - 1)));
    if (isW1()) {
      state.w1Phase = saved.w1_phase === 'activities' || saved.w1_phase === 'result' ? saved.w1_phase : 'story';
      state.w1MaxUnlocked = Number.isFinite(Number(saved.w1_max_unlocked))
        ? Math.max(0, Number(saved.w1_max_unlocked))
        : Math.max(0, state.completedTypes.size - 1);
      state.w1MidpointCelebrated = Boolean(saved.w1_midpoint_celebrated);
      if (saved.story_gate && typeof saved.story_gate === 'object') {
        state.storyGate = {
          read_done: Boolean(saved.story_gate.read_done),
          listen_done: Boolean(saved.story_gate.listen_done),
          paragraphs_played: Array.isArray(saved.story_gate.paragraphs_played)
            ? saved.story_gate.paragraphs_played.slice()
            : [],
          card_index: Number(saved.story_gate.card_index) || 0,
        };
      }
      state.questionOutcomes = saved.question_outcomes || {};
      if (state.storyGate.read_done && state.storyGate.listen_done) {
        state.w1Phase = state.w1Phase === 'story' ? 'activities' : state.w1Phase;
      }
    }
    return true;
  }

  function patchActivityProgress(type, patch) {
    state.activityProgress[type] = {
      ...(state.activityProgress[type] || {}),
      ...patch,
    };
    scheduleSaveLessonSession();
  }

  function markSpeakHeard(activity, itemIndex) {
    const progress = state.activityProgress.listen_and_speak || { heard: [], items: {} };
    const heard = Array.isArray(progress.heard) ? progress.heard.slice() : [];
    if (!heard.includes(itemIndex)) heard.push(itemIndex);
    patchActivityProgress('listen_and_speak', { heard, items: progress.items || {} });
  }

  function persistSpeakItemResult(itemKey, entry) {
    const progress = state.activityProgress.listen_and_speak || { heard: [], items: {} };
    const items = { ...(progress.items || {}) };
    if (entry?.checkResult?.ok) {
      items[itemKey] = {
        checkStatus: entry.checkStatus,
        checkResult: entry.checkResult,
        expectedText: entry.expectedText || '',
      };
    } else {
      delete items[itemKey];
    }
    patchActivityProgress('listen_and_speak', {
      heard: progress.heard || [],
      items,
    });
  }

  function restoreSpeakActivityProgress(root, activity) {
    const saved = state.activityProgress.listen_and_speak;
    if (!saved) return;
    (saved.heard || []).forEach((itemIndex) => {
      const recordBtn = root.querySelector(`[data-speak-record="${itemIndex}"]`);
      if (recordBtn) {
        recordBtn.dataset.heard = 'true';
        recordBtn.disabled = !_r2lMicIsReady();
      }
    });
    Object.entries(saved.items || {}).forEach(([itemKey, itemData]) => {
      const itemIndex = (activity.items || []).findIndex((item, index) => (item.id || `ls_${index}`) === itemKey);
      if (itemIndex < 0) return;
      const cardEl = root.querySelector(`[data-speak-card="${itemIndex}"]`);
      if (!cardEl) return;
      _r2lRecorderState.perItem.set(itemKey, {
        mediaRecorder: null,
        chunks: [],
        blob: null,
        blobUrl: null,
        status: 'recorded',
        expectedText: itemData.expectedText || activity.items[itemIndex]?.text_en || '',
        checkStatus: itemData.checkStatus || 'idle',
        checkResult: itemData.checkResult || null,
      });
      _r2lSyncMinnyRecordButton(itemKey, cardEl);
      if (itemData.checkResult) {
        _r2lRenderSpeakFeedback(cardEl, itemData.checkResult);
      }
    });
    _r2lMergeSpeakActivityScores(activity);
  }

  function restoreRetellActivityProgress() {
    const saved = state.activityProgress.retell_summary;
    if (!saved) return;
    if (saved.heard_instruction) {
      _r2lRetellState.heardInstruction = true;
    }
    if (saved.result) {
      _r2lRetellState.result = saved.result;
      _r2lRetellState.status = 'done';
      _r2lRenderRetellFeedback(saved.result);
    }
  }

  window.addEventListener('pagehide', saveLessonSession);

  // ── Toast: non-destructive error (does NOT hide lesson) ──
  function showToast(message, durationMs = 4000) {
    let toast = qs('#r2l-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'r2l-toast';
      toast.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);z-index:9999;max-width:90vw;padding:12px 20px;border-radius:8px;background:#b45309;color:#fff;font-size:14px;font-weight:600;text-align:center;opacity:0;transition:opacity 0.3s;pointer-events:none;';
      document.body.appendChild(toast);
    }
    toast.textContent = message;
    toast.style.opacity = '1';
    clearTimeout(toast._hideTimer);
    toast._hideTimer = setTimeout(() => { toast.style.opacity = '0'; }, durationMs);
  }

  init();

  async function init() {
    const params = new URLSearchParams(window.location.search);
    state.accessCode = (params.get('code') || '').trim().toUpperCase();
    state.packId = (params.get('pack_id') || '').trim();
    if (!state.accessCode || !state.packId) {
      showError('Thiếu mã học sinh hoặc mã bài. Anh Phương mở lại từ link bài học nhé.');
      return;
    }

    const FETCH_TIMEOUT_MS = 15000;
    const MAX_RETRIES = 2;
    let lastError = '';

    for (let attempt = 0; attempt <= MAX_RETRIES; attempt += 1) {
      try {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);
        const res = await fetch(
          `/api/read2lead-lesson?code=${encodeURIComponent(state.accessCode)}&pack_id=${encodeURIComponent(state.packId)}`,
          { signal: controller.signal },
        );
        clearTimeout(timer);
        const data = await safeJson(res);
        if (!res.ok || !data.ok) throw new Error(data.message || data.error || 'Không tải được bài.');
        const schemaVersion = String(data.lesson?.schema_version ?? '');
        if (schemaVersion !== '2' && schemaVersion !== '2.0' && schemaVersion !== '2.1') {
          throw new Error('Bài này vẫn là format cũ. V2 lesson chỉ nhận pack schema_version = 2.');
        }
        renderLesson(data.lesson);
        return;
      } catch (error) {
        lastError = error.name === 'AbortError'
          ? 'Mạng hơi chậm. Đang thử lại...'
          : (error.message || 'Có lỗi khi mở bài học.');
        if (attempt < MAX_RETRIES) {
          qs('#loading-message').textContent = `Mạng hơi chậm, đang thử lại... (${attempt + 1}/${MAX_RETRIES})`;
          await new Promise((r) => setTimeout(r, 2000));
        }
      }
    }
    showError(lastError || 'Có lỗi khi mở bài học.');
  }

  qs('#error-retry')?.addEventListener('click', () => {
    qs('#error-card')?.classList.add('hidden');
    qs('#loading-card')?.classList.remove('hidden');
    const loadingMsg = qs('#loading-message');
    if (loadingMsg) loadingMsg.textContent = 'Minny đang mở nhiệm vụ cho con...';
    init();
  });

  function setStoryAudioButtonState(button, audioUrl) {
    if (audioUrl) {
      button.textContent = 'Nghe cả truyện';
      button.disabled = false;
      return;
    }
    button.textContent = 'Chưa có audio';
    button.disabled = true;
  }

  async function pollDeferredFullStoryAudio(button) {
    button.textContent = 'Đang tạo audio truyện...';
    button.disabled = true;
    const maxAttempts = 12;
    const intervalMs = 3000;
    for (let attempt = 0; attempt < maxAttempts; attempt += 1) {
      await new Promise((resolve) => window.setTimeout(resolve, intervalMs));
      try {
        const res = await fetch(
          `/api/read2lead-lesson?code=${encodeURIComponent(state.accessCode)}&pack_id=${encodeURIComponent(state.packId)}`,
        );
        const data = await safeJson(res);
        const mergedUrl = data.lesson?.story?.full_audio_url || '';
        if (res.ok && data.ok && mergedUrl) {
          state.lesson.story.full_audio_url = mergedUrl;
          setStoryAudioButtonState(button, mergedUrl);
          return;
        }
      } catch {
        // keep polling until attempts exhausted
      }
    }
    setStoryAudioButtonState(button, '');
  }

  function ensureLessonActivities(lesson) {
    if (isV21Lesson(lesson)) {
      return ensureLessonActivitiesV21(lesson);
    }
    const activities = Array.isArray(lesson?.activities) ? [...lesson.activities] : [];
    const lessonContext = {
      story: lesson?.story,
      topic: lesson?.topic || '',
      activities,
    };
    const existingIndex = activities.findIndex((activity) => activity?.type === 'retell_summary');
    if (existingIndex >= 0) {
      activities[existingIndex] = _r2lEnrichRetellActivity(activities[existingIndex], lessonContext);
      lesson.activities = activities;
      return lesson;
    }
    const retell = _r2lEnrichRetellActivity({
      type: 'retell_summary',
      title_vi: 'Kể truyện',
      identity_vi: 'Minny muốn nghe con kể lại — con điền chỗ trống và nhìn truyện bên dưới nhé',
      instructions_vi: 'Con đọc truyện, điền các chỗ trống trong khung vàng, rồi kể bằng tiếng Anh.',
    }, lessonContext);
    const speakIndex = activities.findIndex((activity) => activity?.type === 'listen_and_speak');
    if (speakIndex >= 0) {
      activities.splice(speakIndex + 1, 0, retell);
    } else {
      activities.push(retell);
    }
    lesson.activities = activities;
    if (
      lesson.activities.length < 6
      && !lesson.activities.some((activity) => activity?.type === 'retell_summary')
    ) {
      lesson.activities.push({
        type: 'retell_summary',
        title_vi: 'Kể truyện',
        identity_vi: 'Minny muốn nghe con kể lại',
        instructions_vi: 'Con đọc truyện, điền các chỗ trống trong khung vàng, rồi kể bằng tiếng Anh.',
      });
      lesson.activities[lesson.activities.length - 1] = _r2lEnrichRetellActivity(
        lesson.activities[lesson.activities.length - 1],
        lessonContext,
      );
    }
    return lesson;
  }

  function ensureLessonActivitiesV21(lesson) {
    const activities = Array.isArray(lesson?.activities) ? [...lesson.activities] : [];
    if (!activities.some((a) => a?.type === 'speed_round')) {
      activities.push({
        type: 'speed_round',
        title_vi: 'Tổng công kích',
        identity_vi: 'Chiến binh tốc độ',
        instructions_vi: 'Trả lời thật nhanh các câu đã học!',
        items: [],
      });
    }
    lesson.activities = activities;
    _r2lCreateGameState();
    return lesson;
  }

  function _r2lEnrichRetellActivity(activity, lessonContext) {
    const template = activity?.retell_template?.lines?.length
      ? activity.retell_template
      : _r2lBuildRetellTemplate(lessonContext);
    const title = lessonContext?.story?.title || 'câu chuyện';
    return {
      ...activity,
      retell_template: template,
      speak_prompt_en: activity?.speak_prompt_en || template.speak_prompt_en,
      prompt_vi: activity?.prompt_vi || `Con nhìn truyện bên dưới, điền các chỗ trống và kể lại “${title}” bằng tiếng Anh trong khoảng 1 phút nhé.`,
      prompt_en: activity?.prompt_en || `Read the story below, fill in the blanks, and retell "${title}" in English.`,
    };
  }

  function w1StoryHasAnyAudio(story) {
    if (!story) return false;
    if (story.full_audio_url) return true;
    return (story.sentences || []).some((sentence) => Boolean(sentence?.audio_url));
  }

  function w1GateComplete() {
    return Boolean(state.storyGate.read_done && state.storyGate.listen_done);
  }

  function w1UpdateGateChips() {
    const readChip = qs('#w1-chip-read');
    const listenChip = qs('#w1-chip-listen');
    if (readChip) readChip.dataset.done = String(state.storyGate.read_done);
    if (listenChip) listenChip.dataset.done = String(state.storyGate.listen_done);
    const openBtn = qs('#w1-open-quests');
    if (openBtn) openBtn.disabled = !w1GateComplete();
  }

  function w1MarkParagraphPlayed(paragraphIndex) {
    const played = state.storyGate.paragraphs_played || [];
    if (!played.includes(paragraphIndex)) {
      played.push(paragraphIndex);
      state.storyGate.paragraphs_played = played;
    }
    const totalParagraphs = (state.lesson?.story?.paragraphs_en || []).length;
    const allPlayed = totalParagraphs > 0 && played.length >= totalParagraphs;
    if (allPlayed) state.storyGate.listen_done = true;
    w1UpdateGateChips();
    scheduleSaveLessonSession();
  }

  function w1CheckListenAutoPass(story) {
    if (!w1StoryHasAnyAudio(story)) {
      state.storyGate.listen_done = true;
      w1UpdateGateChips();
    }
  }

  function w1RenderStoryCard() {
    const story = state.lesson?.story || {};
    const paragraphs = story.paragraphs_en || [];
    const idx = Math.max(0, Math.min(state.storyGate.card_index || 0, Math.max(0, paragraphs.length - 1)));
    state.storyGate.card_index = idx;
    const host = qs('#w1-story-cards');
    if (!host) return;
    if (!paragraphs.length) {
      host.innerHTML = '<p class="text-cream/70">Chưa có truyện trong bài này.</p>';
      return;
    }
    const text = paragraphs[idx] || '';
    host.innerHTML = `
      <article class="r2l-w1-story-card" data-w1-card-index="${idx}">
        <p class="text-xs font-bold uppercase tracking-wide text-gold/80">Trang ${idx + 1}/${paragraphs.length}</p>
        <p class="mt-3" id="w1-card-text">${escapeHtml(text)}</p>
      </article>
    `;
    const prev = qs('#w1-story-prev');
    const next = qs('#w1-story-next');
    if (prev) prev.classList.toggle('hidden', idx <= 0);
    if (next) next.textContent = idx >= paragraphs.length - 1 ? 'Đọc xong trang này ✓' : 'Tiếp →';
  }

  function w1MarkReadProgressFromCard() {
    const paragraphs = state.lesson?.story?.paragraphs_en || [];
    const idx = state.storyGate.card_index || 0;
    if (idx >= paragraphs.length - 1) {
      state.storyGate.read_done = true;
      w1UpdateGateChips();
      scheduleSaveLessonSession();
    }
  }

  function w1OpenStoryPanel() {
    const dock = qs('#story-dock');
    if (dock?.dataset.dockState === 'collapsed') toggleDock();
    dock?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  let _w1StoryPhaseBound = false;

  function w1InitStoryPhase() {
    w1CheckListenAutoPass(state.lesson?.story || {});
    w1RenderStoryCard();
    w1UpdateGateChips();
    qs('#w1-story-phase')?.classList.remove('hidden');
    qs('#w1-legacy-progress')?.classList.add('hidden');
    qsa('[data-activity-shell]').forEach((shell) => { shell.hidden = true; });
    qs('#global-cta')?.classList.add('hidden');
    if (_w1StoryPhaseBound) return;
    _w1StoryPhaseBound = true;
    qs('#w1-story-prev')?.addEventListener('click', () => {
      state.storyGate.card_index = Math.max(0, (state.storyGate.card_index || 0) - 1);
      w1RenderStoryCard();
      scheduleSaveLessonSession();
    });
    qs('#w1-story-next')?.addEventListener('click', () => {
      const paragraphs = state.lesson?.story?.paragraphs_en || [];
      const idx = state.storyGate.card_index || 0;
      if (idx < paragraphs.length - 1) {
        state.storyGate.card_index = idx + 1;
        w1RenderStoryCard();
      } else {
        w1MarkReadProgressFromCard();
      }
      scheduleSaveLessonSession();
    });
    qs('#w1-open-quests')?.addEventListener('click', () => {
      if (!w1GateComplete()) {
        showToast('Con đọc và nghe hết truyện đã nhé!');
        return;
      }
      w1EnterActivitiesPhase(Boolean(state.completedTypes.size));
    });
    qs('#w1-read-along')?.addEventListener('click', () => w1ToggleReadAlong());
  }

  async function w1PlaySentenceAt(index) {
    const sentences = state.lesson?.story?.sentences || [];
    const sentence = sentences[index];
    if (!sentence) return;
    const paragraphIndex = Number(sentence.paragraph_index) || 0;
    state.storyGate.card_index = paragraphIndex;
    w1RenderStoryCard();
    const cardText = qs('#w1-card-text');
    if (cardText && sentence.text_en) {
      const plain = cardText.textContent || '';
      const pos = plain.indexOf(sentence.text_en);
      if (pos >= 0) {
        const before = plain.slice(0, pos);
        const match = plain.slice(pos, pos + sentence.text_en.length);
        const after = plain.slice(pos + sentence.text_en.length);
        cardText.innerHTML = `${escapeHtml(before)}<span class="r2l-w1-karaoke">${escapeHtml(match)}</span>${escapeHtml(after)}`;
      }
    }
    const url = sentence.audio_url || '';
    if (url) {
      await new Promise((resolve) => {
        const audio = new Audio(url);
        audio.addEventListener('ended', resolve, { once: true });
        audio.addEventListener('error', resolve, { once: true });
        audio.play().catch(resolve);
      });
    }
    w1MarkParagraphPlayed(paragraphIndex);
  }

  async function w1RunReadAlong() {
    const sentences = state.lesson?.story?.sentences || [];
    if (!sentences.length) return;
    _w1ReadAlong.running = true;
    _w1ReadAlong.paused = false;
    for (let i = _w1ReadAlong.sentenceIdx; i < sentences.length; i += 1) {
      if (!_w1ReadAlong.running || _w1ReadAlong.paused) break;
      _w1ReadAlong.sentenceIdx = i;
      await w1PlaySentenceAt(i);
    }
    if (_w1ReadAlong.running && !_w1ReadAlong.paused) {
      state.storyGate.read_done = true;
      state.storyGate.listen_done = true;
      const paragraphs = state.lesson?.story?.paragraphs_en || [];
      state.storyGate.card_index = Math.max(0, paragraphs.length - 1);
      w1RenderStoryCard();
      w1UpdateGateChips();
      scheduleSaveLessonSession();
      _w1ReadAlong.running = false;
    }
  }

  function w1ToggleReadAlong() {
    const btn = qs('#w1-read-along');
    if (_w1ReadAlong.running && !_w1ReadAlong.paused) {
      _w1ReadAlong.paused = true;
      _w1ReadAlong.running = false;
      if (btn) btn.textContent = '▶ Đọc cùng Minny';
      return;
    }
    if (btn) btn.textContent = '⏸ Tạm dừng';
    w1RunReadAlong();
  }

  function w1EnterActivitiesPhase(resume) {
    state.w1Phase = 'activities';
    qs('#w1-story-phase')?.classList.add('hidden');
    qs('#w1-quest-path')?.classList.remove('hidden');
    qs('#global-cta')?.classList.remove('hidden');
    w1EnsureHudStoryButton();
    const startIndex = resume ? state.activityIndex : 0;
    showActivity(startIndex);
    w1RenderQuestPath();
  }

  function w1EnsureHudStoryButton() {
    if (qs('#w1-hud-story-btn')) return;
    const dockToggle = qs('#dock-toggle');
    if (!dockToggle) return;
    const btn = document.createElement('button');
    btn.id = 'w1-hud-story-btn';
    btn.type = 'button';
    btn.setAttribute('aria-label', 'Câu chuyện');
    btn.textContent = '📖';
    btn.addEventListener('click', () => {
      stopLessonAudio();
      w1OpenStoryPanel();
    });
    dockToggle.parentElement?.insertBefore(btn, dockToggle);
  }

  function w1RenderQuestPath() {
    const el = qs('[data-r2l-quest-path]');
    if (!el || !isW1()) return;
    const activities = state.lesson?.activities || [];
    el.innerHTML = activities.map((activity, index) => {
      const type = activity?.type;
      let nodeState = 'locked';
      if (type && state.completedTypes.has(type)) nodeState = 'done';
      else if (index === state.activityIndex) nodeState = 'current';
      else if (index <= state.w1MaxUnlocked) nodeState = 'current';
      const icon = nodeState === 'done' ? '✅' : nodeState === 'locked' ? '🔒' : (W1_QUEST_ICONS[type] || '▶');
      const label = ACTIVITY_LABELS[type] || `Phần ${index + 1}`;
      return `
        <li class="r2l-kid-quest-path__node r2l-kid-quest-path__node--${nodeState}" data-r2l-quest-index="${index}">
          <button type="button" class="r2l-kid-quest-path__btn" ${nodeState === 'locked' ? 'disabled' : ''} aria-label="${escapeHtml(label)}">
            <span class="r2l-kid-quest-path__icon">${icon}</span>
            <span class="r2l-kid-quest-path__label">${escapeHtml(label)}</span>
          </button>
        </li>
      `;
    }).join('');
    el.querySelectorAll('.r2l-kid-quest-path__btn:not([disabled])').forEach((btn) => {
      btn.addEventListener('click', () => {
        const li = btn.closest('[data-r2l-quest-index]');
        const index = Number(li?.getAttribute('data-r2l-quest-index'));
        if (!Number.isNaN(index)) showActivity(index);
      });
    });
  }

  function w1RecordQuestionOutcome(activityType, questionId, outcome, attempts) {
    if (!isW1()) return;
    if (!state.questionOutcomes[activityType]) state.questionOutcomes[activityType] = {};
    state.questionOutcomes[activityType][questionId] = { outcome, attempts };
    scheduleSaveLessonSession();
  }

  function w1BuildQuestionOutcomesForSubmit(activityType) {
    const bucket = state.questionOutcomes[activityType];
    if (!bucket) return undefined;
    return Object.entries(bucket).map(([id, entry]) => ({
      id,
      outcome: entry.outcome,
      attempts: entry.attempts,
    }));
  }

  function w1MaybeMidpointCelebration(completedIndex) {
    if (!isW1() || state.w1MidpointCelebrated) return;
    const activities = state.lesson?.activities || [];
    const backendFive = activities.filter((a) => a?.type !== 'retell_summary');
    if (backendFive.length < 5) return;
    const thirdType = backendFive[2]?.type;
    const completedType = activities[completedIndex]?.type;
    if (completedType !== thirdType) return;
    state.w1MidpointCelebrated = true;
    setMinnyStrip('celebrate', 'Nửa đường rồi! Con giỏi lắm 🎉');
    window.__r2lJuice?.fireStreakConfetti?.();
    scheduleSaveLessonSession();
  }

  function w1CollectRecapItems() {
    const items = [];
    Object.entries(state.questionOutcomes).forEach(([activityType, questions]) => {
      Object.entries(questions || {}).forEach(([id, entry]) => {
        if (entry.outcome === 'first_try') return;
        items.push({ activityType, id, outcome: entry.outcome });
      });
    });
    return items;
  }

  function w1FindRecapMeta(activityType, questionId) {
    const activity = (state.lesson?.activities || []).find((a) => a.type === activityType);
    if (!activity) return null;
    if (activity.questions) {
      const q = activity.questions.find((item) => String(item.id || '') === String(questionId));
      if (!q) return null;
      const correct = q.options_en?.[q.correct_index] || '';
      return { question: q.question_en || q.question_vi, correct, explanation: q.explanation_vi || '' };
    }
    if (activity.items) {
      const item = activity.items.find((row) => String(row.id || '') === String(questionId));
      if (!item) return null;
      return {
        question: item.sentence_with_blank || item.original_sentence || 'Câu hỏi',
        correct: item.options_en?.[item.correct_index] || item.original_sentence || '',
        explanation: item.explanation_vi || item.translation_vi || '',
      };
    }
    return null;
  }

  function w1ShowResultRecap() {
    const section = qs('#w1-result-recap');
    if (!section || !isW1()) return;
    const items = w1CollectRecapItems();
    const intro = qs('#w1-recap-intro');
    const cards = qs('#w1-recap-cards');
    const skip = qs('#w1-recap-skip');
    if (!items.length) {
      if (intro) intro.textContent = 'Hoàn hảo! Không có gì cần ôn 🌟';
      if (cards) cards.innerHTML = '';
      if (skip) skip.classList.add('hidden');
      section.classList.remove('hidden');
      return;
    }
    if (intro) intro.textContent = 'Những câu con cần ôn lại:';
    let idx = 0;
    function renderCard() {
      const item = items[idx];
      const meta = w1FindRecapMeta(item.activityType, item.id);
      if (!meta) {
        idx += 1;
        if (idx < items.length) renderCard();
        else section.classList.add('hidden');
        return;
      }
      cards.innerHTML = `
        <article class="rounded-md border border-cream/10 bg-navy-950/45 p-4">
          <p class="font-bold text-cream">${escapeHtml(meta.question)}</p>
          <p class="mt-2 text-sm text-gold">Đáp án: ${escapeHtml(meta.correct)}</p>
          ${meta.explanation ? `<p class="mt-2 text-sm text-cream/75">${escapeHtml(meta.explanation)}</p>` : ''}
          <button id="w1-recap-understood" class="r2l-primary mt-4 w-full" type="button">Đã hiểu ✓</button>
        </article>
      `;
      qs('#w1-recap-understood')?.addEventListener('click', () => {
        idx += 1;
        if (idx < items.length) renderCard();
        else section.classList.add('hidden');
      }, { once: true });
    }
    if (skip) {
      skip.classList.remove('hidden');
      skip.onclick = () => section.classList.add('hidden');
    }
    section.classList.remove('hidden');
    renderCard();
  }

  function renderLesson(lesson) {
    lesson = ensureLessonActivities(lesson);
    state.lesson = lesson;
    qs('#loading-card').classList.add('hidden');
    qs('#lesson-shell').classList.remove('hidden');
    const studentName = lesson.student_name || '';
    if (studentName) {
      const banner = qs('#identity-student-name');
      if (banner) banner.textContent = studentName;
    }

    initStoryDock(lesson.story || {});
    _r2lUpdateMicPrepBanner(lesson.activities || []);
    qs('#mic-prep-dismiss')?.addEventListener('click', () => {
      try {
        sessionStorage.setItem('r2l_mic_prep_dismissed', '1');
      } catch {}
      qs('#mic-prep-banner')?.classList.add('hidden');
    });
    document.addEventListener('r2l-mic-gate', (event) => {
      if (event.detail?.ready) _r2lUpdateMicPrepBanner(state.lesson?.activities || []);
    });
    const resumed = restoreLessonSession();
    renderAllActivitiesOnce(lesson.activities || []);
    if (isW1()) {
      if (!resumed || state.w1Phase === 'story') {
        state.w1Phase = w1GateComplete() ? 'activities' : 'story';
      }
      if (state.w1Phase === 'story') {
        w1InitStoryPhase();
      } else {
        w1EnterActivitiesPhase(resumed);
      }
    } else {
      showActivity(resumed ? state.activityIndex : 0);
    }
    updateProgress();
    saveLessonSession();
    if (resumed) {
      showToast('Con tiếp tục bài đang làm — không cần làm lại từ đầu nhé!', 5000);
    }
    if (loadPendingSubmit()) {
      qs('#submit-hint').textContent = 'Lần trước chưa gửi được kết quả. Con bấm Gửi lại nhé!';
      qs('#submit-retry')?.classList.remove('hidden');
    }
  }

  function renderAllActivitiesOnce(activities) {
    activities.forEach((activity) => {
      const shell = activityShellForType(activity.type);
      if (!shell) return;
      shell.querySelector('[data-activity-title]').textContent = activity.title_vi || activityLabelText(activity.type) || '';
      shell.querySelector('[data-activity-identity]').textContent = activity.identity_vi || '';
      shell.querySelector('[data-activity-instructions]').textContent = activity.instructions_vi || '';
      const body = shell.querySelector('[data-activity-body]');
      if (isV21Lesson()) {
        if (activity.type === 'story_discovery') renderStoryDiscoveryActivity(body, activity);
        else if (activity.type === 'vocab_blitz') renderVocabBlitzActivity(body, activity);
        else if (activity.type === 'sentence_builder') renderOrderActivity(body, activity);
        else if (activity.type === 'story_detective') renderStoryDetectiveActivity(body, activity);
        else if (activity.type === 'listen_and_fill') renderFillBlankActivity(body, activity);
        else if (activity.type === 'echo_challenge') renderEchoChallengeActivity(body, activity);
        else if (activity.type === 'speed_round') renderSpeedRoundActivity(body, activity);
        return;
      }
      if (activity.type === 'listening_fill_blank') {
        renderFillBlankActivity(body, activity);
      } else if (activity.type === 'reading_comprehension') {
        renderMcqActivity(body, activity);
      } else if (activity.type === 'listen_and_order') {
        renderOrderActivity(body, activity);
      } else if (activity.type === 'written_response') {
        renderWrittenActivity(body, activity);
      } else if (activity.type === 'listen_and_speak') {
        renderSpeakActivity(body, activity);
      } else if (activity.type === 'retell_summary') {
        renderRetellSummaryActivity(body, activity);
      }
    });
  }

  function initStoryDock(story) {
    const title = story?.title || 'Câu chuyện của con';
    qs('#dock-title').textContent = title;
    const firstParagraph = (story.paragraphs_en || [])[0] || '';
    qs('#dock-preview').textContent =
      firstParagraph.slice(0, 120) + (firstParagraph.length > 120 ? '…' : '');

    qs('#dock-paragraphs').innerHTML = (story.paragraphs_en || [])
      .map((p, i) => `<p data-paragraph-index="${i}">${escapeHtml(p)}</p>`)
      .join('');

    renderSentences(story.sentences || [], '#dock-sentences');

    qs('#dock-toggle')?.addEventListener('click', toggleDock);
    const playButton = qs('#dock-play-story');
    playButton?.addEventListener('click', () => {
      playAudio(state.lesson?.story?.full_audio_url || story.full_audio_url || '', playButton);
    });
    setStoryAudioButtonState(playButton, story.full_audio_url || '');
    if (!story.full_audio_url) {
      pollDeferredFullStoryAudio(playButton);
    }
  }

  function toggleDock() {
    const dock = qs('#story-dock');
    const expanded = qs('#dock-expanded');
    const toggle = qs('#dock-toggle');
    if (!dock || !expanded || !toggle) return;
    if (dock.dataset.dockState === 'collapsed') {
      dock.dataset.dockState = 'expanded';
      expanded.classList.remove('hidden');
      toggle.textContent = 'Thu gọn ▲';
    } else {
      dock.dataset.dockState = 'collapsed';
      expanded.classList.add('hidden');
      toggle.textContent = 'Mở truyện ▼';
    }
  }

  function highlightDockSentence(sentenceText) {
    qsa('#dock-paragraphs [data-highlight]').forEach((el) => el.removeAttribute('data-highlight'));
    if (!sentenceText) return;
    qsa('#dock-paragraphs p').forEach((p) => {
      const idx = p.textContent.indexOf(sentenceText);
      if (idx >= 0) {
        const before = p.textContent.slice(0, idx);
        const match = p.textContent.slice(idx, idx + sentenceText.length);
        const after = p.textContent.slice(idx + sentenceText.length);
        p.innerHTML = `${escapeHtml(before)}<mark data-highlight="true">${escapeHtml(match)}</mark>${escapeHtml(after)}`;
      }
    });
  }

  function renderSentences(sentences, containerSelector = '#dock-sentences') {
    const container = qs(containerSelector);
    if (!container) return;
    container.innerHTML = sentences
      .map(
        (sentence, index) => `
          <button class="r2l-sentence block w-full" type="button" data-sentence-index="${index}">
            <span class="block text-sm font-bold text-gold">Câu ${index + 1}</span>
            <span>${escapeHtml(sentence.text_en)}</span>
          </button>
        `,
      )
      .join('');

    container.querySelectorAll('[data-sentence-index]').forEach((button) => {
      const sentence = sentences[Number(button.dataset.sentenceIndex)];
      const url = sentence?.audio_url || '';
      setLessonPlayButtonState(button, url);
      button.addEventListener('click', () => {
        highlightDockSentence(sentence?.text_en || '');
        playAudio(url, button);
      });
    });
  }

  function showActivity(index) {
    const activities = state.lesson.activities || [];
    const maxIndex = Math.max(0, activities.length - 1);
    const nextIndex = Math.max(0, Math.min(index, maxIndex));
    if (isW1() && state.w1Phase === 'story') return;
    if (isW1() && nextIndex > state.w1MaxUnlocked && !state.completedTypes.has(activities[nextIndex]?.type)) {
      showToast('Xong nhiệm vụ này trước đã nha!');
      return;
    }
    if (nextIndex !== state.activityIndex) stopLessonAudio();
    state.activityIndex = nextIndex;
    qsa('[data-activity-shell]').forEach((shell) => {
      shell.hidden = true;
    });
    const activity = activities[state.activityIndex];
    if (!activity) return;

    const shell = activityShellForType(activity.type);
    if (!shell) return;
    shell.hidden = false;

    const autoExpandTypes = ['written_response', 'retell_summary'];
    const dock = qs('#story-dock');
    if (autoExpandTypes.includes(activity.type) && dock?.dataset.dockState === 'collapsed') {
      toggleDock();
    }

    qsa('[data-step-button]').forEach((button, buttonIndex) => {
      button.dataset.active = String(buttonIndex === state.activityIndex);
      const type = activities[buttonIndex]?.type;
      button.dataset.done = String(type && state.completedTypes.has(type));
      button.onclick = () => {
        if (buttonIndex === state.activityIndex) return;
        if (isW1()) {
          if (buttonIndex <= state.w1MaxUnlocked || (type && state.completedTypes.has(type))) {
            finalizeCurrentActivityIfReady();
            showActivity(buttonIndex);
          } else {
            showToast('Xong nhiệm vụ này trước đã nha!');
          }
          return;
        }
        if (type && state.completedTypes.has(type)) {
          finalizeCurrentActivityIfReady();
          showActivity(buttonIndex);
        }
      };
    });

    if (isW1()) w1RenderQuestPath();

    setMinnyStrip('idle', MINNY_COMMANDS[activity.type] || '');
    _itemStreak = 0;

    const useLargeMinny = ['listen_and_speak', 'retell_summary'].includes(activity.type)
      || activity.type === 'echo_challenge';
    const minnyStrip = qs('#minny-strip');
    if (minnyStrip) minnyStrip.hidden = useLargeMinny;
    const heroWrap = shell.querySelector('.r2l-minny-hero-wrap');
    if (heroWrap) heroWrap.hidden = !useLargeMinny;

    updateParentStrip();
    updateProgress();
    updateGlobalCta();
    scheduleSaveLessonSession();

    if (['listen_and_speak', 'retell_summary'].includes(activity.type) || activity.type === 'echo_challenge') {
      _r2lMountMicCheck(shell);
      if (window.R2LMicCheck?.sessionPassed?.()) {
        _r2lApplyMicGate(true);
      } else {
        _r2lApplyMicGate(false);
        const panel = shell.querySelector('[data-r2l-mic-check]');
        if (panel && window.R2LMicCheck?.scrollToPanel) {
          window.setTimeout(() => window.R2LMicCheck.scrollToPanel(panel), 300);
        }
      }
    }
  }

  function activityIndexByType(type) {
    return (state.lesson?.activities || []).findIndex((activity) => activity?.type === type);
  }

  function updateGlobalCta() {
    const btn = qs('#lesson-continue');
    if (!btn) return;
    const activities = state.lesson?.activities || [];
    const current = activities[state.activityIndex];
    const currentType = current?.type;
    const isCurrentDone = currentType && state.completedTypes.has(currentType);
    const isLast = state.activityIndex >= activities.length - 1;
    const allDone = state.completedTypes.size >= activities.length;

    if (allDone) {
      btn.textContent = 'Hoàn thành nhiệm vụ 🎉';
      btn.disabled = false;
    } else if (isCurrentDone && !isLast) {
      const nextActivity = activities[state.activityIndex + 1];
      const nextLabel = activityLabelText(nextActivity?.type) || 'bài tiếp';
      btn.textContent = `Phần tiếp: ${nextLabel} →`;
      btn.disabled = false;
    } else {
      btn.textContent = 'Tiếp tục →';
      btn.disabled = !isCurrentDone;
    }
  }

  function w1WordCount(text) {
    return (text || '').trim().split(/\s+/).filter(Boolean).length;
  }

  function w1WrittenModelAnswer(question) {
    const rcActivity = (state.lesson?.activities || []).find((a) => a.type === 'reading_comprehension');
    return window.__r2lWritten?.writtenModelAnswer?.(question, rcActivity?.questions || []) || '';
  }

  function finalizeCurrentActivityIfReady() {
    const activity = state.lesson?.activities?.[state.activityIndex];
    if (!activity || activity.type !== 'written_response' || state.completedTypes.has(activity.type)) return;
    const answers = collectWrittenAnswers(activity);
    const minWords = isW1() ? 3 : 2;
    const answeredCount = Object.values(answers).filter((value) => w1WordCount(value) >= minWords).length;
    if (answeredCount === (activity.questions || []).length) {
      completeActivity(activity.type, {
        correct_count: answeredCount,
        total_count: activity.questions.length,
        written_answers: answers,
      });
    }
  }

  function writtenDraftKey(activity, question, questionIndex) {
    return `${activity.type}:${question.id || questionIndex}`;
  }

  function collectWrittenAnswers(activity) {
    const answers = {};
    (activity.questions || []).forEach((question, questionIndex) => {
      const key = writtenDraftKey(activity, question, questionIndex);
      answers[questionIndex] = state.writtenDrafts[key] || '';
    });
    return answers;
  }

  function w1AppendStoryReviewLink(container) {
    if (!container || container.querySelector('[data-w1-story-link]')) return;
    const link = document.createElement('button');
    link.type = 'button';
    link.className = 'mt-2 text-sm font-bold text-accent underline';
    link.dataset.w1StoryLink = '1';
    link.textContent = '📖 Xem lại truyện';
    link.addEventListener('click', () => w1OpenStoryPanel());
    container.appendChild(link);
  }

  function w1McqWrongFeedback(root, itemIndex, selectorPrefix, isFirstWrong) {
    setMinnyStrip('encourage', 'Chưa đúng — con đọc lại truyện thử nhé!');
    const expl = root.querySelector(`[${selectorPrefix}="${itemIndex}"]`);
    if (isFirstWrong) w1AppendStoryReviewLink(expl);
    else if (expl) expl.classList.remove('hidden');
  }

  function renderStoryDiscoveryActivity(root, activity) {
    const items = activity.items || [];
    let itemIndex = 0;
    const results = { correct: 0, total: items.length };

    function renderItem() {
      const item = items[itemIndex];
      if (!item) return;
      const progress = root.closest('[data-activity-shell]')?.querySelector('[data-story-discovery-progress]');
      if (progress) progress.textContent = `Câu ${itemIndex + 1} / ${items.length}`;
      const mc = item.micro_check || {};
      const showVi = true;
      root.innerHTML = `
        <article class="mt-5 rounded-md border border-cream/10 bg-navy-950/45 p-4" data-sd-card="${itemIndex}">
          <p class="text-lg font-bold text-cream">${escapeHtml(item.text_en || '')}</p>
          ${showVi ? `<p class="mt-1 text-sm text-cream/65">${escapeHtml(item.text_vi || '')}</p>` : ''}
          <button class="r2l-primary mt-3" type="button" data-sd-play="${itemIndex}">▶ Nghe câu</button>
          <div class="mt-4 hidden" data-sd-check="${itemIndex}">
            <p class="font-semibold text-gold">${escapeHtml(mc.prompt_vi || 'Chọn đáp án đúng')}</p>
            <div class="mt-2 grid gap-2" data-sd-options="${itemIndex}"></div>
          </div>
        </article>
      `;
      const optionsWrap = root.querySelector(`[data-sd-options="${itemIndex}"]`);
      const options = mc.options || [];
      options.forEach((opt, optIndex) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'r2l-option min-h-[44px]';
        btn.textContent = String(opt);
        btn.addEventListener('click', () => handleAnswer(optIndex === mc.correct_index, btn, optIndex === mc.correct_index ? null : mc.correct_index));
        optionsWrap?.appendChild(btn);
      });
      const playBtn = root.querySelector(`[data-sd-play="${itemIndex}"]`);
      playBtn?.addEventListener('click', async () => {
        const url = item.audio_url || '';
        try {
          if (window.__r2lV21Audio?.playUrl) await window.__r2lV21Audio.playUrl(url);
          else await _r2lAwaitStoryAudio(url);
        } catch {
          showToast('Chưa nghe được — con thử lại nhé!');
        }
        root.querySelector(`[data-sd-check="${itemIndex}"]`)?.classList.remove('hidden');
      });
      if (itemIndex === 0) playBtn?.click();
    }

    function handleAnswer(isCorrect, btn, revealIndex) {
      qsa(`[data-sd-options="${itemIndex}"] .r2l-option`).forEach((b) => { b.disabled = true; });
      if (isCorrect) {
        btn.dataset.state = 'correct';
        results.correct += 1;
        _r2lRecordAnswer(true);
        onItemCorrect();
      } else {
        btn.dataset.state = 'wrong';
        _r2lRecordAnswer(false);
        onItemWrong(`${activity.type}:${itemIndex}`);
        if (revealIndex != null) {
          const correctBtn = root.querySelectorAll(`[data-sd-options="${itemIndex}"] .r2l-option`)[revealIndex];
          if (correctBtn) correctBtn.dataset.state = 'revealed';
        }
      }
      window.setTimeout(() => {
        itemIndex += 1;
        if (itemIndex >= items.length) {
          _r2lSetPhaseStars(activity.type, results.correct, results.total);
          _r2lEndPhase(activity.type, results);
          completeActivity(activity.type, { correct_count: results.correct, total_count: results.total });
        } else {
          renderItem();
        }
      }, isCorrect ? 400 : 1500);
    }

    renderItem();
  }

  function renderVocabBlitzActivity(root, activity) {
    const items = activity.items || [];
    let cardIndex = 0;
    const results = { correct: 0, total: items.length };

    function renderCard() {
      const item = items[cardIndex];
      if (!item) return;
      const options = item.options_vi || item.options_en || item.options || [];
      root.innerHTML = `
        <article class="r2l-vocab-card-flip mt-5 rounded-md border border-cream/10 bg-navy-950/45 p-4" data-vb-card="${cardIndex}">
          <div class="flex items-center justify-between gap-3">
            <p class="font-display text-2xl font-bold text-cream">${escapeHtml(item.word_en || item.word_vi || '')}</p>
            <div class="r2l-vocab-timer-ring" aria-hidden="true"></div>
          </div>
          ${item.word_vi && item.word_en ? `<p class="mt-1 text-sm text-cream/65">${escapeHtml(item.word_vi)}</p>` : ''}
          <button class="r2l-secondary mt-3" type="button" data-vb-play="${cardIndex}">🔊 Nghe từ</button>
          <div class="mt-4 grid gap-2">
            ${options.map((opt, i) => `<button class="r2l-option min-h-[44px]" type="button" data-vb-opt="${i}">${escapeHtml(String(opt))}</button>`).join('')}
          </div>
          <p class="mt-2 hidden text-sm text-gold" data-vb-speed>⚡ Nhanh quá!</p>
        </article>
      `;
      const startedAt = Date.now();
      root.querySelector(`[data-vb-play="${cardIndex}"]`)?.addEventListener('click', () => {
        const url = item.audio_url || '';
        if (window.__r2lV21Audio?.playUrl) window.__r2lV21Audio.playUrl(url);
        else playAudio(url);
      });
      root.querySelectorAll('[data-vb-opt]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const optIndex = Number(btn.dataset.vbOpt);
          const isCorrect = optIndex === item.correct_index;
          const fast = Date.now() - startedAt < 3000;
          root.querySelectorAll('[data-vb-opt]').forEach((b) => { b.disabled = true; });
          if (isCorrect) {
            btn.dataset.state = 'correct';
            results.correct += 1;
            if (fast) root.querySelector('[data-vb-speed]')?.classList.remove('hidden');
            _r2lRecordAnswer(true, Date.now() - startedAt);
            onItemCorrect();
          } else {
            btn.dataset.state = 'wrong';
            const correctBtn = root.querySelector(`[data-vb-opt="${item.correct_index}"]`);
            if (correctBtn) correctBtn.dataset.state = 'revealed';
            _r2lRecordAnswer(false);
            onItemWrong(`${activity.type}:${cardIndex}`);
          }
          const card = root.querySelector(`[data-vb-card="${cardIndex}"]`);
          if (card) card.dataset.flip = 'out';
          window.setTimeout(() => {
            cardIndex += 1;
            if (cardIndex >= items.length) {
              _r2lSetPhaseStars(activity.type, results.correct, results.total);
              _r2lEndPhase(activity.type, results);
              completeActivity(activity.type, { correct_count: results.correct, total_count: results.total });
            } else {
              renderCard();
            }
          }, isCorrect ? 500 : 1500);
        });
      });
    }
    renderCard();
  }

