  function _r2lMountMicCheck(shell, attempt = 0) {
    if (!shell) return;
    const panel = shell.querySelector('[data-r2l-mic-check]');
    if (!panel || panel.dataset.r2lMicMounted === 'true') return;
    if (!window.R2LMicCheck?.mount) {
      if (attempt < 40) window.setTimeout(() => _r2lMountMicCheck(shell, attempt + 1), 50);
      return;
    }
    window.R2LMicCheck.mount(panel, {
      blockUntilPass: true,
      onPass: () => _r2lApplyMicGate(true),
      onFail: () => _r2lApplyMicGate(false),
