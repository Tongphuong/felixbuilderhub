  function _r2lResolveSpeakUploadStuck(itemKey, cardEl, telemetry, message) {
    const entry = _r2lRecorderState.perItem.get(itemKey);
    if (!entry || entry.checkStatus !== 'uploading') return;
    const activity = activityItemsFromCard(cardEl);
    _r2lRecorderState.perItem.set(itemKey, {
      ...entry,
      failureCount: Number(entry.failureCount || 0) + 1,
      checkStatus: 'error',
      checkResult: { ok: false, message, upload_stuck: true },
    });
    _r2lRenderRecorderUi(itemKey, cardEl);
    _r2lRenderSpeakFeedback(cardEl, { ok: false, message });
    _r2lMaybeOfferSpeakSkip();
