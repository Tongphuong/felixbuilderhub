---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ActivityProgress from '../../components/read2lead/v2/ActivityProgress.astro';
import IdentityBanner from '../../components/read2lead/v2/IdentityBanner.astro';
import ListeningFillBlank from '../../components/read2lead/v2/ListeningFillBlank.astro';
import ListenAndOrder from '../../components/read2lead/v2/ListenAndOrder.astro';
import ListenAndSpeak from '../../components/read2lead/v2/ListenAndSpeak.astro';
import ReadAloud from '../../components/read2lead/v2/ReadAloud.astro';
import MicCheckPanel from '../../components/read2lead/v2/MicCheckPanel.astro';
import LevelUpModal from '../../components/read2lead/v2/LevelUpModal.astro';
import RankUpModal from '../../components/read2lead/v3/rank/RankUpModal.astro';
import ProgressBar from '../../components/read2lead/v2/ProgressBar.astro';
import StoryDock from '../../components/read2lead/v2/StoryDock.astro';
import MinnyCoachStrip from '../../components/read2lead/v2/MinnyCoachStrip.astro';
import ParentStrip from '../../components/read2lead/v2/ParentStrip.astro';
import ReadingComprehension from '../../components/read2lead/v2/ReadingComprehension.astro';
import RewardBurst from '../../components/read2lead/v2/RewardBurst.astro';
import V21MaintenanceScreen from '../../components/read2lead/v2/V21MaintenanceScreen.astro';
import GuidedListener from '../../components/read2lead/guided-listener.astro';
import dictationHelperSrc from '../../lib/read2lead-dictation.ts?raw';
import bookFlowHelperSrc from '../../lib/read2lead-book-flow.mjs?raw';
import { r2lRecorderScriptSrc } from '../../scripts/r2l-recorder-script.mjs';
import { stripInlineExports } from '../../lib/inline-esm.mjs';
import '../../styles/r2l-w2-dynamic.css';

const r2lRecorderSrc = r2lRecorderScriptSrc();
// These helper modules are authored as real ESM but inlined into classic
// <script is:inline> blocks below, so every top-level `export` must be stripped
// (not just `export function`) or the browser throws "Unexpected token 'export'"
// and the whole block dies. See src/lib/inline-esm.mjs.
const dictationHelperInline = stripInlineExports(dictationHelperSrc);
const bookFlowHelperInline = stripInlineExports(bookFlowHelperSrc);
---

<BaseLayout
  title="Bài học Read2Lead — Luyện đọc tiếng Anh | Felix Coaching"
  description="Bài học Read2Lead: nghe truyện, xếp câu, nói lại và đọc hiểu theo nhịp nhẹ nhàng."
  robots="noindex, follow"
>
  <Header read2LeadState={true} />
  <main id="main" class="min-h-screen bg-navy-950" data-r2l-w1-ssr={import.meta.env.PUBLIC_R2L_W1 === '1' ? '1' : '0'} data-r2l-v21-ssr={import.meta.env.PUBLIC_R2L_V21 === '1' ? '1' : '0'}>
    <IdentityBanner />
    <ProgressBar />

    <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
      <div id="loading-card" class="rounded-md border border-cream/10 bg-cream/5 p-6 text-cream">
        <p id="loading-message">Minny đang mở nhiệm vụ cho con...</p>
      </div>

      <div id="error-card" class="hidden rounded-md border border-gold/30 bg-gold/10 p-6 text-cream">
        <p class="font-semibold text-gold">Chưa mở được bài học</p>
        <p id="error-message" class="mt-2 text-sm text-cream/80"></p>
        <button id="error-retry" class="r2l-primary mt-4" type="button">Thử lại</button>
      </div>

      <div id="v21-maintenance" hidden>
        <V21MaintenanceScreen />
      </div>

      <article id="lesson-shell" class="hidden space-y-6">
        <section id="w1-story-phase" class="hidden space-y-4 rounded-md border border-cream/10 bg-cream/[0.04] p-4">
          <h2 class="font-display text-2xl font-bold text-cream">Khám phá truyện</h2>
          <div id="w1-gate-chips" class="flex flex-wrap gap-2">
            <span id="w1-chip-read" class="r2l-w1-chip" data-done="false">📖 Đọc</span>
            <span id="w1-chip-listen" class="r2l-w1-chip" data-done="false">🎧 Nghe</span>
          </div>
          <p id="w1-gate-hint" class="text-sm leading-relaxed text-cream/70">
            Con đọc hết truyện và nghe Minny đọc xong, rồi mới mở nhiệm vụ nhé!
          </p>
          <div id="w1-story-cards" class="space-y-3"></div>
          <div class="flex flex-wrap gap-2">
            <button id="w1-read-along" class="r2l-primary" type="button">▶ Đọc cùng Minny</button>
            <button id="w1-story-prev" class="r2l-secondary hidden" type="button">← Trước</button>
            <button id="w1-story-next" class="r2l-primary" type="button">Tiếp →</button>
          </div>
          <button id="w1-open-quests" class="r2l-primary w-full text-lg" type="button" disabled>Mở nhiệm vụ 🎯</button>
        </section>

        <section id="w1-book-reader-phase" class="r2l-book-reader hidden" aria-labelledby="book-reader-title" data-book-stage="story">
          <header id="book-reader-trail-header" class="r2l-book-trail-header">
            <div class="r2l-book-trail-header__copy">
              <p class="r2l-book-eyebrow">Hành trình</p>
              <div class="r2l-book-trail-header__title-row">
                <div>
                  <h2 id="book-reader-title" class="r2l-book-trail-header__title">Đọc truyện tranh</h2>
                  <p id="book-reader-trail-meta" class="r2l-book-trail-header__meta"></p>
                </div>
                <p id="book-reader-page-counter" class="r2l-book-page-count" aria-live="polite"></p>
              </div>
            </div>
            <div id="book-reader-progress-bar" class="r2l-book-trail-bar" aria-hidden="true">
              <div id="book-reader-progress-fill" class="r2l-book-trail-bar__fill"></div>
            </div>
            <ol id="book-reader-trail" class="r2l-book-trail" aria-label="Tiến trình truyện"></ol>
          </header>

          <div id="book-reader-workspace" class="r2l-book-workspace">
            <div id="book-reader-page-shell" class="r2l-book-page-shell">
              <figure class="r2l-book-page">
                <div class="r2l-book-page__art">
                  <img id="book-reader-img" src="" alt="" />
                  <span id="book-reader-page-badge" class="r2l-book-page__badge">Trang 1</span>
                  <span id="book-reader-art-credit" class="r2l-book-page__credit">Minh hoạ truyện</span>
                  <button id="book-reader-art-prev" class="r2l-book-page__nav r2l-book-page__nav--prev" type="button" aria-label="Xem lại trang trước">←</button>
                  <button id="book-reader-art-next" class="r2l-book-page__nav r2l-book-page__nav--next" type="button" aria-label="Sang trang tiếp">→</button>
                </div>
                <figcaption class="r2l-book-karaoke">
                  <p class="r2l-book-eyebrow">Câu đang nghe</p>
                  <p id="book-reader-karaoke-text" class="r2l-book-karaoke__text">Bấm nghe để Minny bắt đầu đọc.</p>
                </figcaption>
              </figure>
            </div>

            <div class="r2l-book-panel">
              <nav id="book-reader-stage-stepper" class="r2l-book-stepper" aria-label="Ba bước của trang">
                <span class="r2l-book-stepper__step" data-book-step="story"><b>1</b><span>Nghe</span></span>
                <span class="r2l-book-stepper__arrow" aria-hidden="true">›</span>
                <span class="r2l-book-stepper__step" data-book-step="questions"><b>2</b><span>Câu hỏi</span></span>
                <span class="r2l-book-stepper__arrow" aria-hidden="true">›</span>
                <span class="r2l-book-stepper__step" data-book-step="shadow"><b>3</b><span>Đọc trang</span></span>
              </nav>

              <article class="r2l-book-story-card">
                <div class="r2l-book-story-card__heading">
                  <p class="r2l-book-eyebrow">Đoạn truyện</p>
                  <span>EN · Mới bắt đầu</span>
                </div>
                <div id="book-reader-page-text" class="r2l-book-page__text"></div>
                <div class="r2l-book-helpers" aria-label="Trợ giúp đọc truyện">
                  <button id="book-reader-listen-again" class="r2l-book-helper" type="button">🔊 Nghe lại</button>
                  <button id="book-reader-vocab" class="r2l-book-helper" type="button" aria-expanded="false">⌕ Từ khó</button>
                  <button id="book-reader-translate" class="r2l-book-helper" type="button" aria-expanded="false">▣ Dịch từng câu</button>
                </div>
                <div id="book-reader-translation-panel" class="r2l-book-helper-panel hidden" aria-live="polite"></div>
                <div id="book-reader-vocab-panel" class="r2l-book-helper-panel hidden" aria-live="polite"></div>
              </article>

              <div id="book-reader-stage-stack" class="r2l-book-stage-stack">
                <section id="book-reader-audio-gate" class="r2l-book-gate" data-book-stage-container="story" data-audio-state="idle" aria-labelledby="book-reader-audio-title">
                  <div class="r2l-book-audio__copy">
                    <p class="r2l-book-eyebrow">Trạng thái · Nghe</p>
                    <h3 id="book-reader-audio-title">Bấm để Minny đọc trang này</h3>
                    <p id="book-reader-audio-status" role="status" aria-live="polite">Nghe xong, con trả lời câu hỏi rồi đọc lại trang này nhé.</p>
                  </div>
                  <button id="book-reader-listen-btn" class="r2l-book-audio__button" type="button" aria-label="Nghe Minny đọc trang" aria-pressed="false">
                    <span class="r2l-book-audio__play" aria-hidden="true">▶</span>
                    <span class="r2l-book-audio__pause" aria-hidden="true">Ⅱ</span>
                    <span class="r2l-book-audio__check" aria-hidden="true">✓</span>
                    <span class="r2l-book-audio__wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                    <span class="r2l-book-audio__mobile-label">Nghe trang</span>
                  </button>
                  <div class="r2l-book-audio__timeline" aria-hidden="true">
                    <span id="book-reader-audio-current">0:00</span>
                    <div class="r2l-book-audio__track"><span id="book-reader-audio-progress"></span></div>
                    <span id="book-reader-audio-duration">0:00</span>
                  </div>
                  <p id="book-reader-audio-excerpt" class="r2l-book-audio__excerpt"></p>
                  <button id="book-reader-story-next" class="r2l-book-next-cta hidden" type="button" disabled>Trang tiếp →</button>
                </section>

                <section id="book-reader-question-stage" class="r2l-book-question-stage hidden" data-book-stage-container="questions" aria-live="polite">
                  <article class="r2l-book-question-card">
                    <p id="book-reader-question-counter" class="r2l-book-eyebrow"></p>
                    <h3 id="book-reader-question-text"></h3>
                    <div id="book-reader-question-options" class="r2l-book-question-options"></div>
                    <div id="book-reader-question-feedback" class="r2l-book-question-feedback hidden" role="status">
                      <img id="book-reader-question-minny" src="/assets/r2l/minny/smile.png" alt="Minny" />
                      <div>
                        <p id="book-reader-question-feedback-title" class="r2l-book-question-feedback__title"></p>
                        <p id="book-reader-question-feedback-copy"></p>
                      </div>
                    </div>
                    <div id="book-reader-question-rewards" class="r2l-book-question-rewards hidden" aria-hidden="true">
                      <span>+10 XP</span><span>★ Combo x2</span>
                    </div>
                    <aside id="book-reader-question-hint" class="r2l-book-question-hint hidden">
                      <strong>Gợi ý của Minny</strong>
                      <p id="book-reader-question-hint-copy"></p>
                    </aside>
                    <button id="book-reader-question-retry" class="r2l-book-retry hidden" type="button">↶ Chọn lại</button>
                  </article>
                </section>

                <section id="book-reader-shadow-stage" class="r2l-book-shadow-stage hidden" data-book-stage-container="shadow" aria-live="polite">
                  <div class="r2l-book-shadow-stage__heading">
                    <div>
                      <p class="r2l-book-eyebrow">Trạng thái · Đọc trang</p>
                      <h3>Minny đang nghe con đọc…</h3>
                    </div>
                    <p id="book-reader-shadow-counter"></p>
                  </div>
                  <p class="r2l-book-shadow-stage__lead">Con đọc to trang này cho Minny nghe nhé.</p>
                  <MicCheckPanel />
                  <div id="book-reader-shadow-body" data-activity-body></div>
                  <aside id="book-reader-parent-help" class="r2l-book-parent-help hidden">
                    <p><strong>Ba mẹ giúp con kiểm tra micro hoặc mạng nhé.</strong></p>
                    <p>Mở quyền micro cho Chrome/Safari, tắt Zoom hoặc Zalo đang giữ micro, rồi thử lại.</p>
                    <button id="book-reader-technical-skip" class="r2l-secondary" type="button">Bỏ qua phần đọc này và hoàn thành không thưởng</button>
                  </aside>
                </section>

                <section id="book-reader-next-stage" class="r2l-book-reward hidden" data-book-stage-container="next" aria-live="polite">
                  <div class="r2l-book-reward__sparkles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
                  <span class="r2l-book-reward__star" aria-hidden="true"><i></i><i></i><b></b></span>
                  <p class="r2l-book-eyebrow">Trang hoàn thành</p>
                  <h3>Con được 1 ngôi sao!</h3>
                  <p>Minny: “Con bỏ túi một sao! Sang trang tiếp theo nhé.”</p>
                  <div class="r2l-book-reward__pills"><span>+25 XP</span><span>+5 xu</span></div>
                  <button id="book-reader-next" class="r2l-book-next-cta" type="button" disabled>Trang tiếp →</button>
                </section>
              </div>

              <div class="r2l-book-shortcuts" aria-label="Phím tắt">
                <span><kbd>Space</kbd> phát/dừng</span><span><kbd>R</kbd> nghe lại</span><span><kbd>1–4</kbd> chọn</span><span><kbd>Enter</kbd> tiếp</span><span><kbd>M</kbd> thu âm</span>
              </div>
            </div>
          </div>

          <section id="book-reader-summary" class="hidden rounded-md border border-gold/30 bg-gold/10 p-5" aria-live="polite">
            <h3 class="font-display text-xl font-bold text-gold">Tóm tắt cho ba mẹ</h3>
            <div id="book-reader-summary-content" class="mt-3 grid gap-2 text-sm text-cream/85 sm:grid-cols-2"></div>
            <p id="book-reader-save-status" class="mt-3 font-semibold text-cream"></p>
            <button id="book-reader-submit-retry" class="r2l-secondary mt-3 hidden w-full" type="button">Gửi lại kết quả</button>
          </section>
          <details class="r2l-book-attribution">
            <summary>Thông tin tác giả và bản quyền</summary>
            <div id="book-reader-attribution-content" class="mt-3 space-y-2 text-sm text-cream/75"></div>
          </details>
        </section>


        <section id="w1-guided-listening-phase" class="hidden space-y-4 rounded-md border border-cream/10 bg-cream/[0.04] p-4">
          <h2 class="font-display text-2xl font-bold text-cream">Nghe và trả lời</h2>
          <GuidedListener paragraphs={[]} />
        </section>

        <ParentStrip />
        <div
          id="mic-prep-banner"
          class="hidden rounded-md border border-gold/35 bg-gold/10 px-4 py-3 text-sm leading-relaxed text-cream"
          role="status"
        >
          <p class="font-bold text-gold">Bài này có phần nói — cần micro</p>
          <p class="mt-1 text-cream/85">
            Ba mẹ: cho Chrome hoặc Safari được dùng micro (Windows/Mac → Cài đặt → Quyền riêng tư → Microphone).
            Không mở trong Zalo/Facebook.
          </p>
          <button id="mic-prep-dismiss" type="button" class="r2l-secondary mt-3 text-xs">Đã hiểu</button>
        </div>
        <StoryDock />
        <MinnyCoachStrip />

        <section id="lesson-activity-progress-panel" class="rounded-md border border-cream/10 bg-cream/[0.04] p-4">
          <ol id="w1-quest-path" class="r2l-kid-quest-path hidden" data-r2l-quest-path aria-label="Nhiệm vụ"></ol>
          <div id="w1-legacy-progress">
            <ActivityProgress />
          </div>
        </section>

        <section class="space-y-4">
          <ListeningFillBlank />
          <ListenAndOrder />
          <ReadingComprehension />
          <ListenAndSpeak />
          <ReadAloud />
        </section>

        <section id="global-cta" class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 flex flex-col gap-2">
          <button id="lesson-continue" class="r2l-primary w-full text-lg" type="button" disabled>
            Tiếp tục →
          </button>
        </section>

        <section
          id="trivia-reveal-section"
          class="r2l-trivia-reveal hidden rounded-md border border-accent/30 bg-accent/[0.08] p-5"
          data-show="false"
        >
          <div class="flex flex-wrap items-start gap-3">
            <span class="text-3xl" aria-hidden="true">✨</span>
            <div>
              <p class="text-sm font-semibold uppercase tracking-wide text-accent">Bí mật sau truyện</p>
              <h3 class="mt-1 font-display text-xl font-bold text-cream">Minny mở khóa một điều thú vị!</h3>
            </div>
          </div>
          <p id="trivia-reveal-text" class="mt-4 text-base leading-7 text-cream"></p>
          <p id="trivia-reveal-text-en" class="mt-2 hidden text-sm leading-6 text-cream/65"></p>
          <button id="trivia-reveal-continue" class="r2l-primary mt-5" type="button">Tiếp tục</button>
        </section>

        <section id="lesson-submit-panel" class="flex flex-col gap-3 rounded-md border border-accent/25 bg-accent/10 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-display text-xl font-bold text-cream">Hoàn thành nhiệm vụ</p>
            <p id="submit-hint" class="mt-1 text-sm text-cream/70">
              Làm xong hết các phần, Minny sẽ tự lưu chiến công cho con.
            </p>
          </div>
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
            <button id="submit-lesson" class="r2l-primary" type="button" disabled>Lưu chiến công</button>
            <button id="submit-retry" class="r2l-secondary hidden" type="button">Gửi lại</button>
          </div>
        </section>

        <section id="w1-result-recap" class="hidden space-y-3 rounded-md border border-cream/10 bg-cream/[0.04] p-4">
          <h3 class="font-display text-xl font-bold text-cream">Cần ôn 💪</h3>
          <p id="w1-recap-intro" class="text-sm text-cream/70"></p>
          <div id="w1-recap-cards" class="space-y-3"></div>
          <button id="w1-recap-skip" class="r2l-secondary hidden w-full" type="button">Bỏ qua phần ôn</button>
        </section>

        <section id="completion-card" class="hidden rounded-md border border-gold/40 bg-gold/10 p-6 text-center">
          <p class="font-display text-2xl font-bold text-gold">Nhiệm vụ xong!</p>
          <p id="completion-copy" class="mt-2 text-cream/80"></p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
            <a id="completion-new-pack" href="/read2lead#form" class="r2l-primary inline-flex items-center justify-center">Tạo bài mới</a>
            <a href="/read2lead/leaderboard" class="r2l-secondary inline-flex items-center justify-center">Bảng xếp hạng</a>
            <a href="/read2lead" class="r2l-secondary inline-flex items-center justify-center">Trang chính</a>
          </div>
        </section>
      </article>
    </section>

    <RewardBurst />
    <LevelUpModal />
    <RankUpModal />

  </main>
  <Footer />
  <script src={r2lRecorderSrc} defer></script>
  <script src="/scripts/r2l-mic-check.js" defer></script>
</BaseLayout>

<style is:global>
  .r2l-primary {
    min-height: 44px;
    border-radius: 8px;
    background: rgb(74 222 128);
    padding: 0.75rem 1rem;
    font-weight: 800;
    color: rgb(10 14 26);
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .r2l-primary:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .r2l-primary:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .r2l-secondary {
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.24);
    background: rgb(245 230 211 / 0.05);
    padding: 0.75rem 1rem;
    font-weight: 800;
    color: rgb(245 230 211);
  }

  .r2l-secondary:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .r2l-step {
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.14);
    padding: 0.75rem;
    text-align: left;
    font-weight: 700;
    color: rgb(245 230 211 / 0.72);
  }

  .r2l-step[data-active='true'],
  .r2l-step[data-state='active'] {
    border-color: rgb(212 166 78 / 0.5);
    color: rgb(212 166 78);
  }

  .r2l-step[data-done='true'],
  .r2l-step[data-state='done'] {
    border-color: rgb(74 222 128 / 0.55);
    color: rgb(74 222 128);
  }

  .r2l-step[data-state='locked'] {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  .r2l-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(245 230 211 / 0.15);
    transition: background 300ms ease, transform 300ms ease;
  }

  .r2l-dot[data-state='done'] {
    background: rgb(74 222 128);
  }

  .r2l-dot[data-state='active'] {
    background: rgb(212 166 78);
    transform: scale(1.3);
  }

  .r2l-dot[data-state='locked'] {
    background: rgb(245 230 211 / 0.15);
  }

  .r2l-story-dock {
    border-bottom: 1px solid rgb(245 230 211 / 0.1);
    background: rgb(245 230 211 / 0.03);
    transition: max-height 300ms ease;
  }

  .r2l-story-dock [data-highlight='true'] {
    background: rgb(212 166 78 / 0.2);
    border-radius: 4px;
    padding: 0 4px;
  }

  .r2l-activity {
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.12);
    background: rgb(245 230 211 / 0.04);
    padding: 1.25rem;
  }

  .r2l-activity-head h2 {
    margin-top: 0.25rem;
    font-family: Manrope, Inter, sans-serif;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 800;
    color: rgb(245 230 211);
  }

  .r2l-activity-head p {
    color: rgb(245 230 211 / 0.72);
  }

  .r2l-identity {
    font-weight: 800;
    color: rgb(212 166 78) !important;
  }

  .r2l-option,
  .r2l-token,
  .r2l-sentence {
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.14);
    background: rgb(10 14 26 / 0.45);
    padding: 0.75rem 0.9rem;
    text-align: left;
    color: rgb(245 230 211);
  }

  .r2l-option[data-state='correct'],
  .r2l-token[data-picked='true'],
  .r2l-sentence:hover {
    border-color: rgb(74 222 128 / 0.7);
    background: rgb(74 222 128 / 0.14);
  }

  .r2l-option[data-state='retry'] {
    border-color: rgb(212 166 78 / 0.75);
    background: rgb(212 166 78 / 0.14);
  }

  .r2l-option[data-state='revealed'] {
    border-color: rgb(74 222 128 / 0.5);
    background: rgb(74 222 128 / 0.1);
    opacity: 0.85;
  }

  .r2l-order-slots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    gap: 0.5rem;
  }

  .r2l-order-slot {
    min-height: 48px;
    border-radius: 8px;
    border: 1px dashed rgb(245 230 211 / 0.24);
    background: rgb(245 230 211 / 0.05);
    padding: 0.7rem 0.8rem;
    text-align: center;
    font-weight: 700;
    color: rgb(245 230 211 / 0.82);
  }

  .r2l-order-slot[data-filled='true'] {
    border-style: solid;
    border-color: rgb(74 222 128 / 0.52);
    background: rgb(74 222 128 / 0.12);
    color: rgb(245 230 211);
  }

  .r2l-order-slot[data-drop-active='true'] {
    border-color: rgb(212 166 78 / 0.85);
    background: rgb(212 166 78 / 0.14);
  }

  .r2l-order-slot[data-correct='true'] {
    border-color: rgb(74 222 128 / 0.85);
    background: rgb(74 222 128 / 0.18);
  }

  .r2l-order-slot[data-misplaced='true'] {
    border-color: rgb(239 68 68 / 0.7);
    background: rgb(239 68 68 / 0.12);
    animation: pulse-hint 0.6s ease-in-out;
  }

  [data-order-card][data-dictation-locked='true'] .r2l-order-slots,
  [data-order-card][data-dictation-locked='true'] [data-order-tokens] {
    opacity: 0.45;
  }

  [data-order-card][data-dictation-locked='true'] .r2l-order-slot,
  [data-order-card][data-dictation-locked='true'] .r2l-token {
    cursor: not-allowed;
  }

  @keyframes pulse-hint {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  .r2l-token[hidden] {
    display: none;
  }

  .r2l-rec-row {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .r2l-rec-btn {
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid rgba(245, 239, 224, 0.3);
    background: #0f172a;
    color: #f5efe0;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .r2l-rec-btn:hover {
    background: #1e293b;
  }

  .r2l-rec-start,
  .r2l-rec-play {
    border-color: rgba(16, 185, 129, 0.5);
  }

  .r2l-rec-stop {
    border-color: rgba(239, 68, 68, 0.6);
    background: rgba(127, 29, 29, 0.3);
  }

  .r2l-rec-redo {
    border-color: rgba(245, 158, 11, 0.4);
  }

  .r2l-rec-indicator {
    color: #f87171;
    font-size: 0.85rem;
    animation: r2l-pulse 1.2s infinite;
  }

  @keyframes r2l-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  .r2l-speaking-word {
    display: inline-block;
    margin: 0.15rem 0.25rem 0.15rem 0;
    border-radius: 999px;
    border: 1px solid transparent;
    padding: 0.2rem 0.55rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  button.r2l-speaking-word {
    cursor: pointer;
    min-height: 44px;
  }

  .r2l-speaking-word[data-tone='good'] {
    background: rgb(74 222 128 / 0.18);
    color: rgb(187 247 208);
  }

  .r2l-speaking-word[data-tone='close'] {
    background: rgb(212 166 78 / 0.18);
    color: rgb(253 230 138);
  }

  .r2l-speaking-word[data-tone='miss'] {
    border-color: rgb(239 68 68 / 0.65);
    background: rgb(239 68 68 / 0.28);
    color: #fee2e2;
  }

  .r2l-speaking-word-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-left: 0.25rem;
    vertical-align: middle;
  }

  .r2l-speaking-feedback-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }

  .r2l-replay-rate-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.65rem;
  }

  .r2l-replay-rate {
    min-height: 44px;
    border-radius: 999px;
    border: 1px solid rgb(242 204 126 / 0.45);
    background: rgb(15 23 42 / 0.72);
    padding: 0.25rem 0.7rem;
    color: #f5efe0;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .r2l-wave-panel {
    margin-top: 0.75rem;
    border-radius: 8px;
    border: 1px solid rgb(245 239 224 / 0.12);
    background: rgb(15 23 42 / 0.42);
    padding: 0.75rem;
  }

  .r2l-wave-row {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: center;
  }

  .r2l-wave-row + .r2l-wave-row {
    margin-top: 0.5rem;
  }

  .r2l-wave-label,
  .r2l-wave-status {
    color: rgb(245 239 224 / 0.72);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .r2l-wave-mount {
    min-height: 38px;
  }

  @media (prefers-reduced-motion: reduce) {
    .r2l-rec-indicator {
      animation: none;
    }
  }

  .r2l-minny-hero-wrap {
    display: flex;
    justify-content: center;
    margin: 1rem 0 0.5rem;
  }

  .r2l-minny-hero {
    width: 9rem;
    height: 9rem;
  }

  .r2l-minny-video,
  .r2l-minny-fallback {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .r2l-minny-sentence-en {
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 800;
    line-height: 1.45;
    color: rgb(245 230 211);
  }

  .r2l-minny-sentence-vi {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: rgb(245 230 211 / 0.65);
  }

  .r2l-minny-sentence-card {
    border-radius: 12px;
    border: 1px solid rgb(245 230 211 / 0.12);
    background: rgb(10 14 26 / 0.45);
    padding: 1.25rem;
  }

  .r2l-minny-speak-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .minny-btn {
    display: inline-flex;
    min-height: 52px;
    flex: 1 1 140px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 3px solid transparent;
    padding: 0.75rem 1rem;
    font-size: 1.05rem;
    font-weight: 800;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .minny-btn:active:not(:disabled) {
    transform: scale(0.98);
  }

  .minny-btn:disabled {
    cursor: not-allowed;
    opacity: 0.42;
  }

  .minny-btn--listen {
    background: rgb(200 143 56 / 0.18);
    color: rgb(242 204 126);
    border-color: rgb(200 143 56 / 0.45);
  }

  .minny-btn--listen:hover:not(:disabled) {
    background: rgb(200 143 56 / 0.28);
  }

  .minny-btn--record {
    background: rgb(212 166 78);
    color: rgb(10 14 26);
    border-color: rgb(250 220 160);
    box-shadow: 0 3px 0 rgb(120 90 40);
  }

  .minny-btn--record:hover:not(:disabled) {
    background: rgb(242 204 126);
  }

  .r2l-trivia-reveal {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 480ms ease,
      transform 480ms ease;
  }

  .r2l-trivia-reveal[data-show='true'] {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes r2l-trivia-sparkle {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  .r2l-trivia-reveal[data-show='true'] > .flex > span {
    animation: r2l-trivia-sparkle 1.2s ease-in-out 2;
  }

  .r2l-w1-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    border: 2px solid rgb(245 230 211 / 0.2);
    padding: 0.35rem 0.85rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: rgb(245 230 211 / 0.65);
  }

  .r2l-w1-chip[data-done='true'] {
    border-color: rgb(74 222 128 / 0.55);
    color: rgb(74 222 128);
  }

  .r2l-w1-story-card {
    border-radius: 12px;
    border: 1px solid rgb(245 230 211 / 0.12);
    background: rgb(10 14 26 / 0.55);
    padding: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: rgb(245 230 211);
  }

  .r2l-w1-karaoke {
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: rgb(255 200 61);
    text-underline-offset: 4px;
  }

  .r2l-option[data-state='wrong-w1'] {
    border-color: rgb(248 113 113 / 0.65);
    background: rgb(248 113 113 / 0.12);
  }

  .r2l-option[data-disabled-w1='true'] {
    opacity: 0.45;
    pointer-events: none;
  }

  .r2l-w1-shake {
    animation: r2l-w1-shake 0.45s ease;
  }

  @keyframes r2l-w1-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .r2l-w1-shake { animation: none; }
  }

  .r2l-order-slot[data-misplaced='true'] {
    outline: 2px solid rgb(251 146 60);
    background: rgb(251 146 60 / 0.15);
  }

  .r2l-w1-copy-ghost {
    margin-top: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    border: 1px dashed rgb(245 230 211 / 0.25);
    color: rgb(245 230 211 / 0.75);
    font-style: italic;
  }

  .r2l-kid-quest-path {
    display: flex;
    align-items: flex-start;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
  }

  .r2l-kid-quest-path__node {
    position: relative;
    flex: 0 0 auto;
    padding-right: 1.25rem;
  }

  .r2l-kid-quest-path__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    min-width: 56px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    font-weight: 700;
    color: rgb(245 230 211 / 0.7);
  }

  .r2l-kid-quest-path__btn:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .r2l-kid-quest-path__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: rgb(245 230 211 / 0.08);
    font-size: 1.1rem;
  }

  .r2l-kid-quest-path__node--current .r2l-kid-quest-path__icon {
    outline: 2px solid rgb(56 189 248);
  }

  #w1-hud-story-btn {
    min-height: 40px;
    min-width: 40px;
    border-radius: 8px;
    border: none;
    background: rgb(167 139 250);
    font-size: 1.1rem;
  }

  .r2l-book-reader {
    border: 1px solid rgb(200 143 56 / 0.35);
    border-radius: 16px;
    background: rgb(23 53 74 / 0.72);
    padding: 1rem;
  }

  .r2l-book-reader [data-book-stage-container].hidden {
    display: none;
  }

  .r2l-book-page {
    display: grid;
    grid-template-rows: auto auto;
    overflow: hidden;
    border: 1px solid rgb(245 230 200 / 0.18);
    border-radius: 14px;
    background: rgb(16 39 58);
  }

  .r2l-book-page__art {
    position: relative;
    height: clamp(18rem, min(52vw, 58vh), 36rem);
    min-height: 0;
    overflow: hidden;
    background: rgb(16 39 58);
  }

  .r2l-book-page img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .r2l-book-page__text {
    height: clamp(10rem, 18vw, 13rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    border-top: 1px solid rgb(245 230 200 / 0.18);
    background: rgb(16 39 58 / 0.98);
    padding: 1rem 1.25rem;
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    font-weight: 700;
    line-height: 1.65;
    color: rgb(245 230 200);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.8);
  }

  .r2l-book-gate {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid rgb(200 143 56 / 0.28);
    border-radius: 12px;
    background: rgb(200 143 56 / 0.08);
    padding: 1rem;
  }

  .r2l-book-attribution {
    border-top: 1px solid rgb(245 230 200 / 0.14);
    padding-top: 0.75rem;
    color: rgb(217 199 164);
  }

  .r2l-book-attribution summary {
    min-height: 44px;
    cursor: pointer;
    font-weight: 800;
    color: rgb(242 204 126);
  }

  @media (max-width: 639px) {
    .r2l-book-page__art {
      height: clamp(14rem, 78vw, 20rem);
    }

    .r2l-book-page__text {
      height: clamp(15rem, 72vw, 19rem);
      padding: 1rem;
      text-shadow: none;
    }
  }

  /* ===== Phase 1: Progress Trail ===== */
  .r2l-book-trail-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .r2l-book-trail-bar {
    height: 4px;
    border-radius: var(--radius-full, 9999px);
    background: color-mix(in srgb, var(--cream-dim, #aa9673) 20%, transparent);
    overflow: hidden;
  }

  .r2l-book-trail-bar__fill {
    height: 100%;
    width: 0%;
    border-radius: var(--radius-full, 9999px);
    background: linear-gradient(90deg, var(--gold, #c88f38), var(--gold-light, #f2cc7e));
    transition: width 400ms ease;
  }

  .r2l-book-trail {
    display: flex;
    align-items: flex-start;
    gap: 0;
    margin: 0;
    padding: var(--space-2, 0.5rem) 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .r2l-book-trail__node {
    position: relative;
    flex: 1 1 0;
    min-width: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .r2l-book-trail__node::before {
    content: '';
    position: absolute;
    top: 22px;
    left: -50%;
    width: 100%;
    height: 3px;
    background: color-mix(in srgb, var(--cream-dim, #aa9673) 30%, transparent);
    background-image: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--cream-dim, #aa9673) 40%, transparent) 0,
      color-mix(in srgb, var(--cream-dim, #aa9673) 40%, transparent) 4px,
      transparent 4px,
      transparent 8px
    );
  }

  .r2l-book-trail__node:first-child::before {
    display: none;
  }

  .r2l-book-trail__node[data-state='completed']::before {
    background: linear-gradient(90deg, var(--gold, #c88f38), var(--gold-light, #f2cc7e));
    background-image: none;
  }

  .r2l-book-trail__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1, 0.25rem);
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .r2l-book-trail__btn:disabled {
    cursor: default;
  }

  .r2l-book-trail__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full, 9999px);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--cream, #f5e6c8);
    border: 2px dashed color-mix(in srgb, var(--cream-dim, #aa9673) 40%, transparent);
    background: var(--navy-900, #17354a);
  }

  .r2l-book-trail__node[data-state='completed'] .r2l-book-trail__icon {
    border: 2px solid var(--gold, #c88f38);
    background: var(--gold, #c88f38);
    color: var(--navy-950, #10273a);
  }

  .r2l-book-trail__node[data-state='active'] .r2l-book-trail__icon {
    border: 2px solid var(--gold, #c88f38);
    background: color-mix(in srgb, var(--gold, #c88f38) 15%, transparent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold, #c88f38) 20%, transparent);
    animation: r2l-book-trail-pulse 1.8s ease-in-out infinite;
  }

  .r2l-book-trail__minny {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full, 9999px);
    object-fit: contain;
  }

  .r2l-book-trail__pill {
    position: absolute;
    top: -6px;
    background: var(--gold, #c88f38);
    color: var(--navy-950, #10273a);
    font-size: 0.65rem;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: var(--radius-full, 9999px);
    white-space: nowrap;
  }

  .r2l-book-trail__label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--cream-muted, #d9c7a4);
    text-align: center;
    white-space: nowrap;
  }

  .r2l-book-trail__node[data-state='upcoming'] .r2l-book-trail__label {
    color: var(--cream-dim, #aa9673);
    opacity: 0.6;
  }

  .r2l-book-trail__sub {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--cream-dim, #aa9673);
    text-align: center;
    white-space: nowrap;
  }

  .r2l-book-trail__node[data-state='completed'] .r2l-book-trail__sub {
    color: var(--gold-light, #f2cc7e);
  }

  .r2l-book-trail__node[data-state='active'] .r2l-book-trail__sub {
    color: var(--cream-muted, #d9c7a4);
  }

  @keyframes r2l-book-trail-pulse {
    0%, 100% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold, #c88f38) 20%, transparent); }
    50% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--gold, #c88f38) 10%, transparent); }
  }

  @media (prefers-reduced-motion: reduce) {
    .r2l-book-trail__node[data-state='active'] .r2l-book-trail__icon {
      animation: none;
    }
  }

  @media (max-width: 639px) {
    .r2l-book-trail__icon {
      width: 36px;
      height: 36px;
      font-size: 0.9rem;
    }
    .r2l-book-trail__minny {
      width: 26px;
      height: 26px;
    }
    .r2l-book-trail__label {
      font-size: 0.6rem;
    }
    .r2l-book-trail__node {
      min-width: 36px;
    }
  }

  /* ===== Book Reader redesign: storybook quest ===== */
  .r2l-book-reader {
    --book-panel: color-mix(in srgb, var(--navy-850) 88%, var(--navy-950));
    --book-panel-soft: color-mix(in srgb, var(--navy-900) 82%, transparent);
    display: block;
    width: 100%;
    max-width: 92rem;
    margin-inline: auto;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--cream) 14%, transparent);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(circle at 72% 0%, color-mix(in srgb, var(--gold) 7%, transparent), transparent 30rem),
      var(--navy-950);
    box-shadow: var(--shadow-2xl);
    color: var(--cream);
  }

  .r2l-book-reader.hidden {
    display: none;
  }

  .r2l-book-reader .hidden {
    display: none;
  }

  .r2l-book-eyebrow {
    margin: 0;
    color: var(--gold-light);
    font-size: 0.69rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .r2l-book-trail-header {
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    padding: clamp(1rem, 2vw, 1.4rem);
    border: 1px solid color-mix(in srgb, var(--cream) 12%, transparent);
    border-radius: var(--radius-xl);
    background: var(--book-panel);
    box-shadow: var(--shadow-card);
  }

  .r2l-book-trail-header__title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .r2l-book-trail-header__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.45rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--cream);
  }

  .r2l-book-trail-header__meta,
  .r2l-book-page-count {
    margin: var(--space-1) 0 0;
    color: var(--cream-dim);
    font-size: 0.76rem;
    font-weight: 650;
  }

  .r2l-book-page-count {
    flex: none;
    color: var(--cream-muted);
  }

  .r2l-book-trail-bar {
    height: 6px;
    background: color-mix(in srgb, var(--cream) 12%, transparent);
  }

  .r2l-book-trail-bar__fill {
    background: linear-gradient(90deg, var(--gold), var(--gold-light));
    box-shadow: 0 0 16px color-mix(in srgb, var(--gold) 55%, transparent);
  }

  .r2l-book-trail {
    align-items: flex-start;
    overflow: visible;
    padding: var(--space-2) 0 0;
  }

  .r2l-book-trail__node {
    min-width: 44px;
  }

  .r2l-book-trail__node::before {
    top: 27px;
    height: 4px;
  }

  .r2l-book-trail__btn {
    width: 100%;
    gap: var(--space-2);
    color: inherit;
  }

  .r2l-book-trail__btn:not(:disabled):hover .r2l-book-trail__icon,
  .r2l-book-trail__btn:focus-visible .r2l-book-trail__icon {
    transform: translateY(-2px);
    border-color: var(--gold-light);
  }

  .r2l-book-trail__btn:focus-visible {
    border-radius: var(--radius-lg);
    outline: 3px solid color-mix(in srgb, var(--gold-light) 65%, transparent);
    outline-offset: 3px;
  }

  .r2l-book-trail__icon {
    width: 54px;
    height: 54px;
    border-color: color-mix(in srgb, var(--cream-muted) 42%, transparent);
    background: color-mix(in srgb, var(--cream) 7%, var(--navy-900));
    font-family: var(--font-display);
    font-size: 1rem;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .r2l-book-trail__node[data-state='completed'] .r2l-book-trail__icon {
    border-color: var(--gold-light);
    background: linear-gradient(160deg, var(--gold-light), var(--gold));
    box-shadow: 0 0 0 4px var(--navy-850), var(--shadow-md);
  }

  .r2l-book-trail__node[data-state='active'] .r2l-book-trail__icon {
    width: 60px;
    height: 60px;
    border-width: 3px;
    background: var(--navy-900);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold) 20%, transparent), var(--shadow-lg);
  }

  .r2l-book-trail__node[data-state='reward'] .r2l-book-trail__icon {
    border-style: solid;
    color: var(--gold-light);
  }

  .r2l-book-trail__minny {
    width: 42px;
    height: 42px;
  }

  .r2l-book-trail__pill {
    top: -9px;
    border: 2px solid var(--navy-850);
    font-size: 0.6rem;
  }

  .r2l-book-trail__label {
    max-width: 7rem;
    overflow: hidden;
    color: var(--cream);
    font-size: 0.69rem;
    line-height: 1.25;
    text-overflow: ellipsis;
  }

  .r2l-book-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    perspective: 1200px;
  }

  .r2l-book-page-shell,
  .r2l-book-panel {
    min-width: 0;
  }

  .r2l-book-page-shell {
    transform-origin: left center;
  }

  .r2l-book-page-shell.is-turning {
    animation: r2l-book-page-turn 600ms cubic-bezier(0.22, 0.75, 0.3, 1) both;
  }

  .r2l-book-page-shell.is-entering {
    animation: r2l-book-page-enter 420ms cubic-bezier(0.22, 0.75, 0.3, 1) both;
  }

  .r2l-book-page {
    display: flex;
    min-height: 0;
    flex-direction: column;
    border-color: color-mix(in srgb, var(--cream) 14%, transparent);
    border-radius: var(--radius-2xl);
    background: var(--navy-900);
    box-shadow: var(--shadow-xl);
  }

  .r2l-book-page__art {
    height: clamp(18rem, 54vw, 34rem);
    border-radius: calc(var(--radius-2xl) - 1px) calc(var(--radius-2xl) - 1px) 0 0;
    background: var(--navy-900);
    isolation: isolate;
  }

  .r2l-book-page__art::before {
    content: '';
    position: absolute;
    inset: -12px;
    z-index: 0;
    background-image: var(--book-art-image);
    background-position: center;
    background-size: cover;
    filter: blur(12px) saturate(0.82);
    opacity: 0.52;
    transform: scale(1.04);
  }

  .r2l-book-page__art::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--navy-950) 32%, transparent);
    pointer-events: none;
  }

  .r2l-book-page img {
    z-index: 2;
    object-fit: contain;
    background: color-mix(in srgb, var(--navy-950) 12%, transparent);
  }

  .r2l-book-page__badge,
  .r2l-book-page__credit {
    position: absolute;
    top: var(--space-4);
    z-index: 3;
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--cream) 20%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--navy-950) 78%, transparent);
    padding: 0 var(--space-3);
    color: var(--cream);
    font-size: 0.72rem;
    font-weight: 750;
    backdrop-filter: blur(8px);
  }

  .r2l-book-page__badge { left: var(--space-4); }
  .r2l-book-page__credit { right: var(--space-4); color: var(--cream-muted); }

  .r2l-book-page__nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--cream) 20%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--navy-950) 76%, transparent);
    color: var(--cream);
    font-size: 1.2rem;
    transform: translateY(-50%);
    backdrop-filter: blur(8px);
  }

  .r2l-book-page__nav--prev { left: var(--space-4); }
  .r2l-book-page__nav--next { right: var(--space-4); }
  .r2l-book-page__nav:hover { background: var(--gold); color: var(--navy-950); }
  .r2l-book-page__nav:disabled { opacity: 0.35; cursor: default; }

  .r2l-book-karaoke {
    min-height: 8.2rem;
    border-top: 1px solid color-mix(in srgb, var(--cream) 12%, transparent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--navy-900) 72%, transparent), var(--navy-950));
    padding: var(--space-4) var(--space-5);
  }

  .r2l-book-karaoke__text {
    margin: var(--space-2) 0 0;
    color: var(--cream-dim);
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 2.1vw, 1.38rem);
    font-weight: 750;
    line-height: 1.45;
  }

  .r2l-book-karaoke__text[data-active='true'] {
    color: var(--cream);
    background-image: linear-gradient(180deg, transparent 64%, color-mix(in srgb, var(--gold) 48%, transparent) 64%);
    background-decoration-break: clone;
    box-decoration-break: clone;
  }

  .r2l-book-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .r2l-book-stepper {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border: 1px solid color-mix(in srgb, var(--cream) 12%, transparent);
    border-radius: var(--radius-xl);
    background: var(--book-panel);
  }

  .r2l-book-stepper__step {
    display: flex;
    min-height: 44px;
    min-width: 0;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 1px solid color-mix(in srgb, var(--cream) 14%, transparent);
    border-radius: var(--radius-lg);
    color: var(--cream-muted);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .r2l-book-stepper__step b {
    display: inline-flex;
    width: 25px;
    height: 25px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--cream) 12%, transparent);
    color: var(--cream-muted);
    font-size: 0.72rem;
  }

  .r2l-book-stepper__arrow { color: var(--cream-dim); }

  .r2l-book-reader[data-book-stage='story'] [data-book-step='story'],
  .r2l-book-reader[data-book-stage='questions'] [data-book-step='questions'],
  .r2l-book-reader[data-book-stage='shadow'] [data-book-step='shadow'] {
    border-color: color-mix(in srgb, var(--gold) 55%, transparent);
    background: color-mix(in srgb, var(--gold) 16%, transparent);
    color: var(--gold-light);
  }

  .r2l-book-reader[data-book-stage='story'] [data-book-step='story'] b,
  .r2l-book-reader[data-book-stage='questions'] [data-book-step='questions'] b,
  .r2l-book-reader[data-book-stage='shadow'] [data-book-step='shadow'] b {
    background: var(--gold);
    color: var(--navy-950);
  }

  .r2l-book-reader[data-book-stage='questions'] [data-book-step='story'],
  .r2l-book-reader[data-book-stage='shadow'] [data-book-step='story'],
  .r2l-book-reader[data-book-stage='shadow'] [data-book-step='questions'],
  .r2l-book-reader[data-book-stage='next'] .r2l-book-stepper__step {
    border-color: color-mix(in srgb, var(--success) 45%, transparent);
    color: var(--success);
  }

  .r2l-book-story-card,
  .r2l-book-gate,
  .r2l-book-question-card,
  .r2l-book-shadow-stage,
  .r2l-book-reward {
    border: 1px solid color-mix(in srgb, var(--cream) 12%, transparent);
    border-radius: var(--radius-2xl);
    background: var(--book-panel);
    box-shadow: var(--shadow-card);
  }

  .r2l-book-story-card {
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .r2l-book-story-card__heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .r2l-book-story-card__heading::after {
    content: '';
    height: 1px;
    flex: 1;
    background: color-mix(in srgb, var(--cream) 14%, transparent);
  }

  .r2l-book-story-card__heading > span {
    color: var(--cream-dim);
    font-size: 0.67rem;
  }

  .r2l-book-page__text {
    height: auto;
    min-height: 9.25rem;
    max-height: 18rem;
    margin-top: var(--space-3);
    overflow-y: auto;
    border: 0;
    background: transparent;
    padding: 0 var(--space-1) 0 0;
    color: var(--cream-muted);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.2vw, 1.38rem);
    font-weight: 650;
    line-height: 1.62;
    text-shadow: none;
  }

  .r2l-book-sentence {
    border-radius: 0.2rem;
    transition: color 160ms ease, background-image 160ms ease;
  }

  .r2l-book-sentence[data-active='true'] {
    color: var(--cream);
    background-image: linear-gradient(180deg, transparent 66%, color-mix(in srgb, var(--gold) 55%, transparent) 66%);
    background-decoration-break: clone;
    box-decoration-break: clone;
  }

  .r2l-book-sentence-translation {
    display: block;
    margin: var(--space-1) 0 var(--space-2);
    color: var(--cream-dim);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 550;
    line-height: 1.45;
  }

  .r2l-book-helpers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .r2l-book-helper,
  .r2l-book-retry {
    min-height: 44px;
    border: 1px solid color-mix(in srgb, var(--cream-muted) 28%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--cream) 6%, transparent);
    padding: 0 var(--space-4);
    color: var(--cream-muted);
    font-size: 0.75rem;
    font-weight: 750;
  }

  .r2l-book-helper:hover,
  .r2l-book-helper[aria-expanded='true'],
  .r2l-book-helper:focus-visible,
  .r2l-book-retry:hover {
    border-color: var(--gold);
    color: var(--gold-light);
  }

  .r2l-book-helper-panel {
    margin-top: var(--space-3);
    border: 1px solid color-mix(in srgb, var(--gold) 25%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--gold) 8%, transparent);
    padding: var(--space-3);
    color: var(--cream-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .r2l-vocab-card {
    padding: var(--space-3) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 10%, transparent);
  }
  .r2l-vocab-card:last-child { border-bottom: none; }
  .r2l-vocab-word {
    font-size: var(--text-base);
    color: var(--gold-light);
  }
  .r2l-vocab-context {
    margin-top: var(--space-1);
    font-size: 0.88rem;
    font-style: italic;
    color: var(--cream-muted);
    line-height: var(--leading-relaxed);
  }
  .r2l-vocab-vi {
    margin-top: var(--space-1);
    font-size: 0.75rem;
    color: var(--cream-dim);
  }

  .r2l-book-stage-stack {
    position: relative;
    min-height: 15rem;
  }

  .r2l-book-reader [data-book-stage-container]:not(.hidden) {
    animation: r2l-book-stage-in 250ms ease both;
  }

  .r2l-book-reader [data-book-stage-container].is-leaving {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: block;
    pointer-events: none;
    animation: r2l-book-stage-out 180ms ease both;
  }

  .r2l-book-gate {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 15rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    background:
      radial-gradient(circle at 84% 42%, color-mix(in srgb, var(--gold) 20%, transparent), transparent 9rem),
      var(--book-panel);
  }

  .r2l-book-audio__copy h3,
  .r2l-book-question-card h3,
  .r2l-book-shadow-stage h3,
  .r2l-book-reward h3 {
    margin: var(--space-2) 0;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.7vw, 1.7rem);
    font-weight: 850;
    line-height: 1.25;
  }

  .r2l-book-audio__copy > p:last-child,
  .r2l-book-audio__excerpt {
    margin: 0;
    color: var(--cream-dim);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .r2l-book-audio__button {
    position: relative;
    display: grid;
    width: 88px;
    height: 88px;
    min-width: 44px;
    min-height: 44px;
    place-items: center;
    border: 2px solid var(--gold-light);
    border-radius: var(--radius-full);
    background: linear-gradient(160deg, var(--gold-light), var(--gold));
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--gold) 10%, transparent), var(--shadow-lg);
    color: var(--navy-950);
    font-size: 1.65rem;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .r2l-book-audio__button:hover { transform: translateY(-2px) scale(1.02); }
  .r2l-book-audio__button:focus-visible { outline: 4px solid color-mix(in srgb, var(--cream) 60%, transparent); outline-offset: 4px; }
  .r2l-book-audio__pause,
  .r2l-book-audio__check,
  .r2l-book-audio__wave,
  .r2l-book-audio__mobile-label { display: none; }

  .r2l-book-gate[data-audio-state='playing'] .r2l-book-audio__button {
    animation: r2l-book-audio-halo 1.4s ease-in-out infinite;
  }

  .r2l-book-gate[data-audio-state='playing'] .r2l-book-audio__play,
  .r2l-book-gate[data-audio-state='playing'] .r2l-book-audio__check,
  .r2l-book-gate[data-audio-state='paused'] .r2l-book-audio__play,
  .r2l-book-gate[data-audio-state='done'] .r2l-book-audio__play { display: none; }
  .r2l-book-gate[data-audio-state='playing'] .r2l-book-audio__wave,
  .r2l-book-gate[data-audio-state='paused'] .r2l-book-audio__pause,
  .r2l-book-gate[data-audio-state='done'] .r2l-book-audio__check { display: flex; }

  .r2l-book-audio__wave {
    height: 32px;
    align-items: center;
    gap: 3px;
  }

  .r2l-book-audio__wave i {
    width: 4px;
    height: 11px;
    border-radius: var(--radius-full);
    background: var(--navy-950);
    animation: r2l-book-wave 700ms ease-in-out infinite alternate;
  }
  .r2l-book-audio__wave i:nth-child(2) { animation-delay: -300ms; }
  .r2l-book-audio__wave i:nth-child(3) { animation-delay: -500ms; }
  .r2l-book-audio__wave i:nth-child(4) { animation-delay: -200ms; }
  .r2l-book-audio__wave i:nth-child(5) { animation-delay: -400ms; }

  .r2l-book-audio__timeline {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
    color: var(--cream-dim);
    font-size: 0.68rem;
  }

  .r2l-book-audio__track {
    height: 6px;
    overflow: hidden;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--cream) 12%, transparent);
  }

  .r2l-book-audio__track span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--gold), var(--gold-light));
  }

  .r2l-book-audio__excerpt {
    grid-column: 1 / -1;
    min-height: 1.25rem;
    text-align: center;
  }

  .r2l-book-next-cta {
    min-height: 52px;
    border: 1px solid var(--gold-light);
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, var(--gold-light), var(--gold));
    box-shadow: 0 8px 0 color-mix(in srgb, var(--gold) 55%, var(--navy-950)), var(--shadow-md);
    padding: 0 var(--space-6);
    color: var(--navy-950);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 850;
  }

  .r2l-book-gate .r2l-book-next-cta { grid-column: 1 / -1; width: 100%; }
  .r2l-book-next-cta:not(:disabled):hover { transform: translateY(-1px); filter: brightness(1.06); }
  .r2l-book-next-cta:disabled { opacity: 0.46; cursor: not-allowed; }

  .r2l-book-question-card,
  .r2l-book-shadow-stage,
  .r2l-book-reward {
    min-height: 15rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  .r2l-book-question-options {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .r2l-book-guided-option {
    position: relative;
    min-height: 64px;
    border: 1px solid color-mix(in srgb, var(--cream-muted) 26%, transparent);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--cream) 6%, transparent);
    padding: var(--space-3) var(--space-4) var(--space-3) 3.4rem;
    color: var(--cream);
    font-size: 1rem;
    font-weight: 750;
    text-align: left;
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease;
  }

  .r2l-book-guided-option::before {
    content: attr(data-option-label);
    position: absolute;
    left: var(--space-4);
    display: inline-flex;
    width: 25px;
    height: 25px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--cream) 12%, transparent);
    color: var(--cream-muted);
    font-size: 0.72rem;
  }

  .r2l-book-guided-option:not(:disabled):hover,
  .r2l-book-guided-option:focus-visible {
    transform: translateY(-2px);
    border-color: var(--gold);
    background: color-mix(in srgb, var(--gold) 10%, transparent);
  }

  .r2l-book-guided-option[data-state='correct'] {
    border: 2px solid var(--success);
    background: color-mix(in srgb, var(--success) 18%, transparent);
    color: var(--cream);
  }

