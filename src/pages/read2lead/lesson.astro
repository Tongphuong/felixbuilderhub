  function w1EnterGuidedListeningPhase() {
    state.w1Phase = 'guided_listening';
    qs('#w1-story-phase')?.classList.add('hidden');
    qs('#w1-guided-listening-phase')?.classList.remove('hidden');
    qs('#w1-legacy-progress')?.classList.add('hidden');
    qsa('[data-activity-shell]').forEach((shell) => { shell.hidden = true; });
    qs('#global-cta')?.classList.add('hidden');
    initGuidedListeningSentences();
  }

  function w1InitGuidedListeningPhase() {
    w1EnterGuidedListeningPhase();
  }

  /**
   * Normalize raw backend guided_listening data into internal shape.
   * Inlined here because the is:inline script cannot access ES module imports.
   */
  function normalizeGuidedListening(raw, storySentences = []) {
    const paragraphs = [];
    const questions = [];
    if (!Array.isArray(raw)) return { paragraphs, questions };
    for (const para of raw) {
      const paraIdx = Number(para?.paragraph_index ?? 0);
      const rawQuestions = Array.isArray(para?.questions) ? para.questions : [];
      const paragraphSentenceIndexes = storySentences
        .map((sentence, sentenceIndex) => ({ sentence, sentenceIndex }))
        .filter(({ sentence }) => (Number(sentence?.paragraph_index) || 0) === paraIdx)
        .map(({ sentenceIndex }) => sentenceIndex);
      const entrySentenceIndex = Number(para?.sentence_index);
      const normalizedQuestions = rawQuestions.map(function (q, questionIndex) {
        const questionSentenceIndex = Number(q?.sentence_index);
        var base = {
          id: String(q.id ?? ''),
          question_vi: String(q.question_vi ?? ''),
          question_en: String(q.question_en ?? ''),
          paragraph_index: paraIdx,
          sentence_index: Number.isFinite(questionSentenceIndex)
            ? questionSentenceIndex
            : (Number.isFinite(entrySentenceIndex)
              ? entrySentenceIndex
              : (paragraphSentenceIndexes[questionIndex % Math.max(paragraphSentenceIndexes.length, 1)] ?? paraIdx)),
        };
        if (q?.type === 'yes_no') {
          var answer = Boolean(q.answer);
          return Object.assign({}, base, {
            type: 'yes_no',
            options_en: ['Yes', 'No'],
            options_vi: ['Có', 'Không'],
            correct_index: answer ? 0 : 1,
            answer: answer,
          });
        }
        return Object.assign({}, base, {
          type: 'choice',
          options_en: Array.isArray(q?.options_en) ? q.options_en : [],
          options_vi: Array.isArray(q?.options_vi) ? q.options_vi : [],
          correct_index: Number(q?.correct_index ?? 0),
          answer: undefined,
        });
      });
      paragraphs.push({ index: paraIdx, questions: normalizedQuestions });
      questions.push.apply(questions, normalizedQuestions);
    }
    return { paragraphs: paragraphs, questions: questions };
  }

  function initGuidedListeningSentences() {
    const section = qs('#w1-guided-listening-phase');
    if (!section) return;
    const listener = section.querySelector('[data-guided-listener]');
    if (!listener) return;
    const instructions = listener.querySelector('[data-activity-instructions]');
    if (instructions) instructions.textContent = 'Con nghe từng câu, rồi trả lời câu hỏi nhé!';
    const progress = listener.querySelector('[data-guided-progress]');
    if (progress) progress.setAttribute('aria-label', 'Tiến độ câu');

    const story = state.lesson?.story || {};
    const sentences = (story.sentences || []).filter((sentence) => String(sentence?.text_en || sentence?.text || '').trim());
    // Normalize backend guided_listening shape once
    const rawGuided = state.lesson?.guided_listening;
    if (!rawGuided || !rawGuided.length) {
      console.warn('[R2L] guided_listening data is empty — sentences can be skipped');
    } else {
      console.log('[R2L] guided_listening loaded:', rawGuided.length, 'question groups');
    }
    const normalized = normalizeGuidedListening(Array.isArray(rawGuided) ? rawGuided : [], sentences);
    // Store normalized data on window/scope for reuse
    window.__guidedNorm = normalized;
    const questions = normalized.questions;

    const count = sentences.length;
    listener.dataset.sentenceCount = String(count);

    state.guidedListening.progressVersion = 2;
    if (!Array.isArray(state.guidedListening.sentencePlayed)) {
      state.guidedListening.sentencePlayed = new Array(count).fill(false);
    }
    if (!Array.isArray(state.guidedListening.sentencesDone)) {
      state.guidedListening.sentencesDone = new Array(count).fill(false);
    }
    state.guidedListening.sentencePlayed = Array.from({ length: count }, (_, i) => Boolean(state.guidedListening.sentencePlayed[i]));
    state.guidedListening.sentencesDone = Array.from({ length: count }, (_, i) => Boolean(state.guidedListening.sentencesDone[i]));
    state.guidedListening.sentenceIndex = Math.max(0, Math.min(Number(state.guidedListening.sentenceIndex) || 0, Math.max(0, count - 1)));

    // Render progress dots
    if (progress) {
      progress.innerHTML = Array.from({ length: count }, (_, i) =>
        `<span class="r2l-dot" data-sentence-dot="${i}" data-state="${state.guidedListening.sentencesDone[i] ? 'done' : (i === state.guidedListening.sentenceIndex ? 'active' : 'locked')}" aria-label="Câu ${i + 1}"></span>`
      ).join('');
    }

    updateGuidedSentenceView(sentences, questions);
    updateGuidedControls(sentences);
  }

  let guidedAdvanceTimer = null;

  function updateGuidedSentenceView(sentences, questions) {
    const section = qs('#w1-guided-listening-phase');
    if (!section) return;
    const idx = state.guidedListening.sentenceIndex;
    const sentence = sentences[idx];
    if (!sentence) return;

    const label = section.querySelector('[data-paragraph-label]');
    if (label) label.textContent = `Câu ${idx + 1}/${sentences.length}`;

    const paraContainer = section.querySelector('[data-guided-paragraph]');
    if (paraContainer) paraContainer.hidden = false;

    const paraText = section.querySelector('[data-paragraph-text]');
    if (paraText) {
      paraText.innerHTML = `<p class="text-base leading-relaxed text-cream">${escapeHtml(sentence.text_en || sentence.text || '')}</p>`;
    }
    const qContainer = section.querySelector('[data-guided-questions]');

    const audioSec = section.querySelector('[data-guided-audio]');
    const playBtn = section.querySelector('[data-guided-play]');
    if (audioSec) {
      if (state.guidedListening.sentencePlayed[idx]) {
        audioSec.hidden = true;
        showGuidedQuestions(idx);
      } else {
        audioSec.hidden = false;
        if (qContainer) qContainer.innerHTML = '';
        if (playBtn) {
          playBtn.disabled = false;
          playBtn.textContent = '🔊 Nghe câu này';
        }
      }
    }

    if (playBtn && !playBtn.dataset.bound) {
      playBtn.dataset.bound = '1';
      playBtn.addEventListener('click', () => {
        const sentenceIndex = state.guidedListening.sentenceIndex;
        const currentSentence = (state.lesson?.story?.sentences || []).filter((item) => String(item?.text_en || item?.text || '').trim())[sentenceIndex];
        const played = state.guidedListening.sentencePlayed.slice();
        played[sentenceIndex] = true;
        state.guidedListening.sentencePlayed = played;
        state.guidedListening.phase = 'playing';
        audioSec.hidden = true;
        scheduleSaveLessonSession();
        updateGuidedControls(sentences);

        const revealQuestions = () => {
          if (sentenceIndex !== state.guidedListening.sentenceIndex) return;
          state.guidedListening.phase = 'questioning';
          showGuidedQuestions(sentenceIndex);
          checkSentenceCompletion(sentenceIndex, sentences);
          scheduleSaveLessonSession();
        };
        const url = currentSentence?.audio_url || '';
        if (!url || isRewardSfxUrl(url)) {
          revealQuestions();
          return;
        }
        playAudio(url, playBtn);
        const audio = lessonAudioState.audio;
        if (!audio) {
          revealQuestions();
          return;
        }
        audio.addEventListener('ended', revealQuestions, { once: true });
        audio.addEventListener('error', revealQuestions, { once: true });
      });
    }

    const dots = section.querySelectorAll('[data-sentence-dot]');
    dots.forEach((dot, i) => {
      if (state.guidedListening.sentencesDone[i]) dot.dataset.state = 'done';
      else if (i === idx) dot.dataset.state = 'active';
      else dot.dataset.state = 'locked';
    });
  }

  function showGuidedQuestions(sentenceIndex) {
    const section = qs('#w1-guided-listening-phase');
    if (!section) return;
    const listener = section.querySelector('[data-guided-listener]');
    if (!listener) return;

    const norm = window.__guidedNorm;
    const allQuestions = norm?.questions ?? [];
    const sentenceQuestions = allQuestions.filter((q) => q.sentence_index === sentenceIndex);
    console.log('[R2L] showGuidedQuestions sentence=' + sentenceIndex, 'total=' + allQuestions.length, 'forSentence=' + sentenceQuestions.length);

    const qContainer = listener.querySelector('[data-guided-questions]');
    if (!qContainer) return;

    const sentences = (state.lesson?.story?.sentences || []).filter((sentence) => String(sentence?.text_en || sentence?.text || '').trim());

    if (sentenceQuestions.length === 0) {
      qContainer.innerHTML = '<p class="text-sm text-cream/60">Câu này chưa có câu hỏi. Con có thể bỏ qua nhé.</p>';
      return;
    }

    qContainer.innerHTML = '';
    sentenceQuestions.forEach((qData) => {
      const qId = qData.id;
      const qa = document.createElement('article');
      qa.className = 'r2l-activity r2l-guided-question';
      qa.dataset.guidedQuestion = '';
      qa.dataset.questionId = qId;
      qa.dataset.questionType = qData.type;
      qa.innerHTML = `
        <div class="r2l-guided-question__header">
          <p class="r2l-identity" data-question-identity></p>
          <p class="text-sm font-semibold text-cream r2l-guided-question__text" data-question-text></p>
        </div>
        <div class="r2l-guided-question__options mt-3 flex flex-wrap gap-2" data-question-options></div>
        <div class="r2l-guided-question__feedback mt-2 hidden text-sm text-cream/80" data-question-feedback></div>
      `;

      qa.querySelector('[data-question-text]').textContent = qData.question_en || qData.question_vi || '';

      const answerKey = `${sentenceIndex}:${qId}`;
      const existingAnswer = state.guidedListening.answers[answerKey];

      const optContainer = qa.querySelector('[data-question-options]');
      optContainer.innerHTML = qData.options_en.map((opt, optIdx) =>
        `<button type="button" class="r2l-guided-question__option" data-guided-option data-option-index="${optIdx}">${escapeHtml(opt)}</button>`
      ).join('');

      if (existingAnswer) {
        qa.dataset.state = existingAnswer.correct ? 'correct' : (existingAnswer.outcome === 'revealed' ? 'revealed' : '');
        optContainer.querySelectorAll('[data-guided-option]').forEach((opt) => {
          opt.disabled = true;
          const optIdx = Number(opt.dataset.optionIndex);
          if (optIdx === qData.correct_index) {
            opt.dataset.state = 'revealed';
          } else if (optIdx === existingAnswer.selectedIndex && !existingAnswer.correct) {
            opt.dataset.state = 'selected-wrong';
          } else {
            opt.dataset.state = '';
          }
        });
        const fb = qa.querySelector('[data-question-feedback]');
        if (existingAnswer.correct) {
          fb.textContent = 'Đúng rồi! 🎉';
        } else if (existingAnswer.outcome === 'revealed') {
          fb.textContent = `Đáp án đúng: ${qData.options_en[qData.correct_index] ?? ''}`;
        }
        fb.classList.remove('hidden');
      } else {
        qa.dataset.state = '';
        optContainer.querySelectorAll('[data-guided-option]').forEach((optBtn) => {
          optBtn.addEventListener('click', () => {
            const optIdx = Number(optBtn.dataset.optionIndex);
            const isCorrect = optIdx === qData.correct_index;

            const key = `${sentenceIndex}:${qId}`;
            const existing = state.guidedListening.answers[key];
            const prevAttempts = existing?.attempts ?? 0;

            const answer = {
              sentenceIndex,
              questionId: qId,
              selectedIndex: optIdx,
              correct: isCorrect,
              outcome: isCorrect ? (prevAttempts === 0 ? 'first_try' : 'second_try') : (prevAttempts >= 1 ? 'revealed' : 'second_try'),
              attempts: prevAttempts + 1,
            };
            state.guidedListening.answers[key] = answer;

            optContainer.querySelectorAll('[data-guided-option]').forEach((ob) => ob.disabled = true);
            if (isCorrect) {
              optBtn.dataset.state = 'selected-correct';
              qa.dataset.state = 'correct';
              qa.querySelector('[data-question-feedback]').textContent = 'Đúng rồi! 🎉';
              qa.querySelector('[data-question-feedback]').classList.remove('hidden');
            } else {
              optBtn.dataset.state = 'selected-wrong';
              if (answer.outcome === 'revealed') {
                qa.dataset.state = 'revealed';
                optContainer.querySelectorAll('[data-guided-option]').forEach((ob, i) => {
                  if (i === qData.correct_index) ob.dataset.state = 'revealed';
                });
                qa.querySelector('[data-question-feedback]').textContent = `Đáp án đúng: ${qData.options_en[qData.correct_index] ?? ''}`;
              } else {
                qa.dataset.state = '';
                qa.querySelector('[data-question-feedback]').textContent = 'Chưa đúng — thử lại!';
                setTimeout(() => {
                  optContainer.querySelectorAll('[data-guided-option]').forEach((ob) => ob.disabled = false);
                }, 600);
              }
              qa.querySelector('[data-question-feedback]').classList.remove('hidden');
            }

            checkSentenceCompletion(sentenceIndex, sentences);
            scheduleSaveLessonSession();
          });
        });
      }

      qContainer.appendChild(qa);
    });
  }

  function checkSentenceCompletion(sentenceIndex, sentences) {
    const section = qs('#w1-guided-listening-phase');
    if (!section) return;
    const listener = section.querySelector('[data-guided-listener]');
    if (!listener) return;

    const norm = window.__guidedNorm;
    const allQuestions = norm?.questions ?? [];
    const sentenceQuestions = allQuestions.filter((q) => q.sentence_index === sentenceIndex);
    if (sentenceQuestions.length === 0) return;

    const allAnswered = sentenceQuestions.every((q) => {
      const key = `${sentenceIndex}:${q.id}`;
      const answer = state.guidedListening.answers[key];
      return answer?.correct || answer?.outcome === 'revealed';
    });

    if (allAnswered && !state.guidedListening.sentencesDone[sentenceIndex]) {
      const done = state.guidedListening.sentencesDone.slice();
      done[sentenceIndex] = true;
      state.guidedListening.sentencesDone = done;
      state.guidedListening.phase = sentenceIndex >= sentences.length - 1 ? 'done' : 'idle';
      updateGuidedControls(sentences);
      scheduleSaveLessonSession();
      if (sentenceIndex < sentences.length - 1) {
        window.clearTimeout(guidedAdvanceTimer);
        guidedAdvanceTimer = window.setTimeout(() => advanceGuidedSentence(sentences), 700);
      }
    }
  }

  function advanceGuidedSentence(sentences) {
    stopLessonAudio();
    state.guidedListening.sentenceIndex = Math.min(state.guidedListening.sentenceIndex + 1, sentences.length - 1);
    state.guidedListening.phase = 'idle';
    const norm = window.__guidedNorm;
    updateGuidedSentenceView(sentences, norm?.questions ?? []);
    updateGuidedControls(sentences);
    scheduleSaveLessonSession();
  }

  function skipGuidedSentence(sentences) {
    const sentenceIndex = state.guidedListening.sentenceIndex;
    const done = state.guidedListening.sentencesDone.slice();
    done[sentenceIndex] = true;
    state.guidedListening.sentencesDone = done;
    if (sentenceIndex >= sentences.length - 1) {
      state.guidedListening.phase = 'done';
      updateGuidedControls(sentences);
      scheduleSaveLessonSession();
      return;
    }
    advanceGuidedSentence(sentences);
  }

  function updateGuidedControls(sentences) {
    const section = qs('#w1-guided-listening-phase');
    if (!section) return;
    const idx = state.guidedListening.sentenceIndex;
    const prevBtn = section.querySelector('[data-guided-prev]');
    const nextBtn = section.querySelector('[data-guided-next]');
    const isDone = state.guidedListening.sentencesDone[idx];

    if (prevBtn) prevBtn.hidden = true;

    if (nextBtn) {
      if (idx >= sentences.length - 1 && isDone) {
        nextBtn.textContent = 'Bắt đầu nhiệm vụ 🎯';
        nextBtn.disabled = false;
      } else if (isDone) {
        nextBtn.textContent = 'Đang chuyển sang câu tiếp...';
        nextBtn.disabled = true;
      } else {
        nextBtn.textContent = 'Bỏ qua câu này';
        nextBtn.setAttribute('aria-label', 'Bỏ qua câu này');
        nextBtn.disabled = false;
      }
    }

    const nav = section.querySelector('[data-guided-nav]');
    if (nav && !nav.dataset.delegated) {
      nav.dataset.delegated = '1';
      nav.addEventListener('click', (event) => {
        const nextEl = event.target.closest('[data-guided-next]');
        if (!nextEl || nextEl.disabled) return;
        const isLast = state.guidedListening.sentenceIndex >= sentences.length - 1;
        const currentDone = state.guidedListening.sentencesDone[state.guidedListening.sentenceIndex];
        if (isLast && currentDone) advanceToActivities();
        else skipGuidedSentence(sentences);
      });
    }

    const dots = section.querySelectorAll('[data-sentence-dot]');
    dots.forEach((dot, i) => {
      if (state.guidedListening.sentencesDone[i]) dot.dataset.state = 'done';
      else if (i === idx) dot.dataset.state = 'active';
      else dot.dataset.state = 'locked';
    });
  }

  function advanceToActivities() {
    state.w1Phase = 'activities';
    qs('#w1-guided-listening-phase')?.classList.add('hidden');
    qs('#w1-quest-path')?.classList.remove('hidden');
    qs('#global-cta')?.classList.remove('hidden');
    // Collect guided listening results
    const guidedAnswers = Object.values(state.guidedListening.answers);
    const correct = guidedAnswers.filter((a) => a.correct).length;
    const total = guidedAnswers.length;
    if (total > 0) {
      state.activityResults['guided_listening'] = {
        type: 'guided_listening',
        attempted: true,
        correct_count: correct,
        total_count: total,
        wrong_count: total - correct,
        question_outcomes: guidedAnswers.map((a) => ({
          id: a.questionId,
          outcome: a.outcome,
          attempts: a.attempts,
        })),
      };
    }
    w1EnsureHudStoryButton();
    showActivity(0);
    w1RenderQuestPath();
    saveLessonSession();
  }

  function w1RecordQuestionOutcome(activityType, questionId, outcome, attempts) {
    if (!isW1()) return;
    if (!state.questionOutcomes[activityType]) state.questionOutcomes[activityType] = {};
    state.questionOutcomes[activityType][questionId] = { outcome, attempts };
    scheduleSaveLessonSession();
  }

  function w1BuildQuestionOutcomesForSubmit(activityType) {
    const bucket = state.questionOutcomes[activityType];
    if (!bucket) return undefined;
    return Object.entries(bucket).map(([id, entry]) => ({
      id,
      outcome: entry.outcome,
      attempts: entry.attempts,
    }));
  }

  function w1MaybeMidpointCelebration(completedIndex) {
    if (!isW1() || state.w1MidpointCelebrated) return;
    const activities = state.lesson?.activities || [];
    if (activities.length < 2) return;
    const midpointType = activities[Math.ceil(activities.length / 2) - 1]?.type;
    const completedType = activities[completedIndex]?.type;
    if (completedType !== midpointType) return;
    state.w1MidpointCelebrated = true;
    setMinnyStrip('celebrate', 'Nửa đường rồi! Con giỏi lắm 🎉');
    window.__r2lJuice?.fireStreakConfetti?.();
    scheduleSaveLessonSession();
  }

  function w1CollectRecapItems() {
    const items = [];
    Object.entries(state.questionOutcomes).forEach(([activityType, questions]) => {
      Object.entries(questions || {}).forEach(([id, entry]) => {
        if (entry.outcome === 'first_try') return;
        items.push({ activityType, id, outcome: entry.outcome });
      });
    });
    return items;
  }

  function w1FindRecapMeta(activityType, questionId) {
    const activity = (state.lesson?.activities || []).find((a) => a.type === activityType);
    if (!activity) return null;
    if (activity.questions) {
      const q = activity.questions.find((item) => String(item.id || '') === String(questionId));
      if (!q) return null;
      const correct = q.options_en?.[q.correct_index] || '';
      return { question: q.question_en || q.question_vi, correct, explanation: q.explanation_vi || '' };
    }
    if (activity.items) {
      const item = activity.items.find((row) => String(row.id || '') === String(questionId));
      if (!item) return null;
      return {
        question: item.sentence_with_blank || item.original_sentence || 'Câu hỏi',
        correct: item.options_en?.[item.correct_index] || item.original_sentence || '',
        explanation: item.explanation_vi || item.translation_vi || '',
      };
    }
    return null;
  }

  function w1ShowResultRecap() {
    const section = qs('#w1-result-recap');
    if (!section || !isW1()) return;
    const items = w1CollectRecapItems();
    const intro = qs('#w1-recap-intro');
    const cards = qs('#w1-recap-cards');
    const skip = qs('#w1-recap-skip');
    if (!items.length) {
      if (intro) intro.textContent = 'Hoàn hảo! Không có gì cần ôn 🌟';
      if (cards) cards.innerHTML = '';
      if (skip) skip.classList.add('hidden');
      section.classList.remove('hidden');
      return;
    }
    if (intro) intro.textContent = 'Những câu con cần ôn lại:';
    let idx = 0;
    function renderCard() {
      const item = items[idx];
      const meta = w1FindRecapMeta(item.activityType, item.id);
      if (!meta) {
        idx += 1;
        if (idx < items.length) renderCard();
        else section.classList.add('hidden');
        return;
      }
      cards.innerHTML = `
        <article class="rounded-md border border-cream/10 bg-navy-950/45 p-4">
          <p class="font-bold text-cream">${escapeHtml(meta.question)}</p>
          <p class="mt-2 text-sm text-gold">Đáp án: ${escapeHtml(meta.correct)}</p>
          ${meta.explanation ? `<p class="mt-2 text-sm text-cream/75">${escapeHtml(meta.explanation)}</p>` : ''}
          <button id="w1-recap-understood" class="r2l-primary mt-4 w-full" type="button">Đã hiểu ✓</button>
        </article>
      `;
      qs('#w1-recap-understood')?.addEventListener('click', () => {
        idx += 1;
        if (idx < items.length) renderCard();
        else section.classList.add('hidden');
      }, { once: true });
    }
    if (skip) {
      skip.classList.remove('hidden');
      skip.onclick = () => section.classList.add('hidden');
    }
    section.classList.remove('hidden');
    renderCard();
  }

  function renderLesson(lesson) {
    console.log('[R2L] renderLesson guided_listening:', JSON.stringify(lesson.guided_listening?.length ?? 'missing'), 'activities:', (lesson.activities || []).map(a => a.type));
    lesson = ensureLessonActivities(lesson);
    state.lesson = lesson;
    qs('#loading-card').classList.add('hidden');
    qs('#lesson-shell').classList.remove('hidden');
    const studentName = lesson.student_name || '';
    if (studentName) {
      const banner = qs('#identity-student-name');
      if (banner) banner.textContent = studentName;
    }

    initStoryDock(lesson.story || {});
    _r2lUpdateMicPrepBanner(lesson.activities || []);
    qs('#mic-prep-dismiss')?.addEventListener('click', () => {
      try {
        sessionStorage.setItem('r2l_mic_prep_dismissed', '1');
      } catch {}
      qs('#mic-prep-banner')?.classList.add('hidden');
    });
    document.addEventListener('r2l-mic-gate', (event) => {
      if (event.detail?.ready) _r2lUpdateMicPrepBanner(state.lesson?.activities || []);
    });
    const resumed = restoreLessonSession();
    if (!isBookLesson()) renderAllActivitiesOnce(lesson.activities || []);
    configureActivityProgress();
    if (isW1()) {
      if (isBookLesson()) {
        if (!resumed || state.w1Phase !== 'result') state.w1Phase = 'book_reader';
        w1InitBookReaderPhase();
      } else {
        if (!resumed || state.w1Phase === 'story') {
          state.w1Phase = w1GateComplete() ? 'guided_listening' : 'story';
        }
        if (state.w1Phase === 'story') {
          w1InitStoryPhase();
        } else if (state.w1Phase === 'guided_listening') {
          w1InitGuidedListeningPhase();
        } else {
          w1EnterActivitiesPhase(resumed);
        }
      }
    } else {
      showActivity(resumed ? state.activityIndex : 0);
    }
    updateProgress();
    saveLessonSession();
    if (resumed) {
      showToast('Con tiếp tục bài đang làm — không cần làm lại từ đầu nhé!', 5000);
    }
    const pendingSubmit = loadPendingSubmit();
    const totalActivities = (state.lesson?.activities || []).length;
    if (pendingSubmit) {
      qs('#submit-hint').textContent = 'Lần trước chưa lưu xong. Minny đang gửi lại kết quả của con...';
      submitLesson({ trigger: 'auto', payload: pendingSubmit });
    } else if (resumed && !isBookLesson() && totalActivities > 0
        && state.completedTypes.size >= totalActivities) {
      // Everything was finished last visit but the save never started
      // (e.g. tab closed during the celebration) — finish the job now.
      _r2lScheduleAutoSubmit(600);
    }
  }

  function renderAllActivitiesOnce(activities) {
    activities.forEach((activity, index) => {
      const shell = qs(`[data-activity-shell="${activity.type}"]`);
      if (!shell) return;
      shell.querySelector('[data-activity-title]').textContent = activity.title_vi || ACTIVITY_LABELS[activity.type] || '';
      shell.querySelector('[data-activity-identity]').textContent = activity.identity_vi || '';
      shell.querySelector('[data-activity-instructions]').textContent = activity.instructions_vi || '';
      const body = shell.querySelector('[data-activity-body]');
      if (activity.type === 'listening_fill_blank') {
        renderFillBlankActivity(body, activity);
      } else if (activity.type === 'reading_comprehension') {
        renderMcqActivity(body, activity);
      } else if (activity.type === 'listen_and_order') {
        renderOrderActivity(body, activity);
      } else if (activity.type === 'listen_and_speak' || activity.type === 'read_aloud') {
        renderSpeakActivity(body, activity);
      }
    });
  }

  function initStoryDock(story) {
    const title = story?.title || 'Câu chuyện của con';
    qs('#dock-title').textContent = title;
    const firstParagraph = (story.paragraphs_en || [])[0] || '';
    qs('#dock-preview').textContent =
      firstParagraph.slice(0, 120) + (firstParagraph.length > 120 ? '…' : '');

    qs('#dock-paragraphs').innerHTML = (story.paragraphs_en || [])
      .map((p, i) => `<p data-paragraph-index="${i}">${escapeHtml(p)}</p>`)
      .join('');

    renderSentences(story.sentences || [], '#dock-sentences');

    qs('#dock-toggle')?.addEventListener('click', toggleDock);
    const playButton = qs('#dock-play-story');
    playButton?.addEventListener('click', () => {
      playAudio(state.lesson?.story?.full_audio_url || story.full_audio_url || '', playButton);
    });
    setStoryAudioButtonState(playButton, story.full_audio_url || '');
    if (!story.full_audio_url) {
      pollDeferredFullStoryAudio(playButton);
    }
  }

  function toggleDock() {
    const dock = qs('#story-dock');
    const expanded = qs('#dock-expanded');
    const toggle = qs('#dock-toggle');
    if (!dock || !expanded || !toggle) return;
    if (dock.dataset.dockState === 'collapsed') {
      dock.dataset.dockState = 'expanded';
      expanded.classList.remove('hidden');
      toggle.textContent = 'Thu gọn ▲';
    } else {
      dock.dataset.dockState = 'collapsed';
      expanded.classList.add('hidden');
      toggle.textContent = 'Mở truyện ▼';
    }
  }

  function highlightDockSentence(sentenceText) {
    qsa('#dock-paragraphs [data-highlight]').forEach((el) => el.removeAttribute('data-highlight'));
    if (!sentenceText) return;
    qsa('#dock-paragraphs p').forEach((p) => {
      const idx = p.textContent.indexOf(sentenceText);
      if (idx >= 0) {
        const before = p.textContent.slice(0, idx);
        const match = p.textContent.slice(idx, idx + sentenceText.length);
        const after = p.textContent.slice(idx + sentenceText.length);
        p.innerHTML = `${escapeHtml(before)}<mark data-highlight="true">${escapeHtml(match)}</mark>${escapeHtml(after)}`;
      }
    });
  }

  function renderSentences(sentences, containerSelector = '#dock-sentences') {
    const container = qs(containerSelector);
    if (!container) return;
    container.innerHTML = sentences
      .map(
        (sentence, index) => `
          <button class="r2l-sentence block w-full" type="button" data-sentence-index="${index}">
            <span class="block text-sm font-bold text-gold">Câu ${index + 1}</span>
            <span>${escapeHtml(sentence.text_en)}</span>
          </button>
        `,
      )
      .join('');

    container.querySelectorAll('[data-sentence-index]').forEach((button) => {
      const sentence = sentences[Number(button.dataset.sentenceIndex)];
      const url = sentence?.audio_url || '';
      setLessonPlayButtonState(button, url);
      button.addEventListener('click', () => {
        highlightDockSentence(sentence?.text_en || '');
        playAudio(url, button);
      });
    });
  }

  function showActivity(index) {
    const activities = state.lesson.activities || [];
    const maxIndex = Math.max(0, activities.length - 1);
    const nextIndex = Math.max(0, Math.min(index, maxIndex));
    if (isW1() && (state.w1Phase === 'story' || state.w1Phase === 'book_reader')) return;
    if (isW1() && nextIndex > state.w1MaxUnlocked && !state.completedTypes.has(activities[nextIndex]?.type)) {
      showToast('Xong nhiệm vụ này trước đã nha!');
      return;
    }
    if (nextIndex !== state.activityIndex) stopLessonAudio();
    state.activityIndex = nextIndex;
    qsa('[data-activity-shell]').forEach((shell) => {
      shell.hidden = true;
    });
    const activity = activities[state.activityIndex];
    if (!activity) return;

    const shell = qs(`[data-activity-shell="${activity.type}"]`);
    if (!shell) return;
    shell.hidden = false;

    qsa('[data-step-button]').forEach((button, buttonIndex) => {
      button.dataset.active = String(buttonIndex === state.activityIndex);
      const type = activities[buttonIndex]?.type;
      button.dataset.done = String(type && state.completedTypes.has(type));
      button.onclick = () => {
        if (buttonIndex === state.activityIndex) return;
        if (isW1()) {
          if (buttonIndex <= state.w1MaxUnlocked || (type && state.completedTypes.has(type))) {
            showActivity(buttonIndex);
          } else {
            showToast('Xong nhiệm vụ này trước đã nha!');
          }
          return;
        }
        if (type && state.completedTypes.has(type)) {
          showActivity(buttonIndex);
        }
      };
    });

    if (isW1()) w1RenderQuestPath();

    setMinnyStrip('idle', MINNY_COMMANDS[activity.type] || '');
    _itemStreak = 0;

    const useLargeMinny = activity.type === 'listen_and_speak' || activity.type === 'read_aloud';
    const minnyStrip = qs('#minny-strip');
    if (minnyStrip) minnyStrip.hidden = useLargeMinny;
    const heroWrap = shell.querySelector('.r2l-minny-hero-wrap');
    if (heroWrap) heroWrap.hidden = !useLargeMinny;

    updateParentStrip();
    updateProgress();
    updateGlobalCta();
    scheduleSaveLessonSession();

    if (activity.type === 'listen_and_speak' || activity.type === 'read_aloud') {
      _r2lMountMicCheck(shell);
      if (window.R2LMicCheck?.sessionPassed?.()) {
        _r2lApplyMicGate(true);
      } else {
        _r2lApplyMicGate(false);
        const panel = shell.querySelector('[data-r2l-mic-check]');
        if (panel && window.R2LMicCheck?.scrollToPanel) {
          window.setTimeout(() => window.R2LMicCheck.scrollToPanel(panel), 300);
        }
      }
    }
  }

  function updateGlobalCta() {
    const btn = qs('#lesson-continue');
    if (!btn) return;
    const activities = state.lesson?.activities || [];
    const current = activities[state.activityIndex];
    const currentType = current?.type;
    const isCurrentDone = currentType && state.completedTypes.has(currentType);
    const isLast = state.activityIndex >= activities.length - 1;
    const allDone = state.completedTypes.size >= activities.length;

    if (allDone) {
      if (submitInFlight || _r2lAutoSubmitArmed) {
        btn.textContent = 'Minny đang lưu chiến công...';
        btn.disabled = true;
      } else {
        btn.textContent = 'Lưu chiến công 💾';
        btn.disabled = false;
      }
    } else if (isCurrentDone && !isLast) {
      const nextActivity = activities[state.activityIndex + 1];
      const nextLabel = ACTIVITY_LABELS[nextActivity?.type] || 'bài tiếp';
      btn.textContent = `Phần tiếp: ${nextLabel} →`;
      btn.disabled = false;
    } else {
      btn.textContent = 'Tiếp tục →';
      btn.disabled = !isCurrentDone;
    }
  }

  function w1AppendStoryReviewLink(container) {
    if (!container || container.querySelector('[data-w1-story-link]')) return;
    const link = document.createElement('button');
    link.type = 'button';
    link.className = 'mt-2 text-sm font-bold text-accent underline';
    link.dataset.w1StoryLink = '1';
    link.textContent = '📖 Xem lại truyện';
    link.addEventListener('click', () => w1OpenStoryPanel());
    container.appendChild(link);
  }

  function w1McqWrongFeedback(root, itemIndex, selectorPrefix, isFirstWrong) {
    setMinnyStrip('encourage', 'Chưa đúng — con đọc lại truyện thử nhé!');
    const expl = root.querySelector(`[${selectorPrefix}="${itemIndex}"]`);
    if (isFirstWrong) w1AppendStoryReviewLink(expl);
    else if (expl) expl.classList.remove('hidden');
  }

  function renderFillBlankActivity(root, activity) {
    const MAX_WRONG_PER_ITEM = isW1() ? 2 : 3;
    root.innerHTML = `
      <div class="mt-5 space-y-5">
        ${(activity.items || [])
          .map(
            (item, itemIndex) => `
              <article class="rounded-md border border-cream/10 bg-navy-950/45 p-4">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <p class="font-bold text-cream">Câu ${itemIndex + 1}</p>
                  <button class="r2l-primary" type="button" data-play-fill="${itemIndex}">Nghe câu</button>
                </div>
                <p class="mt-3 text-lg font-bold text-cream">${escapeHtml(item.sentence_with_blank || '')}</p>
                <div class="mt-3 grid gap-2">
                  ${(item.options_en || [])
                    .map(
                      (option, optionIndex) => `
                        <button class="r2l-option" type="button" data-fill-item="${itemIndex}" data-option-index="${optionIndex}">
                          ${escapeHtml(option)}
                        </button>
                      `,
                    )
                    .join('')}
                </div>
                <p class="mt-2 hidden text-sm text-gold" data-fill-explanation="${itemIndex}">${escapeHtml(item.explanation_vi || '')}</p>
              </article>
            `,
          )
          .join('')}
      </div>
    `;

    const answered = new Set();
    const attempted = new Set();
    const itemWrongCounts = new Map();
    const buttonStates = {};
    let wrongCount = 0;

    function saveFillBlankProgress() {
      patchActivityProgress(activity.type, {
        attempted: Array.from(attempted),
        answered: Array.from(answered),
        wrong_count: wrongCount,
        button_states: buttonStates,
      });
    }

    const savedFill = state.activityProgress[activity.type];
    if (savedFill) {
      (savedFill.attempted || []).forEach((itemIndex) => attempted.add(itemIndex));
      (savedFill.answered || []).forEach((itemIndex) => answered.add(itemIndex));
      wrongCount = Number(savedFill.wrong_count || 0);
      Object.entries(savedFill.button_states || {}).forEach(([itemIndex, info]) => {
        buttonStates[itemIndex] = info;
        const btn = root.querySelector(
          `[data-fill-item="${itemIndex}"][data-option-index="${info.optionIndex}"]`,
