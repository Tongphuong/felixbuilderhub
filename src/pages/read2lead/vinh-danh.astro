---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Bảng thành tích | Read2Lead" childHome robots="noindex, nofollow">
  <main id="main" class="mx-auto w-full max-w-xl p-8">
    <h1 class="text-2xl font-bold">Mình xem những bước tiến tuần này nhé.</h1>
    <p class="mt-4">Thành tích và huy hiệu đã lưu của con vẫn còn.</p>
    <a id="honors-board" class="mt-6 inline-flex min-h-[48px] items-center rounded-xl bg-accent px-5 font-bold text-navy-950" href="/read2lead/leaderboard">Mở bảng thành tích →</a>
  </main>
</BaseLayout>
<script>
  import { leaderboardReturnPath } from '../../scripts/read2lead-speaking-redirect.mjs';
  let stored = '';
  try { stored = sessionStorage.getItem('r2l_access_code') || ''; } catch { /* optional */ }
  const target = leaderboardReturnPath(location.search, stored);
  (document.getElementById('honors-board') as HTMLAnchorElement).href = target;
  location.replace(target);
</script>
