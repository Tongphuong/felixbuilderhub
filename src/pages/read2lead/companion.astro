---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/read2lead-companion.css';
---
<BaseLayout title="Bạn đồng hành | Read2Lead" description="Chọn một người bạn cùng con đọc sách." robots="noindex, nofollow" childHome>
  <main id="main" class="companion-page r2l">
    <div class="cp-wrap">
      <div class="cp-top">
        <a id="companion-home" class="r2l-back" href="/read2lead" data-design="companion.back"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path d="M19 12H6M11 6l-6 6 6 6" stroke="#17324D" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>Về đọc sách</a>
        <header class="cp-head" data-design="companion.header"><div class="cp-title"><span class="r2l-lab">Góc của con</span><h1 class="r2l-d r2l-t-1">Bạn đồng hành</h1></div><p class="r2l-b-l">Chọn dáng con thích. Tất cả đều miễn phí.</p></header>
      </div>
      <p id="companion-message" class="r2l-b-m" role="status">Đang mở bạn đồng hành…</p>
      <button id="companion-retry" class="r2l-btn r2l-btn-sun r2l-btn-sm" type="button" hidden>Thử lại</button>
      <div id="companion-host"></div>
    </div>
  </main>
</BaseLayout>
<script src="../../scripts/read2lead-companion.ts"></script>
