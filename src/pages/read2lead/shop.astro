---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import KidButton from '../../components/read2lead/v4/KidButton.astro';
import KidCard from '../../components/read2lead/v4/KidCard.astro';
import CoinPill from '../../components/read2lead/v4/CoinPill.astro';
import KidModal from '../../components/read2lead/v4/KidModal.astro';
import KidToast from '../../components/read2lead/v4/KidToast.astro';
import '../../styles/r2l-kid.css';
import '@fontsource-variable/baloo-2/index.css';

const w1Ssr = import.meta.env.PUBLIC_R2L_W1 === '1';
const mainClass = w1Ssr
  ? 'r2l-kid flex-1 px-4 py-8 sm:px-6'
  : 'flex-1 bg-navy-950 px-4 py-8 sm:px-6';
---

<BaseLayout
  title="Cửa hàng Read2Lead | Felix Coaching"
  description="Dùng xu để mua đồ trang trí cho hồ sơ Read2Lead."
  robots="noindex, follow"
>
  <Header read2LeadState={false} kidMode={true} />

  <main id="main" class={mainClass}>
    <section class="mx-auto max-w-4xl">
      {w1Ssr ? (
        <>
          <p class="r2l-kid-eyebrow">Read2Lead</p>
          <h1 class="r2l-kid-title">Cửa hàng Minny</h1>
          <p class="r2l-kid-lead">Dùng xu kiếm được sau mỗi bài để mua đồ trang trí.</p>
        </>
      ) : (
        <>
          <p class="text-xs font-extrabold uppercase tracking-widest text-accent">Read2Lead V3</p>
          <h1 class="mt-2 font-display text-3xl font-extrabold text-cream">Cửa hàng Minny</h1>
          <p class="mt-2 text-sm text-cream-muted">Dùng xu kiếm được sau mỗi bài để mua đồ trang trí. Giá có thể chỉnh sau khi Phương review.</p>
        </>
      )}

      <div id="shop-gate" class:list={['mt-6 hidden', w1Ssr ? 'r2l-kid-card r2l-kid-muted' : 'rounded-2xl border border-cream/15 bg-navy-900/80 p-6 text-sm text-cream-muted']}>
        Cửa hàng chỉ mở khi bật chế độ V3 preview (<code>?v3=1</code>).
      </div>

      {w1Ssr ? (
        <div id="shop-entry" class="mt-6 hidden">
          <KidCard>
            <label for="shop-code" class="text-sm font-bold text-[var(--r2l-ink)]">Mã học sinh</label>
            <div class="mt-3 flex flex-col gap-3 sm:flex-row">
              <input id="shop-code" maxlength="40" autocomplete="off" placeholder="R2L-..." class="r2l-kid-input" />
              <KidButton id="shop-load" class="shrink-0">Vào cửa hàng</KidButton>
            </div>
          </KidCard>
        </div>
      ) : (
        <div id="shop-entry" class="mt-6 hidden rounded-2xl border border-cream/15 bg-navy-900/80 p-5">
          <label for="shop-code" class="text-sm font-semibold text-cream">Mã học sinh</label>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row">
            <input id="shop-code" maxlength="40" autocomplete="off" placeholder="R2L-..." class="min-h-[48px] w-full rounded-xl border border-cream/15 bg-navy-950 px-4 uppercase text-cream" />
            <button id="shop-load" type="button" data-r2l-kid-upgrade="primary" class="min-h-[48px] rounded-xl bg-accent px-6 font-extrabold text-navy-950">Vào cửa hàng</button>
          </div>
        </div>
      )}

      <div id="shop-error" class:list={['mt-4 hidden', w1Ssr ? 'r2l-kid-error' : 'rounded-xl border border-red-400/40 bg-red-500/10 px-4 py-3 text-sm text-red-200']}></div>

      <div id="shop-shell" class="mt-6 hidden space-y-6">
        {w1Ssr ? (
          <KidCard>
            <div class="r2l-kid-balance-row">
              <div>
                <p class="text-sm r2l-kid-muted">Số dư của con</p>
                <CoinPill id="shop-coins-pill" value={0} />
              </div>
              <a id="shop-profile-link" href="/hoc-sinh" class="r2l-kid-btn r2l-kid-btn--ghost r2l-kid-btn--md no-underline">← Về hồ sơ</a>
            </div>
          </KidCard>
        ) : (
          <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-gold/30 bg-gold/10 px-5 py-4">
            <div>
              <p class="text-sm text-cream-muted">Số dư của con</p>
              <p class="font-display text-3xl font-extrabold text-gold"><span id="shop-coins">0</span> 🪙</p>
            </div>
            <a id="shop-profile-link" href="/hoc-sinh" class="rounded-xl border border-cream/20 px-4 py-2 text-sm font-bold text-cream">← Về hồ sơ</a>
          </div>
        )}

        <p id="shop-minny" class:list={['hidden px-4 py-3 text-sm font-semibold', w1Ssr ? 'r2l-kid-card border-2 border-[var(--r2l-accent)] text-[var(--r2l-ink)]' : 'rounded-xl border border-accent/30 bg-accent/10 text-accent']}></p>

        {w1Ssr ? (
          <div id="shop-equipped">
            <KidCard>
              <p class="text-sm font-bold">Đang trang bị</p>
              <div id="shop-equipped-list" class="mt-2 flex flex-wrap gap-2 text-sm r2l-kid-muted"></div>
            </KidCard>
          </div>
        ) : (
          <div id="shop-equipped" class="rounded-2xl border border-cream/10 bg-navy-900/70 p-4">
            <p class="text-sm font-bold text-cream">Đang trang bị</p>
            <div id="shop-equipped-list" class="mt-2 flex flex-wrap gap-2 text-sm text-cream-muted"></div>
          </div>
        )}

        <div id="shop-grid" class="grid gap-4 sm:grid-cols-2"></div>
      </div>
    </section>
  </main>

  <Footer />
  {w1Ssr && <KidModal />}
  {w1Ssr && <KidToast />}
</BaseLayout>

<script>
  import { isV3Enabled, isW1Enabled } from '../../config/flags';
  import { applyW1PageShell, upgradeKidControls } from '../../scripts/r2l-w1-page';
  import { kidConfirm } from '../../scripts/r2l-kid-modal';
  import { kidToast } from '../../scripts/r2l-kid-toast';

  const w1 = isW1Enabled();
  if (w1) {
    applyW1PageShell();
    upgradeKidControls(document.getElementById('main'));
    if (!document.getElementById('r2l-kid-modal-root')) {
      import('../../scripts/r2l-kid-modal').then((m) => m.initKidModal());
    }
    if (!document.getElementById('r2l-kid-toast')) {
      import('../../scripts/r2l-kid-toast').then((m) => m.initKidToast());
    }
  }

  const qs = (sel) => document.querySelector(sel);
  let accessCode = '';
  let shopState = null;

  function kidBtnClass(variant = 'primary') {
    if (!w1) return variant === 'primary' ? 'rounded-lg bg-accent px-3 py-2 text-sm font-extrabold text-navy-950' : 'rounded-lg border border-accent px-3 py-2 text-sm font-bold text-accent';
    if (variant === 'ghost') return 'r2l-kid-btn r2l-kid-btn--ghost r2l-kid-btn--md';
    return 'r2l-kid-btn r2l-kid-btn--primary r2l-kid-btn--md';
  }

  function kidCardClass() {
    return w1 ? 'r2l-kid-card' : 'rounded-2xl border border-cream/10 bg-navy-900/80 p-4';
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function setShopCoins(value) {
    const legacy = qs('#shop-coins');
    if (legacy) legacy.textContent = String(value);
    const pill = qs('[data-r2l-coin-value]');
    if (pill) {
      pill.textContent = String(value);
      const wrap = pill.closest('.r2l-kid-coin-pill');
      if (wrap) {
        wrap.classList.add('is-bump');
        setTimeout(() => wrap.classList.remove('is-bump'), 400);
      }
    }
  }

  async function confirmBuy() {
    if (w1) {
      return kidConfirm({
        title: 'Mua đồ này?',
        body: 'Con muốn mua món này bằng xu?',
        okText: 'Mua nhé',
        cancelText: 'Để sau',
      });
    }
    return window.confirm('Con muốn mua món này bằng xu?');
  }

  async function shopRequest(action, extra = {}) {
    const response = await fetch('/api/read2lead-shop', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ access_code: accessCode, action, ...extra }),
    });
    const payload = await response.json();
    if (!payload.ok) throw new Error(payload.message || 'Không thể thực hiện.');
    shopState = payload.read2lead_state;
    if (payload.minny_message_vi) {
      const minny = qs('#shop-minny');
      if (minny) {
        minny.textContent = payload.minny_message_vi;
        minny.classList.remove('hidden');
      }
      if (w1) kidToast(payload.minny_message_vi);
    }
    renderShop();
    return payload;
  }

  function renderEquipped() {
    const list = qs('#shop-equipped-list');
    if (!list || !shopState) return;
    const equipped = shopState.equipped_display || [];
    const chipClass = w1
      ? 'rounded-lg border-2 border-[rgb(30_42_74/0.12)] bg-[var(--r2l-bg)] px-3 py-1'
      : 'rounded-lg border border-cream/15 bg-navy-950 px-3 py-1';
    list.innerHTML = equipped.length
      ? equipped.map((item) => `<span class="${chipClass}">${escapeHtml(item.emoji)} ${escapeHtml(item.name_vi)}</span>`).join('')
      : 'Chưa trang bị gì — mua và bấm Trang bị nhé!';
  }

  function renderShop() {
    if (!shopState) return;
    setShopCoins(shopState.coins || 0);
    renderEquipped();
    const grid = qs('#shop-grid');
    const inventory = new Set(shopState.inventory || []);
    const equipped = shopState.equipped || {};
    const catalog = shopState.shop_catalog || [];
    grid.innerHTML = catalog.map((item) => {
      const owned = inventory.has(item.id);
      const isEquipped = equipped[item.slot] === item.id;
      const priceClass = w1 ? 'r2l-kid-shop-price' : 'rounded-lg bg-gold/15 px-2 py-1 text-sm font-bold text-gold';
      return `
        <article class="${kidCardClass()}">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-3xl">${escapeHtml(item.emoji)}</p>
              <h2 class="mt-2 text-lg font-extrabold ${w1 ? '' : 'font-display text-cream'}">${escapeHtml(item.name_vi)}</h2>
              <p class="mt-1 text-xs uppercase tracking-wide ${w1 ? 'r2l-kid-muted' : 'text-cream-muted'}">${escapeHtml(item.slot)}</p>
            </div>
            <p class="${priceClass}">${item.price_coins} 🪙</p>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            ${
              owned
                ? `<button type="button" data-equip="${escapeHtml(item.id)}" class="${kidBtnClass('ghost')}">${isEquipped ? 'Đang dùng' : 'Trang bị'}</button>
                   ${isEquipped ? `<button type="button" data-unequip="${escapeHtml(item.slot)}" class="${kidBtnClass('ghost')}">Gỡ</button>` : ''}`
                : `<button type="button" data-buy="${escapeHtml(item.id)}" class="${kidBtnClass('primary')}">Mua</button>`
            }
          </div>
        </article>
      `;
    }).join('');

    grid.querySelectorAll('[data-buy]').forEach((button) => {
      button.addEventListener('click', async () => {
        if (!(await confirmBuy())) return;
        const buyBtn = button;
        const originalText = buyBtn.textContent;
        buyBtn.disabled = true;
        buyBtn.textContent = 'Đang mua…';
        try {
          await shopRequest('buy', { item_id: button.dataset.buy });
        } catch (error) {
          buyBtn.disabled = false;
          buyBtn.textContent = originalText;
          qs('#shop-error').textContent = error.message;
          qs('#shop-error').classList.remove('hidden');
        }
      });
    });
    grid.querySelectorAll('[data-equip]').forEach((button) => {
      button.addEventListener('click', async () => {
        try {
          await shopRequest('equip', { item_id: button.dataset.equip });
        } catch (error) {
          qs('#shop-error').textContent = error.message;
          qs('#shop-error').classList.remove('hidden');
        }
      });
    });
    grid.querySelectorAll('[data-unequip]').forEach((button) => {
      button.addEventListener('click', async () => {
        try {
          await shopRequest('unequip', { slot: button.dataset.unequip });
        } catch (error) {
          qs('#shop-error').textContent = error.message;
          qs('#shop-error').classList.remove('hidden');
        }
      });
    });
  }

  async function loadShop() {
    accessCode = (qs('#shop-code').value || '').trim().toUpperCase();
    if (!accessCode) return;
    qs('#shop-error').classList.add('hidden');
    const payload = await shopRequest('list');
    shopState = payload.read2lead_state;
    qs('#shop-shell').classList.remove('hidden');
    qs('#shop-profile-link').href = `/hoc-sinh?code=${encodeURIComponent(accessCode)}&v3=1`;
    renderShop();
  }

  if (!isV3Enabled()) {
    qs('#shop-gate').classList.remove('hidden');
  } else {
    qs('#shop-entry').classList.remove('hidden');
    const params = new URLSearchParams(window.location.search);
    const code = (params.get('code') || '').trim().toUpperCase();
    if (code) {
      qs('#shop-code').value = code;
      loadShop().catch((error) => {
        qs('#shop-error').textContent = error.message;
        qs('#shop-error').classList.remove('hidden');
      });
    }
  }

  qs('#shop-load')?.addEventListener('click', () => {
    loadShop().catch((error) => {
      qs('#shop-error').textContent = error.message;
      qs('#shop-error').classList.remove('hidden');
    });
  });
</script>

<style>
  .r2l-shop-name-gold { color: #ffd700; }
  .r2l-shop-name-ocean { color: #4fd1c5; }
  .r2l-shop-frame-gold { box-shadow: 0 0 0 3px #ffd700; border-radius: 9999px; }
  .r2l-shop-frame-rainbow { box-shadow: 0 0 0 3px #a855f7; border-radius: 9999px; }
</style>
