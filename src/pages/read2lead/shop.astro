---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import KidButton from '../../components/read2lead/v4/KidButton.astro';
import KidCard from '../../components/read2lead/v4/KidCard.astro';
import CoinPill from '../../components/read2lead/v4/CoinPill.astro';
import KidModal from '../../components/read2lead/v4/KidModal.astro';
import KidToast from '../../components/read2lead/v4/KidToast.astro';
import '../../styles/r2l-kid.css';
import '@fontsource-variable/baloo-2/index.css';

const w1Ssr = import.meta.env.PUBLIC_R2L_W1 === '1';
const mainClass = w1Ssr
  ? 'r2l-kid flex-1 px-4 py-8 sm:px-6'
  : 'flex-1 bg-navy-950 px-4 py-8 sm:px-6';
---

<BaseLayout
  title="Cửa hàng Read2Lead | Felix Coaching"
  description="Dùng xu để mua đồ trang trí cho hồ sơ Read2Lead."
  robots="noindex, follow"
>
  <Header read2LeadState={false} kidMode={true} />

  <main id="main" class={mainClass}>
    <section class="mx-auto max-w-4xl">
      {w1Ssr ? (
        <>
          <p class="r2l-kid-eyebrow">Read2Lead</p>
          <h1 class="r2l-kid-title">Cửa hàng Minny</h1>
          <p class="r2l-kid-lead">Dùng xu kiếm được sau mỗi bài để mua đồ trang trí.</p>
        </>
      ) : (
        <>
          <p class="text-xs font-extrabold uppercase tracking-widest text-accent">Read2Lead V3</p>
          <h1 class="mt-2 font-display text-3xl font-extrabold text-cream">Cửa hàng Minny</h1>
          <p class="mt-2 text-sm text-cream-muted">Dùng xu kiếm được sau mỗi bài để mua đồ trang trí. Giá có thể chỉnh sau khi Phương review.</p>
        </>
      )}

      <div id="shop-gate" class:list={['mt-6 hidden', w1Ssr ? 'r2l-kid-card r2l-kid-muted' : 'rounded-2xl border border-cream/15 bg-navy-900/80 p-6 text-sm text-cream-muted']}>
        Cửa hàng chỉ mở khi bật chế độ V3 preview (<code>?v3=1</code>).
      </div>

      {w1Ssr ? (
        <div id="shop-entry" class="mt-6 hidden">
          <KidCard>
            <label for="shop-code" class="text-sm font-bold text-[var(--r2l-ink)]">Mã học sinh</label>
            <div class="mt-3 flex flex-col gap-3 sm:flex-row">
              <input id="shop-code" maxlength="40" autocomplete="off" placeholder="R2L-..." class="r2l-kid-input" />
              <KidButton id="shop-load" class="shrink-0">Vào cửa hàng</KidButton>
            </div>
          </KidCard>
        </div>
      ) : (
        <div id="shop-entry" class="mt-6 hidden rounded-2xl border border-cream/15 bg-navy-900/80 p-5">
          <label for="shop-code" class="text-sm font-semibold text-cream">Mã học sinh</label>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row">
            <input id="shop-code" maxlength="40" autocomplete="off" placeholder="R2L-..." class="min-h-[48px] w-full rounded-xl border border-cream/15 bg-navy-950 px-4 uppercase text-cream" />
            <button id="shop-load" type="button" data-r2l-kid-upgrade="primary" class="min-h-[48px] rounded-xl bg-accent px-6 font-extrabold text-navy-950">Vào cửa hàng</button>
          </div>
        </div>
      )}

      <div id="shop-error" class:list={['mt-4 hidden', w1Ssr ? 'r2l-kid-error' : 'rounded-xl border border-red-400/40 bg-red-500/10 px-4 py-3 text-sm text-red-200']}></div>

      <div id="shop-shell" class="mt-6 hidden space-y-6">
        {w1Ssr ? (
          <KidCard>
            <div class="r2l-kid-balance-row">
              <div>
                <p class="text-sm r2l-kid-muted">Số dư của con</p>
                <CoinPill id="shop-coins-pill" value={0} />
              </div>
              <a id="shop-profile-link" href="/hoc-sinh" class="r2l-kid-btn r2l-kid-btn--ghost r2l-kid-btn--md no-underline">← Về hồ sơ</a>
            </div>
          </KidCard>
        ) : (
          <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-gold/30 bg-gold/10 px-5 py-4">
            <div>
              <p class="text-sm text-cream-muted">Số dư của con</p>
              <p class="font-display text-3xl font-extrabold text-gold"><span id="shop-coins">0</span> 🪙</p>
            </div>
            <a id="shop-profile-link" href="/hoc-sinh" class="rounded-xl border border-cream/20 px-4 py-2 text-sm font-bold text-cream">← Về hồ sơ</a>
          </div>
        )}

        <p id="shop-minny" class:list={['hidden px-4 py-3 text-sm font-semibold', w1Ssr ? 'r2l-kid-card border-2 border-[var(--r2l-accent)] text-[var(--r2l-ink)]' : 'rounded-xl border border-accent/30 bg-accent/10 text-accent']}></p>

        <div id="shop-grid" class="w2-shop-host"></div>
      </div>
    </section>
  </main>

  <Footer />
  {w1Ssr && <KidModal />}
  {w1Ssr && <KidToast />}
</BaseLayout>

<script>
  import { isV3Enabled, isW1Enabled } from '../../config/flags';
  import { applyW1PageShell, upgradeKidControls } from '../../scripts/r2l-w1-page';
  import { kidConfirm } from '../../scripts/r2l-kid-modal';
  import { kidToast } from '../../scripts/r2l-kid-toast';

  const w1 = isW1Enabled();
  if (w1) {
    applyW1PageShell();
    upgradeKidControls(document.getElementById('main'));
    if (!document.getElementById('r2l-kid-modal-root')) {
      import('../../scripts/r2l-kid-modal').then((m) => m.initKidModal());
    }
    if (!document.getElementById('r2l-kid-toast')) {
      import('../../scripts/r2l-kid-toast').then((m) => m.initKidToast());
    }
  }

  const qs = (sel) => document.querySelector(sel);
  let accessCode = '';
  let shopItems = [];
  let shopCoins = 0;

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function setShopCoins(value) {
    shopCoins = Number(value) || 0;
    const legacy = qs('#shop-coins');
    if (legacy) legacy.textContent = String(shopCoins);
    const pill = qs('[data-r2l-coin-value]');
    if (pill) {
      pill.textContent = String(shopCoins);
      const wrap = pill.closest('.r2l-kid-coin-pill');
      if (wrap) {
        wrap.classList.add('is-bump');
        setTimeout(() => wrap.classList.remove('is-bump'), 400);
      }
    }
  }

  async function confirmBuy() {
    if (w1) {
      return kidConfirm({
        title: 'Mua phụ kiện này?',
        body: 'Con muốn mua phần này bằng xu?',
        okText: 'Mua nhé',
        cancelText: 'Để sau',
      });
    }
    return window.confirm('Con muốn mua phần này bằng xu?');
  }

  function showShopError(message) {
    const errorEl = qs('#shop-error');
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    if (w1) kidToast(message);
  }

  function renderShopItem(item) {
    const owned = item.owned;
    const afford = item.can_afford;
    return `
      <article class="w2-shop-item" data-part-id="${escapeHtml(item.id)}" data-rarity="${escapeHtml(item.rarity)}" data-owned="${owned}">
        <div class="w2-shop-thumb" aria-hidden="true"></div>
        <div class="w2-shop-body">
          <h3 class="w2-shop-name">${escapeHtml(item.name)}</h3>
          <p class="w2-shop-price">🪙 ${item.price}</p>
        </div>
        ${
          owned
            ? '<span class="w2-shop-owned">✓ Có rồi</span>'
            : `<button class="w2-shop-buy" type="button" data-buy-part="${escapeHtml(item.id)}" ${afford ? '' : 'disabled'}>Mua</button>`
        }
      </article>
    `;
  }

  function renderShopRow(title, items) {
    if (!items.length) return '';
    return `
      <div class="w2-shop-row" data-rarity-group="${escapeHtml(items[0].rarity)}">
        <h2 class="w2-shop-row-title">${escapeHtml(title)}</h2>
        <div class="w2-shop-row-items">
          ${items.map(renderShopItem).join('')}
        </div>
      </div>
    `;
  }

  function renderShop() {
    const grid = qs('#shop-grid');
    if (!grid) return;
    const rare = shopItems.filter((item) => item.rarity === 'rare');
    const epic = shopItems.filter((item) => item.rarity === 'epic');
    grid.innerHTML = `
      <section class="w2-shop-grid" aria-label="Cửa hàng phụ kiện">
        ${renderShopRow('Hiếm ⭐', rare)}
        ${renderShopRow('Cực hiếm ✨', epic)}
        ${shopItems.length === 0 ? '<p class="w2-shop-empty">Đang tải cửa hàng…</p>' : ''}
      </section>
    `;

    grid.querySelectorAll('[data-buy-part]').forEach((button) => {
      button.addEventListener('click', async () => {
        if (!(await confirmBuy())) return;
        const buyBtn = button;
        const originalText = buyBtn.textContent;
        buyBtn.disabled = true;
        buyBtn.textContent = 'Đang mua…';
        try {
          const response = await fetch('/api/read2lead-shop-buy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: accessCode, part_id: buyBtn.dataset.buyPart }),
          });
          const payload = await response.json();
          if (!payload.ok) throw new Error(payload.message || 'Không thể mua.');
          setShopCoins(payload.coins);
          shopItems = shopItems.map((item) => {
            if (item.id !== payload.reward?.part_id) return item;
            return { ...item, owned: true, can_afford: false };
          });
          const minny = qs('#shop-minny');
          if (minny) {
            minny.textContent = `Minny thích phụ kiện mới của con! 🎉`;
            minny.classList.remove('hidden');
          }
          if (w1) kidToast('Mua thành công! Phụ kiện đã vào tủ của con.');
          qs('#shop-error')?.classList.add('hidden');
          renderShop();
        } catch (error) {
          buyBtn.disabled = false;
          buyBtn.textContent = originalText;
          const message = error instanceof Error ? error.message : 'Không thể mua.';
          showShopError(message);
        }
      });
    });
  }

  async function loadShop() {
    accessCode = (qs('#shop-code').value || '').trim().toUpperCase();
    if (!accessCode) return;
    qs('#shop-error')?.classList.add('hidden');

    const response = await fetch('/api/read2lead-shop-list', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: accessCode }),
    });
    const payload = await response.json();
    if (!payload.ok) throw new Error(payload.message || 'Không thể mở cửa hàng.');

    shopItems = payload.items || [];
    setShopCoins(payload.coins || 0);
    qs('#shop-shell')?.classList.remove('hidden');
    const profileLink = qs('#shop-profile-link');
    if (profileLink) profileLink.href = `/hoc-sinh?code=${encodeURIComponent(accessCode)}&v3=1`;
    renderShop();
  }

  if (!isV3Enabled()) {
    qs('#shop-gate').classList.remove('hidden');
  } else {
    qs('#shop-entry').classList.remove('hidden');
    const params = new URLSearchParams(window.location.search);
    const code = (params.get('code') || '').trim().toUpperCase();
    if (code) {
      qs('#shop-code').value = code;
      loadShop().catch((error) => {
        const message = error instanceof Error ? error.message : 'Không thể mở cửa hàng.';
        qs('#shop-error').textContent = message;
        qs('#shop-error').classList.remove('hidden');
      });
    }
  }

  qs('#shop-load')?.addEventListener('click', () => {
    loadShop().catch((error) => {
      const message = error instanceof Error ? error.message : 'Không thể mở cửa hàng.';
      qs('#shop-error').textContent = message;
      qs('#shop-error').classList.remove('hidden');
    });
  });
</script>

<style>
  .w2-shop-host :global(.w2-shop-grid) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: var(--r2l-font-display, 'Baloo 2 Variable', system-ui, sans-serif);
  }

  .w2-shop-host :global(.w2-shop-row-title) {
    color: #f8fafc;
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 0.65rem;
  }

  .w2-shop-host :global(.w2-shop-row-items) {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  .w2-shop-host :global(.w2-shop-item) {
    align-items: center;
    background: #0f172a;
    border: 2px solid rgb(255 255 255 / 0.12);
    border-radius: var(--r2l-radius-sm, 12px);
    color: #f8fafc;
    display: flex;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.75rem;
  }

  .w2-shop-host :global(.w2-shop-item[data-rarity='rare']) {
    border-color: #60a5fa;
  }

  .w2-shop-host :global(.w2-shop-item[data-rarity='epic']) {
    border-color: #fbbf24;
  }

  .w2-shop-host :global(.w2-shop-thumb) {
    background: linear-gradient(135deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.18));
    border-radius: 10px;
    flex-shrink: 0;
    height: 52px;
    width: 52px;
  }

  .w2-shop-host :global(.w2-shop-body) {
    flex: 1;
    min-width: 0;
  }

  .w2-shop-host :global(.w2-shop-name) {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }

  .w2-shop-host :global(.w2-shop-price) {
    color: var(--r2l-sun, #ffc83d);
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0.2rem 0 0;
  }

  .w2-shop-host :global(.w2-shop-buy) {
    background: var(--r2l-sun, #ffc83d);
    border: none;
    border-radius: var(--r2l-radius-sm, 12px);
    color: var(--r2l-ink, #1e2a4a);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 800;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.9rem;
  }

  .w2-shop-host :global(.w2-shop-buy:disabled) {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .w2-shop-host :global(.w2-shop-owned) {
    align-items: center;
    color: var(--r2l-mint, #34d399);
    display: inline-flex;
    font-size: 0.9rem;
    font-weight: 700;
    min-height: 44px;
  }

  .w2-shop-host :global(.w2-shop-empty) {
    color: rgb(248 250 252 / 0.75);
    margin: 0;
    min-height: 44px;
  }

  @media (min-width: 640px) {
    .w2-shop-host :global(.w2-shop-row-items) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
