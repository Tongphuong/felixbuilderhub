---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InsufficientCoinsModal from '../../components/read2lead/v4/InsufficientCoinsModal.astro';
import UnlockCelebration from '../../components/read2lead/v4/UnlockCelebration.astro';
import '../../styles/r2l-w6-tiers.css';
---

<BaseLayout
  title="Cửa hàng Read2Lead | Felix Coaching"
  description="Dùng kim cương để mua phụ kiện quái vật."
  robots="noindex, follow"
>
  <Header read2LeadState={false} />

  <main id="main" class="flex-1 bg-navy-950 px-4 py-8 sm:px-6">
    <section class="mx-auto max-w-4xl">
      <p class="text-xs font-extrabold uppercase tracking-widest text-accent">Read2Lead</p>
      <h1 class="mt-2 font-display text-3xl font-extrabold text-cream">Cửa hàng Minny</h1>
      <p class="mt-2 text-sm text-cream-muted">💎 Mua phụ kiện bằng kim cương học bài.</p>
      <a href="/read2lead/gifts" class="mt-1 inline-block text-sm font-semibold text-accent underline-offset-2 hover:underline">🎁 Con cũng có thể đổi kim cương lấy quà thật</a>

      <div id="shop-entry" class="mt-6 rounded-2xl border border-cream/15 bg-navy-900/80 p-5">
        <label for="shop-code" class="text-sm font-semibold text-cream">Mã học sinh</label>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row">
          <input id="shop-code" maxlength="40" autocomplete="off" placeholder="R2L-..." class="min-h-[64px] w-full rounded-xl border border-cream/15 bg-navy-950 px-4 uppercase text-cream" />
          <button id="shop-load" type="button" data-r2l-kid-upgrade="primary" class="min-h-[64px] rounded-xl bg-accent px-6 font-extrabold text-navy-950">Vào cửa hàng</button>
        </div>
      </div>

      <div id="shop-error" class="mt-4 hidden rounded-xl border border-red-400/40 bg-red-500/10 px-4 py-3 text-sm text-red-200"></div>

      <div id="shop-shell" class="mt-6 hidden space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-gold/30 bg-gold/10 px-5 py-4">
          <div>
            <!-- R2L Rewards Redesign: label + gold emphasis match the live
                 "Quà thật" gift shop's established 💎 display convention
                 (gifts.astro / GiftConfirmModal / GiftSuccessModal all use
                 "Kim cương của con" + var(--gold-light)) — one visual
                 language across both diamond shops, not a second one. -->
            <p class="text-sm text-cream-muted">Kim cương của con</p>
            <p class="font-display text-3xl font-extrabold text-gold">💎 <span id="shop-diamonds">0</span></p>
          </div>
          <a id="shop-profile-link" href="/ho-so" class="min-h-[64px] rounded-xl border border-cream/20 px-4 py-2 text-sm font-bold text-cream inline-flex items-center">← Về hồ sơ</a>
        </div>

        <p id="shop-minny" class="hidden rounded-xl border border-accent/30 bg-accent/10 px-4 py-3 text-sm font-semibold text-accent"></p>

        <div id="shop-grid" class="shop-host"></div>
      </div>
    </section>
  </main>

  <InsufficientCoinsModal coins_needed={0} current_coins={0} />
  <UnlockCelebration part_name="" rarity="rare" />

  <Footer />
</BaseLayout>

<script>
  import { initShopPage } from "../../lib/shop-ux";

  /** @param {string} sel */
  const qs = (sel) => document.querySelector(sel);

  async function confirmBuy() {
    return window.confirm("Con dùng kim cương mua món này nhé?");
  }

  /** @param {string} message */
  function showShopError(message) {
    const errorEl = qs("#shop-error");
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  }

  // Linking work (founder decision): the ?v3=1 preview gate is removed — the
  // shop opens for everyone, just like /read2lead/gifts already does. Kids
  // must be able to find it, and a test-flag wall was in the way.
  initShopPage({ confirmBuy, onError: showShopError });
</script>

<style>
  .shop-host :global(.shop-grid) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: var(--r2l-font-display, 'Baloo 2 Variable', system-ui, sans-serif);
  }

  .shop-host :global(.shop-section-header) {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 0.65rem;
  }

  .shop-host :global(.shop-section-header h2) {
    color: #f8fafc;
    font-size: 1.05rem;
    font-weight: 800;
    margin: 0;
  }

  .shop-host :global(.shop-section-items) {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  .shop-host :global(.shop-item) {
    background: #0f172a;
    border-radius: var(--r2l-radius-sm, 12px);
    color: #f8fafc;
    display: grid;
    gap: 0.5rem;
    min-height: 80px;
    padding: 0.75rem;
  }

  .shop-host :global(.shop-item[data-rarity='rare']) {
    border: 2px solid var(--w6-rare);
    box-shadow: 0 0 0.75rem color-mix(in srgb, var(--w6-rare) 48%, transparent);
    animation: w6-rare-glow 2s ease-in-out infinite;
  }

  .shop-host :global(.shop-item[data-rarity='epic']) {
    border: 3px solid var(--w6-epic);
    box-shadow: 0 0 1rem color-mix(in srgb, var(--w6-epic) 58%, transparent);
    animation: w6-epic-ripple 2.4s ease-in-out infinite;
  }

  .shop-host :global(.shop-item[data-rarity='epic'] .shop-item-art img),
  .shop-host :global(.shop-item[data-rarity='epic'] .shop-item-placeholder) {
    animation: w6-epic-shimmer 6s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-host :global(.shop-item[data-rarity='rare']),
    .shop-host :global(.shop-item[data-rarity='epic']),
    .shop-host :global(.shop-item[data-rarity='epic'] .shop-item-art img),
    .shop-host :global(.shop-item[data-rarity='epic'] .shop-item-placeholder) {
      animation: none;
    }
  }

  .shop-host :global(.shop-item[data-owned='true']) {
    border-color: var(--r2l-mint, #34d399);
  }

  .shop-host :global(.shop-item[data-can-afford='false']:not([data-owned='true'])) {
    opacity: 0.5;
  }

  .shop-host :global(.shop-item-art) {
    align-items: flex-start;
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
  }

  .shop-host :global(.shop-item-art img),
  .shop-host :global(.shop-item-placeholder) {
    background: rgb(255 255 255 / 0.08);
    border-radius: 12px;
    height: 72px;
    object-fit: contain;
    width: 72px;
  }

  /* Force cosmetic SVG silhouettes to white on dark shop card (bypasses CDN cache of black SVGs) */
  .shop-host :global(.shop-item-art img[src*="cosmetics/hat"]),
  .shop-host :global(.shop-item-art img[src*="cosmetics/pet"]) {
    filter: brightness(0) invert(1);
  }

  .shop-host :global(.shop-item-placeholder) {
    align-items: center;
    display: flex;
    font-size: 1.75rem;
    justify-content: center;
  }

  .shop-host :global(.shop-item-name) {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }

  .shop-host :global(.shop-item-buy) {
    align-items: center;
    background: var(--r2l-sun, #ffc83d);
    border: none;
    border-radius: var(--r2l-radius-sm, 12px);
    color: var(--r2l-ink, #1e2a4a);
    cursor: pointer;
    display: inline-flex;
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 800;
    gap: 0.35rem;
    min-height: 64px;
    min-width: 64px;
    padding: 0.55rem 1rem;
  }

  .shop-host :global(.shop-item-buy:disabled) {
    background: rgb(255 255 255 / 0.12);
    color: #f87171;
    cursor: not-allowed;
  }

  /* Silver+ rank: every item is free (SPEC_R2L_REWARDS_REDESIGN §3.2) — the
     buy button becomes a mint "Nhận miễn phí" pill instead of the gold 💎
     price pill, so kids can tell at a glance which items cost nothing. */
  .shop-host :global(.shop-item[data-free='true'] .shop-item-buy) {
    background: var(--r2l-mint, #34d399);
    color: var(--r2l-ink, #1e2a4a);
  }

  .shop-host :global(.shop-item-free-label) {
    font-size: 0.95rem;
  }

  .shop-host :global(.shop-item-owned) {
    align-items: center;
    color: var(--r2l-mint, #34d399);
    display: inline-flex;
    font-size: 1rem;
    font-weight: 800;
    gap: 0.35rem;
    min-height: 64px;
  }

  .shop-host :global(.r-badge) {
    align-items: center;
    background: color-mix(in srgb, var(--badge-color) 18%, #0f172a);
    border: 2px solid var(--badge-color);
    border-radius: 999px;
    color: #f8fafc;
    display: inline-flex;
    font-weight: 800;
    gap: 0.25rem;
    min-height: 44px;
    padding: 0.35rem 0.7rem;
  }

  .shop-host :global(.r-badge-large) {
    font-size: 1rem;
    min-height: 64px;
    padding: 0.5rem 1rem;
  }

  .shop-host :global(.r-badge-small) {
    font-size: 0.8rem;
  }

  .shop-host :global(.r-badge[data-rarity='epic']) {
    box-shadow: 0 0 14px color-mix(in srgb, var(--badge-color) 55%, transparent);
  }

  .shop-host :global(.shop-grid-empty) {
    color: rgb(248 250 252 / 0.75);
    margin: 0;
    min-height: 64px;
  }

  @media (min-width: 640px) {
    .shop-host :global(.shop-section-items) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
