---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Bạn đồng hành | Read2Lead" robots="noindex, nofollow" childHome>
  <main id="main" class="p-8"><h1>Bạn đồng hành giờ hoàn toàn miễn phí.</h1><a id="companion-redirect" href="/read2lead/companion">Chọn bạn đồng hành →</a></main>
</BaseLayout>
<script>
  const params = new URLSearchParams(location.search);
  const target = new URL('/read2lead/companion', location.origin);
  if (params.has('t')) target.searchParams.set('t', params.get('t') || '');
  else if (params.has('code')) target.searchParams.set('code', params.get('code') || '');
  (document.getElementById('companion-redirect') as HTMLAnchorElement).href = target.href;
  location.replace(target.href);
</script>
