---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Bảng Vinh Danh Felixar | Read2Lead"
  description="Bảng vinh danh Read2Lead: xem học sinh đã hoàn thành bao nhiêu bài, có bao nhiêu sao và đang ở rank nào trong Felixar."
>
  <Header />

  <main id="main" class="flex-1">
    <section class="relative overflow-hidden px-6 py-16 text-center md:py-24">
      <div class="absolute inset-0 opacity-30" aria-hidden="true">
        <div class="absolute left-[12%] top-12 h-1 w-1 rounded-full bg-gold"></div>
        <div class="absolute left-[30%] top-28 h-1.5 w-1.5 rounded-full bg-cream"></div>
        <div class="absolute right-[18%] top-16 h-1 w-1 rounded-full bg-gold-light"></div>
        <div class="absolute right-[32%] bottom-20 h-1.5 w-1.5 rounded-full bg-cream-dim"></div>
      </div>
      <div class="relative mx-auto max-w-5xl">
        <span class="inline-block rounded-md bg-gold/20 px-3 py-1 text-sm font-semibold text-gold-light">Felixar</span>
        <h1 class="mx-auto mt-6 max-w-4xl font-display text-4xl font-extrabold leading-snug text-cream md:text-6xl">Bảng Vinh Danh Felixar</h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-muted md:text-xl">
          Mỗi bài con hoàn thành qua Felixar sẽ được cộng sao. Bảng này giúp các bạn nhỏ thấy hành trình đọc của mình lớn lên từng ngày.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/read2lead" class="rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Tạo bài Read2Lead</a>
          <a href="/read2lead/review" class="rounded-lg border border-gold px-6 py-3 font-semibold text-gold-light transition hover:bg-gold hover:text-navy-950">Vào Felixar</a>
        </div>
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <div id="loading-state" class="rounded-xl border border-cream-dim/20 bg-navy-950/70 p-8 text-center">
          <div class="mx-auto h-14 w-14 animate-pulse rounded-full bg-gold/30"></div>
          <p class="mt-5 text-cream-muted">Đang tải bảng vinh danh...</p>
        </div>

        <div id="error-state" class="hidden rounded-xl border border-red-500/30 bg-red-500/10 p-8 text-center text-red-300">
          Không tải được bảng vinh danh. Vui lòng thử lại sau ít phút.
        </div>

        <div id="empty-state" class="hidden rounded-xl border border-gold/30 bg-gold/10 p-8 text-center">
          <p class="text-5xl" aria-hidden="true">🌟</p>
          <h2 class="mt-4 font-display text-3xl font-bold leading-snug text-cream">Chưa có học sinh nào trên bảng.</h2>
          <p class="mx-auto mt-3 max-w-xl leading-relaxed text-cream-muted">Hãy tạo bài Read2Lead, cho con làm bài trên giấy, rồi nộp qua Felixar để nhận sao đầu tiên.</p>
          <a href="/read2lead" class="mt-6 inline-flex rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Tạo bài đầu tiên</a>
        </div>

        <div id="leaderboard-content" class="hidden">
          <div class="mb-10 text-center">
            <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Top bạn đọc tuần này</h2>
            <p id="updated-at" class="mt-3 text-sm text-cream-dim"></p>
          </div>

          <div id="podium" class="grid gap-5 md:grid-cols-3 md:items-end"></div>

          <div class="mt-12 rounded-xl border border-cream-dim/20 bg-navy-950/70 p-4 shadow-2xl md:p-6">
            <div class="mb-4 flex items-center justify-between gap-4">
              <h2 class="font-display text-2xl font-bold leading-snug text-cream">Danh sách vinh danh</h2>
              <span id="leader-count" class="rounded-md bg-gold/15 px-3 py-1 text-sm font-semibold text-gold-light"></span>
            </div>
            <div id="leader-list" class="space-y-3"></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const emptyState = document.getElementById('empty-state');
    const content = document.getElementById('leaderboard-content');
    const podium = document.getElementById('podium');
    const leaderList = document.getElementById('leader-list');
    const leaderCount = document.getElementById('leader-count');
    const updatedAt = document.getElementById('updated-at');

    const medals = ['🥇', '🥈', '🥉'];
    const podiumStyles = [
      'border-gold/70 bg-gold/20 md:pb-12',
      'border-cream-dim/40 bg-cream-dim/10 md:pb-7',
      'border-orange-300/40 bg-orange-300/10 md:pb-4',
    ];

    loadLeaderboard();

    async function loadLeaderboard() {
      try {
        const res = await fetch('/api/read2lead-leaderboard?limit=50');
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.message || data.error || 'Fetch failed');

        loadingState.classList.add('hidden');

        if (!data.leaders || data.leaders.length === 0) {
          emptyState.classList.remove('hidden');
          return;
        }

        render(data.leaders, data.updated_at);
      } catch {
        loadingState.classList.add('hidden');
        errorState.classList.remove('hidden');
      }
    }

    function render(leaders, timestamp) {
      updatedAt.textContent = timestamp ? `Cập nhật lúc ${formatDate(timestamp)}` : '';
      leaderCount.textContent = `${leaders.length} bạn đọc`;
      podium.innerHTML = leaders.slice(0, 3).map(podiumCard).join('');
      leaderList.innerHTML = leaders.map(listRow).join('');
      content.classList.remove('hidden');
    }

    function podiumCard(leader, index) {
      return `
        <article class="rounded-2xl border ${podiumStyles[index]} p-6 text-center shadow-2xl">
          <div class="text-5xl" aria-hidden="true">${medals[index]}</div>
          <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-gold-light">Hạng ${leader.position}</p>
          <h3 class="mt-2 font-display text-3xl font-extrabold leading-snug text-cream">${escapeHtml(leader.display_name)}</h3>
          <p class="mt-1 text-sm text-cream-dim">${escapeHtml(leader.masked_code)}</p>
          <div class="mt-5 grid grid-cols-2 gap-3">
            <div class="rounded-lg bg-navy-950/70 p-3">
              <p class="text-xs text-cream-dim">Sao</p>
              <p class="font-display text-3xl font-bold text-gold-light">★ ${leader.stars}</p>
            </div>
            <div class="rounded-lg bg-navy-950/70 p-3">
              <p class="text-xs text-cream-dim">Bài</p>
              <p class="font-display text-3xl font-bold text-cream">${leader.completed_packs}</p>
            </div>
          </div>
          <p class="mt-5 rounded-md bg-navy-950/70 px-3 py-2 font-semibold text-accent">${escapeHtml(leader.rank_vi)}</p>
          ${badgeHtml(leader.badges_vi)}
        </article>
      `;
    }

    function listRow(leader) {
      return `
        <article class="grid gap-4 rounded-lg border border-cream-dim/15 bg-navy-900/70 p-4 md:grid-cols-[64px_1fr_auto] md:items-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gold/15 font-display text-xl font-bold text-gold-light">#${leader.position}</div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-display text-xl font-bold leading-snug text-cream">${escapeHtml(leader.display_name)}</h3>
              <span class="rounded-md bg-navy-950 px-2.5 py-1 text-xs text-cream-dim">${escapeHtml(leader.masked_code)}</span>
            </div>
            <p class="mt-1 text-sm text-cream-muted">${escapeHtml(leader.rank_vi)} · ${escapeHtml(leader.current_level)}</p>
            ${badgeHtml(leader.badges_vi)}
          </div>
          <div class="grid grid-cols-2 gap-2 text-center md:w-44">
            <div class="rounded-lg bg-gold/15 px-3 py-2">
              <p class="text-xs text-cream-dim">Sao</p>
              <p class="font-display text-2xl font-bold text-gold-light">${leader.stars}</p>
            </div>
            <div class="rounded-lg bg-navy-950 px-3 py-2">
              <p class="text-xs text-cream-dim">Bài</p>
              <p class="font-display text-2xl font-bold text-cream">${leader.completed_packs}</p>
            </div>
          </div>
        </article>
      `;
    }

    function badgeHtml(badges) {
      if (!badges || badges.length === 0) return '';
      return `<div class="mt-3 flex flex-wrap justify-center gap-2">${badges.map((badge) => `<span class="rounded-md bg-accent/15 px-2.5 py-1 text-xs font-semibold text-accent">${escapeHtml(badge)}</span>`).join('')}</div>`;
    }

    function formatDate(value) {
      return new Intl.DateTimeFormat('vi-VN', {
        hour: '2-digit',
        minute: '2-digit',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
      }).format(new Date(value));
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }
  </script>
</BaseLayout>
