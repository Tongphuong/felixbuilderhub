---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/read2lead-stars.css';
---
<BaseLayout title="Bảng xếp hạng | Read2Lead" description="Bảng xếp hạng XP và kim cương của tất cả các bạn đọc sách." childHome robots="noindex, nofollow">
  <main id="main" class="stars-page r2l">
    <div class="lb-cols">
      <div class="lb-left">
        <a id="stars-home" class="r2l-back" href="/read2lead" data-design="lb.back"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path d="M19 12H6M11 6l-6 6 6 6" stroke="#17324D" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>Về đọc sách</a>
        <header class="lb-head" data-design="lb.header"><span class="r2l-lab">Tất cả các bạn cùng đọc</span><h1 class="r2l-d">Bảng xếp hạng</h1><p class="r2l-b-l">Đọc thêm một truyện, con leo thêm một bậc nhé!</p></header>
        <section id="stars-personal" class="stars-personal r2l-b-m" aria-live="polite" hidden></section>
        <div class="r2l-tabs lb-tabs" role="tablist" aria-label="Bảng xếp hạng" data-design="lb.tabs">
          <button id="xp-tab" class="r2l-tab r2l-tab-on" role="tab" aria-selected="true" aria-controls="stars-podium stars-panel" type="button">XP<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 17l-5.9 3.3 1.3-6.5L2.5 9.3l6.6-.8z" fill="#FFF8E7" stroke="#17324D" stroke-width="1.6"/></svg></button>
          <button id="diamonds-tab" class="r2l-tab" role="tab" aria-selected="false" aria-controls="stars-podium stars-panel" tabindex="-1" type="button">Kim cương<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path d="M6 3h12l4 6-10 12L2 9z" fill="#3CC8F0" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/></svg></button>
        </div>
        <p id="stars-week" class="stars-week r2l-b-m">Xếp hạng tất cả các bạn, tính từ trước đến nay.</p>
        <p id="stars-status" class="r2l-b-m" role="status">Đang mở bảng xếp hạng…</p>
        <button id="stars-retry" class="stars-retry r2l-btn r2l-btn-sun r2l-btn-sm" type="button" hidden>Thử lại</button>
        <div id="stars-podium" class="stars-podium" role="group" aria-label="Ba bạn đứng đầu" data-design="lb.podium" hidden></div>
      </div>
      <section id="stars-panel" class="lb-right" role="tabpanel" aria-labelledby="xp-tab" tabindex="0" hidden>
        <div class="stars-listcard r2l-card-f" data-design="lb.list">
          <ol id="stars-list" class="stars-list" aria-label="Các bạn cùng đọc"></ol>
          <div id="stars-own" class="stars-own" hidden></div>
        </div>
        <p class="stars-note r2l-b-m" data-design="lb.footnote">XP tính tổng từ trước đến nay. Kim cương là số con đang có. Bảng này không tặng thêm kim cương.</p>
        <a id="stars-cta" class="r2l-btn r2l-btn-sun stars-cta" href="/read2lead" data-design="lb.primary">Đọc truyện để leo bảng</a>
      </section>
    </div>
  </main>
</BaseLayout>
<script src="../../scripts/read2lead-stars.ts"></script>
