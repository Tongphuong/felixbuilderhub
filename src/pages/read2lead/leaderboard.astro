---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const rankLadder = [
  ['L1', 'Đồng', '/assets/r2l/ranks/rank-l1-bronze.svg'],
  ['L2', 'Bạc', '/assets/r2l/ranks/rank-l2-silver.svg'],
  ['L3', 'Vàng', '/assets/r2l/ranks/rank-l3-gold.svg'],
  ['L4', 'Kim cương', '/assets/r2l/ranks/rank-l4-diamond.svg'],
  ['L5', 'Huyền thoại', '/assets/r2l/ranks/rank-l5-legend.svg'],
];
---

<BaseLayout
  title="Bảng vinh danh leo rank | Read2Lead"
  description="Bảng vinh danh Read2Lead xếp hạng bằng XP, xu, số bài hoàn thành và rank L1-L5."
>
  <Header />

  <main id="main" class="flex-1">
    <section class="bg-navy-900 px-6 py-10 md:py-14">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
          <div>
            <span class="inline-block rounded-md bg-gold/20 px-3 py-1 text-sm font-semibold text-gold-light">Felixar Rank Arena</span>
            <h1 class="mt-4 font-display text-4xl font-extrabold leading-snug text-cream md:text-5xl">Bảng vinh danh leo rank</h1>
            <p class="mt-3 max-w-2xl leading-relaxed text-cream-muted">
              Xếp hạng bằng XP, xu và số bài hoàn thành. Bé bắt đầu từ Đồng rồi leo dần lên Bạc, Vàng, Kim cương và Huyền thoại.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href="/read2lead" class="rounded-lg bg-accent px-5 py-3 text-center font-semibold text-navy-950 transition hover:bg-accent-hover">Tạo bài mới</a>
            <a href="/read2lead/review" class="rounded-lg border border-gold px-5 py-3 text-center font-semibold text-gold-light transition hover:bg-gold hover:text-navy-950">Xem hồ sơ học</a>
          </div>
        </div>

        <div id="loading-state" class="rounded-xl border border-cream-dim/20 bg-navy-950/70 p-8 text-center">
          <div class="mx-auto h-14 w-14 animate-pulse rounded-full bg-gold/30"></div>
          <p class="mt-5 text-cream-muted">Đang tải bảng vinh danh...</p>
        </div>

        <div id="error-state" class="hidden rounded-xl border border-red-500/30 bg-red-500/10 p-8 text-center text-red-300">
          Không tải được bảng vinh danh. Vui lòng thử lại sau ít phút.
        </div>

        <div id="empty-state" class="hidden rounded-xl border border-gold/30 bg-gold/10 p-8 text-center">
          <img src="/assets/r2l/ranks/rank-l1-bronze.svg" alt="Rank Đồng" class="mx-auto h-24 w-24" />
          <h2 class="mt-4 font-display text-3xl font-bold leading-snug text-cream">Chưa có bạn nào trên bảng.</h2>
          <p class="mx-auto mt-3 max-w-xl leading-relaxed text-cream-muted">Bé hoàn thành bài học đầu tiên trên web để nhận XP, xu và xuất hiện trong bảng vinh danh.</p>
          <a href="/read2lead" class="mt-6 inline-flex rounded-lg bg-accent px-6 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Tạo bài đầu tiên</a>
        </div>

        <div id="leaderboard-content" class="hidden">
          <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div>
              <h2 class="font-display text-2xl font-bold leading-snug text-cream md:text-3xl">Top bạn đọc hiện tại</h2>
              <p id="updated-at" class="mt-2 text-sm text-cream-dim"></p>
            </div>
            <span id="leader-count" class="w-fit rounded-md bg-gold/15 px-3 py-1 text-sm font-semibold text-gold-light"></span>
          </div>

          <div id="podium" class="grid gap-5 md:grid-cols-3 md:items-end"></div>

          <div class="mt-10 rounded-xl border border-cream-dim/20 bg-navy-950/70 p-4 shadow-2xl md:p-6">
            <h2 class="mb-4 font-display text-2xl font-bold leading-snug text-cream">Danh sách vinh danh</h2>
            <div id="leader-list" class="space-y-3"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 py-14">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 text-center">
          <h2 class="font-display text-3xl font-bold leading-snug text-cream md:text-4xl">Thang rank Read2Lead</h2>
          <p class="mx-auto mt-3 max-w-2xl leading-relaxed text-cream-muted">Mỗi lần hoàn thành bài đạt yêu cầu, bé nhận XP/xu. Đủ XP thì rank mới tự mở.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {rankLadder.map(([level, label, asset]) => (
            <article class="rounded-xl border border-cream-dim/20 bg-navy-900/70 p-5 text-center">
              <img src={asset} alt={`Rank ${label}`} class="mx-auto h-24 w-24" loading="lazy" />
              <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-gold">{level}</p>
              <h3 class="font-display text-2xl font-bold text-cream">{label}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const emptyState = document.getElementById('empty-state');
    const content = document.getElementById('leaderboard-content');
    const podium = document.getElementById('podium');
    const leaderList = document.getElementById('leader-list');
    const leaderCount = document.getElementById('leader-count');
    const updatedAt = document.getElementById('updated-at');

    const podiumStyles = [
      'border-gold/70 bg-gold/20 md:pb-12',
      'border-cream-dim/40 bg-cream-dim/10 md:pb-7',
      'border-blue-300/40 bg-blue-300/10 md:pb-4',
    ];

    loadLeaderboard();

    async function loadLeaderboard() {
      try {
        const res = await fetch('/api/read2lead-leaderboard?limit=50');
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.message || data.error || 'Fetch failed');

        loadingState.classList.add('hidden');

        if (!data.leaders || data.leaders.length === 0) {
          emptyState.classList.remove('hidden');
          return;
        }

        render(data.leaders, data.updated_at);
      } catch {
        loadingState.classList.add('hidden');
        errorState.classList.remove('hidden');
      }
    }

    function render(leaders, timestamp) {
      updatedAt.textContent = timestamp ? `Cập nhật lúc ${formatDate(timestamp)}` : '';
      leaderCount.textContent = `${leaders.length} bạn đọc`;
      podium.innerHTML = leaders.slice(0, 3).map(podiumCard).join('');
      leaderList.innerHTML = leaders.map(listRow).join('');
      content.classList.remove('hidden');
    }

    function podiumCard(leader, index) {
      return `
        <article class="rounded-2xl border ${podiumStyles[index]} p-6 text-center shadow-2xl">
          <img src="${escapeAttr(leader.rank_asset_url)}" alt="Rank ${escapeAttr(leader.rank_vi)}" class="mx-auto h-28 w-28 drop-shadow-xl" />
          <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-gold-light">Hạng ${leader.position}</p>
          <h3 class="mt-2 font-display text-3xl font-extrabold leading-snug text-cream">${escapeHtml(leader.display_name)}</h3>
          <p class="mt-1 text-sm text-cream-dim">${escapeHtml(leader.masked_code)}</p>
          <p class="mt-4 rounded-md bg-navy-950/70 px-3 py-2 font-semibold text-accent">${escapeHtml(leader.current_level)} · ${escapeHtml(leader.rank_vi)}</p>
          <div class="mt-5 grid grid-cols-3 gap-3">
            <div class="rounded-lg bg-navy-950/70 p-3">
              <p class="text-xs text-cream-dim">XP</p>
              <p class="font-display text-2xl font-bold text-gold-light">${leader.total_xp}</p>
            </div>
            <div class="rounded-lg bg-navy-950/70 p-3">
              <p class="text-xs text-cream-dim">Xu</p>
              <p class="font-display text-2xl font-bold text-cream">${leader.coins}</p>
            </div>
            <div class="rounded-lg bg-navy-950/70 p-3">
              <p class="text-xs text-cream-dim">Bài</p>
              <p class="font-display text-2xl font-bold text-cream">${leader.completed_packs}</p>
            </div>
          </div>
          ${xpBar(leader)}
        </article>
      `;
    }

    function listRow(leader) {
      return `
        <article class="grid gap-4 rounded-lg border border-cream-dim/15 bg-navy-900/70 p-4 md:grid-cols-[64px_1fr_auto] md:items-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gold/15 font-display text-xl font-bold text-gold-light">#${leader.position}</div>
          <div class="flex items-center gap-4">
            <img src="${escapeAttr(leader.rank_asset_url)}" alt="Rank ${escapeAttr(leader.rank_vi)}" class="h-16 w-16 shrink-0" loading="lazy" />
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-display text-xl font-bold leading-snug text-cream">${escapeHtml(leader.display_name)}</h3>
                <span class="rounded-md bg-navy-950 px-2.5 py-1 text-xs text-cream-dim">${escapeHtml(leader.masked_code)}</span>
              </div>
              <p class="mt-1 text-sm text-cream-muted">${escapeHtml(leader.current_level)} · ${escapeHtml(leader.rank_vi)} · còn ${leader.packs_until_level_up || 0} bài để lên rank</p>
              ${xpBar(leader)}
            </div>
          </div>
          <div class="grid grid-cols-3 gap-2 text-center md:w-60">
            <div class="rounded-lg bg-gold/15 px-3 py-2">
              <p class="text-xs text-cream-dim">XP</p>
              <p class="font-display text-xl font-bold text-gold-light">${leader.total_xp}</p>
            </div>
            <div class="rounded-lg bg-navy-950 px-3 py-2">
              <p class="text-xs text-cream-dim">Xu</p>
              <p class="font-display text-xl font-bold text-cream">${leader.coins}</p>
            </div>
            <div class="rounded-lg bg-navy-950 px-3 py-2">
              <p class="text-xs text-cream-dim">Bài</p>
              <p class="font-display text-xl font-bold text-cream">${leader.completed_packs}</p>
            </div>
          </div>
        </article>
      `;
    }

    function xpBar(leader) {
      const percent = Math.max(0, Math.min(100, Number(leader.xp_percent || 0)));
      const target = Number(leader.xp_to_next_level || 0);
      const label = target > 0 ? `${leader.xp_in_level}/${target} XP trong rank` : 'Rank cao nhất';
      return `
        <div class="mt-4">
          <div class="h-2 overflow-hidden rounded-full bg-navy-950">
            <div class="h-full rounded-full bg-accent" style="width:${percent}%"></div>
          </div>
          <p class="mt-1 text-xs text-cream-dim">${escapeHtml(label)}</p>
        </div>
      `;
    }

    function formatDate(value) {
      return new Intl.DateTimeFormat('vi-VN', {
        hour: '2-digit',
        minute: '2-digit',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
      }).format(new Date(value));
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function escapeAttr(value) {
      return escapeHtml(value).replaceAll('`', '&#096;');
    }
  </script>
</BaseLayout>
