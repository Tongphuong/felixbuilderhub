---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Hồ sơ học sinh | Read2Lead"
  description="Xem tiến trình Read2Lead của con: level, xu, streak, bài đang làm và các truyện đã học — dành cho phụ huynh."
  robots="noindex, follow"
>
  <Header read2LeadState={true} />

  <main id="main" class="profile-page flex-1 bg-navy-950">
    <section class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-10">
      <h1 class="font-display text-2xl font-extrabold text-cream sm:text-3xl">Hồ sơ học sinh</h1>
      <p class="mt-2 text-sm leading-relaxed text-cream-muted">Nhập mã Felix gửi qua Zalo để xem level, xu, streak và các truyện con đã học.</p>

      <div class="profile-entry mt-6 rounded-2xl border border-cream/10 bg-navy-900/80 p-5 shadow-lg">
        <label for="access-code" class="text-sm font-semibold text-cream">Nhập mã học sinh của con</label>
        <p class="mt-1 text-xs leading-relaxed text-cream-muted">Giống như mã vào lớp trên ClassDojo.</p>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
          <input
            id="access-code"
            name="access_code"
            required
            maxlength="40"
            autocomplete="off"
            placeholder="VD: R2L-LINH-8F3KQ2"
            class="min-h-[48px] w-full rounded-xl border border-cream/15 bg-navy-950 px-4 text-base uppercase text-cream placeholder:normal-case placeholder:text-cream-dim/70 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          />
          <button
            id="load-progress"
            type="button"
            class="min-h-[48px] shrink-0 rounded-xl bg-accent px-6 text-base font-bold text-navy-950 transition hover:bg-accent-hover"
          >
            Xem hồ sơ con
          </button>
        </div>
      </div>

      <section id="error-card" class="mt-4 hidden rounded-2xl border border-red-400/40 bg-red-500/10 px-5 py-4 text-sm text-red-200"></section>

      <section id="dashboard-card" class="mt-6 hidden space-y-5"></section>

      <section id="result-card" class="hidden"></section>
    </section>
  </main>

  <Footer />

  <style is:global>
    .profile-page {
      background:
        radial-gradient(circle at top right, rgb(74 222 128 / 0.08), transparent 45%),
        radial-gradient(circle at top left, rgb(212 166 78 / 0.1), transparent 40%),
        rgb(10 14 26);
    }

    .profile-hero {
      display: flex;
      gap: 1rem;
      align-items: center;
      padding: 1.25rem;
      border-radius: 1.25rem;
      border: 1px solid rgb(245 230 211 / 0.12);
      background: linear-gradient(135deg, rgb(245 230 211 / 0.08), rgb(74 222 128 / 0.06));
    }

    .profile-avatar {
      display: flex;
      height: 4.5rem;
      width: 4.5rem;
      shrink: 0;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      border: 3px solid rgb(212 166 78 / 0.55);
      background: rgb(10 14 26 / 0.6);
      box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
    }

    .profile-avatar img {
      height: 3rem;
      width: 3rem;
    }

    .profile-level-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border-radius: 9999px;
      background: rgb(212 166 78 / 0.18);
      padding: 0.25rem 0.75rem;
      font-size: 0.75rem;
      font-weight: 800;
      color: rgb(250 220 160);
    }

    .profile-xp-track {
      margin-top: 0.75rem;
      height: 0.65rem;
      overflow: hidden;
      border-radius: 9999px;
      background: rgb(245 230 211 / 0.1);
    }

    .profile-xp-fill {
      display: block;
      height: 100%;
      border-radius: 9999px;
      background: linear-gradient(90deg, rgb(74 222 128), rgb(134 239 172));
      transition: width 0.4s ease;
    }

    .profile-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .profile-stat {
      border-radius: 1rem;
      padding: 0.85rem 0.5rem;
      text-align: center;
      border: 1px solid transparent;
    }

    .profile-stat-value {
      font-family: Manrope, Inter, sans-serif;
      font-size: 1.5rem;
      font-weight: 800;
      line-height: 1.1;
    }

    .profile-stat-label {
      margin-top: 0.25rem;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      opacity: 0.85;
    }

    .profile-stat--coins {
      background: rgb(212 166 78 / 0.14);
      border-color: rgb(212 166 78 / 0.25);
      color: rgb(250 220 160);
    }

    .profile-stat--streak {
      background: rgb(251 146 60 / 0.12);
      border-color: rgb(251 146 60 / 0.28);
      color: rgb(254 215 170);
    }

    .profile-stat--stories {
      background: rgb(96 165 250 / 0.12);
      border-color: rgb(96 165 250 / 0.28);
      color: rgb(191 219 254);
    }

    .profile-next-card {
      border-radius: 1.25rem;
      border: 2px solid rgb(74 222 128 / 0.45);
      background: linear-gradient(180deg, rgb(74 222 128 / 0.16), rgb(74 222 128 / 0.06));
      padding: 1.25rem;
    }

    .profile-next-btn {
      display: flex;
      min-height: 52px;
      width: 100%;
      align-items: center;
      justify-content: center;
      border-radius: 0.9rem;
      background: rgb(74 222 128);
      padding: 0.85rem 1rem;
      font-size: 1.05rem;
      font-weight: 800;
      color: rgb(10 14 26);
      text-align: center;
      transition: transform 0.15s ease, background 0.15s ease;
    }

    .profile-next-btn:hover {
      transform: translateY(-1px);
      background: rgb(134 239 172);
    }

    .profile-next-btn--wait {
      background: rgb(245 230 211 / 0.08);
      color: rgb(245 230 211 / 0.6);
      border: 1px dashed rgb(245 230 211 / 0.25);
    }

    .profile-lesson-card {
      border-radius: 1.25rem;
      border: 1px solid rgb(245 230 211 / 0.12);
      background: rgb(245 230 211 / 0.04);
      padding: 1.1rem 1.25rem;
    }

    .profile-status-pill {
      display: inline-flex;
      border-radius: 9999px;
      padding: 0.2rem 0.65rem;
      font-size: 0.72rem;
      font-weight: 800;
    }

    .profile-status-pill--wait {
      background: rgb(251 191 36 / 0.18);
      color: rgb(253 224 71);
    }

    .profile-status-pill--progress {
      background: rgb(96 165 250 / 0.18);
      color: rgb(147 197 253);
    }

    .profile-status-pill--done {
      background: rgb(74 222 128 / 0.18);
      color: rgb(134 239 172);
    }

    .profile-status-pill--empty {
      background: rgb(245 230 211 / 0.08);
      color: rgb(245 230 211 / 0.55);
    }

    .profile-story-grid {
      display: grid;
      gap: 0.75rem;
    }

    @media (min-width: 640px) {
      .profile-story-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .profile-story-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      border-radius: 1rem;
      border: 1px solid rgb(245 230 211 / 0.12);
      background: rgb(10 14 26 / 0.45);
      padding: 1rem;
    }

    .profile-story-card:hover {
      border-color: rgb(74 222 128 / 0.35);
    }

    .profile-story-emoji {
      display: flex;
      height: 3rem;
      width: 3rem;
      align-items: center;
      justify-content: center;
      border-radius: 0.85rem;
      background: rgb(96 165 250 / 0.12);
      font-size: 1.6rem;
    }

    .profile-story-btn {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      border-radius: 0.75rem;
      border: 1px solid rgb(74 222 128 / 0.4);
      background: rgb(74 222 128 / 0.12);
      padding: 0.5rem 0.85rem;
      font-size: 0.85rem;
      font-weight: 800;
      color: rgb(134 239 172);
    }

    .profile-story-btn:hover {
      background: rgb(74 222 128 / 0.22);
    }

    .profile-badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .profile-badge {
      border-radius: 9999px;
      border: 1px solid rgb(212 166 78 / 0.35);
      background: rgb(212 166 78 / 0.1);
      padding: 0.35rem 0.75rem;
      font-size: 0.75rem;
      font-weight: 700;
      color: rgb(250 220 160);
    }

    .profile-badge--locked {
      opacity: 0.35;
      filter: grayscale(1);
    }

    .profile-quick-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .profile-quick-link {
      min-height: 44px;
      border-radius: 0.75rem;
      border: 1px solid rgb(245 230 211 / 0.18);
      background: rgb(245 230 211 / 0.04);
      padding: 0.55rem 1rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: rgb(245 230 211 / 0.85);
    }

    .profile-quick-link:hover {
      border-color: rgb(212 166 78 / 0.45);
      color: rgb(250 220 160);
    }
  </style>

  <script>
    const params = new URLSearchParams(window.location.search);
    const codeInput = document.getElementById('access-code');
    const loadBtn = document.getElementById('load-progress');
    const dashboardCard = document.getElementById('dashboard-card');
    const resultCard = document.getElementById('result-card');
    const errorCard = document.getElementById('error-card');

    const initialCode = params.get('code');
    if (initialCode) {
      codeInput.value = initialCode.toUpperCase();
      loadProgress();
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function showError(message) {
      errorCard.textContent = message;
      errorCard.classList.remove('hidden');
    }

    function clearError() {
      errorCard.classList.add('hidden');
      errorCard.textContent = '';
    }

    function syncHeaderState(read2LeadState) {
      const header = document.querySelector('[data-r2l-state-header]');
      if (!header || !read2LeadState) return;
      header.classList.remove('hidden');
      header.classList.add('flex');
      header.querySelector('[data-r2l-level]').textContent = read2LeadState.current_level || 'LV';
      header.querySelector('[data-r2l-rank]').textContent = read2LeadState.rank_title || 'Read2Lead';
      const rankImage = header.querySelector('[data-r2l-rank-image]');
      if (rankImage && read2LeadState.rank_asset_url) {
        rankImage.src = read2LeadState.rank_asset_url;
        rankImage.alt = `Rank ${read2LeadState.rank_title || read2LeadState.current_level || 'Read2Lead'}`;
      }
      header.querySelector('[data-r2l-xp-label]').textContent = `${read2LeadState.xp_in_level ?? 0}/${read2LeadState.xp_to_next_level ?? 60} XP`;
      header.querySelector('[data-r2l-xp-fill]').style.width = `${read2LeadState.xp_percent ?? 0}%`;
      header.querySelector('[data-r2l-coins]').textContent = `${read2LeadState.coins || 0} xu`;
      header.querySelector('[data-r2l-streak]').textContent = `${read2LeadState.streak_days || 0} ngày`;
    }

    function statusMeta(state, pack) {
      if (!pack) {
        return { label: 'Chưa có bài', pillClass: 'profile-status-pill--empty', step: 'Hãy tạo bài đầu tiên cho con.' };
      }
      if (state === 'generation_in_progress' || pack.status === 'generation_in_progress') {
        return { label: 'Đang tạo bài', pillClass: 'profile-status-pill--progress', step: 'Hệ thống đang viết truyện — khoảng 1–2 phút.' };
      }
      if (pack.status === 'reviewed_pass' || pack.status === 'reviewed_pass_web') {
        return { label: 'Đã xong', pillClass: 'profile-status-pill--done', step: 'Bài này con đã hoàn thành. Có thể tạo bài mới.' };
      }
      if (pack.status === 'reviewed_retry' || pack.status === 'reviewed_retry_web') {
        return { label: 'Làm lại', pillClass: 'profile-status-pill--wait', step: 'Con cần làm lại bài này trên web.' };
      }
      const steps = pack.web_lesson_steps || {};
      if (steps.read_completed_at) {
        return { label: 'Đang học', pillClass: 'profile-status-pill--progress', step: 'Con đang làm phần luyện tập.' };
      }
      if (steps.listen_completed_at) {
        return { label: 'Đang nghe', pillClass: 'profile-status-pill--progress', step: 'Con đang nghe và đọc truyện.' };
      }
      return { label: 'Sẵn sàng', pillClass: 'profile-status-pill--wait', step: 'Bài đã sẵn sàng — cho con bấm làm bài nhé.' };
    }

    function buildPrimaryAction(pack, data, code) {
      const encoded = encodeURIComponent(code);
      if (!pack) {
        return { label: 'Tạo bài đầu tiên cho con', href: `/read2lead?code=${encoded}#form`, kind: 'create' };
      }
      if (data.state === 'generation_in_progress' || pack.status === 'generation_in_progress') {
        return { label: 'Đang tạo bài — đợi thêm chút nhé', href: null, kind: 'wait' };
      }
      if (
        pack.status === 'reviewed_pass' ||
        pack.status === 'reviewed_pass_web' ||
        pack.status === 'reviewed_retry' ||
        pack.status === 'reviewed_retry_web'
      ) {
        return { label: 'Tạo bài mới cho con', href: `/read2lead?code=${encoded}#form`, kind: 'create' };
      }
      return {
        label: 'Cho con làm bài ngay',
        href: `/read2lead/lesson?code=${encoded}&pack_id=${encodeURIComponent(pack.pack_id || '')}`,
        kind: 'lesson',
      };
    }

    function renderHero(progress, read2LeadState, storyProgress) {
      const name = progress.student_name || 'Bé yêu';
      const level = read2LeadState.current_level || progress.current_level || 'L1';
      const rankTitle = read2LeadState.rank_title || 'Đồng';
      const rankAsset = read2LeadState.rank_asset_url || '/assets/r2l/ranks/rank-l1-bronze.svg';
      const xpPercent = read2LeadState.xp_percent ?? 0;
      const xpLabel = `${read2LeadState.xp_in_level ?? 0}/${read2LeadState.xp_to_next_level ?? 60} XP`;
      const levelHint = storyProgress?.level_hint || read2LeadState.packs_until_level_up
        ? `Còn ${read2LeadState.packs_until_level_up ?? '?'} truyện nữa để lên level tiếp theo.`
        : '';

      return `
        <div class="profile-hero">
          <div class="profile-avatar" aria-hidden="true">
            <img src="${escapeHtml(rankAsset)}" alt="" />
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-cream-muted">Hồ sơ của</p>
            <h2 class="font-display text-2xl font-extrabold text-cream sm:text-3xl">${escapeHtml(name)}</h2>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <span class="profile-level-pill">${escapeHtml(level)} · ${escapeHtml(rankTitle)}</span>
            </div>
            <div class="profile-xp-track" role="progressbar" aria-valuenow="${xpPercent}" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến trình XP">
              <span class="profile-xp-fill" style="width: ${xpPercent}%"></span>
            </div>
            <p class="mt-2 text-xs font-semibold text-cream-muted">${escapeHtml(xpLabel)}${levelHint ? ` · ${escapeHtml(storyProgress?.level_hint || levelHint)}` : ''}</p>
          </div>
        </div>
      `;
    }

    function renderStats(read2LeadState, progress, storyProgress) {
      return `
        <div class="profile-stats">
          <div class="profile-stat profile-stat--coins">
            <p class="profile-stat-value">${read2LeadState.coins || 0}</p>
            <p class="profile-stat-label">🪙 Xu</p>
          </div>
          <div class="profile-stat profile-stat--streak">
            <p class="profile-stat-value">${read2LeadState.streak_days || 0}</p>
            <p class="profile-stat-label">🔥 Ngày liên tiếp</p>
          </div>
          <div class="profile-stat profile-stat--stories">
            <p class="profile-stat-value">${storyProgress?.total_completed ?? progress.completed_packs ?? 0}</p>
            <p class="profile-stat-label">📚 Truyện xong</p>
          </div>
        </div>
      `;
    }

    function renderNextStep(primary, status) {
      const btn = primary.href
        ? `<a href="${escapeHtml(primary.href)}" class="profile-next-btn">${escapeHtml(primary.label)}</a>`
        : `<span class="profile-next-btn profile-next-btn--wait">${escapeHtml(primary.label)}</span>`;

      return `
        <div class="profile-next-card">
          <p class="text-xs font-extrabold uppercase tracking-wide text-accent">Bước tiếp theo cho con</p>
          <p class="mt-2 text-sm leading-relaxed text-cream/85">${escapeHtml(status.step)}</p>
          <div class="mt-4">${btn}</div>
        </div>
      `;
    }

    function renderCurrentLesson(pack, progress, status) {
      return `
        <div class="profile-lesson-card">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-sm font-bold text-cream">Bài đang mở</p>
            <span class="profile-status-pill ${status.pillClass}">${escapeHtml(status.label)}</span>
          </div>
          <p class="mt-2 font-display text-lg font-bold text-cream">${escapeHtml(pack?.story_title || 'Chưa có bài nào')}</p>
          <p class="mt-1 text-sm text-cream-muted">${pack ? `${escapeHtml(pack.topic || 'Read2Lead')} · ${escapeHtml(pack.level || progress.current_level || 'L1')}` : 'Tạo bài đầu tiên ở nút xanh phía trên.'}</p>
        </div>
      `;
    }

    function renderStoryPortfolio(storyProgress, code) {
      const stories = Array.isArray(storyProgress?.stories) ? storyProgress.stories : [];

      if (!stories.length) {
        return `
          <div class="profile-lesson-card">
            <p class="font-display text-lg font-bold text-cream">Các truyện con đã học</p>
            <p class="mt-2 text-sm leading-relaxed text-cream-muted">${escapeHtml(storyProgress?.empty_hint || 'Khi con làm xong bài, truyện sẽ hiện ở đây.')}</p>
            <p class="mt-3 rounded-xl border border-dashed border-cream/15 bg-navy-950/50 px-4 py-6 text-center text-3xl" aria-hidden="true">📖</p>
            <p class="mt-2 text-center text-xs text-cream-dim">Chưa có truyện nào — bình thường nếu con mới bắt đầu.</p>
          </div>
        `;
      }

      const cards = stories
        .map((story) => {
          const href = story.lesson_path || `/read2lead/lesson?code=${encodeURIComponent(code)}&pack_id=${encodeURIComponent(story.pack_id || '')}`;
          const meta = [story.level, story.topic].filter(Boolean).join(' · ');
          return `
            <article class="profile-story-card">
              <div class="flex items-start gap-3">
                <div class="profile-story-emoji" aria-hidden="true">${escapeHtml(story.emoji || '📖')}</div>
                <div class="min-w-0">
                  <p class="font-display text-base font-bold leading-snug text-cream">${escapeHtml(story.title || 'Câu chuyện')}</p>
                  ${meta ? `<p class="mt-1 text-xs text-cream-muted">${escapeHtml(meta)}</p>` : ''}
                </div>
              </div>
              <a href="${escapeHtml(href)}" class="profile-story-btn">Cho con làm lại</a>
            </article>
          `;
        })
        .join('');

      return `
        <div>
          <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
            <div>
              <p class="font-display text-lg font-bold text-cream">Các truyện con đã học</p>
              <p class="mt-1 text-sm text-cream-muted">${escapeHtml(storyProgress.headline || '')}</p>
            </div>
          </div>
          <div class="profile-story-grid">${cards}</div>
        </div>
      `;
    }

    function renderBadges(badges) {
      const list = Array.isArray(badges) ? badges : [];
      if (!list.length) return '';
      const pills = list
        .slice(0, 6)
        .map((badge) => {
          const locked = !badge.unlocked;
          return `<span class="profile-badge ${locked ? 'profile-badge--locked' : ''}">${escapeHtml(badge.label_vi || badge.id)}</span>`;
        })
        .join('');
      return `
        <div class="profile-lesson-card">
          <p class="text-sm font-bold text-cream">Huy hiệu của con</p>
          <p class="mt-1 text-xs text-cream-muted">Giống điểm thưởng trên ClassDojo — con mở dần khi học đều.</p>
          <div class="profile-badge-row mt-3">${pills}</div>
        </div>
      `;
    }

    function renderQuickLinks(code) {
      const encoded = encodeURIComponent(code);
      return `
        <div class="profile-quick-links">
          <a href="/read2lead?code=${encoded}#form" class="profile-quick-link">+ Tạo bài mới</a>
          <a href="/read2lead/leaderboard" class="profile-quick-link">🏆 Bảng xếp hạng</a>
          <a href="/read2lead" class="profile-quick-link">← Trang Read2Lead</a>
        </div>
      `;
    }

    function renderDashboard(data) {
      const progress = data.progress || {};
      const read2LeadState = data.read2lead_state || {};
      const storyProgress = data.story_progress || {};
      const pack = progress.current_pack;
      const code = codeInput.value.trim().toUpperCase();
      const status = statusMeta(data.state, pack);
      const primary = buildPrimaryAction(pack, data, code);

      syncHeaderState(read2LeadState);

      const sharedNote = data.is_test || data.is_shared
        ? '<p class="rounded-xl border border-blue-400/30 bg-blue-500/10 px-4 py-3 text-sm text-blue-100">Mã test/dùng chung — có thể tạo bài mới bất cứ lúc nào.</p>'
        : '';

      dashboardCard.innerHTML = `
        ${renderHero(progress, read2LeadState, storyProgress)}
        ${renderStats(read2LeadState, progress, storyProgress)}
        ${renderNextStep(primary, status)}
        ${renderCurrentLesson(pack, progress, status)}
        ${renderStoryPortfolio(storyProgress, code)}
        ${renderBadges(read2LeadState.badges)}
        ${sharedNote}
        ${renderQuickLinks(code)}
      `;
      dashboardCard.classList.remove('hidden');
    }

    async function loadProgress() {
      clearError();
      resultCard.classList.add('hidden');
      const code = codeInput.value.trim().toUpperCase();
      if (!code) {
        showError('Vui lòng nhập mã học sinh.');
        return;
      }
      loadBtn.disabled = true;
      loadBtn.textContent = 'Đang tải...';
      try {
        const res = await fetch(`/api/read2lead-progress?code=${encodeURIComponent(code)}`);
        const data = await res.json();
        if (!res.ok || !data.ok) {
          showError(data.message || 'Không tìm thấy mã học sinh.');
          dashboardCard.classList.add('hidden');
          return;
        }
        renderDashboard(data);
        const url = new URL(window.location.href);
        url.searchParams.set('code', code);
        window.history.replaceState({}, '', url);
      } catch {
        showError('Mạng không ổn định. Vui lòng thử lại.');
      } finally {
        loadBtn.disabled = false;
        loadBtn.textContent = 'Xem hồ sơ con';
      }
    }

    loadBtn.addEventListener('click', loadProgress);
  </script>
</BaseLayout>
