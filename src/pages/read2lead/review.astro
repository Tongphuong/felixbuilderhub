---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Felixar - Quản lí học tập ảo cho Read2Lead"
  description="Felixar giúp phụ huynh xem trạng thái bài Read2Lead, nộp bài, nhận nhận xét, theo dõi sao và biết bước tiếp theo."
>
  <Header />

  <main id="main" class="flex-1">
    <section class="mx-auto max-w-6xl px-6 py-14 md:py-20">
      <div class="max-w-4xl">
        <span class="inline-block rounded-md bg-accent/20 px-4 py-1 text-sm font-semibold text-accent">Felixar đang hỗ trợ Read2Lead</span>
        <h1 class="mt-5 font-display text-4xl font-extrabold leading-snug text-cream md:text-5xl">Nhập mã để biết bước tiếp theo.</h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-cream-muted">
          Felixar giúp bố mẹ xem bài hiện tại của con, nộp ảnh bài làm, gửi ghi âm kể lại câu chuyện, nhận nhận xét tiếng Việt và theo dõi sao.
        </p>
      </div>
    </section>

    <section class="bg-navy-900 px-6 py-12">
      <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[0.9fr_1.1fr]">
        <aside class="rounded-xl border border-cream-dim/20 bg-navy-950/70 p-6">
          <h2 class="font-display text-2xl font-bold leading-snug text-cream">Felixar làm gì?</h2>
          <div class="mt-5 space-y-4 text-cream-muted">
            <div class="rounded-lg border border-cream-dim/20 bg-navy-900/70 p-4">
              <p class="font-semibold text-cream">1. Xem trạng thái</p>
              <p class="mt-1 text-sm leading-relaxed">Bố mẹ biết ngay: chưa có bài, đang tạo bài, chờ nộp bài hay đã nhận xét xong.</p>
            </div>
            <div class="rounded-lg border border-cream-dim/20 bg-navy-900/70 p-4">
              <p class="font-semibold text-cream">2. Nộp bài</p>
              <p class="mt-1 text-sm leading-relaxed">Chọn ảnh các trang con đã làm và ghi âm con kể lại câu chuyện trong 30-60 giây.</p>
            </div>
            <div class="rounded-lg border border-cream-dim/20 bg-navy-900/70 p-4">
              <p class="font-semibold text-cream">3. Nhận bước tiếp theo</p>
              <p class="mt-1 text-sm leading-relaxed">Felixar nói con làm tốt gì, cần luyện gì, bố mẹ nên làm gì trong 5 phút tiếp theo.</p>
            </div>
          </div>
        </aside>

        <div class="space-y-6">
          <section class="rounded-xl border border-cream-dim/20 bg-navy-950/80 p-6">
            <label for="access-code" class="mb-2 block text-sm text-cream-muted">Mã học sinh</label>
            <div class="flex flex-col gap-3 sm:flex-row">
              <input id="access-code" name="access_code" required maxlength="40" placeholder="VD: R2L-LINH-8F3KQ2" class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base uppercase text-cream placeholder:normal-case placeholder:text-cream-dim/80 focus:border-accent focus:outline-none" />
              <button id="load-progress" type="button" class="rounded-lg bg-accent px-5 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">Xem bước tiếp theo</button>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-cream-dim">Không chắc phải làm gì? Chỉ cần nhập mã, Felixar sẽ chỉ đúng bước tiếp theo.</p>
          </section>

          <section id="dashboard-card" class="hidden rounded-xl border border-gold/30 bg-gold/10 p-6"></section>

          <section id="submit-panel" class="hidden rounded-xl border border-cream-dim/20 bg-navy-950/80 p-6">
            <div id="submit" class="scroll-mt-24">
              <h2 class="font-display text-2xl font-bold leading-snug text-cream">Nộp bài hiện tại</h2>
              <p class="mt-2 leading-relaxed text-cream-muted">Bố mẹ gửi ảnh bài làm và ghi âm con kể lại câu chuyện. Felixar sẽ nhận xét ngắn gọn bằng tiếng Việt.</p>
            </div>

            <form id="review-form" class="mt-6 space-y-5">
              <div>
                <label for="worksheet-photo" class="mb-2 block text-sm text-cream-muted">Ảnh các trang bài làm của con</label>
                <input id="worksheet-photo" name="worksheet_photos" type="file" accept="image/*" multiple required class="block w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-sm text-cream file:mr-4 file:rounded-md file:border-0 file:bg-accent file:px-3 file:py-2 file:font-semibold file:text-navy-950" />
                <p id="photo-count" class="mt-2 text-xs text-cream-dim">Có thể chọn nhiều ảnh cùng lúc, tối đa 8 ảnh. Nên chụp từng trang rõ chữ.</p>
              </div>

              <div>
                <label for="typed-answers" class="mb-2 block text-sm text-cream-muted">Nếu ảnh không rõ, bố mẹ gõ thêm vài câu ở đây <span class="text-cream-dim">(tùy chọn)</span></label>
                <textarea id="typed-answers" name="typed_answers" maxlength="2000" rows="4" placeholder="VD: Con trả lời câu 1 là..., hoặc con kể lại: ..." class="w-full rounded-lg border border-cream-dim/30 bg-navy-900 px-4 py-3 text-base text-cream placeholder:text-cream-dim/80 focus:border-accent focus:outline-none"></textarea>
              </div>

              <div class="rounded-lg border border-cream-dim/25 bg-navy-900 p-4">
                <label class="block text-sm text-cream-muted">Ghi âm con kể lại câu chuyện</label>
                <div class="mt-3 flex flex-wrap gap-3">
                  <button id="record-btn" type="button" class="rounded-lg bg-accent px-4 py-2 font-semibold text-navy-950 transition hover:bg-accent-hover">Bắt đầu ghi âm</button>
                  <button id="stop-btn" type="button" disabled class="rounded-lg border border-cream-dim/30 px-4 py-2 font-semibold text-cream transition enabled:hover:border-accent enabled:hover:text-accent disabled:cursor-not-allowed disabled:opacity-50">Dừng</button>
                </div>
                <p id="record-status" class="mt-3 text-sm text-cream-dim">Chưa có ghi âm.</p>
                <audio id="audio-preview" controls class="mt-3 hidden w-full"></audio>
              </div>

              <div class="absolute -left-[9999px]" aria-hidden="true">
                <label for="website">Website</label>
                <input id="website" name="website" tabindex="-1" autocomplete="off" />
              </div>

              <button id="submit-review" type="submit" class="w-full rounded-lg bg-accent px-6 py-3 text-lg font-semibold text-navy-950 transition hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-60">Gửi cho Felixar nhận xét</button>
            </form>
          </section>

          <section id="result-card" class="hidden rounded-xl border border-gold/40 bg-gold/10 p-6"></section>
          <section id="error-card" class="hidden rounded-xl border border-red-500/30 bg-red-500/10 p-5 text-red-300"></section>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const params = new URLSearchParams(window.location.search);
    const codeInput = document.getElementById('access-code');
    const loadBtn = document.getElementById('load-progress');
    const dashboardCard = document.getElementById('dashboard-card');
    const submitPanel = document.getElementById('submit-panel');
    const form = document.getElementById('review-form');
    const resultCard = document.getElementById('result-card');
    const errorCard = document.getElementById('error-card');
    const recordBtn = document.getElementById('record-btn');
    const stopBtn = document.getElementById('stop-btn');
    const recordStatus = document.getElementById('record-status');
    const audioPreview = document.getElementById('audio-preview');
    const submitBtn = document.getElementById('submit-review');
    const typedAnswers = document.getElementById('typed-answers');
    const photoInput = document.getElementById('worksheet-photo');
    const photoCount = document.getElementById('photo-count');

    let mediaRecorder = null;
    let chunks = [];
    let audioBlob = null;
    let stream = null;
    let latestDashboard = null;

    const initialCode = params.get('code');
    if (initialCode) {
      codeInput.value = initialCode.toUpperCase();
      loadProgress();
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function showError(message) {
      errorCard.textContent = message;
      errorCard.classList.remove('hidden');
    }

    function clearError() {
      errorCard.classList.add('hidden');
      errorCard.textContent = '';
    }

    function levelRecommendationText(value) {
      return {
        easier: 'Nên chọn bài dễ hơn ở lần sau',
        stay: 'Giữ mức hiện tại',
        move_up: 'Có thể thử mức khó hơn',
      }[value] || 'Giữ mức hiện tại';
    }

    function actionButton(action) {
      if (!action || !action.href) return '';
      return `<a href="${escapeHtml(action.href)}" class="inline-flex justify-center rounded-lg bg-accent px-5 py-3 font-semibold text-navy-950 transition hover:bg-accent-hover">${escapeHtml(action.label)}</a>`;
    }

    function currentStepLabel(pack, state) {
      if (!pack) return 'Chưa có bài nào — hãy tạo bài đầu tiên.';
      if (state === 'generation_in_progress' || pack.status === 'generation_in_progress') {
        return 'Hệ thống đang tạo bài (1–2 phút).';
      }
      if (pack.status === 'reviewed_pass' || pack.status === 'reviewed_pass_web') return 'Đã hoàn thành ✅';
      if (pack.status === 'reviewed_retry' || pack.status === 'reviewed_retry_web') return 'Cần làm lại để qua bài.';
      const steps = pack.web_lesson_steps || {};
      if (steps.read_completed_at) return 'Đang làm bài luyện tập';
      if (steps.listen_completed_at) return 'Đang đọc câu chuyện';
      return 'Sẵn sàng nghe câu chuyện';
    }

    function buildPrimaryAction(pack, data, code) {
      const encoded = encodeURIComponent(code);
      if (!pack) {
        return { label: 'Tạo bài đầu tiên cho con', href: '/read2lead#form', kind: 'create' };
      }
      if (data.state === 'generation_in_progress' || pack.status === 'generation_in_progress') {
        return { label: 'Đợi bài đang tạo (1–2 phút)', href: null, kind: 'wait' };
      }
      if (pack.status === 'reviewed_pass' || pack.status === 'reviewed_pass_web' || pack.status === 'reviewed_retry' || pack.status === 'reviewed_retry_web') {
        return { label: 'Tạo bài tiếp theo cho con', href: '/read2lead#form', kind: 'create' };
      }
      return {
        label: 'Cho con làm bài trên web',
        href: `/read2lead/lesson?code=${encoded}&pack_id=${encodeURIComponent(pack.pack_id || '')}`,
        kind: 'lesson',
      };
    }

    function renderReviewSummary(summary) {
      if (!summary) return '';
      const feedback = summary.feedback_vi || {};
      const mini = summary.mini_practice_vi || {};
      return `
        <div class="mt-5 rounded-lg border border-cream-dim/20 bg-navy-950/70 p-4">
          <p class="font-display text-lg font-bold text-cream">Nhận xét gần nhất</p>
          <p class="mt-2 leading-relaxed text-cream-muted">${escapeHtml(feedback.summary || 'Felixar đã nhận xét bài này.')}</p>
          <div class="mt-4 grid gap-3 md:grid-cols-3">
            <div class="rounded-lg bg-navy-900 p-3"><p class="text-xs text-cream-dim">Điểm tốt</p><p class="mt-1 text-sm text-cream">${escapeHtml(feedback.strength || 'Con đã nộp bài đầy đủ.')}</p></div>
            <div class="rounded-lg bg-navy-900 p-3"><p class="text-xs text-cream-dim">Cần luyện</p><p class="mt-1 text-sm text-cream">${escapeHtml(feedback.practice || 'Nghe lại audio trên web và đọc chậm hơn.')}</p></div>
            <div class="rounded-lg bg-navy-900 p-3"><p class="text-xs text-cream-dim">Level</p><p class="mt-1 text-sm text-cream">${escapeHtml(levelRecommendationText(summary.level_recommendation))}</p></div>
          </div>
          ${mini.read_again || mini.chunk_to_practice || mini.parent_question ? `
            <div class="mt-4 rounded-lg border border-accent/30 bg-accent/10 p-4">
              <p class="font-semibold text-cream">5 phút luyện thêm</p>
              <ul class="mt-2 space-y-1 text-sm text-cream-muted">
                <li><strong class="text-cream">Đọc lại:</strong> ${escapeHtml(mini.read_again || 'Một câu trong truyện.')}</li>
                <li><strong class="text-cream">Cụm cần luyện:</strong> ${escapeHtml(mini.chunk_to_practice || 'Một cụm trong bài.')}</li>
                <li><strong class="text-cream">Bố mẹ hỏi:</strong> ${escapeHtml(mini.parent_question || 'Con kể lại chuyện gì xảy ra nhé?')}</li>
              </ul>
            </div>
          ` : ''}
        </div>
      `;
    }

    function renderDashboard(data) {
      latestDashboard = data;
      const progress = data.progress || {};
      const pack = progress.current_pack;
      const code = codeInput.value.trim().toUpperCase();
      const sharedNote = data.is_test || data.is_shared
        ? '<p class="mt-3 rounded-lg border border-blue-500/30 bg-blue-500/10 p-3 text-sm text-blue-200">Mã này là mã test/dùng chung nên có thể tạo bài mới bất cứ lúc nào.</p>'
        : '';
      const canSubmitPaper = false;
      const canCreateExtra = data.state === 'awaiting_review' && !data.next_pack_locked;

      const primary = buildPrimaryAction(pack, data, code);
      const primaryHtml = primary.href
        ? `<a href="${escapeHtml(primary.href)}" class="inline-flex w-full items-center justify-center rounded-lg bg-accent px-6 py-4 text-lg font-semibold text-navy-950 transition hover:bg-accent-hover sm:w-auto">${escapeHtml(primary.label)}</a>`
        : `<span class="inline-flex w-full items-center justify-center rounded-lg border border-cream-dim/30 px-6 py-4 text-lg font-semibold text-cream-muted sm:w-auto">${escapeHtml(primary.label)}</span>`;

      const secondaryParts = [];
      if (canSubmitPaper) {
        secondaryParts.push('<button id="open-submit" type="button" class="rounded-md border border-cream-dim/30 px-4 py-2 text-sm font-semibold text-cream transition hover:border-accent hover:text-accent">Nộp ảnh + ghi âm thay vì web</button>');
      }
      if (canCreateExtra && primary.kind !== 'create') {
        secondaryParts.push('<a href="/read2lead#form" class="rounded-md border border-cream-dim/30 px-4 py-2 text-sm font-semibold text-cream transition hover:border-accent hover:text-accent">Tạo bài mới</a>');
      }
      const secondaryHtml = secondaryParts.length
        ? `<div class="mt-3 flex flex-wrap gap-2">${secondaryParts.join('')}</div>`
        : '';

      const stepLabel = currentStepLabel(pack, data.state);

      dashboardCard.innerHTML = `
        <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="text-sm font-semibold text-gold-light">${escapeHtml(data.state_label || 'Trạng thái')}</p>
            <h2 class="mt-2 font-display text-2xl font-bold leading-snug text-cream">${escapeHtml(progress.student_name || 'Học sinh Read2Lead')}</h2>
            <p class="mt-2 text-cream-muted">${escapeHtml(progress.current_level || 'L1')} · ${progress.stars || 0} sao · ${escapeHtml(progress.rank || 'Rookie Reader')}</p>
          </div>
          <div class="grid grid-cols-3 gap-2 text-center text-sm">
            <div class="rounded-lg bg-navy-950/70 p-3"><p class="text-cream-dim">Đã nộp</p><p class="font-display text-2xl font-bold text-gold-light">${progress.completed_packs || 0}</p></div>
            <div class="rounded-lg bg-navy-950/70 p-3"><p class="text-cream-dim">Tuần này</p><p class="font-display text-2xl font-bold text-gold-light">${data.weekly_completed_count || 0}</p></div>
            <div class="rounded-lg bg-navy-950/70 p-3"><p class="text-cream-dim">Streak</p><p class="font-display text-2xl font-bold text-gold-light">${data.streak_days || 0}</p></div>
          </div>
        </div>

        <div class="mt-5 rounded-lg border border-cream-dim/20 bg-navy-950/70 p-4">
          <p class="text-sm text-cream-dim">Bài hiện tại</p>
          <p class="mt-1 font-display text-xl font-bold text-cream">${escapeHtml(pack?.story_title || 'Chưa có bài nào')}</p>
          <p class="mt-2 text-sm text-cream-muted">${pack ? `Chủ đề: ${escapeHtml(pack.topic || 'Read2Lead')} · ${escapeHtml(pack.level || progress.current_level || 'L1')}` : 'Hãy tạo bài đầu tiên cho con.'}</p>
        </div>

        <div class="mt-4 rounded-lg border border-accent/30 bg-accent/10 p-4">
          <p class="text-xs uppercase tracking-wide text-cream-dim">Con đang ở bước</p>
          <p class="mt-1 font-display text-lg font-bold text-cream">${escapeHtml(stepLabel)}</p>
        </div>

        ${sharedNote}

        <div class="mt-5">
          ${primaryHtml}
          ${secondaryHtml}
        </div>

        ${renderReviewSummary(data.last_review_summary)}
      `;
      dashboardCard.classList.remove('hidden');

      const openSubmit = document.getElementById('open-submit');
      if (openSubmit) openSubmit.addEventListener('click', showSubmitPanel);
    }

    function showSubmitPanel() {
      submitPanel.classList.remove('hidden');
      submitPanel.scrollIntoView({ behavior: 'smooth' });
    }

    async function loadProgress({ preserveResult = false } = {}) {
      clearError();
      if (!preserveResult) resultCard.classList.add('hidden');
      const code = codeInput.value.trim().toUpperCase();
      if (!code) {
        showError('Vui lòng nhập mã học sinh.');
        return;
      }
      loadBtn.disabled = true;
      loadBtn.textContent = 'Đang kiểm tra...';
      try {
        const res = await fetch(`/api/read2lead-progress?code=${encodeURIComponent(code)}`);
        const data = await res.json();
        if (!res.ok || !data.ok) {
          showError(data.message || 'Không tìm thấy mã học sinh.');
          dashboardCard.classList.add('hidden');
          submitPanel.classList.add('hidden');
          return;
        }
        renderDashboard(data);
        if (data.state !== 'awaiting_review') submitPanel.classList.add('hidden');
      } catch {
        showError('Mạng không ổn định. Vui lòng thử lại.');
      } finally {
        loadBtn.disabled = false;
        loadBtn.textContent = 'Xem bước tiếp theo';
      }
    }

    loadBtn.addEventListener('click', loadProgress);

    photoInput.addEventListener('change', () => {
      const count = photoInput.files.length;
      photoCount.textContent = count
        ? `Đã chọn ${count} ảnh. Tối đa 8 ảnh, nên chụp từng trang rõ chữ.`
        : 'Có thể chọn nhiều ảnh cùng lúc, tối đa 8 ảnh. Nên chụp từng trang rõ chữ.';
    });

    recordBtn.addEventListener('click', async () => {
      clearError();
      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        chunks = [];
        audioBlob = null;
        mediaRecorder = new MediaRecorder(stream);
        mediaRecorder.addEventListener('dataavailable', (event) => {
          if (event.data.size > 0) chunks.push(event.data);
        });
        mediaRecorder.addEventListener('stop', () => {
          audioBlob = new Blob(chunks, { type: mediaRecorder.mimeType || 'audio/webm' });
          audioPreview.src = URL.createObjectURL(audioBlob);
          audioPreview.classList.remove('hidden');
          recordStatus.textContent = 'Đã có ghi âm. Bố mẹ có thể nghe lại trước khi nộp.';
          stream?.getTracks().forEach((track) => track.stop());
        });
        mediaRecorder.start();
        recordBtn.disabled = true;
        stopBtn.disabled = false;
        recordStatus.textContent = 'Đang ghi âm... con kể lại câu chuyện trong 30-60 giây.';
      } catch {
        showError('Không mở được micro. Vui lòng cho phép trình duyệt dùng micro rồi thử lại.');
      }
    });

    stopBtn.addEventListener('click', () => {
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
      }
      recordBtn.disabled = false;
      stopBtn.disabled = true;
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      showError('Read2Lead V2 nộp bài ngay trong màn hình bài học. Bố mẹ bấm nút Cho con làm bài trên web để con hoàn thành nhiệm vụ.');
    });
  </script>
</BaseLayout>
