---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MicCheckPanel from '../../components/read2lead/v2/MicCheckPanel.astro';
import { r2lRecorderScriptSrc } from '../../scripts/r2l-recorder-script.mjs';
import '../../styles/speakup-free-talk.css';

const r2lRecorderSrc = r2lRecorderScriptSrc();
---

<BaseLayout
  title="Luyện nói với Minny — Felix Coaching"
  description="Con luyện nói với Minny trước buổi coaching với Felix — nhận gợi ý nhẹ nhàng và luyện tiếp."
  robots="noindex, follow"
>
  <Header read2LeadState={false} />

  <main id="main" class="min-h-screen bg-navy-950">
    <section class="mx-auto max-w-lg px-4 py-6 sm:px-6 sm:py-8">
      <p class="text-center text-xs font-extrabold uppercase tracking-widest text-accent">Felix Coaching</p>
      <h1 class="mt-1 text-center font-display text-2xl font-extrabold text-cream sm:text-3xl">Luyện nói với Minny</h1>
      <p class="mt-2 text-center text-sm text-cream-muted">
        Con nói — Minny nghe — chuẩn bị cho buổi coaching với Felix.
      </p>

      <div id="speaking-code-card" class="mt-6 rounded-3xl bg-navy-900/60 p-5 shadow-lg shadow-black/20">
        <label for="speaking-code" class="text-sm font-semibold text-cream">Mã học sinh</label>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row">
          <input
            id="speaking-code"
            maxlength="40"
            autocomplete="off"
            placeholder="VD: R2L-LINH-8F3KQ2"
            class="min-h-[52px] w-full rounded-2xl border border-cream/10 bg-navy-950 px-4 text-base uppercase text-cream placeholder:normal-case placeholder:text-cream-dim/70 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          />
          <button id="speaking-load" type="button" class="minny-btn minny-btn--primary shrink-0 px-8">
            Bắt đầu
          </button>
        </div>
      </div>

      <p id="speaking-error" class="mt-4 hidden rounded-2xl bg-red-500/15 px-4 py-3 text-sm text-red-200"></p>

      <div id="speaking-shell" class="mt-6 hidden space-y-6">
        <!-- Hero: Minny + greeting -->
        <div class="minny-hero rounded-3xl bg-navy-900/50 p-6 text-center shadow-lg shadow-black/15">
          <div class="minny-avatar mx-auto">
            <video
              id="minny-video"
              class="minny-avatar__media hidden"
              poster="/assets/minny/minny_idle.png"
              autoplay
              loop
              muted
              playsinline
              aria-hidden="true"
            ></video>
            <img
              id="minny-fallback"
              src="/assets/minny/minny_idle.png"
              alt="Minny"
              width="200"
              height="200"
              class="minny-avatar__media"
            />
          </div>
          <p id="minny-greeting" class="mt-4 text-lg font-bold leading-snug text-cream"></p>
        </div>

        <MicCheckPanel />

        <!-- Mode picker: large tap cards -->
        <div id="mode-picker" class="space-y-3">
          <p class="text-center text-sm font-semibold text-cream-muted">Con chọn cách luyện hôm nay</p>
          <div id="mode-cards" class="grid grid-cols-1 gap-4 sm:grid-cols-2"></div>
        </div>

        <!-- Practice wizard (hidden until mode picked) -->
        <div id="practice-screen" class="hidden space-y-5">
          <div class="flex items-center justify-between gap-3">
            <button id="back-to-modes" type="button" class="minny-back-link">← Chọn cách luyện</button>
            <div id="progress-dots" class="flex items-center gap-2" aria-label="Tiến độ"></div>
          </div>

          <div class="minny-bubble rounded-3xl bg-cream/10 p-5 shadow-md shadow-black/10">
            <p id="prompt-vi" class="text-lg font-bold leading-relaxed text-cream"></p>
            <p id="prompt-en" class="mt-2 text-sm leading-relaxed text-cream-muted"></p>
          </div>

          <div id="frame-stems" class="hidden space-y-3 rounded-3xl border border-cream/10 bg-navy-900/60 p-5"></div>
          <p id="frame-meta" class="hidden -mt-2 text-xs font-extrabold uppercase tracking-widest text-cream-dim"></p>

          <button id="speaking-listen" type="button" class="minny-btn minny-btn--listen w-full">
            🔊 Nghe Minny
          </button>

          <div class="space-y-2">
            <div id="record-ring" class="minny-frame-ring-wrap">
              <button id="speaking-record" type="button" class="minny-btn minny-btn--record w-full">🎤 Con nói</button>
            </div>
            <p id="frame-listening-caption" class="hidden minny-frame-listening">
              <span class="minny-frame-listening__dot"></span>
              Minny đang lắng nghe 🎧
            </p>
            <p id="speaking-status" class="text-center text-sm text-cream-muted"></p>
            <span id="speaking-timer" class="hidden block text-center text-lg font-bold text-gold"></span>
          </div>

          <div id="speaking-result" class="hidden rounded-3xl bg-navy-900/70 p-5 shadow-md shadow-black/10"></div>

          <div id="speaking-actions" class="hidden grid grid-cols-1 gap-3 sm:grid-cols-2">
            <button id="speaking-retry" type="button" class="minny-btn minny-btn--secondary">Luyện lại</button>
            <button id="speaking-next" type="button" class="minny-btn minny-btn--primary">Tiếp theo</button>
          </div>
        </div>

        <!-- Free Talking screen (Phase 8a). Hidden by default. Sibling of
             #practice-screen. Reuses the shared Minny hero/avatar above
             (#minny-video/#minny-fallback/#minny-greeting, already visible
             inside #speaking-shell) — this screen does not repeat it. -->
        <div id="free-talk-screen" class="hidden space-y-4">
          <div class="flex items-center justify-between gap-3">
            <button id="free-talk-end" type="button" class="minny-end-btn">Kết thúc</button>
            <div class="flex items-center gap-3">
              <div id="free-talk-dots" class="minny-turn-dots" aria-label="Còn 12 lượt trong tổng 12"></div>
              <span id="free-talk-timer" class="minny-timer" role="timer" aria-live="off">5:00</span>
              <span id="free-talk-timer-announce" class="sr-only" aria-live="polite"></span>
            </div>
          </div>

          <div id="free-talk-status-bubble" class="minny-bubble rounded-3xl bg-cream/10 p-4 shadow-md shadow-black/10">
            <p id="free-talk-status-eyebrow" class="fx-eyebrow">Đợi con nói</p>
            <div id="free-talk-thinking-dots" class="minny-bubble--thinking"><span></span><span></span><span></span></div>
            <button id="free-talk-play-chip" type="button" class="minny-play-chip" aria-label="Nghe Minny nói">🔊 Nghe Minny</button>
          </div>

          <div id="free-talk-transcript" class="minny-transcript space-y-3" role="log" aria-live="polite" aria-atomic="false"></div>

          <div class="minny-conversation-grid">
            <div class="minny-recorder-panel">
              <button id="free-talk-record" type="button" class="minny-btn minny-btn--record" aria-label="Nhấn để nói">🎤</button>
              <p id="free-talk-record-label" class="text-center text-sm text-cream-muted">Nhấn để nói</p>
              <div id="free-talk-waveform" class="minny-waveform" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span><span></span><span></span>
              </div>
            </div>
          </div>

          <div id="free-talk-wrapup" class="hidden minny-wrap-up">
            <p id="free-talk-wrapup-text" class="minny-wrap-up__text"></p>
            <button id="free-talk-wrapup-cta" type="button" class="fx-btn fx-btn--primary">Xem tóm tắt →</button>
          </div>

          <div id="free-talk-summary" class="hidden minny-summary-panel">
            <p class="fx-eyebrow">Tóm tắt hôm nay</p>
            <h3 class="font-display text-lg font-bold text-cream">Con đã trò chuyện rất giỏi!</h3>
            <div id="free-talk-summary-stats" class="minny-summary-stats"></div>
            <p id="free-talk-summary-line" class="minny-summary-line"></p>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <button id="free-talk-summary-again" type="button" class="fx-btn fx-btn--primary">Nói chuyện nữa với Minny</button>
              <button id="free-talk-summary-home" type="button" class="minny-btn minny-btn--secondary">Về trang chính</button>
            </div>
          </div>
        </div>

        <!-- Compact footer -->
        <div class="rounded-2xl bg-cream/5 px-4 py-3 text-center text-sm text-cream-muted">
          <p id="practice-stats" class="font-medium"></p>
          <p class="mt-2">
            <a id="coaching-link" href="/coaching#book" class="font-bold text-accent underline">Đặt lịch coaching</a>
            <span class="mx-2 text-cream-dim">·</span>
            <a id="profile-link" href="/ho-so" class="font-semibold text-cream underline">Hồ sơ con</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style is:global>
    .minny-avatar {
      width: 11rem;
      height: 11rem;
    }

    @media (min-width: 640px) {
      .minny-avatar {
        width: 13rem;
        height: 13rem;
      }
    }

    .minny-avatar__media {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .minny-btn {
      display: flex;
      min-height: 56px;
      align-items: center;
      justify-content: center;
      border-radius: 1.25rem;
      border: 3px solid transparent;
      padding: 0.9rem 1.25rem;
      font-size: 1.125rem;
      font-weight: 800;
      transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    }

    .minny-btn:active:not(:disabled) {
      transform: scale(0.98);
    }

    .minny-btn--primary {
      background: rgb(74 222 128);
      color: rgb(10 14 26);
      border-color: rgb(134 239 172);
      box-shadow: 0 4px 0 rgb(22 101 52);
    }

    .minny-btn--primary:hover:not(:disabled) {
      background: rgb(134 239 172);
    }

    .minny-btn--record {
      background: rgb(212 166 78);
      color: rgb(10 14 26);
      border-color: rgb(250 220 160);
      box-shadow: 0 4px 0 rgb(120 90 40);
    }

    .minny-btn--record:hover:not(:disabled) {
      background: rgb(242 204 126);
    }

    .minny-btn--listen {
      background: rgb(200 143 56 / 0.18);
      color: rgb(242 204 126);
      border-color: rgb(200 143 56 / 0.45);
      min-height: 52px;
    }

    .minny-btn--listen:hover:not(:disabled) {
      background: rgb(200 143 56 / 0.28);
    }

    .minny-mode-card {
      display: flex;
      min-height: 7.5rem;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 1.5rem;
      border: 3px solid rgb(245 230 211 / 0.12);
      background: rgb(23 53 74 / 0.7);
      padding: 1.5rem 1rem;
      text-align: center;
      box-shadow: 0 6px 0 rgb(0 0 0 / 0.2);
      transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    }

    .minny-mode-card:hover {
      border-color: rgb(200 143 56 / 0.45);
      background: rgb(29 63 88 / 0.85);
      transform: translateY(-2px);
    }

    .minny-mode-card:active {
      transform: translateY(2px);
      box-shadow: 0 2px 0 rgb(0 0 0 / 0.2);
    }

    .minny-mode-card__emoji {
      font-size: 2.25rem;
      line-height: 1;
    }

    .minny-mode-card__title {
      font-size: 1.125rem;
      font-weight: 800;
      color: rgb(245 230 211);
    }

    .minny-mode-card__desc {
      font-size: 0.8rem;
      line-height: 1.4;
      color: rgb(245 230 211 / 0.6);
    }

    .minny-btn--secondary {
      background: rgb(245 230 211 / 0.1);
      color: rgb(245 230 211);
      border-color: rgb(245 230 211 / 0.25);
    }

    .minny-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .minny-back-link {
      font-size: 0.875rem;
      font-weight: 600;
      color: rgb(217 199 164);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .minny-back-link:hover {
      color: rgb(245 230 211);
    }

    .minny-dot {
      width: 0.65rem;
      height: 0.65rem;
      border-radius: 9999px;
      background: rgb(245 230 211 / 0.2);
      transition: background 0.15s ease, transform 0.15s ease;
    }

    .minny-dot--active {
      background: rgb(200 143 56);
      transform: scale(1.2);
    }

    .minny-dot--done {
      background: rgb(74 222 128 / 0.6);
    }

    .minny-word {
      display: inline-block;
      margin: 0.15rem;
      border-radius: 0.5rem;
      padding: 0.2rem 0.5rem;
      font-size: 0.85rem;
      font-weight: 700;
    }

    .minny-word--good {
      background: rgb(74 222 128 / 0.2);
      color: rgb(187 247 208);
    }

    .minny-word--close {
      background: rgb(251 191 36 / 0.2);
      color: rgb(254 215 170);
    }

    .minny-word--miss {
      background: rgb(245 230 211 / 0.1);
      color: rgb(245 230 211 / 0.75);
    }

.minny-frame-ring-wrap {
  --pct: 0;
}
.minny-frame-ring-wrap.is-frame {
  width: 112px;
  height: 112px;
  margin: 0 auto;
  padding: 8px;
  border-radius: 9999px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: conic-gradient(rgb(200 143 56) calc(var(--pct) * 1%), rgb(200 143 56 / 0.15) 0);
  transition: background 0.2s linear;
}
.minny-frame-ring-wrap.is-frame .minny-btn--record {
  width: 96px;
  height: 96px;
  min-height: 96px;
  border-radius: 9999px;
  font-size: 1.75rem;
  background: linear-gradient(160deg, rgb(248 113 113), rgb(214 69 69));
  border-color: rgb(214 69 69 / 0.6);
  box-shadow: 0 4px 0 rgb(120 30 30);
}
.minny-frame-ring-wrap.is-frame .minny-btn--record.is-recording {
  animation: minny-frame-pulse 1.6s ease-in-out infinite;
}
@keyframes minny-frame-pulse {
  0%, 100% { box-shadow: 0 4px 0 rgb(120 30 30), 0 0 0 0 rgb(248 113 113 / 0.45); }
  50% { box-shadow: 0 4px 0 rgb(120 30 30), 0 0 0 14px rgb(248 113 113 / 0); }
}
.minny-frame-listening {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  font-size: 0.85rem;
  color: rgb(217 199 164);
}
.minny-frame-listening.hidden {
  display: none;
}
.minny-frame-listening__dot {
  width: 8px;
  height: 8px;
  border-radius: 9999px;
  background: rgb(248 113 113);
  box-shadow: 0 0 6px rgb(248 113 113 / 0.8);
  animation: minny-frame-dot 1.2s ease-in-out infinite;
}
@keyframes minny-frame-dot {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}
.minny-frame-stem__num {
  background: rgb(200 143 56 / 0.2);
  color: rgb(200 143 56);
}
.minny-blank {
  display: inline-block;
  min-width: 2.5em;
  border-bottom: 2px dashed rgb(200 143 56 / 0.6);
  color: rgb(242 204 126);
}
.minny-frame-score-card {
  border-radius: 20px;
  padding: 20px;
  background: linear-gradient(160deg, rgb(200 143 56 / 0.22), rgb(23 53 74 / 0.6));
  border: 1px solid rgb(200 143 56 / 0.35);
  text-align: center;
}
.minny-frame-score-card__eyebrow {
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgb(217 199 164);
}
.minny-frame-score-card__value {
  font-family: 'Manrope', sans-serif;
  font-weight: 800;
  font-size: 2.75rem;
  color: rgb(242 204 126);
  line-height: 1.1;
}
.minny-frame-rubric-card {
  margin-top: 12px;
  border-radius: 18px;
  border: 1px solid rgb(245 230 211 / 0.12);
  background: rgb(23 53 74 / 0.5);
  padding: 16px;
}
.minny-frame-rubric-card__eyebrow {
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgb(170 150 115);
  margin-bottom: 8px;
}
.minny-frame-rubric-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 0;
}
.minny-frame-rubric-row__mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  flex-shrink: 0;
  border-radius: 9999px;
  font-size: 0.85rem;
  font-weight: 800;
}
.minny-frame-rubric-row__mark.is-ok {
  background: rgb(111 207 151 / 0.2);
  color: rgb(111 207 151);
}
.minny-frame-rubric-row__mark.is-miss {
  background: rgb(245 230 211 / 0.1);
  color: rgb(170 150 115);
}
.minny-frame-smile-chip {
  margin-top: 12px;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  border-radius: 16px;
  border: 2px dashed rgb(200 143 56 / 0.45);
  padding: 14px;
}
.minny-frame-smile-chip__eyebrow {
  display: block;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgb(200 143 56);
}
@media (prefers-reduced-motion: reduce) {
  .minny-frame-ring-wrap.is-frame .minny-btn--record.is-recording { animation: none; }
  .minny-frame-listening__dot { animation: none; opacity: 0.9; }
}
  </style>

  <script>
    const params = new URLSearchParams(window.location.search);
    const codeInput = document.getElementById('speaking-code');
    const loadBtn = document.getElementById('speaking-load');
    const codeCard = document.getElementById('speaking-code-card');
    const shell = document.getElementById('speaking-shell');
    const errorEl = document.getElementById('speaking-error');
    const modePicker = document.getElementById('mode-picker');
    const practiceScreen = document.getElementById('practice-screen');
    const DEFAULT_MAX_SECONDS = 30;

    function safeStopMonitor(m) {
      try { if (m && typeof m.stop === 'function') m.stop(); } catch {}
    }

    const MODE_EMOJI = { homework: '📚', retell: '📖', questions: '💬', free_talk: '🗣️' };

    const state = {
      accessCode: '',
      packId: '',
      modes: [],
      activeModeId: 'retell',
      modePicked: false,
      stepIndex: 0,
      recording: null,
      status: 'idle',
      secondsLeft: DEFAULT_MAX_SECONDS,
      timerId: null,
      lastResult: null,
      activeAudio: null,
      videoAvailable: {},
      micGateReady: false,
      homeworkResults: [],
      homeworkComplete: false,
    };

    if (params.get('code')) {
      codeInput.value = params.get('code').toUpperCase();
      loadSession();
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function minnyAssetBase(mood) {
      const file = ['idle', 'listen', 'celebrate', 'encourage'].includes(mood) ? mood : 'idle';
      return `/assets/minny/minny_${file}`;
    }

    function showMinnyPng(mood) {
      const img = document.getElementById('minny-fallback');
      const video = document.getElementById('minny-video');
      if (!img) return;
      img.src = `${minnyAssetBase(mood)}.png`;
      img.classList.remove('hidden');
      if (video) video.classList.add('hidden');
    }

    function setMinnyMood(mood) {
      const video = document.getElementById('minny-video');
      const img = document.getElementById('minny-fallback');
      const base = minnyAssetBase(mood);

      if (!video) {
        showMinnyPng(mood);
        return;
      }

      if (state.videoAvailable[mood] === false) {
        showMinnyPng(mood);
        return;
      }

      const tryPlay = (ext) => {
        video.onerror = () => {
          if (ext === 'mp4') {
            video.src = `${base}.webm`;
            video.onerror = () => {
              state.videoAvailable[mood] = false;
              showMinnyPng(mood);
            };
          } else {
            state.videoAvailable[mood] = false;
            showMinnyPng(mood);
          }
        };
        video.onloadeddata = () => {
          state.videoAvailable[mood] = true;
          video.classList.remove('hidden');
          if (img) img.classList.add('hidden');
          video.play().catch(() => showMinnyPng(mood));
        };
        video.poster = `${base}.png`;
        video.src = `${base}.${ext}`;
        video.load();
      };

      tryPlay('mp4');
    }

    function showModePicker() {
      state.modePicked = false;
      document.querySelector('[data-r2l-mic-check]')?.classList.remove('hidden');
      modePicker?.classList.remove('hidden');
      practiceScreen?.classList.add('hidden');
      setMinnyMood('idle');
    }

    function enterPracticeMode(modeId) {
      if (modeId === 'free_talk') {
        enterFreeTalking();
        return;
      }
      state.activeModeId = modeId;
      state.stepIndex = 0;
      state.modePicked = true;
      state.homeworkResults = [];
      state.homeworkComplete = false;
      stopPlayback();
      modePicker?.classList.add('hidden');
      practiceScreen?.classList.remove('hidden');
      renderStep();
      updateRecordUi();
    }

    function showError(message) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }

    function clearError() {
      errorEl.classList.add('hidden');
      errorEl.textContent = '';
    }

    function activeMode() {
      return state.modes.find((mode) => mode.id === state.activeModeId) || state.modes[0] || null;
    }

    function currentStep() {
      const mode = activeMode();
      if (!mode) return null;
      return mode.steps[state.stepIndex] || null;
    }

    function stepMaxSeconds(step) {
      const n = Number(step?.max_seconds);
      return Number.isFinite(n) && n > 0 ? n : DEFAULT_MAX_SECONDS;
    }

    function stopPlayback() {
      if (state.activeAudio) {
        state.activeAudio.pause();
        state.activeAudio = null;
      }
      if (window.speechSynthesis) window.speechSynthesis.cancel();
    }

    function playMinnyAudio(step) {
      if (!step) return;
      stopPlayback();
      setMinnyMood('listen');

      if (step.audio_url) {
        const audio = new Audio(step.audio_url);
        state.activeAudio = audio;
        audio.addEventListener('ended', () => {
          setMinnyMood('idle');
          state.activeAudio = null;
        });
        audio.play().catch(() => speakEnglish(step.prompt_en || step.question_en));
        return;
      }

      const text = step.prompt_en || step.question_en || '';
      if (step.kind === 'homework' && text) {
        playMinnyVoice(text);
        return;
      }
      speakEnglish(text);
    }

    async function playMinnyVoice(text) {
      try {
        const res = await fetch('/api/minny-voice', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ access_code: state.accessCode, text }),
        });
        const data = await res.json();
        if (!res.ok || !data?.ok || !data.audio_b64) throw new Error('minny_voice_failed');
        const audio = new Audio(`data:${data.content_type || 'audio/mpeg'};base64,${data.audio_b64}`);
        state.activeAudio = audio;
        audio.addEventListener('ended', () => {
          setMinnyMood('idle');
          state.activeAudio = null;
        });
        await audio.play();
      } catch {
        speakEnglish(text);
      }
    }

    function speakEnglish(text) {
      const line = String(text || '').trim();
      if (!line || !window.speechSynthesis) return;
      const utterance = new SpeechSynthesisUtterance(line);
      utterance.lang = 'en-US';
      utterance.rate = 0.92;
      utterance.onend = () => setMinnyMood('idle');
      window.speechSynthesis.speak(utterance);
    }

    function renderModeCards() {
      const cardsEl = document.getElementById('mode-cards');
      if (!cardsEl) return;
      cardsEl.innerHTML = state.modes
        .map(
          (mode) => `
            <button
              type="button"
              class="minny-mode-card"
              data-mode-id="${escapeHtml(mode.id)}"
            >
              <span class="minny-mode-card__emoji">${MODE_EMOJI[mode.id] || '✨'}</span>
              <span class="minny-mode-card__title">${escapeHtml(mode.title_vi)}</span>
              <span class="minny-mode-card__desc">${escapeHtml(mode.subtitle_vi || '')}</span>
            </button>
          `,
        )
        .join('');

      cardsEl.querySelectorAll('[data-mode-id]').forEach((button) => {
        button.addEventListener('click', () => enterPracticeMode(button.dataset.modeId));
      });
    }

    function renderProgressDots() {
      const dotsEl = document.getElementById('progress-dots');
      const mode = activeMode();
      if (!dotsEl || !mode) return;

      if (mode.steps.length <= 1) {
        dotsEl.innerHTML = '';
        dotsEl.classList.add('hidden');
        return;
      }

      dotsEl.classList.remove('hidden');
      dotsEl.innerHTML = mode.steps
        .map((_, i) => {
          let cls = 'minny-dot';
          if (i < state.stepIndex) cls += ' minny-dot--done';
          else if (i === state.stepIndex) cls += ' minny-dot--active';
          return `<span class="${cls}" title="Bước ${i + 1}"></span>`;
        })
        .join('');
    }

    function renderFrameStems(step) {
      const el = document.getElementById('frame-stems');
      const metaEl = document.getElementById('frame-meta');
      if (!el) return;
      const stems = step?.check_mode === 'frame' && Array.isArray(step.stems) ? step.stems : null;
      if (!stems || !stems.length) {
        el.classList.add('hidden');
        el.innerHTML = '';
        if (metaEl) metaEl.classList.add('hidden');
        return;
      }
      const withBlanks = (text) => escapeHtml(text || '').replace(/_{2,}/g, '<span class="minny-blank">___</span>');
      el.innerHTML = stems
        .map(
          (stem, i) => `
            <div class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full minny-frame-stem__num text-xs font-extrabold">${i + 1}</span>
              <p class="text-sm leading-relaxed text-cream-muted">${withBlanks(stem.text_en)}</p>
            </div>
          `,
        )
        .join('');
      el.classList.remove('hidden');
      if (metaEl) {
        const seconds = Number(step.max_seconds) || 60;
        metaEl.textContent = `${stems.length} câu · ~${seconds} giây`;
        metaEl.classList.remove('hidden');
      }
    }

    function renderStep() {
      const mode = activeMode();
      const step = currentStep();
      if (!mode || !step) return;

      const viEl = document.getElementById('prompt-vi');
      const enEl = document.getElementById('prompt-en');
      const recordBtn = document.getElementById('speaking-record');

      viEl.textContent = step.prompt_vi || step.question_vi || step.label_vi || '';
      enEl.textContent = step.prompt_en || step.question_en || '';
      renderFrameStems(step);

      const isQuestion = step.kind === 'question';
      recordBtn.textContent = isQuestion ? '🎤 Trả lời Minny' : '🎤 Con nói';

      renderProgressDots();
      setMinnyMood('idle');
      document.getElementById('speaking-result').classList.add('hidden');
      document.getElementById('speaking-actions').classList.add('hidden');
      document.getElementById('speaking-record').disabled = false;
      document.getElementById('speaking-status').textContent = isQuestion
        ? 'Nghe Minny hỏi, rồi con trả lời nhé.'
        : 'Nghe Minny nhắc, rồi con kể nhé.';
    }

    function wordChips(words, tone) {
      if (!Array.isArray(words) || !words.length) return '';
      return words.map((w) => `<span class="minny-word minny-word--${tone}">${escapeHtml(w)}</span>`).join('');
    }

    // Homework mode (any step kind) accumulates each completed step's score so
    // the end-of-set summary can list them; keyed by step id so a retry on the
    // same step replaces its entry instead of duplicating it.
    function finalizeHomeworkStep(result, isLast) {
      if (state.activeModeId !== 'homework') return;
      const step = currentStep();
      const stepId = step?.id || `step_${state.stepIndex}`;
      const scorePercent = result.check_mode === 'frame' ? result.matchPct : result.score_percent;
      const entry = { step_id: stepId, ok: true, score_percent: scorePercent };
      const existingIdx = state.homeworkResults.findIndex((r) => r.step_id === stepId);
      if (existingIdx >= 0) state.homeworkResults[existingIdx] = entry;
      else state.homeworkResults.push(entry);
      if (isLast) appendHomeworkSummary();
    }

    function appendHomeworkSummary() {
      const resultEl = document.getElementById('speaking-result');
      const nextBtn = document.getElementById('speaking-next');
      if (!resultEl || !nextBtn) return;

      const rows = state.homeworkResults
        .map((r, i) => {
          const pct = Number.isFinite(Number(r.score_percent)) ? `${Math.round(Number(r.score_percent))}%` : '—';
          return `<p class="mt-1 text-sm text-cream-muted">Câu ${i + 1}: ${pct}</p>`;
        })
        .join('');

      const matchPercent = (() => {
        const valid = state.homeworkResults.filter(r => Number.isFinite(Number(r.score_percent)));
        if (valid.length === 0) return null;
        const sum = valid.reduce((acc, r) => acc + Number(r.score_percent), 0);
        return Math.round(sum / valid.length);
      })();

      const summary = document.createElement('div');
      summary.className = 'mt-4 border-t border-cream/10 pt-4';
      summary.innerHTML = `
        <p class="font-display text-lg font-bold text-cream">Con đã hoàn thành bài tập thầy giao! 🎉</p>
        ${rows}
        ${matchPercent !== null ? `<p class="mt-3 font-display text-lg font-bold text-gold">Khớp bài thầy dạy: ${matchPercent}%</p>` : ''}
      `;
      resultEl.appendChild(summary);

      state.homeworkComplete = true;
      nextBtn.classList.remove('hidden');
      nextBtn.textContent = 'Xong bài tập';

      if (state.accessCode && state.packId) {
        fetch('/api/minny-practice-log', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            access_code: state.accessCode,
            pack_id: state.packId,
            prompt_id: 'homework_summary',
            mode_id: 'homework',
            summary: {
              mode: 'homework',
              turns: state.homeworkResults.length,
              match_percent: matchPercent,
              homework_note_vi: (activeMode() && activeMode().homework_note_vi) || null,
            },
          }),
        }).catch(() => {});
      }
    }

    function rubricRow(ok, label) {
      const markClass = ok ? 'is-ok' : 'is-miss';
      const mark = ok ? '✓' : '—';
      return `
        <div class="minny-frame-rubric-row">
          <span class="minny-frame-rubric-row__mark ${markClass}">${mark}</span>
          <span class="text-sm text-cream/85">${escapeHtml(label)}</span>
        </div>
      `;
    }

    function renderFrameResult(result) {
      const resultEl = document.getElementById('speaking-result');
      const actionsEl = document.getElementById('speaking-actions');
      const matchPct = Math.round(Number(result.matchPct) || 0);
      setMinnyMood(matchPct >= 70 ? 'celebrate' : 'encourage');

      const rubric = result.rubric || {};
      const rubricHtml = [
        rubricRow(!!rubric.spokeAllStems, 'Nói đủ các câu trong khung'),
        rubricRow(!!rubric.durationOnTarget, 'Đủ thời gian'),
        rubricRow(!!rubric.spokeClearly, 'Nói to, rõ ràng'),
      ].join('');

      resultEl.classList.remove('hidden');
      resultEl.innerHTML = `
        <div class="minny-frame-score-card">
          <p class="minny-frame-score-card__eyebrow">Điểm hoàn thành</p>
          <p class="minny-frame-score-card__value">${matchPct}%</p>
          <p class="mt-1 text-sm text-cream-muted">Khớp bài thầy dạy</p>
        </div>
        <div class="minny-frame-rubric-card">
          <p class="minny-frame-rubric-card__eyebrow">Bảng đánh giá</p>
          ${rubricHtml}
        </div>
        <div class="minny-frame-smile-chip">
          <span class="text-2xl leading-none">😄</span>
          <span>
            <span class="minny-frame-smile-chip__eyebrow">Nhắc nhẹ từ Minny</span>
            <span class="text-sm text-cream-muted">Con nhớ cười khi quay video nộp bài thầy nhé!</span>
          </span>
        </div>
      `;

      actionsEl.classList.remove('hidden');
      const mode = activeMode();
      const isLast = mode ? state.stepIndex >= mode.steps.length - 1 : true;
      document.getElementById('speaking-next').classList.toggle('hidden', isLast);
      document.getElementById('speaking-next').textContent = 'Bước tiếp theo';

      finalizeHomeworkStep(result, isLast);

      logPractice({ ...result, score_percent: matchPct });
    }

    function renderResult(result) {
      const resultEl = document.getElementById('speaking-result');
      const actionsEl = document.getElementById('speaking-actions');
      if (!result?.ok) {
        setMinnyMood('encourage');
        resultEl.classList.remove('hidden');
        resultEl.innerHTML = `<p class="text-lg font-bold text-gold">${escapeHtml(result?.message || 'Chưa nghe rõ — thử lại nhé!')}</p>`;
        actionsEl.classList.remove('hidden');
        document.getElementById('speaking-next').classList.add('hidden');
        return;
      }

      if (result.check_mode === 'frame') {
        renderFrameResult(result);
        return;
      }

      const isOpen = result.check_mode === 'open';
      const passed = Number(result.score_percent) >= 50;
      setMinnyMood(passed ? 'celebrate' : 'encourage');

      const missed = !isOpen && result.words_missed?.length
        ? `<p class="mt-3 text-sm text-cream/80"><strong>Luyện thêm:</strong> ${wordChips(result.words_missed, 'miss')}</p>`
        : '';
      const close = !isOpen && result.words_close?.length
        ? `<p class="mt-3 text-sm text-cream/80"><strong>Gần đúng:</strong> ${wordChips(result.words_close, 'close')}</p>`
        : '';
      const matched = isOpen && result.words_matched?.length
        ? `<p class="mt-3 text-sm text-cream/80"><strong>Con nhắc tới:</strong> ${wordChips(result.words_matched, 'good')}</p>`
        : '';
      const transcript = result.transcript
        ? `<p class="mt-2 text-sm text-cream/75">Minny nghe: “${escapeHtml(result.transcript)}”</p>`
        : '';

      resultEl.classList.remove('hidden');
      resultEl.innerHTML = `
        <p class="font-display text-xl font-bold text-gold">${escapeHtml(result.feedback_vi || 'Hay lắm!')}</p>
        ${transcript}
        ${matched}
        ${close}
        ${missed}
      `;
      actionsEl.classList.remove('hidden');
      const mode = activeMode();
      const isLast = mode ? state.stepIndex >= mode.steps.length - 1 : true;
      document.getElementById('speaking-next').classList.toggle('hidden', isLast);
      const stepKind = currentStep()?.kind;
      document.getElementById('speaking-next').textContent =
        stepKind === 'question' ? 'Câu tiếp theo' : 'Bước tiếp theo';

      finalizeHomeworkStep(result, isLast);

      logPractice(result);
    }

    async function logPractice(result, readyForClass = false) {
      const step = currentStep();
      if (!state.accessCode || !state.packId) return;
      try {
        await fetch('/api/minny-practice-log', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            access_code: state.accessCode,
            pack_id: state.packId,
            prompt_id: step?.id || '',
            mode_id: state.activeModeId,
            score_percent: result?.score_percent,
            ready_for_class: readyForClass,
          }),
        });
      } catch {
        /* non-blocking */
      }
    }

    function micReady() {
      return !!(navigator.mediaDevices?.getUserMedia && window.MediaRecorder);
    }

    function createRecorder(stream) {
      const candidates = [
        'audio/mp4',
        'audio/aac',
        'audio/webm;codecs=opus',
        'audio/webm',
        'audio/ogg;codecs=opus',
      ];
      for (const mimeType of candidates) {
        try {
          if (typeof MediaRecorder.isTypeSupported === 'function' && !MediaRecorder.isTypeSupported(mimeType)) {
            continue;
          }
          const mediaRecorder = new MediaRecorder(stream, { mimeType });
          return { mediaRecorder, mimeType: mediaRecorder.mimeType || mimeType };
        } catch {
          // try next Safari-friendly codec
        }
      }
      const mediaRecorder = new MediaRecorder(stream);
      return { mediaRecorder, mimeType: mediaRecorder.mimeType || 'audio/mp4' };
    }

    function audioUploadFilename(blob) {
      const type = String(blob?.type || '').toLowerCase();
      if (type.includes('mp4') || type.includes('m4a') || type.includes('aac')) return 'audio.mp4';
      if (type.includes('ogg')) return 'audio.ogg';
      if (type.includes('wav')) return 'audio.wav';
      return 'audio.webm';
    }

    function stopMediaRecorder(mediaRecorder) {
      if (!mediaRecorder || mediaRecorder.state !== 'recording') return;
      try {
        mediaRecorder.requestData();
      } catch {
        /* optional on some browsers */
      }
      mediaRecorder.stop();
    }

    function cleanupRecording() {
      if (state.timerId) {
        clearInterval(state.timerId);
        state.timerId = null;
      }
      safeStopMonitor(state.recording?.monitor);
      if (state.recording?.stream) {
        state.recording.stream.getTracks().forEach((t) => t.stop());
      }
      state.recording = null;
      state.status = 'idle';
      state.secondsLeft = DEFAULT_MAX_SECONDS;
      document.getElementById('speaking-timer').classList.add('hidden');
    }

    function updateRecordUi() {
      const btn = document.getElementById('speaking-record');
      const statusEl = document.getElementById('speaking-status');
      const timerEl = document.getElementById('speaking-timer');
      const step = currentStep();
      const isQuestion = step?.kind === 'question';
      const idleLabel = isQuestion ? '🎤 Trả lời Minny' : '🎤 Con nói';

      const isFrame = step?.check_mode === 'frame';
      const ringEl = document.getElementById('record-ring');
      const captionEl = document.getElementById('frame-listening-caption');
      const isRecording = state.status === 'recording';
      ringEl?.classList.toggle('is-frame', isFrame);
      btn.classList.toggle('is-recording', isFrame && isRecording);
      if (isFrame && ringEl) {
        const maxSeconds = Number(step.max_seconds) || DEFAULT_MAX_SECONDS;
        const pct = isRecording ? Math.round(100 - (state.secondsLeft / maxSeconds) * 100) : 0;
        ringEl.style.setProperty('--pct', String(Math.max(0, Math.min(100, pct))));
      }
      captionEl?.classList.toggle('hidden', !(isFrame && isRecording));

      if (state.status === 'warming') {
        btn.textContent = isFrame ? '⏳' : '⏳ Chờ micro...';
        btn.disabled = true;
        timerEl.classList.add('hidden');
        statusEl.textContent = state.warmupMessage || 'Micro đã bật — chờ 3 giây rồi mới nói nhé…';
        setMinnyMood('listen');
        return;
      }

      if (state.status === 'recording') {
        btn.textContent = isFrame ? '⏹' : '⏹ Dừng';
        btn.disabled = false;
        timerEl.classList.remove('hidden');
        timerEl.textContent = `${state.secondsLeft}s`;
        statusEl.textContent = 'Minny đang nghe con...';
        setMinnyMood('listen');
        return;
      }

      if (state.status === 'uploading') {
        btn.disabled = true;
        btn.textContent = isFrame ? '🎤' : idleLabel;
        timerEl.classList.add('hidden');
        statusEl.textContent = 'Minny đang nhận xét...';
        setMinnyMood('listen');
        return;
      }

      const micBlocked = state.modePicked && !state.micGateReady;
      btn.disabled = !micReady() || micBlocked;
      btn.textContent = isFrame ? '🎤' : idleLabel;
      timerEl.classList.add('hidden');
      if (micBlocked) {
        statusEl.textContent = 'Con kiểm tra micro ở khung phía trên trước nhé.';
      } else {
        statusEl.textContent = micReady() ? 'Bấm nút rồi nói to, rõ nhé.' : 'Micro chưa sẵn sàng.';
      }
      if (state.modePicked) setMinnyMood('idle');
    }

    function mountSpeakingMicCheck() {
      const panel = shell?.querySelector('[data-r2l-mic-check]');
      if (!panel || panel.dataset.r2lMicMounted === 'true') return;
      if (!window.R2LMicCheck?.mount) {
        window.setTimeout(mountSpeakingMicCheck, 50);
        return;
      }
      window.R2LMicCheck.mount(panel, {
        blockUntilPass: true,
        onPass: () => {
          state.micGateReady = true;
          updateRecordUi();
        },
        onFail: () => {
          state.micGateReady = false;
          updateRecordUi();
        },
      });
    }

    document.addEventListener('r2l-mic-gate', (event) => {
      state.micGateReady = Boolean(event.detail?.ready);
      updateRecordUi();
    });

    async function submitAudio(blob, prompt, telemetry = null) {
      state.status = 'uploading';
      updateRecordUi();
      const formData = new FormData();
      formData.append('access_code', state.accessCode);
      formData.append('pack_id', state.packId || 'practice');
      const isFrame = prompt.check_mode === 'frame';
      formData.append(
        'expected_text',
        prompt.expected_text
          || prompt.story_context
          || prompt.question_en
          || prompt.prompt_en
          // Frame steps have none of the above (they carry `stems` instead) —
          // fall back to the stem text so the backend's required expected_text
          // field is never empty for a frame submission.
          || (isFrame && Array.isArray(prompt.stems) ? prompt.stems.map((s) => s.text_en || '').join(' ') : '')
          || '',
      );
      formData.append('check_mode', prompt.check_mode || 'open');
      formData.append('practice_mode', '1');
      formData.append('max_seconds', String(stepMaxSeconds(prompt)));
      if (isFrame) {
        formData.append('stems', JSON.stringify(prompt.stems || []));
        formData.append('duration_seconds', String(telemetry?.duration_seconds ?? 0));
      }
      formData.append('audio', blob, audioUploadFilename(blob));
      if (telemetry && window.R2LRecorder?.appendTelemetry) {
        window.R2LRecorder.appendTelemetry(formData, telemetry);
      }

      try {
        const res = await fetch('/api/read2lead-speaking-check', { method: 'POST', body: formData });
        const data = await res.json();
        // Analyser heard speech but ASR heard nothing → broken platform encoder;
        // record raw WAV on this machine from now on.
        if (
          data && !data.ok && data.error === 'transcription_failed'
          && telemetry && telemetry.voiced === true && telemetry.engine === 'mr'
        ) {
          window.R2LRecorder?.useWavEngine?.();
        }
        state.lastResult = data;
        state.status = 'done';
        renderResult(data);
      } catch {
        renderResult({ ok: false, message: 'Mạng không ổn định. Con thử lại nhé!' });
      } finally {
        state.status = 'idle';
        updateRecordUi();
      }
    }

    async function startRecording() {
      const prompt = currentStep();
      if (!prompt) return;
      stopPlayback();
      if (!micReady()) {
        renderResult({ ok: false, message: 'Micro chưa sẵn sàng. Con thử trình duyệt khác hoặc cho phép micro nhé.' });
        return;
      }
      if (!state.micGateReady && !window.R2LMicCheck?.sessionPassed?.()) {
        renderResult({ ok: false, message: 'Con bấm Kiểm tra micro ở khung phía trên trước nhé.' });
        return;
      }

      cleanupRecording();
      try {
        const stream = window.R2LRecorder?.getStream
          ? await window.R2LRecorder.getStream()
          : window.R2LMicCheck?.getMicStream
            ? await window.R2LMicCheck.getMicStream()
            : await navigator.mediaDevices.getUserMedia({
                audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
              });
        state.recording = { stream, mediaRecorder: null };
        state.status = 'warming';
        state.warmupMessage = 'Micro đã bật — chờ 3 giây rồi mới nói nhé…';
        updateRecordUi();

        // NOTE: no primeAudioPipeline here. Creating/closing an AudioContext on
        // the live stream right before recording leaves the track feeding
        // silence on Windows/Realtek (the root cause fixed in lesson.astro —
        // the 3s countdown already warms the pipeline naturally).
        if (window.R2LMicCheck?.runMicWarmupCountdown) {
          await window.R2LMicCheck.runMicWarmupCountdown({
            onMessage: (msg) => {
              if (state.status !== 'warming') return;
              state.warmupMessage = msg;
              updateRecordUi();
            },
          });
        } else {
          await new Promise((resolve) => window.setTimeout(resolve, 3000));
        }
        if (state.status !== 'warming') {
          stream.getTracks().forEach((t) => t.stop());
          return;
        }

        // Unified engine: MediaRecorder or raw-PCM WAV per this machine's
        // history, plus a Meet-style live monitor that detects silent capture
        // locally instead of uploading silence to the ASR.
        const recorder = window.R2LRecorder?.createRecorder
          ? window.R2LRecorder.createRecorder(stream)
          : (() => {
              const { mediaRecorder, mimeType } = createRecorder(stream);
              const chunks = [];
              let resolveStop = null;
              const stopped = new Promise((resolve) => { resolveStop = resolve; });
              mediaRecorder.addEventListener('dataavailable', (event) => {
                if (event.data?.size > 0) chunks.push(event.data);
              });
              mediaRecorder.addEventListener('stop', () => {
                resolveStop(new Blob(chunks, { type: mediaRecorder.mimeType || mimeType || 'audio/mp4' }));
              });
              return {
                engine: 'mr',
                mimeType,
                start() { mediaRecorder.start(250); },
                stop() { stopMediaRecorder(mediaRecorder); return stopped; },
              };
            })();
        const monitor = window.R2LRecorder?.startMonitor
          ? await window.R2LRecorder.startMonitor(stream, {
              onSilenceHint: () => {
                const statusEl = document.getElementById('speaking-status');
                if (statusEl && state.status === 'recording') {
                  statusEl.textContent = 'Minny chưa thấy tiếng — con nói TO hơn nhé!';
                }
              },
            })
          : { available: false, peak: () => -1, voiced: () => true, stop: () => {} };

        let finished = false;
        const finishRecording = async () => {
          if (finished) return;
          finished = true;
          if (state.timerId) {
            clearInterval(state.timerId);
            state.timerId = null;
          }
          // state.secondsLeft still holds the countdown value at the moment
          // recording stopped (cleanupRecording, which resets it, hasn't run
          // yet) — so target minus remaining gives actual elapsed seconds.
          const elapsedSeconds = Math.max(0, stepMaxSeconds(prompt) - state.secondsLeft);
          let blob = null;
          try {
            blob = await recorder.stop();
          } catch {
            blob = null;
          }
          safeStopMonitor(monitor);
          stream.getTracks().forEach((t) => t.stop());
          const voiced = window.R2LRecorder?.recordingLooksVoiced
            ? window.R2LRecorder.recordingLooksVoiced(monitor, blob?.size || 0)
            : (monitor.available ? monitor.voiced() : true);
          if (blob && blob.size > 0 && !voiced) {
            // Silent capture caught on-device: relax constraints for the next
            // try instead of sending silence to the server.
            window.R2LRecorder?.bumpProfile?.();
            state.status = 'idle';
            renderResult({ ok: false, message: 'Minny không thấy tiếng vào micro. Con thử lại — nói TO hơn, hoặc kiểm tra micro ở khung phía trên nhé.' });
            updateRecordUi();
            return;
          }
          if (blob && blob.size > 0) {
            submitAudio(blob, prompt, {
              peak: monitor.available ? monitor.peak() : -1,
              voiced,
              engine: recorder.engine || 'mr',
              mimeType: blob.type || recorder.mimeType || '',
              duration_seconds: elapsedSeconds,
            });
          } else {
            state.status = 'idle';
            renderResult({ ok: false, message: 'Không thu được tiếng. Con thử nói to hơn nhé.' });
            updateRecordUi();
          }
        };

        state.recording = { stream, mediaRecorder: null, recorderCtl: recorder, monitor, finishRecording };
        state.status = 'recording';
        state.secondsLeft = stepMaxSeconds(prompt);
        recorder.start();
        updateRecordUi();

        state.timerId = window.setInterval(() => {
          state.secondsLeft -= 1;
          updateRecordUi();
          if (state.secondsLeft <= 0) {
            finishRecording();
          }
        }, 1000);
      } catch (error) {
        const message = window.R2LMicCheck?.helpMessage?.(error)
          || 'Không mở được micro. Con nhờ bố mẹ cho phép micro nhé.';
        renderResult({ ok: false, message });
        window.R2LMicCheck?.focusMicHelpInShell?.(shell);
        cleanupRecording();
        updateRecordUi();
      }
    }

    function stopRecording() {
      if (state.recording?.finishRecording) {
        state.recording.finishRecording();
        return;
      }
      if (state.recording?.mediaRecorder) {
        stopMediaRecorder(state.recording.mediaRecorder);
      }
      if (state.timerId) {
        clearInterval(state.timerId);
        state.timerId = null;
      }
    }

    async function loadSession() {
      clearError();
      const code = codeInput.value.trim().toUpperCase();
      if (!code) {
        showError('Vui lòng nhập mã học sinh.');
        return;
      }

      loadBtn.disabled = true;
      loadBtn.textContent = 'Đang tải...';

      try {
        const res = await fetch(`/api/minny-speaking-context?code=${encodeURIComponent(code)}`);
        const data = await res.json();
        if (!res.ok || !data.ok) {
          showError(data.message || 'Không tìm thấy mã học sinh.');
          shell.classList.add('hidden');
          return;
        }

        state.accessCode = code;
        state.packId = data.pack_id || 'practice';
        state.modes = Array.isArray(data.modes) ? data.modes : [];
        state.activeModeId = state.modes[0]?.id || 'retell';
        state.stepIndex = 0;
        state.modePicked = false;

        document.getElementById('minny-greeting').textContent = data.greeting_vi || 'Chào con! Minny sẵn sàng luyện nói.';
        document.getElementById('practice-stats').textContent =
          data.practice_count_this_week > 0
            ? `Tuần này con luyện ${data.practice_count_this_week} lần`
            : 'Buổi luyện đầu tuần — cứ thoải mái thử nhé!';
        document.getElementById('profile-link').href = data.profile_link || `/ho-so?code=${encodeURIComponent(code)}`;

        if (!data.has_story && !data.pack_id) {
          document.getElementById('minny-greeting').textContent = data.message_vi || data.greeting_vi;
        }

        codeCard.classList.add('hidden');
        shell.classList.remove('hidden');
        mountSpeakingMicCheck();
        showModePicker();
        renderModeCards();
        setMinnyMood('idle');

        const url = new URL(window.location.href);
        url.searchParams.set('code', code);
        window.history.replaceState({}, '', url);
      } catch {
        showError('Mạng không ổn định. Vui lòng thử lại.');
      } finally {
        loadBtn.disabled = false;
        loadBtn.textContent = 'Bắt đầu';
      }
    }

    document.getElementById('speaking-listen')?.addEventListener('click', () => {
      playMinnyAudio(currentStep());
    });

    document.getElementById('speaking-record')?.addEventListener('click', () => {
      if (state.status === 'recording') stopRecording();
      else startRecording();
    });

    document.getElementById('speaking-retry')?.addEventListener('click', () => {
      document.getElementById('speaking-result').classList.add('hidden');
      document.getElementById('speaking-actions').classList.add('hidden');
      renderStep();
      updateRecordUi();
    });

    document.getElementById('speaking-next')?.addEventListener('click', () => {
      if (state.activeModeId === 'homework' && state.homeworkComplete) {
        state.homeworkComplete = false;
        state.homeworkResults = [];
        showModePicker();
        return;
      }
      const mode = activeMode();
      if (mode && state.stepIndex < mode.steps.length - 1) {
        state.stepIndex += 1;
        renderStep();
        updateRecordUi();
      }
    });

    document.getElementById('back-to-modes')?.addEventListener('click', () => {
      stopPlayback();
      cleanupRecording();
      document.getElementById('speaking-result').classList.add('hidden');
      document.getElementById('speaking-actions').classList.add('hidden');
      showModePicker();
    });

    // ── Free Talking (Phase 8a) ──────────────────────────────────────────
    // Separate state object from `state` above: Free Talking is not a
    // stepped mode (no steps[]/stepIndex), so it does not touch any
    // homework/retell/questions state. Voice is browser speechSynthesis
    // only in this change; real TTS audio_b64 + tap-to-play land later.
    const ft = {
      sessionId: null,
      turnsLeft: 12,
      secondsLeft: 300,
      countdownId: null,
      recTimerId: null,
      recSecondsLeft: DEFAULT_MAX_SECONDS,
      recording: null,
      ended: false,
      awaitingReply: false,
      sentenceCount: 0,
      turnsUsed: 0,
      flaggedSession: false,
    };

    function ftFormatTime(totalSeconds) {
      const s = Math.max(0, Math.floor(totalSeconds));
      const m = Math.floor(s / 60);
      const r = s % 60;
      return `${m}:${String(r).padStart(2, '0')}`;
    }

    function ftUpdateTimerDisplay() {
      const el = document.getElementById('free-talk-timer');
      if (!el) return;
      el.textContent = ftFormatTime(ft.secondsLeft);
      el.classList.remove('minny-timer--warn', 'minny-timer--settled');
      if (ft.secondsLeft <= 0) el.classList.add('minny-timer--settled');
      else if (ft.secondsLeft <= 30) el.classList.add('minny-timer--warn');

      const announceEl = document.getElementById('free-talk-timer-announce');
      if (announceEl && [60, 30, 10].includes(ft.secondsLeft)) {
        announceEl.textContent = `Còn ${ftFormatTime(ft.secondsLeft)}`;
      }
    }

    function ftRenderDots() {
      const el = document.getElementById('free-talk-dots');
      if (!el) return;
      const used = Math.max(0, Math.min(12, 12 - ft.turnsLeft));
      el.setAttribute('aria-label', `Còn ${ft.turnsLeft} lượt trong tổng 12`);
      el.innerHTML = Array.from({ length: 12 }, (_, i) => {
        const cls = i < used ? 'minny-turn-dot minny-turn-dot--used' : 'minny-turn-dot';
        return `<span class="${cls}" aria-hidden="true"></span>`;
      }).join('');
    }

    function ftStartCountdown() {
      if (ft.countdownId) clearInterval(ft.countdownId);
      ft.countdownId = window.setInterval(() => {
        ft.secondsLeft -= 1;
        ftUpdateTimerDisplay();
        if (ft.secondsLeft <= 0) {
          clearInterval(ft.countdownId);
          ft.countdownId = null;
          ftHandleCapReached('time');
        }
      }, 1000);
    }

    function ftStopCountdown() {
      if (ft.countdownId) {
        clearInterval(ft.countdownId);
        ft.countdownId = null;
      }
    }

    function ftSetThinking(isThinking) {
      const avatar = document.querySelector('.minny-avatar');
      const eyebrow = document.getElementById('free-talk-status-eyebrow');
      const dots = document.getElementById('free-talk-thinking-dots');
      avatar?.classList.toggle('minny-avatar--thinking', isThinking);
      dots?.classList.toggle('is-visible', isThinking);
      if (eyebrow) {
        eyebrow.textContent = isThinking ? 'Minny đang nghĩ...' : 'Đợi con nói';
        eyebrow.style.color = isThinking ? 'var(--gold-light)' : '';
      }
      ft.awaitingReply = isThinking;
      const recordBtn = document.getElementById('free-talk-record');
      if (recordBtn) recordBtn.disabled = isThinking;
      ftUpdateRecordUi();
    }

    function ftAppendReplyBubble(text, mood) {
      const list = document.getElementById('free-talk-transcript');
      if (!list || !text) return;
      const bubble = document.createElement('div');
      bubble.className = 'minny-transcript__reply';
      bubble.textContent = text;
      list.appendChild(bubble);
      list.scrollTop = list.scrollHeight;
      setMinnyMood(mood || 'idle');
    }

    function ftAppendKidChip(durationSeconds) {
      const list = document.getElementById('free-talk-transcript');
      if (!list) return;
      const chip = document.createElement('div');
      chip.className = 'minny-transcript__kid-chip';
      const rounded = Math.round(durationSeconds);
      chip.innerHTML = Number.isFinite(rounded)
        ? `con vừa nói xong <span class="hidden lg:inline">· ${rounded} giây</span>`
        : 'con vừa nói xong';
      list.appendChild(chip);
      list.scrollTop = list.scrollHeight;
    }

    function ftHidePlayChip() {
      const chip = document.getElementById('free-talk-play-chip');
      chip?.classList.remove('is-visible');
      if (chip) chip.onclick = null;
    }

    // Real TTS audio when available; falls back to browser speechSynthesis
    // when audio_b64 is absent (server-side TTS failure) or when .play()
    // rejects (iOS Safari autoplay-gesture block) -- in the latter case a
    // tap-to-play chip appears inside Minny's bubble instead of failing
    // silently, per the Phase 7b design.
    function playConversationAudio(audioB64, contentType, fallbackText) {
      ftHidePlayChip();
      if (!audioB64) {
        speakEnglish(fallbackText);
        return;
      }
      stopPlayback();
      const audio = new Audio(`data:${contentType || 'audio/mpeg'};base64,${audioB64}`);
      state.activeAudio = audio;
      audio.addEventListener('ended', () => {
        setMinnyMood('idle');
        state.activeAudio = null;
      });
      audio.play().catch(() => {
        const chip = document.getElementById('free-talk-play-chip');
        if (!chip) {
          speakEnglish(fallbackText);
          return;
        }
        chip.classList.add('is-visible');
        chip.onclick = () => {
          ftHidePlayChip();
          audio.play().catch(() => speakEnglish(fallbackText));
        };
      });
    }

    function ftReset() {
      ft.sessionId = null;
      ft.turnsLeft = 12;
      ft.secondsLeft = 300;
      ft.ended = false;
      ft.awaitingReply = false;
      ft.sentenceCount = 0;
      ft.turnsUsed = 0;
      ft.flaggedSession = false;
      ftStopCountdown();
      ftCleanupRecording();
    }

    function enterFreeTalking() {
      ftReset();
      document.querySelector('[data-r2l-mic-check]')?.classList.add('hidden');
      modePicker?.classList.add('hidden');
      practiceScreen?.classList.add('hidden');
      document.getElementById('free-talk-screen')?.classList.remove('hidden');
      document.getElementById('free-talk-wrapup')?.classList.add('hidden');
      document.getElementById('free-talk-summary')?.classList.add('hidden');
      const transcriptEl = document.getElementById('free-talk-transcript');
      if (transcriptEl) transcriptEl.innerHTML = '';
      ftSetThinking(false);
      ftRenderDots();
      ftUpdateTimerDisplay();
      startFreeTalkSession();
    }

    function ftExitToModes() {
      ftReset();
      document.getElementById('free-talk-screen')?.classList.add('hidden');
      showModePicker();
    }

    async function startFreeTalkSession() {
      const recordBtn = document.getElementById('free-talk-record');
      if (recordBtn) recordBtn.disabled = true;
      try {
        const res = await fetch('/api/minny-conversation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ access_code: state.accessCode, action: 'start' }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          ftExitToModes();
          showError(data.message || 'Không mở được phiên trò chuyện. Con thử lại nhé!');
          return;
        }
        ft.sessionId = data.session_id;
        ft.turnsLeft = data.turns_left ?? 12;
        ft.secondsLeft = data.seconds_left ?? 300;
        ftRenderDots();
        ftUpdateTimerDisplay();
        ftStartCountdown();
        ftAppendReplyBubble(data.greeting?.text_en, 'idle');
        playConversationAudio(data.greeting?.audio_b64, data.greeting?.content_type, data.greeting?.text_en || '');
        if (recordBtn) recordBtn.disabled = false;
      } catch {
        ftExitToModes();
        showError('Mạng không ổn định. Con thử lại nhé!');
      }
    }

    function ftCleanupRecording() {
      if (ft.recTimerId) {
        clearInterval(ft.recTimerId);
        ft.recTimerId = null;
      }
      safeStopMonitor(ft.recording?.monitor);
      if (ft.recording?.stream) {
        ft.recording.stream.getTracks().forEach((t) => t.stop());
      }
      ft.recording = null;
      ftUpdateRecordUi();
    }

    function ftUpdateRecordUi(message) {
      const btn = document.getElementById('free-talk-record');
      const label = document.getElementById('free-talk-record-label');
      const wave = document.getElementById('free-talk-waveform');
      if (!btn) return;
      const recording = ft.recording?.status === 'recording';
      btn.classList.toggle('is-recording', recording);
      wave?.classList.toggle('is-recording', recording);
      btn.setAttribute('aria-label', recording ? 'Dừng ghi âm' : 'Nhấn để nói');
      if (label) {
        label.textContent = message
          || (recording ? 'Đang nghe con nói...' : (ft.awaitingReply ? 'Đợi Minny trả lời...' : 'Nhấn để nói'));
      }
    }

    async function ftStartRecording() {
      if (ft.ended || ft.awaitingReply) return;
      stopPlayback();
      if (!micReady()) {
        ftUpdateRecordUi('Micro chưa sẵn sàng. Con thử trình duyệt khác nhé!');
        return;
      }
      if (!state.micGateReady && !window.R2LMicCheck?.sessionPassed?.()) {
        ftUpdateRecordUi('Con bấm Kiểm tra micro ở khung phía trên trước nhé.');
        return;
      }

      ftCleanupRecording();
      try {
        const stream = window.R2LRecorder?.getStream
          ? await window.R2LRecorder.getStream()
          : window.R2LMicCheck?.getMicStream
            ? await window.R2LMicCheck.getMicStream()
            : await navigator.mediaDevices.getUserMedia({
                audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
              });

        ft.recording = { stream, status: 'warming' };
        ftUpdateRecordUi('Micro đã bật — chờ 3 giây rồi mới nói nhé…');

        if (window.R2LMicCheck?.runMicWarmupCountdown) {
          await window.R2LMicCheck.runMicWarmupCountdown({
            onMessage: (msg) => {
              if (ft.recording?.status !== 'warming') return;
              ftUpdateRecordUi(msg);
            },
          });
        } else {
          await new Promise((resolve) => window.setTimeout(resolve, 3000));
        }
        if (!ft.recording || ft.recording.status !== 'warming') {
          stream.getTracks().forEach((t) => t.stop());
          return;
        }

        const recorder = window.R2LRecorder?.createRecorder
          ? window.R2LRecorder.createRecorder(stream)
          : (() => {
              const { mediaRecorder, mimeType } = createRecorder(stream);
              const chunks = [];
              let resolveStop = null;
              const stopped = new Promise((resolve) => { resolveStop = resolve; });
              mediaRecorder.addEventListener('dataavailable', (event) => {
                if (event.data?.size > 0) chunks.push(event.data);
              });
              mediaRecorder.addEventListener('stop', () => {
                resolveStop(new Blob(chunks, { type: mediaRecorder.mimeType || mimeType || 'audio/mp4' }));
              });
              return {
                engine: 'mr',
                mimeType,
                start() { mediaRecorder.start(250); },
                stop() { stopMediaRecorder(mediaRecorder); return stopped; },
              };
            })();

        const monitor = window.R2LRecorder?.startMonitor
          ? await window.R2LRecorder.startMonitor(stream, {
              onSilenceHint: () => {
                if (ft.recording?.status === 'recording') {
                  ftUpdateRecordUi('Minny chưa thấy tiếng — con nói TO hơn nhé!');
                }
              },
            })
          : { available: false, peak: () => -1, voiced: () => true, stop: () => {} };

        let finished = false;
        const finishRecording = async () => {
          if (finished) return;
          finished = true;
          if (ft.recTimerId) {
            clearInterval(ft.recTimerId);
            ft.recTimerId = null;
          }
          const elapsedSeconds = Math.max(0, DEFAULT_MAX_SECONDS - ft.recSecondsLeft);
          let blob = null;
          try {
            blob = await recorder.stop();
          } catch {
            blob = null;
          }
          safeStopMonitor(monitor);
          stream.getTracks().forEach((t) => t.stop());
          const voiced = window.R2LRecorder?.recordingLooksVoiced
            ? window.R2LRecorder.recordingLooksVoiced(monitor, blob?.size || 0)
            : (monitor.available ? monitor.voiced() : true);

          if (blob && blob.size > 0 && !voiced) {
            window.R2LRecorder?.bumpProfile?.();
            ft.recording = null;
            ftUpdateRecordUi('Minny không thấy tiếng vào micro. Con thử lại nhé!');
            return;
          }
          if (blob && blob.size > 0) {
            ftSubmitAudio(blob, elapsedSeconds);
          } else {
            ft.recording = null;
            ftUpdateRecordUi('Không thu được tiếng. Con thử nói to hơn nhé.');
          }
        };

        ft.recording = { stream, status: 'recording', recorderCtl: recorder, monitor, finishRecording };
        ft.recSecondsLeft = DEFAULT_MAX_SECONDS;
        recorder.start();
        ftUpdateRecordUi();

        ft.recTimerId = window.setInterval(() => {
          ft.recSecondsLeft -= 1;
          if (ft.recSecondsLeft <= 0) finishRecording();
        }, 1000);
      } catch (error) {
        const message = window.R2LMicCheck?.helpMessage?.(error)
          || 'Không mở được micro. Con nhờ bố mẹ cho phép micro nhé.';
        ftUpdateRecordUi(message);
        window.R2LMicCheck?.focusMicHelpInShell?.(shell);
        ftCleanupRecording();
      }
    }

    function ftStopRecording() {
      if (ft.recording?.finishRecording) {
        ft.recording.finishRecording();
      }
    }

    async function ftSubmitAudio(blob, durationSeconds) {
      ftSetThinking(true);
      const formData = new FormData();
      formData.append('access_code', state.accessCode);
      formData.append('pack_id', 'general');
      formData.append('expected_text', 'free_talking_no_score');
      formData.append('check_mode', 'open');
      formData.append('practice_mode', '1');
      formData.append('max_seconds', String(DEFAULT_MAX_SECONDS));
      formData.append('audio', blob, audioUploadFilename(blob));

      try {
        const res = await fetch('/api/read2lead-speaking-check', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok || !data.ok || !data.transcript) {
          ftSetThinking(false);
          ftUpdateRecordUi('Minny chưa nghe rõ. Con thử nói lại nhé!');
          return;
        }
        ftAppendKidChip(durationSeconds);
        ft.sentenceCount += (data.transcript.match(/[.!?]+/g) || [1]).length;
        await ftSubmitTurn(data.transcript);
      } catch {
        ftSetThinking(false);
        ftUpdateRecordUi('Mạng không ổn định. Con thử lại nhé!');
      }
    }

    async function ftSubmitTurn(transcript) {
      try {
        const res = await fetch('/api/minny-conversation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            access_code: state.accessCode,
            action: 'turn',
            session_id: ft.sessionId,
            transcript,
          }),
        });
        const data = await res.json();

        if (!res.ok || !data.ok) {
          ftSetThinking(false);
          ftUpdateRecordUi('Minny chưa trả lời được. Con thử nói lại nhé!');
          return;
        }

        if (data.ended && !data.reply_en) {
          // Session expired/missing server-side — rare edge case, not a cap.
          ftSetThinking(false);
          ftHandleCapReached('expired', data.message_vi);
          return;
        }

        ft.turnsUsed += 1;
        ft.turnsLeft = data.turns_left ?? Math.max(0, ft.turnsLeft - 1);
        ft.secondsLeft = data.seconds_left ?? ft.secondsLeft;
        ftRenderDots();
        ftUpdateTimerDisplay();
        ftSetThinking(false);

        if (data.ended) {
          ftAppendReplyBubble(data.reply_en, data.mood || 'celebrate');
          playConversationAudio(data.audio_b64, data.content_type, data.reply_en);
          if (data.flagged) ft.flaggedSession = true;
          ftHandleCapReached(data.flagged ? 'flagged' : (ft.secondsLeft <= 0 ? 'time' : 'turns'));
          return;
        }

        ftAppendReplyBubble(data.reply_en, data.mood || 'idle');
        playConversationAudio(data.audio_b64, data.content_type, data.reply_en);
      } catch {
        ftSetThinking(false);
        ftUpdateRecordUi('Mạng không ổn định. Con thử lại nhé!');
      }
    }

    function ftHandleCapReached(reason, overrideText) {
      ft.ended = true;
      ftStopCountdown();
      ftCleanupRecording();
      const recordBtn = document.getElementById('free-talk-record');
      if (recordBtn) recordBtn.disabled = true;
      setMinnyMood('celebrate');

      const texts = {
        time: 'Hôm nay nói chuyện vui quá! Hẹn gặp lại con nhé!',
        turns: 'Con nói giỏi quá! Nghỉ tay một tí rồi tiếp nhé!',
        flagged: 'Con nói giỏi quá! Nghỉ tay một tí rồi tiếp nhé!',
        expired: overrideText || 'Phiên trò chuyện đã kết thúc rồi. Con bắt đầu phiên mới nhé!',
      };

      const wrapupText = document.getElementById('free-talk-wrapup-text');
      if (wrapupText) wrapupText.textContent = texts[reason] || texts.time;
      document.getElementById('free-talk-wrapup')?.classList.remove('hidden');
    }

    function ftShowSummary() {
      document.getElementById('free-talk-wrapup')?.classList.add('hidden');
      const minutesUsed = Math.max(1, Math.round((300 - ft.secondsLeft) / 60));

      const statsEl = document.getElementById('free-talk-summary-stats');
      if (statsEl) {
        statsEl.innerHTML = [
          { value: ft.turnsUsed, label: 'lượt trò chuyện' },
          { value: ft.sentenceCount, label: 'câu con đã nói' },
          { value: minutesUsed, label: 'phút trò chuyện' },
        ].map((s) => `
          <div class="minny-summary-stat">
            <strong>${s.value}</strong>
            <span>${s.label}</span>
          </div>
        `).join('');
      }
      const lineEl = document.getElementById('free-talk-summary-line');
      if (lineEl) lineEl.textContent = 'Con nói rõ ràng và tự tin lắm. Ngày mai kể tiếp cho Minny nghe nhé!';

      document.getElementById('free-talk-summary')?.classList.remove('hidden');

      if (state.accessCode && state.packId) {
        fetch('/api/minny-practice-log', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            access_code: state.accessCode,
            pack_id: state.packId,
            prompt_id: 'free_talk_summary',
            mode_id: 'free_talk',
            summary: {
              mode: 'free_talk',
              turns: ft.turnsUsed,
              sentence_count: ft.sentenceCount,
              minutes: minutesUsed,
              flagged: ft.flaggedSession === true,
            },
          }),
        }).catch(() => {});
      }
    }

    document.getElementById('free-talk-record')?.addEventListener('click', () => {
      if (ft.recording?.status === 'recording') {
        ftStopRecording();
      } else {
        ftStartRecording();
      }
    });

    document.getElementById('free-talk-end')?.addEventListener('click', () => {
      ft.ended = true;
      ftStopCountdown();
      ftCleanupRecording();
      ftShowSummary();
    });

    document.getElementById('free-talk-wrapup-cta')?.addEventListener('click', ftShowSummary);

    document.getElementById('free-talk-summary-again')?.addEventListener('click', () => {
      document.getElementById('free-talk-summary')?.classList.add('hidden');
      enterFreeTalking();
    });

    document.getElementById('free-talk-summary-home')?.addEventListener('click', ftExitToModes);

    loadBtn?.addEventListener('click', loadSession);
  </script>
  <script src={r2lRecorderSrc} defer></script>
  <script src="/scripts/r2l-mic-check.js" defer></script>
</BaseLayout>
