---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MicCheckPanel from '../../components/read2lead/v2/MicCheckPanel.astro';
---

<BaseLayout
  title="Luyện nói với Minny — Felix Coaching"
  description="Con luyện nói với Minny trước buổi coaching với Felix — nhận gợi ý nhẹ nhàng và luyện tiếp."
  robots="noindex, follow"
>
  <Header read2LeadState={false} />

  <main id="main" class="min-h-screen bg-navy-950">
    <section class="mx-auto max-w-lg px-4 py-6 sm:px-6 sm:py-8">
      <p class="text-center text-xs font-extrabold uppercase tracking-widest text-accent">Felix Coaching</p>
      <h1 class="mt-1 text-center font-display text-2xl font-extrabold text-cream sm:text-3xl">Luyện nói với Minny</h1>
      <p class="mt-2 text-center text-sm text-cream-muted">
        Con nói — Minny nghe — chuẩn bị cho buổi coaching với Felix.
      </p>

      <div id="speaking-code-card" class="mt-6 rounded-3xl bg-navy-900/60 p-5 shadow-lg shadow-black/20">
        <label for="speaking-code" class="text-sm font-semibold text-cream">Mã học sinh</label>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row">
          <input
            id="speaking-code"
            maxlength="40"
            autocomplete="off"
            placeholder="VD: R2L-LINH-8F3KQ2"
            class="min-h-[52px] w-full rounded-2xl border border-cream/10 bg-navy-950 px-4 text-base uppercase text-cream placeholder:normal-case placeholder:text-cream-dim/70 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          />
          <button id="speaking-load" type="button" class="minny-btn minny-btn--primary shrink-0 px-8">
            Bắt đầu
          </button>
        </div>
      </div>

      <p id="speaking-error" class="mt-4 hidden rounded-2xl bg-red-500/15 px-4 py-3 text-sm text-red-200"></p>

      <div id="speaking-shell" class="mt-6 hidden space-y-6">
        <!-- Hero: Minny + greeting -->
        <div class="minny-hero rounded-3xl bg-navy-900/50 p-6 text-center shadow-lg shadow-black/15">
          <div class="minny-avatar mx-auto">
            <video
              id="minny-video"
              class="minny-avatar__media hidden"
              poster="/assets/minny/minny_idle.png"
              autoplay
              loop
              muted
              playsinline
              aria-hidden="true"
            ></video>
            <img
              id="minny-fallback"
              src="/assets/minny/minny_idle.png"
              alt="Minny"
              width="200"
              height="200"
              class="minny-avatar__media"
            />
          </div>
          <p id="minny-greeting" class="mt-4 text-lg font-bold leading-snug text-cream"></p>
        </div>

        <MicCheckPanel />

        <!-- Mode picker: large tap cards -->
        <div id="mode-picker" class="space-y-3">
          <p class="text-center text-sm font-semibold text-cream-muted">Con chọn cách luyện hôm nay</p>
          <div id="mode-cards" class="grid grid-cols-1 gap-4 sm:grid-cols-2"></div>
        </div>

        <!-- Practice wizard (hidden until mode picked) -->
        <div id="practice-screen" class="hidden space-y-5">
          <div class="flex items-center justify-between gap-3">
            <button id="back-to-modes" type="button" class="minny-back-link">← Chọn cách luyện</button>
            <div id="progress-dots" class="flex items-center gap-2" aria-label="Tiến độ"></div>
          </div>

          <div class="minny-bubble rounded-3xl bg-cream/10 p-5 shadow-md shadow-black/10">
            <p id="prompt-vi" class="text-lg font-bold leading-relaxed text-cream"></p>
            <p id="prompt-en" class="mt-2 text-sm leading-relaxed text-cream-muted"></p>
          </div>

          <button id="speaking-listen" type="button" class="minny-btn minny-btn--listen w-full">
            🔊 Nghe Minny
          </button>

          <div class="space-y-2">
            <button id="speaking-record" type="button" class="minny-btn minny-btn--record w-full">🎤 Con nói</button>
            <p id="speaking-status" class="text-center text-sm text-cream-muted"></p>
            <span id="speaking-timer" class="hidden block text-center text-lg font-bold text-gold"></span>
          </div>

          <div id="speaking-result" class="hidden rounded-3xl bg-navy-900/70 p-5 shadow-md shadow-black/10"></div>

          <div id="speaking-actions" class="hidden grid grid-cols-1 gap-3 sm:grid-cols-2">
            <button id="speaking-retry" type="button" class="minny-btn minny-btn--secondary">Luyện lại</button>
            <button id="speaking-next" type="button" class="minny-btn minny-btn--primary">Tiếp theo</button>
          </div>
        </div>

        <!-- Compact footer -->
        <div class="rounded-2xl bg-cream/5 px-4 py-3 text-center text-sm text-cream-muted">
          <p id="practice-stats" class="font-medium"></p>
          <p class="mt-2">
            <a id="coaching-link" href="/coaching#book" class="font-bold text-accent underline">Đặt lịch coaching</a>
            <span class="mx-2 text-cream-dim">·</span>
            <a id="profile-link" href="/hoc-sinh" class="font-semibold text-cream underline">Hồ sơ con</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .minny-avatar {
      width: 11rem;
      height: 11rem;
    }

    @media (min-width: 640px) {
      .minny-avatar {
        width: 13rem;
        height: 13rem;
      }
    }

    .minny-avatar__media {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .minny-btn {
      display: flex;
      min-height: 56px;
      align-items: center;
      justify-content: center;
      border-radius: 1.25rem;
      border: 3px solid transparent;
      padding: 0.9rem 1.25rem;
      font-size: 1.125rem;
      font-weight: 800;
      transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    }

    .minny-btn:active:not(:disabled) {
      transform: scale(0.98);
    }

    .minny-btn--primary {
      background: rgb(74 222 128);
      color: rgb(10 14 26);
      border-color: rgb(134 239 172);
      box-shadow: 0 4px 0 rgb(22 101 52);
    }

    .minny-btn--primary:hover:not(:disabled) {
      background: rgb(134 239 172);
    }

    .minny-btn--record {
      background: rgb(212 166 78);
      color: rgb(10 14 26);
      border-color: rgb(250 220 160);
      box-shadow: 0 4px 0 rgb(120 90 40);
    }

    .minny-btn--record:hover:not(:disabled) {
      background: rgb(242 204 126);
    }

    .minny-btn--listen {
      background: rgb(200 143 56 / 0.18);
      color: rgb(242 204 126);
      border-color: rgb(200 143 56 / 0.45);
      min-height: 52px;
    }

    .minny-btn--listen:hover:not(:disabled) {
      background: rgb(200 143 56 / 0.28);
    }

    .minny-mode-card {
      display: flex;
      min-height: 7.5rem;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 1.5rem;
      border: 3px solid rgb(245 230 211 / 0.12);
      background: rgb(23 53 74 / 0.7);
      padding: 1.5rem 1rem;
      text-align: center;
      box-shadow: 0 6px 0 rgb(0 0 0 / 0.2);
      transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    }

    .minny-mode-card:hover {
      border-color: rgb(200 143 56 / 0.45);
      background: rgb(29 63 88 / 0.85);
      transform: translateY(-2px);
    }

    .minny-mode-card:active {
      transform: translateY(2px);
      box-shadow: 0 2px 0 rgb(0 0 0 / 0.2);
    }

    .minny-mode-card__emoji {
      font-size: 2.25rem;
      line-height: 1;
    }

    .minny-mode-card__title {
      font-size: 1.125rem;
      font-weight: 800;
      color: rgb(245 230 211);
    }

    .minny-mode-card__desc {
      font-size: 0.8rem;
      line-height: 1.4;
      color: rgb(245 230 211 / 0.6);
    }

    .minny-btn--secondary {
      background: rgb(245 230 211 / 0.1);
      color: rgb(245 230 211);
      border-color: rgb(245 230 211 / 0.25);
    }

    .minny-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .minny-back-link {
      font-size: 0.875rem;
      font-weight: 600;
      color: rgb(217 199 164);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .minny-back-link:hover {
      color: rgb(245 230 211);
    }

    .minny-dot {
      width: 0.65rem;
      height: 0.65rem;
      border-radius: 9999px;
      background: rgb(245 230 211 / 0.2);
      transition: background 0.15s ease, transform 0.15s ease;
    }

    .minny-dot--active {
      background: rgb(200 143 56);
      transform: scale(1.2);
    }

    .minny-dot--done {
      background: rgb(74 222 128 / 0.6);
    }

    .minny-word {
      display: inline-block;
      margin: 0.15rem;
      border-radius: 0.5rem;
      padding: 0.2rem 0.5rem;
      font-size: 0.85rem;
      font-weight: 700;
    }

    .minny-word--good {
      background: rgb(74 222 128 / 0.2);
      color: rgb(187 247 208);
    }

    .minny-word--close {
      background: rgb(251 191 36 / 0.2);
      color: rgb(254 215 170);
    }

    .minny-word--miss {
      background: rgb(245 230 211 / 0.1);
      color: rgb(245 230 211 / 0.75);
    }
  </style>

  <script>
    const params = new URLSearchParams(window.location.search);
    const codeInput = document.getElementById('speaking-code');
    const loadBtn = document.getElementById('speaking-load');
    const codeCard = document.getElementById('speaking-code-card');
    const shell = document.getElementById('speaking-shell');
    const errorEl = document.getElementById('speaking-error');
    const modePicker = document.getElementById('mode-picker');
    const practiceScreen = document.getElementById('practice-screen');
    const DEFAULT_MAX_SECONDS = 30;

    const MODE_EMOJI = { retell: '📖', questions: '💬' };

    const state = {
      accessCode: '',
      packId: '',
      modes: [],
      activeModeId: 'retell',
      modePicked: false,
      stepIndex: 0,
      recording: null,
      status: 'idle',
      secondsLeft: DEFAULT_MAX_SECONDS,
      timerId: null,
      lastResult: null,
      activeAudio: null,
      videoAvailable: {},
      micGateReady: false,
    };

    if (params.get('code')) {
      codeInput.value = params.get('code').toUpperCase();
      loadSession();
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function minnyAssetBase(mood) {
      const file = ['idle', 'listen', 'celebrate', 'encourage'].includes(mood) ? mood : 'idle';
      return `/assets/minny/minny_${file}`;
    }

    function showMinnyPng(mood) {
      const img = document.getElementById('minny-fallback');
      const video = document.getElementById('minny-video');
      if (!img) return;
      img.src = `${minnyAssetBase(mood)}.png`;
      img.classList.remove('hidden');
      if (video) video.classList.add('hidden');
    }

    function setMinnyMood(mood) {
      const video = document.getElementById('minny-video');
      const img = document.getElementById('minny-fallback');
      const base = minnyAssetBase(mood);

      if (!video) {
        showMinnyPng(mood);
        return;
      }

      if (state.videoAvailable[mood] === false) {
        showMinnyPng(mood);
        return;
      }

      const tryPlay = (ext) => {
        video.onerror = () => {
          if (ext === 'mp4') {
            video.src = `${base}.webm`;
            video.onerror = () => {
              state.videoAvailable[mood] = false;
              showMinnyPng(mood);
            };
          } else {
            state.videoAvailable[mood] = false;
            showMinnyPng(mood);
          }
        };
        video.onloadeddata = () => {
          state.videoAvailable[mood] = true;
          video.classList.remove('hidden');
          if (img) img.classList.add('hidden');
          video.play().catch(() => showMinnyPng(mood));
        };
        video.poster = `${base}.png`;
        video.src = `${base}.${ext}`;
        video.load();
      };

      tryPlay('mp4');
    }

    function showModePicker() {
      state.modePicked = false;
      modePicker?.classList.remove('hidden');
      practiceScreen?.classList.add('hidden');
      setMinnyMood('idle');
    }

    function enterPracticeMode(modeId) {
      state.activeModeId = modeId;
      state.stepIndex = 0;
      state.modePicked = true;
      stopPlayback();
      modePicker?.classList.add('hidden');
      practiceScreen?.classList.remove('hidden');
      renderStep();
      updateRecordUi();
    }

    function showError(message) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }

    function clearError() {
      errorEl.classList.add('hidden');
      errorEl.textContent = '';
    }

    function activeMode() {
      return state.modes.find((mode) => mode.id === state.activeModeId) || state.modes[0] || null;
    }

    function currentStep() {
      const mode = activeMode();
      if (!mode) return null;
      return mode.steps[state.stepIndex] || null;
    }

    function stepMaxSeconds(step) {
      const n = Number(step?.max_seconds);
      return Number.isFinite(n) && n > 0 ? n : DEFAULT_MAX_SECONDS;
    }

    function stopPlayback() {
      if (state.activeAudio) {
        state.activeAudio.pause();
        state.activeAudio = null;
      }
      if (window.speechSynthesis) window.speechSynthesis.cancel();
    }

    function playMinnyAudio(step) {
      if (!step) return;
      stopPlayback();
      setMinnyMood('listen');

      if (step.audio_url) {
        const audio = new Audio(step.audio_url);
        state.activeAudio = audio;
        audio.addEventListener('ended', () => {
          setMinnyMood('idle');
          state.activeAudio = null;
        });
        audio.play().catch(() => speakEnglish(step.prompt_en || step.question_en));
        return;
      }

      const text = step.prompt_en || step.question_en || '';
      speakEnglish(text);
    }

    function speakEnglish(text) {
      const line = String(text || '').trim();
      if (!line || !window.speechSynthesis) return;
      const utterance = new SpeechSynthesisUtterance(line);
      utterance.lang = 'en-US';
      utterance.rate = 0.92;
      utterance.onend = () => setMinnyMood('idle');
      window.speechSynthesis.speak(utterance);
    }

    function renderModeCards() {
      const cardsEl = document.getElementById('mode-cards');
      if (!cardsEl) return;
      cardsEl.innerHTML = state.modes
        .map(
          (mode) => `
            <button
              type="button"
              class="minny-mode-card"
              data-mode-id="${escapeHtml(mode.id)}"
            >
              <span class="minny-mode-card__emoji">${MODE_EMOJI[mode.id] || '✨'}</span>
              <span class="minny-mode-card__title">${escapeHtml(mode.title_vi)}</span>
              <span class="minny-mode-card__desc">${escapeHtml(mode.subtitle_vi || '')}</span>
            </button>
          `,
        )
        .join('');

      cardsEl.querySelectorAll('[data-mode-id]').forEach((button) => {
        button.addEventListener('click', () => enterPracticeMode(button.dataset.modeId));
      });
    }

    function renderProgressDots() {
      const dotsEl = document.getElementById('progress-dots');
      const mode = activeMode();
      if (!dotsEl || !mode) return;

      if (mode.steps.length <= 1) {
        dotsEl.innerHTML = '';
        dotsEl.classList.add('hidden');
        return;
      }

      dotsEl.classList.remove('hidden');
      dotsEl.innerHTML = mode.steps
        .map((_, i) => {
          let cls = 'minny-dot';
          if (i < state.stepIndex) cls += ' minny-dot--done';
          else if (i === state.stepIndex) cls += ' minny-dot--active';
          return `<span class="${cls}" title="Bước ${i + 1}"></span>`;
        })
        .join('');
    }

    function renderStep() {
      const mode = activeMode();
      const step = currentStep();
      if (!mode || !step) return;

      const viEl = document.getElementById('prompt-vi');
      const enEl = document.getElementById('prompt-en');
      const recordBtn = document.getElementById('speaking-record');

      viEl.textContent = step.prompt_vi || step.question_vi || step.label_vi || '';
      enEl.textContent = step.prompt_en || step.question_en || '';

      const isQuestion = step.kind === 'question';
      recordBtn.textContent = isQuestion ? '🎤 Trả lời Minny' : '🎤 Con nói';

      renderProgressDots();
      setMinnyMood('idle');
      document.getElementById('speaking-result').classList.add('hidden');
      document.getElementById('speaking-actions').classList.add('hidden');
      document.getElementById('speaking-record').disabled = false;
      document.getElementById('speaking-status').textContent = isQuestion
        ? 'Nghe Minny hỏi, rồi con trả lời nhé.'
        : 'Nghe Minny nhắc, rồi con kể nhé.';
    }

    function wordChips(words, tone) {
      if (!Array.isArray(words) || !words.length) return '';
      return words.map((w) => `<span class="minny-word minny-word--${tone}">${escapeHtml(w)}</span>`).join('');
    }

    function renderResult(result) {
      const resultEl = document.getElementById('speaking-result');
      const actionsEl = document.getElementById('speaking-actions');
      if (!result?.ok) {
        setMinnyMood('encourage');
        resultEl.classList.remove('hidden');
        resultEl.innerHTML = `<p class="text-lg font-bold text-gold">${escapeHtml(result?.message || 'Chưa nghe rõ — thử lại nhé!')}</p>`;
        actionsEl.classList.remove('hidden');
        document.getElementById('speaking-next').classList.add('hidden');
        return;
      }

      const isOpen = result.check_mode === 'open';
      const passed = Number(result.score_percent) >= 50;
      setMinnyMood(passed ? 'celebrate' : 'encourage');

      const missed = !isOpen && result.words_missed?.length
        ? `<p class="mt-3 text-sm text-cream/80"><strong>Luyện thêm:</strong> ${wordChips(result.words_missed, 'miss')}</p>`
        : '';
      const close = !isOpen && result.words_close?.length
        ? `<p class="mt-3 text-sm text-cream/80"><strong>Gần đúng:</strong> ${wordChips(result.words_close, 'close')}</p>`
        : '';
      const matched = isOpen && result.words_matched?.length
        ? `<p class="mt-3 text-sm text-cream/80"><strong>Con nhắc tới:</strong> ${wordChips(result.words_matched, 'good')}</p>`
        : '';
      const transcript = result.transcript
        ? `<p class="mt-2 text-sm text-cream/75">Minny nghe: “${escapeHtml(result.transcript)}”</p>`
        : '';

      resultEl.classList.remove('hidden');
      resultEl.innerHTML = `
        <p class="font-display text-xl font-bold text-gold">${escapeHtml(result.feedback_vi || 'Hay lắm!')}</p>
        ${transcript}
        ${matched}
        ${close}
        ${missed}
      `;
      actionsEl.classList.remove('hidden');
      const mode = activeMode();
      const isLast = mode ? state.stepIndex >= mode.steps.length - 1 : true;
      document.getElementById('speaking-next').classList.toggle('hidden', isLast);
      const stepKind = currentStep()?.kind;
      document.getElementById('speaking-next').textContent =
        stepKind === 'question' ? 'Câu tiếp theo' : 'Bước tiếp theo';

      logPractice(result);
    }

    async function logPractice(result, readyForClass = false) {
      const step = currentStep();
      if (!state.accessCode || !state.packId) return;
      try {
        await fetch('/api/minny-practice-log', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            access_code: state.accessCode,
            pack_id: state.packId,
            prompt_id: step?.id || '',
            mode_id: state.activeModeId,
            score_percent: result?.score_percent,
            ready_for_class: readyForClass,
          }),
        });
      } catch {
        /* non-blocking */
      }
    }

    function micReady() {
      return !!(navigator.mediaDevices?.getUserMedia && window.MediaRecorder);
    }

    function createRecorder(stream) {
      const candidates = [
        'audio/mp4',
        'audio/aac',
        'audio/webm;codecs=opus',
        'audio/webm',
        'audio/ogg;codecs=opus',
      ];
      for (const mimeType of candidates) {
        try {
          if (typeof MediaRecorder.isTypeSupported === 'function' && !MediaRecorder.isTypeSupported(mimeType)) {
            continue;
          }
          const mediaRecorder = new MediaRecorder(stream, { mimeType });
          return { mediaRecorder, mimeType: mediaRecorder.mimeType || mimeType };
        } catch {
          // try next Safari-friendly codec
        }
      }
      const mediaRecorder = new MediaRecorder(stream);
      return { mediaRecorder, mimeType: mediaRecorder.mimeType || 'audio/mp4' };
    }

    function audioUploadFilename(blob) {
      const type = String(blob?.type || '').toLowerCase();
      if (type.includes('mp4') || type.includes('m4a') || type.includes('aac')) return 'audio.mp4';
      if (type.includes('ogg')) return 'audio.ogg';
      if (type.includes('wav')) return 'audio.wav';
      return 'audio.webm';
    }

    function stopMediaRecorder(mediaRecorder) {
      if (!mediaRecorder || mediaRecorder.state !== 'recording') return;
      try {
        mediaRecorder.requestData();
      } catch {
        /* optional on some browsers */
      }
      mediaRecorder.stop();
    }

    function cleanupRecording() {
      if (state.timerId) {
        clearInterval(state.timerId);
        state.timerId = null;
      }
      if (state.recording?.monitor) {
        state.recording.monitor.stop();
      }
      if (state.recording?.stream) {
        state.recording.stream.getTracks().forEach((t) => t.stop());
      }
      state.recording = null;
      state.status = 'idle';
      state.secondsLeft = DEFAULT_MAX_SECONDS;
      document.getElementById('speaking-timer').classList.add('hidden');
    }

    function updateRecordUi() {
      const btn = document.getElementById('speaking-record');
      const statusEl = document.getElementById('speaking-status');
      const timerEl = document.getElementById('speaking-timer');
      const step = currentStep();
      const isQuestion = step?.kind === 'question';
      const idleLabel = isQuestion ? '🎤 Trả lời Minny' : '🎤 Con nói';

      if (state.status === 'warming') {
        btn.textContent = '⏳ Chờ micro...';
        btn.disabled = true;
        timerEl.classList.add('hidden');
        statusEl.textContent = state.warmupMessage || 'Micro đã bật — chờ 3 giây rồi mới nói nhé…';
        setMinnyMood('listen');
        return;
      }

      if (state.status === 'recording') {
        btn.textContent = '⏹ Dừng';
        btn.disabled = false;
        timerEl.classList.remove('hidden');
        timerEl.textContent = `${state.secondsLeft}s`;
        statusEl.textContent = 'Minny đang nghe con...';
        setMinnyMood('listen');
        return;
      }

      if (state.status === 'uploading') {
        btn.disabled = true;
        btn.textContent = idleLabel;
        timerEl.classList.add('hidden');
        statusEl.textContent = 'Minny đang nhận xét...';
        setMinnyMood('listen');
        return;
      }

      const micBlocked = state.modePicked && !state.micGateReady;
      btn.disabled = !micReady() || micBlocked;
      btn.textContent = idleLabel;
      timerEl.classList.add('hidden');
      if (micBlocked) {
        statusEl.textContent = 'Con kiểm tra micro ở khung phía trên trước nhé.';
      } else {
        statusEl.textContent = micReady() ? 'Bấm nút rồi nói to, rõ nhé.' : 'Micro chưa sẵn sàng.';
      }
      if (state.modePicked) setMinnyMood('idle');
    }

    function mountSpeakingMicCheck() {
      const panel = shell?.querySelector('[data-r2l-mic-check]');
      if (!panel || panel.dataset.r2lMicMounted === 'true') return;
      if (!window.R2LMicCheck?.mount) {
        window.setTimeout(mountSpeakingMicCheck, 50);
        return;
      }
      window.R2LMicCheck.mount(panel, {
        blockUntilPass: true,
        onPass: () => {
          state.micGateReady = true;
          updateRecordUi();
        },
        onFail: () => {
          state.micGateReady = false;
          updateRecordUi();
        },
      });
    }

    document.addEventListener('r2l-mic-gate', (event) => {
      state.micGateReady = Boolean(event.detail?.ready);
      updateRecordUi();
    });

    async function submitAudio(blob, prompt, telemetry = null) {
      state.status = 'uploading';
      updateRecordUi();
      const formData = new FormData();
      formData.append('access_code', state.accessCode);
      formData.append('pack_id', state.packId || 'practice');
      formData.append(
        'expected_text',
        prompt.expected_text || prompt.story_context || prompt.question_en || prompt.prompt_en || '',
      );
      formData.append('check_mode', prompt.check_mode || 'open');
      formData.append('practice_mode', '1');
      formData.append('audio', blob, audioUploadFilename(blob));
      if (telemetry && window.R2LRecorder?.appendTelemetry) {
        window.R2LRecorder.appendTelemetry(formData, telemetry);
      }

      try {
        const res = await fetch('/api/read2lead-speaking-check', { method: 'POST', body: formData });
        const data = await res.json();
        // Analyser heard speech but ASR heard nothing → broken platform encoder;
        // record raw WAV on this machine from now on.
        if (
          data && !data.ok && data.error === 'transcription_failed'
          && telemetry && telemetry.voiced === true && telemetry.engine === 'mr'
        ) {
          window.R2LRecorder?.useWavEngine?.();
        }
        state.lastResult = data;
        state.status = 'done';
        renderResult(data);
      } catch {
        renderResult({ ok: false, message: 'Mạng không ổn định. Con thử lại nhé!' });
      } finally {
        state.status = 'idle';
        updateRecordUi();
      }
    }

    async function startRecording() {
      const prompt = currentStep();
      if (!prompt) return;
      stopPlayback();
      if (!micReady()) {
        renderResult({ ok: false, message: 'Micro chưa sẵn sàng. Con thử trình duyệt khác hoặc cho phép micro nhé.' });
        return;
      }
      if (!state.micGateReady && !window.R2LMicCheck?.sessionPassed?.()) {
        renderResult({ ok: false, message: 'Con bấm Kiểm tra micro ở khung phía trên trước nhé.' });
        return;
      }

      cleanupRecording();
      try {
        const stream = window.R2LRecorder?.getStream
          ? await window.R2LRecorder.getStream()
          : window.R2LMicCheck?.getMicStream
            ? await window.R2LMicCheck.getMicStream()
            : await navigator.mediaDevices.getUserMedia({
                audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true },
              });
        state.recording = { stream, mediaRecorder: null };
        state.status = 'warming';
        state.warmupMessage = 'Micro đã bật — chờ 3 giây rồi mới nói nhé…';
        updateRecordUi();

        // NOTE: no primeAudioPipeline here. Creating/closing an AudioContext on
        // the live stream right before recording leaves the track feeding
        // silence on Windows/Realtek (the root cause fixed in lesson.astro —
        // the 3s countdown already warms the pipeline naturally).
        if (window.R2LMicCheck?.runMicWarmupCountdown) {
          await window.R2LMicCheck.runMicWarmupCountdown({
            onMessage: (msg) => {
              if (state.status !== 'warming') return;
              state.warmupMessage = msg;
              updateRecordUi();
            },
          });
        } else {
          await new Promise((resolve) => window.setTimeout(resolve, 3000));
        }
        if (state.status !== 'warming') {
          stream.getTracks().forEach((t) => t.stop());
          return;
        }

        // Unified engine: MediaRecorder or raw-PCM WAV per this machine's
        // history, plus a Meet-style live monitor that detects silent capture
        // locally instead of uploading silence to the ASR.
        const recorder = window.R2LRecorder?.createRecorder
          ? window.R2LRecorder.createRecorder(stream)
          : (() => {
              const { mediaRecorder, mimeType } = createRecorder(stream);
              const chunks = [];
              let resolveStop = null;
              const stopped = new Promise((resolve) => { resolveStop = resolve; });
              mediaRecorder.addEventListener('dataavailable', (event) => {
                if (event.data?.size > 0) chunks.push(event.data);
              });
              mediaRecorder.addEventListener('stop', () => {
                resolveStop(new Blob(chunks, { type: mediaRecorder.mimeType || mimeType || 'audio/mp4' }));
              });
              return {
                engine: 'mr',
                mimeType,
                start() { mediaRecorder.start(250); },
                stop() { stopMediaRecorder(mediaRecorder); return stopped; },
              };
            })();
        const monitor = window.R2LRecorder?.startMonitor
          ? await window.R2LRecorder.startMonitor(stream, {
              onSilenceHint: () => {
                const statusEl = document.getElementById('speaking-status');
                if (statusEl && state.status === 'recording') {
                  statusEl.textContent = 'Minny chưa thấy tiếng — con nói TO hơn nhé!';
                }
              },
            })
          : { available: false, peak: () => -1, voiced: () => true, stop: () => {} };

        let finished = false;
        const finishRecording = async () => {
          if (finished) return;
          finished = true;
          if (state.timerId) {
            clearInterval(state.timerId);
            state.timerId = null;
          }
          let blob = null;
          try {
            blob = await recorder.stop();
          } catch {
            blob = null;
          }
          monitor.stop();
          stream.getTracks().forEach((t) => t.stop());
          const voiced = window.R2LRecorder?.recordingLooksVoiced
            ? window.R2LRecorder.recordingLooksVoiced(monitor, blob?.size || 0)
            : (monitor.available ? monitor.voiced() : true);
          if (blob && blob.size > 0 && !voiced) {
            // Silent capture caught on-device: relax constraints for the next
            // try instead of sending silence to the server.
            window.R2LRecorder?.bumpProfile?.();
            state.status = 'idle';
            renderResult({ ok: false, message: 'Minny không thấy tiếng vào micro. Con thử lại — nói TO hơn, hoặc kiểm tra micro ở khung phía trên nhé.' });
            updateRecordUi();
            return;
          }
          if (blob && blob.size > 0) {
            submitAudio(blob, prompt, {
              peak: monitor.available ? monitor.peak() : -1,
              voiced,
              engine: recorder.engine || 'mr',
              mimeType: blob.type || recorder.mimeType || '',
            });
          } else {
            state.status = 'idle';
            renderResult({ ok: false, message: 'Không thu được tiếng. Con thử nói to hơn nhé.' });
            updateRecordUi();
          }
        };

        state.recording = { stream, mediaRecorder: null, recorderCtl: recorder, monitor, finishRecording };
        state.status = 'recording';
        state.secondsLeft = stepMaxSeconds(prompt);
        recorder.start();
        updateRecordUi();

        state.timerId = window.setInterval(() => {
          state.secondsLeft -= 1;
          updateRecordUi();
          if (state.secondsLeft <= 0) {
            finishRecording();
          }
        }, 1000);
      } catch (error) {
        const message = window.R2LMicCheck?.helpMessage?.(error)
          || 'Không mở được micro. Con nhờ bố mẹ cho phép micro nhé.';
        renderResult({ ok: false, message });
        window.R2LMicCheck?.focusMicHelpInShell?.(shell);
        cleanupRecording();
        updateRecordUi();
      }
    }

    function stopRecording() {
      if (state.recording?.finishRecording) {
        state.recording.finishRecording();
        return;
      }
      if (state.recording?.mediaRecorder) {
        stopMediaRecorder(state.recording.mediaRecorder);
      }
      if (state.timerId) {
        clearInterval(state.timerId);
        state.timerId = null;
      }
    }

    async function loadSession() {
      clearError();
      const code = codeInput.value.trim().toUpperCase();
      if (!code) {
        showError('Vui lòng nhập mã học sinh.');
        return;
      }

      loadBtn.disabled = true;
      loadBtn.textContent = 'Đang tải...';

      try {
        const res = await fetch(`/api/minny-speaking-context?code=${encodeURIComponent(code)}`);
        const data = await res.json();
        if (!res.ok || !data.ok) {
          showError(data.message || 'Không tìm thấy mã học sinh.');
          shell.classList.add('hidden');
          return;
        }

        state.accessCode = code;
        state.packId = data.pack_id || 'practice';
        state.modes = Array.isArray(data.modes) ? data.modes : [];
        state.activeModeId = state.modes[0]?.id || 'retell';
        state.stepIndex = 0;
        state.modePicked = false;

        document.getElementById('minny-greeting').textContent = data.greeting_vi || 'Chào con! Minny sẵn sàng luyện nói.';
        document.getElementById('practice-stats').textContent =
          data.practice_count_this_week > 0
            ? `Tuần này con luyện ${data.practice_count_this_week} lần`
            : 'Buổi luyện đầu tuần — cứ thoải mái thử nhé!';
        document.getElementById('profile-link').href = data.profile_link || `/hoc-sinh?code=${encodeURIComponent(code)}`;

        if (!data.has_story && !data.pack_id) {
          document.getElementById('minny-greeting').textContent = data.message_vi || data.greeting_vi;
        }

        codeCard.classList.add('hidden');
        shell.classList.remove('hidden');
        mountSpeakingMicCheck();
        showModePicker();
        renderModeCards();
        setMinnyMood('idle');

        const url = new URL(window.location.href);
        url.searchParams.set('code', code);
        window.history.replaceState({}, '', url);
      } catch {
        showError('Mạng không ổn định. Vui lòng thử lại.');
      } finally {
        loadBtn.disabled = false;
        loadBtn.textContent = 'Bắt đầu';
      }
    }

    document.getElementById('speaking-listen')?.addEventListener('click', () => {
      playMinnyAudio(currentStep());
    });

    document.getElementById('speaking-record')?.addEventListener('click', () => {
      if (state.status === 'recording') stopRecording();
      else startRecording();
    });

    document.getElementById('speaking-retry')?.addEventListener('click', () => {
      document.getElementById('speaking-result').classList.add('hidden');
      document.getElementById('speaking-actions').classList.add('hidden');
      renderStep();
      updateRecordUi();
    });

    document.getElementById('speaking-next')?.addEventListener('click', () => {
      const mode = activeMode();
      if (mode && state.stepIndex < mode.steps.length - 1) {
        state.stepIndex += 1;
        renderStep();
        updateRecordUi();
      }
    });

    document.getElementById('back-to-modes')?.addEventListener('click', () => {
      stopPlayback();
      cleanupRecording();
      document.getElementById('speaking-result').classList.add('hidden');
      document.getElementById('speaking-actions').classList.add('hidden');
      showModePicker();
    });

    loadBtn?.addEventListener('click', loadSession);
  </script>
  <script src="/scripts/r2l-recorder.js" defer></script>
  <script src="/scripts/r2l-mic-check.js" defer></script>
</BaseLayout>
