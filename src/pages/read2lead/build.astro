---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Input from '../../components/ui/Input.astro';
import TopicTile from '../../components/ui/TopicTile.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import ProgressBar from '../../components/ui/ProgressBar.astro';

// Topic value codes mirror the live create-lesson form on src/pages/read2lead.astro.
// The value (not the label) is POSTed to the backend, which accepts free text.
const TOPICS = [
  { value: 'animals_pets', label: 'Động vật & thú cưng', emoji: '🐾' },
  { value: 'family_friends', label: 'Gia đình & bạn bè', emoji: '👨‍👩‍👧' },
  { value: 'school', label: 'Trường học', emoji: '🏫' },
  { value: 'sports', label: 'Thể thao', emoji: '⚽' },
  { value: 'games_toys', label: 'Trò chơi & đồ chơi', emoji: '🎮' },
  { value: 'vehicles', label: 'Xe cộ & di chuyển', emoji: '🚗' },
  { value: 'food_cooking', label: 'Đồ ăn & nấu ăn', emoji: '🍳' },
  { value: 'nature', label: 'Thiên nhiên', emoji: '🌳' },
  { value: 'art_creativity', label: 'Vẽ tranh & sáng tạo', emoji: '🎨' },
  { value: 'heroes_jobs', label: 'Nghề nghiệp & ước mơ', emoji: '🦸' },
  { value: 'imagination', label: 'Tưởng tượng & phép màu', emoji: '✨' },
  { value: 'vietnamese_holidays', label: 'Lễ hội Việt Nam', emoji: '🏮' },
];

// 3-step indicator. Each phase renders the same labels with a different status
// row so JS only ever needs to flip [data-phase] — no per-step DOM edits.
const STEPS = ['Mã học sinh', 'Chủ đề', 'Bài học'];
type StepStatus = 'active' | 'done' | 'muted';
const STEP_STATUS: Record<'build' | 'generating' | 'result' | 'error', StepStatus[]> = {
  build: ['active', 'muted', 'muted'],
  generating: ['done', 'done', 'active'],
  result: ['done', 'done', 'done'],
  error: ['done', 'done', 'active'],
};

// Stage 0 label for the initial server render; the client script owns rotation.
const STAGE_LABELS = [
  'Đang chọn truyện phù hợp với con…',
  'Đang chuẩn bị phần nghe…',
  'Đang ghi âm các cụm câu…',
  'Đang chuẩn bị nhiệm vụ web…',
];
const INITIAL_PROGRESS = ((0 + 1) / 4) * 100;
---

<BaseLayout title="Tạo bài học mới — Read2Lead | Felix Coaching" robots="noindex, follow">
  <Header />

  <main id="main" class="mx-auto max-w-3xl px-6 py-12" data-phase="build">
    {/* ============================ BUILD ============================ */}
    <section class="phase-build">
      <ol class="r2l-steps">
        {STEPS.map((label, i) => (
          <li class={`r2l-step r2l-step--${STEP_STATUS.build[i]}`}>
            <span class="r2l-step__num">{STEP_STATUS.build[i] === 'done' ? '✓' : i + 1}</span>
            <span class="r2l-step__label">{label}</span>
          </li>
        ))}
      </ol>

      <SectionHeading
        eyebrow="Read2Lead"
        title="Tạo bài học cho con"
        lead="Nhập mã học sinh, chọn chủ đề, Minny sẽ chuẩn bị bài trong vài giây."
        align="center"
      />

      <div class="mt-8">
        <Input label="Mã học sinh" name="code" placeholder="VÍ DỤ: NA2024" maxlength={16} autocomplete="off" required />
      </div>

      <p class="fx-eyebrow mt-8">Chủ đề bài học</p>
      <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
        {TOPICS.map((topic, i) => (
          <TopicTile emoji={topic.emoji} label={topic.label} selected={i === 0} data-topic={topic.value} />
        ))}
      </div>

      <div class="mt-6">
        <Input
          label="Sở thích của con (không bắt buộc)"
          name="interests"
          placeholder="VD: bóng đá, Roblox, mèo, vẽ tranh…"
          maxlength={120}
          autocomplete="off"
          hint="Nếu điền, câu chuyện sẽ cố gắng đi theo điều con thích."
        />
      </div>

      {/* Honeypot — bots fill this hidden field; humans never see it. */}
      <div class="r2l-honeypot" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="mt-8">
        <Button size="lg" block id="generate-btn" disabled>Tạo bài học →</Button>
        <p class="text-center text-xs text-cream-dim mt-3">Minny chỉ dùng mã để mở bài. Không lưu thông tin riêng.</p>
      </div>
    </section>

    {/* ========================== GENERATING ========================== */}
    <section class="phase-generating">
      <ol class="r2l-steps">
        {STEPS.map((label, i) => (
          <li class={`r2l-step r2l-step--${STEP_STATUS.generating[i]}`}>
            <span class="r2l-step__num">{STEP_STATUS.generating[i] === 'done' ? '✓' : i + 1}</span>
            <span class="r2l-step__label">{label}</span>
          </li>
        ))}
      </ol>

      <SectionHeading align="center" title="Minny đang chuẩn bị bài cho con…" />

      <Card variant="raised" class="mt-8 text-center">
        <div id="gen-progress">
          <ProgressBar value={INITIAL_PROGRESS} gradient aria-label="Tiến độ tạo bài học" />
        </div>
        <p id="stage-label" class="r2l-stage-label" aria-live="polite">{STAGE_LABELS[0]}</p>
        <p id="gen-note" class="r2l-gen-note">Lần đầu có thể chậm hơn một chút vì máy chủ cần khởi động.</p>
      </Card>
    </section>

    {/* ============================= ERROR ============================= */}
    <section class="phase-error">
      <ol class="r2l-steps">
        {STEPS.map((label, i) => (
          <li class={`r2l-step r2l-step--${STEP_STATUS.error[i]}`}>
            <span class="r2l-step__num">{STEP_STATUS.error[i] === 'done' ? '✓' : i + 1}</span>
            <span class="r2l-step__label">{label}</span>
          </li>
        ))}
      </ol>

      <Card variant="raised" class="mt-8 text-center">
        <h2 class="font-display r2l-result-title">Chưa tạo được bài học</h2>
        <p class="r2l-result-text" id="error-message" aria-live="polite" role="alert"></p>
        <div class="r2l-result-actions">
          <Button variant="primary" size="lg" id="retry">Thử lại</Button>
        </div>
        <p class="r2l-gen-note">Nếu vẫn lỗi, anh chị nhắn Zalo Felix để được hỗ trợ.</p>
      </Card>
    </section>

    {/* ============================ RESULT ============================ */}
    <section class="phase-result">
      <ol class="r2l-steps">
        {STEPS.map((label, i) => (
          <li class={`r2l-step r2l-step--${STEP_STATUS.result[i]}`}>
            <span class="r2l-step__num">{STEP_STATUS.result[i] === 'done' ? '✓' : i + 1}</span>
            <span class="r2l-step__label">{label}</span>
          </li>
        ))}
      </ol>

      <Card variant="accent" class="mt-8 text-center">
        <h2 class="font-display r2l-result-title">Bài học đã sẵn sàng! ✨</h2>
        <p class="r2l-result-text">Minny đã chuẩn bị một bài học riêng cho mã <strong class="text-accent" id="result-code"></strong> về chủ đề <strong class="text-accent" id="result-topic"></strong>.</p>
        <p class="r2l-result-text" id="result-story" hidden>Tên truyện: <strong class="text-accent" id="result-story-title"></strong></p>
        <div class="r2l-result-actions">
          <Button variant="primary" size="lg" href="#" id="open-lesson">Mở bài học →</Button>
          <Button variant="secondary" id="reset">Tạo bài khác</Button>
        </div>
      </Card>
    </section>
  </main>

  <script>
    import '../../scripts/r2l-builder.client.ts';
  </script>
</BaseLayout>

<style>
  /* Step indicator — gold for active/done, translucent cream for upcoming. */
  .r2l-steps {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-1);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }
  .r2l-step {
    flex: 1;
    text-align: center;
  }
  .r2l-step__num {
    display: flex;
    width: 34px;
    height: 34px;
    margin: 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    font-weight: var(--weight-bold);
    background: color-mix(in srgb, var(--cream) 12%, transparent);
    color: var(--cream);
  }
  .r2l-step__label {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--cream-dim);
  }
  .r2l-step--active .r2l-step__num,
  .r2l-step--done .r2l-step__num {
    background: var(--accent);
    color: var(--navy-950);
  }
  .r2l-step--active .r2l-step__label,
  .r2l-step--done .r2l-step__label {
    color: var(--cream);
  }

  /* Honeypot — visually removed, kept in the accessibility tree off-screen. */
  .r2l-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Generating stage caption. */
  .r2l-stage-label {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--cream);
  }
  .r2l-gen-note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--cream-dim);
  }

  /* Result card. */
  .r2l-result-title {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    color: var(--cream);
  }
  .r2l-result-text {
    margin-top: var(--space-4);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
  }
  .r2l-result-actions {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  /* All four phases live in the DOM at once; CSS reveals one per data-phase. */
  .phase-build,
  .phase-generating,
  .phase-result,
  .phase-error {
    display: none;
  }
  [data-phase='build'] .phase-build {
    display: block;
  }
  [data-phase='generating'] .phase-generating {
    display: block;
  }
  [data-phase='result'] .phase-result {
    display: block;
  }
  [data-phase='error'] .phase-error {
    display: block;
  }

  /* Reduced motion: the stage-label rotation is paused in JS; ensure the
     gradient progress bar never animates while the real request is in flight. */
  @media (prefers-reduced-motion: reduce) {
    .phase-generating .fx-progress__fill,
    .phase-generating .fx-progress__fill--gradient {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
