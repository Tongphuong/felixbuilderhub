---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Thư viện truyện | Read2Lead"
  description="Sổ truyện Read2Lead — xem lại các câu chuyện con đã hoàn thành trên web."
>
  <Header read2LeadState={true} />

  <main id="main" class="min-h-screen bg-navy-950">
    <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-gold">Sổ truyện Read2Lead</p>
          <h1 class="mt-1 font-display text-3xl font-bold text-cream md:text-4xl">Thư viện truyện của con</h1>
          <p id="library-subtitle" class="mt-2 max-w-2xl text-sm text-cream/70">
            Mỗi bài hoàn thành là một sticker. Hoàn thành đủ 5 bài để mở chương mới.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a id="library-home-link" href="/read2lead" class="r2l-secondary inline-flex items-center justify-center">Trang chính</a>
          <a id="library-new-pack-link" href="/read2lead#form" class="r2l-primary inline-flex items-center justify-center">Tạo bài mới</a>
        </div>
      </div>

      <div id="loading-card" class="mt-8 rounded-md border border-cream/10 bg-cream/5 p-6 text-cream">
        Minny đang mở sổ truyện...
      </div>

      <div id="error-card" class="mt-8 hidden rounded-md border border-gold/30 bg-gold/10 p-6 text-cream">
        <p class="font-semibold text-gold">Chưa mở được thư viện</p>
        <p id="error-message" class="mt-2 text-sm text-cream/80"></p>
      </div>

      <div id="library-shell" class="mt-8 hidden space-y-8">
        <div class="rounded-md border border-accent/25 bg-accent/10 p-5">
          <p id="progress-message" class="font-display text-lg font-bold text-cream"></p>
          <p id="progress-count" class="mt-1 text-sm text-cream/70"></p>
        </div>
        <div id="chapter-list" class="space-y-8"></div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .r2l-primary {
    min-height: 44px;
    border-radius: 8px;
    background: rgb(74 222 128);
    padding: 0.75rem 1rem;
    font-weight: 800;
    color: rgb(10 14 26);
  }

  .r2l-secondary {
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.24);
    background: rgb(245 230 211 / 0.05);
    padding: 0.75rem 1rem;
    font-weight: 800;
    color: rgb(245 230 211);
  }

  .library-slot {
    border-radius: 12px;
    border: 1px solid rgb(245 230 211 / 0.14);
    background: rgb(245 230 211 / 0.04);
    padding: 1rem;
    min-height: 148px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .library-slot[data-status='completed'] {
    border-color: rgb(74 222 128 / 0.45);
    background: rgb(74 222 128 / 0.08);
  }

  .library-slot[data-status='next'] {
    border-color: rgb(212 166 78 / 0.55);
    background: rgb(212 166 78 / 0.08);
  }

  .library-slot[data-status='locked'] {
    opacity: 0.45;
    filter: grayscale(1);
  }

  .library-emoji {
    font-size: 2rem;
    line-height: 1;
  }
</style>

<script is:inline>
  const params = new URLSearchParams(window.location.search);
  const accessCode = (params.get('code') || '').trim().toUpperCase();

  if (accessCode) {
    document.getElementById('library-home-link').href = `/read2lead?code=${encodeURIComponent(accessCode)}`;
    document.getElementById('library-new-pack-link').href = `/read2lead?code=${encodeURIComponent(accessCode)}#form`;
  }

  init();

  async function init() {
    if (!accessCode) {
      showError('Thiếu mã học sinh. Anh Phương mở lại từ link profile nhé.');
      return;
    }

    try {
      const res = await fetch(`/api/read2lead-library?code=${encodeURIComponent(accessCode)}`);
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.message || data.error || 'Không tải được thư viện.');
      renderLibrary(data.library || {});
    } catch (error) {
      showError(error.message || 'Có lỗi khi mở thư viện.');
    }
  }

  function showError(message) {
    document.getElementById('loading-card')?.classList.add('hidden');
    document.getElementById('library-shell')?.classList.add('hidden');
    document.getElementById('error-card')?.classList.remove('hidden');
    document.getElementById('error-message').textContent = message;
  }

  function renderLibrary(library) {
    document.getElementById('loading-card')?.classList.add('hidden');
    document.getElementById('library-shell')?.classList.remove('hidden');

    const studentName = library.student_name || '';
    if (studentName) {
      document.getElementById('library-subtitle').textContent =
        `${studentName} đã hoàn thành ${library.total_completed || 0} câu chuyện trên web.`;
    }

    document.getElementById('progress-message').textContent = library.progress_message || '';
    document.getElementById('progress-count').textContent =
      `${library.total_completed || 0} truyện · ${library.packs_per_chapter || 5} truyện / chương`;

    const chapterList = document.getElementById('chapter-list');
    chapterList.innerHTML = (library.chapters || [])
      .map((chapter) => renderChapter(chapter))
      .join('');
  }

  function renderChapter(chapter) {
    const slots = (chapter.slots || [])
      .map((slot) => {
        const title = slot.title || (slot.status === 'locked' ? 'Chưa mở' : 'Chờ bài mới');
        const actions =
          slot.status === 'completed'
            ? `<a class="mt-3 inline-flex rounded-md bg-accent px-3 py-2 text-xs font-bold text-navy-950" href="/read2lead/lesson?code=${encodeURIComponent(accessCode)}&pack_id=${encodeURIComponent(slot.pack_id)}">Đọc lại</a>`
            : '';
        return `
          <article class="library-slot" data-status="${slot.status}">
            <div>
              <div class="library-emoji">${escapeHtml(slot.emoji || '📖')}</div>
              <p class="mt-3 text-sm font-bold text-cream">${escapeHtml(title)}</p>
              <p class="mt-1 text-xs text-cream/60">${slot.level ? escapeHtml(slot.level) : ''}${slot.topic ? ` · ${escapeHtml(slot.topic)}` : ''}</p>
            </div>
            ${actions}
          </article>
        `;
      })
      .join('');

    return `
      <section class="rounded-md border border-cream/10 bg-cream/[0.03] p-5">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-gold">Chương ${chapter.chapter_index}</p>
            <h2 class="font-display text-2xl font-bold text-cream">${escapeHtml(chapter.title || 'Rừng kỳ diệu')}</h2>
          </div>
          <span class="rounded-md bg-navy-900 px-3 py-1 text-xs font-semibold text-cream/70">
            ${chapter.completed_count || 0}/${chapter.total_count || 5}
          </span>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">${slots}</div>
      </section>
    `;
  }

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }
</script>
