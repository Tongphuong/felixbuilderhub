---
// Static hosting cannot preserve ?code= in build-time redirects.
// Client redirect keeps legacy /library links working for parents.
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Đang chuyển tới trang xem tiến độ con...</title>
  </head>
  <body>
    <p>Đang chuyển tới <a id="profile-link" href="/hoc-sinh">trang xem tiến độ con</a>...</p>
    <script is:inline>
      const params = new URLSearchParams(window.location.search);
      const code = (params.get('code') || '').trim().toUpperCase();
      const target = code
        ? `/hoc-sinh?code=${encodeURIComponent(code)}`
        : '/hoc-sinh';
      const link = document.getElementById('profile-link');
      if (link) link.href = target;
      window.location.replace(target);
    </script>
  </body>
</html>
