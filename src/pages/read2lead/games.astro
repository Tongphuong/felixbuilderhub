---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Mini game Read2Lead | Felix Coaching"
  description="Chơi mini game bằng xu trong Read2Lead V3 preview."
  robots="noindex, follow"
>
  <Header read2LeadState={false} />

  <main id="main" class="flex-1 bg-navy-950 px-4 py-8 sm:px-6">
    <section class="mx-auto max-w-3xl">
      <p class="text-xs font-extrabold uppercase tracking-wide text-accent">Read2Lead V3</p>
      <h1 class="mt-2 font-display text-3xl font-extrabold text-cream">Mini game</h1>
      <p class="mt-2 text-sm text-cream-muted">Dùng xu để chơi. Game đầu tiên cần từ vựng gần đây — chưa có API public an toàn, nên hub này là shell preview.</p>

      <div id="games-gate" class="mt-6 hidden rounded-2xl border border-cream/15 bg-navy-900/80 p-6 text-sm text-cream-muted">
        Mini game chỉ mở khi bật V3 preview (<code>?v3=1</code>).
      </div>

      <div id="games-entry" class="mt-6 hidden space-y-4">
        <div class="rounded-2xl border border-cream/15 bg-navy-900/80 p-5">
          <label for="games-code" class="text-sm font-semibold text-cream">Mã học sinh</label>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row">
            <input id="games-code" maxlength="40" autocomplete="off" class="min-h-[48px] w-full rounded-xl border border-cream/15 bg-navy-950 px-4 uppercase text-cream" placeholder="R2L-..." />
            <button id="games-load" type="button" data-r2l-kid-upgrade="primary" class="min-h-[48px] rounded-xl bg-accent px-6 font-extrabold text-navy-950">Tải</button>
          </div>
        </div>

        <div id="games-balance" class="hidden rounded-2xl border border-gold/30 bg-gold/10 px-5 py-4">
          <p class="text-sm text-cream-muted">Số dư</p>
          <p class="font-display text-2xl font-extrabold text-gold"><span id="games-coins">0</span> 🪙</p>
        </div>

        <div id="games-list" class="hidden space-y-4">
          <article class="rounded-2xl border border-cream/10 bg-navy-900/70 p-5">
            <h2 class="font-display text-xl font-extrabold text-cream">Nghe &amp; Chạm</h2>
            <p class="mt-2 text-sm text-cream-muted">Nghe một từ, chọn đúng hình/chữ trong 3–4 lựa chọn, 5 vòng.</p>
            <p class="mt-3 rounded-lg border border-amber-400/30 bg-amber-500/10 px-3 py-2 text-sm text-amber-100">
              TODO: cần API từ vựng gần đây từ pack_history (chưa có endpoint public). Shell + coin gate sẵn sàng; game logic chờ spec data.
            </p>
            <p class="mt-3 text-xs text-cream-dim">Phí chơi dự kiến: 5 xu / lượt (tunable).</p>
            <button type="button" disabled class="mt-4 rounded-xl border border-cream/20 px-4 py-2 text-sm font-bold text-cream/50">Sắp mở</button>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { isV3Enabled } from '../../config/flags';

  const qs = (sel) => document.querySelector(sel);

  function setGamesCoins(value) {
    const coins = qs('#games-coins');
    if (coins) coins.textContent = String(value);
  }

  async function loadGames() {
    const code = (qs('#games-code').value || '').trim().toUpperCase();
    if (!code) return;
    const res = await fetch(`/api/read2lead-progress?code=${encodeURIComponent(code)}`);
    const data = await res.json();
    if (!res.ok || !data.ok) throw new Error(data.message || 'Không tìm thấy mã.');
    setGamesCoins(data.read2lead_state?.coins || 0);
    qs('#games-balance').classList.remove('hidden');
    qs('#games-list').classList.remove('hidden');
  }

  if (!isV3Enabled()) {
    qs('#games-gate').classList.remove('hidden');
  } else {
    qs('#games-entry').classList.remove('hidden');
    const params = new URLSearchParams(window.location.search);
    const code = (params.get('code') || '').trim().toUpperCase();
    if (code) {
      qs('#games-code').value = code;
      loadGames().catch(() => {});
    }
  }

  qs('#games-load')?.addEventListener('click', () => {
    loadGames().catch(() => {});
  });
</script>
