    <div id="gift-staff-root"><main id="main" tabindex="-1"><p>Đang mở bàn quà mẫu…</p></main></div>
    <noscript><p class="notice">Cần bật JavaScript để đối chiếu và lưu lượt thử.</p></noscript>
    <script>import { mountGiftStaff } from '../../lib/read2lead/self-learn/gift-staff.mjs'; mountGiftStaff(document.getElementById('gift-staff-root'));</script>
