  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Bàn quà mẫu · Read2Lead</title>
    <link rel="stylesheet" href={giftStyles} />
  </head>
  <body class="gift-staff-page">
    <a class="skip-link" href="#main">Đến nội dung bàn quà</a>
