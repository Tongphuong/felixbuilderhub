---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Video & nhận xét phụ huynh | Felix Admin"
  description="Trang admin để gửi video bài nói và nhận xét cho phụ huynh."
>
  <header class="border-b border-cream-dim/20 bg-navy-950/85 backdrop-blur">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <a href="/" class="flex items-center" aria-label="Felix Coaching — Trang chủ">
        <img
          src="/logo/felixbuilderhub_website_header_logo.webp"
          alt="Felix Coaching"
          class="h-9 w-auto md:h-10"
          width="525"
          height="190"
        />
      </a>
      <span class="rounded-md bg-accent/15 px-3 py-1 text-xs font-semibold text-accent">ADMIN — chỉ Felix dùng</span>
    </div>
  </header>

  <main id="main" class="flex-1">
    <section class="mx-auto max-w-5xl px-6 py-10">
      <h1 class="font-display text-3xl font-bold text-cream">Video & nhận xét phụ huynh</h1>
      <p class="mt-2 text-cream-muted">Chọn học sinh, tải video buổi học và gửi nhận xét ngắn cho phụ huynh.</p>

      <div class="mt-8 rounded-xl border border-cream-dim/20 bg-navy-900/70 p-6">
        <form id="portfolio-upload-form" class="grid gap-5">
          <div>
            <label for="portfolio-code" class="mb-1 block text-sm font-semibold text-cream">Học sinh</label>
            <select
              id="portfolio-code"
              name="access_code"
              required
              class="min-h-12 w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none"
            >
              <option value="">Đang tải danh sách...</option>
            </select>
          </div>

          <div>
            <label for="portfolio-video" class="mb-1 block text-sm font-semibold text-cream">Video</label>
            <input
              id="portfolio-video"
              name="video"
              type="file"
              accept="video/mp4,video/webm,video/quicktime,.mov"
              required
              class="block min-h-12 w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-sm text-cream file:mr-3 file:rounded-md file:border-0 file:bg-accent file:px-3 file:py-2 file:font-semibold file:text-navy-950"
            />
            <p class="mt-1 text-xs text-cream-dim">MP4, WebM hoặc MOV. Tối đa 80MB.</p>
          </div>

          <div>
            <label for="portfolio-title" class="mb-1 block text-sm font-semibold text-cream">Tiêu đề</label>
            <input
              id="portfolio-title"
              name="title"
              required
              maxlength="120"
              placeholder="Bài nói tuần này"
              class="min-h-12 w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none"
            />
          </div>

          <div>
            <label for="portfolio-note" class="mb-1 block text-sm font-semibold text-cream">Nhận xét</label>
            <textarea
              id="portfolio-note"
              name="note_vi"
              maxlength="2000"
              rows="5"
              required
              placeholder="Con đã giữ nhịp nói đều hơn. Tuần sau mình luyện thêm âm cuối nhé!"
              class="w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none"
            ></textarea>
          </div>

          <div id="upload-progress-wrap" class="hidden" aria-live="polite">
            <div class="mb-1 flex items-center justify-between text-xs text-cream-muted">
              <span>Đang tải video...</span>
              <span id="upload-progress-label">0%</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-navy-950">
              <div id="upload-progress-bar" class="h-full w-0 rounded-full bg-accent transition-[width]"></div>
            </div>
          </div>

          <div>
            <button
              id="portfolio-submit"
              type="submit"
              class="min-h-12 w-full rounded-lg bg-accent px-5 py-2.5 font-semibold text-navy-950 transition hover:bg-accent-hover disabled:cursor-wait disabled:opacity-60 sm:w-auto"
            >
              Gửi cho phụ huynh
            </button>
          </div>
        </form>
        <div id="upload-result" class="mt-5 hidden rounded-lg border p-4 text-sm" aria-live="polite"></div>
      </div>

      <div class="mt-8 rounded-xl border border-cream-dim/20 bg-navy-900/70 p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="font-display text-xl font-bold text-cream">Video đã gửi</h2>
          <button
            id="portfolio-refresh"
            type="button"
            class="min-h-11 rounded-lg border border-cream-dim/30 px-4 py-2 text-sm font-semibold text-cream transition hover:border-accent hover:text-accent"
          >
            ↻ Tải lại
          </button>
        </div>
        <p id="portfolio-list-status" class="mt-3 text-sm text-cream-dim">Chọn học sinh để xem danh sách.</p>
        <div id="portfolio-list" class="mt-5 space-y-3"></div>
      </div>
    </section>
  </main>

  <footer class="mt-auto border-t border-cream-dim/20 py-6 text-center text-sm text-cream-dim/80">
    Felix Admin — handle with care
  </footer>

  <script is:inline>
    const MAX_VIDEO_BYTES = 80 * 1024 * 1024;
    const form = document.getElementById('portfolio-upload-form');
    const codeSelect = document.getElementById('portfolio-code');
    const videoInput = document.getElementById('portfolio-video');
    const submitButton = document.getElementById('portfolio-submit');
    const resultBox = document.getElementById('upload-result');
    const progressWrap = document.getElementById('upload-progress-wrap');
    const progressBar = document.getElementById('upload-progress-bar');
    const progressLabel = document.getElementById('upload-progress-label');
    const listStatus = document.getElementById('portfolio-list-status');
    const list = document.getElementById('portfolio-list');
    const refreshButton = document.getElementById('portfolio-refresh');

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function showResult(message, ok) {
      resultBox.textContent = message;
      resultBox.className = ok
        ? 'mt-5 rounded-lg border border-green-500/40 bg-green-500/10 p-4 text-sm text-green-200'
        : 'mt-5 rounded-lg border border-red-500/40 bg-red-500/10 p-4 text-sm text-red-200';
    }

    function studentLabel(item) {
      const profile = item.student_profile || {};
      const progress = item.progress || {};
      const name = profile.student_name || progress.student_name || item.parent_name || 'Chưa có tên';
      return `${name} — ${item.code}`;
    }

    async function loadStudents() {
      codeSelect.innerHTML = '<option value="">Đang tải danh sách...</option>';
      try {
        const response = await fetch('/api/admin/codes');
        const payload = await response.json();
        if (!response.ok || !payload.ok) throw new Error(payload.message || payload.error || 'Không tải được danh sách');
        const students = (payload.items || []).filter((item) => /^R2L-[A-Z0-9-]+$/.test(item.code || ''));
        codeSelect.innerHTML = '<option value="">Chọn học sinh</option>' + students
          .map((item) => `<option value="${escapeHtml(item.code)}">${escapeHtml(studentLabel(item))}</option>`)
          .join('');
      } catch {
        codeSelect.innerHTML = '<option value="">Không tải được danh sách</option>';
        showResult('Không tải được danh sách học sinh. Vui lòng tải lại trang.', false);
      }
    }

    function formatDate(value) {
      const date = new Date(value || '');
      return Number.isNaN(date.getTime())
        ? '—'
        : new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date);
    }

    function formatBytes(value) {
      const bytes = Number(value) || 0;
      if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    function renderItem(item) {
      const reactions = { heart: 0, clap: 0, strong: 0, ...(item.reactions || {}) };
      const seen = item.parent_seen_at
        ? '<span class="font-semibold text-green-300">Phụ huynh đã xem ✓</span>'
        : '<span class="text-yellow-200">Chưa xem</span>';
      return `
        <article class="rounded-lg border border-cream-dim/20 bg-navy-950/60 p-4" data-video-id="${escapeHtml(item.id)}">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="font-semibold text-cream">${escapeHtml(item.title || 'Video buổi học')}</h3>
              <p class="mt-1 text-xs text-cream-dim">${escapeHtml(formatDate(item.ts))} · ${escapeHtml(formatBytes(item.size))}</p>
            </div>
            <button
              type="button"
              data-action="delete"
              class="min-h-11 rounded-lg border border-red-500/40 px-4 py-2 text-sm font-semibold text-red-200 transition hover:bg-red-500/10"
            >
              Xoá
            </button>
          </div>
          ${item.note_vi ? `<p class="mt-3 text-sm leading-relaxed text-cream-muted">${escapeHtml(item.note_vi)}</p>` : ''}
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs text-cream-muted">
            <span>${seen}</span>
            <span>❤️ ${Number(reactions.heart) || 0}</span>
            <span>👏 ${Number(reactions.clap) || 0}</span>
            <span>💪 ${Number(reactions.strong) || 0}</span>
          </div>
        </article>
      `;
    }

    async function loadPortfolio() {
      const code = codeSelect.value;
      list.innerHTML = '';
      if (!code) {
        listStatus.textContent = 'Chọn học sinh để xem danh sách.';
        return;
      }
      listStatus.textContent = 'Đang tải...';
      try {
        const response = await fetch(`/api/admin/portfolio?code=${encodeURIComponent(code)}`);
        const payload = await response.json();
        if (!response.ok || !payload.ok) throw new Error(payload.message || payload.error || 'Không tải được');
        const items = payload.items || [];
        listStatus.textContent = items.length ? `${items.length} video.` : 'Chưa có video nào.';
        list.innerHTML = items.map(renderItem).join('');
      } catch {
        listStatus.textContent = 'Không tải được danh sách video. Vui lòng thử lại.';
      }
    }

    function uploadWithProgress(formData) {
      return new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/admin/portfolio/upload');
        xhr.responseType = 'json';
        xhr.upload.addEventListener('progress', (event) => {
          if (!event.lengthComputable) return;
          const percent = Math.min(99, Math.round((event.loaded / event.total) * 100));
          progressBar.style.width = `${percent}%`;
          progressLabel.textContent = `${percent}%`;
        });
        xhr.addEventListener('load', () => {
          const payload = xhr.response || {};
          if (xhr.status >= 200 && xhr.status < 300 && payload.ok) {
            progressBar.style.width = '100%';
            progressLabel.textContent = '100%';
            resolve(payload);
          } else {
            reject(new Error(payload.message || payload.error || 'Tải video thất bại'));
          }
        });
        xhr.addEventListener('error', () => reject(new Error('Mạng không ổn định. Vui lòng thử lại.')));
        xhr.send(formData);
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const file = videoInput.files?.[0];
      if (!file) {
        showResult('Vui lòng chọn video.', false);
        return;
      }
      if (file.size > MAX_VIDEO_BYTES) {
        showResult('Video tối đa 80MB.', false);
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = 'Đang gửi...';
      resultBox.classList.add('hidden');
      progressWrap.classList.remove('hidden');
      progressBar.style.width = '0%';
      progressLabel.textContent = '0%';

      try {
        await uploadWithProgress(new FormData(form));
        showResult('Đã gửi video và nhận xét cho phụ huynh.', true);
        videoInput.value = '';
        form.querySelector('[name="title"]').value = '';
        form.querySelector('[name="note_vi"]').value = '';
        await loadPortfolio();
      } catch (error) {
        showResult(error.message || 'Chưa gửi được video. Vui lòng thử lại.', false);
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Gửi cho phụ huynh';
        setTimeout(() => progressWrap.classList.add('hidden'), 500);
      }
    });

    list.addEventListener('click', async (event) => {
      const button = event.target.closest('button[data-action="delete"]');
      if (!button) return;
      const row = button.closest('[data-video-id]');
      const id = row?.dataset.videoId;
      const code = codeSelect.value;
      if (!id || !code) return;
      if (!confirm('Xoá video này? Phụ huynh sẽ không xem lại được.')) return;

      button.disabled = true;
      button.textContent = 'Đang xoá...';
      try {
        const response = await fetch(
          `/api/admin/portfolio/${encodeURIComponent(id)}?code=${encodeURIComponent(code)}`,
          { method: 'DELETE' },
        );
        const payload = await response.json();
        if (!response.ok || !payload.ok) throw new Error(payload.message || payload.error || 'Không xoá được');
        showResult('Đã xoá video.', true);
        await loadPortfolio();
      } catch (error) {
        showResult(error.message || 'Chưa xoá được video. Vui lòng thử lại.', false);
        button.disabled = false;
        button.textContent = 'Xoá';
      }
    });

    codeSelect.addEventListener('change', loadPortfolio);
    refreshButton.addEventListener('click', loadPortfolio);
    loadStudents();
  </script>
</BaseLayout>
