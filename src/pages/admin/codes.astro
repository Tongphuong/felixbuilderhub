---
import AdminLayout from '../../layouts/AdminLayout.astro';
import EditCodeModal from '../../components/admin/EditCodeModal.astro';
---

<AdminLayout
  title="Quản lý mã đăng nhập Read2Lead | Felix Admin"
  description="Trang admin để tạo và quản lý access code Read2Lead."
>
  <section class="mx-auto max-w-7xl px-4 py-8 md:px-6 md:py-10">
    <h1 class="admin-page-title font-display text-3xl font-bold text-cream">Quản lý mã Read2Lead</h1>
    <p class="mt-2 text-cream-muted">Tạo mã mới + xem danh sách + edit/revoke.</p>

    <!-- Create new code -->
    <div class="mt-8 rounded-2xl border border-cream-dim/20 bg-navy-900/70 p-6">
      <h2 class="font-display text-xl font-bold text-cream">Tạo mã mới</h2>
      <form id="create-form" class="mt-5 grid gap-4 md:grid-cols-2">
        <div>
          <label class="mb-1 block text-sm text-cream-muted">Tên phụ huynh <span class="text-red-400">*</span></label>
          <input name="parent_name" required maxlength="100" placeholder="Chị Mai" class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none" />
        </div>
        <div>
          <label class="mb-1 block text-sm text-cream-muted">Zalo / SĐT</label>
          <input name="parent_zalo" maxlength="30" placeholder="0901234567" class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none" />
        </div>
        <div>
          <label class="mb-1 block text-sm text-cream-muted">Tên con <span class="text-red-400">*</span></label>
          <input name="student_name" required maxlength="50" placeholder="Linh" class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none" />
          <p class="mt-1 text-xs text-cream-dim">Nếu điền tên con, mã sẽ dễ nhớ hơn, ví dụ R2L-LINH-A4F2. Tên chỉ dùng chữ cái — không số (vd. "Pilot", không "Pilot L3").</p>
        </div>
        <div>
          <label class="mb-1 block text-sm text-cream-muted">Tuổi con <span class="text-red-400">*</span></label>
          <input name="student_age" type="number" min="5" max="14" required placeholder="8" class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none" />
        </div>
        <div class="rounded-lg border border-accent/30 bg-accent/10 p-4 text-sm leading-relaxed text-cream-muted md:col-span-2">
          Tài khoản mới luôn bắt đầu ở L1. Với <strong class="text-cream">mã test</strong>, anh có thể set L1–L5 trong danh sách bên dưới để pilot nhanh (ví dụ L3 cho Phase 1).
        </div>
        <div>
          <label class="mb-1 block text-sm text-cream-muted">Giới tính <span class="text-red-400">*</span></label>
          <select name="child_gender" required class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none">
            <option value="">Chưa chọn</option>
            <option value="girl">Bé gái</option>
            <option value="boy">Bé trai</option>
          </select>
        </div>
        <div>
          <label class="mb-1 block text-sm text-cream-muted">Số lượt</label>
          <input name="uses" type="number" min="1" max="1000" value="10" required class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none" />
        </div>
        <div>
          <label class="mb-1 block text-sm text-cream-muted">Hạn (ngày)</label>
          <input name="expiry_days" type="number" min="1" max="3650" value="60" required class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none" />
        </div>
        <div class="md:col-span-2">
          <label class="mb-1 block text-sm text-cream-muted">Ghi chú</label>
          <input name="notes" maxlength="500" placeholder="Bé Linh, L2, thử nghiệm" class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none" />
        </div>
        <div class="grid gap-3 rounded-lg border border-cream-dim/20 bg-navy-950/60 p-4 md:col-span-2 sm:grid-cols-2">
          <label class="flex cursor-pointer items-start gap-3 text-sm text-cream">
            <input name="is_test" type="checkbox" class="mt-1 h-4 w-4 accent-accent" />
            <span>
              <span class="block font-semibold text-cream">Mã test</span>
              <span class="block text-xs text-cream-muted">Không bắt buộc nộp bài cũ trước khi tạo bài mới.</span>
            </span>
          </label>
          <label class="flex cursor-pointer items-start gap-3 text-sm text-cream">
            <input name="is_shared" type="checkbox" class="mt-1 h-4 w-4 accent-accent" />
            <span>
              <span class="block font-semibold text-cream">Mã dùng chung</span>
              <span class="block text-xs text-cream-muted">Dùng cho pilot/Facebook nhiều phụ huynh, không enforce progression.</span>
            </span>
          </label>
        </div>
        <div class="md:col-span-2">
          <button type="submit" class="w-full rounded-lg bg-accent px-5 py-2.5 font-semibold text-navy-950 transition hover:bg-accent-hover sm:w-auto">Tạo mã</button>
        </div>
      </form>
      <div id="create-result" class="mt-5 hidden rounded-lg border border-gold/40 bg-gold/10 p-4 text-cream">
        <p class="text-sm text-cream-muted">Mã mới (bấm để copy):</p>
        <button id="copy-code" type="button" class="mt-2 inline-flex items-center gap-2 rounded-lg bg-navy-950 px-4 py-2 font-mono text-2xl font-bold text-gold-light transition hover:bg-navy-800"></button>
        <p id="copy-status" class="mt-2 text-xs text-cream-dim"></p>
      </div>
      <div id="create-error" class="mt-5 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-4 text-red-300"></div>
    </div>

    <!-- Search & filters -->
    <div class="mt-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-display text-xl font-bold text-cream">Danh sách mã</h2>
        <div class="flex flex-wrap gap-2">
          <button id="sync-bot-presets" type="button" class="rounded-lg border border-purple-400/40 px-3 py-1.5 text-sm text-purple-200 transition hover:bg-purple-500/10">🤖 Sync bot (Pilot + Ong)</button>
          <button id="reset-levels" type="button" class="rounded-lg border border-red-500/40 px-3 py-1.5 text-sm text-red-300 transition hover:bg-red-500/10">Reset tất cả về L1</button>
          <button id="refresh-list" type="button" class="rounded-lg border border-cream-dim/30 px-3 py-1.5 text-sm text-cream transition hover:border-accent hover:text-accent">↻ Tải lại</button>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <div class="relative flex-1 min-w-[240px]">
          <input
            id="search-codes"
            type="text"
            placeholder="Tìm mã, tên phụ huynh, tên con..."
            class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 pl-9 text-cream focus:border-accent focus:outline-none"
          />
          <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-cream-dim" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <button type="button" data-filter="all" class="filter-chip rounded-full border border-accent/40 bg-accent/15 px-3 py-1 text-xs font-semibold text-accent transition hover:bg-accent/25">Tất cả</button>
          <button type="button" data-filter="active" class="filter-chip rounded-full border border-cream-dim/20 bg-navy-950/60 px-3 py-1 text-xs font-semibold text-cream-muted transition hover:border-green-400/40 hover:text-green-300">Hoạt động</button>
          <button type="button" data-filter="expired" class="filter-chip rounded-full border border-cream-dim/20 bg-navy-950/60 px-3 py-1 text-xs font-semibold text-cream-muted transition hover:border-red-400/40 hover:text-red-300">Hết hạn</button>
          <button type="button" data-filter="exhausted" class="filter-chip rounded-full border border-cream-dim/20 bg-navy-950/60 px-3 py-1 text-xs font-semibold text-cream-muted transition hover:border-amber-400/40 hover:text-amber-300">Hết lượt</button>
          <button type="button" data-filter="test" class="filter-chip rounded-full border border-cream-dim/20 bg-navy-950/60 px-3 py-1 text-xs font-semibold text-cream-muted transition hover:border-yellow-400/40 hover:text-yellow-300">Test</button>
          <button type="button" data-filter="shared" class="filter-chip rounded-full border border-cream-dim/20 bg-navy-950/60 px-3 py-1 text-xs font-semibold text-cream-muted transition hover:border-blue-400/40 hover:text-blue-300">Shared</button>
        </div>
      </div>

      <p id="list-status" class="mt-3 text-sm text-cream-dim">Đang tải...</p>
      <div id="codes-list" class="mt-5 space-y-3"></div>
      <div id="load-more-wrap" class="mt-5 hidden text-center">
        <button id="load-more" type="button" class="rounded-lg border border-cream-dim/30 px-5 py-2 text-sm font-medium text-cream transition hover:border-accent hover:text-accent">Tải thêm →</button>
      </div>
    </div>
  </section>

  <EditCodeModal />

  <script>
    import { escapeHtml, formatDate, TEST_LEVELS } from '../../lib/admin-shared.mjs';

    const createForm = document.getElementById('create-form');
    const createResult = document.getElementById('create-result');
    const createError = document.getElementById('create-error');
    const copyCodeBtn = document.getElementById('copy-code');
    const copyStatus = document.getElementById('copy-status');
    const refreshBtn = document.getElementById('refresh-list');
    const resetLevelsBtn = document.getElementById('reset-levels');
    const syncBotPresetsBtn = document.getElementById('sync-bot-presets');
    const listEl = document.getElementById('codes-list');
    const listStatus = document.getElementById('list-status');
    const searchInput = document.getElementById('search-codes');
    const loadMoreWrap = document.getElementById('load-more-wrap');
    const loadMoreBtn = document.getElementById('load-more');
    const filterChips = document.querySelectorAll('.filter-chip');
    const editModal = document.getElementById('edit-code-modal');
    const editForm = document.getElementById('edit-code-form');

    let allItems = [];
    let filteredItems = [];
    let activeFilter = 'all';
    let searchQuery = '';
    let nextCursor = null;
    let listComplete = true;

    function showCreateError(msg) {
      createResult.classList.add('hidden');
      createError.classList.remove('hidden');
      createError.textContent = '⚠ ' + msg;
    }

    function showCreatedCode(code) {
      createError.classList.add('hidden');
      createResult.classList.remove('hidden');
      copyCodeBtn.textContent = code;
      copyStatus.textContent = 'Bấm vào mã để copy.';
    }

    copyCodeBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyCodeBtn.textContent);
        copyStatus.textContent = '✓ Đã copy vào clipboard.';
      } catch {
        copyStatus.textContent = 'Không copy được — bôi đen mã và copy tay.';
      }
    });

    createForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = createForm.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Đang tạo...';
      const data = Object.fromEntries(new FormData(createForm));
      try {
        const res = await fetch('/api/admin/codes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (res.ok && result.ok) {
          showCreatedCode(result.code);
          createForm.reset();
          createForm.querySelector('[name=uses]').value = '10';
          createForm.querySelector('[name=expiry_days]').value = '60';
          await loadList();
        } else {
          showCreateError(result.message || result.error || 'Lỗi không xác định');
        }
      } catch (err) {
        showCreateError('Lỗi mạng: ' + err.message);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Tạo mã';
      }
    });

    function filterItems() {
      const q = searchQuery.toLowerCase().trim();
      filteredItems = allItems.filter((item) => {
        const profile = item.student_profile || {};
        const progress = item.progress || {};
        const studentName = profile.student_name || progress.student_name || '';
        const parentName = item.parent_name || '';
        const code = item.code || '';

        const matchesSearch = !q ||
          code.toLowerCase().includes(q) ||
          parentName.toLowerCase().includes(q) ||
          studentName.toLowerCase().includes(q);

        const today = new Date().toISOString().slice(0, 10);
        const expired = item.expires_at && item.expires_at < today;
        const exhausted = (item.uses_remaining ?? 0) <= 0;
        const active = !expired && !exhausted;

        let matchesFilter = true;
        if (activeFilter === 'active') matchesFilter = active;
        else if (activeFilter === 'expired') matchesFilter = expired;
        else if (activeFilter === 'exhausted') matchesFilter = exhausted;
        else if (activeFilter === 'test') matchesFilter = item.is_test;
        else if (activeFilter === 'shared') matchesFilter = item.is_shared;

        return matchesSearch && matchesFilter;
      });
      renderFilteredItems();
    }

    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      filterItems();
    });

    filterChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        filterChips.forEach((c) => {
          c.classList.remove('border-accent/40', 'bg-accent/15', 'text-accent');
          c.classList.add('border-cream-dim/20', 'bg-navy-950/60', 'text-cream-muted');
        });
        chip.classList.remove('border-cream-dim/20', 'bg-navy-950/60', 'text-cream-muted');
        chip.classList.add('border-accent/40', 'bg-accent/15', 'text-accent');
        activeFilter = chip.dataset.filter;
        filterItems();
      });
    });

    function renderItem(item) {
      const today = new Date().toISOString().slice(0, 10);
      const expired = item.expires_at && item.expires_at < today;
      const exhausted = (item.uses_remaining ?? 0) <= 0;
      const status = expired ? 'Hết hạn' : exhausted ? 'Hết lượt' : 'Hoạt động';
      const statusColor = expired || exhausted ? 'text-red-400 border-red-500/40' : 'text-green-400 border-green-500/40';
      const usesRemaining = item.uses_remaining;
      const usesTotal = item.uses_total ?? item.uses_remaining;
      const usesLabel = usesRemaining != null && usesTotal != null
        ? `${usesRemaining} / ${usesTotal}`
        : usesRemaining != null ? `${usesRemaining} / —` : '—';
      const profile = item.student_profile || {};
      const progress = item.progress || {};
      const studentName = profile.student_name || progress.student_name || '';
      const studentAge = profile.age ?? progress.age ?? '';
      const studentLevel = progress.current_level || profile.level || '';
      const flags = [
        item.is_test ? '<span class="rounded-md border border-yellow-500/40 px-2 py-0.5 text-[11px] font-semibold text-yellow-300">TEST</span>' : '',
        item.is_shared ? '<span class="rounded-md border border-blue-500/40 px-2 py-0.5 text-[11px] font-semibold text-blue-300">SHARED</span>' : '',
      ].filter(Boolean).join(' ');
      const levelOptions = TEST_LEVELS.map(
        ([value, label]) => `<option value="${value}"${studentLevel === value ? ' selected' : ''}>${label}</option>`,
      ).join('');
      const testLevelControls = item.is_test
        ? `
          <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-yellow-500/20 pt-3">
            <span class="text-xs font-semibold text-yellow-300">Set level (test):</span>
            <select data-role="test-level" class="fx-field rounded border border-yellow-500/30 bg-navy-950 px-2 py-1 text-xs text-cream focus:border-accent focus:outline-none">
              ${levelOptions}
            </select>
            <button type="button" data-action="set-level" class="rounded border border-yellow-500/40 px-3 py-1 text-xs font-semibold text-yellow-200 transition hover:bg-yellow-500/10">Áp dụng</button>
          </div>
        `
        : '';
      const botStatsControls = item.is_test || item.is_bot
        ? `
          <div class="mt-3 flex flex-wrap items-end gap-2 border-t border-purple-500/20 pt-3">
            <span class="w-full text-xs font-semibold text-purple-300">🤖 Set bot stats (hiện trên bảng xếp hạng):</span>
            <label class="text-xs text-cream-muted">
              Rank
              <input data-role="bot-rank" type="text" placeholder="Vàng II" value="${escapeHtml(progress.rank_title || '')}" class="fx-field mt-0.5 block w-24 rounded border border-purple-500/30 bg-navy-950 px-2 py-1 text-xs text-cream focus:border-accent focus:outline-none" />
            </label>
            <label class="text-xs text-cream-muted">
              Bài
              <input data-role="bot-packs" type="number" min="0" value="${escapeHtml(progress.completed_packs ?? '')}" class="fx-field mt-0.5 block w-16 rounded border border-purple-500/30 bg-navy-950 px-2 py-1 text-xs text-cream focus:border-accent focus:outline-none" />
            </label>
            <label class="text-xs text-cream-muted">
              Xu
              <input data-role="bot-coins" type="number" min="0" value="${escapeHtml(progress.coins ?? '')}" class="fx-field mt-0.5 block w-20 rounded border border-purple-500/30 bg-navy-950 px-2 py-1 text-xs text-cream focus:border-accent focus:outline-none" />
            </label>
            <button type="button" data-action="set-bot-stats" class="rounded border border-purple-500/40 px-3 py-1 text-xs font-semibold text-purple-200 transition hover:bg-purple-500/10">Áp dụng</button>
          </div>
        `
        : '';

      return `
        <article class="rounded-xl border border-cream-dim/20 bg-navy-950/60 p-4 transition hover:border-cream-dim/30" data-code="${escapeHtml(item.code)}">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="font-mono text-lg font-bold text-gold-light">${escapeHtml(item.code)}</p>
              <p class="mt-1 text-sm text-cream">
                <strong>${escapeHtml(item.parent_name || '(chưa có thông tin)')}</strong>
                ${item.parent_zalo ? ' · ' + escapeHtml(item.parent_zalo) : ''}
              </p>
              ${item.notes ? `<p class="mt-1 text-xs text-cream-dim">${escapeHtml(item.notes)}</p>` : ''}
              ${studentName ? `<p class="mt-1 text-xs text-accent">Con: ${escapeHtml(studentName)}${studentAge ? ' · ' + escapeHtml(studentAge) + ' tuổi' : ''}${studentLevel ? ' · ' + escapeHtml(studentLevel) : ''}</p>` : ''}
              ${flags ? `<div class="mt-2 flex flex-wrap gap-1.5">${flags}</div>` : ''}
            </div>
            <span class="rounded-md border px-2 py-1 text-xs font-semibold ${statusColor}">${status}</span>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2 text-xs text-cream-muted sm:grid-cols-4">
            <div><span class="text-cream-dim">Lượt:</span> ${usesLabel}</div>
            <div><span class="text-cream-dim">Level:</span> ${escapeHtml(studentLevel || '—')}</div>
            <div><span class="text-cream-dim">Hết hạn:</span> ${escapeHtml(formatDate(item.expires_at))}</div>
            <div><span class="text-cream-dim">Dùng lần cuối:</span> ${escapeHtml(formatDate(item.last_used_at))}</div>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" data-action="edit" class="rounded border border-cream-dim/30 px-3 py-1 text-xs text-cream transition hover:border-accent hover:text-accent">✏️ Sửa</button>
            <button type="button" data-action="refund" class="rounded border border-cream-dim/30 px-3 py-1 text-xs text-cream transition hover:border-accent hover:text-accent">+1 lượt</button>
            <button type="button" data-action="extend" class="rounded border border-cream-dim/30 px-3 py-1 text-xs text-cream transition hover:border-accent hover:text-accent">+30 ngày</button>
            <button type="button" data-action="toggle-test" class="rounded border border-yellow-500/40 px-3 py-1 text-xs text-yellow-300 transition hover:bg-yellow-500/10">${item.is_test ? 'Test OFF' : 'Test ON'}</button>
            <button type="button" data-action="toggle-shared" class="rounded border border-blue-500/40 px-3 py-1 text-xs text-blue-300 transition hover:bg-blue-500/10">${item.is_shared ? 'Shared OFF' : 'Shared ON'}</button>
            <button type="button" data-action="copy" class="rounded border border-cream-dim/30 px-3 py-1 text-xs text-cream transition hover:border-accent hover:text-accent">📋 Copy</button>
            <button type="button" data-action="create-link" class="rounded border border-purple-500/40 px-3 py-1 text-xs text-purple-300 transition hover:bg-purple-500/10">🔗 Link</button>
            <button type="button" data-action="revoke" class="rounded border border-red-500/40 px-3 py-1 text-xs text-red-300 transition hover:bg-red-500/10">🗑️ Revoke</button>
          </div>
          ${testLevelControls}
          ${botStatsControls}
          <div data-link-result class="mt-3 hidden rounded-lg border border-purple-500/30 bg-purple-500/10 p-3">
            <p class="text-xs text-cream-muted">Magic link (bấm để copy):</p>
            <button type="button" data-role="copy-link" class="mt-1 block w-full break-all rounded bg-navy-950 px-3 py-2 text-left font-mono text-sm text-purple-200 transition hover:bg-navy-800"></button>
            <p data-link-copy-status class="mt-1 text-xs text-cream-dim"></p>
          </div>
        </article>
      `;
    }

    function renderFilteredItems() {
      if (filteredItems.length === 0) {
        listEl.innerHTML = '';
        listStatus.textContent = allItems.length === 0 ? 'Chưa có mã nào.' : 'Không tìm thấy mã phù hợp.';
        loadMoreWrap.classList.add('hidden');
        return;
      }
      listStatus.textContent = `${filteredItems.length} mã${filteredItems.length !== allItems.length ? ` (trong tổng ${allItems.length})` : ''}.`;
      listEl.innerHTML = filteredItems.map(renderItem).join('');
      loadMoreWrap.classList.toggle('hidden', listComplete);
    }

    async function loadList() {
      listStatus.textContent = 'Đang tải...';
      try {
        const res = await fetch('/api/admin/codes');
        const result = await res.json();
        if (!res.ok || !result.ok) {
          listStatus.textContent = '⚠ Lỗi: ' + (result.message || result.error || 'Không tải được');
          return;
        }
        allItems = result.items || [];
        nextCursor = result.cursor || null;
        listComplete = result.list_complete || true;
        filterItems();
      } catch (err) {
        listStatus.textContent = '⚠ Lỗi mạng: ' + err.message;
      }
    }

    async function loadMore() {
      if (!nextCursor || listComplete) return;
      loadMoreBtn.disabled = true;
      loadMoreBtn.textContent = 'Đang tải...';
      try {
        const res = await fetch(`/api/admin/codes?cursor=${encodeURIComponent(nextCursor)}`);
        const result = await res.json();
        if (res.ok && result.ok) {
          allItems = [...allItems, ...(result.items || [])];
          nextCursor = result.cursor || null;
          listComplete = result.list_complete || true;
          filterItems();
        }
      } catch (err) {
        console.error('Load more failed:', err);
      } finally {
        loadMoreBtn.disabled = false;
        loadMoreBtn.textContent = 'Tải thêm →';
      }
    }

    loadMoreBtn.addEventListener('click', loadMore);

    async function patchCode(code, body) {
      const res = await fetch(`/api/admin/codes/${encodeURIComponent(code)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      return res.json();
    }

    function addDaysToISO(iso, days) {
      const d = new Date(iso + 'T00:00:00Z');
      d.setUTCDate(d.getUTCDate() + days);
      return d.toISOString().slice(0, 10);
    }

    listEl.addEventListener('click', async (e) => {
      const copyLinkBtn = e.target.closest('[data-role="copy-link"]');
      if (copyLinkBtn) {
        try {
          await navigator.clipboard.writeText(copyLinkBtn.textContent);
          const status = copyLinkBtn.closest('[data-link-result]')?.querySelector('[data-link-copy-status]');
          if (status) status.textContent = '✓ Đã copy link vào clipboard.';
        } catch {
          const status = copyLinkBtn.closest('[data-link-result]')?.querySelector('[data-link-copy-status]');
          if (status) status.textContent = 'Không copy được — bôi đen link và copy tay.';
        }
        return;
      }

      const btn = e.target.closest('button[data-action]');
      if (!btn) return;
      const article = btn.closest('article[data-code]');
      const code = article?.dataset.code;
      if (!code) return;
      const action = btn.dataset.action;

      if (action === 'copy') {
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = '✓ Copied';
          setTimeout(() => (btn.textContent = '📋 Copy'), 1500);
        } catch {
          alert('Copy thất bại — bôi đen mã và copy tay.');
        }
        return;
      }

      if (action === 'create-link') {
        btn.disabled = true;
        btn.textContent = 'Đang tạo...';
        try {
          const res = await fetch(`/api/admin/codes/${encodeURIComponent(code)}/links`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({}),
          });
          const result = await res.json();
          if (res.ok && result.ok && result.link) {
            const linkResult = article.querySelector('[data-link-result]');
            const copyLinkBtn = article.querySelector('[data-role="copy-link"]');
            const linkStatus = article.querySelector('[data-link-copy-status]');
            if (linkResult && copyLinkBtn) {
              copyLinkBtn.textContent = result.link;
              linkResult.classList.remove('hidden');
              if (linkStatus) linkStatus.textContent = 'Bấm vào link để copy. Gửi link này qua Zalo cho phụ huynh.';
            }
          } else {
            alert('Lỗi tạo link: ' + (result.error || 'Không xác định'));
          }
        } catch (err) {
          alert('Lỗi mạng: ' + err.message);
        } finally {
          btn.disabled = false;
          btn.textContent = '🔗 Link';
        }
        return;
      }

      if (action === 'revoke') {
        if (!confirm(`Revoke mã ${code}? Không thể khôi phục.`)) return;
        const res = await fetch(`/api/admin/codes/${encodeURIComponent(code)}`, { method: 'DELETE' });
        const result = await res.json();
        if (res.ok && result.ok) {
          await loadList();
        } else {
          alert('Lỗi: ' + (result.error || 'Không revoke được'));
        }
        return;
      }

      if (action === 'refund') {
        const current = allItems.find((it) => it.code === code);
        if (!current) return;
        const result = await patchCode(code, { uses_remaining: (current.uses_remaining ?? 0) + 1 });
        if (result.ok) await loadList();
        else alert('Lỗi: ' + (result.error || 'patch failed'));
        return;
      }

      if (action === 'extend') {
        const current = allItems.find((it) => it.code === code);
        if (!current) return;
        const today = new Date().toISOString().slice(0, 10);
        const base = (current.expires_at || today) < today ? today : current.expires_at || today;
        const newExpiry = addDaysToISO(base, 30);
        const result = await patchCode(code, { expires_at: newExpiry });
        if (result.ok) await loadList();
        else alert('Lỗi: ' + (result.error || 'patch failed'));
        return;
      }

      if (action === 'toggle-test' || action === 'toggle-shared') {
        const current = allItems.find((it) => it.code === code);
        if (!current) return;
        const field = action === 'toggle-test' ? 'is_test' : 'is_shared';
        const result = await patchCode(code, { [field]: !current[field] });
        if (result.ok) await loadList();
        else alert('Lỗi: ' + (result.error || 'patch failed'));
        return;
      }

      if (action === 'set-level') {
        const select = article.querySelector('[data-role="test-level"]');
        const level = select?.value;
        if (!level) return;
        if (!confirm(`Set ${code} → ${level}? Chỉ dùng cho mã test / pilot.`)) return;
        btn.disabled = true;
        btn.textContent = 'Đang set...';
        try {
          const res = await fetch(`/api/admin/codes/${encodeURIComponent(code)}/set-level`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ level }),
          });
          const result = await res.json();
          if (!res.ok || !result.ok) {
            alert(result.message || result.error || 'Không set level được');
            return;
          }
          await loadList();
        } catch (err) {
          alert('Lỗi mạng: ' + err.message);
        } finally {
          btn.disabled = false;
          btn.textContent = 'Áp dụng';
        }
        return;
      }

      if (action === 'set-bot-stats') {
        const rankLabelVi = article.querySelector('[data-role="bot-rank"]')?.value.trim();
        const completedPacks = article.querySelector('[data-role="bot-packs"]')?.value;
        const coins = article.querySelector('[data-role="bot-coins"]')?.value;
        if (!rankLabelVi) {
          alert('Nhập rank (vd. "Vàng II") trước khi áp dụng.');
          return;
        }
        if (!confirm(`Set ${code} trên bảng xếp hạng → ${rankLabelVi}, ${completedPacks || 0} bài, ${coins || 0} xu?`)) return;
        btn.disabled = true;
        btn.textContent = 'Đang set...';
        try {
          const res = await fetch(`/api/admin/codes/${encodeURIComponent(code)}/set-bot-stats`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              rank_label_vi: rankLabelVi,
              completed_packs: Number(completedPacks) || 0,
              coins: coins === '' ? undefined : Number(coins),
            }),
          });
          const result = await res.json();
          if (!res.ok || !result.ok) {
            alert(result.message || result.error || 'Không set được bot stats');
            return;
          }
          await loadList();
        } catch (err) {
          alert('Lỗi mạng: ' + err.message);
        } finally {
          btn.disabled = false;
          btn.textContent = 'Áp dụng';
        }
        return;
      }

      if (action === 'edit') {
        const current = allItems.find((it) => it.code === code);
        if (!current) return;
        const profile = current.student_profile || {};
        const progress = current.progress || {};

        document.getElementById('edit-modal-code').value = code;
        document.getElementById('edit-parent-name').value = current.parent_name || '';
        document.getElementById('edit-parent-zalo').value = current.parent_zalo || '';
        document.getElementById('edit-student-name').value = profile.student_name || progress.student_name || '';
        document.getElementById('edit-student-age').value = profile.age ?? progress.age ?? '';
        document.getElementById('edit-child-gender').value = profile.child_gender || progress.child_gender || '';
        document.getElementById('edit-notes').value = current.notes || '';

        editModal.showModal();
      }
    });

    editForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('edit-modal-code').value;
      const body = {
        parent_name: document.getElementById('edit-parent-name').value,
        parent_zalo: document.getElementById('edit-parent-zalo').value,
        notes: document.getElementById('edit-notes').value,
        student_profile: {
          student_name: document.getElementById('edit-student-name').value,
          age: document.getElementById('edit-student-age').value,
          child_gender: document.getElementById('edit-child-gender').value,
        },
      };
      const result = await patchCode(code, body);
      if (result.ok) {
        editModal.close();
        await loadList();
      } else {
        alert('Lỗi: ' + (result.error || 'patch failed'));
      }
    });

    refreshBtn.addEventListener('click', loadList);

    syncBotPresetsBtn.addEventListener('click', async () => {
      if (!confirm('Áp dụng stats cố định cho Pilot (Vàng II, 39 bài) và Ong (Vàng III, 19 bài)?')) return;
      syncBotPresetsBtn.disabled = true;
      syncBotPresetsBtn.textContent = 'Đang sync...';
      try {
        const res = await fetch('/api/admin/codes/apply-bot-presets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ presets: ['pilot', 'ong'] }),
        });
        const result = await res.json();
        if (!res.ok || !result.ok) throw new Error(result.message || result.error || 'sync failed');
        const lines = (result.results || [])
          .filter((row) => row.ok)
          .map((row) => `${row.display_name}: ${row.rank_label_vi} · ${row.completed_packs} bài · ${row.coins} xu`);
        alert(`Đã sync ${result.applied} bot.\n${lines.join('\n')}`);
        await loadList();
      } catch (err) {
        alert('Lỗi sync bot: ' + err.message);
      } finally {
        syncBotPresetsBtn.disabled = false;
        syncBotPresetsBtn.textContent = '🤖 Sync bot (Pilot + Ong)';
      }
    });

    resetLevelsBtn.addEventListener('click', async () => {
      if (!confirm('Reset TẤT CẢ mã Read2Lead về L1 và xoá XP/progress V2 hiện tại?')) return;
      resetLevelsBtn.disabled = true;
      resetLevelsBtn.textContent = 'Đang reset...';
      try {
        const res = await fetch('/api/admin/codes/reset-levels', { method: 'POST' });
        const result = await res.json();
        if (!res.ok || !result.ok) throw new Error(result.error || 'reset failed');
        alert(`Đã reset ${result.reset} / ${result.scanned} mã về L1.`);
        await loadList();
      } catch (err) {
        alert('Lỗi reset: ' + err.message);
      } finally {
        resetLevelsBtn.disabled = false;
        resetLevelsBtn.textContent = 'Reset tất cả về L1';
      }
    });

    loadList();
  </script>
</AdminLayout>
