---
import '../styles/global.css';
import { ZALO_URL } from '../config/contact';

export interface Props { title: string; description?: string; ogImage?: string; }
const {
  title,
  description = 'Phương xây dựng các sản phẩm giáo dục dành riêng cho mỗi bạn nhỏ. My Story My World, Read2Lead, Felix Sharing Space.',
  ogImage = '/logo/felixbuilderhub_website_header_logo.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://felixbuilderhub.com').toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://felixbuilderhub.com').toString();
---
<!DOCTYPE html>
<html lang="vi" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Felix Builder Hub" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/png" href="/logo/felixbuilderhub_favicon.png" />
    <link rel="apple-touch-icon" href="/logo/felixbuilderhub_favicon.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap&subset=vietnamese" rel="stylesheet" />
  </head>
  <body class="star-field font-sans bg-navy-950 text-cream min-h-screen flex flex-col antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:font-semibold focus:text-navy-950">Bỏ qua tới nội dung chính</a>
    <slot />
    <a
      data-sticky-zalo
      href={ZALO_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Nhắn Zalo Felix"
      class="fixed bottom-5 right-5 z-40 inline-flex items-center gap-2 rounded-full bg-accent px-4 py-3 font-semibold text-navy-950 shadow-2xl ring-2 ring-navy-950/40 transition-opacity duration-300 hover:bg-accent-hover hover:scale-105 print:hidden"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12 2a10 10 0 1 0 5.4 18.4l3.6 1.1-1.1-3.5A10 10 0 0 0 12 2Zm-4.1 8.5h2v.8c.5-.6 1.2-1 2.1-1 1.6 0 2.5 1 2.5 2.7v3.5h-2v-3.2c0-.9-.4-1.4-1.2-1.4-.8 0-1.4.6-1.4 1.5v3.1h-2v-6Zm-2.4 0h2v6h-2v-6Zm9.9 0h4.8v1.3l-3 3h3v1.7h-5v-1.3l3-3h-2.8v-1.7Z"/>
      </svg>
      <span class="hidden text-sm sm:inline">Nhắn Zalo</span>
    </a>
    <script>
      const stickyZalo = document.querySelector('[data-sticky-zalo]');
      const forms = document.querySelectorAll('form');

      if (stickyZalo && forms.length) {
        const observer = new IntersectionObserver((entries) => {
          const hasVisibleForm = entries.some((entry) => entry.isIntersecting);
          stickyZalo.classList.toggle('opacity-0', hasVisibleForm);
          stickyZalo.classList.toggle('pointer-events-none', hasVisibleForm);
        }, { threshold: 0.3 });

        forms.forEach((form) => observer.observe(form));
      }
    </script>
  </body>
</html>
