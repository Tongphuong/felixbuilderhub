---
// HomeworkModal — modal dialog for assigning homework to a class or a student.
---

<dialog
  id="homework-modal"
  class="rounded-2xl border border-cream-dim/20 bg-navy-900 p-0 shadow-2xl shadow-navy-950/50 backdrop:bg-navy-950/70 backdrop:backdrop-blur"
  aria-labelledby="homework-title"
>
  <form id="homework-form" method="dialog" class="flex flex-col">
    <div class="flex items-center justify-between border-b border-cream-dim/15 px-6 py-4">
      <h2 id="homework-title" class="font-display text-lg font-bold text-cream">Giao bài tập</h2>
      <button
        type="button"
        class="rounded-md p-1 text-cream-dim transition hover:text-cream"
        onclick="document.getElementById('homework-modal').close()"
        aria-label="Đóng"
      >
        ✕
      </button>
    </div>

    <div class="space-y-4 px-6 py-5">
      <input type="hidden" name="class_id" id="homework-class-id" />
      <input type="hidden" name="code" id="homework-code" />

      <div>
        <label class="mb-1 block text-sm font-medium text-cream-muted">Ảnh bài tập (tuỳ chọn)</label>
        <input type="file" id="homework-photo-input" accept="image/jpeg,image/png,image/webp" class="hidden" />
        <button
          type="button"
          id="homework-photo-pick"
          class="w-full rounded-lg border border-dashed border-cream-dim/40 px-4 py-3 text-sm font-medium text-cream-muted transition hover:border-accent hover:text-accent"
        >
          📷 Thêm ảnh bài tập
        </button>
        <div id="homework-photo-preview" class="mt-2 hidden items-center gap-3">
          <img
            id="homework-photo-thumb"
            src=""
            alt="Ảnh bài tập"
            class="h-16 w-16 rounded-lg border border-cream-dim/30 object-cover"
          />
          <button
            type="button"
            id="homework-photo-remove"
            class="flex h-11 min-w-11 items-center justify-center rounded-lg border border-cream-dim/30 px-3 text-sm text-cream-dim transition hover:border-red-400 hover:text-red-300"
            aria-label="Xoá ảnh"
          >
            ✕ Xoá ảnh
          </button>
        </div>
        <p class="mt-1 text-xs text-cream-dim">Ảnh cũ sẽ bị thay khi lưu bài mới. Nhận JPEG/PNG/WebP, tối đa 8MB.</p>
        <p id="homework-photo-status" class="mt-1 hidden text-xs font-medium text-accent" role="status" aria-live="polite"></p>
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium text-cream-muted" for="homework-sentences">Câu / từ cần luyện</label>
        <textarea
          id="homework-sentences"
          name="sentences_text"
          rows="4"
          class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none"
          placeholder="I have two cats.&#10;She is very happy today."
        ></textarea>
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium text-cream-muted" for="homework-frame">Khung thuyết trình</label>
        <textarea
          id="homework-frame"
          name="frame_text"
          rows="4"
          class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none"
          placeholder="Last summer, I went to ___.&#10;I saw ___ there and it was ___."
        ></textarea>
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium text-cream-muted" for="homework-duration">Thời gian nói (giây)</label>
        <input
          type="number"
          id="homework-duration"
          name="frame_duration_s"
          value="60"
          min="10"
          max="600"
          class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none"
        />
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium text-cream-muted" for="homework-note">Ghi chú cho Minny</label>
        <input
          type="text"
          id="homework-note"
          name="note_vi"
          maxlength="300"
          class="fx-field w-full rounded-lg border border-cream-dim/30 bg-navy-950 px-3 py-2 text-cream focus:border-accent focus:outline-none"
          placeholder="(tuỳ chọn)"
        />
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-end gap-2 border-t border-cream-dim/15 px-6 py-4">
      <button
        type="button"
        class="rounded-lg border border-cream-dim/30 px-4 py-2 text-sm font-medium text-cream transition hover:border-accent hover:text-accent"
        onclick="document.getElementById('homework-modal').close()"
      >
        Hủy
      </button>
      <button
        type="submit"
        class="rounded-lg bg-accent px-5 py-2 text-sm font-semibold text-navy-950 transition hover:bg-accent-hover"
      >
        Lưu bài tập
      </button>
    </div>
  </form>
</dialog>
