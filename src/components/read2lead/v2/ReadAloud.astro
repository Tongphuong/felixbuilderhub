---
import MicCheckPanel from './MicCheckPanel.astro';
---

<section class="r2l-activity r2l-minny-activity" data-activity-shell="read_aloud" data-read-aloud-mode="sentence" data-read-aloud-state="idle" hidden>
  <div class="r2l-activity-head">
    <p class="r2l-identity" data-activity-identity></p>
    <h2 data-activity-title></h2>
    <p data-activity-instructions></p>
  </div>
  <div class="r2l-minny-hero-wrap">
    <div class="r2l-minny-hero" data-minny-hero="read_aloud">
      <video
        class="r2l-minny-video hidden"
        data-minny-video
        poster="/assets/minny/minny_idle.png"
        autoplay
        loop
        muted
        playsinline
        aria-hidden="true"
      ></video>
      <img
        class="r2l-minny-fallback"
        data-minny-fallback
        src="/assets/minny/minny_idle.png"
        alt="Minny"
        width="160"
        height="160"
      />
    </div>
  </div>
  <MicCheckPanel />
  <div data-activity-body>
    <!-- Story paragraphs — always visible for reference -->
    <div data-read-aloud-story class="r2l-read-aloud-story"></div>
    <!-- Sentence list (L1-L3) or continuous area (L4-L5) -->
    <div data-read-aloud-sentences class="r2l-read-aloud-sentences"></div>
    <!-- Recording controls -->
    <div data-read-aloud-controls class="r2l-read-aloud-controls"></div>
    <!-- Word-level feedback area -->
    <div data-read-aloud-feedback class="r2l-read-aloud-feedback"></div>
    <!-- Score summary (shown at end) -->
    <div data-read-aloud-summary class="r2l-read-aloud-summary hidden"></div>
  </div>
</section>

<style is:global>
  .r2l-read-aloud-story {
    margin-top: 0.75rem;
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.12);
    background: rgb(10 14 26 / 0.45);
    padding: 1rem;
    max-height: 180px;
    overflow-y: auto;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgb(245 230 211 / 0.82);
  }
  .r2l-read-aloud-story p {
    margin-bottom: 0.5rem;
  }
  .r2l-read-aloud-story p:last-child {
    margin-bottom: 0;
  }
  .r2l-read-aloud-sentences {
    margin-top: 0.75rem;
  }
  .r2l-read-aloud-controls {
    margin-top: 0.75rem;
  }
  .r2l-read-aloud-feedback {
    margin-top: 0.75rem;
  }
  .r2l-read-aloud-summary {
    margin-top: 0.75rem;
    border-radius: 8px;
    border: 1px solid rgb(74 222 128 / 0.35);
    background: rgb(74 222 128 / 0.08);
    padding: 1rem;
    text-align: center;
  }
  .r2l-read-aloud-summary h3 {
    font-family: Manrope, Inter, sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    color: rgb(74 222 128);
  }
  .r2l-read-aloud-summary p {
    margin-top: 0.5rem;
    color: rgb(245 230 211 / 0.72);
    font-size: 0.9rem;
  }
  .r2l-read-aloud-summary .r2l-read-aloud-grade {
    margin-top: 0.75rem;
    font-size: 2rem;
    font-weight: 900;
  }
  /* Sentence-by-sentence mode */
  .r2l-ra-sentence {
    border-radius: 8px;
    border: 1px solid rgb(245 230 211 / 0.10);
    background: rgb(10 14 26 / 0.35);
    padding: 0.75rem;
    margin-bottom: 0.5rem;
    transition: border-color 200ms ease, background 200ms ease;
  }
  .r2l-ra-sentence[data-sentence-state="active"] {
    border-color: rgb(212 166 78 / 0.45);
    background: rgb(212 166 78 / 0.08);
  }
  .r2l-ra-sentence[data-sentence-state="scored"] {
    border-color: rgb(74 222 128 / 0.35);
    background: rgb(74 222 128 / 0.06);
  }
  .r2l-ra-sentence[data-sentence-state="skipped"] {
    border-color: rgb(239 68 68 / 0.25);
    background: rgb(239 68 68 / 0.06);
    opacity: 0.6;
  }
  .r2l-ra-sentence-en {
    font-size: 1rem;
    font-weight: 700;
    color: rgb(245 230 211);
  }
  .r2l-ra-sentence-vi {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: rgb(245 230 211 / 0.55);
  }
  .r2l-ra-sentence-vi[data-read-aloud-vi-mode="hidden"] {
    visibility: hidden;
    max-height: 0;
    overflow: hidden;
    margin-top: 0;
  }
  .r2l-ra-sentence-vi[data-read-aloud-vi-mode="revealed"] {
    visibility: visible;
    max-height: 3rem;
    margin-top: 0.25rem;
  }
  .r2l-ra-audio-hint {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    min-width: 36px;
    border-radius: 999px;
    border: 1px solid rgb(245 230 211 / 0.2);
    background: transparent;
    color: rgb(245 230 211 / 0.72);
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 150ms ease;
  }
  .r2l-ra-audio-hint:hover {
    background: rgb(245 230 211 / 0.1);
  }
  .r2l-ra-sentence-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
    align-items: center;
  }
  .r2l-ra-record-btn {
    min-height: 44px;
    border-radius: 8px;
    border: 1px solid rgb(16 185 129 / 0.4);
    background: rgb(16 185 129 / 0.12);
    padding: 0.5rem 1rem;
    font-weight: 700;
    color: rgb(245 230 211);
    cursor: pointer;
    font-size: 0.9rem;
  }
  .r2l-ra-record-btn:hover:not(:disabled) {
    background: rgb(16 185 129 / 0.22);
  }
  .r2l-ra-record-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .r2l-ra-record-btn[data-recording="true"] {
    border-color: rgb(239 68 68 / 0.6);
    background: rgb(239 68 68 / 0.2);
  }
  .r2l-ra-skip-btn {
    border: none;
    background: none;
    color: rgb(245 230 211 / 0.45);
    font-size: 0.8rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .r2l-ra-skip-btn:hover {
    color: rgb(245 230 211 / 0.72);
  }
  .r2l-ra-progress {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }
  .r2l-ra-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(245 230 211 / 0.15);
    transition: background 200ms ease;
  }
  .r2l-ra-dot[data-state="done"] {
    background: rgb(74 222 128);
  }
  .r2l-ra-dot[data-state="active"] {
    background: rgb(212 166 78);
    transform: scale(1.3);
  }
  .r2l-ra-dot[data-state="skipped"] {
    background: rgb(239 68 68 / 0.5);
  }
  .r2l-ra-score-badge {
    display: inline-block;
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .r2l-ra-score-badge[data-grade="S"] { background: rgb(74 222 128 / 0.25); color: rgb(187 247 208); }
  .r2l-ra-score-badge[data-grade="A"] { background: rgb(16 185 129 / 0.25); color: rgb(110 231 183); }
  .r2l-ra-score-badge[data-grade="B"] { background: rgb(212 166 78 / 0.25); color: rgb(253 230 138); }
  .r2l-ra-score-badge[data-grade="F"] { background: rgb(239 68 68 / 0.25); color: rgb(252 165 165); }
  /* Continuous mode */
  .r2l-ra-continuous-area {
    margin-top: 0.75rem;
  }
  .r2l-ra-continuous-btn {
    min-height: 48px;
    width: 100%;
    border-radius: 8px;
    border: 1px solid rgb(16 185 129 / 0.4);
    background: rgb(16 185 129 / 0.12);
    padding: 0.75rem 1rem;
    font-weight: 700;
    font-size: 1rem;
    color: rgb(245 230 211);
    cursor: pointer;
  }
  .r2l-ra-continuous-btn:hover:not(:disabled) {
    background: rgb(16 185 129 / 0.22);
  }
  .r2l-ra-continuous-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .r2l-ra-continuous-btn[data-recording="true"] {
    border-color: rgb(239 68 68 / 0.6);
    background: rgb(239 68 68 / 0.2);
  }
  .r2l-ra-continuous-result {
    margin-top: 0.75rem;
  }
  .r2l-ra-continuous-sentence {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgb(245 230 211 / 0.06);
    font-size: 0.9rem;
  }
  .r2l-ra-continuous-sentence:last-child {
    border-bottom: none;
  }
  .r2l-ra-continuous-sentence .r2l-ra-sentence-index {
    flex-shrink: 0;
    width: 2rem;
    font-weight: 700;
    color: rgb(245 230 211 / 0.5);
  }
</style>
