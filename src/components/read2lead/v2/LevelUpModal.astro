<section
  id="level-up-modal"
  class="fixed inset-0 z-[70] hidden items-center justify-center bg-navy-950/80 px-4 backdrop-blur"
  role="dialog"
  aria-modal="true"
  aria-labelledby="level-up-title"
>
  <div class="w-full max-w-md rounded-md border border-gold/50 bg-navy-950 p-6 text-center shadow-2xl shadow-gold/20">
    <p class="text-sm font-bold uppercase tracking-wide text-gold">Level up</p>
    <h2 id="level-up-title" class="mt-2 font-display text-3xl font-extrabold text-cream">Con mở level mới!</h2>
    <p id="level-up-copy" class="mt-3 text-cream/75"></p>
    <button id="level-up-close" class="mt-5 rounded-md bg-accent px-5 py-3 font-bold text-navy-950" type="button">
      Tiếp tục đọc
    </button>
  </div>
</section>
