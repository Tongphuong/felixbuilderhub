---
import RarityBadge from './RarityBadge.astro';

export interface Props {
  id: string;
  rarity: 'common' | 'rare' | 'epic';
  price: number;
  name: string;
  thumbnail_url?: string;
  owned: boolean;
  can_afford: boolean;
}

const { id, rarity, price, name, thumbnail_url, owned, can_afford } = Astro.props;
---

<article
  class="shop-item"
  data-rarity={rarity}
  data-owned={owned}
  data-can-afford={can_afford}
>
  <div class="shop-item-art">
    {thumbnail_url ? (
      <img src={thumbnail_url} alt={name} loading="lazy" width="72" height="72" />
    ) : (
      <div class="shop-item-placeholder" aria-hidden="true">🎨</div>
    )}
    <RarityBadge rarity={rarity} />
  </div>
  <h3 class="shop-item-name">{name}</h3>
  <div class="shop-item-action">
    {owned ? (
      <span class="shop-item-owned">
        <span aria-hidden="true">✓</span> Có rồi
      </span>
    ) : (
      <button
        class="shop-item-buy"
        type="button"
        data-part-id={id}
        data-price={price}
        disabled={!can_afford}
      >
        <span class="shop-item-coin" aria-hidden="true">🪙</span>
        <span class="shop-item-price">{price}</span>
      </button>
    )}
  </div>
</article>

<style>
  .shop-item {
    background: #0f172a;
    border-radius: var(--r2l-radius-sm, 12px);
    color: #f8fafc;
    display: grid;
    font-family: var(--r2l-font-display, 'Baloo 2 Variable', system-ui, sans-serif);
    gap: 0.5rem;
    min-height: 80px;
    padding: 0.75rem;
  }

  .shop-item[data-rarity='common'] {
    border: 1px solid #94a3b8;
  }

  .shop-item[data-rarity='rare'] {
    border: 2px solid #3b82f6;
    box-shadow: 0 0 12px rgb(59 130 246 / 0.25);
  }

  .shop-item[data-rarity='epic'] {
    border: 3px solid #a855f7;
    box-shadow: 0 0 16px rgb(168 85 247 / 0.4);
  }

  .shop-item[data-owned='true'] {
    border-color: var(--r2l-mint, #34d399);
  }

  .shop-item[data-can-afford='false']:not([data-owned='true']) {
    opacity: 0.5;
  }

  .shop-item-art {
    align-items: flex-start;
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
  }

  .shop-item-art img,
  .shop-item-placeholder {
    background: rgb(255 255 255 / 0.08);
    border-radius: 12px;
    height: 72px;
    object-fit: contain;
    width: 72px;
  }

  .shop-item-placeholder {
    align-items: center;
    display: flex;
    font-size: 1.75rem;
    justify-content: center;
  }

  .shop-item-name {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }

  .shop-item-action {
    display: flex;
    justify-content: flex-end;
  }

  .shop-item-buy {
    align-items: center;
    background: var(--r2l-sun, #ffc83d);
    border: none;
    border-radius: var(--r2l-radius-sm, 12px);
    color: var(--r2l-ink, #1e2a4a);
    cursor: pointer;
    display: inline-flex;
    font-family: inherit;
    font-size: 1.05rem;
    font-weight: 800;
    gap: 0.35rem;
    min-height: 64px;
    min-width: 64px;
    padding: 0.55rem 1rem;
  }

  .shop-item-buy:disabled {
    background: rgb(255 255 255 / 0.12);
    color: #f87171;
    cursor: not-allowed;
  }

  .shop-item-owned {
    align-items: center;
    color: var(--r2l-mint, #34d399);
    display: inline-flex;
    font-size: 1rem;
    font-weight: 800;
    gap: 0.35rem;
    min-height: 64px;
  }
</style>
