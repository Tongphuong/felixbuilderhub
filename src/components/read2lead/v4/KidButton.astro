---
export interface Props {
  variant?: 'primary' | 'ghost' | 'danger';
  size?: 'md' | 'lg';
  id?: string;
  class?: string;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
}

const {
  variant = 'primary',
  size = 'md',
  id,
  class: className = '',
  disabled = false,
  type = 'button',
} = Astro.props;
---

<button
  type={type}
  id={id}
  class:list={['r2l-kid-btn', `r2l-kid-btn--${variant}`, `r2l-kid-btn--${size}`, className]}
  disabled={disabled}
>
  <slot />
</button>
