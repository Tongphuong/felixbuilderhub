---
export interface Props {
  name: string;
  level: string;
  packsUntilLevelUp?: number;
}

const { name, level, packsUntilLevelUp = 0 } = Astro.props;
---

<button
  type="button"
  class="r2l-egg-shell"
  data-r2l-egg
  data-level={level}
  data-packs-until-hatch={Math.max(0, packsUntilLevelUp)}
  aria-label={`Quả trứng của ${name}`}
>
  <svg viewBox="0 0 200 240" class="r2l-egg-svg" aria-hidden="true">
    <defs>
      <linearGradient id="r2l-egg-component-gradient" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fffdf4" />
        <stop offset="1" stop-color="#fde68a" />
      </linearGradient>
    </defs>
    <ellipse cx="100" cy="140" rx="76" ry="96" fill="url(#r2l-egg-component-gradient)" stroke="#d97706" stroke-width="4" />
    <ellipse cx="74" cy="103" rx="17" ry="26" fill="#ffffff" opacity="0.62" transform="rotate(24 74 103)" />
    <circle cx="66" cy="150" r="10" fill="#f59e0b" opacity="0.35" />
    <circle cx="132" cy="178" r="14" fill="#fb7185" opacity="0.28" />
    <circle cx="122" cy="116" r="8" fill="#38bdf8" opacity="0.3" />
  </svg>
  <span class="r2l-egg-greeting">Chào {name}! Khi con học lên Bạc, trứng sẽ nở.</span>
</button>
