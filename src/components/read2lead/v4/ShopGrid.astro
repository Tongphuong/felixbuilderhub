---
import ShopItem from './ShopItem.astro';

export interface Props {
  items: {
    id: string;
    rarity: 'rare' | 'epic';
    price: number;
    name: string;
    owned: boolean;
    can_afford: boolean;
  }[];
}

const { items } = Astro.props;
const rareItems = items.filter((item) => item.rarity === 'rare');
const epicItems = items.filter((item) => item.rarity === 'epic');
---

<section class="w2-shop-grid" aria-label="Cửa hàng phụ kiện">
  {rareItems.length > 0 && (
    <div class="w2-shop-row" data-rarity-group="rare">
      <h2 class="w2-shop-row-title">Hiếm ⭐</h2>
      <div class="w2-shop-row-items">
        {rareItems.map((item) => <ShopItem {...item} />)}
      </div>
    </div>
  )}
  {epicItems.length > 0 && (
    <div class="w2-shop-row" data-rarity-group="epic">
      <h2 class="w2-shop-row-title">Cực hiếm ✨</h2>
      <div class="w2-shop-row-items">
        {epicItems.map((item) => <ShopItem {...item} />)}
      </div>
    </div>
  )}
  {items.length === 0 && <p class="w2-shop-empty">Đang tải cửa hàng…</p>}
</section>

<style>
  .w2-shop-grid {
    display: flex;
    flex-direction: column;
    font-family: var(--r2l-font-display, 'Baloo 2 Variable', system-ui, sans-serif);
    gap: 1.25rem;
  }

  .w2-shop-row-title {
    color: #f8fafc;
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 0.65rem;
  }

  .w2-shop-row-items {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  .w2-shop-empty {
    color: rgb(248 250 252 / 0.75);
    margin: 0;
    min-height: 44px;
  }

  @media (min-width: 640px) {
    .w2-shop-row-items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
