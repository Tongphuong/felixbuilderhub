---
import { RARITY_LABELS_VI } from '../../../../functions/api/_read2lead-chests.js';

export interface Props {
  part_name: string;
  rarity: 'common' | 'rare' | 'epic';
}

const { part_name, rarity } = Astro.props;
const tierLabel = RARITY_LABELS_VI[rarity] || RARITY_LABELS_VI.common;
---

<dialog class="unlock-celebration" data-rarity={rarity}>
  <div class="unlock-burst" aria-hidden="true" />
  <h2 class="unlock-title">Mới có {tierLabel}!</h2>
  <div class="unlock-part-name">{part_name}</div>
  <div class="unlock-sparkles" aria-hidden="true">✨ ✨ ✨</div>
  <button class="unlock-equip" type="button">Đeo ngay</button>
  <button class="unlock-later" type="button">Để sau</button>
</dialog>

<style>
  .unlock-celebration {
    background: #0f172a;
    border: 3px solid #a855f7;
    border-radius: var(--r2l-radius, 20px);
    color: #f8fafc;
    font-family: var(--r2l-font-display, 'Baloo 2 Variable', system-ui, sans-serif);
    margin: auto;
    max-width: 22rem;
    overflow: hidden;
    padding: 1.25rem;
    position: relative;
    text-align: center;
    transform: scale(0);
    transition: transform 0.3s ease-out;
    width: calc(100% - 2rem);
  }

  .unlock-celebration[open] {
    transform: scale(1);
  }

  .unlock-celebration::backdrop {
    background: rgb(15 23 42 / 0.75);
  }

  .unlock-celebration[data-rarity='rare'] {
    border-color: #3b82f6;
  }

  .unlock-celebration[data-rarity='epic'] {
    border-color: #a855f7;
    box-shadow: 0 0 24px rgb(168 85 247 / 0.45);
  }

  .unlock-burst {
    animation: unlock-burst 1.5s ease-out forwards;
    background: radial-gradient(circle, rgb(251 191 36 / 0.55) 0%, transparent 70%);
    height: 120px;
    left: 50%;
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    width: 120px;
  }

  .unlock-title {
    font-size: 1.2rem;
    margin: 0.5rem 0 0.35rem;
    position: relative;
  }

  .unlock-part-name {
    animation: unlock-pop 1.2s ease-in-out;
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0.35rem 0 0.75rem;
    position: relative;
  }

  .unlock-sparkles {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
    position: relative;
  }

  .unlock-equip,
  .unlock-later {
    border: none;
    border-radius: var(--r2l-radius-sm, 12px);
    cursor: pointer;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 800;
    min-height: 64px;
    min-width: 64px;
    padding: 0.65rem 1rem;
    position: relative;
    width: 100%;
  }

  .unlock-equip {
    background: var(--r2l-mint, #34d399);
    color: var(--r2l-ink, #1e2a4a);
    margin-bottom: 0.5rem;
  }

  .unlock-later {
    background: rgb(255 255 255 / 0.12);
    color: #f8fafc;
  }

  @keyframes unlock-burst {
    0% {
      opacity: 0.2;
      transform: translateX(-50%) scale(0.6);
    }
    100% {
      opacity: 1;
      transform: translateX(-50%) scale(1.2);
    }
  }

  @keyframes unlock-pop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.2);
    }
    100% {
      transform: scale(1);
    }
  }
</style>
