---
import { rankBadgeStyle, rankStarRow, type RankLadderView } from '../../../../lib/rank-ladder-ui';

export interface Props {
  ladder: RankLadderView;
  variant?: 'compact' | 'large';
}

const { ladder, variant = 'compact' } = Astro.props;
const sizeClass = variant === 'large' ? 'r2l-rank-badge--large' : 'r2l-rank-badge--compact';
const stars = rankStarRow(ladder.stars || 0, ladder.stars_per_division || 3);
---

<div
  class:list={['r2l-rank-badge', sizeClass]}
  style={rankBadgeStyle(ladder)}
  role="status"
  aria-label={`Hạng ${ladder.label_vi}`}
>
  <span class="r2l-rank-badge__label">{ladder.label_vi}</span>
  <span class="r2l-rank-badge__stars" set:html={stars} />
</div>

<style>
  .r2l-rank-badge {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    border: 2px solid;
    border-radius: 0.65rem;
    padding: 0.35rem 0.55rem;
    color: #f5e6d3;
    line-height: 1.1;
  }

  .r2l-rank-badge--compact {
    min-width: 4.5rem;
  }

  .r2l-rank-badge--large {
    min-width: 7rem;
    padding: 0.65rem 0.85rem;
    gap: 0.35rem;
  }

  .r2l-rank-badge__label {
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .r2l-rank-badge--large .r2l-rank-badge__label {
    font-size: 1.05rem;
  }

  .r2l-rank-badge__stars {
    display: flex;
    gap: 0.1rem;
    font-size: 0.62rem;
  }

  .r2l-rank-badge--large .r2l-rank-badge__stars {
    font-size: 0.95rem;
  }

  :global(.r2l-rank-star--filled) {
    filter: drop-shadow(0 0 2px rgb(255 215 0 / 0.45));
  }
</style>
