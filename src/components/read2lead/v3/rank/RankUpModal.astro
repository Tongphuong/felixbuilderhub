---
/** Rank-up celebration — canvas-confetti loaded only when this modal fires (V3). */
---

<section
  id="rank-up-modal"
  class="fixed inset-0 z-[75] hidden items-center justify-center bg-navy-950/85 px-4 backdrop-blur"
  role="dialog"
  aria-modal="true"
  aria-labelledby="rank-up-title"
>
  <div class="w-full max-w-md rounded-md border border-gold/50 bg-navy-950 p-6 text-center shadow-2xl shadow-gold/20">
    <img
      src="/assets/minny/minny_celebrate.png"
      alt="Minny cổ vũ"
      width="96"
      height="96"
      class="mx-auto mb-3"
      loading="lazy"
    />
    <p class="text-sm font-bold uppercase tracking-wide text-gold">Lên hạng!</p>
    <h2 id="rank-up-title" class="mt-2 font-display text-3xl font-extrabold text-cream">
      <span id="rank-up-label"></span>
    </h2>
    <p id="rank-up-minny-copy" class="mt-3 text-sm leading-relaxed text-cream/80"></p>
    <button id="rank-up-close" class="mt-5 rounded-md bg-accent px-5 py-3 font-bold text-navy-950" type="button">
      Tiếp tục
    </button>
  </div>
</section>
