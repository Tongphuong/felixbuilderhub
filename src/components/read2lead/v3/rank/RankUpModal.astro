---
/** Shared rank-up celebration. Populated by src/lib/rank-up-celebration.ts. */
---

<section id="rank-up-modal" class="rank-up-modal hidden" role="dialog" aria-modal="true" aria-labelledby="rank-up-title" tabindex="-1">
  <div class="rank-up-stars" aria-hidden="true">
    {Array.from({ length: 6 }, (_, index) => <span style={`--star:${index}`}></span>)}
  </div>
  <div class="fx-card rank-up-card" data-rank-up-card>
    <p class="fx-eyebrow rank-up-eyebrow">Lên bậc mới</p>
    <div class="rank-up-medal" aria-hidden="true"><div><svg viewBox="0 0 80 80"><path d="M40 8 L52 32 L76 36 L58 54 L62 76 L40 64 L18 76 L22 54 L4 36 L28 32 Z" /></svg></div></div>
    <h2 id="rank-up-title"><span id="rank-up-name">Con</span> đã đạt bậc <span id="rank-up-label"></span>!</h2>
    <p id="rank-up-minny-copy"></p>
    <div class="rank-up-transition" aria-label="Thay đổi bậc"><span id="rank-up-old" class="fx-rank"></span><span aria-hidden="true">→</span><span id="rank-up-new" class="fx-rank"></span></div>
    <div id="rank-up-rewards" class="rank-up-rewards hidden">
      <div data-rank-reward="coins"><span>🪙</span><strong></strong><small>xu thưởng</small></div>
      <div data-rank-reward="avatars"><span>🎨</span><strong></strong><small>avatar mới</small></div>
      <div data-rank-reward="unlock"><span>📚</span><strong></strong><small>mở khoá</small></div>
    </div>
    <div class="rank-up-actions">
      <button id="rank-up-share" class="fx-btn fx-btn--primary fx-btn--lg fx-btn--block" type="button">Chia sẻ với bố mẹ 🎉</button>
      <button id="rank-up-close" class="fx-btn fx-btn--ghost" type="button">Để sau →</button>
    </div>
    <p id="rank-up-status" class="rank-up-status hidden" role="status"></p>
  </div>
</section>

<style>
  .rank-up-modal { position: fixed; inset: 0; z-index: 75; place-items: center; overflow-y: auto; padding: 24px; background: radial-gradient(ellipse at 50% 30%, color-mix(in srgb, var(--rank-diamond) 18%, transparent), transparent 50%), color-mix(in srgb, var(--navy-950) 92%, transparent); }
  .rank-up-modal.flex { display: grid; }
  .rank-up-stars { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .rank-up-stars span { position: absolute; width: 4px; height: 4px; border-radius: 50%; background: var(--gold-light); box-shadow: 0 0 12px var(--gold-light); animation: ru-twinkle calc(2.4s + var(--star) * .2s) ease-in-out infinite; animation-delay: calc(var(--star) * .22s); }
  .rank-up-stars span:nth-child(1) { left: 8%; top: 18%; } .rank-up-stars span:nth-child(2) { left: 18%; top: 70%; background: var(--rank-diamond); } .rank-up-stars span:nth-child(3) { left: 86%; top: 22%; } .rank-up-stars span:nth-child(4) { left: 78%; top: 76%; background: var(--rank-diamond); } .rank-up-stars span:nth-child(5) { left: 50%; top: 10%; } .rank-up-stars span:nth-child(6) { left: 32%; top: 12%; }
  .rank-up-card { position: relative; width: min(100%, 480px); padding: 32px 28px; border-color: var(--accent-border); background: linear-gradient(180deg, color-mix(in srgb, var(--navy-850) 92%, transparent), color-mix(in srgb, var(--navy-900) 95%, transparent)); box-shadow: var(--shadow-2xl), 0 0 60px color-mix(in srgb, var(--rank-diamond) 25%, transparent); text-align: center; }
  .rank-up-eyebrow { color: var(--gold-light); }
  .rank-up-medal { width: 144px; height: 144px; margin: 22px auto 16px; padding: 14px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--rank-diamond) 45%, transparent), transparent 70%); animation: ru-float 3s ease-in-out infinite; }
  .rank-up-medal > div { width: 100%; height: 100%; display: grid; place-items: center; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #e6f5ff, #8fd3ff 55%, #5aa9d8); box-shadow: inset 0 -10px 18px rgba(0,0,0,.3), inset 0 8px 12px rgba(255,255,255,.4); }
  .rank-up-medal svg { width: 64px; height: 64px; fill: var(--navy-950); }
  #rank-up-title { margin: 0; color: var(--cream); font-family: var(--font-display); font-size: clamp(24px, 5vw, 28px); font-weight: 800; line-height: 1.3; text-wrap: balance; }
  #rank-up-label { color: var(--rank-diamond); }
  #rank-up-minny-copy { margin: 10px 0 0; color: var(--cream-muted); font-size: 15px; line-height: 1.55; }
  .rank-up-transition { margin: 22px 0 24px; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 14px; color: var(--gold-light); font-weight: 700; }
  #rank-up-old { opacity: .65; } #rank-up-new { font-size: 15px; padding: .4rem 1rem; }
  .rank-up-rewards { grid-template-columns: repeat(3, 1fr); gap: 10px; padding-top: 18px; border-top: 1px solid var(--border-subtle); }
  .rank-up-rewards:not(.hidden) { display: grid; } .rank-up-rewards div { display: grid; gap: 3px; } .rank-up-rewards span { font-size: 22px; } .rank-up-rewards strong { color: var(--cream); font-family: var(--font-display); } .rank-up-rewards small { color: var(--cream-dim); font-size: 11px; }
  .rank-up-actions { margin-top: 24px; display: grid; gap: 10px; } .rank-up-actions .fx-btn { min-height: 44px; } #rank-up-share { min-height: 52px; }
  .rank-up-status { margin: 10px 0 0; color: var(--cream-muted); font-size: 12px; }
  @keyframes ru-twinkle { 0%,100% { opacity: .4; transform: scale(1); } 50% { opacity: 1; transform: scale(1.2); } }
  @keyframes ru-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .rank-up-stars span, .rank-up-medal { animation: none !important; } }
</style>
