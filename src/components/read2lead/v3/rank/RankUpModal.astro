---
/** Shared rank-up celebration ("Đảo phiêu lưu", design S3-rank-up). Populated by src/lib/rank-up-celebration.ts
 *  (unchanged): ids and data attributes below are its contract. Markup and style only. */
---

<section id="rank-up-modal" class="rank-up-modal r2l hidden" role="dialog" aria-modal="true" aria-labelledby="rank-up-title" tabindex="-1">
  <svg class="r2l-m-burst ru-rays" aria-hidden="true" viewBox="0 0 390 460" preserveAspectRatio="xMidYMid slice"><g fill="#2E8B4E"><path d="M195 230 L170 0 L220 0Z"></path><path d="M195 230 L60 20 L100 0Z"></path><path d="M195 230 L290 0 L330 20Z"></path><path d="M195 230 L0 110 L0 160Z"></path><path d="M195 230 L390 110 L390 160Z"></path><path d="M195 230 L0 300 L0 360Z"></path><path d="M195 230 L390 300 L390 360Z"></path></g></svg>
  <div class="ru-confetti" aria-hidden="true">
    <span class="r2l-m-fall" style="left:10%;top:30px;width:14px;height:20px;background:#FFC83D;border-radius:3px"></span>
    <span class="r2l-m-fall" style="left:31%;top:90px;width:14px;height:14px;background:#FF7A3D;border-radius:50%;animation-delay:.5s"></span>
    <span class="r2l-m-fall" style="left:72%;top:50px;width:12px;height:18px;background:#3CC8F0;border-radius:3px;animation-delay:.9s"></span>
    <span class="r2l-m-fall" style="left:87%;top:120px;width:14px;height:14px;background:#FFC83D;border-radius:50%;animation-delay:1.3s"></span>
  </div>
  <button id="rank-up-share" class="r2l-ibtn ru-share" type="button" aria-label="Chia sẻ với bố mẹ"><span aria-hidden="true">🎉</span><span class="sr-only">Chia sẻ với bố mẹ</span></button>
  <div class="ru-col" data-rank-up-card>
    <span class="r2l-lab ru-label" data-design="rankup.label">HẠNG MỚI CỦA CON</span>
    <div class="ru-shield" data-design="rankup.shield" aria-hidden="true">
      <svg class="r2l-m-pop" width="200" height="225" viewBox="0 0 32 36"><path d="M16 2l13 5v10c0 9-6 15-13 17C9 32 3 26 3 17V7z" fill="#C9D3DE" stroke="#17324D" stroke-width="1.4"></path><path d="M16 6l9.5 3.6V17c0 6.6-4.4 11-9.5 12.6C10.9 28 6.5 23.6 6.5 17V9.6z" fill="#E8EEF3"></path></svg>
      <div id="rank-up-stars" class="ru-stars">
        <svg class="ru-star r2l-m-pop" width="64" height="64" viewBox="0 0 24 24" style="animation-delay:.7s"><path d="M12 2.5l2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 17l-5.9 3.3 1.3-6.5L2.5 9.3l6.6-.8z" fill="#FFC83D" stroke="#17324D" stroke-width="1.6" stroke-linejoin="round"></path></svg>
      </div>
      <span class="r2l-tag r2l-tag-sun r2l-m-pop ru-new" style="animation-delay:.9s">Sao mới!</span>
    </div>
    <h2 id="rank-up-title" class="r2l-d r2l-m-pop ru-name" data-design="rankup.name"><span id="rank-up-name" class="sr-only">Con</span><span class="sr-only"> đã đạt bậc </span><span id="rank-up-label"></span></h2>
    <p class="r2l-b-l ru-line" data-design="rankup.line">Con lên hạng rồi! Bạn đồng hành đang nhảy mừng con đó.</p>
    <p id="rank-up-minny-copy" class="sr-only"></p>
    <div class="sr-only" aria-label="Thay đổi bậc"><span id="rank-up-old" class="fx-rank"></span><span aria-hidden="true">→</span><span id="rank-up-new" class="fx-rank"></span></div>
    <div class="ru-monster r2l-m-dance" data-design="rankup.monster"><div id="rank-up-monster" class="ru-monster__holder"><img src="/assets/minny/vector/minny-cheer.svg" alt="" width="150" height="150" /></div></div>
    <div id="rank-up-rewards" class="rank-up-rewards hidden">
      <div data-rank-reward="coins"><span>💎</span><strong></strong><small>kim cương thưởng</small></div>
      <div data-rank-reward="avatars"><span>🎨</span><strong></strong><small>avatar mới</small></div>
      <div data-rank-reward="unlock"><span>📚</span><strong></strong><small>mở khoá</small></div>
    </div>
    <div class="ru-actions">
      <button id="rank-up-close" data-design="rankup.primary" class="r2l-btn r2l-btn-sun r2l-btn-w r2l-m-ring ru-primary" type="button">Tuyệt vời!</button>
    </div>
    <p id="rank-up-status" class="rank-up-status hidden" role="status"></p>
  </div>
</section>

<script>
  import { loadChildState, drawChildAvatar, ladderProgress } from '../../../../lib/r2l-child-avatar';
  // The child's own companion dances in the modal (cheering Minny is the fallback), and the shield shows the
  // REAL stars of the new division from rank_ladder (stars / stars_per_division).
  const modal = document.getElementById('rank-up-modal');
  if (modal) {
    let drawn = false;
    const star = (filled: boolean, pop: boolean) => `<svg class="ru-star${pop ? ' r2l-m-pop' : ''}" ${pop ? 'style="animation-delay:.7s" ' : ''}width="40" height="40" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 17l-5.9 3.3 1.3-6.5L2.5 9.3l6.6-.8z" fill="${filled ? '#FFC83D' : 'none'}" stroke="#17324D" stroke-width="1.6" stroke-linejoin="round"></path></svg>`;
    new MutationObserver(async () => {
      if (drawn || modal.classList.contains('hidden')) return;
      drawn = true;
      const state = await loadChildState();
      const holder = document.getElementById('rank-up-monster');
      if (holder) drawChildAvatar(holder, state);
      const lp = ladderProgress(state), row = document.getElementById('rank-up-stars');
      if (lp && row) row.innerHTML = Array.from({ length: lp.perDivision }, (_, i) => star(i < lp.stars, i === lp.stars - 1)).join('');
    }).observe(modal, { attributes: true, attributeFilter: ['class'] });
  }
</script>

<style>
  .rank-up-modal.r2l { position: fixed; inset: 0; z-index: 75; overflow-x: hidden; overflow-y: auto; background: var(--r2l-leaf); color: #fff; }
  .rank-up-modal.flex { display: flex; justify-content: center; }
  .rank-up-modal :global(.sr-only) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .ru-rays { position: absolute; left: 0; top: 40px; width: 100%; height: 460px; pointer-events: none; }
  .ru-confetti { position: absolute; left: 0; top: 0; width: 100%; height: 380px; overflow: hidden; pointer-events: none; }
  .ru-confetti > span { position: absolute; border: 2px solid var(--r2l-ink); }
  .ru-col { position: relative; width: 100%; max-width: 480px; min-height: 100%; display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 16px; box-sizing: border-box; }
  .ru-share { font-family: var(--r2l-font-display); position: absolute; right: 12px; top: 12px; z-index: 3; width: 48px; height: 48px; font-size: 22px; box-shadow: 0 3px 0 var(--r2l-ink); }
  .ru-label { margin-top: 20px; letter-spacing: .06em; color: #fff; min-height: 28px; display: inline-flex; align-items: center; }
  #rank-up-label { color: #fff !important; }
  .ru-shield { position: relative; width: 220px; height: 240px; display: flex; align-items: center; justify-content: center; flex: none; }
  .ru-stars { position: absolute; top: 76px; left: 0; right: 0; display: flex; justify-content: center; gap: 4px; }
  .ru-new { position: absolute; right: -6px; top: 70px; border: 2px solid var(--r2l-ink); font-size: 16px; }
  .ru-name { margin: 0; font-size: 44px; text-align: center; color: #fff; }
  #rank-up-label { color: #fff; }
  .ru-line { margin: 0; text-align: center; font-weight: 800; color: #fff; }
  .ru-monster { width: 150px; height: 150px; flex: none; }
  .ru-monster__holder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .ru-monster__holder img { width: 100%; height: 100%; object-fit: contain; }
  .rank-up-rewards { grid-template-columns: repeat(3, 1fr); gap: 10px; width: 100%; padding: 12px; background: #fff; border: 3px solid var(--r2l-ink); border-radius: 20px; color: var(--r2l-ink); text-align: center; }
  .rank-up-rewards:not(.hidden) { display: grid; }
  .rank-up-rewards div { display: grid; gap: 3px; } .rank-up-rewards span { font-size: 22px; } .rank-up-rewards strong { font-family: var(--r2l-font-display); } .rank-up-rewards small { font-size: 15px; font-weight: 800; }
  .ru-actions { margin-top: auto; width: 100%; display: grid; gap: 12px; padding-bottom: 0; }
  .ru-primary { min-height: var(--r2l-btn-primary); font-size: 26px; }
  .rank-up-status { margin: 0; color: #fff; font-weight: 800; font-size: 16px; text-align: center; }
  @media (prefers-reduced-motion: reduce) { .ru-confetti > span { animation: none; } }
</style>
