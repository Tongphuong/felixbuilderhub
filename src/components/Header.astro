---
export interface Props {
  homeLinks?: boolean;
}
const { homeLinks = false } = Astro.props;
const productsHref = homeLinks ? '#products' : '/#products';
const contactHref = homeLinks ? '#contact' : '/#contact';
---
<header class="sticky top-0 z-50 border-b border-cream-dim/20 bg-navy-950/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center" aria-label="Felix Builder Hub">
      <img src="/logo/felixbuilderhub_website_header_logo.png" alt="Felix Builder Hub" class="h-9 w-auto md:h-10" />
    </a>
    <nav class="hidden items-center gap-6 text-sm font-medium text-cream-muted sm:flex">
      <a href={productsHref} class="transition hover:text-accent">Sản phẩm</a>
      <a href={contactHref} class="transition hover:text-accent">Liên hệ</a>
      <a href="https://zalo.me/0396868675" target="_blank" rel="noopener noreferrer" class="rounded-md border border-accent/60 px-3 py-1.5 text-accent transition hover:bg-accent hover:text-navy-950">Zalo</a>
    </nav>
    <button
      type="button"
      id="mobile-nav-toggle"
      aria-label="Mở menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-cream-dim/30 text-cream transition hover:border-accent hover:text-accent sm:hidden"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <div id="mobile-nav" hidden class="border-t border-cream-dim/20 bg-navy-950/95 sm:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-6 py-4 text-base font-medium text-cream-muted">
      <a href={productsHref} class="py-3 transition hover:text-accent">Sản phẩm</a>
      <a href={contactHref} class="py-3 transition hover:text-accent">Liên hệ</a>
      <a href="https://zalo.me/0396868675" target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex w-fit rounded-md bg-accent px-4 py-2 font-semibold text-navy-950">Nhắn Zalo Felix</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const nav = document.getElementById('mobile-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.hasAttribute('hidden') ? false : true;
      if (open) {
        nav.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        nav.removeAttribute('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>
