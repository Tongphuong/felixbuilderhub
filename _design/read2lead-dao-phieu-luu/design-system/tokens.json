{
  "name": "Read2Lead · Đảo phiêu lưu",
  "color": {
    "ink": "#17324D", "inkDeep": "#0B1E30",
    "sun": "#FFC83D", "sunShadow": "#E0A21A",
    "sky": "#9BDDFF", "skyShadow": "#5BA9D6", "skyPale": "#E3F1FA", "skyRest": "#CBE6F7",
    "leaf": "#237A41", "leafDeep": "#1B6136", "leafTint": "#DDF5E3",
    "hill": "#4FB868", "hillLight": "#7BD389",
    "cream": "#FFF8E7", "sand": "#FFE7A8", "coral": "#FF7A3D", "minny": "#E0362C",
    "bronze": "#E8A06B", "silver": "#C9D3DE", "gold": "#FFC83D", "podium3": "#F2B98C", "diamond": "#3CC8F0"
  },
  "contrast": {
    "ink/sun": 8.9, "ink/sky": 8.6, "ink/cream": 12.0, "white/leaf": 5.3,
    "rule": "never white text on sun, sky, coral or hill green; no grey text"
  },
  "font": {
    "display": { "family": "Baloo 2", "weight": 800 },
    "body": { "family": "Nunito", "weights": [700, 800, 900] },
    "size": { "display": 46, "h1": 34, "h2": 26, "h3": 22, "h4": 20, "body": 18, "small": 16, "label": 15, "story": 25, "storyDesktop": 32 }
  },
  "shape": { "border": 3, "radiusCard": 28, "radiusCardFlat": 24, "radiusButton": 22, "shadowCard": "0 6px 0 ink", "shadowButtonPressed": "0 2px 0 ink" },
  "size": { "tapMin": 48, "buttonPrimary": 64, "buttonHero": 72, "gutterPhone": 16, "gutterTablet": 24, "container": 1200 },
  "breakpoints": { "phone": 390, "tablet": 768, "laptop": 1024, "desktop": 1280 },
  "motion": {
    "bob": "2.6s ease-in-out infinite, translateY ±10px, rotate ±2deg",
    "dance": "1.1s, 3 loops then stop",
    "pop": "0.6s cubic-bezier(.2,1.4,.4,1) once",
    "halo": "1.6s ring on the one next action",
    "burst": "0.9s once + confetti 2.4s x2",
    "reduceMotion": "every animation off; static pose/outline instead (prefers-reduced-motion + .still class)"
  }
}
